 V:=0; For K:=1 To N Do Begin V:=V*2+((W^.Data[BP Div 8] Shr (7-(BP Mod 8))) And 1); Inc(BP); End; Bits:=V;
End;
Procedure Put(N:Integer; V:LongInt);
Var K:Integer;
Begin
