 If HasBFrames Or HasBQuant Then Begin
  If (InputFormat<>'yuv4mpegpipe') Or
   Not ((VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or (VideoCodec='mpeg2video') Or
    (FourMV And (VideoCodec='')) Or ((VideoCodec='') And
     ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Then
   Fail('-bf/-b_qfactor/-b_qoffset exige un encodage Y4M vers MPEG-1, MPEG-2 ou MPEG-4; incompatible avec copy.');
 End;
 If HasVideoBitrate Or HasVideoTolerance Or HasVideoBuffer Then Begin
  If (InputFormat<>'yuv4mpegpipe') Or
   Not ((VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or (VideoCodec='mpeg2video') Or (VideoCodec='flv') Or
    (FourMV And (VideoCodec='')) Or ((VideoCodec='') And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Then
   Fail('-b/-bt/-bufsize exige un encodage video Y4M vers MPEG4, MPEG1, MPEG2 ou FLV1; incompatible avec copy et FFV1.');
 End;
 If (HasAlbum Or HasComment) And (OutputFormat<>'mp3') And (OutputFormat<>'wav') And
  (OutputFormat<>'avi') And (OutputFormat<>'mp4') Then
  Fail('-album/-comment: sorties MP3, WAV, AVI et MP4 uniquement.');
 If AspectNum>0 Then Begin
  If NoVideo Then Fail('-aspect incompatible avec -vn.');
  If (OutputFormat<>'mp4') And (OutputFormat<>'avi') And (OutputFormat<>'yuv4mpegpipe') Then
   Fail('-aspect: sorties MP4, AVI et Y4M uniquement.');
 End;
 If (VideoCodec='mpeg1video') Or (VideoCodec='mpeg2video') Or (InputFormat='mpeg1video') Or
  ((InputFormat='yuv4mpegpipe') And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video'))) Or
  ((InputFormat='mpeg') And (OutputFormat='yuv4mpegpipe')) Then Begin
  If FourMV Or NoVideo Or IsHTTP(InputPath) Or (HLSBase<>'') Or (RequestedRate<>0) Or
   (RequestedChannels<>0) Or HasBitrate Or (VideoFrames<>0) Or (ImageWidth<>0) Then
   Fail('MPEG1 natif: video locale sans filtres, -4mv ni conversion audio requise.');
  Temps[2]:=NewTemporary;
  If (InputFormat='mpeg1video') And (OutputFormat='mpeg1video') And
   ((AudioCodec='') Or (AudioCodec='copy')) And ((VideoCodec='') Or (VideoCodec='copy')) And
   ((AudioCodec='copy') Or (VideoCodec='copy')) Then CopyFile(Intermediate,Temps[2]) Else Begin
   If AudioCodec<>'' Then Fail('MPEG1 natif: options audio non prises en charge.');
   If InputFormat='yuv4mpegpipe' Then Begin
    If VideoCodec='' Then VideoCodec:=OutputFormat;
    If ((VideoCodec<>'mpeg1video') And (VideoCodec<>'mpeg2video')) Or (OutputFormat<>VideoCodec) Then
     Fail('MPEG: encodage Y4M vers M1V ou M2V du meme codec requis.');
    MPEG1Video(Intermediate,Temps[2],True);
   End Else Begin
    If (OutputFormat<>'yuv4mpegpipe') Or ((VideoCodec<>'') And (VideoCodec<>'rawvideo')) Then
     Fail('MPEG1: decodage M1V/MPEG1 System vers Y4M uniquement.');
    If InputFormat='mpeg' Then Begin
     Temps[3]:=NewTemporary; MPEGSystem(Intermediate,Temps[3],'mpeg','mpeg1video'); Intermediate:=Temps[3];
    End Else If InputFormat<>'mpeg1video' Then Fail('MPEG1: entree non prise en charge.');
    MPEG1Video(Intermediate,Temps[2],False);
   End;
  End;
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video MPEG creee: ',OutputPath); Halt(0);
 End;
 If FourMV And (VideoCodec='') Then VideoCodec:='mpeg4';
 If FourMV And (VideoCodec<>'mpeg4') Then Fail('-4mv exige un encodage MPEG-4 Part 2, pas une copie.');
 If VideoCodec='mpeg4' Then Begin
  If (InputFormat<>'yuv4mpegpipe') Or IsHTTP(InputPath) Or (HLSBase<>'') Or NoVideo Or
   (AudioCodec<>'') Or (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   (VideoFrames<>0) Or (ImageWidth<>0) Then Fail('MPEG4: entree Y4M locale sans filtres ni audio requise.');
  If (OutputFormat<>'m4v') And (OutputFormat<>'avi') And (OutputFormat<>'mp4') Then
   Fail('MPEG4: sorties M4V, AVI ou MP4 requises.');
  Temps[3]:=NewTemporary; EncodeMPEG4(Intermediate,Temps[3]); Temps[2]:=NewTemporary;
  If OutputFormat='m4v' Then CopyFile(Temps[3],Temps[2])
  Else RemuxVideo(Temps[3],Temps[2],'m4v',OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video MPEG4 creee: ',OutputPath); Halt(0);
 End;
 If (VideoCodec='ffv1') Or (VideoCodec='flv') Or (InputFormat='yuv4mpegpipe') Or (OutputFormat='yuv4mpegpipe') Then Begin
  If IsHTTP(InputPath) Or (HLSBase<>'') Or NoVideo Or (AudioCodec<>'') Or
   (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   (VideoFrames<>0) Or (ImageWidth<>0) Then Fail('FFV1: video locale sans filtres ni options audio requise.');
  If InputFormat='yuv4mpegpipe' Then Begin
   If Not (((HasCrop Or DecodedVideo) And (OutputFormat='yuv4mpegpipe') And ((VideoCodec='') Or (VideoCodec='rawvideo'))) Or ((OutputFormat='avi') And (VideoCodec='ffv1')) Or
    ((OutputFormat='flv') And (VideoCodec='flv'))) Then Fail('Y4M: ffv1 vers AVI ou flv vers FLV requis.');
  End Else If ((InputFormat<>'avi') And (InputFormat<>'flv')) Or (OutputFormat<>'yuv4mpegpipe') Or
   ((VideoCodec<>'') And (VideoCodec<>'rawvideo')) Then Fail('Decodage: AVI FFV1 ou FLV1 intra vers Y4M requis.');
  Temps[2]:=NewTemporary;
  If (HasCrop Or DecodedVideo) And (InputFormat='yuv4mpegpipe') And (OutputFormat='yuv4mpegpipe') Then CopyFile(Intermediate,Temps[2])
  Else RemuxVideo(Intermediate,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video creee: ',OutputPath); Halt(0);
 End;
 If (InputFormat='m4v') Or (OutputFormat='m4v') Then Begin
  If IsHTTP(InputPath) Or (HLSBase<>'') Then Fail('M4V: entree locale requise.');
  If Not (((AudioCodec='copy') And AllStreams) Or ((VideoCodec='copy') And (AudioCodec=''))) Then
   Fail('M4V exige -c copy ou -c:v copy.');
  If NoVideo Or (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   (VideoFrames<>0) Or (ImageWidth<>0) Or ((VideoCodec<>'') And (VideoCodec<>'copy')) Then
   Fail('M4V: copie video sans filtre ni reencodage.');
  If Not (((InputFormat='m4v') And ((OutputFormat='mp4') Or (OutputFormat='avi') Or (OutputFormat='m4v'))) Or
   ((OutputFormat='m4v') And ((InputFormat='mp4') Or (InputFormat='avi')))) Then
   Fail('M4V: conversions MP4/AVI vers M4V et M4V vers MP4/AVI.');
  Temps[2]:=NewTemporary; RemuxVideo(Intermediate,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video creee: ',OutputPath); Halt(0);
 End;
 If (InputFormat='mpeg') Or (OutputFormat='mpeg') Then Begin
  If IsHTTP(InputPath) Or (HLSBase<>'') Then Fail('MPEG System: entree locale requise.');
  If Not (((AudioCodec='copy') And AllStreams) Or
   ((VideoCodec='copy') And (AudioCodec='') And (InputFormat='mpeg') And
    ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Then Fail('MPEG System exige -c copy (ou -c:v copy pour mpeg1video/mpeg2video).');
  If (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   ((VideoCodec<>'') And Not ((VideoCodec='copy') And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Or
   (VideoFrames<>0) Or (ImageWidth<>0) Then
   Fail('MPEG System: copie des flux uniquement, sans reencodage ni filtres.');
  If NoAudio And NoVideo Then Fail('Aucune piste selectionnee (-an et -vn).');
  If InputFormat='mpeg' Then Begin
   If (OutputFormat<>'mpeg') And (OutputFormat<>'mp3') And
    (OutputFormat<>'mp2') And (OutputFormat<>'mpeg1video') And (OutputFormat<>'mpeg2video') Then
    Fail('Sorties MPEG System: mpeg, mp3, mp2, mpeg1video ou mpeg2video.');
   If NoAudio And ((OutputFormat='mp3') Or (OutputFormat='mp2')) Then Fail('-an exclut la sortie audio.');
   If NoVideo And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')) Then Fail('-vn exclut la sortie video.');
  End Else If InputFormat<>'mp3' Then Fail('Muxage MPEG System: entree MP3 MPEG-1 requise.');
  Temps[2]:=NewTemporary; MPEGSystem(Intermediate,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie MPEG creee: ',OutputPath); Halt(0);
 End;
 If (VideoCodec='png') Or (VideoCodec='gif') Or (OutputFormat='png') Or
  (OutputFormat='gif') Or (OutputFormat='image2') Then Begin
  If InputFormat<>'flv' Then Fail('Extraction PNG/GIF: entree FLV AVC/H264 requise.');
  If VideoCodec='' Then Begin
   If (OutputFormat='gif') Or (Extension(OutputPath)='gif') Then VideoCodec:='gif'
   Else VideoCodec:='png';
  End;
  If ((OutputFormat='gif') And (VideoCodec<>'gif')) Or
     ((OutputFormat='png') And (VideoCodec<>'png')) Then Fail('Codec et format image incompatibles.');
  If Not ((OutputFormat='rawvideo') Or (OutputFormat='png') Or (OutputFormat='gif') Or
   (OutputFormat='image2')) Then Fail('Image: muxeur rawvideo, image2, png ou gif requis.');
  If NoVideo Then Fail('-vn est incompatible avec extraction PNG/GIF.');
  If (AudioCodec<>'') Or (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Then
   Fail('Options audio incompatibles avec extraction PNG/GIF.');
  If Not HideBanner Then WriteLn('Premiere image FLV H264 CAVLC: decodage et image natifs Pascal.');
  Temps[2]:=NewTemporary; ExtractFLVPicture(Intermediate,Temps[2],ImageWidth,ImageHeight);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Image ',VideoCodec,' creee: ',OutputPath); Halt(0);
 End;
 If (VideoFrames<>0) Or (ImageWidth<>0) Or ((VideoCodec<>'') And (VideoCodec<>'copy')) Then
  Fail('-vframes, -s et encodage video non pris en charge pour cette sortie.');
 If InputFormat='hls' Then Begin
  If (OutputFormat<>'mp4') Or (AudioCodec<>'copy') Or Not AllStreams Then   Fail(
  'HLS exige -c copy et une sortie MP4.');
  If (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or NoVideo Then   Fail(
  'HLS copy conserve toutes les pistes: conversion et -vn non pris en charge.');
  Temps[2]:=NewTemporary;
  If NoAudio Or (AspectNum>0) Or HasAlbum Or HasComment Then Begin
   Temps[3]:=NewTemporary; AssembleHLS(Intermediate,Temps[3]);
   RemuxVideo(Temps[3],Temps[2],'mp4','mp4');
  End Else AssembleHLS(Intermediate,Temps[2]);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('MP4 cree: ',OutputPath); Halt(0);
 End;
 If IsHTTP(InputPath) Then Fail('Entree reseau reservee aux listes HLS.');
 If HLSBase<>'' Then Fail('-hls_base_url exige une entree HLS.');
 If (InputFormat='mp4') Or (InputFormat='avi') Or (InputFormat='webm') Then Begin
  If Not (((InputFormat='mp4') And (OutputFormat='avi')) Or
  ((InputFormat='avi') And (OutputFormat='mp4')) Or
  ((InputFormat='webm') And (OutputFormat='mp4')) Or
  ((NoAudio Or (AspectNum>0) Or HasAlbum Or HasComment) And (InputFormat=OutputFormat) And ((InputFormat='mp4') Or (InputFormat='avi')))) Then   Fail(
  'Conversions video: MP4 vers AVI, AVI vers MP4, WebM vers MP4.');
  If (AudioCodec<>'') And ((AudioCodec<>'copy') Or Not AllStreams) Then   Fail(
  'Video: utiliser -c copy; aucun reencodage video implemente.');
  If (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or NoVideo Then   Fail(
  'Conversion de conteneur video: filtres et conversion audio non pris en charge.');
  If Not HideBanner Then WriteLn('Conversion de conteneur video sans reencodage.');
  Temps[2]:=NewTemporary; RemuxVideo(InputPath,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video creee: ',OutputPath); Halt(0);
 End;
 If NoAudio Then Fail('-an: aucune piste a ecrire dans une sortie audio seule.');
 If VideoCodec<>'' Then Fail('Codec video incompatible avec une sortie audio seule.');
 If (OutputFormat<>'wav') And (OutputFormat<>'mp3') And (OutputFormat<>'ac3') And
 (OutputFormat<>'adx') And (OutputFormat<>'aiff') And (OutputFormat<>'flv') And (OutputFormat<>'mp4') Then Fail(
 'Sorties audio WAV, MP3, AC3, ADX et AIFF-C (adpcm_ima_qt) prises en charge.');
 If AudioCodec='' Then If OutputFormat='wav' Then AudioCodec:=
 'pcm_s16le' Else If OutputFormat='adx' Then AudioCodec:='adpcm_adx'
 Else If OutputFormat='aiff' Then AudioCodec:='adpcm_ima_qt'
 Else If OutputFormat='flv' Then AudioCodec:='adpcm_swf'
 Else If OutputFormat='mp4' Then AudioCodec:='alac' Else AudioCodec:=OutputFormat;
 If (AudioCodec<>'copy') And Not (((OutputFormat='wav') And ((AudioCodec='pcm_s16le') Or (AudioCodec='adpcm_ima_wav') Or
  (AudioCodec='adpcm_ms') Or (AudioCodec='adpcm_yamaha'))) Or ((OutputFormat='flv') And (AudioCodec='adpcm_swf')) Or
 ((OutputFormat='mp4') And (AudioCodec='alac')) Or
 ((OutputFormat='adx') And (AudioCodec='adpcm_adx')) Or ((OutputFormat='aiff') And (AudioCodec='adpcm_ima_qt')) Or
 ((OutputFormat='mp3') And (AudioCodec='mp3')) Or ((OutputFormat='ac3') And (AudioCodec='ac3'))) Then Fail(
 'Codec de sortie non pris en charge pour ce conteneur.');
 If HasBitrate And (((OutputFormat<>'mp3') And (OutputFormat<>'ac3')) Or (AudioCodec='copy')) Then Fail(
 '-b:a exige un encodage MP3 ou AC3.');
 If (OutputFormat='mp3') And (RequestedBitRateK>320) Then Fail('MP3: debit maximal 320k.');
 If (AudioCodec='copy') And ((RequestedRate<>0) Or (RequestedChannels<>0) Or (InputFormat
 <>OutputFormat)) Then  Fail(
 '-c:a copy exige le meme conteneur audio et aucune conversion audio.');
 If Not HideBanner Then WriteLn('FFMPEG Pascal 1.11 - moteur audio natif du projet');
 Temps[2]:=NewTemporary;
 If AudioCodec='copy' Then CopyFile(InputPath,Temps[2])
  Else
 Begin
  Intermediate:=InputPath;
  If InputFormat<>'wav' Then Begin
   Temps[0]:=NewTemporary;
   If InputFormat='asf' Then Begin
    Temps[3]:=NewTemporary; DemuxASF(InputPath,Temps[3]);
    DecodeWMA2Spool(Temps[3],Temps[0]);
   End Else
   If (InputFormat='mp3') Or (InputFormat='mp1') Then DecodeMP3(InputPath,Temps[0]) Else
   If InputFormat='ac3' Then ProcessAC3(InputPath,Temps[0],False,0) Else
   If InputFormat='aac' Then DecodeAAC(InputPath,Temps[0]) Else
   If InputFormat='iff' Then Decode8SVX(InputPath,Temps[0]) Else
   If InputFormat='adx' Then DecodeADX(InputPath,Temps[0]) Else
   If InputFormat='4xm' Then Decode4XMAudio(InputPath,Temps[0]) Else
   If InputFormat='ea' Then DecodeEAContainer(InputPath,Temps[0],InputCodec) Else
   If InputFormat='xa' Then DecodeMaxisXA(InputPath,Temps[0]) Else
   If InputFormat='alac' Then DecodeALAC(InputPath,Temps[0]) Else
   If InputFormat='thp' Then DecodeTHP(InputPath,Temps[0]) Else
   If InputFormat='psxstr' Then DecodeXASectors(InputPath,Temps[0]) Else
   If InputFormat='flv' Then DecodeFLVAudio(InputPath,Temps[0]) Else
   If InputFormat='smjpeg' Then DecodeSMJPEG(InputPath,Temps[0]) Else
   If InputFormat='wsaud' Then DecodeWSAud(InputPath,Temps[0]) Else
   If InputFormat='amv' Then DecodeAMV(InputPath,Temps[0]) Else
   If InputFormat='iss' Then DecodeISS(InputPath,Temps[0]) Else
   If InputFormat='ape' Then DecodeAPE(InputPath,Temps[0]) Else
   If InputFormat='oma' Then DecodeATRAC3(InputPath,Temps[0]) Else
   If (InputFormat='aiff') And IsAIFFIma4(InputPath) Then DecodeAIFFIma4(InputPath,Temps[0]) Else
   If InputFormat='aiff' Then DecodeAIFF(InputPath,Temps[0]) Else
   If InputFormat='voc' Then DecodeVOC(InputPath,Temps[0]) Else
   If InputFormat='libopenmpt' Then DecodeMOD(InputPath,Temps[0])
                               Else Fail('Decodeur non implemente.');
   Intermediate:=Temps[0];
  End Else If IsWaveCT(InputPath) Then Begin
   Temps[0]:=NewTemporary; DecodeWaveCT(InputPath,Temps[0]); Intermediate:=Temps[0];
  End Else If WaveFormatTag(InputPath)=$270 Then Begin
   Temps[0]:=NewTemporary; DecodeATRAC3(InputPath,Temps[0]); Intermediate:=Temps[0];
  End Else If (WaveFormatTag(InputPath)=$61) Or (WaveFormatTag(InputPath)=$62) Or
  (WaveFormatTag(InputPath)=$11) Or (WaveFormatTag(InputPath)=$02) Or (WaveFormatTag(InputPath)=$20) Then Begin
   Temps[0]:=NewTemporary; DecodeWaveBlocks(InputPath,Temps[0]); Intermediate:=Temps[0];
  End;
  If (OutputFormat='wav') And (AudioCodec='adpcm_ima_wav') Then Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   EncodeWaveBlocks(Temps[1],Temps[2],0);
  End Else If (OutputFormat='wav') And (AudioCodec='adpcm_ms') Then Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   EncodeWaveBlocks(Temps[1],Temps[2],1);
  End Else If (OutputFormat='wav') And (AudioCodec='adpcm_yamaha') Then Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   EncodeWaveYamaha(Temps[1],Temps[2]);
  End Else If OutputFormat='mp4' Then Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   EncodeALACM4A(Temps[1],Temps[2]);
  End Else If OutputFormat='flv' Then Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   EncodeFLVSWF(Temps[1],Temps[2]);
  End Else If OutputFormat='wav' Then NormalizeWave(Intermediate,Temps[2],False)
   Else If OutputFormat='adx' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    EncodeADX(Temps[1],Temps[2]);
   End
   Else If OutputFormat='aiff' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    EncodeIMAQT(Temps[1],Temps[2]);
   End
   Else If OutputFormat='ac3' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    If Not HasBitrate Then RequestedBitRateK:=192; ProcessAC3(Temps[1],Temps[2],True,RequestedBitRateK);
   End Else
  Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],True);
   EncodeMP3(Temps[1],Temps[2],RequestedBitRateK);
  End;
 End;
 Commit(Temps[2]); Temps[2]:='';
 WriteLn('Sortie creee: ',OutputPath);
END.
