{ O3 : vecteur d'arguments modifiable ; ParamStr/ParamCount masques pour que
 tous les moteurs voient la ligne de commande reecrite (-target, ...) }
Var
 O3Argv: Array[0..2047] Of String[255]; O3Argc: LongInt; O3ArgInit: Boolean;

Procedure O3LoadArgs;
Var I: LongInt;
Begin
 O3ArgInit:=True; O3Argc:=System.ParamCount; If O3Argc>2046 Then O3Argc:=2046;
 For I:=0 To O3Argc Do O3Argv[I]:=System.ParamStr(I);
 { '/?' (aide a la Windows) equivaut a '-h' }
 If (O3Argc=1) And (O3Argv[1]='/?') Then O3Argv[1]:='-h';
End;

Function ParamCount: LongInt;
Begin
 If Not O3ArgInit Then O3LoadArgs;
 ParamCount:=O3Argc;
End;

Function ParamStr(I: LongInt): String;
Begin
 If Not O3ArgInit Then O3LoadArgs;
 If (I<0) Or (I>O3Argc) Then ParamStr:='' Else ParamStr:=O3Argv[I];
End;

Procedure O3HelpFr; Forward;
Function O3F3Ign(Const A: String): Boolean; Forward;
Function O3MacLangIdx(Const L: String): LongInt; Forward;
Var O3PendN: LongInt; O3PendSpec,O3PendKey,O3PendVal: Array[0..15] Of String[
 80]; { -metadata:s:... en attente (multiplexeur generique) }
Procedure O3FmxApply; Forward;
Procedure O3FmxInputTags; Forward;
Var
V1NoRng: Boolean; { V1 : en-tete Y4M d'une sortie vide : pas de plage de
 couleurs }
Var
 O3IgnN: LongInt; { options de conversion de -target ignorees par F3Try :
 valables seulement pour la copie }
Var O3NoSMeta: Boolean; { -map_metadata -1 sans specificateur : ni les flux ni
 les chapitres ne sont copies non plus }
Var O3NoMeta: Boolean; { -map_metadata -1 : ne pas copier les metadonnees de
 l'entree }
{ ==== O3-SHADOW-END ==== }


