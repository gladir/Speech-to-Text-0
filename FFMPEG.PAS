{ nom du codec video de sortie (options -c:v/-vcodec/-codec:v/-c) ou defaut du
 conteneur }
Function O1CodecOf(G: Integer; Const OutNm: String): String;
Var I: Integer; K: String; R: String;
Begin
 R:='';
 For I:=1 To O1NOp Do
  If (O1Op[I].Grp=G) And Not O1Op[I].Av Then Begin
   K:=O1Op[I].Key;
   If (K='vcodec') Or (K='c:v') Or (K='codec:v') Or (K='c') Or (K='codec') Then
    R:=Lower(O1Op[I].Val);
  End;
 If R='' Then Begin
  K:=Extension(OutNm);
  If K='avi' Then R:='mpeg4' Else If (K='flv') Then R:='flv' Else If (K='wmv')
   Or (K='asf') Then R:='msmpeg4v3';
 End;
 O1CodecOf:=R;
End;

{ marque les jetons des options traitees par ce module }
Var O1Strong: Boolean;
Procedure O1MarkMine;
Var I: Integer; B: String;
Begin
 O1Strong:=False;
 For I:=1 To O1NOp Do
  If (O1Op[I].Grp>0) And (O1Op[I].Ti>=0) Then Begin
   B:=O1OptNm[O1Op[I].Ti];
   If (B='ss') Or (B='t') Or (B='to') Or (B='itsoffset') Or (B='vframes') Or (
    B='frames') Or (B='fs') Or (B='sseof') Or (B='dframes') Or (B='aspect') Then
    O1Used[O1Op[I].Tok]:=True;
   If (
(B='vf') Or (B='af') Or (B='filter')) And (O1Op[I].Grp=O1OutG) Then Begin
 O1Used[O1Op[I].Tok]:=True; O1Strong:=True; End;
   If (
O1Op[I].Grp=O1OutG) And ((B='r') Or (B='s')) Then O1Used[O1Op[I].Tok]:=
    True;
   If (O1Op[I].Grp=O1InG) And (B='r') Then O1Used[O1Op[I].Tok]:=True;
   If (B='ss') Or (B='t') Or (B='to') Or (B='itsoffset') Or (B='vframes') Or (
    B='frames') Or (B='fs') Or (B='sseof') Or (B='dframes') Or (B='r') Or (
    B='s') Then O1Strong:=True;
  End;
End;

{ ---- fonction principale ---- }
Function O1Route: Boolean;
Var I,J,K,Rc: Integer; Ok: Boolean; V: String; Us: Int64; Fl: Int64; InNm,OutNm,
 Kind,Ext: String;
 Child: String; Code: LongInt; InIsY4M,InIsWav,AudOut: Boolean; OutFmtN,SrcV,
  SrcA: String; Hd: Array[0..15] Of Char; F: File; N: LongInt;
 HasEngaged: Boolean; Aud: Boolean; E1,E2,E3: Int64; PixI: Integer;
Begin
 O1Route:=False;
 O1NoPts:=-9223372036854775807-1; O1VFrames:=-1;
 O1LogLevel:=32; O1HideBanner:=False; O1BannerDone:=False;
 If (ParamCount=0) Or ((ParamCount=1) And (ParamStr(1)='-hide_banner')) Then
  Begin
  { aucun argument : usage de ffmpeg }
  O1HideBanner:=ParamCount=1;
  O1Banner; O1TxUsage(StdErr); Flush(StdErr); Halt(1);
 End;
 If (ParamStr(1)='-fmxq') Or (ParamStr(1)='-f5q') Then Exit;
 If Not O1Engaged Then Exit;
 O1PreScan;
 Rc:=O1Split;
 If Rc<>0 Then O1Die(Rc);
 { options globales d'information (OPT_EXIT) }
 For I:=1 To O1NOp Do
  If (O1Op[I].Grp=-1) And (O1Op[I].Ti>=0) And O1HasFlag(O1Op[I].Ti,'X') Then
   Begin
   V:=O1OptNm[O1Op[I].Ti];
   If V='version' Then Begin O1TxVersion(Output); Flush(Output); Halt(0); End;
   If V='L' Then Begin O1Banner; O1TxLicense(Output); Flush(Output); Halt(0);
    End;
   If (V='h') Or (V='help') Or (V='-help') Or (V='?') Then Begin
    { aide seule : en francais, sauf si LANGUAGE=EN }
    If (ParamCount=1) And (GetEnv('LANGUAGE')<>'EN') Then Begin
     O3HelpFr; Halt(0); End;
    O1Banner;
    O1TxHelp(Output); Flush(Output); Halt(0); End;
   If V='formats' Then Begin O1Banner; O1TxFormats(Output); Flush(Output); Halt(
    0); End;
  End;
 { prise en charge : une entree et une sortie }
 O1InG:=0; O1OutG:=0;
 For I:=1 To O1NGr Do Begin
  If O1Gr[I].IsIn Then Begin If O1InG<>0 Then Exit; O1InG:=I; End
  Else Begin If O1OutG<>0 Then Exit; O1OutG:=I; End;
 End;
 If (O1InG=0) Or (O1OutG=0) Then Exit;
 V1Gate(O1Gr[O1InG].Arg,O1Gr[O1OutG].Arg); { V1 }

 { copie de flux : non prise en charge ici }
 For I:=1 To O1NOp Do
  If (O1Op[I].Grp>0) And ((O1Op[I].Key='c') Or (O1Op[I].Key='codec') Or (Copy(
   O1Op[I].Key,1,2)='c:') Or (Copy(O1Op[I].Key,1,6)='codec:') Or (O1Op[
   I].Key='vcodec') Or (O1Op[I].Key='acodec')) And (O1Op[I].Val='copy') Then
   Exit;
 InNm:=O1Gr[O1InG].Arg; OutNm:=O1Gr[O1OutG].Arg;
 O1MarkMine;
 { ---- options d'entree ---- }
 O1CheckFlags(O1InG);
 O1HasInSS:=False; O1HasInT:=False; O1HasInTo:=False; O1HasInOff:=False;
  O1HasInR:=False;
 O1HasInSS:=O1GetDur(O1InG,'ss',O1InSS);
 O1HasInT:=O1GetDur(O1InG,'t',O1InT);
 O1HasInTo:=O1GetDur(O1InG,'to',O1InTo);
 O1HasInOff:=O1GetDur(O1InG,'itsoffset',O1InOff);
 If O1HasInT And O1HasInTo Then Begin O1HasInTo:=False; O1Msg(24,
  '[in#0 @ 0x55a0c1f2d640] -t and -to cannot be used together; using -t.'); End;
 If O1HasInTo And Not O1HasInT Then Begin
  If O1HasInSS Then E1:=O1InSS Else E1:=0;
  If O1InTo<=E1 Then Begin
   O1Msg(16,'[in#0 @ 0x55a0c1f2d640] -to value smaller than -ss; aborting.');
   O1Msg(16,'Error opening input file '+InNm+'.'); O1Msg(16,
    'Error opening input files: Invalid argument'); O1Die(234);
  End;
 End;
 I:=O1Last(O1InG,'r','v');
 If I>0 Then Begin
  If Not O1ParseRate(O1Op[I].Val,O1InRN,O1InRD) Then Begin
   O1Msg(16,'Error parsing framerate '+O1Op[I].Val+'.');
   O1Die(234);
  End;
  O1HasInR:=True;
 End;
 { entree inexistante }
 If Not O1FileExists(InNm) Then Begin
  O1Msg(16,
   '[in#0 @ 0x55a0c1f2d640] Error opening input: No such file or directory');
  O1Msg(16,'Error opening input file '+InNm+'.');
  O1Msg(16,'Error opening input files: No such file or directory');
  O1Die(254);
 End;
 { ---- options de sortie ---- }
 O1CheckFlags(O1OutG);
 O1HasOutSS:=O1GetDur(O1OutG,'ss',O1OutSS);
 O1HasOutT:=O1GetDur(O1OutG,'t',O1OutT);
 O1HasOutTo:=O1GetDur(O1OutG,'to',O1OutTo);
 If O1HasOutT And O1HasOutTo Then Begin O1HasOutTo:=False; O1Msg(24,
  '[out#0 @ 0x55a0c1f2d640] -t and -to cannot be used together; using -t.');
  End;
 If O1HasOutTo And Not O1HasOutT Then Begin
  If O1HasOutSS Then E1:=O1OutSS Else E1:=0;
  If O1OutTo<=E1 Then Begin
   O1Msg(16,'[out#0 @ 0x55a0c1f2d640] -to value smaller than -ss; aborting.');
   O1Msg(16,'Error opening output file '+OutNm+'.'); O1Msg(16,
    'Error opening output files: Invalid argument'); O1Die(234);
  End;
 End;
 O1VFrames:=-1;
 If O1GetInt(O1OutG,'frames',E1,'v','frames:v','') Then O1VFrames:=E1;
 If O1GetInt(O1OutG,'vframes',E2,'v','frames:v','vframes') Then O1VFrames:=E2;
 If O1VFrames<0 Then O1VFrames:=-1;
 O1FsSet:=O1GetInt(O1OutG,'fs',O1Fs,'v','fs','');
 O1HasOutR:=False; O1AspN:=0; O1AspD:=1;
 I:=O1Last(O1OutG,'aspect','v');
 If I>0 Then Begin
  If (Not O1ParseRatio(O1Op[I].Val,255,O1AspN,O1AspD)) Or (O1AspN<=0) Or (
   O1AspD<=0) Then Begin
   O1Msg(16,'[vost#0:0 @ 0x55a0c1f2d640] Invalid aspect ratio: '+O1Op[I].Val);
   O1Msg(16,'Error opening output file '+OutNm+'.'); O1Msg(16,
    'Error opening output files: Invalid argument'); O1Die(234);
  End;
 End;
 I:=O1Last(O1OutG,'r','v');
 If I>0 Then Begin
  If Not O1ParseRate(O1Op[I].Val,O1OutRN,O1OutRD) Then Begin
   O1Msg(16,'[vost#0:0 @ 0x55a0c1f2d640] Invalid framerate value: '+O1Op[
    I].Val);
   O1Msg(16,'Error opening output file '+OutNm+'.'); O1Msg(16,
    'Error opening output files: Invalid argument'); O1Die(234);
  End;
  O1HasOutR:=True;
 End;
 O1Sz:=False; O1DstW:=0; O1DstH:=0; O1DstFm:=-1; O1SwFlags:=O1SwBicubic;
  O1SwParamSet:=False;
 I:=O1Last(O1OutG,'s','v');
 If I>0 Then Begin
  If Not O1ParseSize(O1Op[I].Val,O1SzW,O1SzH) Then Begin
   O1Msg(16,'[vost#0:0 @ 0x55a0c1f2d640] Invalid frame size: '+O1Op[I].Val+'.');
   O1Msg(16,'Error opening output file '+OutNm+'.'); O1Msg(16,
    'Error opening output files: Invalid argument'); O1Die(234);
  End;
  O1Sz:=True;
 End;
 { drapeaux swscale }
 For I:=1 To O1NOp Do
  If (O1Op[I].Grp=O1OutG) And O1Op[I].Av And (O1Op[I].Key='sws_flags') Then
   Begin
   Ok:=O1ParseSwsFlags(O1Op[I].Val,O1SwFlags);
   If Not Ok Then Begin
    O1Msg(16,'[scaler_out_0_0 @ 0x55a0c1f2d640] Unable to parse option value "'+
     O1Op[I].Val+'"');
    O1Msg(16,
     '[scaler_out_0_0 @ 0x55a0c1f2d640] Error setting option sws_flags to valu'+
     'e '+O1Op[I].Val+'.');
    O1Msg(16,'[vf#0:0 @ 0x55a0c1f2d640] Error reinitializing filters!');
    O1Die(234);
   End;
   O1Used[O1Op[I].Tok]:=True;
  End;
 V1Prepare(InNm,OutNm); { V1 }

 { sortie existante }
 O1Overwrite:=O1GlobalBool('y'); O1NoOverwrite:=O1GlobalBool('n');
 Overwrite:=O1Overwrite; NoOverwrite:=O1NoOverwrite;
 If O1FileExists(OutNm) And (OutNm<>'-') And Not O1Overwrite Then
  O1OverwriteGate(OutNm);
{ ---- sources : Y4M, WAV ou autre (decodage par le programme) ---- }
 InIsY4M:=False; InIsWav:=False;
 Assign(F,InNm); {$I-}Reset(F,1);{$I+}
 If IOResult=0 Then Begin
  FillChar(Hd,SizeOf(Hd),0); N:=0; {$I-}BlockRead(F,Hd,12,N);{$I+}
  Close(F);
  If (N>=9) And (Hd[0]='Y') And (Hd[1]='U') And (Hd[2]='V') And (Hd[3]='4') And
   (Hd[4]='M') And (Hd[5]='P') And (Hd[6]='E') And (Hd[7]='G') And (Hd[8]='2')
   Then InIsY4M:=True;
  If (N>=12) And (Hd[0]='R') And (Hd[1]='I') And (Hd[2]='F') And (Hd[3]='F') And
   (Hd[8]='W') And (Hd[9]='A') And (Hd[10]='V') And (Hd[11]='E') Then InIsWav:=
   True;
 End;
 V1PosOk:=InIsY4M; { V1 }

 { cible de la mise a l'echelle / conversion }
 V:=''; PixI:=O1Last(O1OutG,'pix_fmt','v');
 If PixI>0 Then Begin
  V:=Lower(O1Op[PixI].Val); If (V<>'') And (V[1]='+') Then Delete(V,1,1);
  Ok:=False; For K:=0 To O1PixN-1 Do If O1Pix[K]=V Then Ok:=True;
  If (V='y8') Or (V='gray8') Or (V='y16') Then Ok:=True;
  If Not Ok Then Begin
   O1Msg(16,'[vost#0:0 @ 0x55a0c1f2d640] Unknown pixel format requested: '+V+
    '.');
   O1Msg(16,'Error opening output file '+OutNm+'.'); O1Msg(16,
    'Error opening output files: Invalid argument'); O1Die(234);
  End;
 End;
 If (PixI>0) And (O1OutFmtName(O1OutG,OutNm)='yuv4mpegpipe') And Not O1HasAv(
  O1OutG,'strict') Then Begin
  { yuv4mpegenc.c : formats de pixels acceptes sans -strict -1 }
  If Not ((V='yuv444p') Or (V='yuv422p') Or (V='yuv420p') Or (V='yuv411p') Or (
   V='gray') Or (V='gray8') Or (V='y8') Or (V='yuvj420p') Or (V='yuvj422p') Or (
   V='yuvj444p')) Then Begin
   Assign(F,OutNm); {$I-}Rewrite(F,1);{$I+} If IOResult=0 Then Close(F);
   If (V='yuva444p') Or (V='gray9le') Or (V='gray10le') Or (V='gray12le') Or (
    V='gray16le') Or
      ((Copy(V,1,3)='yuv') And (Pos('p',V)=7) And (Copy(V,Length(V)-1,2)='le')
       And (Pos(Copy(V,4,3),'444422420')>0)) Then Begin
    O1Msg(16,'[yuv4mpegpipe @ 0x55a0c1f2d640] '''+V+
     ''' is not an official yuv4mpegpipe pixel format. Use ''-strict -1'' to e'+
     'ncode to this pixel format.');
    O1Msg(16,
     '[out#0/yuv4mpegpipe @ 0x55a0c1f2d640] Could not write header (incorrect '+
     'codec parameters ?): Invalid argument');
    O1Msg(16,'Error while filtering: Invalid argument');
    O1Msg(16,
     '[out#0/yuv4mpegpipe @ 0x55a0c1f2d640] Nothing was written into output fi'+
     'le, because at least one of its streams received no packets.');
    O1Msg(16,'Conversion failed!');
    O1Die(234);
   End;
   O1Msg(16,
    '[yuv4mpegpipe @ 0x55a0c1f2d640] ERROR: yuv4mpeg can only handle yuv444p, '+
    'yuv422p, yuv420p, yuv411p and gray8 pixel formats. And using ''strict -'+
    '1'' also yuv444p9, yuv422p9, yuv420p9, yuv444p10, yuv422p10, yuv420p10, y'+
    'uv444p12, yuv422p12, yuv420p12, yuv444p14, yuv422p14, yuv420p14, yuv444p1'+
    '6, yuv422p16, yuv420p16, yuva444p, gray9, gray10, gray12 and gray16 pixel'+
    ' formats. Use -pix_fmt to select one.');
   O1Msg(16,
    '[out#0/yuv4mpegpipe @ 0x55a0c1f2d640] Could not write header (incorrect c'+
    'odec parameters ?): Input/output error');
   O1Msg(16,'Error while filtering: Input/output error');
   O1Msg(16,
    '[out#0/yuv4mpegpipe @ 0x55a0c1f2d640] Nothing was written into output fil'+
    'e, because at least one of its streams received no packets.');
   O1Msg(16,'Conversion failed!');
   O1Die(251);
  End;
 End;
 If O1Sz Then Begin
  O1DstW:=O1SzW; O1DstH:=O1SzH;
  If V='' Then V:=O1NativeFm(O1CodecOf(O1OutG,OutNm));
 End;
 If V<>'' Then Begin
  K:=F5FindFm(V);
  If (K>=0) And O1CanScaleFm(K) Then Begin O1DstFm:=K; If PixI>0 Then O1Used[
   O1Op[PixI].Tok]:=True; End;
 End;
 If Not InIsY4M And Not InIsWav And Not O1Strong Then Exit;   { -pix_fmt /
  -aspect seuls sur une entree decodee : chemin historique }
 OutFmtN:=O1OutFmtName(O1OutG,OutNm);
 O1VSMode:=O1VSyncMode(OutFmtN);
 AudOut:=O1IsAudioFmt(OutFmtN);
 SrcV:=InNm; SrcA:=InNm;
 If InIsY4M Then AudOut:=False;
 If InIsWav Then AudOut:=True;
 If Not InIsY4M And Not InIsWav Then Begin
  { decodage de l'entree par le programme }
  For K:=0 To 1 Do Begin
   If (K=0) Xor AudOut Then Begin
    { video }
    O1Tmp1:=O1TmpName('.y4m'); Rc:=O1Exec(O1ChildLine(InNm,True,O1Tmp1,
     ' -f yuv4mpegpipe',1));
    If (Rc<>0) Or Not O1FileExists(O1Tmp1) Then Begin
     F5DelTmp(O1Tmp1);
     O1Tmp1:=O1TmpName('.y4m'); Rc:=O1Exec(O1ChildLine(InNm,True,O1Tmp1,
      ' -pix_fmt yuv420p -f yuv4mpegpipe',1));
    End;
    If (Rc=0) And O1FileExists(O1Tmp1) Then Begin SrcV:=O1Tmp1; AudOut:=False;
     Break; End;
    F5DelTmp(O1Tmp1);
   End Else Begin
    O1Tmp1:=O1TmpName('.wav'); Rc:=O1Exec(O1ChildLine(InNm,True,O1Tmp1,
     ' -f wav',1));
    If (Rc=0) And O1FileExists(O1Tmp1) Then Begin SrcA:=O1Tmp1; AudOut:=True;
     Break; End;
    F5DelTmp(O1Tmp1);
   End;
   If K=1 Then Begin O1Msg(16,InNm+
    ': Invalid data found when processing input'); O1Die(234); End;
  End;
 End;
 If AudOut Then Begin
  V1AudioCheck(OutNm); { V1 }

  O1Tmp2:=O1TmpName('.wav');
  N:=O1AudioJob(SrcA,O1Tmp2);
  If N<0 Then Begin O1Msg(16,SrcA+': Invalid data found when processing input');
   O1Die(234); End;
  Child:=O1ChildLine(O1Tmp2,False,OutNm,'',2);
  Code:=O1Exec(Child);
  O1Die(Code);
 End;
 O1Tmp2:=O1TmpName('.y4m');
 N:=O1VideoJob(SrcV,O1Tmp2);
 If N=0 Then Begin
  { aucune image : sortie vide (en-tete seul pour Y4M) }
  If OutFmtN='yuv4mpegpipe' Then Begin
   Assign(F,O1Tmp2); {$I-}Reset(F,1);{$I+}
   If IOResult=0 Then Begin Close(F); Assign(F,OutNm); {$I-}Erase(F);{$I+} If
    IOResult<>0 Then; Assign(F,O1Tmp2); {$I-}Rename(F,OutNm);{$I+} If
    IOResult<>0 Then Begin O1Msg(16,'Could not open file : '+OutNm); O1Die(234);
    End; End;
   F5DelTmp(O1Tmp2);
   O1Die(0);
  End;
  O1Msg(24,'[out#0/'+OutFmtN+
   ' @ 0x55a0c1f2d640] Output file is empty, nothing was encoded (check -ss / '+
   '-t / -frames parameters if used)');
  O1Die(0);
 End;
 Child:=O1ChildLine(O1Tmp2,False,OutNm,'',2);
 Code:=O1Exec(Child);
 O1Die(Code);
End;

{ ==== O1-END ==== }
{ ==== BLOCK-ANCHOR-O1 : inserer le code du groupe O1 juste au-dessus de cette
 ligne ==== }

{ ======================================================================== }
{ O2 : options de reglage de l'encodeur (ffmpeg 6.1.1)                      }
{   - evaluateur d'expressions libavutil/eval.c (av_expr)                   }
{   - table d'options AVCodecContext, analyse av_opt_set, messages d'erreur }
{   - controle de debit ratecontrol.c (1 passe / 2 passes)                  }
{ ======================================================================== }
Const
 O2_Pi=3.14159265358979323846264338327950288;
 O2_E=2.71828182845904523536028747135266250;
 O2_Phi=1.61803398874989484820458683436563812;
 O2_MaxNodes=1024;
 O2_NV=10;
Type
 TO2Node=Record
  Typ: Integer;
  Val: Double;
  CIdx: LongInt;
  P0,P1,P2: LongInt;
 End;
 TO2Expr=Record
  N: LongInt;
  Nd: Array[0..O2_MaxNodes-1] Of TO2Node;
  Root: LongInt;
  Vars: Array[0..O2_NV-1] Of Double;
  NC: LongInt;
  CNames: Array[0..79] Of String[24];
  CVals: Array[0..79] Of Double;
  Ok: Boolean;
  Err: String;
 End;
 PO2Expr=^TO2Expr;
Const
 { types de noeud (ordre de libavutil/eval.c) }
 e_value=0; e_const=1; e_func0=2; e_func1=3; e_func2=4;
 e_squish=5; e_gauss=6; e_ld=7; e_isnan=8; e_isinf=9;
 e_mod=10; e_max=11; e_min=12; e_eq=13; e_gt=14; e_gte=15; e_lte=16; e_lt=17;
 e_pow=18; e_mul=19; e_div=20; e_add=21;
 e_last=22; e_st=23; e_while=24; e_taylor=25; e_root=26; e_floor=27; e_ceil=28;
  e_trunc=29; e_round=30;
 e_sqrt=31; e_not=32; e_random=33; e_hypot=34; e_gcd=35;
 e_if=36; e_ifnot=37; e_print=38; e_bitand=39; e_bitor=40; e_between=41;
  e_clip=42; e_atan2=43; e_lerp=44;
 e_sgn=45;
 { fonctions a un argument (e_func0 : numero dans CIdx) }
 f0_sinh=1; f0_cosh=2; f0_tanh=3; f0_sin=4; f0_cos=5; f0_tan=6; f0_atan=7;
  f0_asin=8; f0_acos=9; f0_exp=10; f0_log=11; f0_abs=12; f0_time=13;
Var
 O2E: PO2Expr;          { expression en cours d'analyse / d'evaluation }
 O2PS: String;          { chaine en cours d'analyse (sans espaces) }
 O2PP: LongInt;         { position courante (1..) }
 O2StackIdx: LongInt;
 O2Func1Names: Array[0..3] Of String[16];
 O2NFunc1: LongInt;
 O2RceQscale: Single;   { rce courant pour bits2qp / qp2bits }
 O2RceITex,O2RcePTex: LongInt;
 O2LogLine: String;     { dernier message d'erreur de l'evaluateur }

Function O2IsInf(D: Double): Boolean;
Begin
 O2IsInf:=(D>1.7976931348623157E308) Or (D<-1.7976931348623157E308);
End;

Function O2IsNan(D: Double): Boolean;
Begin
 O2IsNan:=D<>D;
End;

Function O2Nan: Double;
Var Q: Int64; D: Double Absolute Q;
Begin
 Q:=Int64($7FF8000000000000); O2Nan:=D;
End;

Function O2Inf: Double;
Var Q: Int64; D: Double Absolute Q;
Begin
 Q:=Int64($7FF0000000000000); O2Inf:=D;
End;

Function O2NegInf: Double;
Begin
 O2NegInf:=-O2Inf;
End;

Function O2Floor(X: Double): Double;
Var T: Double;
Begin
 If O2IsNan(X) Or O2IsInf(X) Or (Abs(X)>=4503599627370496.0) Then Begin
  O2Floor:=X; Exit; End;
 T:=Int(X); If T>X Then T:=T-1;
 O2Floor:=T;
End;

Function O2Ceil(X: Double): Double;
Var T: Double;
Begin
 If O2IsNan(X) Or O2IsInf(X) Or (Abs(X)>=4503599627370496.0) Then Begin O2Ceil:=
  X; Exit; End;
 T:=Int(X); If T<X Then T:=T+1;
 O2Ceil:=T;
End;

Function O2Trunc(X: Double): Double;
Begin
 If O2IsNan(X) Or O2IsInf(X) Or (Abs(X)>=4503599627370496.0) Then Begin
  O2Trunc:=X; Exit; End;
 O2Trunc:=Int(X);
End;

Function O2RoundC(X: Double): Double;   { round() du C : demi vers l'infini }
Var T: Double;
Begin
 If O2IsNan(X) Or O2IsInf(X) Or (Abs(X)>=4503599627370496.0) Then Begin
  O2RoundC:=X; Exit; End;
 If X>=0 Then Begin T:=Int(X+0.5); If T-X>0.5 Then T:=T-1; End
 Else Begin T:=-Int(-X+0.5); If X-T>0.5 Then T:=T+1; End;
 O2RoundC:=T;
End;

{ lrint / llrint : arrondi au plus proche pair }
Function O2LRint(X: Double): Int64;
Var F: Double;
Begin
 If O2IsNan(X) Then Begin O2LRint:=Int64($8000000000000000); Exit; End;
 If X>=9.2233720368547758E18 Then Begin O2LRint:=Int64($8000000000000000); Exit;
  End;
 If X<-9.2233720368547758E18 Then Begin O2LRint:=Int64($8000000000000000); Exit;
  End;
 O2LRint:=Round(X);
End;

Function O2Pow(X,Y: Double): Double;
Var L,R: Extended; YI: Int64; Odd_,NegX: Boolean; AX: Double;
Begin
 If Y=0 Then Begin O2Pow:=1; Exit; End;
 If X=1 Then Begin O2Pow:=1; Exit; End;
 If O2IsNan(X) Or O2IsNan(Y) Then Begin O2Pow:=O2Nan; Exit; End;
 YI:=0; Odd_:=False;
 If Not O2IsInf(Y) And (Abs(Y)<9.0E18) And (Int(Y)=Y) Then Begin YI:=Trunc(Y);
  Odd_:=(YI And 1)<>0; End
 Else If Not O2IsInf(Y) And (Abs(Y)>=9.0E18) Then Begin Odd_:=False; End;
 AX:=Abs(X);
 If O2IsInf(Y) Then Begin
  If AX=1 Then Begin O2Pow:=1; Exit; End;
  If (AX<1)=(Y<0) Then O2Pow:=O2Inf Else O2Pow:=0;
  Exit;
 End;
 If X=0 Then Begin
  If Y<0 Then Begin
   If Odd_ And (1/X<0) Then O2Pow:=O2NegInf Else O2Pow:=O2Inf;
  End Else Begin
   If Odd_ And (1/X<0) Then O2Pow:=-0.0 Else O2Pow:=0;
  End;
  Exit;
 End;
 If O2IsInf(X) Then Begin
  If X>0 Then Begin If Y<0 Then O2Pow:=0 Else O2Pow:=O2Inf; End
  Else Begin
   If Y<0 Then Begin If Odd_ Then O2Pow:=-0.0 Else O2Pow:=0; End
   Else Begin If Odd_ Then O2Pow:=O2NegInf Else O2Pow:=O2Inf; End;
  End;
  Exit;
 End;
 NegX:=X<0;
 If NegX And ((Int(Y)<>Y) Or (Abs(Y)>=9.0E18)) Then Begin
  If Int(Y)<>Y Then Begin O2Pow:=O2Nan; Exit; End;
 End;
 If Y=0.5 Then Begin If NegX Then O2Pow:=O2Nan Else O2Pow:=Sqrt(X); Exit; End;
 If Y=1 Then Begin O2Pow:=X; Exit; End;
 If Y=2 Then Begin O2Pow:=X*X; Exit; End;
 If Y=-1 Then Begin O2Pow:=1/X; Exit; End;
 If (Int(Y)=Y) And (Abs(Y)<=64) And Not NegX Then Begin
  { puissance entiere par multiplications en precision etendue }
  R:=1; L:=AX; YI:=Abs(YI);
  While YI>0 Do Begin
   If (YI And 1)<>0 Then R:=R*L;
   YI:=YI Shr 1; If YI>0 Then L:=L*L;
  End;
  If Y<0 Then R:=1/R;
  O2Pow:=R; Exit;
 End;
 L:=Ln(AX)*Y;
 If L>709.78 Then R:=O2Inf Else If L<-745.2 Then R:=0 Else R:=Exp(L);
 If NegX And Odd_ Then R:=-R;
 O2Pow:=R;
End;

Function O2Sinh(X: Double): Double;
Var E1: Extended;
Begin
 If Abs(X)<1E-5 Then Begin O2Sinh:=X+X*X*X/6; Exit; End;
 E1:=Exp(X); O2Sinh:=(E1-1/E1)/2;
End;
Function O2Cosh(X: Double): Double;
Var E1: Extended;
Begin
 E1:=Exp(X); O2Cosh:=(E1+1/E1)/2;
End;
Function O2Tanh(X: Double): Double;
Var E1,E2: Extended;
Begin
 If X>40 Then Begin O2Tanh:=1; Exit; End;
 If X<-40 Then Begin O2Tanh:=-1; Exit; End;
 If Abs(X)<1E-5 Then Begin O2Tanh:=X-X*X*X/3; Exit; End;
 E1:=Exp(X); E2:=1/E1; O2Tanh:=(E1-E2)/(E1+E2);
End;
Function O2Tan(X: Double): Double;
Begin
 O2Tan:=Sin(X)/Cos(X);
End;
Function O2Asin(X: Double): Double;
Begin
 If (X>1) Or (X<-1) Then Begin O2Asin:=O2Nan; Exit; End;
 If X=1 Then Begin O2Asin:=O2_Pi/2; Exit; End;
 If X=-1 Then Begin O2Asin:=-O2_Pi/2; Exit; End;
 O2Asin:=ArcTan(X/Sqrt(1-X*X));
End;
Function O2Acos(X: Double): Double;
Begin
 If (X>1) Or (X<-1) Then Begin O2Acos:=O2Nan; Exit; End;
 If X=1 Then Begin O2Acos:=0; Exit; End;
 If X=-1 Then Begin O2Acos:=O2_Pi; Exit; End;
 O2Acos:=O2_Pi/2-O2Asin(X);
End;
Function O2Atan2(Y,X: Double): Double;
Var R: Extended;
Begin
 If O2IsNan(X) Or O2IsNan(Y) Then Begin O2Atan2:=O2Nan; Exit; End;
 If X=0 Then Begin
  If Y>0 Then O2Atan2:=O2_Pi/2 Else If Y<0 Then O2Atan2:=-O2_Pi/2 Else If 1/X<0
   Then Begin If 1/Y<0 Then O2Atan2:=-O2_Pi Else O2Atan2:=O2_Pi; End Else
   O2Atan2:=Y;
  Exit;
 End;
 R:=ArcTan(Y/X);
 If X<0 Then Begin If Y>=0 Then R:=R+O2_Pi Else R:=R-O2_Pi; End;
 O2Atan2:=R;
End;
Function O2Hypot(X,Y: Double): Double;
Begin
 O2Hypot:=Sqrt(X*X+Y*Y);
End;
Function O2Exp(X: Double): Double;
Begin
 If X>709.78 Then O2Exp:=O2Inf Else If X<-745.2 Then O2Exp:=0 Else O2Exp:=Exp(
  X);
End;
Function O2Log(X: Double): Double;
Begin
 If O2IsNan(X) Then O2Log:=X Else If X<0 Then O2Log:=O2Nan Else If X=0 Then
  O2Log:=O2NegInf Else If O2IsInf(X) Then O2Log:=X Else O2Log:=Ln(X);
End;
Function O2Gcd(A,B: Double): Double;
Var X,Y, U,V: Int64; Za,Zb,K: LongInt;
 Function Cv(D: Double) : Int64;
Begin
 If O2IsNan(D) Or (D>=9223372036854775807.0) Or (D<-9223372036854775808.0) Then
  Cv:=Low(Int64) Else Cv :=Trunc(
D);
 End;
 Function Ab(T: Int64): Int64;
 Begin If T<0 Then Ab:=-T Else Ab:=T; End;
Begin
 { av_gcd (pgcd binaire) : si une des valeurs est nulle, l'autre est renvoyee
  telle quelle }
 X:=Cv(
A); Y:= Cv (B);
 If X = 0 Then
Begin O2Gcd:=Y; Exit; End;
 If Y=0 Then Begin O2Gcd:=
 X
; Exit; End;
 Za:=0; U
:= X;
While (U And 1)=0 Do Begin U:=U Div 2; Inc(Za);
 If
Za>62 Then Break; End;
 Zb:=0; V:=
 Y ; While (V And 1)= 0
Do Begin V:=V Div 2; Inc(Zb); If Zb>62
 Then Break; End;
 If Za<Zb Then K:=Za Else K := Zb;
 U:=Ab(X Div (Int64(1) Shl Za)); V:=Ab( Y
Div (Int64(1) Shl Zb))
;
 While U <>
V Do Begin
  If U>V Then Begin Y:=U; U:=V; V:=Y; End;
  V:=V-U;
  While (V And 1)=
0 Do V := V Div 2 ; End;
 O2Gcd:= U*(Int64(1) Shl K) ;
End;

{ ---- strtod / av_strtod ---- }
Function O2HexVal(C: Char): Integer;
Begin
 If (C>='0') And (C<='9') Then O2HexVal:=Ord(C)-48
 Else If (C>='a') And (C<='f') Then O2HexVal:=Ord(C)-87
 Else If (C>='A') And (C<='F') Then O2HexVal:=Ord(C)-55
 Else O2HexVal:=-1;
End;

Function O2Pow10(E: LongInt): Extended;
Var R,B: Extended; N: LongInt;
Begin
 R:=1; B:=10; N:=Abs(E);
 While N>0 Do Begin
  If (N And 1)<>0 Then R:=R*B;
  B:=B*B; N:=N Shr 1;
 End;
 If E<0 Then R:=1/R;
 O2Pow10:=R;
End;

{ strtod du C sur S a partir de P ; retourne la valeur, Nxt = position suivante
 (= P si aucune conversion) }
Function O2Strtod(Const S: String; P: LongInt; Var Nxt: LongInt): Double;
Var
 I,Start,Digits,ExpV,ExpSign,DecN,K: LongInt; Neg: Boolean; M: Int64; Mant:
  Extended; Frac,Any,Big: Boolean; R: Extended; T: String; C: Char;
 HexM: Extended; HE: LongInt;
Begin
 Nxt:=P; I:=P; Neg:=False;
 If (I<=Length(S)) And ((S[I]='+') Or (S[I]='-')) Then Begin Neg:=S[I]='-'; Inc(
  I); End;
 Start:=I;
 { inf / nan }
 If (I<=Length(S)) And ((UpCase(S[I])='I') Or (UpCase(S[I])='N')) Then Begin
  T:=Lower(Copy(S,I,8));
  If Copy(T,1,3)='inf' Then Begin
   If Copy(T,1,8)='infinity' Then Nxt:=I+8 Else Nxt:=I+3;
   If Neg Then O2Strtod:=O2NegInf Else O2Strtod:=O2Inf; Exit;
  End;
  If Copy(T,1,3)='nan' Then Begin
   Nxt:=I+3;
   If (Nxt<=Length(S)) And (S[Nxt]='(') Then Begin
    K:=Nxt+1;
    While (K<=Length(S)) And (S[K] In ['0'..'9','a'..'z','A'..'Z','_']) Do Inc(
     K);
    If (K<=Length(S)) And (S[K]=')') Then Nxt:=K+1;
   End;
   O2Strtod:=O2Nan; Exit;
  End;
  O2Strtod:=0; Exit;
 End;
 { flottant hexadecimal }
 If (I+1<=Length(S)) And (S[I]='0') And ((S[I+1]='x') Or (S[I+1]='X')) Then
  Begin
  K:=I+2; HexM:=0; HE:=0; Any:=False; Frac:=False;
  While K<=Length(S) Do Begin
   If O2HexVal(S[K])>=0 Then Begin HexM:=HexM*16+O2HexVal(S[K]); Any:=True; If
    Frac Then HE:=HE-4; Inc(K); End
   Else If (S[K]='.') And Not Frac Then Begin Frac:=True; Inc(K); End
   Else Break;
  End;
  If Not Any Then Begin
   { seul "0" est converti }
   Nxt:=I+1; O2Strtod:=0; If Neg Then O2Strtod:=-0.0; Exit;
  End;
  If (K<=Length(S)) And ((S[K]='p') Or (S[K]='P')) Then Begin
   DecN:=K+1; ExpSign:=1;
   If (DecN<=Length(S)) And ((S[DecN]='+') Or (S[DecN]='-')) Then Begin If S[
    DecN]='-' Then ExpSign:=-1; Inc(DecN); End;
   If (DecN<=Length(S)) And (S[DecN] In ['0'..'9']) Then Begin
    ExpV:=0;
    While (DecN<=Length(S)) And (S[DecN] In ['0'..'9']) Do Begin If ExpV<100000
     Then ExpV:=ExpV*10+Ord(S[DecN])-48; Inc(DecN); End;
    HE:=HE+ExpSign*ExpV; K:=DecN;
   End;
  End;
  R:=HexM;
  While HE>0 Do Begin R:=R*2; Dec(HE); End;
  While HE<0 Do Begin R:=R/2; Inc(HE); End;
  If Neg Then R:=-R;
  Nxt:=K; O2Strtod:=R; Exit;
 End;
 { decimal }
 Digits:=0; M:=0; DecN:=0; Big:=False; Frac:=False; Mant:=0; Any:=False; ExpV:=
  0;
 K:=I;
 While K<=Length(S) Do Begin
  C:=S[K];
  If (C>='0') And (C<='9') Then Begin
   Any:=True;
   If Not Big Then Begin
    If M<=Int64(900000000000000000) Then Begin M:=M*10+Ord(C)-48; Mant:=M; If
     Frac Then Inc(DecN); End
    Else Begin Big:=True; Mant:=M; If Not Frac Then Inc(ExpV); End;
   End Else Begin
    If Not Frac Then Inc(ExpV);
   End;
   Inc(K);
  End Else If (C='.') And Not Frac Then Begin Frac:=True; Inc(K); End
  Else Break;
 End;
 If Not Any Then Begin Nxt:=P; O2Strtod:=0; Exit; End;
 { exposant }
 If (K<=Length(S)) And ((S[K]='e') Or (S[K]='E')) Then Begin
  I:=K+1; ExpSign:=1;
  If (I<=Length(S)) And ((S[I]='+') Or (S[I]='-')) Then Begin If S[I]='-' Then
   ExpSign:=-1; Inc(I); End;
  If (I<=Length(S)) And (S[I] In ['0'..'9']) Then Begin
   Digits:=0;
   While (I<=Length(S)) And (S[I] In ['0'..'9']) Do Begin If Digits<100000 Then
    Digits:=Digits*10+Ord(S[I])-48; Inc(I); End;
   ExpV:=ExpV+ExpSign*Digits; K:=I;
  End;
 End;
 Nxt:=K;
 ExpV:=ExpV-DecN;
 If M=0 Then Begin If Neg Then O2Strtod:=-0.0 Else O2Strtod:=0; Exit; End;
 If (Not Big) And (M<9007199254740992) And (ExpV>=-22) And (ExpV<=22) Then Begin
  If ExpV>=0 Then R:=(M*1.0)*Double(O2Pow10(ExpV)) Else R:=(M*1.0)/Double(
   O2Pow10(-ExpV));
 End Else Begin
  If ExpV>400 Then R:=O2Inf
  Else If ExpV<-400 Then R:=0
  Else Begin
   R:=Mant;
   If ExpV>=0 Then R:=R*O2Pow10(ExpV) Else R:=R/O2Pow10(-ExpV);
  End;
 End;
 If Neg Then R:=-R;
 If R>1.7976931348623157E308 Then R:=O2Inf Else If R<-1.7976931348623157E308
  Then R:=O2NegInf;
 O2Strtod:=R;
End;

{ strtoul base 16 sur S a partir de P }
Function O2StrtoulHex(Const S: String; P: LongInt; Var Nxt: LongInt): Double;
Var I: LongInt; V: Extended; Any: Boolean;
Begin
 I:=P; V:=0; Any:=False;
 If (I+1<=Length(S)) And (S[I]='0') And ((S[I+1]='x') Or (S[I+1]='X')) And (I+
  2<=Length(S)) And (O2HexVal(S[I+2])>=0) Then Inc(I,2);
 While (I<=Length(S)) And (O2HexVal(S[I])>=0) Do Begin V:=V*16+O2HexVal(S[I]);
  Any:=True; Inc(I); End;
 If Not Any Then Begin Nxt:=P; O2StrtoulHex:=0; Exit; End;
 Nxt:=I;
 If V>18446744073709551615.0 Then V:=18446744073709551615.0;
 O2StrtoulHex:=V;
End;

Function O2SiExp(C: Char; Var BinV,DecV: Double): Integer;
Begin
 O2SiExp:=0; BinV:=1; DecV:=1;
 Case C Of
  'y': Begin BinV:=8.271806125530276749e-25; DecV:=1e-24; O2SiExp:=-24; End;
  'z': Begin BinV:=8.4703294725430034e-22; DecV:=1e-21; O2SiExp:=-21; End;
  'a': Begin BinV:=8.6736173798840355e-19; DecV:=1e-18; O2SiExp:=-18; End;
  'f': Begin BinV:=8.8817841970012523e-16; DecV:=1e-15; O2SiExp:=-15; End;
  'p': Begin BinV:=9.0949470177292824e-13; DecV:=1e-12; O2SiExp:=-12; End;
  'n': Begin BinV:=9.3132257461547852e-10; DecV:=1e-9; O2SiExp:=-9; End;
  'u': Begin BinV:=9.5367431640625e-7; DecV:=1e-6; O2SiExp:=-6; End;
  'm': Begin BinV:=9.765625e-4; DecV:=1e-3; O2SiExp:=-3; End;
  'c': Begin BinV:=9.8431332023036951e-3; DecV:=1e-2; O2SiExp:=-2; End;
  'd': Begin BinV:=9.921256574801246e-2; DecV:=1e-1; O2SiExp:=-1; End;
  'h': Begin BinV:=1.0159366732596479e2; DecV:=1e2; O2SiExp:=2; End;
  'k','K': Begin BinV:=1.024e3; DecV:=1e3; O2SiExp:=3; End;
  'M': Begin BinV:=1.048576e6; DecV:=1e6; O2SiExp:=6; End;
  'G': Begin BinV:=1.073741824e9; DecV:=1e9; O2SiExp:=9; End;
  'T': Begin BinV:=1.099511627776e12; DecV:=1e12; O2SiExp:=12; End;
  'P': Begin BinV:=1.125899906842624e15; DecV:=1e15; O2SiExp:=15; End;
  'E': Begin BinV:=1.152921504606847e18; DecV:=1e18; O2SiExp:=18; End;
  'Z': Begin BinV:=1.1805916207174113e21; DecV:=1e21; O2SiExp:=21; End;
  'Y': Begin BinV:=1.2089258196146292e24; DecV:=1e24; O2SiExp:=24; End;
 End;
End;

{ av_strtod }
Function O2AvStrtod(Const S: String; P: LongInt; Var Nxt: LongInt): Double;
Var D,BinV,DecV: Double; E: Integer; Nx: LongInt; C1: Char;
Begin
 If (P+1<=Length(S)) And (S[P]='0') And ((Ord(S[P+1]) Or $20)=Ord('x')) Then D:=
  O2StrtoulHex(S,P,Nx)
 Else D:=O2Strtod(S,P,Nx);
 If Nx<>P Then Begin
  If (Nx+1<=Length(S)) And (S[Nx]='d') And (S[Nx+1]='B') Then Begin
   D:=O2Pow(10,D/20); Nx:=Nx+2;
  End Else If (Nx<=Length(S)) And (S[Nx]>='E') And (S[Nx]<='z') Then Begin
   E:=O2SiExp(S[Nx],BinV,DecV);
   If E<>0 Then Begin
    If (Nx+1<=Length(S)) And (S[Nx+1]='i') Then Begin D:=D*BinV; Nx:=Nx+2; End
    Else Begin D:=D*DecV; Inc(Nx); End;
   End;
  End;
  If (Nx<=Length(S)) And (S[Nx]='B') Then Begin D:=D*8; Inc(Nx); End;
 End;
 Nxt:=Nx;
 O2AvStrtod:=D;
End;

{ ---- analyse ---- }
Function O2IsIdChar(C: Char): Boolean;
Begin
 O2IsIdChar:=(C In ['0'..'9','a'..'z','A'..'Z','_']);
End;

Function O2StrMatch(Const Pre: String; At: LongInt): Boolean;
Var I: Integer;
Begin
 O2StrMatch:=False;
 For I:=1 To Length(Pre) Do Begin
  If At+I-1>Length(O2PS) Then Exit;
  If O2PS[At+I-1]<>Pre[I] Then Exit;
 End;
 If At+Length(Pre)>Length(O2PS) Then O2StrMatch:=True
 Else O2StrMatch:=Not O2IsIdChar(O2PS[At+Length(Pre)]);
End;

Function O2NewNode: LongInt;
Begin
 If O2E^.N>=O2_MaxNodes Then Begin O2NewNode:=-1; Exit; End;
 O2NewNode:=O2E^.N;
 FillChar(O2E^.Nd[O2E^.N],SizeOf(TO2Node),0);
 O2E^.Nd[O2E^.N].P0:=-1; O2E^.Nd[O2E^.N].P1:=-1; O2E^.Nd[O2E^.N].P2:=-1;
 Inc(O2E^.N);
End;

Function O2MakeNode(Typ: Integer; Val: Double; A,B: LongInt): LongInt;
Var N: LongInt;
Begin
 N:=O2NewNode;
 If N>=0 Then Begin
  O2E^.Nd[N].Typ:=Typ; O2E^.Nd[N].Val:=Val; O2E^.Nd[N].P0:=A; O2E^.Nd[N].P1:=B;
 End;
 O2MakeNode:=N;
End;

