Begin
 F1OutFmt:=(N='au') Or (N='voc') Or (N='flac') Or (N='mmf') Or (N='tta') Or (
  N='wsaud') Or (N='eac3') Or (N='gsm') Or (N='wv') Or (N='dts') Or (N='mlp') Or
  (N='amr');
End;
{ CRYO APC (libavformat/apc.c) + adpcm_ima_apc }
Procedure F1DecodeAPC(Const Source,Target: String);
Var F: PEABuffer; Size,Rate,Ch,I,V,P0,P1: LongInt; B: Byte;
 Function L32(At: LongInt): Int64; Begin L32:=Int64(F^[At])+Int64(F^[At+1])*256+
  Int64(F^[At+2])*65536+Int64(F^[At+3])*16777216; End;
 Function C18(X: Int64): LongInt; Begin If X>=2147483648 Then X:=X-4294967296;
  If X>262143 Then X:=262143; If X<-262144 Then X:=-262144; C18:=X; End;
Begin
 NVLoad(Source,F,Size); CloseRead;
 If Size<32 Then Fail('apc: en-tete tronque.');
 Rate:=L32(16); If L32(28)<>0 Then Ch:=2 Else Ch:=1;
 If (Rate<1) Or (Rate>2147483647) Then Fail('apc: frequence incorrecte.');
 IMAReset; IMAPred[0]:=C18(L32(20)); IMAPred[1]:=C18(L32(24));
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,Ch,0);
 For I:=32 To Size-1 Do Begin
  B:=F^[I];
  EAPut(IMAExpand(0,B Shr 4,3));
  EAPut(IMAExpand(Ch-1,B And 15,3));
 End;
 EAFlush;
 If EAWritten=0 Then Fail('apc: aucune donnee audio.');
 ADPCMPatchHeader(Rate,Ch,EAWritten); CloseWrite; FreeMem(F);
End;

{ EA cdata (libavformat/eacdata.c) + adpcm_ea_xas }
Procedure F1DecodeCData(Const Source,Target: String);
Var F: PEABuffer; Size,Rate,Ch,H,Off: LongInt;
Begin
 NVLoad(Source,F,Size); CloseRead;
 H:=F^[0]*256+F^[1];
 Case H Of $400: Ch:=1; $404: Ch:=2; $40C: Begin Ch:=4; F1MaskOver:=$33; End;
  $414: Begin Ch:=6; F1MaskOver:=$3F; End;
  Else Fail('ea_cdata: en-tete inconnu.'); End;
 Rate:=F^[2]*256+F^[3];
 If (F^[4] And $20)<>0 Then Off:=5+15 Else Off:=5+11;
 If Off>Size Then Fail('ea_cdata: fichier tronque.');
 Move(F^[Off],F^[0],Size-Off); Size:=Size-Off;
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,Ch,0);
 EADecodeXAS(F,Size,Ch); EAFlush;
 If EAWritten=0 Then Fail('ea_cdata: aucune donnee audio.');
 ADPCMPatchHeader(Rate,Ch,EAWritten); CloseWrite; FreeMem(F);
End;
{ Yamaha SMAF (libavformat/mmf.c) }
Procedure F1MuxMMF(Const WavTmp,Target: String);
Var H: Array[0..63] Of Byte; Lim,Rate,Ch,DSz,Code,I,Gate,Pos: LongInt; Ver:
 String; Out: Array[0..255] Of Byte; N: LongInt; Buf: PEABuffer;
 Cnt: LongInt;
 Procedure P8(V: LongInt); Begin Out[N]:=V And 255; Inc(N); End;
 Procedure PB32(V: LongInt); Begin P8(V Shr 24); P8(V Shr 16); P8(V Shr 8); P8(
  V); End;
 Procedure PTag(Const T: String); Var K: LongInt; Begin For K:=1 To 4 Do P8(Ord(
  T[K])); End;
 Procedure VarLen(V: LongInt); Begin If V<128 Then P8(V) Else Begin Dec(V,128);
  P8($80 Or (V Shr 7)); P8($7F And V); End; End;
Begin
 OpenRead(WavTmp); Lim:=InputSize; ReadAt(0,H,58);
 Ch:=H[22]; Rate:=H[24]+H[25]*256+H[26]*65536;
 DSz:=H[54]+H[55]*256+H[56]*65536+H[57]*16777216;
 Code:=-1; If Rate=4000 Then Code:=0 Else If Rate=8000 Then Code:=1 Else If
  Rate=11025 Then Code:=2 Else If Rate=22050 Then Code:=3 Else If Rate=44100
  Then Code:=4;
 If Code<0 Then Fail('Unsupported sample rate '+
  'for mmf, supported are 4000, 8000, 11025, 22050 and 44100');
 If (Ch>1) And Not LJUnofficial Then Fail(
  'Yamaha SMAF stereo is experimental, add ''-strict -2'' if you want to use i'+
  't.');
 If VGBitExact Then Ver:='VN:Lavf,' Else Ver:='VN:Lavf60.16.100,';
 OpenWrite(Target); N:=0;
 PTag('MMMD'); PB32(0);
 PTag('CNTI'); PB32(5); P8(0); P8(1); P8(1); P8(0); P8(0);
 PTag('OPDA'); PB32(Length(Ver)); For I:=1 To Length(Ver) Do P8(Ord(Ver[I]));
 Pos:=N; { debut ATR }
 P8(65); P8(84); P8(82); P8(0);
 PB32(6+8+16+8+DSz);
 P8(0); P8(0); P8(((Ch-1) Shl 7) Or (1 Shl 4) Or Code); P8(0); P8(2); P8(2);
 PTag('Atsq'); PB32(16);
 Gate:=(Int64(DSz)*500) Div Rate;
 Cnt:=N; P8(0); P8(((Ch-1) Shl 6) Or 1); VarLen(Gate); VarLen(Gate); P8($FF);
  P8(0); P8(0); P8(0); P8(0); P8(0);
 While N-Cnt<16 Do P8(0);
 P8(65); P8(119); P8(97); P8(1);
 PB32(DSz);
 { taille MMMD : fichier - 8 }
 I:=N+DSz-8; Out[4]:=I Shr 24; Out[5]:=I Shr 16; Out[6]:=I Shr 8; Out[7]:=I;
 WriteBytes(Out,N);
 GetMem(Buf,DSz+16);
 I:=0; While I<DSz Do Begin Cnt:=DSz-I; If Cnt>30000 Then Cnt:=30000; ReadAt(58+
  I,Buf^[I],Cnt); Inc(I,Cnt); End;
 CloseRead;
 I:=0; While I<DSz Do Begin Cnt:=DSz-I; If Cnt>30000 Then Cnt:=30000;
  WriteBytes(Buf^[I],Cnt); Inc(I,Cnt); End;
 CloseWrite; FreeMem(Buf);
End;

Procedure F1DecodeMMF(Const Source,Target: String);
Var F: PEABuffer; Size,At,Tag,Sz,Params,Rate,Ch,DEnd,DLen,I,Tmp: LongInt; Name:
 String; Fv: File;
 Function T4(P: LongInt): LongInt; Begin T4:=F^[P]+F^[P+1]*256+F^[P+2]*65536+F^[
  P+3]*16777216; End;
 Function B4(P: LongInt): LongInt; Begin B4:=F^[P+3]+F^[P+2]*256+F^[P+1]*65536+
  F^[P]*16777216; End;
 Procedure W8(V: LongInt); Var B: Byte; Begin B:=V And 255; WriteBytes(B,1);
  End;
 Procedure W16(V: LongInt); Begin W8(V); W8(V Shr 8); End;
 Procedure W32(V: LongInt); Begin W16(V); W16(V Shr 16); End;
 Procedure WT(Const T: String); Var K: LongInt; Begin For K:=1 To 4 Do W8(Ord(T[
  K])); End;
Begin
 NVLoad(Source,F,Size); CloseRead;
 If T4(0)<>$444D4D4D Then Fail('mmf: signature incorrecte.');
 At:=8;
 Repeat
  If At+8>Size Then Fail('mmf: fichier tronque.');
  Tag:=T4(At); Sz:=B4(At+4); Inc(At,8);
  If (Tag=$49544E43) Or (Tag=$4144504F) Then Inc(At,Sz) Else Break;
 Until False;
 If (Tag And $FFFFFF)=$52544D Then Fail('MIDI like format found, unsupported');
 If (Tag And $FFFFFF)<>$525441 Then Fail('Unsupported SMAF chunk');
 If At+6>Size Then Fail('mmf: fichier tronque.');
 Params:=F^[At+2]; Inc(At,6);
 Case Params And 15 Of 0: Rate:=4000; 1: Rate:=8000; 2: Rate:=11025; 3: Rate:=
  22050; 4: Rate:=44100; Else Fail('Invalid sample rate'); End;
 Ch:=(Params Shr 7)+1;
 Repeat
  If At+8>Size Then Fail('mmf: fichier tronque.');
  Tag:=T4(At); Sz:=B4(At+4); Inc(At,8);
  If (Tag=$71737441) Or (Tag=$49707341) Then Inc(At,Sz) Else Break;
 Until False;
 If (Tag And $FFFFFF)<>$617741 Then Fail('Unexpected SMAF chunk');
 DEnd:=At+Sz; DLen:=Sz; If At+DLen>Size Then DLen:=Size-At;
 If DLen<=0 Then Fail('mmf: aucune donnee audio.');
 Name:=Target+'.yam'; If Exists(Name) Then Fail(
  'Sortie intermediaire deja existante.');
 OpenWrite(Name);
 WT('RIFF'); W32(4+8+18+8+DLen); WT('WAVE'); WT('fmt '); W32(18); W16($20); W16(
  Ch); W32(Rate); W32(Rate*Ch*4 Div 8); W16(1024); W16(4); W16(0);
 WT('data'); W32(DLen);
 I:=0; While I<DLen Do Begin Tmp:=DLen-I; If Tmp>30000 Then Tmp:=30000;
  WriteBytes(F^[At+I],Tmp); Inc(I,Tmp); End;
 CloseWrite; FreeMem(F);
 DecodeWaveBlocks(Name,Target);
 Assign(Fv,Name); Erase(Fv);
End;
{ F1-PCM2-END }
{ PCM-END }


