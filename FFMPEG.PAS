  History: Array[0..1,0..511] Of Double;
  Previous: Array[0..1,0..575] Of Double;
  Spectrum: Array[0..1,0..1,0..575] Of Double;
  Quantized: Array[0..1,0..1,0..575] Of Integer;
  Gain, TableNumber, PairCount, BitCount: Array[0..1,0..1] Of Integer;
 End;
 PState = ^TState;
 TTransforms = Record
  Filter: Array[0..31,0..63] Of Double;
  MDCT: Array[0..17,0..35] Of Double;
  CS, CA: Array[0..7] Of Double;
 End;
 PTransforms = ^TTransforms;

Var
 State: PState;
 Transform: PTransforms;
 WAVPosition, WAVRemaining: LongInt;
 WAVBits, WAVAlign, RateIndex, BitRateIndex: Integer;
 Codes: Array[0..1,0..255] Of LongInt;
 CodeLengths: Array[0..1,0..255] Of Byte;
 Frame: Array[0..2047] Of Byte;
 BitPosition, FrameBytes: Integer;
 PaddingRemainder, EncodedFrames: LongInt;

Function LE16(Const B; Offset: Integer): Word;
Type
 TSmallBytes = Array[0..63] Of Byte;
Begin
 LE16 := Word(TSmallBytes(B)[Offset]) Or (Word(TSmallBytes(B)[Offset+1]) Shl 8);
End;

Function LE32(Const B; Offset: Integer): LongInt;
Type
 TSmallBytes = Array[0..63] Of Byte;
Begin
 If TSmallBytes(B)[Offset+3] >= 128 Then Fail('Valeur RIFF depassant 2 Go.');
 LE32 := LongInt(TSmallBytes(B)[Offset]) + LongInt(TSmallBytes(B)[Offset+1])*256 +
 LongInt(TSmallBytes(B)[Offset+2])*65536 + LongInt(TSmallBytes(B)[Offset+3])*16777216;
End;

Function TagIs(Const B; Const Tag: String): Boolean;
Type
 TSmallBytes = Array[0..63] Of Byte;
Var
 J: Integer;
 Equal: Boolean;
Begin
 Equal := True;
 For J := 1 To 4 Do  If TSmallBytes(B)[J-1] <> Ord(Tag[J]) Then Equal := False;
 TagIs := Equal;
End;

Procedure OpenWave;
Var
 B: Array[0..63] Of Byte;
 Position, RiffEnd, ChunkSize, DataStart, DataSize: LongInt;
 Bits, BlockAlign, Code: Integer;
 OldMode: Byte;
 HasFormat, HasData: Boolean;
Begin
 Assign(InputFile, InputName); OldMode := FileMode; FileMode := 0;
 {$I-}Reset(InputFile, 1); Code := IOResult;{$I+}
 FileMode := OldMode;
 If Code <> 0 Then Fail('Ouverture WAV impossible: ' + InputName);
 InputOpen := True;
 {$I-}InputSize := FileSize(InputFile); Code := IOResult;{$I+}
 If (Code <> 0) Or (InputSize < 12) Then Fail('WAV vide, trop grand ou tronque.');
 ReadAt(0, B, 12);
 If Not TagIs(B, 'RIFF') Then Fail('RIFF/WAVE requis (RF64 et RIFX non pris en charge).');
 If (B[8] <> Ord('W')) Or (B[9] <> Ord('A')) Or (B[10] <> Ord('V')) Or (B[11] <> Ord('E'))
 Then  Fail('Signature WAVE manquante.');
 RiffEnd := LE32(B, 4);
 If (RiffEnd < 4) Or (RiffEnd > InputSize - 8) Then Fail('Taille RIFF incorrecte.');
 Inc(RiffEnd, 8); Position := 12; HasFormat := False; HasData := False;
 DataStart := 0; DataSize := 0; Bits := 0; BlockAlign := 0;
 While Position < RiffEnd Do Begin
  If RiffEnd - Position < 8 Then Fail('Entete de bloc WAV tronquee.');
  ReadAt(Position, B, 8); ChunkSize := LE32(B, 4); Inc(Position, 8);
  If ChunkSize > RiffEnd - Position Then Fail('Bloc WAV tronque.');
  If TagIs(B, 'fmt ') Then Begin
   If HasFormat Then Fail('Plusieurs blocs fmt non pris en charge.');
   If ChunkSize < 16 Then Fail('Bloc fmt trop court.');
   ReadAt(Position, B, 16);
   If LE16(B, 0) <> 1 Then Fail(
   'WAV PCM entier requis; float, ADPCM et extensible non pris en charge.');
   Header.Channels := LE16(B, 2); Header.Rate := LE32(B, 4);
   BlockAlign := LE16(B, 12); Bits := LE16(B, 14);
   If Not (Header.Channels In [1,2]) Then Fail('WAV mono ou stereo requis.');
   If Not (Bits In [8,16,24,32]) Then Fail('Resolution PCM attendue: 8/16/24/32 bits.');
   If (Header.Rate < 8000) Or (Header.Rate > 192000) Then Fail(
   'Frequence attendue: 8000..192000 Hz.');
   If (BlockAlign <> Header.Channels*(Bits Div 8)) Or
   (LE32(B, 8) <> Header.Rate*BlockAlign) Then Fail('Alignement ou debit PCM incoherent.')
   ;
   HasFormat := True;
  End
  Else If TagIs(B, 'data') Then Begin
   If HasData Then Fail('Plusieurs blocs data non pris en charge.');
   DataStart := Position; DataSize := ChunkSize; HasData := True;
  End;
  Inc(Position, ChunkSize);
  If Odd(ChunkSize) Then Begin
   If Position >= RiffEnd Then Fail('Octet de bourrage RIFF manquant.');
   Inc(Position);
  End;
 End;
 If Not HasFormat Or Not HasData Then Fail('Bloc fmt ou data manquant.');
 If (DataSize = 0) Or (DataSize Mod BlockAlign <> 0) Then Fail(
 'Donnees PCM vides ou echantillon incomplet.');
 WAVPosition := DataStart; WAVRemaining := DataSize;
 WAVBits := Bits; WAVAlign := BlockAlign;
 Case Header.Rate Of 44100: RateIndex := 0; 48000: RateIndex := 1; 32000: RateIndex := 2;
 Else Fail('Frequence MPEG-1 requise: 32000, 44100 ou 48000 Hz.');
End;
End;

Procedure PutBits(Value: LongInt; Count: Integer);
Var
 I: Integer;
Begin
 If BitPosition+Count > FrameBytes*8 Then Fail('Depassement de trame MP3.');
 For I := Count-1 Downto 0 Do Begin
  If ((Value Shr I) And 1) <> 0 Then   Frame[BitPosition Div 8] :=
  Frame[BitPosition Div 8] Or (1 Shl (7-(BitPosition Mod 8)));
  Inc(BitPosition);
 End;
End;

Procedure BuildCodes(SetIndex, Table, Node, Length: Integer; Value: LongInt);
Var
 Leaf: Word;
 Direction, Next, Jump: Integer;
Begin
 If (Node < 0) Or (Node >= HuffLength[Table]) Or (Length > 24) Then Fail(
 'Table Huffman invalide.');
 Leaf := HuffTree[HuffOffset[Table]+Node];
 If Leaf < 256 Then Begin
  Codes[SetIndex,Leaf] := Value; CodeLengths[SetIndex,Leaf] := Length; Exit;
 End;
 For Direction := 0 To 1 Do Begin
  Next := Node;
  Repeat
  Leaf := HuffTree[HuffOffset[Table]+Next];
  If Direction = 0 Then Jump := Leaf Shr 8 Else Jump := Leaf And 255;
  Inc(Next,Jump);
  Until Jump < 250;
  BuildCodes(SetIndex,Table,Next,Length+1,Value*2+Direction);
 End;
End;

Procedure InitializeEncoder;
Const
 CI: Array[0..7] Of Double = (-0.6,-0.535,-0.33,-0.185,-0.095,-0.041,-0.0142,-0.0037);
Var
 I,J: Integer;
Begin
 New(State); New(Transform); FillChar(State^,SizeOf(State^),0);
 For I := 0 To 31 Do
 For J := 0 To 63 Do  Transform^.Filter[I,J] := Cos((2*I+1)*(16-J)*Pi/64);
 For I := 0 To 17 Do
 For J := 0 To 35 Do  Transform^.MDCT[I,J] := Sin(Pi*(J+0.5)/36)*Cos(Pi*(2*J+19)*(2*I+1)/
 72)/9;
 For I := 0 To 7 Do Begin
  Transform^.CS[I] := 1/Sqrt(1+Sqr(CI[I]));
  Transform^.CA[I] := CI[I]*Transform^.CS[I];
 End;
 BuildCodes(0,15,0,0,0); BuildCodes(1,24,0,0,0);
 PaddingRemainder := 0; EncodedFrames := 0;
End;

Procedure AnalyzeGranule(G: Integer);
Var
 Raw: Array[0..255] Of Byte;
 Current: Array[0..1,0..575] Of Double;
 Y: Array[0..63] Of Double;
 T,C,I,J,K,SB,N,Bps,Take: Integer;
 Sample: LongInt;
 Sum,A,B: Double;
Begin
 Bps := WAVBits Div 8;
 For T := 0 To 17 Do Begin
  Take := 32*WAVAlign;
  If WAVRemaining < Take Then Take := WAVRemaining;
  FillChar(Raw,SizeOf(Raw),0);
  If Take > 0 Then Begin
   ReadAt(WAVPosition,Raw,Take); Inc(WAVPosition,Take); Dec(WAVRemaining,Take);
  End;
  For C := 0 To Header.Channels-1 Do Begin
   For I := 511 Downto 32 Do State^.History[C,I] := State^.History[C,I-32];
   For I := 0 To 31 Do Begin
    K := I*WAVAlign+C*Bps; Sample := 0;
    If K < Take Then Begin
     If WAVBits = 8 Then Sample := (LongInt(Raw[K])-128)*256
      Else
     Begin
      Sample := LongInt(Raw[K+Bps-2])+LongInt(Raw[K+Bps-1])*256;
      If Sample >= 32768 Then Dec(Sample,65536);
     End;
    End;
    State^.History[C,31-I] := Sample/32768;
   End;
   For I := 0 To 63 Do Begin
    Sum := 0;
    For J := 0 To 7 Do Begin
     K := I+J*64;
     Sum := Sum+State^.History[C,K]*SynthWindow[K]/32;
    End;
    Y[I] := Sum;
   End;
   For SB := 0 To 31 Do Begin
    Sum := 0;
    For I := 0 To 63 Do Sum := Sum+Y[I]*Transform^.Filter[SB,I];
    If Odd(SB) And Odd(T) Then Sum := -Sum;
    Current[C,SB*18+T] := Sum;
   End;
  End;
 End;
 For C := 0 To Header.Channels-1 Do Begin
  For SB := 0 To 31 Do
  For I := 0 To 17 Do Begin
   Sum := 0;
   For J := 0 To 17 Do Sum := Sum+
   State^.Previous[C,SB*18+J]*Transform^.MDCT[I,J]+
   Current[C,SB*18+J]*Transform^.MDCT[I,J+18];
   State^.Spectrum[G,C,SB*18+I] := Sum;
  End;
  Move(Current[C],State^.Previous[C],SizeOf(Current[C]));
  { Inverse des papillons de reduction d'alias du decodeur. }
  For SB := 1 To 31 Do
  For I := 0 To 7 Do Begin
   K := SB*18-1-I; N := SB*18+I;
   A := State^.Spectrum[G,C,K]; B := State^.Spectrum[G,C,N];
   State^.Spectrum[G,C,K] := A*Transform^.CS[I]+B*Transform^.CA[I];
   State^.Spectrum[G,C,N] := B*Transform^.CS[I]-A*Transform^.CA[I];
  End;
 End;
End;

Function Magnitude(G,C,I: Integer): Integer;Begin
 Magnitude := Abs(State^.Quantized[G,C,I]);
End;

Function HuffCost(G,C,Table,Pairs: Integer): Integer;
Var
 I,X,Y,L,SetIndex,Cost,Limit: Integer;
Begin
 If Table = 15 Then Begin
  SetIndex := 0; Limit := 15;
 End
  Else
 Begin
  SetIndex := 1; Limit := 15+(1 Shl HuffLinBits[Table])-1;
 End;
 Cost := 0;
 For I := 0 To Pairs-1 Do Begin
  X := Magnitude(G,C,I*2); Y := Magnitude(G,C,I*2+1);
  If (X > Limit) Or (Y > Limit) Then Begin
   HuffCost := 30000; Exit;
  End;
  If X > 0 Then Inc(Cost); If Y > 0 Then Inc(Cost);
  If Table <> 15 Then Begin
   If X >= 15 Then Inc(Cost,HuffLinBits[Table]);
   If Y >= 15 Then Inc(Cost,HuffLinBits[Table]);
  End;
  If X > 15 Then X := 15; If Y > 15 Then Y := 15;
  L := CodeLengths[SetIndex,X*16+Y]; Inc(Cost,L);
 End;
 HuffCost := Cost;
End;

Procedure Quantize(G,C,Budget: Integer);
Var
 Powered: Array[0..575] Of Double;
 I,Gain,Pairs,Table,BestTable,BestBits,Cost,Q: Integer;
 Peak,Scale,V: Double;
 TooLarge: Boolean;
Begin
 Peak := 0;
 For I := 0 To 575 Do Begin
  V := Abs(State^.Spectrum[G,C,I]);
  If V > 0 Then Powered[I] := Exp(Ln(V)*0.75) Else Powered[I] := 0;
  If Powered[I] > Peak Then Peak := Powered[I];
 End;
 Gain := 0;
 If Peak > 0 Then Gain := Trunc(210+Ln(Peak/8205)*16/(3*Ln(2)));
 If Gain < 0 Then Gain := 0;
 Repeat
 If Gain > 255 Then Fail('Quantification MP3 impossible.');
 Scale := Exp((210-Gain)*3*Ln(2)/16); TooLarge := False; Pairs := 0;
 For I := 0 To 575 Do Begin
  V := Powered[I]*Scale+0.4054;
  If V > 8206 Then Begin
   TooLarge := True; Q := 8206;
  End Else Q := Trunc(V);
  If Q <> 0 Then Pairs := I Div 2+1;
  If State^.Spectrum[G,C,I] < 0 Then Q := -Q;
  State^.Quantized[G,C,I] := Q;
 End;
 BestBits := 30000; BestTable := 0;
 If Not TooLarge Then Begin
  If Pairs = 0 Then BestBits := 0
   Else
  Begin
   BestTable := 15; BestBits := HuffCost(G,C,15,Pairs);
   For Table := 24 To 31 Do Begin
    Cost := HuffCost(G,C,Table,Pairs);
    If Cost < BestBits Then Begin
     BestBits := Cost; BestTable := Table;
    End;
   End;
  End;
 End;
 If BestBits <= Budget Then Break;
 Inc(Gain);
 Until False;
 State^.Gain[G,C] := Gain; State^.PairCount[G,C] := Pairs;
 State^.TableNumber[G,C] := BestTable; State^.BitCount[G,C] := BestBits;
End;

Procedure EncodePairs(G,C: Integer);
Var
 I,X,Y,A,B,Table,SetIndex: Integer;
Begin
 Table := State^.TableNumber[G,C];
 If Table = 0 Then Exit;
 If Table = 15 Then SetIndex := 0 Else SetIndex := 1;
 For I := 0 To State^.PairCount[G,C]-1 Do Begin
  X := Magnitude(G,C,I*2); Y := Magnitude(G,C,I*2+1); A := X; B := Y;
  If A > 15 Then A := 15; If B > 15 Then B := 15;
  PutBits(Codes[SetIndex,A*16+B],CodeLengths[SetIndex,A*16+B]);
  If (Table <> 15) And (X >= 15) Then PutBits(X-15,HuffLinBits[Table]);
  If X > 0 Then PutBits(Ord(State^.Quantized[G,C,I*2] < 0),1);
  If (Table <> 15) And (Y >= 15) Then PutBits(Y-15,HuffLinBits[Table]);
  If Y > 0 Then PutBits(Ord(State^.Quantized[G,C,I*2+1] < 0),1);
 End;
End;

Procedure EncodeFrame;
Var
 G,C,J,SideBytes,Budget,Padding: Integer;
Begin
 Padding := 0; Inc(PaddingRemainder,(LongInt(BitRateK)*144000) Mod Header.Rate);
 If PaddingRemainder >= Header.Rate Then Begin
  Padding := 1; Dec(PaddingRemainder,Header.Rate);
 End;
 FrameBytes := (LongInt(BitRateK)*144000) Div Header.Rate+Padding;
 If Header.Channels = 1 Then SideBytes := 17 Else SideBytes := 32;
 Budget := (FrameBytes-4-SideBytes)*8 Div (2*Header.Channels);
 If Budget > 4095 Then Budget := 4095;
 For G := 0 To 1 Do Begin
  AnalyzeGranule(G);
  For C := 0 To Header.Channels-1 Do Quantize(G,C,Budget);
 End;
 FillChar(Frame,SizeOf(Frame),0); BitPosition := 0;
 PutBits($7FF,11); PutBits(3,2); PutBits(1,2); PutBits(1,1);
 PutBits(BitRateIndex,4); PutBits(RateIndex,2); PutBits(Padding,1); PutBits(0,1);
 If Header.Channels = 1 Then PutBits(3,2) Else PutBits(0,2);
 PutBits(0,2); PutBits(0,1); PutBits(1,1); PutBits(0,2);
 PutBits(0,9);
 If Header.Channels = 1 Then PutBits(0,5) Else PutBits(0,3);
 For C := 0 To Header.Channels-1 Do PutBits(0,4);
 For G := 0 To 1 Do
 For C := 0 To Header.Channels-1 Do Begin
  PutBits(State^.BitCount[G,C],12); PutBits(State^.PairCount[G,C],9);
  PutBits(State^.Gain[G,C],8); PutBits(0,4); PutBits(0,1);
  For J := 0 To 2 Do PutBits(State^.TableNumber[G,C],5);
  PutBits(7,4); PutBits(5,3);
  PutBits(0,1); PutBits(0,1); PutBits(0,1);
 End;
 If BitPosition <> (4+SideBytes)*8 Then Fail('Entete MP3 interne incorrecte.');
 For G := 0 To 1 Do
 For C := 0 To Header.Channels-1 Do EncodePairs(G,C);
 If Written > 2147483600-FrameBytes Then Fail('Sortie MP3 depassant 2 Go.');
 WriteBytes(Frame,FrameBytes); Inc(Written,FrameBytes); Inc(EncodedFrames);
End;

Procedure Convert;
Var
 Code,J: Integer;
Begin
 OpenWave; InitializeEncoder;
 If Exists(OutputName) Then Fail('Le fichier de sortie existe deja: '+OutputName);
 Assign(OutputFile,OutputName);
 {$I-}Rewrite(OutputFile,1); Code := IOResult;{$I+}
 If Code <> 0 Then Fail('Creation MP3 impossible.');
 OutputOpen := True; OutputCreated := True; Written := 0;
 WriteLn('Encodage MPEG-1 Layer III ',BitRateK,' kbit/s...');
 While WAVRemaining > 0 Do EncodeFrame;
 { Vidange des retards du filtre polyphase et de la MDCT. }
 For J := 1 To 2 Do EncodeFrame;
 {$I-}Close(InputFile); Code := IOResult;{$I+} InputOpen := False;
 If Code <> 0 Then Fail('Fermeture WAV impossible.');
 {$I-}Close(OutputFile); Code := IOResult;{$I+} OutputOpen := False;
 If Code <> 0 Then Fail('Fermeture MP3 impossible.');
 OutputCreated := False; Dispose(State); Dispose(Transform);
 WriteLn('MP3 cree: ',OutputName);
 WriteLn(Header.Rate,' Hz, ',Header.Channels,' canal/canaux, ',EncodedFrames,
 ' trames MPEG.');
End;
Begin
 InputName:=Source; OutputName:=Target; InputOpen:=False; OutputOpen:=False;
 OutputCreated:=False;
 Case BitRateK Of
  32: BitRateIndex:=1; 40: BitRateIndex:=2; 48: BitRateIndex:=3;
  56: BitRateIndex:=4; 64: BitRateIndex:=5; 80: BitRateIndex:=6;
  96: BitRateIndex:=7; 112: BitRateIndex:=8; 128: BitRateIndex:=9;
  160: BitRateIndex:=10; 192: BitRateIndex:=11; 224: BitRateIndex:=12;
  256: BitRateIndex:=13; 320: BitRateIndex:=14;
  Else Fail('Debit MPEG-1 Layer III non pris en charge.');
 End;
 Convert;
End;

Type
 TVideoSchedule=Record
  Positions,Numbers:Array[0..16] Of LongInt;
  Count,Next:Integer;
  Total:LongInt;
 End;
 TVideoRateTrial=Record
  Q,Low,High,Best: Integer;
  Done: Boolean;
  Budget: Double;
 End;

Var
 Temps: Array[0..6] Of String;
 SavedExit: Pointer;
 InputPath,OutputPath,InputFormat,OutputFormat,AudioCodec,PendingFormat: String;
 RequestedRate: LongInt;
 RequestedChannels,RequestedBitRateK: Integer;
 Overwrite,NoOverwrite,HideBanner,HasBitrate: Boolean;
 ActiveInput,ActiveOutput: File;
 InputActive,OutputActive: Boolean;
 HLSBase: String;
 LastDownloadURL: String;
 HLSList: Text;
 HLSListOpen,AllStreams,NoVideo,NoAudio: Boolean;
 VideoCodec: String;
 AspectNum,AspectDen: LongInt;
 HasAlbum,FourMV,HasVideoBitrate,HasBFrames,HasVideoTolerance,HasBQuant,HasVideoBuffer,HasComment: Boolean;
 BFrames:Integer;
 VideoBitrate,VideoTolerance,VideoBuffer: LongInt;
 VideoBufferAvailable:Double;
 BQuantFactor,BQuantOffset:Double; LastReferenceQP:Integer;
 VideoRateBits,VideoRateDuration,VideoFrameBudget: Double;
 VideoRateLimited: LongInt;
 AlbumName: String;
 AlbumWide: Array[0..254] Of Word;
 AlbumUTF8: Array[0..764] Of Byte;
 AlbumWideSize,AlbumUTF8Size: Integer;
 CommentName: String;
 CommentWide: Array[0..254] Of Word;
 CommentUTF8: Array[0..764] Of Byte;
 CommentWideSize,CommentUTF8Size: Integer;
 VideoFrames,ImageWidth,ImageHeight: Integer;
 HasCrop:Boolean; CropTop,CropBottom,CropLeft,CropRight:Integer;
 {$IFDEF MSWINDOWS}
  NetSession,NetRequest: Pointer;
 {$ENDIF}

Function Exists(Const Name: String): Boolean;
Var
 F: File;
 A: Word;
Begin
 Assign(F,Name); GetFAttr(F,A); Exists := DosError=0;
End;

Function IsDirectory(Const Name: String): Boolean;
Var
 F: File;
 A: Word;
Begin
 Assign(F,Name); GetFAttr(F,A); IsDirectory:=(DosError=0) And ((A And Directory)<>0);
End;

Procedure Cleanup;
Var
 J,Code: Integer;
 F: File;
Begin
 {$IFDEF MSWINDOWS}
  If NetRequest<>Nil Then Begin
   InternetCloseHandle(NetRequest); NetRequest:=Nil;
  End;
  If NetSession<>Nil Then Begin
   InternetCloseHandle(NetSession); NetSession:=Nil;
  End;
 {$ENDIF}
 If HLSListOpen Then Begin
 {$I-}Close(HLSList); Code:=IOResult;{$I+} HLSListOpen:=False;
 End;
 If InputActive Then Begin
 {$I-}Close(ActiveInput); Code := IOResult;{$I+} InputActive := False;
 End;
 If OutputActive Then Begin
 {$I-}Close(ActiveOutput); Code := IOResult;{$I+} OutputActive := False;
 End;
 For J := 0 To 6 Do If Temps[J]<>'' Then If Exists(Temps[J]) Then Begin
  Assign(F,Temps[J]); {$I-}Erase(F); Code := IOResult;{$I+}
  If Code<>0 Then WriteLn('Temporaire a supprimer: ',Temps[J]);
 End;
End;
Procedure ExitCleanup;
{$IFNDEF FPC}
 Far;
{$ENDIF}
Begin
 ExitProc := SavedExit; Cleanup;
End;

Procedure Fail(Const MessageText: String);Begin
 WriteLn('FFMPEG Pascal: ',MessageText); Halt(1);
End;

Function Lower(S: String): String;
Var
 J: Integer;
Begin
 For J:=1 To Length(S) Do If S[J] In ['A'..'Z'] Then S[J]:=Chr(Ord(S[J])+32); Lower:=S;
End;

Function Extension(Const Name: String): String;
Var
 J: Integer;
Begin
 J:=Length(Name);
 While (J>0) And Not (Name[J] In ['.','/','\',':']) Do Dec(J);
 If (J>0) And (Name[J]='.') Then Extension:=Lower(Copy(Name,J+1,255)) Else Extension:='';
End;

Function FormatName(S: String): String;Begin
 S:=Lower(S); If (S='aif') Or (S='aifc') Then S:='aiff';
 If S='mod' Then S:='libopenmpt';
 If S='m3u8' Then S:='hls';
 If (S='mpg') Or (S='mpe') Then S:='mpeg';
 If S='y4m' Then S:='yuv4mpegpipe';
 If S='m1v' Then S:='mpeg1video';
 If S='m2v' Then S:='mpeg2video';
 If (S='wmv') Or (S='wma') Then S:='asf';
 FormatName:=S;
End;

Function NewTemporary: String;
Var
 Folder,Digits,Name: String;
 J,K,Attempt: Integer;
 Used: Boolean;
Begin
 J:=Length(OutputPath);
 While (J>0) And Not (OutputPath[J] In ['/','\',':']) Do Dec(J);
 Folder:=Copy(OutputPath,1,J);
 If Length(Folder)>240 Then Fail('Chemin de sortie trop long.');
 For Attempt:=1 To 100 Do Begin
  Str(Random(30000),Digits); Name:=Folder+'FFP'+Digits+'.TMP';
  Used:=Exists(Name);
  For K:=0 To 6 Do If Lower(Temps[K])=Lower(Name) Then Used:=True;
  If Not Used Then Begin
   NewTemporary:=Name; Exit;
  End;
 End;
 Fail('Nom temporaire indisponible.'); NewTemporary:='';
End;

Procedure OpenRead(Const Name: String);
Var
 Code: Integer;
 OldMode: Byte;
Begin
 Assign(ActiveInput,Name); OldMode:=FileMode; FileMode:=0;
 {$I-}Reset(ActiveInput,1); Code:=IOResult;{$I+} FileMode:=OldMode;
 If Code<>0 Then Fail('Lecture impossible: '+Name); InputActive:=True;
End;

Procedure CloseRead;
Var
 Code: Integer;
Begin
 {$I-}Close(ActiveInput); Code:=IOResult;{$I+} InputActive:=False;
 If Code<>0 Then Fail('Fermeture entree impossible.');
End;

Procedure OpenWrite(Const Name: String);
Var
 Code: Integer;
Begin
 If Exists(Name) Then Fail('Sortie intermediaire deja existante.');
 Assign(ActiveOutput,Name); {$I-}Rewrite(ActiveOutput,1); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Creation impossible: '+Name); OutputActive:=True;
End;

Procedure CloseWrite;
Var
 Code: Integer;
Begin
 {$I-}Close(ActiveOutput); Code:=IOResult;{$I+} OutputActive:=False;
 If Code<>0 Then Fail('Fermeture sortie impossible.');
End;

Procedure ReadAt(Position: LongInt; Var Buffer; Count: Word);
Var
 Code: Integer;
 Actual: Word;
Begin
 {$I-}Seek(ActiveInput,Position); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Position entree incorrecte.');
 {$I-}BlockRead(ActiveInput,Buffer,Count,Actual); Code:=IOResult;{$I+}
 If (Code<>0) Or (Actual<>Count) Then Fail('Entree tronquee.');
End;

Procedure WriteBytes(Var Buffer; Count: Word);
Var
 Code: Integer;
 Actual: Word;
Begin
 {$I-}BlockWrite(ActiveOutput,Buffer,Count,Actual); Code:=IOResult;{$I+}
 If (Code<>0) Or (Actual<>Count) Then Fail('Ecriture incomplete.');
End;

Function InputSize: LongInt;
Var
 Code: Integer;
 N: LongInt;
Begin
 {$I-}N:=FileSize(ActiveInput); Code:=IOResult;{$I+}
 If (Code<>0) Or (N<0) Then Fail('Taille entree invalide ou superieure a 2 Go.');
 InputSize:=N;
End;

{ B pictures are displayed before the future reference, but coded after it.
  Keep offsets only; the raw pictures remain in the seekable Y4M input. }
Function NextVideoFrame(Var S:TVideoSchedule; Var At:LongInt; Limit,Size:LongInt;
 Var Position,Number:LongInt; Var IsB:Boolean):Boolean;
Var N,I:Integer; Marker:String[6];
Begin
 NextVideoFrame:=False;
 If S.Next>=S.Count Then Begin
  S.Count:=0; S.Next:=0; N:=BFrames+1; If S.Total=0 Then N:=1;
  While (S.Count<N) And (At<Limit) Do Begin
   If Limit-At<6 Then Fail('Y4M: marqueur FRAME tronque.');
   Marker:='      '; ReadAt(At,Marker[1],6);
   If Marker<>'FRAME'+#10 Then Fail('Y4M: marqueur FRAME simple requis.'); Inc(At,6);
   If Size>Limit-At Then Fail('Y4M: image tronquee.');
   S.Positions[S.Count]:=At; S.Numbers[S.Count]:=S.Total;
   Inc(S.Total); Inc(S.Count); Inc(At,Size);
  End;
  If S.Count=0 Then Exit;
 End;
 I:=S.Next-1; If S.Next=0 Then I:=S.Count-1;
 Position:=S.Positions[I]; Number:=S.Numbers[I]; IsB:=S.Next<>0;
 Inc(S.Next); NextVideoFrame:=True;
End;

{ Native video rate control: search QP 4..31 to fit each frame budget. }
Function VideoOutPosition: LongInt;
Var Code: Integer; P: LongInt;
Begin
 {$I-}P:=FilePos(ActiveOutput); Code:=IOResult;{$I+}
 If (Code<>0) Or (P<0) Then Fail('Position de sortie video incorrecte.'); VideoOutPosition:=P;
End;
Procedure VideoRewind(P: LongInt);
Var Code: Integer;
Begin {$I-}Seek(ActiveOutput,P); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Reprise encodage video impossible.'); End;
Procedure VideoRateStart;
Begin VideoBufferAvailable:=VideoBuffer*0.75; LastReferenceQP:=4; VideoRateBits:=0; VideoRateDuration:=0; VideoRateLimited:=0; End;
Procedure VideoTrialStart(Var R: TVideoRateTrial; Seconds: Double);
Var Compensation:Double;
Begin
 { One-pass accumulated-rate feedback, following FFmpeg ratecontrol.c.
   Zero tolerance selects the strict per-picture budget without division. }
 Compensation:=1;
 If VideoTolerance>0 Then Begin
  Compensation:=1-(VideoRateBits-VideoBitrate*VideoRateDuration)/VideoTolerance;
  If Compensation<0.001 Then Compensation:=0.001;
 End;
 VideoFrameBudget:=VideoBitrate*Seconds*Compensation;
 R.Q:=4; R.Low:=4; R.High:=31; R.Best:=0; R.Done:=False; R.Budget:=VideoFrameBudget;
 If (VideoBuffer>0) And (R.Budget>VideoBufferAvailable) Then R.Budget:=VideoBufferAvailable;
End;
Procedure VideoPictureTrialStart(Var R:TVideoRateTrial; Seconds:Double; IsB:Boolean);
Begin
 VideoTrialStart(R,Seconds);
 { Positive factor fixes B QP from the last accepted reference, not a trial. }
 If IsB And (BQuantFactor>0) Then Begin
  If VideoBuffer=0 Then R.Done:=True Else Begin
   R.Q:=Trunc(LastReferenceQP*BQuantFactor+BQuantOffset+0.5);
   If R.Q<1 Then R.Q:=1; If R.Q>31 Then R.Q:=31; R.Low:=R.Q;
  End;
 End;
End;
Function VideoPictureQP(Base:Integer; IsB:Boolean):Integer;
Var Q:Double;
Begin
 Q:=Base;
 If IsB Then Begin
  If BQuantFactor>0 Then Begin
   Q:=LastReferenceQP*BQuantFactor+BQuantOffset;
   If (VideoBuffer>0) And (Q<Base) Then Q:=Base;
  End
  Else If BQuantFactor<0 Then Q:=-Base*BQuantFactor+BQuantOffset;
 End;
 If Q<1 Then Q:=1; If Q>31 Then Q:=31;
 VideoPictureQP:=Trunc(Q+0.5);
End;
Function VideoTrialAgain(Var R: TVideoRateTrial; Bytes: LongInt): Boolean;
Begin
 VideoTrialAgain:=False; If R.Done Then Exit;
 If Bytes*8.0<=R.Budget Then Begin R.Best:=R.Q; R.High:=R.Q-1; End Else R.Low:=R.Q+1;
 If R.Low<=R.High Then Begin R.Q:=(R.Low+R.High) Div 2; VideoTrialAgain:=True; End Else
 If (R.Best<>0) And (R.Best<>R.Q) Then Begin R.Q:=R.Best; R.Done:=True; VideoTrialAgain:=True; End;
End;
Procedure VideoRateAccept(Bytes: LongInt; Seconds: Double);
Var Code: Integer;
Begin
 If VideoBuffer>0 Then Begin
  If Bytes*8.0>VideoBufferAvailable Then Fail('-bufsize: tampon insuffisant pour cette image au QP autorise.');
  VideoBufferAvailable:=VideoBufferAvailable-Bytes*8.0+VideoBitrate*Seconds;
  If VideoBufferAvailable>VideoBuffer Then VideoBufferAvailable:=VideoBuffer;
 End;
 { Remove the tail of a larger trial before the next picture or muxing. }
 {$I-}Truncate(ActiveOutput); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Finalisation encodage video impossible.');
 VideoRateBits:=VideoRateBits+Bytes*8.0; VideoRateDuration:=VideoRateDuration+Seconds;
 If Bytes*8.0>VideoFrameBudget Then Inc(VideoRateLimited);
End;
Procedure VideoRateReport;
Begin
 If HideBanner Or (VideoRateDuration<=0) Then Exit;
 WriteLn('Tolerance video: ',VideoTolerance,' bits/s.');
 WriteLn('Debit video cible: ',VideoBitrate,' bit/s; obtenu: ',VideoRateBits/VideoRateDuration:0:0,' bit/s.');
 If VideoRateLimited>0 Then WriteLn(VideoRateLimited,' image(s): budget depasse (quantification maximale ou QP B impose).');
End;

Function Probe(Const Name: String): String;
Var
 B: Array[0..1083] Of Byte;
 N,J: Integer;
 Size,StartPos,TagSize: LongInt;
 Tag: String[4];
Begin
 OpenRead(Name); Size:=InputSize; StartPos:=0;
 Repeat
  N:=1084; If Size-StartPos<N Then N:=Size-StartPos;
  FillChar(B,SizeOf(B),0); ReadAt(StartPos,B,N);
  If N<10 Then Break;
  If (B[0]<>73) Or (B[1]<>68) Or (B[2]<>51) Then Break;
  If (B[3]<2) Or (B[3]>4) Or (B[4]=255) Then Fail('Version ID3v2 invalide.');
  TagSize:=0;
  For J:=6 To 9 Do Begin
   If B[J]>127 Then Fail('Taille ID3v2 invalide.'); TagSize:=TagSize*128+B[J];
  End;
  Inc(TagSize,10); If (B[3]=4) And ((B[5] And 16)<>0) Then Inc(TagSize,10);
  If TagSize>Size-StartPos Then Fail('Etiquette ID3v2 tronquee.');
  Inc(StartPos,TagSize);
 Until False;
 CloseRead;
 Probe:='';
 If N>=9 Then If (B[0]=89) And (B[1]=85) And (B[2]=86) And (B[3]=52) And
  (B[4]=77) And (B[5]=80) And (B[6]=69) And (B[7]=71) And (B[8]=50) Then Begin
  Probe:='yuv4mpegpipe'; Exit;
 End;
 If N>=4 Then If (B[0]=0) And (B[1]=0) And (B[2]=1) And (B[3]=$B3) Then Begin
  Probe:='mpeg1video'; Exit;
 End;
 If N>=5 Then If (B[0]=0) And (B[1]=0) And (B[2]=1) And
  ((B[3]=$B0) Or (B[3]=$B5) Or (B[3]<=$2F)) Then Begin
  Probe:='m4v'; Exit;
 End;
 If N>=4 Then If (B[0]=0) And (B[1]=0) And (B[2]=1) And (B[3]=$BA) Then Begin
  Probe:='mpeg'; Exit;
 End;
 If N>=16 Then If (B[0]=$30) And (B[1]=$26) And (B[2]=$B2) And (B[3]=$75) And
  (B[4]=$8E) And (B[5]=$66) And (B[6]=$CF) And (B[7]=$11) Then Begin
  Probe:='asf'; Exit;
 End;
 If N>=9 Then If (B[0]=70) And (B[1]=76) And (B[2]=86) Then Begin
  Probe:='flv'; Exit;
 End;
 If N>=12 Then Begin
  If (B[4]=102) And (B[5]=116) And (B[6]=121) And (B[7]=112) Then Begin
   Probe:='mp4'; Exit;
  End;
  If (B[0]=82) And (B[1]=73) And (B[2]=70) And (B[3]=70) And
  (B[8]=65) And (B[9]=86) And (B[10]=73) And (B[11]=32) Then Begin
   Probe:='avi'; Exit;
  End;
  If (B[0]=$1A) And (B[1]=$45) And (B[2]=$DF) And (B[3]=$A3) Then Begin
   Probe:='webm'; Exit;
  End;
 End;
 If N>=7 Then If (B[0]=35) And (B[1]=69) And (B[2]=88) And
 (B[3]=84) And (B[4]=77) And (B[5]=51) And (B[6]=85) Then Begin
  Probe:='hls'; Exit;
 End;
 If N>=12 Then Begin
  If (B[0]=82) And (B[1]=73) And (B[2]=70) And (B[3]=70) And
  (B[8]=87) And (B[9]=65) And (B[10]=86) And (B[11]=69) Then Begin
   Probe:='wav'; Exit;
  End;
  If (B[0]=70) And (B[1]=79) And (B[2]=82) And (B[3]=77) And
  (B[8]=65) And (B[9]=73) And (B[10]=70) And (B[11] In [70,67]) Then Begin
   Probe:='aiff'; Exit;
  End;
 End;
 If N>=26 Then If (B[0]=67) And (B[1]=114) And (B[2]=101) And (B[19]=$1A) Then Begin
  Probe:='voc'; Exit;
 End;
 If N>=4 Then If (B[0]=$FF) And ((B[1] And $E6)=$E6) Then Begin
  Probe:='mp1'; Exit;
 End;
 If N>=4 Then If ((B[0]=73) And (B[1]=68) And (B[2]=51)) Or
 ((B[0]=$FF) And ((B[1] And $E6)=$E2)) Then Begin
  Probe:='mp3'; Exit;
 End;
 If N>=1084 Then Begin
  Tag:='';
  For J:=1080 To 1083 Do Tag:=Tag+Chr(B[J]);
  If (Tag='M.K.') Or (Tag='M!K!') Or (Tag='4CHN') Or (Tag='FLT4') Then Probe:=
  'libopenmpt';
 End;
End;

{ ASF packet reader. Reassembles media objects; it does not decode WMV/WMA.
  ASFP0001 is a private spool/test format, never an FLV output.
  Reference: FFmpeg libavformat/asfdec_f.c and the ASF object layout. }
Procedure DemuxASF(Const Source,Target: String);
Const
 GHeader: String[16]=#$30#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GFile: String[16]=#$A1#$DC#$AB#$8C#$47#$A9#$CF#$11#$8E#$E4#$00#$C0#$0C#$20#$53#$65;
 GStream: String[16]=#$91#$07#$DC#$B7#$B7#$A9#$CF#$11#$8E#$E6#$00#$C0#$0C#$20#$53#$65;
 GAudio: String[16]=#$40#$9E#$69#$F8#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GVideo: String[16]=#$C0#$EF#$19#$BC#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GData: String[16]=#$36#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GExtension: String[16]=#$B5#$03#$BF#$5F#$2E#$A9#$CF#$11#$8E#$E3#$00#$C0#$0C#$20#$53#$65;
 GEncrypt: String[16]=#$FB#$B3#$11#$22#$23#$BD#$D2#$11#$B4#$B7#$00#$A0#$C9#$55#$FC#$6E;
 GEncrypt2: String[16]=#$14#$E6#$8A#$29#$22#$26#$17#$4C#$B9#$35#$DA#$E0#$7E#$E9#$28#$9C;
Type
 PFragment=^TFragment;
 TFragment=Record Next: PFragment; Used: Word; Data: Array[0..4095] Of Byte; End;
 TStream=Record
  ID,Kind,Channels,Align,ExtraSize: Integer;
  Codec,Width,Height,Rate,BitRate,Expected,Received,Sequence,Stamp: LongInt;
  Key: Boolean;
  Extra: Array[0..2047] Of Byte;
  First,Last: PFragment;
 End;
 TStreams=Array[0..3] Of TStream;
 PStreams=^TStreams;
Var
 Streams: PStreams;
 StreamCount: Integer;
 Cache: Array[0..4095] Of Byte;
 CacheAt,CacheSize,Limit,PacketSize,PacketCount,Preroll,DataStart,DataEnd: LongInt;
 HeaderEnd,AtObject,Size,P,PacketEnd,PayloadEnd,PacketStart,PacketLength,Padding: LongInt;
 Sequence,Offset,RepSize,ObjectSize,Stamp,PayloadSize,Ignored,Delta: LongInt;
 PacketIndex: LongInt;
 Flags,Properties,SegFlags,Segments,I,J,S,StreamID,Key,SubSize: Integer;
 Signature: String[8];

 Procedure ClearObject(Track: Integer);
 Var F,N: PFragment;
 Begin
  F:=Streams^[Track].First;
  While F<>Nil Do Begin N:=F^.Next; Dispose(F); F:=N; End;
  Streams^[Track].First:=Nil; Streams^[Track].Last:=Nil;
  Streams^[Track].Expected:=0; Streams^[Track].Received:=0;
 End;

 Procedure Release;
 Var I: Integer;
 Begin
  If Streams<>Nil Then Begin
   For I:=0 To StreamCount-1 Do ClearObject(I); Dispose(Streams); Streams:=Nil;
  End;
 End;

 Procedure Bad(Const MessageText: String);
 Begin Release; Fail('ASF: '+MessageText); End;

 Procedure Bound(Pos,Count,Last: LongInt);
 Begin
  If (Pos<0) Or (Count<0) Or (Pos>Last) Then Bad('Position invalide.');
  If Count>Last-Pos Then Bad('Objet ou paquet tronque.');
 End;

 Function ByteAt(Pos: LongInt): Byte;
 Begin
  Bound(Pos,1,Limit);
  If (Pos<CacheAt) Or (Pos>=CacheAt+CacheSize) Then Begin
   CacheAt:=Pos; CacheSize:=4096; If Limit-Pos<CacheSize Then CacheSize:=Limit-Pos;
   ReadAt(Pos,Cache,CacheSize);
  End;
  ByteAt:=Cache[Pos-CacheAt];
 End;

 Function LE(Pos: LongInt; Count: Integer): LongInt;
 Var I: Integer; V: LongInt;
 Begin
  Bound(Pos,Count,Limit); V:=0;
  For I:=Count-1 Downto 0 Do Begin
   If V>8388607 Then Bad('Valeur superieure a 2 Go non prise en charge.');
   V:=V*256+ByteAt(Pos+I);
  End;
  LE:=V;
 End;

 Function Small64(Pos: LongInt): LongInt;
 Begin
  If LE(Pos+4,4)<>0 Then Bad('Valeur 64 bits hors limites.'); Small64:=LE(Pos,4);
 End;

 Function GUID(Pos: LongInt; Const Value: String): Boolean;
 Var I: Integer;
 Begin
  Bound(Pos,16,Limit); GUID:=False;
  For I:=1 To 16 Do If ByteAt(Pos+I-1)<>Ord(Value[I]) Then Exit;
  GUID:=True;
 End;

 Procedure Put32(V: LongInt);
 Var B: Array[0..3] Of Byte; I: Integer;
 Begin For I:=0 To 3 Do B[I]:=(V Shr (I*8)) And 255; WriteBytes(B,4); End;

 Procedure Headers(Start,Last: LongInt; Depth: Integer);
 Var Pos,N,EndPos,T,TypeSize,ECCSize,ExtraAt,BI: LongInt; ID,I: Integer;
 Begin
  If Depth>2 Then Bad('Extensions imbriquees excessives.'); Pos:=Start;
  While Pos<Last Do Begin
   Bound(Pos,24,Last); N:=Small64(Pos+16); If N<24 Then Bad('Taille objet invalide.');
   Bound(Pos,N,Last); EndPos:=Pos+N; T:=Pos+24;
   If GUID(Pos,GFile) Then Begin
    If PacketSize<>0 Then Bad('Proprietes fichier dupliquees.'); Bound(T,80,EndPos);
    If (LE(T+64,4) And 1)<>0 Then Bad('Diffusion ASF sans taille fixe non implementee.');
    PacketCount:=Small64(T+32); Preroll:=Small64(T+56);
    PacketSize:=LE(T+68,4);
    If (PacketSize<16) Or (PacketSize>16777216) Or (PacketSize<>LE(T+72,4)) Then
     Bad('Tailles de paquets variables ou invalides.');
   End Else If GUID(Pos,GStream) Then Begin
    Bound(T,54,EndPos); TypeSize:=LE(T+40,4); ECCSize:=LE(T+44,4);
    ID:=LE(T+48,2);
    If (ID And $FF80)<>0 Then Bad('Piste chiffree ou identifiant reserve.');
    If ID=0 Then Bad('Identifiant de piste nul.');
    If Small64(T+32)<>0 Then Bad('Decalage temporel de piste non implemente.');
    If StreamCount=4 Then Bad('Plus de quatre pistes.');
    For I:=0 To StreamCount-1 Do If Streams^[I].ID=ID Then Bad('Piste dupliquee.');
    Bound(T+54,TypeSize,EndPos); Bound(T+54+TypeSize,ECCSize,EndPos);
    Streams^[StreamCount].ID:=ID;
    If GUID(T,GAudio) Then Begin
     Streams^[StreamCount].Kind:=2; Inc(T,54); Bound(T,18,T+TypeSize);
     Streams^[StreamCount].Codec:=LE(T,2); Streams^[StreamCount].Channels:=LE(T+2,2);
     Streams^[StreamCount].Rate:=LE(T+4,4);
     Ignored:=LE(T+8,4); If Ignored>268435455 Then Bad('Debit audio invalide.');
     Streams^[StreamCount].BitRate:=Ignored*8;
     Streams^[StreamCount].Align:=LE(T+12,2); ExtraAt:=T+18;
     Streams^[StreamCount].ExtraSize:=LE(T+16,2);
     If Streams^[StreamCount].ExtraSize>TypeSize-18 Then Bad('Configuration audio tronquee.');
     If ECCSize>0 Then Begin
      Bound(T+TypeSize,8,EndPos);
      If ByteAt(T+TypeSize)>1 Then Bad('Entrelacement audio ASF non implemente.');
     End;
    End Else If GUID(T,GVideo) Then Begin
     Streams^[StreamCount].Kind:=1; Inc(T,54); Bound(T,51,T+TypeSize);
     BI:=LE(T+11,4); If (BI<40) Or (BI>TypeSize-11) Then Bad('BITMAPINFO invalide.');
     If BI>2088 Then Bad('Configuration codec trop longue.');
     Streams^[StreamCount].Width:=LE(T+15,4); Streams^[StreamCount].Height:=LE(T+19,4);
     Streams^[StreamCount].Codec:=LE(T+27,4); ExtraAt:=T+51;
     Streams^[StreamCount].ExtraSize:=BI-40;
    End Else Bad('Type de piste non implemente.');
    If Streams^[StreamCount].ExtraSize>2048 Then Bad('Configuration codec trop longue.');
    For I:=0 To Streams^[StreamCount].ExtraSize-1 Do Streams^[StreamCount].Extra[I]:=ByteAt(ExtraAt+I);
    Inc(StreamCount);
   End Else If GUID(Pos,GExtension) Then Begin
    Bound(T,22,EndPos); N:=LE(T+18,4); Bound(T+22,N,EndPos); Headers(T+22,T+22+N,Depth+1);
   End Else If GUID(Pos,GEncrypt) Or GUID(Pos,GEncrypt2) Then Bad('Chiffrement ASF non implemente.');
   Pos:=EndPos;
  End;
 End;

 Function ReadField(Kind: Integer; Default: LongInt): LongInt;
 Var N: Integer;
 Begin
  N:=Kind And 3; If N=3 Then N:=4;
  If N=0 Then ReadField:=Default Else Begin
   Bound(P,N,PacketEnd); ReadField:=LE(P,N); Inc(P,N);
  End;
 End;

 Procedure FinishObject(Track: Integer);
 Var F: PFragment;
 Begin
  Put32(Streams^[Track].ID); Put32(Ord(Streams^[Track].Key));
  Put32(Streams^[Track].Stamp-Preroll); Put32(Streams^[Track].Expected);
  F:=Streams^[Track].First;
  While F<>Nil Do Begin WriteBytes(F^.Data,F^.Used); F:=F^.Next; End;
  ClearObject(Track);
 End;

 Procedure Fragment(Track: Integer; SourcePos,Count,FragOffset,Total,Seq,Time: LongInt; IsKey: Boolean);
 Var F: PFragment; N: Word;
 Begin
  If FragOffset=0 Then Begin
   If Streams^[Track].Expected<>0 Then Bad('Objet incomplet avant le suivant.');
   If (Total<=0) Or (Total>16777216) Then Bad('Taille media invalide.');
   Streams^[Track].Expected:=Total; Streams^[Track].Sequence:=Seq;
   Streams^[Track].Stamp:=Time; Streams^[Track].Key:=IsKey Or (Streams^[Track].Kind=2);
  End;
  If (Streams^[Track].Expected=0) Or (Streams^[Track].Sequence<>Seq) Or
   (Streams^[Track].Received<>FragOffset) Then Bad('Fragments manquants ou desordonnes.');
  If (Total<>0) And (Total<>Streams^[Track].Expected) Then Bad('Taille media changeante.');
  If Count>Streams^[Track].Expected-Streams^[Track].Received Then Bad('Fragment hors objet.');
  While Count>0 Do Begin
   {$IFNDEF FPC}
   If MaxAvail<SizeOf(TFragment) Then Bad('Memoire DOS insuffisante.');
   {$ENDIF}
   New(F); F^.Next:=Nil; N:=4096; If Count<N Then N:=Count; F^.Used:=N;
   If Streams^[Track].First=Nil Then Streams^[Track].First:=F Else Streams^[Track].Last^.Next:=F;
   Streams^[Track].Last:=F; ReadAt(SourcePos,F^.Data,N);
   Inc(SourcePos,N); Dec(Count,N); Inc(Streams^[Track].Received,N);
  End;
  If Streams^[Track].Received=Streams^[Track].Expected Then FinishObject(Track);
 End;

Begin
 Streams:=Nil; StreamCount:=0; PacketSize:=0; Preroll:=0; PacketCount:=0;
 CacheAt:=-1; CacheSize:=0; New(Streams); FillChar(Streams^,SizeOf(TStreams),0);
 OpenRead(Source); Limit:=InputSize;
 Bound(0,30,Limit); If Not GUID(0,GHeader) Then Bad('Signature absente.');
 HeaderEnd:=Small64(16); Bound(0,HeaderEnd,Limit);
 If HeaderEnd<30 Then Bad('En-tete trop court.'); Headers(30,HeaderEnd,0);
 If (PacketSize=0) Or (StreamCount=0) Then Bad('Proprietes fichier/pistes absentes.');
 AtObject:=HeaderEnd; DataStart:=0; DataEnd:=0;
 While AtObject<Limit Do Begin
  Bound(AtObject,24,Limit); Size:=Small64(AtObject+16);
  If Size<24 Then Bad('Taille objet invalide.'); Bound(AtObject,Size,Limit);
  If GUID(AtObject,GData) Then Begin
   If Size<50 Then Bad('Objet de donnees trop court.');
   If Small64(AtObject+40)<>PacketCount Then Bad('Nombre de paquets incoherent.');
   DataStart:=AtObject+50; DataEnd:=AtObject+Size; Break;
  End;
  Inc(AtObject,Size);
 End;
 If DataStart=0 Then Bad('Objet de donnees absent.');
 If (DataEnd-DataStart) Div PacketSize<>PacketCount Then Bad('Nombre de paquets invalide.');
 If (DataEnd-DataStart) Mod PacketSize<>0 Then Bad('Dernier paquet tronque.');
 OpenWrite(Target); Signature:='ASFP0001'; WriteBytes(Signature[1],8); Put32(StreamCount);
 For I:=0 To StreamCount-1 Do With Streams^[I] Do Begin
  Put32(ID); Put32(Kind); Put32(Codec); Put32(Width); Put32(Height);
  Put32(Rate); Put32(Channels); Put32(Align); Put32(BitRate); Put32(ExtraSize);
  If ExtraSize>0 Then WriteBytes(Extra,ExtraSize);
 End;
 PacketStart:=DataStart;
 For PacketIndex:=1 To PacketCount Do Begin
  PacketEnd:=PacketStart+PacketSize; P:=PacketStart; Flags:=ReadField(1,0);
  If (Flags And $80)<>0 Then Begin
   If Flags<>$82 Then Bad('Correction erreur ASF non implementee.');
   If ReadField(2,0)<>0 Then Bad('Correction erreur non nulle.'); Flags:=ReadField(1,0);
  End;
  Properties:=ReadField(1,0);
  If Properties Shr 6<>1 Then Bad('Identifiant de flux de taille non implementee.');
  PacketLength:=ReadField(Flags Shr 5,PacketSize); Ignored:=ReadField(Flags Shr 1,0);
  Padding:=ReadField(Flags Shr 3,0);
  If (PacketLength<=0) Or (PacketLength>PacketSize) Or (Padding>=PacketLength) Then Bad('Longueur paquet invalide.');
  Stamp:=ReadField(3,0); Ignored:=ReadField(2,0);
  SegFlags:=0; Segments:=1;
  If Odd(Flags) Then Begin SegFlags:=ReadField(1,0); Segments:=SegFlags And 63; End;
  If Segments=0 Then Bad('Paquet sans charges utiles.');
  PacketEnd:=PacketStart+PacketLength-Padding; Bound(P,0,PacketEnd);
  For J:=1 To Segments Do Begin
   StreamID:=ReadField(1,0); Key:=StreamID Shr 7; StreamID:=StreamID And 127; S:=-1;
   For I:=0 To StreamCount-1 Do If Streams^[I].ID=StreamID Then S:=I;
   If S<0 Then Bad('Piste de paquet inconnue.');
   Sequence:=ReadField(Properties Shr 4,0); Offset:=ReadField(Properties Shr 2,0);
   RepSize:=ReadField(Properties,0); Bound(P,RepSize,PacketEnd); ObjectSize:=0; Delta:=0;
   If RepSize>=8 Then Begin ObjectSize:=LE(P,4); Stamp:=LE(P+4,4); End
   Else If RepSize=1 Then Begin Stamp:=Offset; Offset:=0; Delta:=ByteAt(P); End
