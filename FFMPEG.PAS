{ -sws_flags : drapeaux swscale (AVOption de type flags) ; renvoie False si
 syntaxe invalide }
Function O1ParseSwsFlags(Const S: String; Var Fl: LongInt): Boolean;
Const Nm: Array[0..16] Of String[16]=('fast_bilinear','bilinear','bicubic',
 'experimental','neighbor','area','bicublin','gauss','sinc','lanczos','spline',
 'print_info','accurate_rnd','full_chroma_int','full_chroma_inp','bitexact',
 'error_diffusion');
 Vl: Array[0..16] Of LongInt=(1,2,4,8,$10,$20,$40,$80,$100,$200,$400,$1000,
  $40000,$2000,$4000,$80000,$800000);
Var P,K,Q: Integer; Cmd: Char; Tk: String; V: LongInt; Code: LongInt; Found:
 Boolean; Cur: LongInt;
Begin
 O1ParseSwsFlags:=False; P:=1; Cur:=Fl; Cmd:=#0;
 If S='' Then Exit;
 While P<=Length(S) Do Begin
  If S[P] In ['+','-'] Then Begin Cmd:=S[P]; Inc(P); End;
  Q:=P; While (Q<=Length(S)) And Not (S[Q] In ['+','-']) Do Inc(Q);
  Tk:=Copy(S,P,Q-P); P:=Q;
  If Tk='' Then Exit;
  Found:=False; V:=0;
  For K:=0 To 16 Do If Nm[K]=Tk Then Begin V:=Vl[K]; Found:=True; End;
  If Not Found Then Begin Val(Tk,V,Code); If Code<>0 Then Exit; End;
  If Cmd='+' Then Cur:=Cur Or V Else If Cmd='-' Then Cur:=Cur And Not V Else
   Cur:=V;
 End;
 Fl:=Cur; O1ParseSwsFlags:=True;
End;

{ format natif de l'encodeur pour une entree 4:2:0 (negociation de
 ffmpeg_filter.c) ; '' si quelconque/inconnu }
Function O1NativeFm(Const C: String): String;
Begin
 O1NativeFm:='';
 If C='huffyuv' Then O1NativeFm:='yuv422p'
 Else If C='svq1' Then O1NativeFm:='yuv410p'
 Else If C='mjpeg' Then O1NativeFm:='yuvj420p'
 Else If C='dnxhd' Then O1NativeFm:='yuv422p'
 Else If C='roqvideo' Then O1NativeFm:='yuv444p'
 Else If (C='wmv1') Or (C='wmv2') Or (C='msmpeg4') Or (C='msmpeg4v1') Or (
  C='msmpeg4v2') Or (C='mpeg4') Or (C='h263') Or (C='h263p') Or (C='flv') Or (
  C='mpeg1video') Or (C='mpeg2video') Or (C='asv1') Or (C='asv2') Or (C='snow')
  Or (C='rv10') Or (C='rv20') Or (C='libx264') Or (C='libtheora') Or (C='ffv1')
  Then O1NativeFm:='yuv420p';
End;

{ nom du format de sortie : -f ou extension }
Function O1OutFmtName(G: Integer; Const OutNm: String): String;
Var I: Integer; E: String;
Begin
 I:=O1Last(G,'f','v');
 If I>0 Then E:=Lower(O1Op[I].Val) Else E:=Extension(OutNm);
 If (E='mkv') Or (E='mka') Then E:='matroska';
 If (E='ts') Or (E='m2ts') Or (E='mts') Then E:='mpegts';
 If E='y4m' Then E:='yuv4mpegpipe';
 O1OutFmtName:=E;
End;

{ methode de synchronisation video par defaut (ffmpeg_mux_init.c) : 0 cfr, 1
 vscfr, 2 vfr, 3 passthrough }
Function O1VSyncMode(Const Fmt: String): LongInt;
Var M: LongInt;
Begin
 If O1HasOutR Then M:=0
 Else If Fmt='avi' Then M:=2
 Else If (Fmt='matroska') Or (Fmt='webm') Or (Fmt='flv') Or (Fmt='gif') Or (
  Fmt='mpegts') Or (Fmt='nut') Or (Fmt='apng') Or (Fmt='webp') Or (
  Fmt='framecrc') Or (Fmt='framemd5') Then M:=2
 Else If Fmt='null' Then M:=3
 Else M:=0;
 If (M=0) And (Not O1HasInOff Or (O1InOff=0)) Then M:=1;
 O1VSyncMode:=M;
End;

