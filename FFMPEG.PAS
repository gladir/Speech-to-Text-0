{ get_interleaved_ue_golomb (golomb.h, lecteur avec taille : l'index est borne a
 size+8) }
Function S3Ue(Var G: TS3Gb): Int64;
Var Buf: Int64; Ret: Int64; B8: LongInt;
Begin
 Buf:=S3Cache(G);
 If (Buf And $AA800000)<>0 Then Begin
  B8:=Buf Shr 24; S3SkipC(G,S3GVLen[B8]); S3Ue:=S3GUe[B8]; Exit;
 End;
 Ret:=1;
 Repeat
  B8:=Buf Shr 24;
  If S3GVLen[B8]<8 Then S3SkipC(G,S3GVLen[B8]) Else S3SkipC(G,8);
  If S3GVLen[B8]<>9 Then Begin
   Ret:=(Ret Shl ((S3GVLen[B8]-1) Shr 1)) And $FFFFFFFF;
   Ret:=Ret Or S3GDirac[B8];
   Break;
  End;
  Ret:=((Ret Shl 4) And $FFFFFFFF) Or S3GDirac[B8];
  Buf:=S3Cache(G);
 Until Not ((Ret<$8000000) And (G.Pos<G.Size+8));
 S3Ue:=(Ret-1) And $FFFFFFFF;
End;
{ get_interleaved_se_golomb ; -$80000000 = INVALID_VLC }
Function S3Se(Var G: TS3Gb): Int64;
Var Buf,T,M: Int64; B8,Lg: LongInt; Sv: LongInt;
Begin
 M:=$FFFFFFFF;
 Buf:=S3Cache(G);
 If (Buf And $AA800000)<>0 Then Begin
  B8:=Buf Shr 24; S3SkipC(G,S3GVLen[B8]); S3Se:=S3GSe[B8]; Exit;
 End;
 Sv:=G.Pos;
 S3SkipC(G,8);
 Buf:=Buf Or 1 Or (S3Cache(G) Shr 8);
 If (Buf And $AAAAAAAA)=0 Then Begin G.Pos:=Sv; S3Se:=-$80000000; Exit; End;
 Lg:=31;
 While ((Buf And $80000000)=0) And (Lg>=1) Do Begin
  Buf:=(((Buf Shl 2) And M) - ((((Buf Shl Lg) And M) Shr (Lg-1))) + (Buf Shr
   30)) And M;
  Dec(Lg);
 End;
 S3SkipC(G,63-2*Lg-8);
 T:=((Buf Shl Lg) And M) Shr Lg;
 T:=(T-1) And M;
 If (Buf And 1)<>0 Then T:=T Xor M;
 T:=(T+1) And M;
 If T>=$80000000 Then T:=T-$100000000;
 If T>=0 Then S3Se:=T Shr 1 Else S3Se:=-((-T+1) Shr 1);
End;
Function S3Skip1Stop8(Var G: TS3Gb): LongInt;
Begin
 S3Skip1Stop8:=-1;
 If S3Left(G)<=0 Then Exit;
 While S3Bits(G,1)<>0 Do Begin
  S3Bits(G,8);
  If S3Left(G)<=0 Then Exit;
 End;
 S3Skip1Stop8:=0;
End;

{ ---- prediction intra (h264pred) ---- }
Procedure S3Pred4(P: PEABuffer; O,St,Mode,TR: LongInt);
Var T0,T1,T2,T3,T4,T5,T6,L0,L1,L2,L3,Lt,Dc,I,J: LongInt;
Procedure W(X,Y,V: LongInt);Begin P^[O+X+Y*St]:=V; End;
Begin
 T0:=P^[O-St]; T1:=P^[O+1-St]; T2:=P^[O+2-St]; T3:=P^[O+3-St];
 L0:=P^[O-1]; L1:=P^[O-1+St]; L2:=P^[O-1+2*St]; L3:=P^[O-1+3*St];
 Lt:=P^[O-1-St];
 Case Mode Of
  0: For J:=0 To 3 Do Begin W(0,J,T0); W(1,J,T1); W(2,J,T2); W(3,J,T3); End;
  1: For J:=0 To 3 Do Begin L0:=P^[O-1+J*St]; For I:=0 To 3 Do W(I,J,L0); End;
  2: Begin Dc:=(T0+T1+T2+T3+L0+L1+L2+L3+4) Shr 3; For J:=0 To 3 Do For I:=0 To 3
   Do W(I,J,Dc); End;
  3: Begin
   W(0,0,(L1+T1) Shr 1);
   W(1,0,(L2+T2) Shr 1); W(0,1,(L2+T2) Shr 1);
   Dc:=(L3+T3) Shr 1;
   W(2,0,Dc); W(1,1,Dc); W(0,2,Dc); W(3,0,Dc); W(2,1,Dc); W(1,2,Dc); W(0,3,Dc);
    W(3,1,Dc); W(2,2,Dc); W(1,3,Dc); W(3,2,Dc); W(2,3,Dc); W(3,3,Dc);
  End;
  4: Begin
   W(0,3,(L3+2*L2+L1+2) Shr 2);
   W(0,2,(L2+2*L1+L0+2) Shr 2); W(1,3,(L2+2*L1+L0+2) Shr 2);
   Dc:=(L1+2*L0+Lt+2) Shr 2; W(0,1,Dc); W(1,2,Dc); W(2,3,Dc);
   Dc:=(L0+2*Lt+T0+2) Shr 2; W(0,0,Dc); W(1,1,Dc); W(2,2,Dc); W(3,3,Dc);
   Dc:=(Lt+2*T0+T1+2) Shr 2; W(1,0,Dc); W(2,1,Dc); W(3,2,Dc);
   Dc:=(T0+2*T1+T2+2) Shr 2; W(2,0,Dc); W(3,1,Dc);
   W(3,0,(T1+2*T2+T3+2) Shr 2);
  End;
  5: Begin
   Dc:=(Lt+T0+1) Shr 1; W(0,0,Dc); W(1,2,Dc);
   Dc:=(T0+T1+1) Shr 1; W(1,0,Dc); W(2,2,Dc);
   Dc:=(T1+T2+1) Shr 1; W(2,0,Dc); W(3,2,Dc);
   W(3,0,(T2+T3+1) Shr 1);
   Dc:=(L0+2*Lt+T0+2) Shr 2; W(0,1,Dc); W(1,3,Dc);
   Dc:=(Lt+2*T0+T1+2) Shr 2; W(1,1,Dc); W(2,3,Dc);
   Dc:=(T0+2*T1+T2+2) Shr 2; W(2,1,Dc); W(3,3,Dc);
   W(3,1,(T1+2*T2+T3+2) Shr 2);
   W(0,2,(Lt+2*L0+L1+2) Shr 2);
   W(0,3,(L0+2*L1+L2+2) Shr 2);
  End;
  6: Begin
   Dc:=(Lt+L0+1) Shr 1; W(0,0,Dc); W(2,1,Dc);
   Dc:=(L0+2*Lt+T0+2) Shr 2; W(1,0,Dc); W(3,1,Dc);
   W(2,0,(Lt+2*T0+T1+2) Shr 2);
   W(3,0,(T0+2*T1+T2+2) Shr 2);
   Dc:=(L0+L1+1) Shr 1; W(0,1,Dc); W(2,2,Dc);
   Dc:=(Lt+2*L0+L1+2) Shr 2; W(1,1,Dc); W(3,2,Dc);
   Dc:=(L1+L2+1) Shr 1; W(0,2,Dc); W(2,3,Dc);
   Dc:=(L0+2*L1+L2+2) Shr 2; W(1,2,Dc); W(3,3,Dc);
   W(0,3,(L2+L3+1) Shr 1);
   W(1,3,(L1+2*L2+L3+2) Shr 2);
  End;
  7: Begin
   T4:=P^[TR]; T5:=P^[TR+1]; T6:=P^[TR+2];
   W(0,0,(T0+T1+1) Shr 1);
   Dc:=(T1+T2+1) Shr 1; W(1,0,Dc); W(0,2,Dc);
   Dc:=(T2+T3+1) Shr 1; W(2,0,Dc); W(1,2,Dc);
   Dc:=(T3+T4+1) Shr 1; W(3,0,Dc); W(2,2,Dc);
   W(3,2,(T4+T5+1) Shr 1);
   W(0,1,(T0+2*T1+T2+2) Shr 2);
   Dc:=(T1+2*T2+T3+2) Shr 2; W(1,1,Dc); W(0,3,Dc);
   Dc:=(T2+2*T3+T4+2) Shr 2; W(2,1,Dc); W(1,3,Dc);
   Dc:=(T3+2*T4+T5+2) Shr 2; W(3,1,Dc); W(2,3,Dc);
   W(3,3,(T4+2*T5+T6+2) Shr 2);
  End;
  8: Begin
   W(0,0,(L0+L1+1) Shr 1);
   W(1,0,(L0+2*L1+L2+2) Shr 2);
   Dc:=(L1+L2+1) Shr 1; W(2,0,Dc); W(0,1,Dc);
   Dc:=(L1+2*L2+L3+2) Shr 2; W(3,0,Dc); W(1,1,Dc);
   Dc:=(L2+L3+1) Shr 1; W(2,1,Dc); W(0,2,Dc);
   Dc:=(L2+2*L3+L3+2) Shr 2; W(3,1,Dc); W(1,2,Dc);
   W(3,2,L3); W(1,3,L3); W(0,3,L3); W(2,2,L3); W(2,3,L3); W(3,3,L3);
  End;
  9: Begin Dc:=(L0+L1+L2+L3+2) Shr 2; For J:=0 To 3 Do For I:=0 To 3 Do W(I,J,
   Dc); End;
  10: Begin Dc:=(T0+T1+T2+T3+2) Shr 2; For J:=0 To 3 Do For I:=0 To 3 Do W(I,J,
   Dc); End;
  Else For J:=0 To 3 Do For I:=0 To 3 Do W(I,J,128);
 End;
End;

Procedure S3Pred16(P: PEABuffer; O,St,Mode: LongInt);
Var I,J,Dc,H,V,K,A,B,Hh,Vv: LongInt; S0,S1,S2: LongInt;
Begin
 Case Mode Of
  0: Begin
   Dc:=0; For I:=0 To 15 Do Dc:=Dc+P^[O-1+I*St]; For I:=0 To 15 Do Dc:=Dc+P^[O+
    I-St];
   Dc:=(Dc+16) Shr 5; For J:=0 To 15 Do For I:=0 To 15 Do P^[O+I+J*St]:=Dc;
  End;
  1: For J:=0 To 15 Do Begin Dc:=P^[O-1+J*St]; For I:=0 To 15 Do P^[O+I+J*St]:=
   Dc; End;
  2: For J:=0 To 15 Do For I:=0 To 15 Do P^[O+I+J*St]:=P^[O+I-St];
  3: Begin
   S0:=O+7-St; S1:=O+8*St-1; S2:=S1-2*St;
   H:=P^[S0+1]-P^[S0-1]; V:=P^[S1]-P^[S2];
   For K:=2 To 8 Do Begin
    Inc(S1,St); Dec(S2,St);
    H:=H+K*(P^[S0+K]-P^[S0-K]); V:=V+K*(P^[S1]-P^[S2]);
   End;
   H:=(5*(H Div 4)) Div 16; V:=(5*(V Div 4)) Div 16;
   K:=H; H:=V; V:=K;
   A:=16*(P^[S1]+P^[S2+16]+1)-7*(V+H);
   For J:=0 To 15 Do Begin
    B:=A; A:=A+V;
    For I:=0 To 15 Do Begin
     P^[O+I+J*St]:=S3Clip8(S3Sar(B+I*H,5));
    End;
   End;
  End;
  4: Begin
   Dc:=0; For I:=0 To 15 Do Dc:=Dc+P^[O-1+I*St];
   Dc:=(Dc+8) Shr 4; For J:=0 To 15 Do For I:=0 To 15 Do P^[O+I+J*St]:=Dc;
  End;
  5: Begin
   Dc:=0; For I:=0 To 15 Do Dc:=Dc+P^[O+I-St];
   Dc:=(Dc+8) Shr 4; For J:=0 To 15 Do For I:=0 To 15 Do P^[O+I+J*St]:=Dc;
  End;
  Else For J:=0 To 15 Do For I:=0 To 15 Do P^[O+I+J*St]:=128;
 End;
End;

Procedure S3PredC(P: PEABuffer; O,St,Mode: LongInt);
Var I,J,Dc0,Dc1,Dc2,Dc3,D: LongInt;
Begin
 Case Mode Of
  0: Begin
   Dc0:=0; Dc1:=0; Dc2:=0;
   For I:=0 To 3 Do Begin
    Dc0:=Dc0+P^[O-1+I*St]+P^[O+I-St]; Dc1:=Dc1+P^[O+4+I-St]; Dc2:=Dc2+P^[O-1+(I+
     4)*St];
   End;
   For J:=0 To 7 Do For I:=0 To 7 Do Begin
    If J<4 Then Begin If I<4 Then D:=(Dc0+4) Shr 3 Else D:=(Dc1+2) Shr 2; End
    Else Begin If I<4 Then D:=(Dc2+2) Shr 2 Else D:=(Dc1+Dc2+4) Shr 3; End;
    P^[O+I+J*St]:=D;
   End;
  End;
  4: Begin
   Dc0:=0; Dc2:=0;
   For I:=0 To 3 Do Begin Dc0:=Dc0+P^[O-1+I*St]; Dc2:=Dc2+P^[O-1+(I+4)*St]; End;
   For J:=0 To 7 Do For I:=0 To 7 Do Begin
    If J<4 Then D:=(Dc0+2) Shr 2 Else D:=(Dc2+2) Shr 2;
    P^[O+I+J*St]:=D;
   End;
  End;
  5: Begin
   Dc0:=0; Dc1:=0;
   For I:=0 To 3 Do Begin Dc0:=Dc0+P^[O+I-St]; Dc1:=Dc1+P^[O+4+I-St]; End;
   For J:=0 To 7 Do For I:=0 To 7 Do Begin
    If I<4 Then D:=(Dc0+2) Shr 2 Else D:=(Dc1+2) Shr 2;
    P^[O+I+J*St]:=D;
   End;
  End;
  Else For J:=0 To 7 Do For I:=0 To 7 Do P^[O+I+J*St]:=128;
 End;
End;

{ ---- IDCT ---- }
Procedure S3LumaDcIdct(Qp: LongInt);
Var Tmp: Array[0..15] Of LongInt; I,Z0,Z1,Z2,Z3,Off: LongInt; Q: Int64;
Const XOff: Array[0..3] Of Byte=(0,16,64,80);
Begin
 Q:=S3Dq[Qp];
 For I:=0 To 3 Do Begin
  Z0:=13*(S3LumaDc[4*I+0]+S3LumaDc[4*I+2]); Z1:=13*(S3LumaDc[4*I+0]-S3LumaDc[4*
   I+2]);
  Z2:=7*S3LumaDc[4*I+1]-17*S3LumaDc[4*I+3]; Z3:=17*S3LumaDc[4*I+1]+7*S3LumaDc[4*
   I+3];
  Tmp[4*I+0]:=Z0+Z3; Tmp[4*I+1]:=Z1+Z2; Tmp[4*I+2]:=Z1-Z2; Tmp[4*I+3]:=Z0-Z3;
 End;
 For I:=0 To 3 Do Begin
  Off:=XOff[I];
  Z0:=13*(Tmp[0+I]+Tmp[8+I]); Z1:=13*(Tmp[0+I]-Tmp[8+I]);
  Z2:=7*Tmp[4+I]-17*Tmp[12+I]; Z3:=17*Tmp[4+I]+7*Tmp[12+I];
  S3Mb[16*0+Off]:=SmallInt(S3Sar(S3S32((Int64(Z0+Z3)*Q+$80000) And $FFFFFFFF),
   20));
  S3Mb[16*2+Off]:=SmallInt(S3Sar(S3S32((Int64(Z1+Z2)*Q+$80000) And $FFFFFFFF),
   20));
  S3Mb[16*8+Off]:=SmallInt(S3Sar(S3S32((Int64(Z1-Z2)*Q+$80000) And $FFFFFFFF),
   20));
  S3Mb[16*10+Off]:=SmallInt(S3Sar(S3S32((Int64(Z0-Z3)*Q+$80000) And $FFFFFFFF),
   20));
 End;
End;

Procedure S3AddIdct(P: PEABuffer; O,St,Qp,Dc,Bk: LongInt);
Var Q,Dcv,Rr,Z0,Z1,Z2,Z3: Int64; I,A0,A1,A2,A3,B: LongInt;
Begin
 Q:=S3Dq[Qp]; Dcv:=0;
 If Dc<>0 Then Begin
  If Dc=1 Then Begin
   Dcv:=(1538*Int64(S3Mb[Bk])) And $FFFFFFFF; Dcv:=S3S32((Dcv*169) And
    $FFFFFFFF);
  End Else Begin
   Dcv:=(Q*(S3Sar(S3Mb[Bk],3))) Div 2; Dcv:=S3S32(Dcv*169);
  End;
  S3Mb[Bk]:=0;
 End;
 For I:=0 To 3 Do Begin
  A0:=S3Mb[Bk+0+4*I]; A1:=S3Mb[Bk+1+4*I]; A2:=S3Mb[Bk+2+4*I]; A3:=S3Mb[Bk+3+4*
   I];
  Z0:=13*(A0+A2); Z1:=13*(A0-A2); Z2:=7*A1-17*A3; Z3:=17*A1+7*A3;
  S3Mb[Bk+0+4*I]:=SmallInt(Z0+Z3); S3Mb[Bk+1+4*I]:=SmallInt(Z1+Z2); S3Mb[Bk+2+4*
   I]:=SmallInt(Z1-Z2); S3Mb[Bk+3+4*I]:=SmallInt(Z0-Z3);
 End;
 Rr:=(Dcv+$80000) And $FFFFFFFF;
 For I:=0 To 3 Do Begin
  A0:=S3Mb[Bk+I+0]; A1:=S3Mb[Bk+I+4]; A2:=S3Mb[Bk+I+8]; A3:=S3Mb[Bk+I+12];
  Z0:=(13*(A0+A2)) And $FFFFFFFF; Z1:=(13*(A0-A2)) And $FFFFFFFF;
  Z2:=(7*A1-17*A3) And $FFFFFFFF; Z3:=(17*A1+7*A3) And $FFFFFFFF;
  B:=O+I;
  P^[B]:=S3Clip8(P^[B]+LongInt(S3Sar(S3S32((((Z0+Z3)*Q) And $FFFFFFFF)+Rr),
   20)));
  B:=B+St;
  P^[B]:=S3Clip8(P^[B]+LongInt(S3Sar(S3S32((((Z1+Z2)*Q) And $FFFFFFFF)+Rr),
   20)));
  B:=B+St;
  P^[B]:=S3Clip8(P^[B]+LongInt(S3Sar(S3S32((((Z1-Z2)*Q) And $FFFFFFFF)+Rr),
   20)));
  B:=B+St;
  P^[B]:=S3Clip8(P^[B]+LongInt(S3Sar(S3S32((((Z0-Z3)*Q) And $FFFFFFFF)+Rr),
   20)));
 End;
 For I:=0 To 15 Do S3Mb[Bk+I]:=0;
End;

{ svq3_decode_block ; renvoie 0 ou -1 }
Function S3DecBlock(Var G: TS3Gb; Base,Index,Typ: LongInt; Lum: Boolean):
 LongInt;
Var Run,Level,Sign,Lim,Intra,Idx: LongInt; Vlc: Int64; V: Int64; Sc: LongInt;
 Stop: Boolean;
Function ScanAt(I: LongInt): LongInt;
Begin
 Case Typ Of
  1,0: ScanAt:=S3Zigzag[I];
  2: ScanAt:=S3Scan[I];
  Else ScanAt:=S3ChromaDcScan[I];
 End;
End;
Begin
 S3DecBlock:=-1;
 Intra:=(3*Typ) Shr 2;
 Lim:=16 Shr Intra; Idx:=Index;
 While Idx<16 Do Begin
  Stop:=False;
  While True Do Begin
   Vlc:=S3Ue(G);
   If Vlc=0 Then Break;
   If Vlc>=$80000000 Then Exit;
   If (Vlc And 1)<>0 Then Sign:=0 Else Sign:=-1;
   Vlc:=(Vlc+1) Shr 1;
   If Typ=3 Then Begin
    If Vlc<3 Then Begin Run:=0; Level:=Vlc; End
    Else If Vlc<4 Then Begin Run:=1; Level:=1; End
    Else Begin Run:=Vlc And 3; Level:=((Vlc+9) Shr 2)-Run; End;
   End Else Begin
    If Vlc<16 Then Begin Run:=S3Dct[Intra*32+Vlc*2]; Level:=S3Dct[Intra*32+Vlc*
     2+1]; End
    Else If Intra<>0 Then Begin
     Run:=Vlc And 7;
     V:=0; If Run=0 Then V:=8 Else If Run<2 Then V:=2 Else If Run<5 Then V:=0
      Else V:=-1;
     Level:=(Vlc Shr 3)+V;
    End Else Begin
     Run:=Vlc And 15;
     V:=0; If Run=0 Then V:=4 Else If Run<3 Then V:=2 Else If Run<10 Then V:=1
      Else V:=0;
     Level:=(Vlc Shr 4)+V;
    End;
   End;
   Inc(Idx,Run);
   If Idx>=Lim Then Exit;
   Sc:=ScanAt(Idx);
   If Lum Then S3LumaDc[Sc]:=SmallInt((Level Xor Sign)-Sign) Else S3Mb[Base+
    Sc]:=SmallInt((Level Xor Sign)-Sign);
   Inc(Idx);
  End;
  If Typ<>2 Then Break;
  Idx:=Lim; Inc(Lim,8);
 End;
 S3DecBlock:=0;
End;

{ ---- images ---- }
Procedure S3FreePic(I: LongInt);
Var K: LongInt;
Begin
 With S3Pic[I] Do Begin
  For K:=0 To 2 Do If Raw[K]<>Nil Then Begin FreeMem(Raw[K]); Raw[K]:=Nil; Pl[
   K]:=Nil; End;
  For K:=0 To 1 Do Begin
   If MvX[K]<>Nil Then Begin FreeMem(MvX[K]); MvX[K]:=Nil; End;
   If MvY[K]<>Nil Then Begin FreeMem(MvY[K]); MvY[K]:=Nil; End;
  End;
  If MbT<>Nil Then Begin FreeMem(MbT); MbT:=Nil; End;
  Have:=False;
 End;
End;

{ nouvelle image : les tableaux de mouvements/types persistent d'une utilisation
 a l'autre (comme SVQ3Frame) }
Procedure S3GetPic(I: LongInt);
Var K,Sz,Mg: LongInt;
Begin
 With S3Pic[I] Do Begin
  If MbT=Nil Then Begin
   MbLen:=(S3MbStride*(S3MbH+1)+1+S3MbStride)+S3MbStride*2+2;
   GetMem(MbT,MbLen*4); FillChar(MbT^,MbLen*4,0); MbTOrg:=2*S3MbStride+1;
   MvLen:=S3BStride*S3MbH*4+S3MbW*4+8+4;
   For K:=0 To 1 Do Begin
    GetMem(MvX[K],MvLen*4); FillChar(MvX[K]^,MvLen*4,0);
    GetMem(MvY[K],MvLen*4); FillChar(MvY[K]^,MvLen*4,0);
   End;
  End;
  For K:=0 To 2 Do Begin
   If Raw[K]<>Nil Then Begin FreeMem(Raw[K]); Raw[K]:=Nil; End;
   If K=0 Then Begin Sz:=S3Ls*(S3MbH*16+32); Mg:=S3Ls*2+1024; End Else Begin
    Sz:=S3Cs*(S3MbH*8+16); Mg:=S3Cs*2+1024; End;
   RawSz[K]:=Sz+2*Mg;
   GetMem(Raw[K],RawSz[K]); FillChar(Raw[K]^,RawSz[K],S3FillV);
   Pl[K]:=PEABuffer(@Raw[K]^[Mg]);
  End;
  Have:=True; Idx:=S3PktIdx; { pts de la trame = celui du paquet qui l'a allouee
   (get_buffer) }
 End;
End;

Procedure S3UnrefPic(I: LongInt);
Var K: LongInt;
Begin
 With S3Pic[I] Do Begin
  For K:=0 To 2 Do If Raw[K]<>Nil Then Begin FreeMem(Raw[K]); Raw[K]:=Nil; Pl[
   K]:=Nil; End;
  Have:=False;
 End;
End;

{ ---- compensation de mouvement ---- }
Procedure S3PutPix(Dst,Src: PEABuffer; DO_,SO,DStr,SSt,W,H,Dxy,Tp: LongInt; Avg:
 Boolean);
Var X,Y,A,B,C,D,V: LongInt;
Begin
 For Y:=0 To H-1 Do
  For X:=0 To W-1 Do Begin
   A:=Src^[SO+Y*SSt+X];
   If Tp=0 Then Begin
    Case Dxy Of
     0: V:=A;
     1: V:=(A+Src^[SO+Y*SSt+X+1]+1) Shr 1;
     2: V:=(A+Src^[SO+(Y+1)*SSt+X]+1) Shr 1;
     Else Begin
      B:=Src^[SO+Y*SSt+X+1]; C:=Src^[SO+(Y+1)*SSt+X]; D:=Src^[SO+(Y+1)*SSt+X+1];
      V:=(A+B+C+D+2) Shr 2;
     End;
    End;
   End Else Begin
    B:=Src^[SO+Y*SSt+X+1]; C:=Src^[SO+(Y+1)*SSt+X]; D:=Src^[SO+(Y+1)*SSt+X+1];
    Case Dxy Of
     0: V:=A;
     1: V:=((2*A+B+1)*683) Shr 11;
     2: V:=((A+2*B+1)*683) Shr 11;
     4: V:=((2*A+C+1)*683) Shr 11;
     5: V:=((4*A+3*B+3*C+2*D+6)*2731) Shr 15;
     6: V:=((3*A+4*B+2*C+3*D+6)*2731) Shr 15;
     8: V:=((A+2*C+1)*683) Shr 11;
     9: V:=((3*A+2*B+4*C+3*D+6)*2731) Shr 15;
     Else V:=((2*A+3*B+3*C+4*D+6)*2731) Shr 15;
    End;
   End;
   { avg_pixels2_xy2_8_c de hpeldsp.c est en fait une copie (pas de moyenne) }
   If Avg And Not ((Tp=0) And (W=2) And (Dxy=3)) Then V:=(Dst^[DO_+Y*DStr+X]+V+
    1) Shr 1;
   Dst^[DO_+Y*DStr+X]:=V;
  End;
End;

{ copie du bloc de reference avec duplication des bords (emulated_edge_mc) }
Procedure S3EmuEdge(Src: PEABuffer; SSt,BW,BH,SX,SY,EW,EH: LongInt);
Var X,Y,Xx,Yy: LongInt;
Begin
 For Y:=0 To BH-1 Do Begin
  Yy:=SY+Y; If Yy<0 Then Yy:=0 Else If Yy>EH-1 Then Yy:=EH-1;
  For X:=0 To BW-1 Do Begin
   Xx:=SX+X; If Xx<0 Then Xx:=0 Else If Xx>EW-1 Then Xx:=EW-1;
   S3Emu[Y*32+X]:=Src^[Yy*SSt+Xx];
  End;
 End;
End;

Procedure S3McPart(X,Y,W,H,Mx,My,Dxy,Tp,Dir: LongInt; Avg: Boolean);
Var Pic,I: LongInt; EmuB: Boolean; Cx,Cy: LongInt;
Begin
 If Dir=0 Then Pic:=S3Last Else Pic:=S3Next;
 Inc(Mx,X); Inc(My,Y);
 EmuB:=False;
 If (Mx<0) Or (Mx>=S3HEdge-W-1) Or (My<0) Or (My>=S3VEdge-H-1) Then Begin
  EmuB:=True;
  Mx:=S3ClipI(Mx,-16,S3HEdge-W+15); My:=S3ClipI(My,-16,S3VEdge-H+15);
 End;
 If EmuB Then Begin
  S3EmuEdge(S3Pic[Pic].Pl[0],S3Ls,W+1,H+1,Mx,My,S3HEdge,S3VEdge);
  S3PutPix(S3Pic[S3Cur].Pl[0],PEABuffer(@S3Emu),X+Y*S3Ls,0,S3Ls,32,W,H,Dxy,Tp,
   Avg);
 End Else
  S3PutPix(S3Pic[S3Cur].Pl[0],S3Pic[Pic].Pl[0],X+Y*S3Ls,Mx+My*S3Ls,S3Ls,S3Ls,W,
   H,Dxy,Tp,Avg);
 Cx:=Mx; If Mx<X Then Inc(Cx); Cx:=LongInt(S3Sar(Cx,1));
 Cy:=My; If My<Y Then Inc(Cy); Cy:=LongInt(S3Sar(Cy,1));
 W:=W Shr 1; H:=H Shr 1;
 For I:=1 To 2 Do Begin
  If EmuB Then Begin
   S3EmuEdge(S3Pic[Pic].Pl[I],S3Cs,W+1,H+1,Cx,Cy,S3HEdge Shr 1,S3VEdge Shr 1);
   S3PutPix(S3Pic[S3Cur].Pl[I],PEABuffer(@S3Emu),(X Shr 1)+(Y Shr 1)*S3Cs,0,
    S3Cs,32,W,H,Dxy,Tp,Avg);
  End Else
   S3PutPix(S3Pic[S3Cur].Pl[I],S3Pic[Pic].Pl[I],(X Shr 1)+(Y Shr 1)*S3Cs,Cx+Cy*
    S3Cs,S3Cs,S3Cs,W,H,Dxy,Tp,Avg);
 End;
End;

Procedure S3PredMotion(N,PartWidth,List,Ref: LongInt; Var Mx,My: LongInt);
Var I8,TopRef,LeftRef,DiagRef,Match,Ci: LongInt; Ax,Ay,Bx,By,Cx,Cy: LongInt;
Begin
 I8:=S3Scan8[N];
 TopRef:=S3RefC[List,I8-8]; LeftRef:=S3RefC[List,I8-1];
 Ax:=S3MvC[List,I8-1,0]; Ay:=S3MvC[List,I8-1,1];
 Bx:=S3MvC[List,I8-8,0]; By:=S3MvC[List,I8-8,1];
 DiagRef:=S3RefC[List,I8-8+PartWidth];
 If DiagRef<>-2 Then Ci:=I8-8+PartWidth Else Begin Ci:=I8-8-1; DiagRef:=S3RefC[
  List,Ci]; End;
 Cx:=S3MvC[List,Ci,0]; Cy:=S3MvC[List,Ci,1];
 Match:=Ord(DiagRef=Ref)+Ord(TopRef=Ref)+Ord(LeftRef=Ref);
 If Match>1 Then Begin Mx:=S3Mid(Ax,Bx,Cx); My:=S3Mid(Ay,By,Cy); End
 Else If Match=1 Then Begin
  If LeftRef=Ref Then Begin Mx:=Ax; My:=Ay; End
  Else If TopRef=Ref Then Begin Mx:=Bx; My:=By; End
  Else Begin Mx:=Cx; My:=Cy; End;
 End Else Begin
  If (TopRef=-2) And (DiagRef=-2) And (LeftRef<>-2) Then Begin Mx:=Ax; My:=Ay;
   End
  Else Begin Mx:=S3Mid(Ax,Bx,Cx); My:=S3Mid(Ay,By,Cy); End;
 End;
End;

Procedure S3FillMv(Dir,Bxy,W4,H4,Mx,My: LongInt);
Var I,J: LongInt;
Begin
 For J:=0 To H4-1 Do For I:=0 To W4-1 Do Begin
  S3Pic[S3Cur].MvX[Dir]^[Bxy+I+J*S3BStride]:=SmallInt(Mx);
  S3Pic[S3Cur].MvY[Dir]^[Bxy+I+J*S3BStride]:=SmallInt(My);
 End;
End;

{ svq3_mc_dir : Mode 1 entier, 2 demi, 3 tiers, 4 PREDICT }
Function S3McDir(Size,Mode,Dir: LongInt; Avg: Boolean): LongInt;
Var
 I,J,K,Mx,My,Dx,Dy,X,Y,Dxy,PartW,PartH,ExtraW,HEd,VEd,Bxy,Fx,Fy: LongInt; D:
  Int64;
Begin
 S3McDir:=-1;
 If (Size And 5)=4 Then PartW:=4 Else PartW:=16 Shr (Size And 1);
 PartH:=16 Shr ((Size+1) Div 3);
 If Mode=4 Then ExtraW:=-16*6 Else ExtraW:=0;
 HEd:=6*(S3HEdge-PartW)-ExtraW; VEd:=6*(S3VEdge-PartH)-ExtraW;
 I:=0;
 While I<16 Do Begin
  J:=0;
  While J<16 Do Begin
   Bxy:=(4*S3MbX+(J Shr 2))+(4*S3MbY+(I Shr 2))*S3BStride;
   X:=16*S3MbX+J; Y:=16*S3MbY+I;
   K:=((J Shr 2) And 1)+((I Shr 1) And 2)+((J Shr 1) And 4)+(I And 8);
   If Mode<>4 Then S3PredMotion(K,PartW Shr 2,Dir,1,Mx,My)
   Else Begin
    Mx:=S3Pic[S3Next].MvX[0]^[Bxy]*2; My:=S3Pic[S3Next].MvY[0]^[Bxy]*2;
    If Dir=0 Then Begin
     Mx:=LongInt(S3Sar((Int64(Mx)*S3FrameNumOffset) Div S3PrevFrameNumOffset+1,
      1));
     My:=LongInt(S3Sar((Int64(My)*S3FrameNumOffset) Div S3PrevFrameNumOffset+1,
      1));
    End Else Begin
     Mx:=LongInt(S3Sar((Int64(Mx)*(S3FrameNumOffset-S3PrevFrameNumOffset)) Div
      S3PrevFrameNumOffset+1,1));
     My:=LongInt(S3Sar((Int64(My)*(S3FrameNumOffset-S3PrevFrameNumOffset)) Div
      S3PrevFrameNumOffset+1,1));
    End;
   End;
   Mx:=S3ClipI(Mx,ExtraW-6*X,HEd-6*X);
   My:=S3ClipI(My,ExtraW-6*Y,VEd-6*Y);
   If Mode=4 Then Begin Dx:=0; Dy:=0; End Else Begin
    D:=S3Se(S3Gs); If (D<-32768) Or (D>32767) Then Exit; Dy:=D;
    D:=S3Se(S3Gs); If (D<-32768) Or (D>32767) Then Exit; Dx:=D;
   End;
   If Mode=3 Then Begin
    Mx:=LongInt(S3Sar(Mx+1,1))+Dx; My:=LongInt(S3Sar(My+1,1))+Dy;
    Fx:=S3FloorDiv(Mx,3); Fy:=S3FloorDiv(My,3);
    Dxy:=(Mx-3*Fx)+4*(My-3*Fy);
    S3McPart(X,Y,PartW,PartH,Fx,Fy,Dxy,1,Dir,Avg);
    Mx:=Mx+Mx; My:=My+My;
   End Else If (Mode=2) Or (Mode=4) Then Begin
    Mx:=S3FloorDiv(Mx+1,3)+Dx; My:=S3FloorDiv(My+1,3)+Dy;
    Dxy:=(Mx And 1)+2*(My And 1);
    S3McPart(X,Y,PartW,PartH,LongInt(S3Sar(Mx,1)),LongInt(S3Sar(My,1)),Dxy,0,
     Dir,Avg);
    Mx:=Mx*3; My:=My*3;
   End Else Begin
    Mx:=S3FloorDiv(Mx+3,6)+Dx; My:=S3FloorDiv(My+3,6)+Dy;
    S3McPart(X,Y,PartW,PartH,Mx,My,0,0,Dir,Avg);
    Mx:=Mx*6; My:=My*6;
   End;
   Mx:=SmallInt(Mx); My:=SmallInt(My);
   If Mode<>4 Then Begin
    If (PartH=8) And (I<8) Then Begin
     S3MvC[Dir,S3Scan8[K]+8,0]:=Mx; S3MvC[Dir,S3Scan8[K]+8,1]:=My;
     If (PartW=8) And (J<8) Then Begin S3MvC[Dir,S3Scan8[K]+9,0]:=Mx; S3MvC[Dir,
      S3Scan8[K]+9,1]:=My; End;
    End;
    If (PartW=8) And (J<8) Then Begin S3MvC[Dir,S3Scan8[K]+1,0]:=Mx; S3MvC[Dir,
     S3Scan8[K]+1,1]:=My; End;
    If (PartW=4) Or (PartH=4) Then Begin S3MvC[Dir,S3Scan8[K],0]:=Mx; S3MvC[Dir,
     S3Scan8[K],1]:=My; End;
   End;
   S3FillMv(Dir,Bxy,PartW Shr 2,PartH Shr 2,Mx,My);
   Inc(J,PartW);
  End;
  Inc(I,PartH);
 End;
 S3McDir:=0;
End;

{ ---- verification des modes intra (h264_parse.c) ---- }
Function S3CheckIntraPred(Top,Left,Mode,IsChroma: LongInt): LongInt;
Const TopT: Array[0..3] Of ShortInt=(4,1,-1,-1); LeftT: Array[0..4] Of
 ShortInt=(5,-1,2,-1,6);
Begin
 S3CheckIntraPred:=-1;
 If LongWord(Mode)>3 Then Exit;
 If (Top And $8000)=0 Then Begin
  Mode:=TopT[Mode];
  If Mode<0 Then Exit;
 End;
 If (Left And $8080)<>$8080 Then Begin
  Mode:=LeftT[Mode];
  If Mode<0 Then Exit;
  If (IsChroma<>0) And ((Left And $8080)<>0) Then Begin
   Mode:=7+Ord((Left And $8000)=0)+2*Ord(Mode=6);
  End;
 End;
 S3CheckIntraPred:=Mode;
End;

Function S3CheckI4(Top,Left: LongInt): LongInt;
Const
 TopT: Array[0..11] Of ShortInt=(-1,0,9,-1,-1,-1,-1,-1,0,0,0,0);
 LeftT: Array[0..11] Of ShortInt=(0,-1,10,0,-1,-1,-1,0,-1,11,0,0);
 Mask: Array[0..3] Of Word=($8000,$2000,$80,$20);
Var I,St: LongInt;
Begin
 S3CheckI4:=-1;
 If (Top And $8000)=0 Then
  For I:=0 To 3 Do Begin
   St:=TopT[S3I4Cache[12+I]];
   If St<0 Then Exit Else If St<>0 Then S3I4Cache[12+I]:=St;
  End;
 If (Left And $8888)<>$8888 Then
  For I:=0 To 3 Do
   If (Left And Mask[I])=0 Then Begin
    St:=LeftT[S3I4Cache[12+8*I]];
    If St<0 Then Exit Else If St<>0 Then S3I4Cache[12+8*I]:=St;
   End;
 S3CheckI4:=0;
End;

Function S3Rl32(P: PEABuffer; At: LongInt): Int64;
Begin S3Rl32:=Int64(P^[At]) Or (Int64(P^[At+1]) Shl 8) Or (Int64(P^[At+2]) Shl
 16) Or (Int64(P^[At+3]) Shl 24); End;

{ svq3_decode_slice_header ; 0 si bon }
Function S3SliceHeader: LongInt;
Var Header,Len,SliceLength,SliceBits,SliceBytes,I,SId,Q,Hd: LongInt; B: Int64;
Begin
 S3SliceHeader:=-1;
 Header:=S3Bits(S3Gb,8);
 If (((Header And $9F)<>1) And ((Header And $9F)<>2)) Or ((Header And $60)=0)
  Then Exit;
 Len:=(Header Shr 5) And 3;
 SliceLength:=S3Show(S3Gb,8*Len);
 SliceBits:=SliceLength*8; SliceBytes:=SliceLength+Len-1;
 S3Bits(S3Gb,8);
 If Int64(SliceBytes)*8>S3Left(S3Gb) Then Exit;
 If SliceBytes+64>S3SliceCap Then Begin
  If S3SliceBuf<>Nil Then FreeMem(S3SliceBuf);
  S3SliceCap:=SliceBytes+1024; GetMem(S3SliceBuf,S3SliceCap);
 End;
 FillChar(S3SliceBuf^,SliceBytes+64,0);
 Move(S3Gb.Buf^[S3Gb.Pos Shr 3],S3SliceBuf^,SliceBytes);
 If Len>0 Then Move(S3SliceBuf^[SliceLength],S3SliceBuf^[0],Len-1);
 If S3WmKey<>0 Then Begin
  B:=S3Rl32(S3SliceBuf,1) Xor S3WmKey;
  S3SliceBuf^[1]:=B And 255; S3SliceBuf^[2]:=(B Shr 8) And 255; S3SliceBuf^[3]:=
   (B Shr 16) And 255; S3SliceBuf^[4]:=(B Shr 24) And 255;
 End;
 S3Gs.Buf:=S3SliceBuf; S3Gs.Size:=SliceBits; S3Gs.Pos:=0;
 Inc(S3Gb.Pos,SliceBytes*8);
 B:=S3Ue(S3Gs);
 If B>=3 Then Exit;
 SId:=B;
 Case SId Of 0: S3SliceType:=2; 1: S3SliceType:=3; Else S3SliceType:=1; End;
 If (Header And $9F)=2 Then Begin
  If S3MbNum<64 Then I:=6 Else Begin
   Q:=S3MbNum-1; I:=0; While Q>1 Do Begin Q:=Q Shr 1; Inc(I); End; I:=I+1;
  End;
  S3Bits(S3Gs,I);
 End Else If S3Bits(S3Gs,1)<>0 Then Exit;
 S3SliceNum:=S3Bits(S3Gs,8);
 S3Qscale:=S3Bits(S3Gs,5);
 S3Adaptive:=S3Bits(S3Gs,1)<>0;
 S3Bits(S3Gs,1);
 If S3Wm Then S3Bits(S3Gs,1);
 S3Bits(S3Gs,1);
 S3Bits(S3Gs,2);
 If S3Skip1Stop8(S3Gs)<0 Then Exit;
 { reinitialisation des predicteurs intra et invalidation des vecteurs }
 If S3MbX>0 Then Begin
  For I:=0 To 3 Do S3I4Mode[S3Mb2br^[S3MbXY-1]+3+I]:=-1;
  For I:=0 To 8*S3MbX-1 Do S3I4Mode[S3Mb2br^[S3MbXY-S3MbX]+I]:=-1;
 End;
 If S3MbY>0 Then Begin
  For I:=0 To 8*(S3MbW-S3MbX)-1 Do S3I4Mode[S3Mb2br^[S3MbXY-S3MbStride]+I]:=-1;
  If S3MbX>0 Then S3I4Mode[S3Mb2br^[S3MbXY-S3MbStride-1]+3]:=-1;
 End;
 S3SliceHeader:=0;
End;

Const
 S3TSkip=2048; S3T16=8; S3TI4=1; S3TI16=2;

{ svq3_decode_mb ; 0 si bon }
Function S3DecodeMb(MbT0: LongInt): LongInt;
Var
 I,J,K,M,Dir,Mode,Cbp,Bxy,Typ,Idx,I4B,PrevL,Ci: LongInt; MbT: Int64; Vlc,Q:
  Int64; Done: Boolean; Cur: LongInt;
Begin
 S3DecodeMb:=-1;
 Cur:=S3Cur; Cbp:=0;
 Bxy:=4*S3MbX+4*S3MbY*S3BStride;
 If S3MbY=0 Then S3TopAv:=$33FF Else S3TopAv:=$FFFF;
 If S3MbX=0 Then S3LeftAv:=$5F5F Else S3LeftAv:=$FFFF;
 MbT:=MbT0;
 If MbT0=0 Then Begin
  Done:=(S3PictType=2);
  If Not Done Then Done:=(LongWord(S3Pic[S3Next].MbT^[S3Pic[S3Next].MbTOrg+
   S3MbXY])=$FFFFFFFF);
  If Done Then Begin
   S3McPart(16*S3MbX,16*S3MbY,16,16,0,0,0,0,0,False);
   If S3PictType=3 Then S3McPart(16*S3MbX,16*S3MbY,16,16,0,0,0,0,1,True);
   MbT:=S3TSkip;
  End Else Begin
   Q:=LongWord(S3Pic[S3Next].MbT^[S3Pic[S3Next].MbTOrg+S3MbXY]);
   If Q>6 Then Q:=6;
   If S3McDir(Q,4,0,False)<0  Then Exit;
   If S3McDir(Q,4,1,True)<0  Then Exit;
   MbT:=S3T16;
  End;
 End Else If MbT0<8 Then Begin
  Done:=False; Mode:=1;
  If S3Third Then Begin
   If Ord(S3Half)=Ord(S3Bits(S3Gs,1)=0) Then Begin Mode:=3; Done:=True; End;
  End;
  If Not Done Then Begin
   If S3Half Then Begin
    If Ord(S3Third)=Ord(S3Bits(S3Gs,1)=0) Then Begin Mode:=2; Done:=True; End;
   End;
  End;
  If Not Done Then Mode:=1;
  For M:=0 To 1 Do Begin
   If (S3MbX>0) And (S3I4Mode[S3Mb2br^[S3MbXY-1]+6]<>-1) Then Begin
    For I:=0 To 3 Do Begin
     S3MvC[M,12-1+I*8,0]:=S3Pic[Cur].MvX[M]^[Bxy-1+I*S3BStride];
     S3MvC[M,12-1+I*8,1]:=S3Pic[Cur].MvY[M]^[Bxy-1+I*S3BStride];
    End;
   End Else
    For I:=0 To 3 Do Begin S3MvC[M,12-1+I*8,0]:=0; S3MvC[M,12-1+I*8,1]:=0; End;
   If S3MbY>0 Then Begin
    For I:=0 To 3 Do Begin
     S3MvC[M,12-8+I,0]:=S3Pic[Cur].MvX[M]^[Bxy-S3BStride+I];
     S3MvC[M,12-8+I,1]:=S3Pic[Cur].MvY[M]^[Bxy-S3BStride+I];
    End;
    If S3I4Mode[S3Mb2br^[S3MbXY-S3MbStride]]=-1 Then Ci:=-2 Else Ci:=1;
    For I:=4 To 7 Do S3RefC[M,I]:=Ci;
    If S3MbX<S3MbW-1 Then Begin
     S3MvC[M,12+4-8,0]:=S3Pic[Cur].MvX[M]^[Bxy-S3BStride+4];
     S3MvC[M,12+4-8,1]:=S3Pic[Cur].MvY[M]^[Bxy-S3BStride+4];
     If (S3I4Mode[S3Mb2br^[S3MbXY-S3MbStride+1]+6]=-1) Or (S3I4Mode[S3Mb2br^[
      S3MbXY-S3MbStride]]=-1) Then S3RefC[M,12+4-8]:=-2 Else S3RefC[M,12+4-8]:=
      1;
    End Else S3RefC[M,12+4-8]:=-2;
    If S3MbX>0 Then Begin
     S3MvC[M,12-1-8,0]:=S3Pic[Cur].MvX[M]^[Bxy-S3BStride-1];
     S3MvC[M,12-1-8,1]:=S3Pic[Cur].MvY[M]^[Bxy-S3BStride-1];
     If S3I4Mode[S3Mb2br^[S3MbXY-S3MbStride-1]+3]=-1 Then S3RefC[M,12-1-8]:=-2
      Else S3RefC[M,12-1-8]:=1;
    End Else S3RefC[M,12-1-8]:=-2;
   End Else
    For I:=3 To 10 Do S3RefC[M,I]:=-2;
   If S3PictType<>3 Then Break;
  End;
  If S3PictType=2 Then Begin
   If S3McDir(MbT0-1,Mode,0,False)<0  Then Exit;
  End Else Begin
   If MbT0<>2 Then Begin
    If S3McDir(0,Mode,0,False)<0  Then Exit;
   End Else
    For I:=0 To 3 Do For J:=0 To 3 Do Begin S3Pic[Cur].MvX[0]^[Bxy+I*S3BStride+
     J]:=0; S3Pic[Cur].MvY[0]^[Bxy+I*S3BStride+J]:=0; End;
   If MbT0<>1 Then Begin
    If S3McDir(0,Mode,1,MbT0=3)<0  Then Exit;
   End Else
    For I:=0 To 3 Do For J:=0 To 3 Do Begin S3Pic[Cur].MvX[1]^[Bxy+I*S3BStride+
     J]:=0; S3Pic[Cur].MvY[1]^[Bxy+I*S3BStride+J]:=0; End;
  End;
  MbT:=S3T16;
 End Else If (MbT0=8) Or (MbT0=33) Then Begin
  I4B:=S3Mb2br^[S3MbXY];
  FillChar(S3I4Cache,SizeOf(S3I4Cache),255);
  If MbT0=8 Then Begin
   If S3MbX>0 Then Begin
    For I:=0 To 3 Do S3I4Cache[12-1+I*8]:=S3I4Mode[S3Mb2br^[S3MbXY-1]+6-I];
    If S3I4Cache[12-1]=-1 Then S3LeftAv:=$5F5F;
   End;
   If S3MbY>0 Then Begin
    For I:=0 To 3 Do S3I4Cache[4+I]:=S3I4Mode[S3Mb2br^[S3MbXY-S3MbStride]+I];
    If S3I4Cache[4]=-1 Then S3TopAv:=$33FF;
   End;
   I:=0;
   While I<16 Do Begin
    Vlc:=S3Ue(S3Gs);
    If Vlc>=25  Then Exit;
    K:=S3Scan8[I];
    S3I4Cache[K]:=S3Pred1[((S3I4Cache[K-8]+1)*6+(S3I4Cache[K-1]+1))*5+S3Pred0[
     Vlc*2]];
    S3I4Cache[K+1]:=S3Pred1[((S3I4Cache[K-8+1]+1)*6+(S3I4Cache[K]+1))*5+S3Pred0[
     Vlc*2+1]];
    If (S3I4Cache[K]=-1) Or (S3I4Cache[K+1]=-1)  Then Exit;
    Inc(I,2);
   End;
  End Else
   For I:=0 To 3 Do For J:=0 To 3 Do S3I4Cache[12+8*I+J]:=2;
  For I:=0 To 3 Do S3I4Mode[I4B+I]:=S3I4Cache[4+8*4+I];
  S3I4Mode[I4B+4]:=S3I4Cache[7+8*3]; S3I4Mode[I4B+5]:=S3I4Cache[7+8*2];
   S3I4Mode[I4B+6]:=S3I4Cache[7+8*1];
  If MbT0=8 Then Begin
   S3CheckI4(S3TopAv,S3LeftAv);
   If S3MbY=0 Then S3TopAv:=$33FF Else S3TopAv:=$FFFF;
   If S3MbX=0 Then S3LeftAv:=$5F5F Else S3LeftAv:=$FFFF;
  End Else Begin
   For I:=0 To 3 Do For J:=0 To 3 Do S3I4Cache[12+8*I+J]:=11;
   S3TopAv:=$33FF; S3LeftAv:=$5F5F;
  End;
  MbT:=S3TI4;
 End Else Begin
  Dir:=S3IMbPm[MbT0-8];
  Dir:=(Dir Shr 1) Xor (3*(Dir And 1)) Xor 1;
  S3I16Mode:=S3CheckIntraPred(S3TopAv,S3LeftAv,Dir,0);
  If S3I16Mode<0  Then Exit;
  Cbp:=S3IMbCbp[MbT0-8];
  MbT:=S3TI16;
 End;
 If ((MbT And 120)=0) And (S3PictType<>1) Then Begin
  For I:=0 To 3 Do For J:=0 To 3 Do Begin S3Pic[Cur].MvX[0]^[Bxy+I*S3BStride+
   J]:=0; S3Pic[Cur].MvY[0]^[Bxy+I*S3BStride+J]:=0; End;
  If S3PictType=3 Then
   For I:=0 To 3 Do For J:=0 To 3 Do Begin S3Pic[Cur].MvX[1]^[Bxy+I*S3BStride+
    J]:=0; S3Pic[Cur].MvY[1]^[Bxy+I*S3BStride+J]:=0; End;
 End;
 If (MbT And S3TI4)=0 Then
  For I:=0 To 7 Do S3I4Mode[S3Mb2br^[S3MbXY]+I]:=2;
 If ((MbT And S3TSkip)=0) Or (S3PictType=3) Then FillChar(S3Nnz,SizeOf(S3Nnz),
  0);
 If ((MbT And S3TI16)=0) And (((MbT And S3TSkip)=0) Or (S3PictType=3)) Then
  Begin
  Vlc:=S3Ue(S3Gs);
  If Vlc>=48  Then Exit;
  If (MbT And 7)<>0 Then Cbp:=S3CbpIntra[Vlc] Else Cbp:=S3CbpInter[Vlc];
 End;
 If ((MbT And S3TI16)<>0) Or ((S3PictType<>1) And S3Adaptive And (Cbp<>0)) Then
  Begin
  Q:=S3Qscale+S3Se(S3Gs);
  If (Q<0) Or (Q>31)  Then Exit;
  S3Qscale:=Q;
 End;
 If (MbT And S3TI16)<>0 Then Begin
  FillChar(S3LumaDc,SizeOf(S3LumaDc),0);
  If S3DecBlock(S3Gs,0,0,1,True)<>0  Then Exit;
 End;
 If Cbp<>0 Then Begin
  If (MbT And S3TI16)<>0 Then Idx:=1 Else Idx:=0;
  If (S3Qscale<24) And ((MbT And S3TI4)<>0) Then Typ:=2 Else Typ:=1;
  For I:=0 To 3 Do
   If (Cbp And (1 Shl I))<>0 Then
    For J:=0 To 3 Do Begin
     If Idx<>0 Then K:=(J And 1)+2*(I And 1)+2*(J And 2)+4*(I And 2) Else K:=4*
      I+J;
     S3Nnz[K]:=1;
     If S3DecBlock(S3Gs,16*K,Idx,Typ,False)<>0  Then Exit;
    End;
  If (Cbp And $30)<>0 Then Begin
   For I:=1 To 2 Do If S3DecBlock(S3Gs,16*16*I,0,3,False)<>0  Then Exit;
   If (Cbp And $20)<>0 Then
    For I:=1 To 2 Do
     For J:=0 To 3 Do Begin
      K:=16*I+J; S3Nnz[K]:=1;
      If S3DecBlock(S3Gs,16*K,1,1,False)<>0  Then Exit;
     End;
  End;
 End;
 S3Cbp:=Cbp;
 S3Pic[Cur].MbT^[S3Pic[Cur].MbTOrg+S3MbXY]:=MbT;
 If (MbT And 7)<>0 Then S3ChromaPred:=S3CheckIntraPred(S3TopAv,S3LeftAv,0,1);
 S3DecodeMb:=0;
End;

Procedure S3HlMb;
Var
 MbT,I,J,Lin,UvLin,Dy,Dc,Dcr,Nz,Dir,Tr,Qs: LongInt; Y,Cb,Cr: PEABuffer;
 A,B,C,D,E: LongInt;
Begin
 MbT:=S3Pic[S3Cur].MbT^[S3Pic[S3Cur].MbTOrg+S3MbXY];
 Lin:=S3Ls; UvLin:=S3Cs;
 Y:=S3Pic[S3Cur].Pl[0]; Cb:=S3Pic[S3Cur].Pl[1]; Cr:=S3Pic[S3Cur].Pl[2];
 Dy:=16*S3MbX+16*S3MbY*Lin; Dc:=8*S3MbX+8*S3MbY*UvLin;
 If (MbT And 7)<>0 Then Begin
  S3PredC(Cb,Dc,UvLin,S3ChromaPred);
  S3PredC(Cr,Dc,UvLin,S3ChromaPred);
  If (MbT And S3TI4)<>0 Then Begin
   For I:=0 To 15 Do Begin
    Dir:=S3I4Cache[S3Scan8[I]];
    Tr:=Dy+S3BlkOff[I]+4-Lin;
    S3Pred4(Y,Dy+S3BlkOff[I],Lin,Dir,Tr);
    If S3Nnz[I]<>0 Then S3AddIdct(Y,Dy+S3BlkOff[I],Lin,S3Qscale,0,I*16);
   End;
  End Else Begin
   S3Pred16(Y,Dy,Lin,S3I16Mode);
   S3LumaDcIdct(S3Qscale);
  End;
 End;
 If (MbT And S3TI4)=0 Then
  For I:=0 To 15 Do
   If (S3Nnz[I]<>0) Or (S3Mb[I*16]<>0) Then Begin
    If (MbT And 7)<>0 Then Dcr:=1 Else Dcr:=0;
    S3AddIdct(Y,Dy+S3BlkOff[I],Lin,S3Qscale,Dcr,I*16);
   End;
 If (S3Cbp And $30)<>0 Then Begin
  For J:=1 To 2 Do Begin
   A:=S3Mb[256*J]; B:=S3Mb[256*J+16]; C:=S3Mb[256*J+32]; D:=S3Mb[256*J+48];
   E:=A-B; A:=A+B; B:=C-D; C:=C+D;
   S3Mb[256*J]:=SmallInt(S3Sar((A+C)*1024,7));
   S3Mb[256*J+16]:=SmallInt(S3Sar((E+B)*1024,7));
   S3Mb[256*J+32]:=SmallInt(S3Sar((A-C)*1024,7));
   S3Mb[256*J+48]:=SmallInt(S3Sar((E-B)*1024,7));
  End;
  Qs:=S3ChromaQp[S3Qscale+12]-12;
  For J:=1 To 2 Do
   For I:=J*16 To J*16+3 Do
    If (S3Nnz[I]<>0) Or (S3Mb[I*16]<>0) Then Begin
     If J=1 Then S3AddIdct(Cb,Dc+S3CBlkOff[I And 3],UvLin,Qs,2,I*16)
     Else S3AddIdct(Cr,Dc+S3CBlkOff[I And 3],UvLin,Qs,2,I*16);
    End;
 End;
End;

Var S3Pkt: PEABuffer; S3PktCap: LongInt;

Procedure S3Setup;
Var X,Y,I,W,L0,L1,D: LongInt; Un: Boolean;
Begin
 S3MbW:=(S3W+15) Div 16; S3MbH:=(S3H+15) Div 16;
 S3MbStride:=S3MbW+1; S3MbNum:=S3MbW*S3MbH; S3BStride:=4*S3MbW;
 S3HEdge:=S3MbW*16; S3VEdge:=S3MbH*16;
 W:=S3HEdge;
 Repeat
  L0:=W; L1:=(W+1) Shr 1;
  W:=W+(W And (-W));
  Un:=((L0 Mod 64)<>0) Or ((L1 Mod 64)<>0);
 Until Not Un;
 S3Ls:=L0; S3Cs:=L1;
 FillChar(S3I4Mode,SizeOf(S3I4Mode),0);
 GetMem(S3Mb2br,S3MbStride*(S3MbH+1)*4+16); FillChar(S3Mb2br^,S3MbStride*(S3MbH+
  1)*4+16,0);
 For Y:=0 To S3MbH-1 Do For X:=0 To S3MbW-1 Do S3Mb2br^[X+Y*S3MbStride]:=8*((X+
  Y*S3MbStride) Mod (2*S3MbStride));
 For I:=0 To 15 Do Begin
  D:=S3Scan8[I]-12;
  S3BlkOff[I]:=4*(D And 7)+4*S3Ls*(D Shr 3);
 End;
 For I:=0 To 3 Do Begin
  D:=S3Scan8[I]-12;
  S3CBlkOff[I]:=4*(D And 7)+4*S3Cs*(D Shr 3);
 End;
 FillChar(S3Mb,SizeOf(S3Mb),0); FillChar(S3LumaDc,SizeOf(S3LumaDc),0);
 FillChar(S3Nnz,SizeOf(S3Nnz),0);
 FillChar(S3MvC,SizeOf(S3MvC),0); FillChar(S3RefC,SizeOf(S3RefC),0);
 FillChar(S3Pic,SizeOf(S3Pic),0);
 S3Cur:=0; S3Last:=1; S3Next:=2;
 S3FrameNum:=0; S3PrevFrameNum:=0; S3FrameNumOffset:=0; S3PrevFrameNumOffset:=0;
  S3LastOut:=0;
 S3SliceBuf:=Nil; S3SliceCap:=0; S3Qscale:=0; S3Cbp:=0; S3ChromaPred:=0;
  S3I16Mode:=0;
End;

Procedure S3Release;
Var I: LongInt;
Begin
 For I:=0 To 2 Do S3FreePic(I);
 If S3Mb2br<>Nil Then Begin FreeMem(S3Mb2br); S3Mb2br:=Nil; End;
 If S3SliceBuf<>Nil Then Begin FreeMem(S3SliceBuf); S3SliceBuf:=Nil;
  S3SliceCap:=0; End;
 If S3Pkt<>Nil Then Begin FreeMem(S3Pkt); S3Pkt:=Nil; S3PktCap:=0; End;
End;

Procedure S3MissingRef(P: LongInt);
Var K,Rows: LongInt;
Begin
 S3UnrefPic(P); S3GetPic(P);
 FillChar(S3Pic[P].Pl[0]^,S3H*S3Ls,0);
 Rows:=S3H Div 2;
 For K:=1 To 2 Do FillChar(S3Pic[P].Pl[K]^,Rows*S3Cs,$80);
End;

{ svq3_decode_frame ; 0 = ok (OutP = indice de l'image sortie ou -1), <0 =
 erreur }
Function S3DecodeFrame(Pk: PEABuffer; Sz: LongInt; Var OutP: LongInt): LongInt;
Var Tmp,M,I,J,Left,MbT,Cur: LongInt; Q: Int64;
Begin
 S3DecodeFrame:=-1; OutP:=-1;
 S3MbX:=0; S3MbY:=0; S3MbXY:=0;
 If Sz+64>S3PktCap Then Begin
  If S3Pkt<>Nil Then FreeMem(S3Pkt);
  S3PktCap:=Sz+1024; GetMem(S3Pkt,S3PktCap);
 End;
 FillChar(S3Pkt^,Sz+64,0); Move(Pk^,S3Pkt^,Sz);
 S3Gb.Buf:=S3Pkt; S3Gb.Size:=Sz*8; S3Gb.Pos:=0;
 If S3SliceHeader<>0 Then Exit;
 S3PictType:=S3SliceType;
 If S3PictType<>3 Then Begin Tmp:=S3Next; S3Next:=S3Last; S3Last:=Tmp; End;
 S3UnrefPic(S3Cur);
 S3GetPic(S3Cur);
 Cur:=S3Cur;
 If S3PictType<>1 Then Begin
  If Not S3Pic[S3Last].Have Then S3MissingRef(S3Last);
  If (S3PictType=3) And Not S3Pic[S3Next].Have Then S3MissingRef(S3Next);
 End;
 If S3PictType=3 Then Begin
  S3FrameNumOffset:=S3SliceNum-S3PrevFrameNum;
  If S3FrameNumOffset<0 Then Inc(S3FrameNumOffset,256);
  If (S3FrameNumOffset=0) Or (S3FrameNumOffset>=S3PrevFrameNumOffset) Then Exit;
 End Else Begin
  S3PrevFrameNum:=S3FrameNum;
  S3FrameNum:=S3SliceNum;
  S3PrevFrameNumOffset:=S3FrameNum-S3PrevFrameNum;
  If S3PrevFrameNumOffset<0 Then Inc(S3PrevFrameNumOffset,256);
 End;
 For M:=0 To 1 Do
  For I:=0 To 3 Do Begin
   For J:=-1 To 3 Do S3RefC[M,12+8*I+J]:=1;
   If I<3 Then S3RefC[M,12+8*I+4]:=-2;
  End;
 S3MbY:=0;
 While S3MbY<S3MbH Do Begin
  S3MbX:=0;
  While S3MbX<S3MbW Do Begin
   S3MbXY:=S3MbX+S3MbY*S3MbStride;
   If S3Left(S3Gs)<=7 Then Begin
    If ((S3Gs.Pos And 7)=0) Or (S3Show(S3Gs,S3Left(S3Gs) And 7)=0) Then
     If S3SliceHeader<>0 Then Exit;
   End;
   Q:=S3Ue(S3Gs);
   If Q>1000 Then Exit;
   MbT:=Q;
   If S3PictType=1 Then Inc(MbT,8)
   Else If (S3PictType=3) And (MbT>=4) Then Inc(MbT,4);
   If (MbT>33) Or (S3DecodeMb(MbT)<>0) Then Exit;
   If (MbT<>0) Or (S3Cbp<>0) Then S3HlMb;
   If (S3PictType<>3) And Not S3LowDelay Then Begin
    If (S3PictType=2) And (MbT<8) Then S3Pic[Cur].MbT^[S3Pic[Cur].MbTOrg+S3MbX+
     S3MbY*S3MbStride]:=MbT-1
    Else S3Pic[Cur].MbT^[S3Pic[Cur].MbTOrg+S3MbX+S3MbY*S3MbStride]:=-1;
   End;
   Inc(S3MbX);
  End;
  Inc(S3MbY);
 End;
 Left:=Sz*8-S3Gs.Pos;
 If Left<0 Then Exit;
 If (S3PictType=3) Or S3LowDelay Then OutP:=S3Cur
 Else If S3Pic[S3Last].Have Then OutP:=S3Last;
 S3DecodeFrame:=0;
 If Not (S3Pic[S3Last].Have Or S3LowDelay) Then OutP:=-1;
 If S3PictType<>3 Then Begin Tmp:=S3Cur; S3Cur:=S3Next; S3Next:=Tmp; End
 Else Begin
  { l'image de sortie est copiee avant : on ne la libere qu'apres l'emission }
 End;
End;

Function S3Crc16(P: PEABuffer; Len: LongInt): Int64;
Var Tab: Array[0..255] Of Int64; I,J: LongInt; C: Int64; Crc: Int64;
Begin
 For I:=0 To 255 Do Begin
  C:=Int64(I) Shl 24;
  For J:=0 To 7 Do Begin
   If (C And $80000000)<>0 Then C:=((C Shl 1) And $FFFFFFFF) Xor ($1021 Shl 16)
   Else C:=(C Shl 1) And $FFFFFFFF;
  End;
  Tab[I]:=((C And $FF) Shl 24) Or (((C Shr 8) And $FF) Shl 16) Or (((C Shr 16)
   And $FF) Shl 8) Or ((C Shr 24) And $FF);
 End;
 Crc:=0;
 For I:=0 To Len-1 Do Crc:=Tab[(Crc And $FF) Xor P^[I]] Xor (Crc Shr 8);
 S3Crc16:=Crc And $FFFFFFFF;
End;

{ H8 : horodatage de ffmpeg pour svq3 (libavformat/mov.c : dts_shift, ctts ;
 libavcodec/decode.c : guess_correct_pts) }
Function S3RecFind(Start,Fin: LongInt; Const Name: String; Var APos,ASize:
 LongInt): Boolean;
Var P,Sz: LongInt; T: String;
Begin
 S3RecFind:=False; P:=Start; If Fin>QXSize Then Fin:=QXSize;
 While Fin-P>=8 Do Begin
  Sz:=QXB32(P); If Sz=0 Then Sz:=Fin-P;
  If (Sz<8) Or (Sz>Fin-P) Then Exit;
  T:=QXT4(P+4);
  If T=Name Then Begin APos:=P; ASize:=Sz; S3RecFind:=True; Exit; End;
  If (T='moov') Or (T='trak') Or (T='mdia') Or (T='minf') Or (T='stbl') Or (
   T='edts') Then
   If S3RecFind(P+8,P+Sz,Name,APos,ASize) Then Begin S3RecFind:=True; Exit; End;
  Inc(P,Sz);
 End;
End;

{ Dts/Pts[j] : horodatages (ticks) du paquet j apres decalage de debut ; TbN/TbD
 : base de temps ; DurT : duree d'une image }
Procedure S3Times(Dts,Pts: PTLArr; Var TbN,TbD,DurT: Int64);
Var I,J,Ap,Sp,Ts,Delta,Cnt,Ent,Dr,Shift,N,Lim: LongInt; Start: Int64; Cts:
 PALLong; Mp: LongInt;
Begin
 N:=QXCount;
 If Not QXIsMov Then Begin
  TbN:=AXScale; TbD:=AXRate; DurT:=1;
  For I:=0 To N-1 Do Begin Dts^[I]:=I; Pts^[I]:=I; End;
  Exit;
 End;
 Ts:=0; Delta:=0;
 If S3RecFind(0,QXSize,'mdhd',Ap,Sp) Then Begin If EAByte(QXF,QXSize,Ap+8)=1
  Then Ts:=QXB32(Ap+28) Else Ts:=QXB32(Ap+20); End;
 If S3RecFind(0,QXSize,'stts',Ap,Sp) Then Delta:=QXB32(Ap+20);
 If (Ts<=0) Or (Delta<=0) Then Begin
  TbN:=QXRd; TbD:=QXRn; DurT:=1;
  For I:=0 To N-1 Do Begin Dts^[I]:=I; Pts^[I]:=I; End;
  Exit;
 End;
 GetMem(Cts,N*4+8); FillChar(Cts^,N*4+8,0);
 Shift:=0; Mp:=0;
 If S3RecFind(0,QXSize,'ctts',Ap,Sp) Then Begin
  Ent:=QXB32(Ap+12); If (Ent<0) Or (Int64(Ent)*8+16>Sp) Then Ent:=0;
  J:=0;
  For I:=0 To Ent-1 Do Begin
   Cnt:=QXB32(Ap+16+8*I); Dr:=QXB32(Ap+20+8*I);
   If I+2<Ent Then If (Dr<0) And (-Dr>Shift) Then Shift:=-Dr;
   While (Cnt>0) And (J<N) Do Begin Cts^[J]:=Dr; Inc(J); Dec(Cnt); End;
  End;
 End;
 For I:=0 To N-1 Do Begin
  Dts^[I]:=Int64(I)*Delta-Shift;
  Pts^[I]:=Int64(I)*Delta+Cts^[I];
 End;
 Lim:=N; If Lim>32 Then Lim:=32;
 Start:=Pts^[0]; For I:=1 To Lim-1 Do If Pts^[I]<Start Then Start:=Pts^[I];
 For I:=0 To N-1 Do Begin Dts^[I]:=Dts^[I]-Start; Pts^[I]:=Pts^[I]-Start; End;
 FreeMem(Cts);
 TbN:=1; TbD:=Ts; DurT:=Delta;
End;

Procedure DecodeSVQ3(Const Source,Target: String; Mode: LongInt);
Var
 Pk,Out,Ext,Wm: PEABuffer; PIdx,Sz,I,Y,W,H,CW,CH,P,M,ExtLen,Sq,Sh,Fsc,Hd,N,Off,
  WmLen: LongInt; Begun,Found: Boolean; NbF,NbP: Int64; TsD,TsP: PTLArr; TbN,
  TbD,DurT,GcLastPts,GcLastDts,BestTs: Int64; GcFp,GcFd: LongInt;
 G: TS3Gb; Wd,Ht,Cap: Int64; R: Integer; Op: LongInt; WmOut: LongInt; Key:
  Int64;
Procedure Emit(Pic: LongInt; Flush: Boolean);
Var K,Y: LongInt; Re,Dt: Int64;
Begin
 W:=S3W; H:=S3H; CW:=(W+1) Shr 1; CH:=(H+1) Shr 1;
 If Not Begun Then Begin
  NVBegin(Mode,Target,W,H,7,QXRn,QXRd);
  NVSubX:=1; NVSubY:=1; NVCW:=CW; NVCH:=CH; NVHdrOk:=True; NVFullRng:=True;
  If OptPixFmt='yuv420p' Then Begin NVTo420:=True; NVYTag:=
   'C420jpeg XYSCSS=420JPEG XCOLORRANGE=LIMITED'; End
  Else NVYTag:='C420jpeg XYSCSS=420JPEG XCOLORRANGE=FULL';
  If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End Else
   NVSarN:=0;
  GetMem(Out,NVFrameBytes+64);
  Begun:=True;
 End;
 For Y:=0 To H-1 Do Move(S3Pic[Pic].Pl[0]^[Y*S3Ls],Out^[Y*W],W);
 For K:=1 To 2 Do
  For Y:=0 To CH-1 Do Move(S3Pic[Pic].Pl[K]^[Y*S3Cs],Out^[W*H+(K-1)*CW*CH+Y*CW],
   CW);
 { synchronisation CFR de ffmpeg : pts = celui du paquet d'origine ; les trous
  (paquets en erreur) sont combles par duplication }
 { libavcodec/decode.c : guess_correct_pts(pts d'origine de l'image, pkt_dts du
  paquet courant) }
 Re:=TsP^[S3Pic[Pic].Idx];
 If Flush Then Begin GcLastDts:=Re; Dt:=0; End Else Begin
  Dt:=TsD^[S3PktIdx];
  If Dt<=GcLastDts Then Inc(GcFd);
  GcLastDts:=Dt;
 End;
 If Re<=GcLastPts Then Inc(GcFp);
 GcLastPts:=Re;
 If (GcFp<=GcFd) Or Flush Then BestTs:=Re Else BestTs:=Dt;
 CFSync(BestTs,DurT,NbF,NbP);
 NVEmitN(Out,NbP,NbF); Inc(CFNext,NbF); Inc(CFFrameNo,NbF); G2CFOn:=True;
End;
Begin
 QXOpen(Source);
 S3Dbg:=False; S3PktIdx:=0; S3FillV:=0;
 W:=QXW; H:=QXH;
 S3Half:=True; S3Third:=True; S3Wm:=False; S3LowDelay:=False; S3WmKey:=0;
 { atome SMI : extradata }
 Ext:=Nil; ExtLen:=0; P:=QXExtPos;
 While P+8<=QXExtPos+QXExtLen Do Begin
  Sz:=QXB32(P); If Sz<8 Then Break;
  If QXT4(P+4)='SMI ' Then Begin
   ExtLen:=Sz; If P+ExtLen>QXSize Then ExtLen:=QXSize-P;
   Ext:=PEABuffer(@QXF^[P]); Break;
  End;
  Inc(P,Sz);
 End;
 If Ext<>Nil Then Begin
  Found:=False; M:=0;
  While M+8<ExtLen Do Begin
   If (Ext^[M]=Ord('S')) And (Ext^[M+1]=Ord('E')) And (Ext^[M+2]=Ord('Q')) And (
    Ext^[M+3]=Ord('H')) Then Begin Found:=True; Break; End;
   Inc(M);
  End;
  If Found Then Begin
   Sz:=(LongInt(Ext^[M+4]) Shl 24) Or (LongInt(Ext^[M+5]) Shl 16) Or (LongInt(
    Ext^[M+6]) Shl 8) Or LongInt(Ext^[M+7]);
   If (Sz<0) Or (Sz>ExtLen-M-8) Then Fail('svq3: extradata invalide.');
   G.Buf:=PEABuffer(@Ext^[M+8]); G.Size:=Sz*8; G.Pos:=0;
   Fsc:=S3Bits(G,3);
   Case Fsc Of
    0: Begin W:=160; H:=120; End;
    1: Begin W:=128; H:=96; End;
    2: Begin W:=176; H:=144; End;
    3: Begin W:=352; H:=288; End;
    4: Begin W:=704; H:=576; End;
    5: Begin W:=240; H:=180; End;
    6: Begin W:=320; H:=240; End;
    Else Begin W:=S3Bits(G,12); H:=S3Bits(G,12); End;
   End;
   If (W<1) Or (H<1) Then Fail('svq3: dimensions invalides.');
   S3Half:=S3Bits(G,1)<>0; S3Third:=S3Bits(G,1)<>0;
   S3Bits(G,4);
   S3LowDelay:=S3Bits(G,1)<>0;
   S3Bits(G,1);
   If S3Skip1Stop8(G)<0 Then Fail('svq3: extradata invalide.');
   S3Wm:=S3Bits(G,1)<>0;
   If S3Wm Then Begin
    Wd:=S3Ue(G); Ht:=S3Ue(G); S3Ue(G); S3Bits(G,8); S3Bits(G,2); S3Ue(G);
    Cap:=Wd*Ht*4;
    Off:=(G.Pos+7) Shr 3;
    If (Ht<=0) Or (Wd*4>Int64(4294967295) Div Ht) Or (Cap>200000000) Then Fail(
     'svq3: filigrane invalide.');
    GetMem(Wm,Cap+64);
    If (Off>Sz) Or (NVInflate(PEABuffer(@Ext^[M+8+Off]),Sz-Off,Wm,LongInt(Cap),
     WmOut)<>0) Then Fail('svq3: impossible de decompresser le filigrane.');
    Key:=S3Crc16(Wm,WmOut);
    Key:=((Key And $FF) Shl 8) Or ((Key Shr 8) And $FF);
    S3WmKey:=(Key Shl 16) Or Key;
    FreeMem(Wm);
   End;
  End;
 End;
 If (W<1) Or (H<1) Or (W>16384) Or (H>16384) Then Fail(
  'svq3: dimensions invalides.');
 S3W:=W; S3H:=H;
 S3Mb2br:=Nil; S3Pkt:=Nil; S3PktCap:=0;
 S3Setup;
 Begun:=False; Out:=Nil;
 GetMem(TsD,QXCount*8+8); GetMem(TsP,QXCount*8+8);
 S3Times(TsD,TsP,TbN,TbD,DurT);
 G2CFBegin(TbN,TbD,QXRn,QXRd,True);
 GcLastPts:=-9223372036854775807-1; GcLastDts:=GcLastPts; GcFp:=0; GcFd:=0;
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  If Sz=0 Then Continue;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]);
  S3PktIdx:=PIdx;
  I:=S3DecodeFrame(Pk,Sz,Op);
  If I<0 Then Continue;
  If Op>=0 Then Begin
   Emit(Op,False);
   If NVDone Then Break;
  End;
  If (S3PictType=3) Then S3UnrefPic(S3Cur);
 End;
 If Not NVDone Then
  If S3Pic[S3Next].Have And (Not S3LowDelay) And (S3LastOut=0) Then Begin
   S3LastOut:=1; Emit(S3Next,True);
  End;
 If Begun And G2CFOn And Not NVDone Then CFFlush(Out);
 If Out<>Nil Then FreeMem(Out);
 S3Release;
 QXClose;
 NVFinish('svq3');
End;
{ ==== G6B-END ==== }
