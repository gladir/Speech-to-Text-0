Procedure
 NVWriteY4MPlanar(P: PEABuffer);
Var
 Hdr,S: String;
 At,Tot,Q,K: LongInt;
Begin
 If Not NVOpened Then Begin
  If (OptPixFmt='yuv420p') And Not NVTo420 And Not ((NVFmt=7) And (NVSubX=1) And
   (NVSubY=1)) Then
   Fail(
    '-pix_fmt yuv420p: conversion depuis ce format de pixels non prise en char'+
    'ge.');

  OpenWrite(NVTarget); NVOpened:=True;
  Str(NVW,S); Hdr:='YUV4MPEG2 W'+S; Str(NVH,S); Hdr:=Hdr+' H'+S;
  Str(NVFpsN,S); Hdr:=Hdr+' F'+S; Str(NVFpsD,S); Hdr:=Hdr+':'+S+' Ip A';
  Str(NVSarN,S); Hdr:=Hdr+S; Str(NVSarD,S); Hdr:=Hdr+':'+S+' '+NVYTag
;
  If (Pos('XYSCSS',NVYTag)=0) And (Copy(NVYTag,1,2)='C4') Then Begin
   S:=Copy(NVYTag,2,60); For K:=1 To Length(S) Do S[K]:=UpCase(S[K]);
   Hdr:=Hdr+' XYSCSS='+S;
  End;
  If (F4YRange<>'') And (Pos('XCOLORRANGE',Hdr)=0) Then Hdr:=Hdr+F4YRange; { F4
   }
  Hdr:=Hdr
+#10;
  If NVIl<>'p' Then Begin
   K:=Pos('Ip A',Hdr); If K>0 Then Hdr[K+1]:=NVIl;
  End;
  WriteBytes(Hdr[1],Length(Hdr));
 End;
 Hdr:='FRAME'+#10; WriteBytes(Hdr[1],Length(Hdr));
 If NVTo420 Then Begin NVWriteConv420(P); Exit; End;

 Tot:=NVFrameBytes; At:=0;
 While At<Tot Do Begin
  If Tot-At>8192 Then Q:=8192 Else Q:=Tot-At;
  WriteBytes(P^[At],Q); Inc(At,Q);
 End;
End;
{ ---- conversion RGB -> YUV420P (libswscale: input.c, utils.c initFilter
 bicubique, rgb2rgb_template.c, output.c) ---- }
Type TSwsI64=Array[0..4000000] Of Int64; PSwsI64=^TSwsI64; TSwsI32=Array[
 0..4000000] Of LongInt; PSwsI32=^TSwsI32;
 TSwsF=Record Pos,Coef: PSwsI32; FS,N: LongInt; End;

Function SwsRDiv(A,B: Int64): Int64;
Begin
 If A>=0 Then SwsRDiv:=(A+(B Shr 1)) Div B Else SwsRDiv:=(A-(B Shr 1)) Div B;
End;

{ initFilter bicubique (libswscale/utils.c), sans filtre source/destination ;
 One = 1<<14 (horizontal) ou 1<<12 (vertical) }
Procedure SwsInitF(Var Fl: TSwsF; SrcW,DstW,SrcPos,DstPos: LongInt; One: Int64);
Var
 XInc,Fone,XDst,D,Dd,Ddd,Coeff,B,C,Cut,Sum,Err,V,Acc: Int64;
 FSz,I,J,K,Xx,MinF,Mn,Shift,L,Q: LongInt;
 Ft,F2: PSwsI64; Lim,DFone,DCut: Double; IntV: Int64; FPos: PSwsI32;
Begin
 XInc:=((Int64(SrcW) Shl 16)+(DstW Shr 1)) Div DstW;
 Q:=SrcW Div DstW; L:=0; While Q>1 Do Begin Q:=Q Shr 1; Inc(L); End; If L>8 Then
  L:=8;
 Fone:=Int64(1) Shl (54-L);
 B:=0; C:=10066329;
 GetMem(FPos,(Int64(DstW)+4)*4);
 Fl.N:=DstW;
 If (Abs(XInc-$10000)<10) And (SrcPos=DstPos) Then Begin
  { filtre unitaire }
  Fl.FS:=1; Fl.Pos:=FPos; GetMem(Fl.Coef,Int64(DstW)*4+64);
  For I:=0 To DstW-1 Do Begin
   FPos^[I]:=I;
   Fl.Coef^[I]:=LongInt(SwsRDiv(Fone,(Fone+One Div 2) Div One));
  End;
  Exit;
 End;
 If XInc>(1 Shl 16) Then FSz:=1+(4*SrcW+DstW-1) Div DstW Else FSz:=1+4;
 If FSz>SrcW-2 Then FSz:=SrcW-2;
 If FSz<1 Then FSz:=1;
 GetMem(Ft,Int64(DstW)*FSz*8+64); GetMem(F2,Int64(DstW)*FSz*8+64);
 XDst:=((Int64(DstPos)*XInc) Shr 7)-((Int64(SrcPos)*$10000) Shr 7);
 For I:=0 To DstW-1 Do Begin
  Xx:=LongInt((XDst-Int64(FSz-2)*(Int64(1) Shl 16)) Div (Int64(1) Shl 17));
  FPos^[I]:=Xx;
  For J:=0 To FSz-1 Do Begin
   D:=Abs(Int64(Xx)*(Int64(1) Shl 17)-XDst) Shl 13;
   If XInc>(1 Shl 16) Then D:=D*DstW Div SrcW;
   If D>=(Int64(1) Shl 31) Then Coeff:=0
   Else Begin
    Dd:=(D*D) Shr 30; Ddd:=(Dd*D) Shr 30;
    If D<(Int64(1) Shl 30) Then
     Coeff:=(12*(Int64(1) Shl 24)-9*B-6*C)*Ddd+(-18*(Int64(1) Shl 24)+12*B+6*C)*
      Dd+(6*(Int64(1) Shl 24)-2*B)*(Int64(1) Shl 30)
    Else
     Coeff:=(-B-6*C)*Ddd+(6*B+30*C)*Dd+(-12*B-48*C)*D+(8*B+24*C)*(Int64(1) Shl
      30);
    Coeff:=Coeff Div ((Int64(1) Shl 54) Div Fone);
   End;
   Ft^[I*FSz+J]:=Coeff;
   Inc(Xx);
  End;
  XDst:=XDst+2*XInc;
 End;
 For I:=0 To DstW-1 Do For J:=0 To FSz-1 Do F2^[I*FSz+J]:=Ft^[I*FSz+J];
 DFone:=Fone; Lim:=0.002*DFone;
 MinF:=0;
 For I:=DstW-1 DownTo 0 Do Begin
  Mn:=FSz; Cut:=0;
  For J:=0 To FSz-1 Do Begin
   Cut:=Cut+Abs(F2^[I*FSz]);
   DCut:=Cut; If DCut>Lim Then Break;
   If (I<DstW-1) And (FPos^[I]>=FPos^[I+1]) Then Break;
   For K:=1 To FSz-1 Do F2^[I*FSz+K-1]:=F2^[I*FSz+K];
   F2^[I*FSz+FSz-1]:=0;
   Inc(FPos^[I]);
  End;
  Cut:=0;
  For J:=FSz-1 DownTo 1 Do Begin
   Cut:=Cut+Abs(F2^[I*FSz+J]);
   DCut:=Cut; If DCut>Lim Then Break;
   Dec(Mn);
  End;
  If Mn>MinF Then MinF:=Mn;
 End;
 For I:=0 To DstW-1 Do For J:=0 To MinF-1 Do Ft^[I*MinF+J]:=F2^[I*FSz+J];
 For I:=0 To DstW-1 Do Begin
  If FPos^[I]<0 Then Begin
   For J:=1 To MinF-1 Do Begin
    K:=J+FPos^[I]; If K<0 Then K:=0;
    Ft^[I*MinF+K]:=Ft^[I*MinF+K]+Ft^[I*MinF+J]; Ft^[I*MinF+J]:=0;
   End;
   FPos^[I]:=0;
  End;
  If FPos^[I]+MinF>SrcW Then Begin
   Q:=MinF-SrcW; If Q>0 Then Q:=0;
   Shift:=FPos^[I]+Q; Acc:=0;
   For J:=MinF-1 DownTo 0 Do If FPos^[I]+J>=SrcW Then Begin Acc:=Acc+Ft^[I*MinF+
    J]; Ft^[I*MinF+J]:=0; End;
   For J:=MinF-1 DownTo 0 Do
    If J<Shift Then Ft^[I*MinF+J]:=0 Else Ft^[I*MinF+J]:=Ft^[I*MinF+J-Shift];
   FPos^[I]:=FPos^[I]-Shift;
   Ft^[I*MinF+SrcW-1-FPos^[I]]:=Ft^[I*MinF+SrcW-1-FPos^[I]]+Acc;
  End;
 End;
 Fl.FS:=MinF; Fl.Pos:=FPos; GetMem(Fl.Coef,Int64(DstW)*MinF*4+64);
 For I:=0 To DstW-1 Do Begin
  Err:=0; Sum:=0;
  For J:=0 To MinF-1 Do Sum:=Sum+Ft^[I*MinF+J];
  Sum:=(Sum+One Div 2) Div One;
  If Sum=0 Then Sum:=1;
  For J:=0 To MinF-1 Do Begin
   V:=Ft^[I*MinF+J]+Err;
   IntV:=SwsRDiv(V,Sum);
   Fl.Coef^[I*MinF+J]:=LongInt(IntV);
   Err:=V-IntV*Sum;
  End;
 End;
 FreeMem(Ft,Int64(DstW)*FSz*8+64); FreeMem(F2,Int64(DstW)*FSz*8+64);
End;

Procedure SwsFreeF(Var Fl: TSwsF);
Begin
 If Fl.Pos<>Nil Then FreeMem(Fl.Pos,(Int64(Fl.N)+4)*4);
 If Fl.Coef<>Nil Then FreeMem(Fl.Coef,Int64(Fl.N)*Fl.FS*4+64);
 Fl.Pos:=Nil; Fl.Coef:=Nil;
End;

{ nombre de tranches du filtre scale de ffmpeg: fils du graphe (-filter_threads,
 sinon nombre de CPU) + 1 }
Var NVFilterThreads: LongInt;
Function NVSliceJobs: LongInt;
Var T: Text; L: String; N: LongInt;
Begin
 N:=NVFilterThreads;
 If N<0 Then Begin
  N:=0;
  {$I-}Assign(T,'/proc/cpuinfo'); Reset(T);{$I+}
  If IOResult=0 Then Begin
   While Not Eof(T) Do Begin ReadLn(T,L); If Copy(L,1,9)='processor' Then Inc(
    N); End;
   Close(T);
  End;
  If N<1 Then N:=1;
 End;
 If N<=1 Then NVSliceJobs:=1 Else NVSliceJobs:=N+1;
End;

{ yuv410p/411p -> yuv420p (libswscale: chroma filtree horizontalement
 hScale8To15 puis verticalement yuv2planeX_8) }
Procedure NVWriteConv420(P: PEABuffer);
Var CW2,CH2,I,X,Y,J,FS,HS,Bp: LongInt; HF,VF: TSwsF; H15: PSwsI32; Row:
 PEABuffer; Val: Int64; Pl: PEABuffer; SW,SH,DW,Sb,DbS,Jobs,Sl,Sy,Ey,SHs,Sb0:
 LongInt;
Begin
 CW2:=(NVW+1) Div 2; CH2:=(NVH+1) Div 2;
 GetMem(Row,NVW+CW2+64);
 If NVFullRng Then Begin
  For Y:=0 To NVH-1 Do Begin
   For X:=0 To NVW-1 Do Begin
    Val:=(((Int64(P^[Y*NVW+X]) Shl 7)*14071+33561947) Shr 14)+64; Val:=Val Shr
     7;
    If Val>255 Then Val:=255;
    Row^[X]:=Val;
   End;
   WriteBytes(Row^,NVW);
  End;
 End Else
 For Y:=0 To NVH-1 Do WriteBytes(P^[Y*NVW],NVW);
 If ((NVH And 3)=0) And (NVSubX=2) And (NVSubY=2) Then Begin
  { yvu9ToYv12Wrapper: planar2x_c de rgb2rgb_template.c, appele par tranche
   (fils du filtre scale) }
  SW:=NVCW; SH:=NVCH; DW:=2*SW;
  GetMem(Pl,Int64(DW)*2*SH+64);
  Jobs:=NVSliceJobs; Sl:=(NVH+Jobs-1) Div Jobs; If Sl<1 Then Sl:=1; Sl:=(Sl+3)
   And Not 3;
  For I:=0 To 1 Do Begin
   Sb0:=NVW*NVH+I*NVCW*NVCH;
   Sy:=0;
   While Sy<NVH Do Begin
    Ey:=Sy+Sl; If Ey>NVH Then Ey:=NVH;
    Sb:=Sb0+(Sy Shr 2)*SW; SHs:=(Ey-Sy) Shr 2; DbS:=(Sy Shr 1)*DW;
    Pl^[DbS]:=P^[Sb];
    For X:=0 To SW-2 Do Begin
     Pl^[DbS+2*X+1]:=(3*P^[Sb+X]+P^[Sb+X+1]) Shr 2;
     Pl^[DbS+2*X+2]:=(P^[Sb+X]+3*P^[Sb+X+1]) Shr 2;
    End;
    Pl^[DbS+2*SW-1]:=P^[Sb+SW-1];
    Inc(DbS,DW);
    For Y:=1 To SHs-1 Do Begin
     Pl^[DbS]:=(P^[Sb+(Y-1)*SW]*3+P^[Sb+Y*SW]) Shr 2;
     Pl^[DbS+DW]:=(P^[Sb+(Y-1)*SW]+3*P^[Sb+Y*SW]) Shr 2;
     For X:=0 To SW-2 Do Begin
      Pl^[DbS+2*X+1]:=(P^[Sb+(Y-1)*SW+X]*3+P^[Sb+Y*SW+X+1]) Shr 2;
      Pl^[DbS+DW+2*X+2]:=(P^[Sb+(Y-1)*SW+X]+3*P^[Sb+Y*SW+X+1]) Shr 2;
      Pl^[DbS+DW+2*X+1]:=(P^[Sb+(Y-1)*SW+X+1]+3*P^[Sb+Y*SW+X]) Shr 2;
      Pl^[DbS+2*X+2]:=(P^[Sb+(Y-1)*SW+X+1]*3+P^[Sb+Y*SW+X]) Shr 2;
     End;
     Pl^[DbS+2*SW-1]:=(P^[Sb+(Y-1)*SW+SW-1]*3+P^[Sb+Y*SW+SW-1]) Shr 2;
     Pl^[DbS+DW+2*SW-1]:=(P^[Sb+(Y-1)*SW+SW-1]+3*P^[Sb+Y*SW+SW-1]) Shr 2;
     Inc(DbS,2*DW);
    End;
    Pl^[DbS]:=P^[Sb+(SHs-1)*SW];
    For X:=0 To SW-2 Do Begin
     Pl^[DbS+2*X+1]:=(P^[Sb+(SHs-1)*SW+X]*3+P^[Sb+(SHs-1)*SW+X+1]) Shr 2;
     Pl^[DbS+2*X+2]:=(P^[Sb+(SHs-1)*SW+X]+3*P^[Sb+(SHs-1)*SW+X+1]) Shr 2;
    End;
    Pl^[DbS+2*SW-1]:=P^[Sb+(SHs-1)*SW+SW-1];
    Sy:=Ey;
   End;
   For Y:=0 To CH2-1 Do WriteBytes(Pl^[Y*DW],CW2);
  End;
  FreeMem(Pl,Int64(DW)*2*SH+64); FreeMem(Row,NVW+CW2+64);
  Exit;
 End;
 SwsInitF(HF,NVCW,CW2,128,128,16384); HS:=HF.FS;
 SwsInitF(VF,NVCH,CH2,128,128,4096); FS:=VF.FS;
 GetMem(H15,Int64(NVCH)*CW2*4+64);
 For I:=0 To 1 Do Begin
  For Y:=0 To NVCH-1 Do For X:=0 To CW2-1 Do Begin
   Val:=0;
   For J:=0 To HS-1 Do Val:=Val+Int64(P^[NVW*NVH+I*NVCW*NVCH+Y*NVCW+HF.Pos^[X]+
    J])*HF.Coef^[X*HS+J];
   Val:=AVSar(Val,7); If Val>32767 Then Val:=32767;
   If NVFullRng Then Val:=(Val*1799+4081085) Shr 11;
   H15^[Y*CW2+X]:=Val;
  End;
  For Y:=0 To CH2-1 Do Begin
   For X:=0 To CW2-1 Do Begin
    Val:=Int64(64) Shl 12;
    For J:=0 To FS-1 Do Begin
     Bp:=(VF.Pos^[Y]+J)*CW2+X;
     Val:=Val+Int64(H15^[Bp])*VF.Coef^[Y*FS+J];
    End;
    Val:=AVSar(Val,19); If Val<0 Then Val:=0 Else If Val>255 Then Val:=255;
    Row^[X]:=Val;
   End;
   WriteBytes(Row^,CW2);
  End;
 End;
 FreeMem(H15,Int64(NVCH)*CW2*4+64); SwsFreeF(HF); SwsFreeF(VF); FreeMem(Row,NVW+
  CW2+64);
End;

{ ecrit les 3 plans YUV420P d'une image RGB native (formats 1 BGR24, 2 RGB555, 3
 BGRA, 5 RGB565, 6 RGB444, 9 RGB24) }
Procedure NVSwsPlanes(P: PEABuffer);
Const RY=8414; GY=16519; BY=3208; RU=-4865; GU=-9528; BU=14392; RV=14392; GV=-
 12061; BV=-2332;
Var
 CW,CH,X,Y,Rr,I,J,Bp,FS: LongInt; Row: PEABuffer; U15,V15: PSwsI32; Val,Vv:
  Int64;
 R0,G0,B0,R1,G1,B1: Int64; VF: TSwsF;
Function Px16(Rw,Col: LongInt): LongInt;
Begin
 If Col>=NVW Then Begin Px16:=0; If NVPadOn And (NVFmt<>3) Then Px16:=NVPad^[Rw*
  2]+NVPad^[Rw*2+1]*256; End Else Px16:=P^[(Rw*NVW+Col)*2]+P^[(Rw*NVW+Col)*2+1]*
  256; { F6: pixel de bourrage (ligne suivante) }
End;
Procedure Rgb8(Rw,Col: LongInt; Var R,G,B: Int64);
Var At: LongInt;
Begin
 If Col>=NVW Then Begin
  R:=0; G:=0; B:=0;
  If NVPadOn And (NVFmt=3) Then Begin At:=Rw*4; B:=NVPad^[At]; G:=NVPad^[At+1];
   R:=NVPad^[At+2]; End; { G1: colonne de bourrage lue par swscale (txd/dxt) }
  Exit;
 End;
 If NVFmt=1 Then Begin At:=(Rw*NVW+Col)*3; B:=P^[At]; G:=P^[At+1]; R:=P^[At+2];
  End
 Else If NVFmt=9 Then Begin At:=(Rw*NVW+Col)*3; R:=P^[At]; G:=P^[At+1]; B:=P^[
  At+2]; End
 Else Begin At:=(Rw*NVW+Col)*4; B:=P^[At]; G:=P^[At+1]; R:=P^[At+2]; End;
End;
Function Y14(Rw,Col: LongInt): Int64;
Var R,G,B: Int64; V: LongInt;
Begin
 Case NVFmt Of
  1,3,9: Begin Rgb8(Rw,Col,R,G,B); Y14:=(RY*R+GY*G+BY*B+(32 Shl 14)+(1 Shl 8))
   Shr 9; End;
  2: Begin V:=Px16(Rw,Col); Y14:=(Int64(RY)*(V And $7C00)+Int64(GY Shl 5)*(V And
   $3E0)+Int64(BY Shl 10)*(V And $1F)+(Int64(32) Shl 21)+(1 Shl 15)) Shr 16;
   End;
  5: Begin V:=Px16(Rw,Col); Y14:=(Int64(RY)*(V And $F800)+Int64(GY Shl 5)*(V And
   $7E0)+Int64(BY Shl 11)*(V And $1F)+(Int64(32) Shl 22)+(1 Shl 16)) Shr 17;
   End;
  Else Begin V:=Px16(Rw,Col); Y14:=(Int64(RY)*(V And $F00)+Int64(GY Shl 4)*(V
   And $F0)+Int64(BY Shl 8)*(V And $F)+(Int64(32) Shl 18)+(1 Shl 12)) Shr 13;
   End;
 End;
End;
Procedure UV14(Rw,I2: LongInt; Var Ou,Ov: Int64);
Var Va,Vb,R,G,B: Int64; V0,V1: LongInt;
Begin
 Case NVFmt Of
  1,3,9: Begin
   Rgb8(Rw,2*I2,R0,G0,B0); Rgb8(Rw,2*I2+1,R1,G1,B1);
   R:=R0+R1; G:=G0+G1; B:=B0+B1;
   Ou:=(RU*R+GU*G+BU*B+(256 Shl 15)+(1 Shl 9)) Shr 10; Ov:=(RV*R+GV*G+BV*B+(256
    Shl 15)+(1 Shl 9)) Shr 10;
  End;
  2: Begin
   V0:=Px16(Rw,2*I2); V1:=Px16(Rw,2*I2+1);
   R:=(V0 And $7C00)+(V1 And $7C00); G:=(V0 And $3E0)+(V1 And $3E0); B:=(V0 And
    $1F)+(V1 And $1F);
   Ou:=(RU*R+Int64(GU Shl 5)*G+Int64(BU Shl 10)*B+(Int64(256) Shl 22)+(1 Shl
    16)) Shr 17;
   Ov:=(RV*R+Int64(GV Shl 5)*G+Int64(BV Shl 10)*B+(Int64(256) Shl 22)+(1 Shl
    16)) Shr 17;
  End;
  5: Begin
   V0:=Px16(Rw,2*I2); V1:=Px16(Rw,2*I2+1);
   R:=(V0 And $F800)+(V1 And $F800); G:=(V0 And $7E0)+(V1 And $7E0); B:=(V0 And
    $1F)+(V1 And $1F);
   Ou:=(RU*R+Int64(GU Shl 5)*G+Int64(BU Shl 11)*B+(Int64(256) Shl 23)+(1 Shl
    17)) Shr 18;
   Ov:=(RV*R+Int64(GV Shl 5)*G+Int64(BV Shl 11)*B+(Int64(256) Shl 23)+(1 Shl
    17)) Shr 18;
  End;
  Else Begin
   V0:=Px16(Rw,2*I2); V1:=Px16(Rw,2*I2+1);
   R:=(V0 And $F00)+(V1 And $F00); G:=(V0 And $F0)+(V1 And $F0); B:=(V0 And $F)+
    (V1 And $F);
   Ou:=(RU*R+Int64(GU Shl 4)*G+Int64(BU Shl 8)*B+(Int64(256) Shl 19)+(1 Shl 13))
    Shr 14;
   Ov:=(RV*R+Int64(GV Shl 4)*G+Int64(BV Shl 8)*B+(Int64(256) Shl 19)+(1 Shl 13))
    Shr 14;
  End;
 End;
End;
Function Clip8(V: Int64): LongInt;
Begin If V<0 Then Clip8:=0 Else If V>255 Then Clip8:=255 Else Clip8:=V; End;
Begin
 CW:=(NVW+1) Div 2; CH:=(NVH+1) Div 2;
 GetMem(Row,NVW+CW+64);
 If (NVFmt=1) And Not Odd(NVW) Then Begin
  { ff_rgb24toyv12_c : luma tronquee, chroma du pixel haut-gauche des lignes
   paires }
  For Y:=0 To NVH-1 Do Begin
   For X:=0 To NVW-1 Do Begin
    Rgb8(Y,X,R0,G0,B0);
    Row^[X]:=((RY*R0+GY*G0+BY*B0) Shr 15)+16;
   End;
   WriteBytes(Row^,NVW);
  End;
  For I:=0 To 1 Do For Y:=0 To CH-1 Do Begin
   For X:=0 To CW-1 Do Begin
    Rgb8(2*Y,2*X,R0,G0,B0);
    If I=0 Then Vv:=AVSar(RU*R0+GU*G0+BU*B0,15)+128 Else Vv:=AVSar(RV*R0+GV*G0+
     BV*B0,15)+128;
    Row^[X]:=Vv And 255;
   End;
   WriteBytes(Row^,CW);
  End;
  FreeMem(Row,NVW+CW+64); Exit;
 End;
 For Y:=0 To NVH-1 Do Begin
  For X:=0 To NVW-1 Do Begin
   Vv:=Y14(Y,X)*2; If Vv>32767 Then Vv:=32767;
   Row^[X]:=Clip8((Vv+64) Shr 7);
  End;
  WriteBytes(Row^,NVW);
 End;
 { chromas : conversion demi-largeur de chaque ligne, puis filtre vertical
  bicubique }
 GetMem(U15,Int64(NVH)*CW*4+64); GetMem(V15,Int64(NVH)*CW*4+64);
 For Y:=0 To NVH-1 Do For X:=0 To CW-1 Do Begin
  UV14(Y,X,R0,G0);
  Vv:=R0*2; If Vv>32767 Then Vv:=32767; U15^[Y*CW+X]:=Vv;
  Vv:=G0*2; If Vv>32767 Then Vv:=32767; V15^[Y*CW+X]:=Vv;
 End;
 SwsInitF(VF,NVH,CH,128,128,4096);
 FS:=VF.FS;
 For I:=0 To 1 Do Begin
  For Y:=0 To CH-1 Do Begin
   For X:=0 To CW-1 Do Begin
    Val:=Int64(64) Shl 12;
    For J:=0 To FS-1 Do Begin
     Bp:=(VF.Pos^[Y]+J)*CW+X;
     If I=0 Then Val:=Val+Int64(U15^[Bp])*VF.Coef^[Y*FS+J] Else Val:=Val+Int64(
      V15^[Bp])*VF.Coef^[Y*FS+J];
    End;
    Row^[X]:=Clip8(AVSar(Val,19));
   End;
   WriteBytes(Row^,CW);
  End;
 End;
 SwsFreeF(VF);
 FreeMem(U15,Int64(NVH)*CW*4+64); FreeMem(V15,Int64(NVH)*CW*4+64); FreeMem(Row,
  NVW+CW+64);
End;


{ PAL8 -> YUV420P (swscale : palette convertie en YUV 8 bits, chroma reduite par
 filtres bicubiques horizontal puis vertical) }
Procedure NVSwsPal(P: PEABuffer);
Var
 CW,CH,X,Y,I,J,FS,HFS,Bp: LongInt; Row: PEABuffer; PY,PU,PV: Array[0..255] Of
  LongInt;
 Hu,Hv: PSwsI32; HF,VF: TSwsF; Val,Su,Sv: Int64; Ix: LongInt;
Function C8(V: Int64): LongInt;
Begin If V<0 Then C8:=0 Else If V>255 Then C8:=255 Else C8:=V; End;
Begin
 CW:=(NVW+1) Div 2; CH:=(NVH+1) Div 2;
 For I:=0 To 255 Do Begin
  PY[I]:=C8(AVSar(8414*Int64(NVPalR[I])+16519*Int64(NVPalG[I])+3208*Int64(
   NVPalB[I])+(Int64(33) Shl 14),15));
  PU[I]:=C8(AVSar(-4865*Int64(NVPalR[I])-9528*Int64(NVPalG[I])+14392*Int64(
   NVPalB[I])+(Int64(257) Shl 14),15));
  PV[I]:=C8(AVSar(14392*Int64(NVPalR[I])-12061*Int64(NVPalG[I])-2332*Int64(
   NVPalB[I])+(Int64(257) Shl 14),15));
 End;
 GetMem(Row,NVW+CW+64);
 For Y:=0 To NVH-1 Do Begin
  For X:=0 To NVW-1 Do Row^[X]:=PY[P^[Y*NVW+X]];
  WriteBytes(Row^,NVW);
 End;
 GetMem(Hu,Int64(NVH)*CW*4+64); GetMem(Hv,Int64(NVH)*CW*4+64);
 SwsInitF(HF,NVW,CW,128,128,16384); HFS:=HF.FS;
 For Y:=0 To NVH-1 Do For X:=0 To CW-1 Do Begin
  Su:=0; Sv:=0;
  For J:=0 To HFS-1 Do Begin
   Ix:=P^[Y*NVW+HF.Pos^[X]+J];
   Su:=Su+Int64(PU[Ix] Shl 6)*HF.Coef^[X*HFS+J]; Sv:=Sv+Int64(PV[Ix] Shl 6)*
    HF.Coef^[X*HFS+J];
  End;
  Su:=AVSar(Su,13); If Su>32767 Then Su:=32767; Sv:=AVSar(Sv,13); If Sv>32767
   Then Sv:=32767;
  Hu^[Y*CW+X]:=Su; Hv^[Y*CW+X]:=Sv;
 End;
 SwsInitF(VF,NVH,CH,128,128,4096); FS:=VF.FS;
 For I:=0 To 1 Do Begin
  For Y:=0 To CH-1 Do Begin
   For X:=0 To CW-1 Do Begin
    Val:=Int64(64) Shl 12;
    For J:=0 To FS-1 Do Begin
     Bp:=(VF.Pos^[Y]+J)*CW+X;
     If I=0 Then Val:=Val+Int64(Hu^[Bp])*VF.Coef^[Y*FS+J] Else Val:=Val+Int64(
      Hv^[Bp])*VF.Coef^[Y*FS+J];
    End;
    Row^[X]:=C8(AVSar(Val,19));
   End;
   WriteBytes(Row^,CW);
  End;
 End;
 SwsFreeF(VF); SwsFreeF(HF);
 FreeMem(Hu,Int64(NVH)*CW*4+64); FreeMem(Hv,Int64(NVH)*CW*4+64); FreeMem(Row,
  NVW+CW+64);
End;


Procedure NVWriteY4M(P: PEABuffer);
Var
 Hdr,S: String;
 X,Y,K,J,R,G,B,Sum,CW,CH,PX,PY: LongInt;
 Row: Array[0..65535] Of Byte;
Begin
 If (NVFmt=7) Or (NVFmt=8) Then Begin
  NVWriteY4MPlanar(P); Exit;
 End;
 If Not NVOpened Then Begin
  OpenWrite(NVTarget); NVOpened:=True;
  Str(NVW,S); Hdr:='YUV4MPEG2 W'+S; Str(NVH,S); Hdr:=Hdr+' H'+S;
  Str(NVFpsN,S); Hdr:=Hdr+' F'+S; Str(NVFpsD,S); Hdr:=Hdr+':'+S+' Ip A';
  Str(NVSarN,S); Hdr:=Hdr+S; Str(NVSarD,S); Hdr:=Hdr+':'+S+
   ' C420jpeg XYSCSS=420JPEG XCOLORRANGE=LIMITED' +#10;
  If NVIl<>'p' Then Begin K:=Pos('Ip A',Hdr); If K>0 Then Hdr[K+1]:=NVIl; End;

  WriteBytes(Hdr[1],Length(Hdr));
 End;
 Hdr:='FRAME'+#10; WriteBytes(Hdr[1],Length(Hdr));
 If (NVFmt=1) Or (NVFmt=2) Or (NVFmt=3) Or (NVFmt=5) Or (NVFmt=6) Or (NVFmt=9)
  Then Begin NVSwsPlanes(P); Exit; End;
 If NVFmt=0 Then Begin NVSwsPal(P); Exit; End;

 For Y:=0 To NVH-1 Do Begin
  For X:=0 To NVW-1 Do Begin
   NVPixel(P,(Y*NVW+X)*NVBpp(NVFmt),R,G,B);
   If NVFmt= 10 Then Row[X]:=R Else If NVFmt=4
Then Row[X]:=((((R Shl 7
)
*14071+33561947) Shr 14)+64) Shr 7 Else If NVFmt=0
 Then Row[X]:=NVY4(R,G,B) Else If Odd(NVW)
   Or NVYC Then Row[X]:=(8414*R+16519*G+3208*B+540928) Shr 15
           Else Row[X]:=(8414*R+16519*G+3208*B+524288) Shr 15;
  End;
  WriteBytes(Row,NVW);
 End;
 CW:=(NVW+1) Div 2; CH:=(NVH+1) Div 2;
 For K:=0 To 1 Do
 For Y:=0 To CH-1 Do Begin
  For X:=0 To CW-1 Do Begin
   Sum:=0;
   If (NVFmt=1) And Not Odd(NVW) Then Begin
    { ff_rgb24toyv12_c : chroma du seul pixel haut-gauche de chaque bloc 2x2 }
    NVPixel(P,((2*Y)*NVW+2*X)*3,R,G,B);
    If K=0 Then Row[X]:=(ADPCMSar(-4865*R-9528*G+14392*B,15)+128) And 255
    Else Row[X]:=(ADPCMSar(14392*R-12061*G-2332*B,15)+128) And 255;
    Continue;
   End;

   For J:=0 To 3 Do Begin
    PX:=2*X+(J And 1); PY:=2*Y+(J Shr 1);
    If PX>=NVW Then PX:=NVW-1; If PY>=NVH Then PY:=NVH-1;
    NVPixel(P,(PY*NVW+PX)*NVBpp(NVFmt),R,G,B);
    If K=0 Then Inc(Sum,NVU4(R,G,B)) Else Inc(Sum,NVV4(R,G,B));
   End;
   Row[X]:=(Sum+2) Div 4;
  End;
  WriteBytes(Row,CW);
 End;
End;
{ Recoit une image native (haut vers bas, NVW*bpp octets par ligne). }

Procedure NVEmit(P: PEABuffer);
Var
 Rgb: PEABuffer;
 I,R,G,B,Bpp,Size
,RowB
: LongInt;
Begin
 If NVDone Then Exit;
 If (NVMode<>0) And (NVFmt=7) And (NVCW=0) Then NVFmt:=4; { H5: planaire sans
  chroma (Cmono) -> gray, ecrit tel quel en PNG ; palette grise en BMP }

 Size:=NVFrameBytes;
 If NVMode=0 Then Begin
  If NVLast=Nil Then Begin
   GetMem(NVLast,Size); NVLastSize:=Size;
  End;
  If NVHaveLast And (NVGap>=2) Then Begin
   Move(NVPalR,NVSavePalR,256); Move(NVPalG,NVSavePalG,256); Move(NVPalB,
    NVSavePalB,256);
   Move(NVLastPalR,NVPalR,256); Move(NVLastPalG,NVPalG,256); Move(NVLastPalB,
    NVPalB,256);
   For I:=1 To NVGap-1 Do Begin
    NVWriteY4M(NVLast); Inc(NVFrames);
   End;
   Move(NVSavePalR,NVPalR,256); Move(NVSavePalG,NVPalG,256); Move(NVSavePalB,
    NVPalB,256);
  End;
  Move(P^,NVLast^,Size); Move(NVPalR,NVLastPalR,256); Move(NVPalG,NVLastPalG,
   256);
  Move(NVPalB,NVLastPalB,256);
  If NVHaveLast And (NVGap>=1) Then Begin
   NVWriteY4M(P); Inc(NVFrames);
  End;
  If Not NVHaveLast And NVInitDup And (NVGap>=1) Then
  For I:=1 To NVGap Do Begin
   NVWriteY4M(P); Inc(NVFrames);
  End;
  NVHaveLast:=True; NVGap:=0;
  NVWriteY4M(P); Inc(NVFrames);
 End Else If
(NVMode=1) And ((NVFmt=0) Or (NVFmt=4)) Then Begin
  { PAL8 (type 3 + PLTE) et GRAY8 (type 0) sont ecrits tels quels, comme
   l'encodeur png de FFmpeg }
  If NVFmt=0 Then NVWritePNGEx(P,1,3) Else NVWritePNGEx(P,1,0);
  NVDone:=True; Inc(NVFrames);
 End Else If (NVMode=1) And (NVFmt=11) Then Begin
  NVWritePNGEx(P,2,4); NVDone:=True; Inc(NVFrames);
 End Else If (NVMode=1) And (NVFmt=10) Then Begin
  { monob: gris 1 bit, 8 pixels par octet, bit de poids fort en premier }
  RowB:=(NVW+7) Shr 3; GetMem(Rgb,RowB*NVH+16); FillChar(Rgb^,RowB*NVH+16,0);
  For I:=0 To NVW*NVH-1 Do
   If P^[I]>=128 Then Begin
    R:=(I Div NVW)*RowB+((I Mod NVW) Shr 3); Rgb^[R]:=Rgb^[R] Or ($80 Shr ((I
     Mod NVW) And 7));
   End;
  PNGDepth:=1; NVWritePNGEx(Rgb,1,0); PNGDepth:=0;
  FreeMem(Rgb,RowB*NVH+16); NVDone:=True; Inc(NVFrames);
 End Else If (NVMode=1) And (NVFmt=8) And (NVCW=0) Then Begin
  { H5: gris > 8 bits -> gray16be }
  GetMem(Rgb,NVW*NVH*2+16); H5GrayConv(P,Rgb,True);
  PNGDepth:=16; NVWritePNGEx(Rgb,2,0); PNGDepth:=0;
  FreeMem(Rgb,NVW*NVH*2+16); NVDone:=True; Inc(NVFrames);
 End Else If (NVMode=1) And (NVFmt=8) Then Begin
  { H5: YUV > 8 bits -> rgb48be }
  GetMem(Rgb,NVW*NVH*6+16); H5Dst16:=True; H5YuvRgb(P,Rgb,6,Nil); H5Dst16:=
   False;
  PNGDepth:=16; NVWritePNGEx(Rgb,6,2); PNGDepth:=0;
  FreeMem(Rgb,NVW*NVH*6+16); NVDone:=True; Inc(NVFrames);
 End Else If
 NVMode=1 Then Begin
  If NVHasAlpha And (NVFmt=3) Then Bpp:=4 Else Bpp:=3;
  GetMem(Rgb,NVW*NVH*Bpp);
  If NVFmt=7 Then H5YuvRgb(P,Rgb,3,Nil) Else

  For I:=0 To NVW*NVH-1 Do Begin
   NVPixel(P,I*NVBpp(NVFmt),R,G,B); Rgb^[I*Bpp]:=R; Rgb^[I*Bpp+1]:=G; Rgb^[I*
    Bpp+2]:=B;
   If Bpp=4 Then Rgb^[I*4+3]:=P^[I*4+3];
  End;
  NVWritePNG(Rgb,Bpp); FreeMem(Rgb,NVW*NVH*Bpp); NVDone:=True; Inc(NVFrames);
 End Else
 Begin
  If (NVFmt= 8) And ( NVCW= 0 ) Then Begin
    { H5: gris > 8 bits -> gray 8 bits (palette grise) }
   GetMem(Rgb,NVW*NVH+16); H5GrayConv (P, Rgb , False ); NVFmt := 4 ;
NVWriteBMP(
 Rgb ); NVFmt := 8 ;
FreeMem(
 Rgb ,NVW * NVH + 16) ;
   End
Else
  If (NVFmt=7) Or (NVFmt=8) Then Begin
   GetMem(Rgb,NVW*NVH*3);
   H5YuvRgb(P,Rgb,3,Nil)
;
   Bpp:=NVFmt; NVFmt:=9; NVWriteBMP(Rgb); NVFmt:=Bpp;
   FreeMem(Rgb,NVW*NVH*3);
  End Else NVWriteBMP(P);
  NVDone:=True; Inc(NVFrames);
 End;
End;
{ Repete la derniere image (image perdue: duplication CFR de ffmpeg). }

Procedure NVRepeat;Begin
 If (NVMode=0) And (NVHaveLast Or NVInitDup) And Not NVDone Then Inc(NVGap);
End;

Procedure NVBegin(Mode: LongInt; Const Target: String; W,H,Fmt,FpsN,FpsD:
 LongInt);Begin
 NVMode:=Mode; NVTarget:=Target; NVW:=W; NVH:=H; NVFmt:=Fmt; NVFrames:=0;
  NVFpsN:=FpsN;
 NVFpsD:=FpsD;
 NVSarN:=0; NVSarD:=0; NVYC:=False; NVInitDup:=False; NVIl:='p'; NVBT709:=False;
NVFullRng:=False;

 NVOpened:=False; NVDone:=False; NVLast:=Nil; NVHaveLast:=False; NVGap:=0;
 NVHasAlpha:=False;
NVTo420:=False; NVHdrOk:=False; NVPalN:=256; NVPalAOn:=False; NVPadOn:=False;
 NVGamma22:=False; H5Bits:=0;
End;

{ flux sans image decodee: ffmpeg ecrit l'en-tete Y4M seul quand le format est
 connu des parametres du conteneur }
Procedure NVHeaderOnly;
Var Hdr,S: String;
Begin
 OpenWrite(NVTarget); NVOpened:=True;
 Str(NVW,S); Hdr:='YUV4MPEG2 W'+S; Str(NVH,S); Hdr:=Hdr+' H'+S;
 Str(NVFpsN,S); Hdr:=Hdr+' F'+S; Str(NVFpsD,S); Hdr:=Hdr+':'+S+' Ip A';
 Str(NVSarN,S); Hdr:=Hdr+S; Str(NVSarD,S); Hdr:=Hdr+':'+S;
 { aucune image convertie : la plage de couleurs n'est pas encore fixee par le
  filtre de conversion }
 If (NVFmt=7) Or (NVFmt=8) Then Hdr:=Hdr+' '+NVYTag+#10 Else Hdr:=Hdr+
  ' C420jpeg XYSCSS=420JPEG'+#10;
 WriteBytes(Hdr[1],Length(Hdr));

End;

Procedure NVFinish(Const Who: String);Begin
 If NVLast<>Nil Then Begin
  FreeMem(NVLast,NVLastSize); NVLast:=Nil;
 End;
 If
(
 NVFrames=0
) And NVHdrOk And (NVMode=0) Then NVHeaderOnly;
 If NVFrames=0 Then If Not (NVHdrOk And (NVMode=0))
 Then Fail(Who+': aucune image decodee.');
 CloseRead; If NVOpened Then CloseWrite;
End;
{ Cadence "r_frame_rate" de ffmpeg pour une duree d'image T secondes (candidats
 standard de libavformat). }

Procedure NVStdRate(T: Double; Var N,D: LongInt);
Var
 Best,E,X,C: Double;
 J: LongInt;
 CN,CD: LongInt;

Procedure Try(PN,PD: LongInt);Begin
 C:=PN/PD; X:=T*C;
 If Round(X)<1 Then Exit;
 E:=Abs(X-Round(X));
 If E<Best Then Begin
  Best:=E; CN:=PN; CD:=PD;
 End;
End;
Begin
 Best:=1e9; CN:=0; CD:=1;
 For J:=1 To 360 Do Try(J,12);
 For J:=31 To 60 Do Try(J,1);
 Try(80,1); Try(120,1); Try(240,1);
 Try(24000,1001); Try(30000,1001); Try(60000,1001); Try(12000,1001); Try(15000,
  1001);
 Try(48000,1001);
 If (CN=0) Or (Best>0.1) Then Begin
  N:=0; D:=1;
 End Else
 Begin
  N:=CN; D:=CD;
 End;
End;
Procedure NVGcd(Var A,B: LongInt);Forward;

Procedure NVAviSar(W,H: LongInt);
Var
 A,B: LongInt;
Begin
 If (NVVN>0) And (NVVD>0) Then Begin
  A:=NVVN*H; B:=NVVD*W; NVGcd(A,B); NVSarN:=A; NVSarD:=B;
 End;
End;

Procedure NVGcd(Var A,B: LongInt);
Var
 X,Y,T: LongInt;
Begin
 X:=A; Y:=B;
 While Y<>0 Do Begin
  T:=X Mod Y; X:=Y; Y:=T;
 End;
 If X>1 Then Begin
  A:=A Div X; B:=B Div X;
 End;
End;
{ ---- BMP ---- }

Procedure NVRLE(Pic: PEABuffer; Stride,W,H,Depth: LongInt; Src: PEABuffer;
                SrcLen: LongInt);
Var
 SP,Line,Pos,P1,P2,I,K,OutP,OutEnd,Width,Bpp,Odd2,Rc,Extra,Q: LongInt;

Function GB: LongInt;Begin
 If SP<SrcLen Then GB:=Src^[SP] Else GB:=0; Inc(SP);
End;
Begin
 SP:=0;
 If Depth=4 Then Begin
  Line:=H-1; Pos:=0;
  While (Line>=0) And (Pos<=W) Do Begin
   If SP>=SrcLen Then Exit;
   Rc:=GB;
   If Rc=0 Then Begin
    P2:=GB;
    If P2=0 Then Begin
     Dec(Line); Pos:=0;
    End
    Else If P2=1 Then Exit Else
    If P2=2 Then Begin
     Inc(Pos,GB); Dec(Line,GB);
    End
     Else
    Begin
     Odd2:=P2 And 1; Rc:=(P2+1) Div 2; Extra:=Rc And 1;
     If (Pos+2*Rc-Odd2>W) Or (SrcLen-SP<Rc) Then Exit;
     For I:=0 To Rc-1 Do Begin
      If Pos>=W Then Break;
      Q:=GB; Pic^[Line*Stride+Pos]:=Q Shr 4; Inc(Pos);
      If (I+1=Rc) And (Odd2<>0) Then Break;
      If Pos>=W Then Break;
      Pic^[Line*Stride+Pos]:=Q And 15; Inc(Pos);
     End;
     If Extra<>0 Then Inc(SP);
    End;
   End Else
   Begin
    If Pos+Rc>W+1 Then Exit;
    Q:=GB;
    For I:=0 To Rc-1 Do Begin
     If Pos>=W Then Break;
     If (I And 1)=0 Then Pic^[Line*Stride+Pos]:=Q Shr 4 Else Pic^[Line*Stride+
      Pos]:=
     Q And 15;
     Inc(Pos);
    End;
   End;
  End;
  Exit;
 End;
 Bpp:=Depth Shr 3; Width:=Stride Div Bpp; Line:=H-1; Pos:=0;
 OutP:=Line*Stride; OutEnd:=OutP+Stride;
 While SP<SrcLen Do Begin
  P1:=GB;
  If P1=0 Then Begin
   P2:=GB;
   If P2=0 Then Begin
    Dec(Line);
    If Line<0 Then Exit;
    OutP:=Line*Stride; OutEnd:=OutP+Stride; Pos:=0; Continue;
   End Else If P2=1 Then Exit Else
   If P2=2 Then Begin
    P1:=GB; P2:=GB; Dec(Line,P2); Inc(Pos,P1);
    If (Line<0) Or (Pos>=Width) Then Exit;
    OutP:=Line*Stride+Pos*Bpp; OutEnd:=Line*Stride+Stride; Continue;
   End;
   If OutP+P2*Bpp>OutEnd Then Begin
    Inc(SP,2*Bpp); Continue;
   End
   Else If SrcLen-SP<P2*Bpp Then Exit;
   Move(Src^[SP],Pic^[OutP],P2*Bpp); Inc(SP,P2*Bpp); Inc(OutP,P2*Bpp);
   If (Depth=8) And ((P2 And 1)<>0) Then Inc(SP);
   Inc(Pos,P2);
  End Else
  Begin
   If OutP+P1*Bpp>OutEnd Then Continue;
   For K:=0 To P1-1 Do Begin
    For I:=0 To Bpp-1 Do Pic^[OutP+I]:=EAByte(Src,SrcLen,SP+I);
    Inc(OutP,Bpp);
   End;
   Inc(SP,Bpp); Inc(Pos,P1);
  End;
 End;
End;

Procedure DecodeBMP(Const Source,Target: String; Mode: LongInt);
Var
 Size,Fsize,Hsize,Ihsize,Width,Height,Depth,Comp,I,J,N,Dsize,Colors,T,Pal0,
 RowSrc: LongInt;
 Buf,Pic,Tmp: PEABuffer;
 Rgb: Array[0..2] Of LongInt;
 Alpha,V,TopDown: LongInt;
 Fmt: LongInt;
 Stride,BytesPp: LongInt;
 Q: LongInt;
 Pad: LongInt;
 Img: PEABuffer;
 Bottom,HasA: Boolean;

Function R16(At: LongInt): LongInt;Begin
 R16:=EAByte(Buf,Size,At)+EAByte(Buf,Size,At+1)*256;
End;

Function R32(At: LongInt): LongInt;Begin
 R32:=LongInt(EA32(Buf,Size,At,False));
End;

Function R32U(At: LongInt): Int64;Begin
 R32U:=Int64(EAByte(Buf,Size,At))+Int64(EAByte(Buf,Size,At+1))*256+Int64(EAByte(
  Buf,Size,
 At+2))*65536+Int64(EAByte(Buf,Size,At+3))*16777216;
End;
Begin
 OpenRead(Source); Size:=InputSize;
 If (Size<14) Or (Size>400000000) Then Fail(
  'bmp: taille de fichier incorrecte.');
 GetMem(Buf,Size+64); FillChar(Buf^,Size+64,0);
 I:=0;
 While I<Size Do Begin
  If Size-I>60000 Then J:=60000 Else J:=Size-I; ReadAt(I,Buf^[I],J); Inc(I,J);
 End;
 If (Buf^[0]<>66) Or (Buf^[1]<>77) Then Fail('bmp: signature BM requise.');
 Fsize:=R32U(2) And $7FFFFFFF; If Fsize>Size Then Fsize:=Size;
 Hsize:=R32(10); Ihsize:=R32(14);
 If (Ihsize<0) Or (Hsize<0) Or (Int64(Ihsize)+14>Hsize) Then Fail(
 'bmp: taille d''en-tete incorrecte.');
 If (Fsize=14) Or (Fsize=Ihsize+14) Then Fsize:=Size-2;
 If Fsize<=Hsize Then Fail(
  'bmp: taille de fichier declaree inferieure a l''en-tete.');
 Case Ihsize Of
 40,56,64,108,124:
 Begin
  Width:=R32(18); Height:=R32(22); Q:=26;
 End;
 12:
 Begin
  Width:=R16(18); Height:=R16(20); Q:=22;
 End;
  Else
 Begin
  Fail('bmp: taille d''en-tete d''information non supportee.'); Exit;
 End;
End;
If R16(Q)<>1 Then Fail('bmp: en-tete incorrect (plans).');
Depth:=R16(Q+2);
If Ihsize>=40 Then Comp:=R32(Q+4) Else Comp:=0;
If Not (Comp In [0,1,2,3]) Then Fail('bmp: compression non supportee.');
Alpha:=0; Rgb[0]:=0; Rgb[1]:=0; Rgb[2]:=0;
If Comp=3 Then Begin
 Rgb[0]:=R32(Q+4+4+20); Rgb[1]:=R32(Q+4+4+24); Rgb[2]:=R32(Q+4+4+28);
 If Ihsize>40 Then Alpha:=R32(Q+4+4+32);
End;
If (Width<=0) Or (Height=0) Or (Width>16000) Or (Abs(Height)>16000) Then Fail(
'bmp: dimensions incorrectes.');
TopDown:=0; If Height<0 Then Begin
 TopDown:=1; Height:=-Height;
End;
Fmt:=-1; NVHasAlpha:=False;
Case Depth Of
32:
Begin
 If Comp=3 Then Begin
  If (Rgb[0]=LongInt($FF000000)) And (Rgb[1]=$00FF0000) And (Rgb[2]=$0000FF00)
   Then Fmt:=3 Else
  If (Rgb[0]=$00FF0000) And (Rgb[1]=$0000FF00) And (Rgb[2]=$000000FF) Then Fmt:=
   3 Else
  If (Rgb[0]=$0000FF00) And (Rgb[1]=$00FF0000) And (Rgb[2]=LongInt($FF000000))
  Then Fmt:=3 Else
  If (Rgb[0]=$000000FF) And (Rgb[1]=$0000FF00) And (Rgb[2]=$00FF0000) Then Fmt:=
   3
                                                                      Else Fail(
                                                                       'bmp: m'+
                                                                       'asques'+
                                                                       ' de bi'+
                                                                       'ts inc'+
                                                                       'onnus'+
                                                                       '.');
  NVHasAlpha:=Alpha<>0;
 End Else
 Begin
  Fmt:=3; NVHasAlpha:=True;
 End;
End;
24: Fmt:=1;
16:
Begin
 If Comp=0 Then Fmt:=2 Else
 If Comp=3 Then Begin
  If (Rgb[0]=$F800) And (Rgb[1]=$07E0) And (Rgb[2]=$001F) Then Fmt:=5 Else
  If (Rgb[0]=$7C00) And (Rgb[1]=$03E0) And (Rgb[2]=$001F) Then Fmt:=2 Else
  If (Rgb[0]=$0F00) And (Rgb[1]=$00F0) And (Rgb[2]=$000F) Then Fmt:=6
                                                          Else Fail(
                                                           'bmp: masques de bi'+
                                                           'ts inconnus.');
 End;
End;
8: If Hsize-Ihsize-14>0 Then Fmt:=0 Else Fmt:=4;
1,4:
Begin
 If Hsize-Ihsize-14>0 Then Fmt:=0 Else Fail(
 'bmp: palette inconnue pour une image 2/16 couleurs.');
End;
Else Fail('bmp: profondeur non supportee.');
End;
If Fmt<0 Then Fail('bmp: format de pixel non supporte.');
HasA:=NVHasAlpha; NVBegin(Mode,Target,Width,Height,Fmt,25,1); NVHasAlpha:=HasA;
 NVSarN:=0;
NVSarD:=0;
BytesPp:=NVBpp(Fmt); Stride:=((Width*BytesPp+31) Div 32)*32;
Dsize:=Size-Hsize;
N:=((Width*Depth+31) Div 8) And Not 3;
If (Int64(N)*Height>Dsize) And (Comp<>1) And (Comp<>2) Then Begin
 N:=(Width*Depth+7) Div 8;
 If Int64(N)*Height>Dsize Then Fail('bmp: donnees insuffisantes.');
End;
GetMem(Pic,Stride*Height+64); FillChar(Pic^,Stride*Height+64,0);
FillChar(NVPalR,256,0); FillChar(NVPalG,256,0); FillChar(NVPalB,256,0);
If Fmt=0 Then Begin
 Colors:=1 Shl Depth;
 If Ihsize>=36 Then Begin
  T:=R32(46);
  If (T<0) Or (T>(1 Shl Depth)) Then T:=0 Else If T<>0 Then Colors:=T;
 End Else
 Begin
  Colors:=(Hsize-Ihsize-14) Div 3; If Colors>256 Then Colors:=256;
 End;
 Pal0:=14+Ihsize;
 If (Hsize-Ihsize-14)<(Colors*4) Then Begin
  If (Hsize-Ihsize-14)<Colors*3 Then Fail('bmp: palette hors de l''en-tete.');
  For I:=0 To Colors-1 Do Begin
   NVPalB[I]:=Buf^[Pal0+3*I]; NVPalG[I]:=Buf^[Pal0+3*I+1]; NVPalR[I]:=Buf^[Pal0+
    3*I+2];
  End;
 End Else
 For I:=0 To Colors-1 Do Begin
  NVPalB[I]:=Buf^[Pal0+4*I]; NVPalG[I]:=Buf^[Pal0+4*I+1]; NVPalR[I]:=Buf^[Pal0+
   4*I+2];
 End;
 NVPalN:=Colors;

End;
If (Comp=1) Or (Comp=2) Then Begin
 If Depth<>4 Then Begin
  If (Depth<>8) Then Fail('bmp: RLE seulement en 4 ou 8 bits.');
 End;
 NVRLE(Pic,Stride,Width,Height,Depth,PEABuffer(@Buf^[Hsize]),Dsize);
 If TopDown<>0 Then Begin
  GetMem(Tmp,Stride);
  For I:=0 To (Height Div 2)-1 Do Begin
   Move(Pic^[I*Stride],Tmp^,Stride);
   Move(Pic^[(Height-1-I)*Stride],Pic^[I*Stride],Stride);
   Move(Tmp^,Pic^[(Height-1-I)*Stride],Stride);
  End; FreeMem(Tmp,Stride);
 End;
End Else
Begin
 For I:=0 To Height-1 Do Begin
  If TopDown<>0 Then J:=I Else J:=Height-1-I;
  RowSrc:=Hsize+I*N;
  Case Depth Of
  1:
  For Q:=0 To Width-1 Do Pic^[J*Stride+Q]:=(Buf^[RowSrc+(Q Shr 3)] Shr (7-(Q And
   7)))
  And 1;
  4:
  For Q:=0 To Width-1 Do If (Q And 1)=0 Then Pic^[J*Stride+Q]:=Buf^[RowSrc+(Q
   Shr 1)
  ] Shr 4 Else Pic^[J*Stride+Q]:=Buf^[RowSrc+(Q Shr 1)] And 15;
  Else Move(Buf^[RowSrc],Pic^[J*Stride],Width*BytesPp);
 End;
End;
End;
 { compactage des lignes (stride -> largeur*bpp) et permutation des canaux 32
  bits }
GetMem(Img,Width*Height*BytesPp+16);
For I:=0 To Height-1 Do Begin
 Move(Pic^[I*Stride],Img^[I*Width*BytesPp],Width*BytesPp);
 If (Fmt=3) And (Comp=3) Then
 For J:=0 To Width-1 Do Begin
  Q:=(I*Width+J)*4;
  If Rgb[0]=LongInt($FF000000) Then Begin
   T:=Img^[Q]; V:=Img^[Q+1]; Img^[Q]:=V; Img^[Q+1]:=Img^[Q+2]; Img^[Q+2]:=Img^[
    Q+3];
   Img^[Q+3]:=T;
  End Else If Rgb[0]=$0000FF00 Then Begin
   T:=Img^[Q]; V:=Img^[Q+1]; Img^[Q]:=Img^[Q+3]; Img^[Q+3]:=T; Img^[Q+1]:=Img^[
    Q+2];
   Img^[Q+2]:=V;
  End Else If Rgb[0]=$000000FF Then Begin
   T:=Img^[Q]; Img^[Q]:=Img^[Q+2]; Img^[Q+2]:=T;
  End;
 End;
End;
If (Fmt=3) And (Comp=0) Then Begin
  { BGRA sans masques: image sans alpha si tous les alpha sont nuls }
 NVHasAlpha:=False;
 For I:=0 To Width*Height-1 Do If Img^[I*4+3]<>0 Then Begin
  NVHasAlpha:=True; Break;
 End;
End;
NVEmit(Img);
FreeMem(Img,Width*Height*BytesPp+16); FreeMem(Pic,Stride*Height+64); FreeMem(
 Buf,Size+64);
NVFinish('bmp');
End;
{ ---- Bethesda VID ---- }

Type
 TNVFileBuf=Record
  P: PEABuffer;
  Size: LongInt;
 End;

Procedure NVLoad(Const Source: String; Var P: PEABuffer; Var Size: LongInt);
Var
 I,J: LongInt;
Begin
 OpenRead(Source); Size:=InputSize;
 If (Size<16) Or (Size>400000000) Then Fail(
  'fichier incorrect ou trop volumineux.');
 GetMem(P,Size+64); FillChar(P^,Size+64,0);
 I:=0;
 While I<Size Do Begin
  If Size-I>60000 Then J:=60000 Else J:=Size-I; ReadAt(I,P^[I],J); Inc(I,J);
 End;
End;

Function NVRL16(P: PEABuffer; Size,At: LongInt): LongInt;Begin
 NVRL16:=EAByte(P,Size,At)+EAByte(P,Size,At+1)*256;
End;

Function NVRL32(P: PEABuffer; Size,At: LongInt): LongInt;Begin
 NVRL32:=LongInt(EA32(P,Size,At,False));
End;
{ Mode: 0 Y4M, 1 PNG, 2 BMP, 3 audio WAV }

Var
 NVDurs: Array[0..63] Of LongInt;
 NVNDur,NVNVid,NVScanRate: LongInt;

Procedure DecodeBethsoft(Const Source,Target: String; Mode: LongInt);
Var
 F: PEABuffer;
 Size,W,H,Delay,Pos,Bt,Rate,Code,Copied,NPix,Dur,I,J,K,Len,PktN,FirstDur,Dst,
  Remaining,
 Yoff,Cd,L2: LongInt;
 AudioRate: LongInt;
 Pk: PEABuffer;
 Pal: Array[0..767] Of Byte;
 PalPending,Bad,HaveVideo,AudioStarted,FirstFrame,GotPal: Boolean;
 Frame: PEABuffer;
 Pp: Int64;
 Fin: Boolean;
 PkPos: LongInt;
 V: Int64;
 SrcRate,Q2: LongInt;
 Acc: Double;

Function PG: LongInt;Begin
 If PkPos<PktN Then PG:=Pk^[PkPos] Else PG:=0; Inc(PkPos);
End;
Begin
 If Mode<3 Then Begin
  NVNDur:=0; NVNVid:=0; DecodeBethsoft(Source,Target,4);
 End;
 NVLoad(Source,F,Size);
 If (F^[0]<>86) Or (F^[1]<>73) Or (F^[2]<>68) Or (F^[3]<>0) Then Fail(
 'bethsoftvid: signature VID requise.');
 W:=NVRL16(F,Size,7); H:=NVRL16(F,Size,9); Delay:=NVRL16(F,Size,11);
 If (W<1) Or (H<1) Or (W*H>16000000) Then Fail(
  'bethsoftvid: dimensions incorrectes.');
 NPix:=W*H; Pos:=15; Rate:=11111; PalPending:=False; HaveVideo:=False;
 AudioStarted:=False;
 GetMem(Frame,NPix+64); FillChar(Frame^,NPix+64,0); GetMem(Pk,NPix*2+4096);
  FirstDur:=0;
 FillChar(NVPalR,256,0); FillChar(NVPalG,256,0); FillChar(NVPalB,256,0);
 AudioRate:=11111;
 If Mode=3 Then Begin
  EAReset; OpenWrite(Target); ADPCMWaveHeader(11111,1,0);
 End;
 While Pos<Size Do Begin
  Bt:=F^[Pos]; Inc(Pos);
  Case Bt Of
  2:
  Begin
   If Pos+768>Size Then Break;
   Move(F^[Pos],Pal,768); Inc(Pos,768); PalPending:=True;
  End;
  $7C,$7D:
  Begin
   If Bt=$7C Then Begin
    If Pos+3>Size Then Break;
    L2:=F^[Pos+2]; Inc(Pos,3); Rate:=1000000 Div (256-L2);
   End;
   If Pos+2>Size Then Break;
   Len:=NVRL16(F,Size,Pos); Inc(Pos,2);
   If Pos+Len>Size Then Break;
   If Not AudioStarted Then AudioRate:=Rate;
   AudioStarted:=True;
   If Mode=3 Then Begin
    For I:=0 To Len-1 Do EAPut((F^[Pos+I]-128)*256);
   End;
   Inc(Pos,Len);
  End;
  1,3,4:
  Begin
   If Pos+2>Size Then Break;
   Dur:=Delay+NVRL16(F,Size,Pos); Inc(Pos,2);
   PktN:=0; Pk^[PktN]:=Bt; Inc(PktN);
   If Bt=4 Then Begin
    If Pos+2>Size Then Break;
    Pk^[PktN]:=F^[Pos]; Pk^[PktN+1]:=F^[Pos+1]; Inc(PktN,2); Inc(Pos,2);
   End;
   Copied:=0; Bad:=False;
   Repeat
   If Pos>=Size Then Begin
    Bad:=True; Break;
   End;
   Code:=F^[Pos]; Inc(Pos); Pk^[PktN]:=Code; Inc(PktN);
   If Code>=$80 Then Begin
    If Bt=3 Then Begin
     If Pos>=Size Then Begin
      Bad:=True; Break;
     End; Pk^[PktN]:=F^[Pos]; Inc(PktN); Inc(Pos);
    End;
   End Else If Code<>0 Then Begin
    If Pos+Code>Size Then Begin
     Bad:=True; Break;
    End;
    Move(F^[Pos],Pk^[PktN],Code); Inc(PktN,Code); Inc(Pos,Code);
   End;
   Inc(Copied,Code And $7F);
   If Copied=NPix Then Begin
    If (Pos<Size) And (F^[Pos]<>0) Then Else If Pos<Size Then Inc(Pos);
    Break;
   End;
   If Copied>NPix Then Begin
    Bad:=True; Break;
   End;
   Until Code=0;
   If Bad Then Begin
    If HaveVideo Then Break Else Continue;
   End;
   If Mode=4 Then Begin
    HaveVideo:=True;
    If NVNVid=0 Then NVScanRate:=Rate;
    Inc(NVNVid); If NVNDur<64 Then Begin
     NVDurs[NVNDur]:=Dur; Inc(NVNDur);
    End;
    Continue;
   End;
   If Mode=3 Then Continue;
   If Not HaveVideo Then Begin
    HaveVideo:=True; FirstDur:=Dur;
    SrcRate:=Rate;
    If Dur<1 Then Dur:=1;
    NVBegin(Mode,Target,W,H,0,SrcRate,185*Dur); NVInitDup:=True;
    K:=0;
    For I:=0 To NVNDur-1 Do Begin
     If I>=20 Then Break; L2:=NVDurs[I]; J:=K;
     While L2<>0 Do Begin
      Q2:=J Mod L2; J:=L2; L2:=Q2;
     End; K:=J;
    End;
    Acc:=0; L2:=0;
    For I:=0 To NVNDur-1 Do Begin
     Acc:=Acc+185.0*NVDurs[I]/SrcRate; Inc(L2); If Acc>=5.0 Then Break;
    End;
    If L2+1>NVNVid-1 Then L2:=NVNVid-1 Else L2:=L2+1;
    If (L2>15) And (K>1) Then Begin
     NVFpsN:=SrcRate; NVFpsD:=185*K; NVGcd(NVFpsN,NVFpsD);
    End Else
    Begin
     NVStdRate(185.0*Dur/SrcRate,I,J);
     If I>0 Then Begin
      NVFpsN:=I; NVFpsD:=J;
     End;
     NVGcd(NVFpsN,NVFpsD);
    End;
   End;
    { decodeur }
   If PalPending Then Begin
    For I:=0 To 255 Do Begin
     V:=Int64($FF000000) Or ((Int64(Pal[3*I])*65536+Pal[3*I+1]*256+Pal[3*I+2])*
      4);
     V:=V And $FFFFFFFF;
     V:=V Or ((V Shr 6) And $30303);
     NVPalR[I]:=(V Shr 16) And 255; NVPalG[I]:=(V Shr 8) And 255; NVPalB[I]:=V
      And 255;
    End;
    PalPending:=False;
   End;
   PkPos:=1; Dst:=0; Remaining:=W; Fin:=False;
   If Bt=4 Then Begin
    Yoff:=Pk^[1]+Pk^[2]*256; PkPos:=3;
    If Yoff>=H Then Begin
     NVRepeat; Continue;
    End;
    Dst:=Yoff*W;
   End;
   Cd:=PG;
   While Cd<>0 Do Begin
    Len:=Cd And $7F;
    While Len>Remaining Do Begin
     If Cd<$80 Then Begin
      For K:=0 To Remaining-1 Do Begin
       If PkPos<PktN Then Begin
        Frame^[Dst+K]:=Pk^[PkPos]; Inc(PkPos);
       End;
      End;
     End Else If Bt=3 Then Begin
      For K:=0 To Remaining-1 Do Frame^[Dst+K]:=EAByte(Pk,PktN,PkPos);
     End;
     Dec(Len,Remaining); Inc(Dst,Remaining); Remaining:=W;
     If Dst=NPix Then Begin
      Fin:=True; Break;
     End;
    End;
    If Fin Then Break;
    If Cd<$80 Then Begin
     For K:=0 To Len-1 Do Begin
      If PkPos<PktN Then Begin
       Frame^[Dst+K]:=Pk^[PkPos]; Inc(PkPos);
      End;
     End;
    End Else If Bt=3 Then Begin
     L2:=PG;
     For K:=0 To Len-1 Do Frame^[Dst+K]:=L2;
    End;
    Dec(Remaining,Len); Inc(Dst,Len);
    Cd:=PG;
   End;
   NVEmit(Frame);
   If NVDone Then Break;
  End;
  $14: Break;
  Else If HaveVideo Then Break;
 End;
End;
FreeMem(Frame,NPix+64); FreeMem(Pk,NPix*2+4096); FreeMem(F,Size+64);
If Mode=4 Then Begin
 CloseRead; Exit;
End;
If Mode=3 Then Begin
 EAFlush;
 If EAWritten=0 Then Fail('bethsoftvid: aucun bloc audio.');
 ADPCMPatchHeader(AudioRate,1,EAWritten); CloseRead; CloseWrite;
End Else NVFinish('bethsoftvid');
End;
{ ---- Brute Force & Ignorance ---- }

Procedure DecodeBFI(Const Source,Target: String; Mode: LongInt);
Var
 F: PEABuffer;
 Size,W,H,ChunkHeader,NFrames,Fps,Rate,Pos,ChunkSize,AOff,VOff,ASize,VSize,I,J,
  K,Len,
 Offset,Code,Dst,FrameEnd,Frames: LongInt;
 V32: Int64;
 ChunkNo: LongInt;
 Dstb,Pk: PEABuffer;
 Pal: Array[0..767] Of Byte;
 Found: Boolean;
 State: LongWord;
 Bad: Boolean;
 B,Byte2,C1,C2,GP: LongInt;
Const
 LenTab: Array[0..3] Of Integer=(0,2,0,1);

Function G: LongInt;Begin
 If GP<VSize Then G:=Pk^[GP] Else G:=0; Inc(GP);
End;
Begin
 NVLoad(Source,F,Size);
 If (F^[0]<>66) Or (F^[1]<>70) Or (F^[2]<>38) Or (F^[3]<>73) Then Fail(
 'bfi: signature BF&I requise.');
 ChunkHeader:=NVRL32(F,Size,8); NFrames:=NVRL32(F,Size,12); Fps:=NVRL32(F,Size,
  28);
 W:=NVRL32(F,Size,44); H:=NVRL32(F,Size,48);
 If (ChunkHeader<3) Or (NFrames<0) Then Fail('bfi: en-tete incorrect.');
 If (W<1) Or (H<1) Or (W*H>16000000) Then Fail('bfi: dimensions incorrectes.');
 If Size<60+768+4 Then Fail('bfi: fichier tronque.');
 Move(F^[60],Pal,768); Rate:=NVRL32(F,Size,60+768);
 If Rate<=0 Then Fail('bfi: frequence audio incorrecte.');
 If Fps<=0 Then Fail('bfi: cadence incorrecte.');
 For I:=0 To 255 Do Begin
  V32:=Int64($FF000000)+(Int64((Pal[3*I] Shl 2) Or (Pal[3*I] Shr 4)) Shl 16)+(
   Int64((
  Pal[3*I+1] Shl 2) Or (Pal[3*I+1] Shr 4)) Shl 8)+Int64((Pal[3*I+2] Shl 2) Or (
   Pal[3*I+
  2] Shr 4));
  NVPalR[I]:=(V32 Shr 16) And 255; NVPalG[I]:=(V32 Shr 8) And 255; NVPalB[I]:=
   V32 And 255;
 End;
 Pos:=ChunkHeader-3; Frames:=0; ChunkNo:=0;
 GetMem(Dstb,W*H+64); FillChar(Dstb^,W*H+64,0);
 If Mode=3 Then Begin
  EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,1,0);
 End
  Else
 Begin
  NVBegin(Mode,Target,W,H,0,Fps,1); NVInitDup:=True;
 End;
 While (NFrames>0) And (Pos<Size) Do Begin
  State:=0; Found:=False;
  While Pos<Size Do Begin
   State:=((State Shl 8) Or F^[Pos]) And $FFFFFFFF; Inc(Pos);
   If State=$49564153 Then Begin
    Found:=True; Break;
   End;
  End;
  If Not Found Then Break;
  ChunkSize:=NVRL32(F,Size,Pos); AOff:=NVRL32(F,Size,Pos+8); VOff:=NVRL32(F,
   Size,Pos+16);
  Inc(Pos,20);
  If (AOff<0) Or (VOff<AOff) Or (ChunkSize<VOff) Then Begin
   If ChunkNo=0 Then Begin
    Inc(ChunkNo); Continue;
   End Else Break;
  End;
  Inc(ChunkNo);
  ASize:=VOff-AOff; VSize:=ChunkSize-VOff;
  If Pos+ASize>Size Then ASize:=Size-Pos;
  If Mode=3 Then
  For I:=0 To ASize-1 Do EAPut((F^[Pos+I]-128)*256);
  Inc(Pos,ASize);
  If VSize>0 Then Begin
   If Pos+VSize>Size Then VSize:=Size-Pos;
   Pk:=PEABuffer(@F^[Pos]); Inc(Pos,VSize); Dec(NFrames);
   If Mode<>3 Then Begin
    GP:=0; G; G; G; G; Dst:=0; FrameEnd:=W*H; Bad:=False;
    While Dst<>FrameEnd Do Begin
     B:=G; Code:=B Shr 6; Len:=B And 63; Offset:=0;
     If GP>=VSize Then Begin
      Bad:=True; Break;
     End;
     If Len=0 Then Begin
      If Code=1 Then Begin
       Len:=G; Offset:=G; Offset:=Offset+G*256;
      End
       Else
      Begin
       Len:=G; Len:=Len+G*256; If (Code=2) And (Len=0) Then Break;
      End;
     End Else If Code=1 Then Offset:=G;
     If Dst+(Len Shl LenTab[Code])>FrameEnd Then Break;
     Case Code Of
     0:
     Begin
      If Len>=VSize-GP Then Begin
       Bad:=True; Break;
      End;
      Move(Pk^[GP],Dstb^[Dst],Len); Inc(GP,Len); Inc(Dst,Len);
     End;
     1:
     Begin
      K:=Dst-Offset; Len:=Len*4;
      If K>=0 Then
      While Len>0 Do Begin
       Dstb^[Dst]:=Dstb^[K]; Inc(Dst); Inc(K); Dec(Len);
      End;
     End;
     2: Inc(Dst,Len);
     3:
     Begin
      C1:=G; C2:=G;
      While Len>0 Do Begin
       Dstb^[Dst]:=C1; Dstb^[Dst+1]:=C2; Inc(Dst,2); Dec(Len);
      End;
     End;
    End;
   End;
   If Bad Then NVRepeat Else NVEmit(Dstb);
   If NVDone Then Break;
  End;
 End;
End;
FreeMem(Dstb,W*H+64);
If Mode=3 Then Begin
 EAFlush; FreeMem(F,Size+64);
 If EAWritten=0 Then Fail('bfi: aucune donnee audio.');
 ADPCMPatchHeader(Rate,1,EAWritten); CloseRead; CloseWrite;
End Else
Begin
 FreeMem(F,Size+64); NVFinish('bfi');
End;
End;
{ ---- Interplay C93 ---- }

Procedure DecodeC93(Const Source,Target: String; Mode: LongInt);
Const
 Wd=320;
 Ht=192;
Var
 F: PEABuffer;
 Size,I,J,K,CB,CF,Pos,DSize,PSize,N,Frames,Idx,BlkLen: LongInt;
 Recs: Array[0..511] Of Record
  Index: LongInt;
  Len,Fr: LongInt;
 End;
 Offs: Array[0..31] Of LongInt;
 NextAudio,Bad: Boolean;
 Pic: Array[0..1] Of PEABuffer;
 PalOf: Array[0..1] Of Array[0..255] Of LongInt;
 HaveOld: Boolean;
 Cur: LongInt;
 Pk: PEABuffer;
 PkN: LongInt;
 PalStart: Boolean;
 Pr,Pg,Pb: Array[0..1,0..255] Of Byte;
 B,X,Y,Bt,Typ,GP: LongInt;
 Cols,Grps: Array[0..3] Of Byte;
 Old,New2: PEABuffer;

Function G: LongInt;Begin
 If GP<PkN Then G:=Pk^[GP] Else G:=0; Inc(GP);
End;

Function G16: LongInt;
Var
 A: LongInt;
Begin
 A:=G; G16:=A+G*256;
End;

Function G32: Int64;
Var
 A,Bq,C,D: LongInt;
Begin
 A:=G; Bq:=G; C:=G; D:=G; G32:=Int64(A)+Int64(Bq)*256+Int64(C)*65536+Int64(D)*
  16777216;
End;

Function CopyBlk(ToP: PEABuffer; ToOff: LongInt; From: PEABuffer;
                 Offset,Hh: LongInt): Boolean;
Var
 Wd2,FromX,FromY,Overflow,Q,R: LongInt;
Begin
 CopyBlk:=True;
 If From=Nil Then Exit;
 Wd2:=Hh; FromX:=Offset Mod Wd; FromY:=Offset Div Wd; Overflow:=FromX+Wd2-Wd;
 If FromY+Hh>Ht Then Begin
  CopyBlk:=False; Exit;
 End;
 If Overflow>0 Then Begin
  Dec(Wd2,Overflow);
  For Q:=0 To Hh-1 Do
  For R:=0 To Overflow-1 Do ToP^[ToOff+Q*Wd+Wd2+R]:=From^[(FromY+Q)*Wd+R];
 End;
 For Q:=0 To Hh-1 Do
 For R:=0 To Wd2-1 Do ToP^[ToOff+Q*Wd+R]:=From^[(FromY+Q)*Wd+FromX+R];
End;

Procedure DrawN(OutP: PEABuffer; OutOff,Ww,Hh,Bpp: LongInt; UseGrps: Boolean;
 Col: Int64);
Var
 Xx,Yy: LongInt;
Begin
 For Yy:=0 To Hh-1 Do Begin
  If UseGrps Then Cols[0]:=Grps[3*(Yy Shr 1)];
  For Xx:=0 To Ww-1 Do Begin
   If UseGrps Then Cols[1]:=Grps[(Xx Shr 1)+1];
   OutP^[OutOff+Xx+Yy*Wd]:=Cols[Col And ((1 Shl Bpp)-1)];
   Col:=Col Shr Bpp;
  End;
 End;
End;
Begin
 NVLoad(Source,F,Size);
 If Size<2048 Then Fail('c93: fichier trop court.');
 For I:=0 To 511 Do Begin
  Recs[I].Index:=NVRL16(F,Size,I*4); Recs[I].Len:=F^[I*4+2]; Recs[I].Fr:=F^[I*4+
   3];
  If Recs[I].Fr>32 Then Fail('c93: trop d''images dans un bloc.');
 End;
 NVBegin(Mode,Target,Wd,Ht,0,25,2); NVSarN:=5; NVSarD:=6;
 GetMem(Pic[0],Wd*Ht+64); GetMem(Pic[1],Wd*Ht+64); FillChar(Pic[0]^,Wd*Ht+64,0);
 FillChar(Pic[1]^,Wd*Ht+64,0);
 FillChar(Pr,SizeOf(Pr),0); FillChar(Pg,SizeOf(Pg),0); FillChar(Pb,SizeOf(Pb),
  0);
 GetMem(Pk,200000); Cur:=0; HaveOld:=False;
 CB:=0; CF:=0; NextAudio:=False;
 Repeat
 If NextAudio Then Begin
  Inc(CF); NextAudio:=False;
 End;
 If CF>=Recs[CB].Fr Then Begin
  If (CB>=511) Or (Recs[CB+1].Len=0) Then Break;
  Inc(CB); CF:=0;
 End;
 If CF=0 Then Begin
  For I:=0 To 31 Do Offs[I]:=NVRL32(F,Size,Recs[CB].Index*2048+I*4);
 End;
 Pos:=Recs[CB].Index*2048+Offs[CF];
 If (Pos<0) Or (Pos+2>Size) Then Break;
 DSize:=NVRL16(F,Size,Pos); Inc(Pos,2);
 If (DSize>60000) Or (Pos+DSize+2>Size) Then Break;
 Pk^[0]:=0; Move(F^[Pos],Pk^[1],DSize); PkN:=DSize+1; Inc(Pos,DSize);
 PSize:=NVRL16(F,Size,Pos); Inc(Pos,2);
 If PSize<>0 Then Begin
  If PSize<>768 Then Break;
  If Pos+768>Size Then Break;
  Pk^[0]:=Pk^[0] Or 1; Move(F^[Pos],Pk^[PkN],768); Inc(PkN,768);
 End;
 NextAudio:=True;
 If (CB=0) And (CF=0) Then Pk^[0]:=Pk^[0] Or 2;
  { decodage }
 Idx:=Cur; Cur:=Cur Xor 1; New2:=Pic[Idx]; Old:=Pic[Idx Xor 1];
 If Not HaveOld Then Old:=Nil;
 GP:=0; B:=G; Bt:=0; Bad:=False;
 Y:=0;
 While (Y<Ht) And Not Bad Do Begin
  X:=0;
  While (X<Wd) And Not Bad Do Begin
   If Bt=0 Then Bt:=G;
   Typ:=Bt And 15;
   Case Typ Of
   2:
   Begin
    I:=G16; If Not CopyBlk(New2,Y*Wd+X,Old,I,8) Then Bad:=True;
   End;
   6,7:
   Begin
    For J:=0 To 1 Do
    For I:=0 To 1 Do Begin
     K:=G16;
     If Typ=7 Then Begin
      If ((K Div Wd)=Y+J*4) And ((Abs((K Mod Wd)-X-I*4)<4) Or (Abs((K Mod Wd)-X-
       I*4)>Wd-4)
      ) Then Bad:=True Else
      If Not CopyBlk(New2,(Y+J*4)*Wd+X+I*4,New2,K,4) Then Bad:=True;
     End Else If Not CopyBlk(New2,(Y+J*4)*Wd+X+I*4,Old,K,4) Then Bad:=True;
     If Bad Then Break;
    End;
   End;
   8:
   Begin
    Cols[0]:=G; Cols[1]:=G;
    For I:=0 To 7 Do DrawN(New2,Y*Wd+X+I*Wd,8,1,1,False,G);
   End;
   10,11,13:
   Begin
    For J:=0 To 1 Do
    For I:=0 To 1 Do Begin
     If Typ=10 Then Begin
      Cols[0]:=G; Cols[1]:=G; DrawN(New2,(Y+J*4)*Wd+X+I*4,4,4,1,False,G16);
     End Else If Typ=13 Then Begin
      Cols[0]:=G; Cols[1]:=G; Cols[2]:=G; Cols[3]:=G;
      DrawN(New2,(Y+J*4)*Wd+X+I*4,4,4,2,False,G32);
     End Else
     Begin
      Grps[0]:=G; Grps[1]:=G; Grps[2]:=G; Grps[3]:=G;
      DrawN(New2,(Y+J*4)*Wd+X+I*4,4,4,1,True,G16);
     End;
    End;
   End;
   14: ;
   15:
   For J:=0 To 7 Do
   For I:=0 To 7 Do New2^[(Y+J)*Wd+X+I]:=G;
   Else Bad:=True;
  End;
  Bt:=Bt Shr 4;
  Inc(X,8);
 End;
 Inc(Y,8);
End;
If Not Bad Then Begin
 If (B And 1)<>0 Then Begin
  For I:=0 To 255 Do Begin
   Pr[Idx,I]:=G; Pg[Idx,I]:=G; Pb[Idx,I]:=G;
  End;
 End Else If HaveOld Then Begin
  Move(Pr[Idx Xor 1],Pr[Idx],256); Move(Pg[Idx Xor 1],Pg[Idx],256);
  Move(Pb[Idx Xor 1],Pb[Idx],256);
 End;
 Move(Pr[Idx],NVPalR,256); Move(Pg[Idx],NVPalG,256); Move(Pb[Idx],NVPalB,256);
 HaveOld:=True;
 NVEmit(New2);
End Else
Begin
 NVRepeat; HaveOld:=True;
End;
If NVDone Then Break;
Until False;
FreeMem(Pic[0],Wd*Ht+64); FreeMem(Pic[1],Wd*Ht+64); FreeMem(Pk,200000);
FreeMem(F,Size+64);
NVFinish('c93');
End;
{ ---- AVI: CamStudio (CSCD) et Camtasia (TSCC) ---- }

Procedure DecodeScreenAVI(Const Source,Target: String; Mode: LongInt; Camtasia:
 Boolean);
Var
 F: PEABuffer;
 Size,Pos,W,H,Bits,Rate,Scale,I,J,K,Cnt,CSize,Sz,MoviePos,Stride,Bpp,LineLen,
  Fmt,DecSize,
 Q,N,BugDelta,Res,OutLen: LongInt;
 Tag: String[4];
 Vids,HaveFmt,InMovie: Boolean;
 Pic,Dec,Pk: PEABuffer;
 Pal: Array[0..255] Of LongWord;
 Fcc: String[4];
 Ok,PalChanged,Key,HavePic: Boolean;
 RN,RD,Comp,St,ColorsN,FirstEnt,NEnt,Row,Rr,SrcStride: LongInt;
 Img: PEABuffer;

Function T4(At: LongInt): String;
Var
 S4: String[4];
 Z: Integer;
Begin
 S4:='';
 For Z:=0 To 3 Do S4:=S4+Chr(EAByte(F,Size,At+Z)); T4:=S4;
End;
Begin
 NVLoad(Source,F,Size);
 If (T4(0)<>'RIFF') Or (T4(8)<>'AVI ') Then Fail(
  'avi: signature RIFF/AVI requise.');
 NVVN:=0; NVVD:=0;
 Pos:=12; Vids:=False; HaveFmt:=False; InMovie:=False; Cnt:=0; Rate:=25; Scale:=
  1;
 Fcc:=''; Bits:=0; W:=0; H:=0;
 FillChar(Pal,SizeOf(Pal),0);
 While (Pos+8<=Size) And Not InMovie And (Cnt<500) Do Begin
  Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4); Inc(Cnt);
  If Sz<0 Then Break;
  If Tag='LIST' Then Begin
   If T4(Pos+8)='movi' Then Begin
    InMovie:=True; MoviePos:=Pos+12;
   End;
   Inc(Pos,12);
  End Else
  Begin
   If (Tag='strh') And Not HaveFmt Then Begin
    Vids:=T4(Pos+8)='vids';
    If Vids Then Begin
     Scale:=NVRL32(F,Size,Pos+8+20); Rate:=NVRL32(F,Size,Pos+8+24);
    End;
   End Else If (Tag='strf') And Vids And Not HaveFmt Then Begin
    W:=NVRL32(F,Size,Pos+8+4); H:=NVRL32(F,Size,Pos+8+8); Bits:=NVRL16(F,Size,
     Pos+8+14);
    Fcc:=T4(Pos+8+16);
    ColorsN:=NVRL32(F,Size,Pos+8+32);
    If Bits<=8 Then Begin
     N:=(Sz-40) Div 4; If N>(1 Shl Bits) Then N:=1 Shl Bits;
     For I:=0 To N-1 Do Pal[I]:=$FF000000 Or LongWord(NVRL32(F,Size,Pos+8+40+4*
      I)
     And $FFFFFF);
    End;
    HaveFmt:=True;
   End;
   If Tag='vprp' Then Begin
    NVVD:=NVRL16(F,Size,Pos+8+20); NVVN:=NVRL16(F,Size,Pos+8+22);
   End;
   Inc(Pos,8+Sz+(Sz And 1));
  End;
 End;
 If Not InMovie Or Not HaveFmt Then Fail('avi: flux video introuvable.');
 If Camtasia Then Begin
  If Not ((Fcc='tscc') Or (Fcc='TSCC')) Then Fail(
   'camtasia: flux AVI tscc requis.');
 End Else If Fcc<>'CSCD' Then Fail('camstudio: flux AVI CSCD requis.');
 If H<0 Then H:=-H;
 If (W<1) Or (H<1) Or (W>8192) Or (H>8192) Then Fail(
  'avi: dimensions incorrectes.');
 If (Rate<=0) Or (Scale<=0) Then Begin
  Rate:=25; Scale:=1;
 End;
 RN:=Rate; RD:=Scale; NVGcd(RN,RD);
 If Camtasia Then Begin
  Case Bits Of 8: Fmt:=0; 16: Fmt:=2; 24: Fmt:=1; 32: Fmt:=3; Else
  Begin
   Fail('camtasia: profondeur non supportee.'); Exit;
  End;
 End;
End Else
Begin
 Case Bits Of 16: Fmt:=2; 24: Fmt:=1; 32: Fmt:=3; Else
 Begin
  Fail('camstudio: profondeur invalide.'); Exit;
 End;
End;
End;
Bpp:=NVBpp(Fmt); LineLen:=W*Bpp;
NVBegin(Mode,Target,W,H,Fmt,RN,RD); NVAviSar(W,H);
If Fmt=3 Then Begin
 NVHasAlpha:=False; NVYC:=True;
End;
GetMem(Pic,W*H*Bpp+64); FillChar(Pic^,W*H*Bpp+64,0);
If Camtasia Then Begin
 DecSize:=(((W*Bits+7) Shr 3)+3*W+2)*H+2;
End Else
Begin
 Stride:=((LineLen+3) Div 4)*4; DecSize:=H*Stride;
End;
GetMem(Dec,DecSize+256);
For I:=0 To 255 Do Begin
 NVPalR[I]:=(Pal[I] Shr 16) And 255; NVPalG[I]:=(Pal[I] Shr 8) And 255;
 NVPalB[I]:=Pal[I] And 255;
End;
Pos:=MoviePos; HavePic:=False;
While Pos+8<=Size Do Begin
 Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4);
 If Sz<0 Then Break;
 If Tag='LIST' Then Begin
  Inc(Pos,12); Continue;
 End;
 If Pos+8+Sz>Size Then Sz:=Size-Pos-8;
 If (Tag[1]='0') And (Tag[2]='0') And (Tag[3]='p') And (Tag[4]='c') And Camtasia
  And (
 Bits<=8) Then Begin
  FirstEnt:=F^[Pos+8]; NEnt:=F^[Pos+9]; If NEnt=0 Then NEnt:=256;
  For I:=0 To NEnt-1 Do If (FirstEnt+I<256) And (4+4*I+3<Sz) Then Begin
   NVPalR[FirstEnt+I]:=F^[Pos+8+4+4*I]; NVPalG[FirstEnt+I]:=F^[Pos+8+4+4*I+1];
   NVPalB[FirstEnt+I]:=F^[Pos+8+4+4*I+2];
  End;
 End Else If (Tag[1]='0') And (Tag[2]='0') And ((Tag[3]='d') Or (Tag[3]='w'))
  And ((
 Tag[4]='c') Or (Tag[4]='b')) Then Begin
  Pk:=PEABuffer(@F^[Pos+8]); Ok:=False;
  If Camtasia Then Begin
    { TSCC: zlib + RLE MS }
   Res:=NVInflate(Pk,Sz,Dec,DecSize,OutLen);
   If (Res=1) Then Ok:=False Else
   If Res=2 Then Ok:=False
    Else
   Begin
    SrcStride:=((W*Bpp+31) Div 32)*32;
    If Bpp>1 Then Begin
      { RLE en profondeur Bits: tampon avec stride aligne }
     GetMem(Img,SrcStride*H+64);
     For Row:=0 To H-1 Do Move(Pic^[Row*LineLen],Img^[Row*SrcStride],LineLen);
     NVRLE(Img,SrcStride,W,H,Bits,Dec,OutLen);
     For Row:=0 To H-1 Do Move(Img^[Row*SrcStride],Pic^[Row*LineLen],LineLen);
     FreeMem(Img,SrcStride*H+64);
    End Else
    Begin
     GetMem(Img,SrcStride*H+64);
     For Row:=0 To H-1 Do Move(Pic^[Row*LineLen],Img^[Row*SrcStride],LineLen);
     NVRLE(Img,SrcStride,W,H,8,Dec,OutLen);
     For Row:=0 To H-1 Do Move(Img^[Row*SrcStride],Pic^[Row*LineLen],LineLen);
     FreeMem(Img,SrcStride*H+64);
    End;
    Ok:=True;
   End;
  End Else
  Begin
   If Sz>=2 Then Begin
    Comp:=(Pk^[0] Shr 1) And 7; Key:=(Pk^[0] And 1)<>0;
    BugDelta:=((W*Bpp+3) Div 4)*4*H-(W And Not 3)*Bpp*H;
    OutLen:=DecSize;
    If Comp=0 Then Begin
     Res:=NVLzo(PEABuffer(@Pk^[2]),Sz-2,Dec,OutLen);
     Ok:=(Res=0) And ((OutLen=0) Or (OutLen=BugDelta));
    End Else If Comp=1 Then Begin
     Res:=NVInflate(PEABuffer(@Pk^[2]),Sz-2,Dec,DecSize,OutLen);
     Ok:=(Res=0) And ((OutLen=DecSize) Or (OutLen=DecSize-BugDelta));
    End;
    If Ok Then Begin
     For Row:=0 To H-1 Do Begin
      Rr:=H-1-Row;
      If Key Then Move(Dec^[Row*Stride],Pic^[Rr*LineLen],LineLen)
       Else
      For Q:=0 To LineLen-1 Do Pic^[Rr*LineLen+Q]:=(Pic^[Rr*LineLen+Q]+Dec^[Row*
       Stride+Q])
      And 255;
     End;
    End;
   End;
  End;
  If Ok Then Begin
   For I:=0 To 255 Do Begin
   End;
   NVEmit(Pic); HavePic:=True;
  End Else NVRepeat;
  If NVDone Then Break;
 End;
 Inc(Pos,8+Sz+(Sz And 1));
End;
FreeMem(Pic,W*H*Bpp+64); FreeMem(Dec,DecSize+256); FreeMem(F,Size+64);
If Camtasia Then NVFinish('camtasia') Else NVFinish('camstudio');
End;
{ Y4M (4:2:0) vers BMP 24 bits: premiere image; conversion BT.601 approchee
 (swscale non reproduit). }

Procedure EncodeBMPFromY4M(Const Source,Target: String);
Var
 Limit,Cur,At: LongInt;
 H: Array[0..255] Of Byte;
 Line,Token: String;
 W,Hh,K,Code,X,Y,CW,CH,C,D,E,R,G,B,Yv,Uv,Vv: LongInt;
 Yp,Up,Vp,Img: PEABuffer;
 Q: LongInt;

Function Clip(V: LongInt): LongInt;Begin
 If V<0 Then Clip:=0 Else If V>255 Then Clip:=255 Else Clip:=V;
End;
Begin
 OpenRead(Source); Limit:=InputSize; Cur:=0; Line:='';
 While Cur<Limit Do Begin
  ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break;
  If Length(Line)<250 Then Line:=Line+Chr(H[0]);
 End;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('bmp: entree Y4M requise.');
 W:=0; Hh:=0; Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
  'W': Val(Copy(Token,2,20),W,Code);
  'H': Val(Copy(Token,2,20),Hh,Code);
  'C': If (Token<>'C420') And (Token<>'C420jpeg') And (Token<>'C420mpeg2') And (
   Token<>
  'C420paldv') Then Fail('bmp: Y4M YUV420 8 bits requis.');
 End;
End;
If (W<1) Or (Hh<1) Or (W>16000) Or (Hh>16000) Then Fail(
'bmp: dimensions Y4M incorrectes.');
CW:=(W+1) Div 2; CH:=(Hh+1) Div 2;
If Cur+6+W*Hh+2*CW*CH>Limit Then Fail('bmp: aucune image Y4M.');
ReadAt(Cur,H,5); If (H[0]<>70) Or (H[1]<>82) Then Fail(
 'bmp: marqueur FRAME requis.');
Cur:=Cur+5;
While Cur<Limit Do Begin
 ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break;
End;
GetMem(Yp,W*Hh); GetMem(Up,CW*CH); GetMem(Vp,CW*CH); GetMem(Img,W*Hh*4+16);
At:=0;
While At<W*Hh Do Begin
 If W*Hh-At>60000 Then Q:=60000 Else Q:=W*Hh-At; ReadAt(Cur+At,Yp^[At],Q); Inc(
  At,Q);
End;
Inc(Cur,W*Hh);
At:=0;
While At<CW*CH Do Begin
 If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-At; ReadAt(Cur+At,Up^[At],Q);
  Inc(At,Q);
End;
Inc(Cur,CW*CH);
At:=0;
While At<CW*CH Do Begin
 If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-At; ReadAt(Cur+At,Vp^[At],Q);
  Inc(At,Q);
End;
For Y:=0 To Hh-1 Do
For X:=0 To W-1 Do Begin
 Yv:=Yp^[Y*W+X]; Uv:=Up^[(Y Shr 1)*CW+(X Shr 1)]; Vv:=Vp^[(Y Shr 1)*CW+(X Shr
  1)];
 C:=Yv-16; D:=Uv-128; E:=Vv-128;
 R:=Clip((298*C+409*E+128) Shr 8); G:=Clip((298*C-100*D-208*E+128) Shr 8);
 B:=Clip((298*C+516*D+128) Shr 8);
 Q:=(Y*W+X)*4; Img^[Q]:=B; Img^[Q+1]:=G; Img^[Q+2]:=R; Img^[Q+3]:=255;
End;
NVBegin(2,Target,W,Hh,3,25,1); NVHasAlpha:=False;
NVEmit(Img);
FreeMem(Yp,W*Hh); FreeMem(Up,CW*CH); FreeMem(Vp,CW*CH); FreeMem(Img,W*Hh*4+16);
NVFinish('bmp');
End;
{ ---- encodeurs PAM (rgb24) et PBM (monow) depuis un Y4M 4:2:0
 (libavcodec/pnmenc.c ; libswscale yuv2rgb et yuv2mono) ---- }
Procedure EncodePNM(Const Source,Target: String; PMode: LongInt);
Const
 Dith: Array[0..7,0..7] Of Byte=(
  (117,62,158,103,113,58,155,100),(34,199,21,186,31,196,17,182),(144,89,131,76,
   141,86,127,72),(0,165,41,206,10,175,52,217),
  (110,55,151,96,120,65,162,107),(28,193,14,179,38,203,24,189),(138,83,124,69,
   148,93,134,79),(7,172,48,213,3,168,45,210));
Var
 IsPbm: Boolean; GV: Int64; Limit,Cur,At: LongInt; H: Array[0..255] Of Byte;
  Line,Token,Hdr,Ws,Hs: String; W,Hh,K,Code,X,Y,CW,CH,C,D,E,R,G,B,Yv,Uv,Vv,Acc,
  Q,Bit,RowB: LongInt;
 Yp,Up,Vp,Img,Full,Row,Body: PEABuffer; Tabs: PSwsI32; Hdr512: Array[0..511] Of
  Byte; Chn,Pos2,Start,Cnt,Base,I: LongInt;
Function RleCount(S: PEABuffer; At,Len: LongInt; Same: Boolean): LongInt;
Var Pp,C,Lim: LongInt; Neq: Boolean;
Begin
 C:=1; Pp:=At+1; If Len<127 Then Lim:=Len Else Lim:=127;
 While C<Lim Do Begin
  Neq:=S^[Pp-1]<>S^[Pp];
  If Same=Neq Then Begin
   If Not Same Then Begin
    If (C+1<Lim) And (S^[Pp]<>S^[Pp+1]) Then Begin Inc(Pp); Inc(C); Continue;
     End;
    Dec(C);
   End;
   Break;
  End;
  Inc(Pp); Inc(C);
 End;
 RleCount:=C;
End;
Function Clip(V: LongInt): LongInt;Begin If V<0 Then Clip:=0 Else If V>255 Then
 Clip:=255 Else Clip:=V; End;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-((-V+(Int64(1) Shl N)-1) Shr N); End;
Var Tab: Array[0..2047] Of Byte; Crv,Cbu,Cgu,Cgv,Cy,Oy,Yb: Int64; Yoffs,Ix:
 LongInt;
Begin
 { tables de yuv2rgb.c (ff_yuv2rgb_c_init_tables, 24 bits, plage limitee,
  coefficients ITU-601) }
 Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16;
 Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279;
 Crv:=((Crv Shl 16)+$8000) Div Cy; Cbu:=((Cbu Shl 16)+$8000) Div Cy;
 Cgu:=(Int64(-25675)*65536+$8000) Div Cy; Cgv:=(Int64(-53279)*65536+$8000) Div
  Cy;
 Yoffs:=326+512;
 Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For Ix:=0 To 2047 Do Begin Tab[Ix]:=Clip(Sar(Yb+$8000,16)); Yb:=Yb+Cy; End;
 OpenRead(Source); Limit:=InputSize; Cur:=0; Line:='';
 While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break; If
  Length(Line)<250 Then Line:=Line+Chr(H[0]); End;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('pnm: entree Y4M requise.');
 W:=0; Hh:=0; Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),Hh,Code);
   'C': If (Token<>'C420') And (Token<>'C420jpeg') And (Token<>'C420mpeg2') And
    (Token<>'C420paldv') Then Fail('pnm: Y4M YUV420 8 bits requis.');
  End;
 End;
 If (W<1) Or (Hh<1) Or (W>16000) Or (Hh>16000) Then Fail(
  'pnm: dimensions Y4M incorrectes.');
 CW:=(W+1) Div 2; CH:=(Hh+1) Div 2;
 If Cur+6+W*Hh+2*CW*CH>Limit Then Fail('pnm: aucune image Y4M.');
 ReadAt(Cur,H,5); If (H[0]<>70) Or (H[1]<>82) Then Fail(
  'pnm: marqueur FRAME requis.');
 Cur:=Cur+5; While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then
  Break; End;
 GetMem(Yp,W*Hh); GetMem(Up,CW*CH); GetMem(Vp,CW*CH);
 At:=0; While At<W*Hh Do Begin If W*Hh-At>60000 Then Q:=60000 Else Q:=W*Hh-At;
  ReadAt(Cur+At,Yp^[At],Q); Inc(At,Q); End;
 Inc(Cur,W*Hh);
 At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
  At; ReadAt(Cur+At,Up^[At],Q); Inc(At,Q); End;
 Inc(Cur,CW*CH);
 At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
  At; ReadAt(Cur+At,Vp^[At],Q); Inc(At,Q); End;
 CloseRead;
 Str(W,Ws); Str(Hh,Hs);
 IsPbm:=PMode=1;
 OpenWrite(Target);
 If PMode=2 Then Begin
  { pgm : yuv420p -> gray (plage limitee vers plage pleine, swscale
   lumRangeToJpeg) }
  Hdr:='P5'+#10+Ws+' '+Hs+#10+'255'+#10;
  WriteBytes(Hdr[1],Length(Hdr));
  GetMem(Img,W+16);
  For Y:=0 To Hh-1 Do Begin
   For X:=0 To W-1 Do Begin
    GV:=Yp^[Y*W+X] Shl 7; If GV>30189 Then GV:=30189;
    GV:=Sar(GV*19077-39057361,14);
    GV:=Sar(GV+64,7); If GV<0 Then GV:=0; If GV>255 Then GV:=255;
    Img^[X]:=GV;
   End;
   WriteBytes(Img^,W);
  End;
  FreeMem(Img,W+16);
 End Else If PMode=4 Then Begin
  If Odd(W) Or Odd(Hh) Then Fail('pgmyuv: largeur et hauteur paires requises.');
  Str(Hh*3 Div 2,Hs);
  Hdr:='P5'+#10+Ws+' '+Hs+#10+'255'+#10;
  WriteBytes(Hdr[1],Length(Hdr));
  WriteBytes(Yp^,W*Hh);
  For Y:=0 To CH-1 Do Begin
   WriteBytes(Up^[Y*CW],CW); WriteBytes(Vp^[Y*CW],CW);
  End;
 End Else If IsPbm Then Begin
  Hdr:='P4'+#10+Ws+' '+Hs+#10;
  WriteBytes(Hdr[1],Length(Hdr));
  RowB:=(W+7) Div 8;
  GetMem(Img,RowB+16);
  For Y:=0 To Hh-1 Do Begin
   { yuv2mono_X_c : l'accumulateur n'est jamais remis a zero dans la ligne ;
    l'octet partiel final contient les 8 derniers bits }
   Acc:=0; Q:=0; X:=0;
   While Q<W Do Begin
    For Bit:=0 To 1 Do Begin
     If Q+Bit<W Then Yv:=Yp^[Y*W+Q+Bit] Else Yv:=0;
     Acc:=(Acc*2) And $FFFFFF;
     If Yv+Dith[Y And 7,(Q+Bit) And 7]>=234 Then Inc(Acc);
    End;
    If (Q And 7)=6 Then Begin Img^[X]:=(Not Acc) And 255; Inc(X); End;
    Inc(Q,2);
   End;
   If (Q And 6)<>0 Then Begin Img^[X]:=(Not Acc) And 255; Inc(X); End;
   WriteBytes(Img^,RowB);
  End;
  FreeMem(Img,RowB+16);
 End Else Begin
  If PMode=5 Then Hdr:=''
  Else If PMode=3 Then Hdr:='P6'+#10+Ws+' '+Hs+#10+'255'+#10
  Else Hdr:='P7'+#10+'WIDTH '+Ws+#10+'HEIGHT '+Hs+#10+'DEPTH 3'+#10+
   'MAXVAL 255'+#10+'TUPLTYPE RGB'+#10+'ENDHDR'+#10;
  If Hdr<>'' Then WriteBytes(Hdr[1],Length(Hdr));
  GetMem(Img,W*3+16);
  If PMode=5 Then GetMem(Full,W*Hh*3+16);
  For Y:=0 To Hh-1 Do Begin
   For X:=0 To W-1 Do Begin
    Yv:=Yp^[Y*W+X]; Uv:=Up^[(Y Shr 1)*CW+(X Shr 1)]; Vv:=Vp^[(Y Shr 1)*CW+(X Shr
     1)];
    R:=Tab[Yoffs-Sar(Crv,9)+Sar(Vv*Crv,16)+Yv];
    G:=Tab[Yoffs-Sar(Cgu,9)+Sar(Uv*Cgu,16)-Sar(Cgv,9)+Sar(Vv*Cgv,16)+Yv];
    B:=Tab[Yoffs-Sar(Cbu,9)+Sar(Uv*Cbu,16)+Yv];
    Img^[X*3]:=R; Img^[X*3+1]:=G; Img^[X*3+2]:=B;
   End;
   If PMode=5 Then Move(Img^,Full^[Y*W*3],W*3) Else WriteBytes(Img^,W*3);
  End;
  FreeMem(Img,W*3+16);
  If PMode=5 Then Begin
   { sgienc.c : RLE (ff_rle_count_pixels), lignes du bas vers le haut, canal par
    canal }
   If W>65535 Then Fail('sgi: resolution non prise en charge.');
   GetMem(Row,W+16); GetMem(Tabs,Hh*3*8+16); GetMem(Body,Int64(Hh)*3*(2*W+2)+
    16);
   FillChar(Hdr512,SizeOf(Hdr512),0);
   Hdr512[0]:=1; Hdr512[1]:=$DA; Hdr512[2]:=1; Hdr512[3]:=1; Hdr512[5]:=3;
    Hdr512[6]:=W Shr 8; Hdr512[7]:=W And 255;
   Hdr512[8]:=Hh Shr 8; Hdr512[9]:=Hh And 255; Hdr512[11]:=3; Hdr512[19]:=255;
   WriteBytes(Hdr512,512);
   Pos2:=0;
   For Chn:=0 To 2 Do
    For Y:=0 To Hh-1 Do Begin
     For X:=0 To W-1 Do Row^[X]:=Full^[(Hh-1-Y)*W*3+X*3+Chn];
     Start:=Pos2;
     X:=0;
     While X<W Do Begin
      Cnt:=RleCount(Row,X,W-X,True);
      If Cnt>1 Then Begin Body^[Pos2]:=Cnt; Body^[Pos2+1]:=Row^[X]; Inc(Pos2,2);
       End
      Else Begin
       Cnt:=RleCount(Row,X,W-X,False);
       Body^[Pos2]:=Cnt+$80; Inc(Pos2);
       Move(Row^[X],Body^[Pos2],Cnt); Inc(Pos2,Cnt);
      End;
      Inc(X,Cnt);
     End;
     Tabs^[(Chn*Hh+Y)*2]:=Start; Tabs^[(Chn*Hh+Y)*2+1]:=Pos2-Start;
    End;
   Base:=512+Hh*3*8;
   For I:=0 To Hh*3-1 Do Begin
    Q:=Base+Tabs^[I*2]; Hdr512[0]:=Q Shr 24; Hdr512[1]:=Q Shr 16; Hdr512[2]:=Q
     Shr 8; Hdr512[3]:=Q; WriteBytes(Hdr512,4);
   End;
   For I:=0 To Hh*3-1 Do Begin
    Q:=Tabs^[I*2+1]; Hdr512[0]:=Q Shr 24; Hdr512[1]:=Q Shr 16; Hdr512[2]:=Q Shr
     8; Hdr512[3]:=Q; WriteBytes(Hdr512,4);
   End;
   WriteBytes(Body^,Pos2);
   FreeMem(Row,W+16); FreeMem(Tabs,Hh*3*8+16); FreeMem(Body,Int64(Hh)*3*(2*W+2)+
    16); FreeMem(Full,W*Hh*3+16);
  End;
 End;
 CloseWrite;
 FreeMem(Yp,W*Hh); FreeMem(Up,CW*CH); FreeMem(Vp,CW*CH);
End;

{ ---- msrle, msvideo1, mszh (libavcodec/msrle.c, msrledec.c, msvideo1.c,
 lcldec.c) : AVI vers image ---- }
Function MszhDecomp(Src: PEABuffer; SrcLen: LongInt; Dst: PEABuffer; DstSize:
 LongInt): LongInt;
Var SP,DP,Mask,MaskBit,Ofs,Cnt,I: LongInt;
Function SB(At: LongInt): LongInt;Begin If At<SrcLen Then SB:=Src^[At] Else SB:=
 0; End;
Begin
 SP:=0; DP:=0; Mask:=SB(0); SP:=1; MaskBit:=$80;
 While (SP<SrcLen) And (DP<DstSize) Do Begin
  If (Mask And MaskBit)=0 Then Begin
   For I:=0 To 3 Do Dst^[DP+I]:=SB(SP+I);
   Inc(DP,4); Inc(SP,4);
  End Else Begin
   Ofs:=SB(SP)+SB(SP+1)*256; Inc(SP,2);
   Cnt:=(Ofs Shr 11)+1; Ofs:=Ofs And $7FF;
   If Ofs>DP Then Ofs:=DP;
   Cnt:=Cnt*4;
   If Cnt>DstSize-DP Then Cnt:=DstSize-DP;
   If Ofs<>0 Then Begin For I:=0 To Cnt-1 Do Dst^[DP+I]:=Dst^[DP+I-Ofs]; End
   Else FillChar(Dst^[DP],Cnt,0);
   Inc(DP,Cnt);
  End;
  MaskBit:=MaskBit Shr 1;
  If MaskBit=0 Then Begin
   Mask:=SB(SP); Inc(SP);
   While Mask=0 Do Begin
    If (DstSize-DP<32) Or (SrcLen-SP<32) Then Break;
    Move(Src^[SP],Dst^[DP],32); Inc(DP,32); Inc(SP,32);
    Mask:=SB(SP); Inc(SP);
   End;
   MaskBit:=$80;
  End;
 End;
 MszhDecomp:=DP;
End;

{ Kind : 2 msrle, 3 msvideo1, 4 mszh }
Procedure DecodeMsAVI(Const Source,Target: String; Mode,Kind: LongInt);
Var
 F: PEABuffer; Size,Pos,W,H,Bits,Rate,Scale,I,J,K,Cnt,Sz,MoviePos,Fmt,N,RN,RD,
  Bpp,Stride,OutStride,Row,Q: LongInt;
 Tag: String[4]; Vids,HaveFmt,InMovie,Ok,HavePic: Boolean; Pal: Array[0..255] Of
  LongWord; Fcc: String[4];
 ExOff,ExLen,Comp: LongInt; Fr,Outp,Pk,DecB: PEABuffer; Istride: LongInt;
  PalSet: Boolean;
 { mszh }
 ImgType,Compression,Flags,DecompSize,CW,CH,Len,Enc,Ln,Col,Rw,YRow,CRow,Dl,MtIn,
  MtOut,PlaneY,PlaneU,PlaneV: LongInt; Planar: Boolean; Encoded: PEABuffer;
 BlocksW,BlocksH,TotalBlocks,SkipBlocks,BlockY,BlockX,BlockPtr,PixelPtr,SP,PX,
  PY,A,B,Flg,RowDec: LongInt; Colors: Array[0..7] Of LongInt;
Function T4(At: LongInt): String;
Var S4: String[4]; Z: Integer;
Begin S4:=''; For Z:=0 To 3 Do S4:=S4+Chr(EAByte(F,Size,At+Z)); T4:=S4; End;
Function PkB(At: LongInt): LongInt;Begin If (At>=0) And (At<Sz) Then PkB:=Pk^[
 At] Else PkB:=0; End;
{ msvideo1 : blocs 4x4 }
Procedure Mv1Decode;
Var Eight: Boolean; PX,PY,K,BlockY,BlockX: LongInt;
Procedure Put(Ptr,V: LongInt);
Begin
 If Eight Then Fr^[Ptr]:=V Else Begin Fr^[Ptr*2]:=V And 255; Fr^[Ptr*2+1]:=V Shr
  8; End;
End;
Begin
 Eight:=Bits=8;
 SP:=0; SkipBlocks:=0; BlocksW:=W Div 4; BlocksH:=H Div 4; TotalBlocks:=BlocksW*
  BlocksH;
 RowDec:=W+4;
 For BlockY:=BlocksH Downto 1 Do Begin
  BlockPtr:=(BlockY*4-1)*W;
  For BlockX:=BlocksW Downto 1 Do Begin
   If SkipBlocks>0 Then Begin Inc(BlockPtr,4); Dec(SkipBlocks); Dec(
    TotalBlocks); Continue; End;
   PixelPtr:=BlockPtr;
   If SP+2>Sz Then Exit;
   A:=Pk^[SP]; B:=Pk^[SP+1]; Inc(SP,2);
   If (A=0) And (B=0) And (TotalBlocks=0) Then Exit
   Else If (B And $FC)=$84 Then SkipBlocks:=((B-$84) Shl 8)+A-1
   Else If B<$80 Then Begin
    Flg:=(B Shl 8) Or A;
    If Eight Then Begin
     If SP+2>Sz Then Exit;
     Colors[0]:=Pk^[SP]; Colors[1]:=Pk^[SP+1]; Inc(SP,2);
     For PY:=0 To 3 Do Begin
      For PX:=0 To 3 Do Begin Put(PixelPtr,Colors[(Flg And 1) Xor 1]); Inc(
       PixelPtr); Flg:=Flg Shr 1; End;
      Dec(PixelPtr,RowDec);
     End;
    End Else Begin
     If SP+4>Sz Then Exit;
     Colors[0]:=Pk^[SP]+Pk^[SP+1]*256; Colors[1]:=Pk^[SP+2]+Pk^[SP+3]*256; Inc(
      SP,4);
     If (Colors[0] And $8000)<>0 Then Begin
      If SP+12>Sz Then Exit;
      For K:=2 To 7 Do Begin Colors[K]:=Pk^[SP]+Pk^[SP+1]*256; Inc(SP,2); End;
      For PY:=0 To 3 Do Begin
       For PX:=0 To 3 Do Begin Put(PixelPtr,Colors[((PY And 2) Shl 1)+(PX And
        2)+((Flg And 1) Xor 1)]); Inc(PixelPtr); Flg:=Flg Shr 1; End;
       Dec(PixelPtr,RowDec);
      End;
     End Else Begin
      For PY:=0 To 3 Do Begin
       For PX:=0 To 3 Do Begin Put(PixelPtr,Colors[(Flg And 1) Xor 1]); Inc(
        PixelPtr); Flg:=Flg Shr 1; End;
       Dec(PixelPtr,RowDec);
      End;
     End;
    End;
   End Else If Eight And (B>=$90) Then Begin
    Flg:=(B Shl 8) Or A;
    If SP+8>Sz Then Exit;
    For K:=0 To 7 Do Colors[K]:=Pk^[SP+K];
    Inc(SP,8);
    For PY:=0 To 3 Do Begin
     For PX:=0 To 3 Do Begin Put(PixelPtr,Colors[((PY And 2) Shl 1)+(PX And 2)+(
      (Flg And 1) Xor 1)]); Inc(PixelPtr); Flg:=Flg Shr 1; End;
     Dec(PixelPtr,RowDec);
    End;
   End Else Begin
    If Eight Then Colors[0]:=A Else Colors[0]:=(B Shl 8) Or A;
    For PY:=0 To 3 Do Begin
     For PX:=0 To 3 Do Begin Put(PixelPtr,Colors[0]); Inc(PixelPtr); End;
     Dec(PixelPtr,RowDec);
    End;
   End;
   Inc(BlockPtr,4); Dec(TotalBlocks);
  End;
 End;
End;
Procedure PutY(Row2,Col2,V: LongInt);Begin Outp^[Row2*W+Col2]:=V And 255; End;
Procedure PutU(Row2,Col2,V: LongInt);Begin Outp^[PlaneU+Row2*CW+Col2]:=V And
 255; End;
Procedure PutV(Row2,Col2,V: LongInt);Begin Outp^[PlaneV+Row2*CW+Col2]:=V And
 255; End;
Function EB(At: LongInt): LongInt;Begin If (At>=0) And (At<Len) Then EB:=
 Encoded^[At] Else EB:=0; End;
Begin
 NVLoad(Source,F,Size);
 If (T4(0)<>'RIFF') Or (T4(8)<>'AVI ') Then Fail(
  'avi: signature RIFF/AVI requise.');
 NVVN:=0; NVVD:=0;
 Pos:=12; Vids:=False; HaveFmt:=False; InMovie:=False; Cnt:=0; Rate:=25; Scale:=
  1; Fcc:=''; Bits:=0; W:=0; H:=0; ExLen:=0; ExOff:=0; Comp:=0;
 FillChar(Pal,SizeOf(Pal),0);
 While (Pos+8<=Size) And Not InMovie And (Cnt<500) Do Begin
  Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4); Inc(Cnt);
  If Sz<0 Then Break;
  If Tag='LIST' Then Begin
   If T4(Pos+8)='movi' Then Begin InMovie:=True; MoviePos:=Pos+12; End;
   Inc(Pos,12);
  End Else Begin
   If (Tag='strh') And Not HaveFmt Then Begin
    Vids:=T4(Pos+8)='vids';
    If Vids Then Begin Scale:=NVRL32(F,Size,Pos+8+20); Rate:=NVRL32(F,Size,Pos+
     8+24); End;
   End Else If (Tag='strf') And Vids And Not HaveFmt Then Begin
    W:=NVRL32(F,Size,Pos+8+4); H:=NVRL32(F,Size,Pos+8+8); Bits:=NVRL16(F,Size,
     Pos+8+14); Fcc:=T4(Pos+8+16);
    Comp:=NVRL32(F,Size,Pos+8+16);
    ExOff:=Pos+8+40; ExLen:=Sz-40; If ExLen<0 Then ExLen:=0;
    { palette : libavformat/avidec.c prend les dernieres entrees des donnees
     supplementaires }
    If (Bits<=8) And (ExLen>0) Then Begin
     N:=(4 Shl Bits); If N>ExLen Then N:=ExLen;
     Q:=ExOff+ExLen-N;
     If (Q-ExOff>=9) And (T4(ExOff+ExLen-9)='Bott') Then Dec(Q,9);
     For I:=0 To (N Div 4)-1 Do If I<256 Then Pal[I]:=$FF000000 Or LongWord(
      NVRL32(F,Size,Q+4*I) And $FFFFFF);
    End;
    HaveFmt:=True;
   End;
   If Tag='vprp' Then Begin NVVD:=NVRL16(F,Size,Pos+8+20); NVVN:=NVRL16(F,Size,
    Pos+8+22); End;
   Inc(Pos,8+Sz+(Sz And 1));
  End;
 End;
 If Not InMovie Or Not HaveFmt Then Fail('avi: flux video introuvable.');
 If H<0 Then H:=-H;
 If (W<1) Or (H<1) Or (W>8192) Or (H>8192) Then Fail(
  'avi: dimensions incorrectes.');
 If (Rate<=0) Or (Scale<=0) Then Begin Rate:=25; Scale:=1; End;
 RN:=Rate; RD:=Scale; NVGcd(RN,RD);
 Planar:=False; CW:=0; CH:=0; ImgType:=0; Compression:=0; Flags:=0; DecompSize:=
  0;
 If Kind=2 Then Begin
  Case Bits Of 1: Fmt:=10; 4,8: Fmt:=0; 24: Fmt:=1; Else Begin Fail(
   'msrle: profondeur non supportee.'); Exit; End; End;
 End Else If Kind=3 Then Begin
  If (W<4) Or (H<4) Then Fail('msvideo1: dimensions >= 4 requises.');
  If Bits=8 Then Fmt:=0 Else Fmt:=2;
 End Else Begin
  If ExLen<8 Then Fail(
   'mszh: donnees supplementaires (extradata) trop courtes.');
  ImgType:=F^[ExOff+4]; Compression:=ShortInt(F^[ExOff+5]); Flags:=F^[ExOff+6];
  If (Flags And $F8)<>0 Then Begin End;
  Fmt:=1; Planar:=True;
  Case ImgType Of
   0: Begin DecompSize:=W*H*3; NVSubX:=0; NVSubY:=0; CW:=W; CH:=H; NVYTag:=
    'C444'; End;
   1: Begin DecompSize:=(W And Not 3)*H*2; NVSubX:=1; NVSubY:=0; CW:=(W+1) Div
    2; CH:=H; NVYTag:='C422'; End;
   2: Begin DecompSize:=((W*3+3) And Not 3)*H; Planar:=False; End;
   3: Begin DecompSize:=(W And Not 3)*H Div 2*3; NVSubX:=2; NVSubY:=0; CW:=(W+3)
    Div 4; CH:=H; NVYTag:='C411'; End;
   4: Begin DecompSize:=W*H*2; NVSubX:=1; NVSubY:=0; CW:=(W+1) Div 2; CH:=H;
    NVYTag:='C422'; End;
   5: Begin DecompSize:=W*H Div 2*3; NVSubX:=1; NVSubY:=1; CW:=(W+1) Div 2; CH:=
    (H+1) Div 2; NVYTag:='C420jpeg'; End;
   Else Begin Fail('mszh: type d''image non pris en charge.'); Exit; End;
  End;
  If Planar Then Begin
   If ((ImgType=0) Or (ImgType=2) Or (ImgType=4) Or (ImgType=5)) And Odd(W) And
    (ImgType<>0) Then Fail('mszh: dimensions non supportees.');
   If ((ImgType=4) Or (ImgType=5)) And Odd(W) Then Fail(
    'mszh: dimensions non supportees.');
   If (ImgType=5) And Odd(H) Then Fail('mszh: dimensions non supportees.');
   Fmt:=7;
  End;
  If Compression=1 Then DecompSize:=0
  Else If Compression<>0 Then Fail(
   'mszh: methode de compression non prise en charge.');
 End;
 NVBegin(Mode,Target,W,H,Fmt,RN,RD); NVAviSar(W,H);
 If Fmt=7 Then Begin NVCW:=CW; NVCH:=CH; End;
 If Fmt=1 Then NVYC:=False;
 Bpp:=NVBpp(Fmt); If Fmt=7 Then Bpp:=1;
 OutStride:=W*Bpp;
 If Kind=2 Then Begin
  If Bits=1 Then Stride:=0 Else If Bits=24 Then Stride:=((W*3+31) Div 32)*32
   Else Stride:=((W+31) Div 32)*32;
  Istride:=((W*Bits+31) Div 32)*4;
  GetMem(Fr,Stride*H+Istride*2+64); FillChar(Fr^,Stride*H+Istride*2+64,0);
 End Else Begin Stride:=W*Bpp; Fr:=Nil; End;
 If Kind=3 Then Begin GetMem(Fr,W*Bpp*H+64); FillChar(Fr^,W*Bpp*H+64,0); End;
 If Fmt=7 Then Begin
  PlaneU:=W*H; PlaneV:=W*H+CW*CH;
  GetMem(Outp,W*H+2*CW*CH+64); FillChar(Outp^,W*H+2*CW*CH+64,0);
  GetMem(DecB,DecompSize+256);
 End Else Begin
  GetMem(Outp,W*H*Bpp+64); FillChar(Outp^,W*H*Bpp+64,0);
  If Kind=4 Then Begin GetMem(DecB,DecompSize+256); End Else DecB:=Nil;
 End;
 For I:=0 To 255 Do Begin NVPalR[I]:=(Pal[I] Shr 16) And 255; NVPalG[I]:=(Pal[I]
  Shr 8) And 255; NVPalB[I]:=Pal[I] And 255; End;
 Pos:=MoviePos; HavePic:=False;
 While Pos+8<=Size Do Begin
  Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4);
  If Sz<0 Then Break;
  If Tag='LIST' Then Begin Inc(Pos,12); Continue; End;
  If Pos+8+Sz>Size Then Sz:=Size-Pos-8;
  If (Tag[1]='0') And (Tag[2]='0') And (Tag[3]='p') And (Tag[4]='c') And (
   Kind<>4) And (Bits<=8) Then Begin
   K:=F^[Pos+8]; N:=F^[Pos+9]; If N=0 Then N:=256;
   For I:=0 To N-1 Do If (K+I<256) And (4+4*I+3<Sz) Then Begin
    NVPalR[K+I]:=F^[Pos+8+4+4*I]; NVPalG[K+I]:=F^[Pos+8+4+4*I+1]; NVPalB[K+I]:=
     F^[Pos+8+4+4*I+2];
   End;
  End Else If (Tag[1]='0') And (Tag[2]='0') And ((Tag[3]='d') Or (Tag[3]='w'))
   And ((Tag[4]='c') Or (Tag[4]='b')) Then Begin
   Pk:=PEABuffer(@F^[Pos+8]); Ok:=False;
   If Kind=2 Then Begin
    If Sz>=2 Then Begin
     If H*Istride=Sz Then Begin
      { image non compressee, de bas en haut }
      For Row:=0 To H-1 Do Begin
       Q:=(H-1-Row)*Istride;
       If Bits=4 Then Begin
        For J:=0 To W-1 Do Begin
         If Odd(J) Then Fr^[Row*Stride+J]:=Pk^[Q+(J Shr 1)] And 15 Else Fr^[Row*
          Stride+J]:=Pk^[Q+(J Shr 1)] Shr 4;
        End;
       End Else If Bits=1 Then Begin
        For J:=0 To W-1 Do Outp^[Row*W+J]:=((Pk^[Q+(J Shr 3)] Shr (7-(J And 7)))
         And 1)*255;
       End Else Move(Pk^[Q],Fr^[Row*Stride],W*Bpp);
      End;
      Ok:=True;
     End Else If Bits<>1 Then Begin
      Case Bits Of 4: NVRLE(Fr,Stride,W,H,4,Pk,Sz); 8: NVRLE(Fr,Stride,W,H,8,Pk,
       Sz); Else NVRLE(Fr,Stride,W,H,24,Pk,Sz); End;
      Ok:=True;
     End;
     If Ok And (Bits<>1) Then For Row:=0 To H-1 Do Move(Fr^[Row*Stride],Outp^[
      Row*OutStride],OutStride);
    End;
   End Else If Kind=3 Then Begin
    If Sz>=(W Div 4)*(H Div 4) Div 512 Then Begin
     Mv1Decode; Ok:=True;
     Move(Fr^,Outp^,W*H*Bpp);
    End;
   End Else Begin
    { mszh }
    Encoded:=Pk; Len:=Sz;
    If Compression=0 Then Begin
     If ((ImgType=2) And (Len=((W*3+3) And Not 3)*H)) Or ((ImgType=0) And (
      Len=W*H*3)) Then Ok:=True
     Else If (Flags And 1)<>0 Then Begin
      If Len>=8 Then Begin
       MtIn:=NVRL32(F,Size,Pos+8); MtOut:=NVRL32(F,Size,Pos+12);
       If (MtIn>=0) And (Len-8>=MtIn) Then Begin
        If MtOut>DecompSize Then MtOut:=DecompSize;
        Dl:=MszhDecomp(PEABuffer(@Pk^[8]),MtIn,DecB,DecompSize);
        If Dl=MtOut Then Begin
         Dl:=MszhDecomp(PEABuffer(@Pk^[8+MtIn]),Len-8-MtIn,PEABuffer(@DecB^[
          MtOut]),DecompSize-MtOut);
         If Dl=MtOut Then Begin Encoded:=DecB; Len:=DecompSize; Ok:=True; End;
        End;
       End;
      End;
     End Else Begin
      Dl:=MszhDecomp(Pk,Len,DecB,DecompSize);
      If (Dl=DecompSize) Or (Dl=DecompSize-2) Then Begin Encoded:=DecB; Len:=Dl;
       Ok:=True; End;
     End;
    End Else Begin
     Case ImgType Of 0,2: Q:=6; 1,4: Q:=4; Else Q:=3; End;
     N:=W; If (ImgType=1) Or (ImgType=3) Then N:=W And Not 3;
     Ok:=Len>=((N*H*Q) Shr 1);
    End;
    If Ok Then Begin
     Case ImgType Of
      0: Begin
       Enc:=0;
       For Rw:=0 To H-1 Do Begin
        YRow:=H-1-Rw;
        For Col:=0 To W-1 Do Begin PutY(YRow,Col,EB(Enc)); PutU(YRow,Col,EB(Enc+
         1)+128); PutV(YRow,Col,EB(Enc+2)+128); Inc(Enc,3); End;
       End;
      End;
      1: Begin
       Enc:=0;
       For Rw:=0 To H-1 Do Begin
        YRow:=H-1-Rw; Col:=0;
        While Col<W-3 Do Begin
         For K:=0 To 3 Do PutY(YRow,Col+K,EB(Enc+K));
         Inc(Enc,4);
         PutU(YRow,Col Shr 1,EB(Enc)+128); PutU(YRow,(Col Shr 1)+1,EB(Enc+1)+
          128);
         PutV(YRow,Col Shr 1,EB(Enc+2)+128); PutV(YRow,(Col Shr 1)+1,EB(Enc+3)+
          128);
         Inc(Enc,4); Inc(Col,4);
        End;
        If (Col<>0) And (Col<W) Then Begin
         PutU(YRow,Col Shr 1,Outp^[PlaneU+YRow*CW+(Col Shr 1)-1]); PutV(YRow,Col
          Shr 1,Outp^[PlaneV+YRow*CW+(Col Shr 1)-1]);
        End;
       End;
      End;
      2: Begin
       If Len<((W*3+3) And Not 3)*H Then Ln:=3*W Else Ln:=(3*W+3) And Not 3;
       Enc:=0;
       For Rw:=H-1 Downto 0 Do Begin
        For K:=0 To 3*W-1 Do Outp^[Rw*3*W+K]:=EB(Enc+K);
        Inc(Enc,Ln);
       End;
      End;
      3: Begin
       Enc:=0;
       For Rw:=0 To H-1 Do Begin
        YRow:=H-1-Rw; Col:=0;
        While Col<W-3 Do Begin
         For K:=0 To 3 Do PutY(YRow,Col+K,EB(Enc+K));
         Inc(Enc,4);
         PutU(YRow,Col Shr 2,EB(Enc)+128); PutV(YRow,Col Shr 2,EB(Enc+1)+128);
         Inc(Enc,2); Inc(Col,4);
        End;
        If (Col<>0) And (Col<W) Then Begin
         PutU(YRow,Col Shr 2,Outp^[PlaneU+YRow*CW+(Col Shr 2)-1]); PutV(YRow,Col
          Shr 2,Outp^[PlaneV+YRow*CW+(Col Shr 2)-1]);
        End;
       End;
      End;
      4: Begin
       Enc:=0;
       For Rw:=0 To H-1 Do Begin
        YRow:=H-1-Rw; Col:=0;
        While Col<W-1 Do Begin
         PutY(YRow,Col,EB(Enc)); PutY(YRow,Col+1,EB(Enc+1)); Inc(Enc,2);
         PutU(YRow,Col Shr 1,EB(Enc)+128); PutV(YRow,Col Shr 1,EB(Enc+1)+128);
          Inc(Enc,2);
         Inc(Col,2);
        End;
       End;
      End;
      5: Begin
       Enc:=0; YRow:=H-1; CRow:=(H Shr 1)-1; Rw:=0;
       While Rw<H-1 Do Begin
        Col:=0;
        While Col<W-1 Do Begin
         PutY(YRow,Col,EB(Enc)); PutY(YRow,Col+1,EB(Enc+1)); PutY(YRow-1,Col,EB(
          Enc+2)); PutY(YRow-1,Col+1,EB(Enc+3));
         PutU(CRow,Col Shr 1,EB(Enc+4)+128); PutV(CRow,Col Shr 1,EB(Enc+5)+128);
         Inc(Enc,6); Inc(Col,2);
        End;
        Dec(YRow,2); Dec(CRow); Inc(Rw,2);
       End;
      End;
     End;
    End;
   End;
   If Ok Then Begin
    NVEmit(Outp); HavePic:=True;
   End Else NVRepeat;
   If NVDone Then Break;
  End;
  Inc(Pos,8+Sz+(Sz And 1));
 End;
 FreeMem(Outp,W*H*Bpp+64); FreeMem(F,Size+64);
 If Kind=2 Then NVFinish('msrle') Else If Kind=3 Then NVFinish('msvideo1') Else
  NVFinish('mszh');
End;

{ classification AVI : 2 msrle, 3 msvideo1, 4 mszh, 0 autre (poignee strh ou
 compression strf) }
Function MsAviKind(Const Name: String): LongInt;
Var H: Array[0..63] Of Byte; Limit,Pos,Size,Count,K: LongInt; Handler,Compr:
 String[4]; Found: Boolean; Tag: String[4];
Function T4: String;
Var S4: String[4]; J: Integer;
Begin S4:=''; For J:=0 To 3 Do S4:=S4+Chr(H[J]); T4:=S4; End;
Function Cls(Const S: String): LongInt;
Begin
 Cls:=0;
 If (S='mrle') Or (S='WRLE') Or (S=#1#0#0#0) Or (S=#2#0#0#0) Then Cls:=2
 Else If (S='MSVC') Or (S='msvc') Or (S='CRAM') Or (S='cram') Or (S='WHAM') Or (
  S='wham') Then Cls:=3
 Else If S='MSZH' Then Cls:=4;
End;
Begin
 MsAviKind:=0; Handler:=''; Compr:=''; Found:=False;
 OpenRead(Name); Limit:=InputSize;
 If Limit>=12 Then Begin
  ReadAt(0,H,12);
  If (T4='RIFF') And (H[8]=65) And (H[9]=86) And (H[10]=73) And (H[11]=32) Then
   Begin
   Pos:=12; Count:=0;
   While (Limit-Pos>=8) And (Count<200) And Not Found Do Begin
    ReadAt(Pos,H,8); Tag:=T4; Inc(Count);
    Size:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+LongInt(H[7])*
     16777216;
    If H[7]>=128 Then Break;
    If Tag='LIST' Then Begin
     ReadAt(Pos+8,H,4);
     If (H[0]=109) And (H[1]=111) And (H[2]=118) And (H[3]=105) Then Break;
     Inc(Pos,12);
    End Else Begin
     If (Tag='strh') And (Size>=8) And (Limit-Pos>=24) Then Begin
      ReadAt(Pos+8,H,8);
      If (H[0]=118) And (H[1]=105) And (H[2]=100) And (H[3]=115) Then Handler:=
       Chr(H[4])+Chr(H[5])+Chr(H[6])+Chr(H[7]);
     End;
     If (Tag='strf') And (Handler<>'') And (Size>=20) And (Limit-Pos>=28) Then
      Begin
      ReadAt(Pos+8+16,H,4); Compr:=T4; Found:=True;
     End;
     Inc(Pos,8+Size+(Size And 1));
    End;
   End;
  End;
 End;
 CloseRead;
 If Found Then Begin K:=Cls(Compr); If K=0 Then K:=Cls(Handler); MsAviKind:=K;
  End;
End;

{ Kind: 1 bethsoftvid, 2 bfi, 3 c93, 4 bmp, 5 camstudio (AVI CSCD), 6 camtasia
 (AVI tscc); Mode: 0 Y4M, 1 PNG, 2 BMP, 3 audio }

Procedure DecodeNV(Kind: LongInt; Const Source,Target: String; Mode:
 LongInt);Begin
 Case Kind Of
 1: DecodeBethsoft(Source,Target,Mode);
 2: DecodeBFI(Source,Target,Mode);
 3: DecodeC93(Source,Target,Mode);
 4: DecodeBMP(Source,Target,Mode);
 5: DecodeScreenAVI(Source,Target,Mode,False);
 6: DecodeScreenAVI(Source,Target,Mode,True);
End;
End;
{ ---- cljr (Cirrus Logic AccuPak), cyuv (Creative YUV), cinepak: AVI -> image
 ---- }

Type
 TCVBook=Array[0..255,0..11] Of Byte;
 TCVStrip=Record
  V4,V1: TCVBook;
 End;

Var
 CVStrips: Array[0..31] Of TCVStrip;

Function CVClip(V: LongInt): LongInt;Begin
 If V<0 Then CVClip:=0 Else If V>255 Then CVClip:=255 Else CVClip:=V;
End;

Procedure CVCodebook(Var Book: TCVBook; ChunkId,Size: LongInt; Data: PEABuffer;
                     DOff: LongInt);
Var
 EOD,Flag,Mask,N,I,K,KK,R,G,B,U,V,PP: LongInt;
 Flg: Int64;

Function BE32At(At: LongInt): Int64;Begin
 BE32At:=Int64(Data^[At])*16777216+Data^[At+1]*65536+Data^[At+2]*256+Data^[At+
  3];
End;

Var
 Cur: LongInt;
 M2: Int64;
Begin
 Cur:=DOff; EOD:=DOff+Size;
 If (ChunkId And 4)<>0 Then N:=4 Else N:=6;
 Flg:=0; M2:=0;
 For I:=0 To 255 Do Begin
  If ((ChunkId And 1)<>0) Then Begin
   M2:=M2 Shr 1;
   If M2=0 Then Begin
    If Cur+4>EOD Then Break;
    Flg:=BE32At(Cur); Inc(Cur,4); M2:=$80000000;
   End;
  End;
  If ((ChunkId And 1)=0) Or ((Flg And M2)<>0) Then Begin
   If Cur+N>EOD Then Break;
   PP:=0;
   For K:=0 To 3 Do Begin
    R:=Data^[Cur]; Inc(Cur);
    For KK:=0 To 2 Do Begin
     Book[I,PP]:=R; Inc(PP);
    End;
   End;
   If N=6 Then Begin
    U:=ShortInt(Data^[Cur]); V:=ShortInt(Data^[Cur+1]); Inc(Cur,2);
    PP:=0;
    For K:=0 To 3 Do Begin
     R:=Book[I,PP]+V*2; G:=Book[I,PP]-(U Div 2)-V; B:=Book[I,PP+2]+U*2;
     Book[I,PP]:=CVClip(R); Book[I,PP+1]:=CVClip(G); Book[I,PP+2]:=CVClip(B);
     Inc(PP,3);
    End;
   End;
  End;
 End;
End;
{ Retourne 0 si OK, -1 si erreur }

Function CVVectors(Var Strip: TCVStrip; Pic: PEABuffer; Stride,Pal,Hgt: LongInt;
                   X1,Y1,X2,Y2,ChunkId,Size: LongInt; Data: PEABuffer;
                   DOff: LongInt): LongInt;
Var
 EOD,Y,X,Cur,I0,I1,I2,I3,Q: LongInt;
 Flag,Mask: Int64;
 P: LongInt;
 C0,C1,C2,C3: LongInt;
 Bpp: LongInt;

Procedure Cp(Dst,Src: LongInt; Var Book: TCVBook; Idx,Cnt: LongInt);
Var
 Z: LongInt;
Begin
 For Z:=0 To Cnt-1 Do Pic^[Dst+Z]:=Book[Idx,Src+Z];
End;
Begin
 Cur:=DOff; EOD:=DOff+Size; Flag:=0; Mask:=0;
 If Pal<>0 Then Bpp:=1 Else Bpp:=3;
 Y:=Y1;
 While Y<Y2 Do Begin
  I0:=Y*Stride+X1*Bpp; I1:=I0; I2:=I0; I3:=I0;
  If Hgt-Y>1 Then Begin
   I1:=I0+Stride;
   If Hgt-Y>2 Then Begin
    I2:=I1+Stride; If Hgt-Y>3 Then I3:=I2+Stride;
   End;
  End;
  X:=X1;
  While X<X2 Do Begin
   If ((ChunkId And 1)<>0) Then Begin
    Mask:=Mask Shr 1;
    If Mask=0 Then Begin
     If Cur+4>EOD Then Begin
      CVVectors:=-1; Exit;
     End;
     Flag:=Int64(Data^[Cur])*16777216+Data^[Cur+1]*65536+Data^[Cur+2]*256+Data^[
      Cur+3];
     Inc(Cur,4); Mask:=$80000000;
    End;
   End;
   If ((ChunkId And 1)=0) Or ((Flag And Mask)<>0) Then Begin
    If ((ChunkId And 2)=0) Then Begin
     Mask:=Mask Shr 1;
     If Mask=0 Then Begin
      If Cur+4>EOD Then Begin
       CVVectors:=-1; Exit;
      End;
      Flag:=Int64(Data^[Cur])*16777216+Data^[Cur+1]*65536+Data^[Cur+2]*256+
       Data^[Cur+3];
      Inc(Cur,4); Mask:=$80000000;
     End;
    End;
    If ((ChunkId And 2)<>0) Or ((Not Flag And Mask)<>0) Then Begin
     If Cur>=EOD Then Begin
      CVVectors:=-1; Exit;
     End;
     Q:=Data^[Cur]; Inc(Cur);
     If Pal<>0 Then Begin
      Pic^[I3]:=Strip.V1[Q,6]; Pic^[I3+1]:=Strip.V1[Q,6]; Pic^[I2]:=Strip.V1[Q,
       6];
      Pic^[I2+1]:=Strip.V1[Q,6];
      Pic^[I3+2]:=Strip.V1[Q,9]; Pic^[I3+3]:=Strip.V1[Q,9]; Pic^[I2+2]:=
       Strip.V1[Q,9];
      Pic^[I2+3]:=Strip.V1[Q,9];
      Pic^[I1]:=Strip.V1[Q,0]; Pic^[I1+1]:=Strip.V1[Q,0]; Pic^[I0]:=Strip.V1[Q,
       0];
      Pic^[I0+1]:=Strip.V1[Q,0];
      Pic^[I1+2]:=Strip.V1[Q,3]; Pic^[I1+3]:=Strip.V1[Q,3]; Pic^[I0+2]:=
       Strip.V1[Q,3];
      Pic^[I0+3]:=Strip.V1[Q,3];
     End Else
     Begin
      Cp(I3,6,Strip.V1,Q,3); Cp(I3+3,6,Strip.V1,Q,3); Cp(I2,6,Strip.V1,Q,3);
      Cp(I2+3,6,Strip.V1,Q,3);
      Cp(I3+6,9,Strip.V1,Q,3); Cp(I3+9,9,Strip.V1,Q,3); Cp(I2+6,9,Strip.V1,Q,3);
      Cp(I2+9,9,Strip.V1,Q,3);
      Cp(I1,0,Strip.V1,Q,3); Cp(I1+3,0,Strip.V1,Q,3); Cp(I0,0,Strip.V1,Q,3);
      Cp(I0+3,0,Strip.V1,Q,3);
      Cp(I1+6,3,Strip.V1,Q,3); Cp(I1+9,3,Strip.V1,Q,3); Cp(I0+6,3,Strip.V1,Q,3);
      Cp(I0+9,3,Strip.V1,Q,3);
     End;
    End Else If (Flag And Mask)<>0 Then Begin
     If Cur+4>EOD Then Begin
      CVVectors:=-1; Exit;
     End;
     C0:=Data^[Cur]; C1:=Data^[Cur+1]; C2:=Data^[Cur+2]; C3:=Data^[Cur+3]; Inc(
      Cur,4);
     If Pal<>0 Then Begin
      Pic^[I3]:=Strip.V4[C2,6]; Pic^[I3+1]:=Strip.V4[C2,9]; Pic^[I3+2]:=
       Strip.V4[C3,6];
      Pic^[I3+3]:=Strip.V4[C3,9];
      Pic^[I2]:=Strip.V4[C2,0]; Pic^[I2+1]:=Strip.V4[C2,3]; Pic^[I2+2]:=
       Strip.V4[C3,0];
      Pic^[I2+3]:=Strip.V4[C3,3];
      Pic^[I1]:=Strip.V4[C0,6]; Pic^[I1+1]:=Strip.V4[C0,9]; Pic^[I1+2]:=
       Strip.V4[C1,6];
      Pic^[I1+3]:=Strip.V4[C1,9];
      Pic^[I0]:=Strip.V4[C0,0]; Pic^[I0+1]:=Strip.V4[C0,3]; Pic^[I0+2]:=
       Strip.V4[C1,0];
      Pic^[I0+3]:=Strip.V4[C1,3];
     End Else
     Begin
      Cp(I3,6,Strip.V4,C2,6); Cp(I3+6,6,Strip.V4,C3,6);
      Cp(I2,0,Strip.V4,C2,6); Cp(I2+6,0,Strip.V4,C3,6);
      Cp(I1,6,Strip.V4,C0,6); Cp(I1+6,6,Strip.V4,C1,6);
      Cp(I0,0,Strip.V4,C0,6); Cp(I0+6,0,Strip.V4,C1,6);
     End;
    End;
   End;
   If Pal<>0 Then Begin
    Inc(I0,4); Inc(I1,4); Inc(I2,4); Inc(I3,4);
   End
    Else
   Begin
    Inc(I0,12); Inc(I1,12); Inc(I2,12); Inc(I3,12);
   End;
   Inc(X,4);
  End;
  Inc(Y,4);
 End;
 CVVectors:=0;
End;
{ Decode un paquet cinepak dans Pic; retourne False si le paquet est rejete
 (aucune image). }

Function CVDecode(Pk: PEABuffer; Size,W4,H4,Hgt,Pal: LongInt; Pic: PEABuffer;
                  Stride: LongInt; Var SegaSkip: LongInt): Boolean;
Var
 NumStrips,Enc,I,Cur,EOD,StripSize,FrameFlags,Y0,ChunkId,ChunkSize,Res,SX1,SY1,
  SX2,SY2,
 SId,Pos2,SStart,SEnd,R2: LongInt;
 Done: Boolean;

Function RB16(At: LongInt): LongInt;Begin
 RB16:=Pk^[At]*256+Pk^[At+1];
End;

Function RB24(At: LongInt): LongInt;Begin
 RB24:=Pk^[At]*65536+Pk^[At+1]*256+Pk^[At+2];
End;
Begin
 CVDecode:=False;
 If Size<10 Then Exit;
 NumStrips:=RB16(8);
 If NumStrips=0 Then Exit;
 Enc:=RB24(1);
 { predecode check (discard_damaged_percentage = 95 par defaut) }
 If Size<Int64(Enc)*(100-95) Div 100 Then Exit;
 If SegaSkip=-1 Then Begin
  If Enc=0 Then Exit;
  If (Enc<>Size) And ((Size Mod Enc)<>0) Then Begin
   If (Size>=16) And (Pk^[10]=$FE) And (Pk^[11]=0) And (Pk^[12]=0) And (Pk^[
    13]=6) And (
   Pk^[14]=0) And (Pk^[15]=0) Then SegaSkip:=6 Else SegaSkip:=2;
  End Else SegaSkip:=0;
 End;
 If Size<10+SegaSkip+NumStrips*12 Then Exit;
 StripSize:=RB24(10+SegaSkip+1);
 If (StripSize<12) Or (StripSize>Enc) Then Exit;
 CVDecode:=True;
 { cinepak_decode }
 EOD:=Size; FrameFlags:=Pk^[0]; Cur:=10+SegaSkip; Y0:=0;
 If NumStrips>32 Then NumStrips:=32;
 For I:=0 To NumStrips-1 Do Begin
  If Cur+12>EOD Then Exit;
  SId:=Pk^[Cur];
  SY1:=RB16(Cur+4);
  If SY1=0 Then Begin
   SY1:=Y0; SY2:=SY1+RB16(Cur+8);
  End Else SY2:=RB16(Cur+8);
  SX1:=RB16(Cur+6); SX2:=RB16(Cur+10);
  StripSize:=RB24(Cur+1)-12;
  If StripSize<0 Then Exit;
  Inc(Cur,12);
  If Cur+StripSize>EOD Then StripSize:=EOD-Cur;
  If (I>0) And ((FrameFlags And 1)=0) Then Begin
   CVStrips[I].V4:=CVStrips[I-1].V4; CVStrips[I].V1:=CVStrips[I-1].V1;
  End;
  { cinepak_decode_strip }
  If (SX2>W4) Or (SY2>H4) Or (SX1>=SX2) Or (SY1>=SY2) Then Exit;
  Pos2:=Cur; SEnd:=Cur+StripSize; Done:=False; Res:=-1;
  While (Pos2+4<=SEnd) And Not Done Do Begin
   ChunkId:=Pk^[Pos2]; ChunkSize:=RB24(Pos2+1)-4;
   If ChunkSize<0 Then Exit;
   Inc(Pos2,4);
   If Pos2+ChunkSize>SEnd Then ChunkSize:=SEnd-Pos2;
   Case ChunkId Of
   $20,$21,$24,$25: CVCodebook(CVStrips[I].V4,ChunkId,ChunkSize,Pk,Pos2);
   $22,$23,$26,$27: CVCodebook(CVStrips[I].V1,ChunkId,ChunkSize,Pk,Pos2);
   $30,$31,$32:
   Begin
    Res:=CVVectors(CVStrips[I],Pic,Stride,Pal,Hgt,SX1,SY1,SX2,SY2,ChunkId,
     ChunkSize,Pk,
    Pos2); Done:=True;
   End;
  End;
  If Not Done Then Inc(Pos2,ChunkSize);
 End;
 If Res<>0 Then Exit;
 Inc(Cur,StripSize);
 Y0:=SY2;
End;
End;
{ Kind: 7 cljr, 8 cyuv, 9 cinepak. Mode: 0 Y4M, 1 PNG, 2 BMP }

Procedure DecodeAVIVideo(Const Source,Target: String; Mode,Kind: LongInt);
Var
 Raw422: Boolean;
 F: PEABuffer;
 Size,Pos,W,H,Bits,Rate,Scale,I,J,K,Cnt,Sz,MoviePos,N,RN,RD,Pal4,H4,W4,Stride,
  Row,X,Y,Rr,
 CW,Q,SegaSkip: LongInt;
 Tag: String[4];
 Vids,HaveFmt,InMovie,Ok: Boolean;
 Pal: Array[0..255] Of LongWord;
 Fcc: String[4];
 Pk,Pic,Out2,PY,PU,PV: PEABuffer;
 OutSz: LongInt;
 Cb,V: LongInt;
 Luma: LongInt;
 Fmt: LongInt;
 CurFmt: LongInt;
 PalPending: Boolean;

Function T4(At: LongInt): String;
Var
 S4: String[4];
 Z: Integer;
Begin
 S4:='';
 For Z:=0 To 3 Do S4:=S4+Chr(EAByte(F,Size,At+Z)); T4:=S4;
End;

Function G5(Var BitPos: LongInt; Nb: LongInt; Base: PEABuffer; Len: LongInt):
 LongInt;
Var
 Z,Vv: LongInt;
Begin
 Vv:=0;
 For Z:=1 To Nb Do Begin
  Vv:=Vv*2+((EAByte(Base,Len,BitPos Shr 3) Shr (7-(BitPos And 7))) And 1); Inc(
   BitPos);
 End;
 G5:=Vv;
End;

Var
 BP: LongInt;
Begin
 NVLoad(Source,F,Size);
 If (T4(0)<>'RIFF') Or (T4(8)<>'AVI ') Then Fail(
  'avi: signature RIFF/AVI requise.');
 NVVN:=0; NVVD:=0;
 Pos:=12; Vids:=False; HaveFmt:=False; InMovie:=False; Cnt:=0; Rate:=25; Scale:=
  1;
 Fcc:=''; Bits:=0; W:=0; H:=0;
 FillChar(Pal,SizeOf(Pal),0); MoviePos:=0;
 While (Pos+8<=Size) And Not InMovie And (Cnt<500) Do Begin
  Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4); Inc(Cnt);
  If Sz<0 Then Break;
  If Tag='LIST' Then Begin
   If T4(Pos+8)='movi' Then Begin
    InMovie:=True; MoviePos:=Pos+12;
   End;
   Inc(Pos,12);
  End Else
  Begin
   If (Tag='strh') And Not HaveFmt Then Begin
    Vids:=T4(Pos+8)='vids';
    If Vids Then Begin
     Scale:=NVRL32(F,Size,Pos+8+20); Rate:=NVRL32(F,Size,Pos+8+24);
    End;
   End Else If (Tag='strf') And Vids And Not HaveFmt Then Begin
    W:=NVRL32(F,Size,Pos+8+4); H:=NVRL32(F,Size,Pos+8+8); Bits:=NVRL16(F,Size,
     Pos+8+14);
    Fcc:=T4(Pos+8+16);
    If Bits<=8 Then Begin
     N:=(Sz-40) Div 4; If N>(1 Shl Bits) Then N:=1 Shl Bits;
     For I:=0 To N-1 Do Pal[I]:=$FF000000 Or LongWord(NVRL32(F,Size,Pos+8+40+4*
      I)
     And $FFFFFF);
    End;
    HaveFmt:=True;
   End;
   If Tag='vprp' Then Begin
    NVVD:=NVRL16(F,Size,Pos+8+20); NVVN:=NVRL16(F,Size,Pos+8+22);
   End;
   Inc(Pos,8+Sz+(Sz And 1));
  End;
 End;
 If Not InMovie Or Not HaveFmt Then Fail('avi: flux video introuvable.');
 Case Kind Of
 7: If (Fcc<>'CLJR') And (Fcc<>'cljr') Then Fail('cljr: flux AVI CLJR requis.');
 8: If (Fcc<>'cyuv') And (Fcc<>'CYUV') Then Fail('cyuv: flux AVI cyuv requis.');
 9: If (Fcc<>'cvid') And (Fcc<>'CVID') Then Fail(
  'cinepak: flux AVI cvid requis.');
End;
If H<0 Then H:=-H;
If (W<1) Or (H<1) Or (W>8192) Or (H>8192) Then Fail(
 'avi: dimensions incorrectes.');
If (Rate<=0) Or (Scale<=0) Then Begin
 Rate:=25; Scale:=1;
End;
RN:=Rate; RD:=Scale; NVGcd(RN,RD);
If (Kind=8) And ((W And 3)<>0) Then Fail(
 'cyuv: largeur multiple de 4 requise.');
W4:=(W+3) And Not 3; H4:=(H+3) And Not 3;
Pal4:=0;
Case Kind Of
7:
Begin
 Fmt:=7; NVSubX:=2; NVSubY:=0; NVCW:=(W+3) Div 4; NVCH:=H; NVYTag:='C411';
End;
8:
Begin
 Fmt:=7; NVSubX:=2; NVSubY:=0; NVCW:=W Div 4; NVCH:=H; NVYTag:='C411';
End;
9:
Begin
 If Bits=8 Then Begin
  Fmt:=0; Pal4:=1;
 End Else Fmt:=9;
End;
End;
NVBegin(Mode,Target,W,H,Fmt,RN,RD); NVAviSar(W,H); If Fmt=9 Then NVYC:=True;
If Kind<>9 Then Begin
 NVSubX:=2; NVSubY:=0; If Kind=7 Then NVCW:=(W+3) Div 4 Else NVCW:=W Div 4;
  NVCH:=H;
 NVYTag:='C411';
 If Kind=8 Then Begin
   { detection du mode UYVY brut d'apres le premier paquet video }
  J:=MoviePos; Raw422:=False;
  While J+8<=Size Do Begin
   N:=NVRL32(F,Size,J+4);
   If (N<0) Or (T4(J)='LIST') Then Begin
    If T4(J)='LIST' Then Begin
     Inc(J,12); Continue;
    End; Break;
   End;
   If (F^[J]=48) And (F^[J+1]=48) And ((F^[J+2]=100) Or (F^[J+2]=119)) Then
    Begin
    If N=H*((W+1) And Not 1)*2 Then Raw422:=True;
    Break;
   End;
   Inc(J,8+N+(N And 1));
  End;
  If Raw422 Then Begin
   NVSubX:=1; NVCW:=(W+1) Div 2; NVYTag:='C422';
  End;
 End;
End;
For I:=0 To 255 Do Begin
 NVPalR[I]:=(Pal[I] Shr 16) And 255; NVPalG[I]:=(Pal[I] Shr 8) And 255;
 NVPalB[I]:=Pal[I] And 255;
End;
SegaSkip:=-1; FillChar(CVStrips,SizeOf(CVStrips),0);
If Kind=9 Then Begin
 If Pal4<>0 Then Stride:=W4 Else Stride:=W4*3;
 GetMem(Pic,Stride*H4+64); FillChar(Pic^,Stride*H4+64,0);
 GetMem(Out2,W*H*3+64);
End Else
Begin
 Pic:=Nil; GetMem(Out2,W4*H*3+W4*H+64);
End;
Pos:=MoviePos;
While Pos+8<=Size Do Begin
 Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4);
 If Sz<0 Then Break;
 If Tag='LIST' Then Begin
  Inc(Pos,12); Continue;
 End;
 If Pos+8+Sz>Size Then Sz:=Size-Pos-8;
 If (Tag[1]='0') And (Tag[2]='0') And (Tag[3]='p') And (Tag[4]='c') And (Kind=9)
  And (
 Bits<=8) Then Begin
  K:=F^[Pos+8]; N:=F^[Pos+9]; If N=0 Then N:=256;
  For I:=0 To N-1 Do If (K+I<256) And (4+4*I+3<Sz) Then Begin
   NVPalR[K+I]:=F^[Pos+8+4+4*I]; NVPalG[K+I]:=F^[Pos+8+4+4*I+1];
   NVPalB[K+I]:=F^[Pos+8+4+4*I+2];
  End;
 End Else If (Tag[1]='0') And (Tag[2]='0') And ((Tag[3]='d') Or (Tag[3]='w'))
  And ((
 Tag[4]='c') Or (Tag[4]='b')) Then Begin
  Pk:=PEABuffer(@F^[Pos+8]); Ok:=False;
  Case Kind Of
  7: If (Sz Div H>=W) Then Begin
     { 411 : 4 octets par groupe de 4 pixels }
   PY:=Out2; PU:=PEABuffer(@Out2^[W4*H]); PV:=PEABuffer(@Out2^[W4*H+NVCW*H]);
   BP:=0;
   For Y:=0 To H-1 Do Begin
    X:=0;
    While X<W Do Begin
     PY^[Y*W4+X+3]:=(G5(BP,5,Pk,Sz)*33) Shr 2; PY^[Y*W4+X+2]:=(G5(BP,5,Pk,Sz)*
      33) Shr 2;
     PY^[Y*W4+X+1]:=(G5(BP,5,Pk,Sz)*33) Shr 2; PY^[Y*W4+X]:=(G5(BP,5,Pk,Sz)*33)
      Shr 2;
