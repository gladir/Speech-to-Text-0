Function FByte(P:LongInt):Byte;Begin
 If (P<0) Or (P>=FileEnd) Then Fail('4xm: lecture hors fichier.');
 If (P<CacheAt) Or (P>=CacheAt+CacheSize) Then Begin
  CacheAt:=P; CacheSize:=4096; If FileEnd-P<CacheSize Then CacheSize:=FileEnd-P;
  ReadAt(P,Cache,CacheSize);
 End;
 FByte:=Cache[P-CacheAt];
End;

Function FNumber(P:LongInt):LongInt;
Var
 V:Double;
 J:Integer;
Begin
 V:=0;
 For J:=3 Downto 0 Do V:=V*256+FByte(P+J);
 If V>2147483647.0 Then Fail('4xm: entier hors limites.'); FNumber:=Trunc(V);
End;

Function Tag(P:LongInt):String;
Var
 S:String;
 J:Integer;
Begin
 S:='';
 For J:=0 To 3 Do S:=S+Chr(FByte(P+J)); Tag:=S;
End;

Function PB(P:LongInt):Byte;
Var
 S:PXSegment;
Begin
 If (P<0) Or (P>=PacketSize) Then Fail('4xm: paquet tronque.');
 If Packet=Nil Then PB:=FByte(PacketAt+P) Else
 Begin
  S:=Packet;
  While (S<>Nil) And (P>=S^.Size) Do Begin
   Dec(P,S^.Size); S:=S^.Next;
  End;
  If S=Nil Then Fail('4xm: fragments incomplets.'); PB:=FByte(S^.At+P);
 End;
End;

Function PN(P:LongInt):LongInt;
Var
 V:Double;
 J:Integer;
Begin
 V:=0;
 For J:=3 Downto 0 Do V:=V*256+PB(P+J);
 If V>2147483647.0 Then Fail('4xm: taille de flux excessive.'); PN:=Trunc(V);
End;

Function PW(P:LongInt):Word;Begin
 PW:=Word(PB(P))+Word(PB(P+1))*256;
End;

Function Bits(Var G:TXBits; N:Integer):LongInt;
Var
 V,P:LongInt;
 J:Integer;
Begin
 If (N<0) Or (N>24) Or (G.Bit>G.Size*8-N) Then Fail(
  '4xm: flux de bits tronque.');
 V:=0;
 For J:=1 To N Do Begin
  P:=G.Bit Div 8; If G.Swap Then P:=(P Div 4)*4+3-(P Mod 4);
  V:=V*2+((PB(G.At+P) Shr (7-(G.Bit Mod 8))) And 1); Inc(G.Bit);
 End;
 Bits:=V;
End;

Function SAR(V:LongInt; N:Integer):LongInt;
Var
 D:LongInt;
Begin
 D:=LongInt(1) Shl N; If V>=0 Then SAR:=V Div D Else SAR:=-1-((-1-V) Div D);
End;

Function Signed16(V:LongInt):LongInt;Begin
 V:=V And $FFFF; If V>=32768 Then Dec(V,65536); Signed16:=V;
End;

Function Mul(V,K:LongInt):LongInt;
Var
 P : Int64 ;
Begin
 P :=
(Int64(
V ) *K ) And $FFFFFFFF ;
 If P >= 2147483648 Then P := P - 4294967296 ; Mul:=SAR( P ,16);
End;

Procedure Transform(Var Block:TXBlock);
Var
 A,T:TXBlock;
 Pass,I,J:Integer;
 t0,t1,t2,t3,t4,t5,t6,t7,t10,t11,t12,t13,z5,z10,z11,z12,z13:LongInt;
Begin
 FillChar(T,SizeOf(T),0);
 For Pass:=0 To 1 Do
 For I:=0 To 7 Do Begin
  For J:=0 To 7 Do If Pass=0 Then A[J]:=Block[J*8+I] Else A[J]:=T[I*8+J];
  t10:=A[0]+A[4]; t11:=A[0]-A[4]; t13:=A[2]+A[6]; t12:=Mul(A[2]-A[6],92682)-t13;
  t0:=t10+t13; t3:=t10-t13; t1:=t11+t12; t2:=t11-t12;
  z13:=A[5]+A[3]; z10:=A[5]-A[3]; z11:=A[1]+A[7]; z12:=A[1]-A[7];
  t7:=z11+z13; t11:=Mul(z11-z13,92682); z5:=Mul(z10+z12,121095);
  t10:=Mul(z12,70936)-z5; t12:=Mul(z10,-171254)+z5;
  t6:=t12-t7; t5:=t11-t6; t4:=t10+t5;
  A[0]:=t0+t7; A[7]:=t0-t7; A[1]:=t1+t6; A[6]:=t1-t6;
  A[2]:=t2+t5; A[5]:=t2-t5; A[4]:=t3+t4; A[3]:=t3-t4;
  For J:=0 To 7 Do If Pass=0 Then T[J*8+I]:=A[J] Else Block[I*8+J]:=Signed16(
   SAR(A[J],6));
 End;
End;

Function Huff:Integer;
Var
 N,Count:Integer;
Begin
 N:=Root; Count:=0;
 While N>256 Do Begin
  N:=Nodes[N,Bits(Pre,1)]; Inc(Count);
  If Count>31 Then Fail('4xm: Huffman trop profond.');
 End;
 Huff:=N;
End;

Function XBits(N:Integer):LongInt;
Var
 V:LongInt;
Begin
 V:=Bits(GB,N); If (N>0) And (V<(LongInt(1) Shl (N-1))) Then V:=V+1-(LongInt(1)
  Shl N);
 XBits:=V;
End;

Procedure ReadBlock(Var B:TXBlock);
Const
 Zig:Array[0..63] Of Byte=(0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,12,19,26,33,
  40,48,41,
 34,27,20,13,6,7,14,21,28,35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,58,59,
  52,45,38,
 31,39,46,53,60,61,54,47,55,62,63);
Var
 Code,I,J:Integer;
 V:LongInt;
Begin
 FillChar(B,SizeOf(B),0); Code:=Huff; If Code>15 Then Fail(
  '4xm: code DC incorrect.');
 V:=XBits(Code)*16+LastDC; LastDC:=Signed16(V); B[0]:=LastDC; I:=1;
 While I<64 Do Begin
  Code:=Huff; If Code=0 Then Exit;
  If Code=240 Then Begin
   Inc(I,16); If I>=64 Then Fail('4xm: run AC hors bloc.');
  End Else
  Begin
   If (Code>=256) Or (Code Mod 16=0) Then Fail('4xm: code AC incorrect.');
   V:=XBits(Code Mod 16); Inc(I,Code Div 16);
   If I>=64 Then Fail('4xm: coefficient hors bloc.');
   J:=Zig[I]; B[J]:=Signed16(V*XMDQ[J]); Inc(I);
  End;
 End;
End;

Procedure DecodeI;
Var
 Freq:Array[0..511] Of LongInt;
 P,Start,Finish,Size,Base,Count,Min0,Min1:LongInt;
 I,J,S0,S1,X,Y,XX,YY,K,BX,BY,Bi:Integer;
 CB,CR,CG,L,V:LongInt;
Begin
 Size:=PN(0);
 If (Size>PacketSize-12) Or (Size>67108864) Then Fail(
  '4xm: taille intra incorrecte.');
 Count:=PN(Size+4);
 If (Count>(PacketSize-Size-12) Div 4) Or (Count*4<>PacketSize-Size-12) Then
  Fail(
 '4xm: prefixe intra incorrect.');
 GB.At:=4; GB.Size:=Size; GB.Bit:=0; GB.Swap:=False;
 Base:=Size+12; P:=Base; FillChar(Freq,SizeOf(Freq),0);
 Start:=PB(P); Inc(P); Finish:=PB(P); Inc(P);
 Repeat
 If Start>Finish Then Fail('4xm: plage Huffman incorrecte.');
 For I:=Start To Finish Do Begin
  Freq[I]:=PB(P); Inc(P);
 End;
 Start:=PB(P); Inc(P); If Start=0 Then Break; Finish:=PB(P); Inc(P);
 Until False;
 Freq[256]:=1;
 While (P-Base) Mod 4<>0 Do Inc(P);
 If P>PacketSize Then Fail('4xm: table Huffman tronquee.');
 Root:=256;
 For J:=257 To 511 Do Begin
  Min0:=65536; Min1:=65536; S0:=0; S1:=0;
  For I:=0 To J-1 Do If (Freq[I]>0) And (Freq[I]<Min1) Then Begin
   If Freq[I]<Min0 Then Begin
    Min1:=Min0; S1:=S0; Min0:=Freq[I]; S0:=I;
   End
    Else
   Begin
    Min1:=Freq[I]; S1:=I;
   End;
  End;
  If Min1=65536 Then Break;
  Freq[J]:=Min0+Min1; Freq[S0]:=0; Freq[S1]:=0; Nodes[J,0]:=S0; Nodes[J,1]:=S1;
   Root:=J;
 End;
 If Root=256 Then Fail('4xm: table Huffman vide.');
 Pre.At:=P; Pre.Size:=PacketSize-P; Pre.Bit:=0; Pre.Swap:=True; LastDC:=0;
 For BY:=0 To H Div 16-1 Do
 For BX:=0 To W Div 16-1 Do Begin
  For K:=0 To 5 Do Begin
   ReadBlock(Blocks[K]); If K<4 Then Blocks[K,0]:=Signed16(Blocks[K,0]+8192);
   Transform(Blocks[K]);
  End;
  For Y:=0 To 7 Do
  For X:=0 To 7 Do Begin
   Bi:=X Div 4+2*(Y Div 4); I:=2*(X Mod 4)+16*(Y Mod 4);
   CB:=Blocks[4,X+8*Y]; CR:=Blocks[5,X+8*Y]; CG:=SAR(CB+CR,1); CB:=CB*2;
   For YY:=0 To 1 Do
   For XX:=0 To 1 Do Begin
    L:=Blocks[Bi,I+XX+YY*8]; V:=SAR(L+CB,3)+((L-CG) And $FC)*8+((L+CR) And $F8)*
     256;
    Frames^[Cur,BY*16+Y*2+YY]^[BX*16+X*2+XX]:=V And $FFFF;
   End;
  End;
 End;
 If Huff<>256 Then Fail('4xm: marqueur final intra absent.');
End;

Function Mixed(A,B:Word):Word;Begin
 Mixed:=((2*(A And 31)+(B And 31)) Div 3)+
 ((2*((A Shr 5) And 31)+((B Shr 5) And 31)) Div 3)*32+
 ((2*(A Shr 10)+(B Shr 10)) Div 3)*1024;
End;

Procedure DecodeI2;
Var
 X,Y,XX,YY,I:Integer;
 P:LongInt;
 Colors:Array[0..3] Of Word;
 B:Array[0..3] Of Byte;
Begin
 P:=0;
 For Y:=0 To H Div 16-1 Do
 For X:=0 To W Div 16-1 Do Begin
  Colors[0]:=PW(P); Colors[1]:=PW(P+2);
  If ((Colors[0] Or Colors[1]) And $8000)<>0 Then Fail(
   '4xm: couleur ifr2 hors profil.');
  Colors[2]:=Mixed(Colors[0],Colors[1]); Colors[3]:=Mixed(Colors[1],Colors[0]);
  For I:=0 To 3 Do B[I]:=PB(P+4+I); Inc(P,8);
  For YY:=0 To 15 Do
  For XX:=0 To 15 Do Frames^[Cur,Y*16+YY]^[X*16+XX]:=Colors[(B[YY Div 4] Shr (2*
   (XX Div 4)
  )) And 3];
 End;
End;

Function NextWord:Word;Begin
 If WordsAt>WordsEnd-2 Then Fail('4xm: wordstream tronque.'); NextWord:=PW(
  WordsAt);
 Inc(WordsAt,2);
End;

Function NextByte:Byte;Begin
 If BytesAt>=BytesEnd Then Fail('4xm: bytestream tronque.'); NextByte:=PB(
  BytesAt);
 Inc(BytesAt);
End;

Procedure PBlock(X,Y,LW,LH:Integer);
Var
 Index,Table,Code,Len,BitsSoFar,I,DX,DY,BW,BH,XX,YY,Scale,Carry:Integer;
 DC,V,S,Base:LongInt;
Begin
 If (LW=0) And (LH=0) Then Fail('4xm: bloc predictif nul.');
 Index:=0; If LH=0 Then Begin
  If LW=1 Then Index:=3 Else Index:=1;
 End;
 If LW=0 Then Begin
  If LH=1 Then Index:=3 Else Index:=2;
 End;
 Table:=0; If Version<=1 Then Table:=1;
 Code:=-1; BitsSoFar:=0;
 For Len:=1 To 5 Do Begin
  BitsSoFar:=BitsSoFar*2+Bits(GB,1);
  For I:=0 To 6 Do If (XMCode[Table,Index,I,1]=Len) And (XMCode[Table,Index,I,
   0]=
  BitsSoFar) Then Code:=I;
  If Code>=0 Then Break;
 End;
 If Code<0 Then Fail('4xm: VLC predictif invalide.');
 If Code=1 Then Begin
  If LH=0 Then Fail('4xm: division verticale invalide.'); PBlock(X,Y,LW,LH-1);
  PBlock(X,Y+(1 Shl (LH-1)),LW,LH-1); Exit;
 End;
 If Code=2 Then Begin
  If LW=0 Then Fail('4xm: division horizontale invalide.'); PBlock(X,Y,LW-1,LH);
  PBlock(X+(1 Shl (LW-1)),Y,LW-1,LH); Exit;
 End;
 If Code=6 Then Begin
  Frames^[Cur,Y]^[X]:=NextWord;
  If LW>0 Then Frames^[Cur,Y]^[X+1]:=NextWord Else Frames^[Cur,Y+1]^[X]:=
   NextWord; Exit;
 End;
 If (Code=3) And (Version>=2) Then Exit;
 DX:=0; DY:=0; DC:=0; Scale:=1; BW:=1 Shl LW; BH:=1 Shl LH;
 If (Code=0) Or (Code=4) Then Begin
  I:=NextByte;
  If Version>1 Then Begin
   DX:=XMVec[I,0]; DY:=XMVec[I,1];
  End
   Else
  Begin
   DX:=(I And 15)-8; DY:=(I Shr 4)-8;
  End;
 End;
 If (Code=4) Or (Code=5) Then DC:=NextWord;
 If Code=5 Then Scale:=0;
 Base:=LongInt(Y+DY)*W+X+DX;
 If (Base<0) Or (Base>LongInt(W)*(H-BH+1)-BW) Then Fail(
  '4xm: vecteur hors image.');
 For YY:=0 To BH-1 Do Begin
  Carry:=0;
  For XX:=0 To BW-1 Do Begin
   S:=Base+LongInt(YY)*W+XX;
   V:=Scale*LongInt(Frames^[Prev,S Div W]^[S Mod W])+DC;
   If (LW>0) And Odd(XX) Then Inc(V,Carry);
   Carry:=0; If (LW>0) And Not Odd(XX) And (V>65535) Then Carry:=1;
   Frames^[Cur,Y+YY]^[X+XX]:=V And $FFFF;
  End;
 End;
End;

Procedure DecodeP(OldWords,OldBits:LongInt);
Var
 Extra,BS,WS,YS:LongInt;
 X,Y:Integer;
Begin
 Extra:=0; BS:=OldBits; WS:=OldWords;
 If Version>1 Then Begin
  Extra:=20; BS:=PN(8); WS:=PN(12); YS:=PN(16);
 End
 Else YS:=PacketSize-BS-WS;
 If (BS Mod 4<>0) Or (BS>PacketSize) Or (WS>PacketSize-BS) Or (YS<0) Or (
  YS>PacketSize-BS-
 WS) Or (Extra>PacketSize-BS-WS-YS) Then Fail(
  '4xm: tailles predictives invalides.');
 GB.At:=Extra; GB.Size:=BS; GB.Bit:=0; GB.Swap:=True;
 WordsAt:=Extra+BS; WordsEnd:= PacketSize; BytesAt:=Extra+BS +WS;  BytesEnd:=
  PacketSize ;
{ FFmpeg: les flux mots/octets vont jusqu'a la fin du paquet }

 For Y:=0 To H Div 8-1 Do
 For X:=0 To W Div 8-1 Do PBlock(X*8,Y*8,3,3);
End;

Procedure RGB(X,Y:Integer; Var R,G,B:LongInt);
Var
 V:Word;
Begin
 V:=Frames^[Cur,Y]^[X];
 If Version>2 Then Begin
  R:=(V Shr 11) And 31; G:=(V Shr 5) And 63; B:=V And 31; G:=(G Shl 2) Or (G Shr
   4);
 End
  Else
 Begin
  B:=(V Shr 10) And 31; G:=(V Shr 5) And 31; R:=V And 31; G:=(G Shl 3) Or (G Shr
   2);
 End;
 R:=(R Shl 3) Or (R Shr 2); B:=(B Shl 3) Or (B Shr 2);
End;
Var XMOut: PEABuffer;


Procedure OutputFrame;
Var
 X,Y, Swap:Integer;
 V :Word; D :LongInt;
 NbF,NbP : Int64 ;
Begin
 D:=0;
  For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
  V:= Frames^[Cur,Y]^ [ X ] ;

   If Version<=2 Then V := ( V And $3E0 ) Or (( V Shr 10 ) And 31 ) Or ( ( V And
    31) Shl 10 );
      XMOut^[D] := V And 255 ;
      XMOut^[D + 1]:= V Shr 8 ; Inc( D , 2 );
     End;
     CFSync ( FrameCount,1,NbF,NbP ) ;
    NVEmitN ( XMOut , NbP,NbF );
   Inc(CFNext,NbF) ;
  Inc(CFFrameNo,NbF) ;

 Swap:=Cur; Cur:=Prev; Prev:=Swap; Inc(FrameCount);
End;

Procedure StartOutput;
Var

 I,J:Integer;
RN,RD: LongInt;

Begin
 If Not HaveHeader Or Not HaveRate Then Fail(
  '4xm: piste video ou cadence absente.');

 New(Frames); FillChar(Frames^,SizeOf(Frames^),0);
 For I:=0 To 1 Do
 For J:=0 To H-1 Do Begin
  GetMem(Frames^[I,J],W*2); FillChar(Frames^[I,J]^,W*2,0);
 End;
 GetMem (
XMOut,
W * H *2+64 ); RN := RateN ; RD := RateD
; NVGcd(RN,RD);
 If Version>2 Then NVBegin(0,Target,W,H,5,RN,RD) Else NVBegin(0,Target,W,H,2
, RN,RD ); NVOpened := False ;
  Opened:=True;
 CFTbN:=RD; CFTbD:=RN; CFFn:=RN; CFFd:=RD; CFNext:=0; CFFrameNo:=0; CFHist[0]:=
  0; CFHist [1] :=0; CFHist[2]:=0; CFLastDropped:=False; CFVscfr:=False;
End;

Procedure Scan(Start,Finish:LongInt; Depth:Integer; InMovie:Boolean);
Var
 P,N,EndAt,At,ID,Total,Count:LongInt;
 Kind,ListKind:String;
 I,J,Slot:Integer;
 Rate:Single;
 Raw:Array[0..3] Of Byte;
 Num:Double;
 S:PXSegment;
Begin
 If Depth>16 Then Fail('4xm: imbrication excessive.'); P:=Start;
 While P<Finish Do Begin
  If Finish-P<8 Then Fail('4xm: entete de bloc tronquee.'); Kind:=Tag(P); N:=
   FNumber(P+4);
  At:=P+8;
  If N>Finish-At Then Fail('4xm: bloc hors conteneur.'); EndAt:=At+N;
  If Kind='LIST' Then Begin
   If N<4 Then Fail('4xm: LIST tronquee.'); ListKind:=Tag(At);
   Scan(At+4,EndAt,Depth+1,InMovie Or (ListKind='MOVI'));
  End Else If (Kind='std_') And Not InMovie Then Begin
   If N<8 Then Fail('4xm: cadence tronquee.');
   For J:=0 To 3 Do Raw[J]:=FByte(At+4+J);
   If (Raw[3] And $7F)=$7F Then Fail('4xm: cadence invalide.'); Move(Raw,Rate,
    4);
   If (Rate<=0) Or (Rate>120) Then Fail('4xm: cadence 0..120 requise.');
   RateD:=10000; Num:=Rate*RateD; RateN:=Round(Num);
   If RateN=0 Then Fail('4xm: cadence trop petite.'); HaveRate:=True;
  End Else If (Kind='vtrk') And Not InMovie Then Begin
   If HaveHeader Or (N<>68) Then Fail(
    '4xm: une seule piste video vtrk requise.');
   Version:=FNumber(At+8) Shr 16; Count:=FNumber(At+28);
   If (Count<16) Or (Count>640) Or (Count Mod 16<>0) Then Fail(
   '4xm: largeur multiple de 16, maximum 640.'); W:=Count;
   Count:=FNumber(At+32);
   If (Count<16) Or (Count>480) Or (Count Mod 16<>0) Then Fail(
   '4xm: hauteur multiple de 16, maximum 480.'); H:=Count;
   If (Version<0) Or (Version>4) Then Fail('4xm: versions 0..4 uniquement.');
   HaveHeader:=True;
  End Else If InMovie And ((Kind='ifrm') Or (Kind='ifr2') Or (Kind='pfrm') Or (
   Kind=
  'pfr2') Or (Kind='cfrm') Or (Kind='cfr2')) Then Begin
   If Not Opened Then StartOutput;
   Packet:=Nil; Slot:=-1; PacketAt:=At; PacketSize:=N;
   If (Kind='cfrm') Or (Kind='cfr2') Then Begin
    If (Version<=1) Or (N<12) Then Fail('4xm: fragment invalide.');
    ID:=FNumber(At+4); Total:=FNumber(At+8);
    If Total<20 Then Fail('4xm: taille fragmentee invalide.');
    For I:=0 To 99 Do If (Pending^[I].First<>Nil) And (Pending^[I].ID=ID) Then
     Slot:=I;
    If Slot<0 Then
    For I:=99 Downto 0 Do If Pending^[I].First=Nil Then Slot:=I;
    If Slot<0 Then Fail('4xm: trop de trames fragmentees.');
    If Pending^[Slot].First=Nil Then Begin
     Pending^[Slot].ID:=ID; Pending^[Slot].Total:=Total;
    End;
    If (Pending^[Slot].Total<>Total) Or (N-12>Total-Pending^[Slot].Size) Or (
     N=12)
    Then Fail('4xm: fragments incoherents.');
    New(S); S^.Next:=Nil; S^.At:=At+12; S^.Size:=N-12;
    If Pending^[Slot].Last=Nil Then Pending^[Slot].First:=
    S Else Pending^[Slot].Last^.Next:=S;
    Pending^[Slot].Last:=S; Inc(Pending^[Slot].Size,N-12);
    If Pending^[Slot].Size=Total Then Begin
     Packet:=Pending^[Slot].First; PacketSize:=Total; DecodeP(0,0); OutputFrame;
     While Packet<>Nil Do Begin
      S:=Packet; Packet:=S^.Next; Dispose(S);
     End;
     FillChar(Pending^[Slot],SizeOf(TXPending),0);
    End;
   End Else
   Begin
    If Kind='ifr2' Then DecodeI2 Else
    Begin
     If N<4 Then Fail('4xm: paquet video tronque.'); Inc(PacketAt,4); Dec(
      PacketSize,4);
     If Kind='ifrm' Then DecodeI Else DecodeP(FByte(At+2)+LongInt(FByte(At+3))*
      256,FByte(
     At)+LongInt(FByte(At+1))*256);
    End;
    OutputFrame;
   End;
  End;
  P:=EndAt; { 4XM chunks are not RIFF word-padded, matching the demuxer. }
 End;
End;

Var
 I,J:Integer;
 Size:LongInt;
Begin
 OpenRead(Source); FileEnd:=InputSize; CacheAt:=-1; CacheSize:=0; Packet:=Nil;
 HaveHeader:=False; HaveRate:=False; Opened:=False; FrameCount:=0; Cur:=0;
  Prev:=1;
 Frames:=Nil;
 New(Pending); FillChar(Pending^,SizeOf(Pending^),0);
 If (FileEnd<12) Or (Tag(0)<>'RIFF') Or (Tag(8)<>'4XMV') Then Fail(
 '4xm: signature RIFF/4XMV requise.');
 Size:=FNumber(4); If Size<>FileEnd-8 Then Fail(
  '4xm: taille RIFF incoherente.');
 Scan(12,FileEnd,0,False);
 For I:=0 To 99 Do If Pending^[I].First<>Nil Then Fail(
 '4xm: trame fragmentee incomplete.');
 If FrameCount=0 Then Fail('4xm: aucune image video.');
 CFFlush(XMOut) ; NVFinish('4xm') ;
 For I:=0 To 1 Do
 For J:=0 To H-1 Do FreeMem(Frames^[I,J],W*2);
 Dispose(Frames); Dispose(Pending);
End;
{ Planar YUV420 crop, preserving cadence, pixel aspect and plane samples. }

Procedure CropY4M(Const Source,Target:String);
Var
 At,Limit,FrameSize,PlaneAt,P,LeftToCopy:LongInt;
 W,H,NW,NH,PW,PH,CW,CH,L,T,Plane,Y,Take,J,Code:Integer;
 Line,Token,Extra,Header,S:String;
 B:Byte;
 Buffer:Array[0..4095] Of Byte;
 Frames:LongInt;

Function LineAt:String;
Var
 R:String;
Begin
 R:='';
 Repeat
 If At>=Limit Then Fail('Crop: ligne Y4M tronquee.');
 ReadAt(At,B,1); Inc(At); If B=10 Then Break;
 If (B=13) Or (Length(R)>=254) Then Fail('Crop: ligne Y4M incorrecte.');
 R:=R+Chr(B);
 Until False;
 LineAt:=R;
End;

Procedure PutLine(V:String);Begin
 If Length(V)>0 Then WriteBytes(V[1],Length(V)); B:=10; WriteBytes(B,1);
End;
Begin
 If Odd(CropTop) Or Odd(CropBottom) Or Odd(CropLeft) Or Odd(CropRight) Then
  Fail(
 'Crop YUV420: bandes paires requises pour conserver la chrominance.');
 OpenRead(Source); Limit:=InputSize; At:=0; W:=0; H:=0; Extra:=''; Frames:=0;
 Line:=LineAt; If Copy(Line,1,10)<>'YUV4MPEG2 ' Then Fail('Crop: Y4M requis.');
 Delete(Line,1,10);
 While Line<>'' Do Begin
  While (Line<>'') And (Line[1]=' ') Do Delete(Line,1,1); If Line='' Then Break;
  J:=Pos(' ',Line); If J=0 Then J:=Length(Line)+1;
  Token:=Copy(Line,1,J-1); Delete(Line,1,J);
  If Token[1] In ['W','H'] Then Begin
   Val(Copy(Token,2,255),P,Code);
   If (Code<>0) Or (P<2) Or (P>8192) Or Odd(P) Then Fail(
   'Crop: dimensions Y4M paires 2..8192 requises.');
   If Token[1]='W' Then Begin
    If W<>0 Then Fail('Crop: largeur dupliquee.'); W:=P;
   End
    Else
   Begin
    If H<>0 Then Fail('Crop: hauteur dupliquee.'); H:=P;
   End;
  End Else
  Begin
   If (Token[1]='C') And (Token<>'C420') And (Token<>'C420jpeg')
And (Token<>'C420mpeg2') And (Token<>'C420paldv')
 Then Fail(
   'Crop: YUV420 8 bits requis.');
   If (Token[1]='I') And (Token<>'Ip') Then Fail(
    'Crop: video progressive requise.');
   If Not ((Token[1]='A') And (AspectNum>0) And (OutputFormat='yuv4mpegpipe'))
   Then Extra:=Extra+' '+Token;
  End;
 End;
 If (W=0) Or (H=0) Then Fail('Crop: dimensions absentes.');
 NW:=W-CropLeft-CropRight; NH:=H-CropTop-CropBottom;
 If (NW<2) Or (NH<2) Then Fail('Crop: les bandes suppriment toute l''image.');
 Str(NW,S); Header:='YUV4MPEG2 W'+S; Str(NH,S); Header:=Header+' H'+S;
 If Length(Header)+Length(Extra)>210 Then Fail('Crop: en-tete Y4M trop long.');
 Header:=Header+Extra;
 If (AspectNum>0) And (OutputFormat='yuv4mpegpipe') Then Begin
  If (AspectNum*1.0*NH>2147483647.0) Or (AspectDen*1.0*NW>2147483647.0) Then
   Fail(
  'Crop: ratio de sortie trop grand.');
  Str(LongInt(AspectNum)*NH,S); Header:=Header+' A'+S;
  Str(LongInt(AspectDen)*NW,S); Header:=Header+':'+S;
 End;
 OpenWrite(Target); PutLine(Header); FrameSize:=LongInt(W)*H*3 Div 2;
 While At<Limit Do Begin
  Line:=LineAt;
  If (Line<>'FRAME') And (Copy(Line,1,6)<>'FRAME ') Then Fail(
  'Crop: marqueur FRAME requis.');
  If FrameSize>Limit-At Then Fail('Crop: image Y4M tronquee.'); PutLine(Line);
  PlaneAt:=At;
  For Plane:=0 To 2 Do Begin
   PW:=W; PH:=H; CW:=NW; CH:=NH; L:=CropLeft; T:=CropTop;
   If Plane<>0 Then Begin
    PW:=PW Div 2; PH:=PH Div 2; CW:=CW Div 2; CH:=CH Div 2; L:=L Div 2; T:=T Div
     2;
   End;
   For Y:=0 To CH-1 Do Begin
    P:=PlaneAt+LongInt(Y+T)*PW+L; LeftToCopy:=CW;
    While LeftToCopy>0 Do Begin
     Take:=4096; If LeftToCopy<Take Then Take:=LeftToCopy;
     ReadAt(P,Buffer,Take); WriteBytes(Buffer,Take); Inc(P,Take); Dec(
      LeftToCopy,Take);
    End;
   End;
   Inc(PlaneAt,LongInt(PW)*PH);
  End;
  Inc(At,FrameSize); Inc(Frames);
 End;
 If Frames=0 Then Fail('Crop: aucune image.'); CloseRead; CloseWrite;
End;

Procedure Commit(Const Stage: String);
Var
 F: File;
 Backup,Ready: String;
 Code,RestoreCode: Integer;
Begin
 Backup:=''; Ready:=Stage;
 If
F4Pending Then Ready:=F4CommitStage(Stage); { F4 }
 If F4TrimN>0 Then F4TrimWav(Stage); { F4 }
 If
 HasCrop And (OutputFormat='yuv4mpegpipe') And (InputFormat<>'yuv4mpegpipe')
  Then Begin
  Temps[6]:=NewTemporary; CropY4M(Stage,Temps[6]); Ready:=Temps[6];
 End;
 If (HasAlbum Or HasComment) And ((OutputFormat='mp3') Or (OutputFormat='wav'))
  Then Begin
  Temps[4]:=NewTemporary; WriteAudioAlbum(Stage,Temps[4]); Ready:=Temps[4];
 End
Else If (OutputFormat='wav') And MdIsPlainWav(Stage) Then Begin
  Temps[4]:=NewTemporary; MdWavInsert(Stage,Temps[4]); Ready:=Temps[4];
 End
;
 If IsDirectory(OutputPath) Then Fail('La sortie designe un dossier.');
 If Exists(OutputPath) Then Begin
  If Not Overwrite Then Fail(
   'Sortie existante (utiliser -y pour la remplacer): '+
  OutputPath);
  Backup:=NewTemporary; Assign(F,OutputPath);
  {$I-}Rename(F,Backup); Code:=IOResult;{$I+}
  If Code<>0 Then Fail('Sauvegarde de la sortie existante impossible.');
 End;
 Assign(F,Ready); {$I-}Rename(F,OutputPath); Code:=IOResult;{$I+}
 If Code<>0 Then Begin
  If Backup<>'' Then Begin
   Assign(F,Backup); {$I-}Rename(F,OutputPath); RestoreCode:=IOResult;{$I+}
   If RestoreCode<>0 Then WriteLn('Ancienne sortie conservee ici: ',Backup);
  End;
  Fail('Installation du fichier de sortie impossible.');
 End;
 If Ready<>Stage Then Begin
  Assign(F,Stage); {$I-}Erase(F); Code:=IOResult;{$I+}
  If Code<>0 Then WriteLn('Temporaire a supprimer: ',Stage);
  Temps[4]:=''; Temps[6]:='';
 End;
 If Backup<>'' Then Begin
  Assign(F,Backup); {$I-}Erase(F); Code:=IOResult;{$I+}
  If Code<>0 Then WriteLn('Sauvegarde a supprimer: ',Backup);
 End;
End;

