   If EncodeMode Then Begin
    N:=Coeff[Block,0]; If N=128 Then N:=255; Dummy:=LVBits(8,N);
    Last:=0; For I:=1 To 63 Do If Coeff[Block,Scan[I]]<>0 Then Last:=I;
    Run:=0;
    For I:=1 To Last Do Begin
     Level:=Coeff[Block,Scan[I]];
     If Level=0 Then Inc(Run) Else Begin
      Dummy:=LVBits(7,3); Dummy:=LVBits(1,1); Dummy:=LVBits(1,Ord(I=Last));
      Dummy:=LVBits(6,Run); Dummy:=LVBits(11,Level And 2047); Run:=0;
     End;
    End;
   End Else Begin
    N:=LVBits(8,0); If (N=0) Or (N=128) Then Fail('FLV1: DC invalide.'); If N=255 Then N:=128;
    Coeff[Block,0]:=N*8; Index:=0;
    If (CBP And (1 Shl (5-Block)))<>0 Then Repeat
     Code:=VLC(2);
     If Code=102 Then Begin
      N:=8;
      If LVVersion=1 Then Begin N:=7; If LVBits(1,0)<>0 Then N:=11; End;
      Last:=LVBits(1,0); Run:=LVBits(6,0); Level:=LVBits(N,0);
      If Level>=(1 Shl (N-1)) Then Dec(Level,1 Shl N);
      If (LVVersion=0) And (Level=-128) Then Begin
       I:=LVBits(5,0); J:=LVBits(6,0); If J>=32 Then Dec(J,64); Level:=I+J*32;
      End;
      If Level=0 Then Fail('FLV1: coefficient nul dans escape.');
     End Else Begin
      Last:=Ord(Code>=58); Run:=RLRun[Code]; Level:=RLLevel[Code];
      If LVBits(1,0)<>0 Then Level:=-Level;
     End;
     Inc(Index,Run+1); If Index>63 Then Fail('FLV1: depassement bloc DCT.');
     N:=Abs(Level)*2*LVQP+((LVQP-1) Or 1); If Level<0 Then N:=-N;
     Coeff[Block,Scan[Index]]:=N;
    Until Last<>0;
    Geometry(Block);
    For Y:=0 To 7 Do For X:=0 To 7 Do Begin
     Sum:=0; For U:=0 To 7 Do Sum:=Sum+C[U,X]*Coeff[Block,Y*8+U]; Temp[Y,X]:=Sum;
    End;
    For Y:=0 To 7 Do If BY+Y<PH Then Begin
     K:=0;
     For X:=0 To 7 Do If BX+X<PW Then Begin
      Sum:=0; For U:=0 To 7 Do Sum:=Sum+C[U,Y]*Temp[U,X];
      N:=Round(Sum); If N<0 Then N:=0 Else If N>255 Then N:=255; Row[X]:=N; Inc(K);
     End;
     If K>0 Then Begin SeekOut(PlaneBase+LongInt(BY+Y)*PW+BX); WriteBytes(Row,K); End;
    End;
   End;
  End;
 End;
 If EncodeMode Then Begin If LVCount<>0 Then Dummy:=LVBits(8-LVCount,0); End
 Else SeekOut(FrameEnd);
End;

Procedure ReadFLV1;
Var At,N,TS,Previous,LastTS,Delta: LongInt; T,Kind: Integer; V: PSample;
Begin
 If (FileLimit<13) Or (Tag(0)<>'FLV'+#1) Then Fail('FLV: entete invalide.');
 At:=Number(5,False); If (At<9) Or ((ByteAt(4) And $FA)<>0) Then Fail('FLV: entete invalide.');
 Bounds(At,4); If Number(At,False)<>0 Then Fail('FLV: premiere taille precedente invalide.'); Inc(At,4);
 T:=AddTrack; Tracks^[T].Video:=True; Tracks^[T].Codec:='FLV1'; Tracks^[T].Scale:=1000;
 Tracks^[T].InputScale:=1000; LastTS:=-1; Delta:=0;
 While At<FileLimit Do Begin
  Bounds(At,11); If (ByteAt(At+8)<>0) Or (U16(At+9,False)<>0) Then Fail('FLV: identifiant de flux non nul.');
  Kind:=ByteAt(At); N:=LongInt(ByteAt(At+1))*65536+U16(At+2,False);
  TS:=LongInt(ByteAt(At+4))*65536+U16(At+5,False);
  If ByteAt(At+7)>127 Then Fail('FLV: horodatage hors limites.'); Inc(TS,LongInt(ByteAt(At+7))*16777216);
  Bounds(At+11,N+4); Previous:=Number(At+11+N,False); If Previous<>N+11 Then Fail('FLV: taille precedente incorrecte.');
  If Kind=9 Then Begin
   If (N<2) Or (ByteAt(At+11)<>$12) Then Fail('FLV1: images intra Sorenson Spark requises.');
   If LastTS>=0 Then Begin
    If Delta=0 Then Delta:=TS-LastTS;
    If (Delta<=0) Or (TS-LastTS<>Delta) Then Fail('FLV1: cadence constante requise.');
    Tracks^[T].Last^.Duration:=Delta;
   End;
   V:=AddSample(T,At+12,N-1,TS,1,0,True); LVHeader(T,V,False); LastTS:=TS;
  End Else If (Kind<>8) And (Kind<>18) Then Fail('FLV: tag non pris en charge.');
  Inc(At,N+15);
 End;
 If Delta=0 Then Fail('FLV1: deux images requises pour determiner la cadence.');
 Tracks^[T].DefaultDuration:=Delta; Tracks^[T].Last^.Duration:=Delta;
 TS:=Tracks^[T].First^.Time; V:=Tracks^[T].First;
 While V<>Nil Do Begin Dec(V^.Time,TS); V:=V^.Next; End;
End;

Procedure WriteFLV1;
Var V: PSample; At,Finish,N,TS: LongInt; J: Integer; Trial:TVideoRateTrial; Seconds:Double;
Begin
 VideoRateStart;
 If TrackCount<>1 Then Fail('FLV1: une seule piste requise.');
 LE:=False; WTag('FLV'+#1); W8(1); W32(9); W32(0); V:=Tracks^[1].First;
 While V<>Nil Do Begin
  At:=OutPos; Seconds:=V^.Duration*1.0/Tracks^[1].Scale; VideoTrialStart(Trial,Seconds);
  Repeat
  SeekOut(At); LVEncodeQP:=Trial.Q; W8(9); Zero(3); TS:=Ticks(V^.Time*1000.0/Tracks^[1].Scale);
  W8((TS Shr 16) And 255); W8((TS Shr 8) And 255); W8(TS And 255); W8((TS Shr 24) And 255); Zero(3);
  W8($12); LVFrame(1,V,True); Finish:=OutPos; N:=Finish-At-11;
  If N>$FFFFFF Then Fail('FLV1: image trop volumineuse.');
  SeekOut(At+1); For J:=2 Downto 0 Do W8((N Shr (J*8)) And 255);
  SeekOut(Finish); W32(N+11);
  Until Not VideoTrialAgain(Trial,OutPos-At);
  VideoRateAccept(OutPos-At,Seconds); V:=V^.Next;
 End; VideoRateReport;
End;

Procedure ReadY4M;
Var At,N,Num,Den: LongInt; Line,Token: String; T,J,K,Code: Integer; V: PSample;
Begin
 At:=0; Line:=Y4Line(At);
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('Y4M: signature absente.');
 T:=AddTrack; Tracks^[T].Video:=True; Tracks^[T].Codec:='FFV1';
 If VideoCodec='flv' Then Tracks^[T].Codec:='FLV1'; Num:=0; Den:=0;
 Delete(Line,1,9);
 While Line<>'' Do Begin
  If Line[1]=' ' Then Delete(Line,1,1) Else Begin
   J:=Pos(' ',Line); If J=0 Then J:=Length(Line)+1;
   Token:=Copy(Line,1,J-1); Delete(Line,1,J);
   Case Token[1] Of
    'W','H': Begin
     Val(Copy(Token,2,255),N,Code); If (Code<>0) Or (N<1) Or (N>4096) Then Fail('Y4M: dimensions 1..4096 requises.');
     If Token[1]='W' Then Tracks^[T].Width:=N Else Tracks^[T].Height:=N;
    End;
    'F': Begin
     K:=Pos(':',Token); If K<3 Then Fail('Y4M: cadence invalide.');
     Val(Copy(Token,2,K-2),Num,Code); If (Code<>0) Or (Num<=0) Or (Num>1000000) Then Fail('Y4M: cadence invalide.');
     Val(Copy(Token,K+1,255),Den,Code); If (Code<>0) Or (Den<=0) Or (Den>1000000) Then Fail('Y4M: cadence invalide.');
    End;
    'C': If (Token<>'C420') And (Token<>'C420jpeg') Then Fail('Y4M: C420jpeg 8 bits requis.');
    'I': If Token<>'Ip' Then Fail('Y4M: video progressive requise.');
    'A': If (Token<>'A1:1') And (Token<>'A0:0') Then Fail('Y4M: pixels carres requis.');
    Else Fail('Y4M: parametre non pris en charge: '+Token);
   End;
  End;
 End;
 If (Num=0) Or (Den=0) Or (Tracks^[T].Width=0) Or (Tracks^[T].Height=0) Then Fail('Y4M: dimensions et cadence requises.');
 Tracks^[T].Scale:=Num; Tracks^[T].InputScale:=Num;
 N:=Tracks^[T].Width*Tracks^[T].Height+2*((Tracks^[T].Width+1) Div 2)*((Tracks^[T].Height+1) Div 2);
 While At<FileLimit Do Begin
  Line:=Y4Line(At); If Line<>'FRAME' Then Fail('Y4M: marqueur FRAME simple requis.');
  V:=AddSample(T,At,N,Ticks(Tracks^[T].Count*1.0*Den),Den,0,True); Inc(At,N);
 End;
End;

{ QuickTime 8BPS planar RLE, adapted from FFmpeg libavcodec/8bps.c,
  Copyright Roberto Togni (2003), LGPL-2.1-or-later. }
Procedure BPFrame(T:Integer; Sample:PSample);
Type
 TBPRow=Array[0..4095] Of Byte; PBPRow=^TBPRow;
 TBPPlane=Array[0..4095] Of PBPRow; PBPPlane=^TBPPlane;
 TBPOutput=Array[0..16383] Of Byte; PBPOutput=^TBPOutput;
Var
 Planes:Array[0..3] Of PBPPlane; Row:PBPOutput;
 W,H,Count,P,Y,X,N,Run,J,V,DX,DY,CW,CH,XX,YY:Integer;
 At,Finish,RowEnd,TableEnd:LongInt; R,G,B,A,Sum,C:LongInt;
Function NextByte:Byte;
Begin If At>=RowEnd Then Fail('8bps: ligne RLE tronquee.'); NextByte:=ByteAt(At); Inc(At); End;
Procedure Pixel(X,Y:Integer; Var R,G,B,A:LongInt);
Var Index:Integer;
Begin
 A:=255;
 If Count=1 Then Begin
  Index:=Planes[0]^[Y]^[X]*3; R:=Tracks^[T].Config[Index]; G:=Tracks^[T].Config[Index+1]; B:=Tracks^[T].Config[Index+2];
 End Else Begin
  R:=Planes[0]^[Y]^[X]; G:=Planes[1]^[Y]^[X]; B:=Planes[2]^[Y]^[X];
  If Count=4 Then A:=Planes[3]^[Y]^[X];
 End;
End;
Function Shift8(Value:LongInt):LongInt;
Begin If Value>=0 Then Shift8:=Value Div 256 Else Shift8:=-1-((-1-Value) Div 256); End;
Begin
 W:=Tracks^[T].Width; H:=Tracks^[T].Height;
 If (W<1) Or (W>4096) Or (H<1) Or (H>4096) Then Fail('8bps: dimensions 1..4096 requises.');
 Count:=Tracks^[T].BPDepth Div 8;
 If (Count<>1) And (Count<>3) And (Count<>4) Then Fail('8bps: profondeur invalide.');
 At:=Sample^.Pos; Finish:=At+Sample^.Size; TableEnd:=At+LongInt(Count)*H*2;
 If TableEnd>Finish Then Fail('8bps: table des longueurs tronquee.');
 {$IFNDEF FPC}
 If MemAvail<LongInt(W)*H*Count+LongInt(SizeOf(TBPPlane))*Count+SizeOf(TBPOutput)+8192 Then Fail('8bps: memoire DOS insuffisante.');
 {$ENDIF}
 New(Row); At:=TableEnd;
 For P:=0 To Count-1 Do Begin
  New(Planes[P]);
  For Y:=0 To H-1 Do Begin
   GetMem(Planes[P]^[Y],W); N:=U16(Sample^.Pos+(LongInt(P)*H+Y)*2,False);
   If N>Finish-At Then Fail('8bps: ligne hors paquet.'); RowEnd:=At+N; X:=0;
   While At<RowEnd Do Begin
    Run:=NextByte;
    If Run<=127 Then Begin
     Inc(Run); If (Run>W-X) Or (Run>RowEnd-At) Then Fail('8bps: sequence litterale hors ligne.');
     For J:=1 To Run Do Begin Planes[P]^[Y]^[X]:=NextByte; Inc(X); End;
    End Else Begin
     Run:=257-Run; If Run>W-X Then Fail('8bps: repetition hors ligne.'); V:=NextByte;
     For J:=1 To Run Do Begin Planes[P]^[Y]^[X]:=V; Inc(X); End;
    End;
   End;
   If X<>W Then Fail('8bps: ligne decodee incomplete.');
  End;
 End;
 If At<>Finish Then Fail('8bps: octets excedentaires apres les plans.');
 {$IFDEF TEST_8BPS_RGBA}
 For Y:=0 To H-1 Do Begin
  For X:=0 To W-1 Do Begin Pixel(X,Y,R,G,B,A); Row^[X*4]:=R; Row^[X*4+1]:=G; Row^[X*4+2]:=B; Row^[X*4+3]:=A; End;
  WriteBytes(Row^,W*4);
 End;
 {$ELSE}
 For P:=0 To 2 Do Begin
  CW:=W; CH:=H; If P<>0 Then Begin CW:=(W+1) Div 2; CH:=(H+1) Div 2; End;
  For Y:=0 To CH-1 Do Begin
   For X:=0 To CW-1 Do Begin
    If P=0 Then Begin Pixel(X,Y,R,G,B,A); Row^[X]:=16+((66*R+129*G+25*B+128) Div 256); End
    Else Begin
     Sum:=0;
     For DY:=0 To 1 Do For DX:=0 To 1 Do Begin
      XX:=X*2+DX; YY:=Y*2+DY; If XX>=W Then XX:=W-1; If YY>=H Then YY:=H-1;
      Pixel(XX,YY,R,G,B,A);
      If P=1 Then C:=-38*R-74*G+112*B Else C:=112*R-94*G-18*B;
      Inc(Sum,128+Shift8(C+128));
     End;
     Row^[X]:=(Sum+2) Div 4;
    End;
   End;
   WriteBytes(Row^,CW);
  End;
 End;
 {$ENDIF}
 For P:=0 To Count-1 Do Begin For Y:=0 To H-1 Do FreeMem(Planes[P]^[Y],W); Dispose(Planes[P]); End;
 Dispose(Row);
End;


Procedure WriteY4M;
Type
 TAARow=Array[0..12291] Of Byte; PAARow=^TAARow;
 TAARows=Array[0..4095] Of PAARow; PAARows=^TAARows;
Var T,Y,AAStride: Integer; V: PSample; Line,A,B,C,D: String; RN,RD,G,AARepeat,AAIndex:LongInt;
 AARows:PAARows; AAOutput:PAARow; IsAASC:Boolean;
{ Autodesk RLE: FFmpeg aasc.c/msrledec.c, LGPL-2.1-or-later.
  RLE commands count BYTES even for RGB555/BGR24. Previous rows persist. }
Procedure AAFrame(Sample:PSample);
Var At,Finish,Stride,Compression:LongInt;
 X,Y,N,V,J,RowSize,P,CW,CH,DX,DY,XX,YY:Integer;
 R,G,B,Sum,Value:LongInt; Ended:Boolean;
Function NextByte:Byte;
Begin If At>=Finish Then Fail('aasc: commande RLE tronquee.'); NextByte:=ByteAt(At); Inc(At); End;
Procedure Pixel(X,Y:Integer; Var R,G,B:LongInt);
Var A,V:Integer;
Begin
 A:=X*(Tracks^[T].BPDepth Div 8);
 Case Tracks^[T].BPDepth Of
  8:Begin V:=AARows^[Y]^[A]*4; B:=Tracks^[T].Config[V]; G:=Tracks^[T].Config[V+1]; R:=Tracks^[T].Config[V+2]; End;
  16:Begin
   V:=AARows^[Y]^[A]+(Integer(AARows^[Y]^[A+1] And 127) Shl 8);
   R:=(V Shr 10) And 31; G:=(V Shr 5) And 31; B:=V And 31;
   R:=(R Shl 3) Or (R Shr 2); G:=(G Shl 3) Or (G Shr 2); B:=(B Shl 3) Or (B Shr 2);
  End;
  24:Begin B:=AARows^[Y]^[A]; G:=AARows^[Y]^[A+1]; R:=AARows^[Y]^[A+2]; End;
 End;
End;
Function Shift8(V:LongInt):LongInt;
Begin If V>=0 Then Shift8:=V Div 256 Else Shift8:=-1-((-1-V) Div 256); End;
Begin
 At:=Sample^.Pos; Finish:=At+Sample^.Size;
 If Sample^.Size<4 Then Fail('aasc: trame trop courte.');
 With Tracks^[T] Do Begin
  RowSize:=Width*(BPDepth Div 8);
  If Codec='AASC' Then Begin Compression:=Number(At,True); Inc(At,4); End Else Compression:=1;
  If Compression=0 Then Begin
   { Autodesk raw stride, deliberately not the ordinary DIB stride. }
   Stride:=(LongInt(RowSize)+(BPDepth Div 8)) And Not LongInt(BPDepth Div 8);
   If Stride*Height>Finish-At Then Fail('aasc: image brute tronquee.');
   For Y:=Height-1 Downto 0 Do Begin ReadAt(At,AARows^[Y]^,RowSize); Inc(At,Stride); End;
  End Else If Compression=1 Then Begin
   X:=0; Y:=Height-1; Ended:=False;
   While At<Finish Do Begin
    N:=NextByte; V:=NextByte;
    If N<>0 Then Begin
     If (Y<0) Or (N>AAStride-X) Then Fail('aasc: repetition hors ligne.');
     For J:=1 To N Do Begin AARows^[Y]^[X]:=V; Inc(X); End;
    End Else If V=0 Then Begin
     Dec(Y); X:=0; If Y < -1 Then Fail('aasc: fin de ligne hors image.');
    End Else If V=1 Then Begin Ended:=True; Break; End
    Else If V=2 Then Begin
     N:=NextByte; J:=NextByte; Inc(X,N); Dec(Y,J);
     If (Y<0) Or (X>=AAStride) Then Fail('aasc: deplacement hors image.');
    End Else Begin
     N:=V; If (Y<0) Or (N>AAStride-X) Then Fail('aasc: sequence litterale hors ligne.');
     For J:=1 To N Do Begin AARows^[Y]^[X]:=NextByte; Inc(X); End;
     If Odd(N) Then V:=NextByte;
    End;
   End;
   If Not Ended Then Fail('aasc: marqueur de fin image absent.');
  End Else Fail('aasc: compression inconnue.');
  {$IFDEF TEST_AASC_RGB}
  For Y:=0 To Height-1 Do Begin
   For X:=0 To Width-1 Do Begin Pixel(X,Y,R,G,B); AAOutput^[X*3]:=R; AAOutput^[X*3+1]:=G; AAOutput^[X*3+2]:=B; End;
   WriteBytes(AAOutput^,Width*3);
  End;
  {$ELSE}
  For P:=0 To 2 Do Begin
   CW:=Width; CH:=Height; If P<>0 Then Begin CW:=(CW+1) Div 2; CH:=(CH+1) Div 2; End;
   For Y:=0 To CH-1 Do Begin
    For X:=0 To CW-1 Do Begin
     If P=0 Then Begin Pixel(X,Y,R,G,B); AAOutput^[X]:=16+((66*R+129*G+25*B+128) Div 256); End
     Else Begin
      Sum:=0;
      For DY:=0 To 1 Do For DX:=0 To 1 Do Begin
       XX:=X*2+DX; YY:=Y*2+DY; If XX>=Width Then XX:=Width-1; If YY>=Height Then YY:=Height-1;
       Pixel(XX,YY,R,G,B);
       If P=1 Then Value:=-38*R-74*G+112*B Else Value:=112*R-94*G-18*B;
       Inc(Sum,128+Shift8(Value+128));
      End;
      AAOutput^[X]:=(Sum+2) Div 4;
     End;
    End;
    WriteBytes(AAOutput^,CW);
   End;
  End;
  {$ENDIF}
 End;
End;
Begin
 AARows:=Nil; AAOutput:=Nil;
 If TrackCount<>1 Then Fail('FFV1: AVI avec une seule piste video requis.'); T:=1;
 With Tracks^[T] Do Begin
  IsAASC:=(Codec='AASC') Or (Codec='AAS4');
  If Not IsAASC And (Codec<>'8BPS') And (((Codec<>'FFV1') And (Codec<>'FLV1')) Or (ConfigSize<>0)) Then Fail('Y4M: FFV1 v0/1 ou FLV1 intra requis.');
  If (Width>4096) Or (Height>4096) Then Fail('Video: dimensions maximales 4096.');
  If IsAASC Then Begin
   If StartDelay<>0 Then Fail('aasc: retard initial non pris en charge.');
   AAStride:=(Width*(BPDepth Div 8)+3) And Not 3;
   {$IFNDEF FPC}
   If MemAvail<LongInt(AAStride)*Height+SizeOf(TAARows)+SizeOf(TAARow)+8192 Then Fail('aasc: memoire DOS insuffisante.');
   {$ENDIF}
   New(AARows); New(AAOutput);
   For Y:=0 To Height-1 Do Begin GetMem(AARows^[Y],AAStride); FillChar(AARows^[Y]^,AAStride,0); End;
  End;
  If Codec='8BPS' Then Begin
   If (First^.Duration<=0) Or (StartDelay<>0) Then Fail('8bps: cadence constante sans retard requise.');
   V:=First; While V<>Nil Do Begin
    If (V^.Duration<>First^.Duration) Or (V^.Composition<>0) Then Fail('8bps: cadence variable ou reordonnancement non pris en charge.'); V:=V^.Next;
   End;
  End;
  Str(Width,A); Str(Height,B);
  If Codec='8BPS' Then Begin RN:=Scale; RD:=First^.Duration; G:=RatioGCD(RN,RD); Str(RN Div G,C); Str(RD Div G,D); End
  Else Begin Str(InputScale,C); Str(DefaultDuration,D); End;
  Line:='YUV4MPEG2 W'+A+' H'+B+' F'+C+':'+D+' Ip A1:1 C420jpeg'+#10;
  If (AspectNum>0) Or ((Codec='8BPS') And (SARNum>0) And (SARDen>0)) Then Begin
   Str(SARNum,A); Str(SARDen,B);
   Line:=Copy(Line,1,Pos(' A1:1',Line))+'A'+A+':'+B+' C420jpeg'+#10;
  End;
  {$IFNDEF TEST_8BPS_RGBA}{$IFNDEF TEST_AASC_RGB}WriteBytes(Line[1],Length(Line));{$ENDIF}{$ENDIF} V:=First;
  While V<>Nil Do Begin
   AARepeat:=1;
   If IsAASC Then Begin
    AARepeat:=Round(V^.Duration*1.0*InputScale/(Scale*1.0*DefaultDuration));
    If (AARepeat<1) Or (Abs(V^.Duration-AARepeat*1.0*DefaultDuration*Scale/InputScale)>1.01) Then Fail('aasc: duree image incompatible avec la cadence AVI.');
   End;
   For AAIndex:=1 To AARepeat Do Begin
    Line:='FRAME'+#10; {$IFNDEF TEST_8BPS_RGBA}{$IFNDEF TEST_AASC_RGB}WriteBytes(Line[1],Length(Line));{$ENDIF}{$ENDIF}
    If IsAASC Then AAFrame(V) Else If Codec='8BPS' Then BPFrame(T,V) Else If Codec='FLV1' Then LVFrame(T,V,False) Else FFFrame(T,V,False);
   End;
   V:=V^.Next;
  End;
  If IsAASC Then Begin For Y:=0 To Height-1 Do FreeMem(AARows^[Y],AAStride); Dispose(AARows); Dispose(AAOutput); End;
 End;
End;

Procedure Packet(T: Integer; V: PSample);
Var
 At,B,E,D,A: LongInt;
 OldLE: Boolean;
Begin
 OldLE:=LE;
 If InKind='yuv4mpegpipe' Then Begin FFFrame(T,V,True); Exit; End;
 If (Tracks^[T].Codec='avc1') And (Tracks^[T].AnnexB<>(OutKind='avi')) Then Begin
  If Tracks^[T].AnnexB Then Begin
   At:=StartCode(V^.Pos,V^.Pos+V^.Size,B);
   If At<0 Then Fail('Paquet H264 AVI sans start code.');
   While At>=0 Do Begin
    E:=StartCode(B,V^.Pos+V^.Size,D); If E<0 Then E:=V^.Pos+V^.Size;
    If E<=B Then Fail('NAL H264 vide.');
    LE:=False; W32(E-B); CopyBytes(B,E-B);
    At:=StartCode(B,V^.Pos+V^.Size,B);
   End;
  End Else
  Begin
   If V^.Key Then WriteAVCInitialization(T);
   At:=V^.Pos; E:=At+V^.Size;
   While At<E Do Begin
    B:=0;
    For A:=1 To Tracks^[T].NALBytes Do Begin
     If At>=E Then Fail('Longueur NAL tronquee.');
     If B>8388607 Then Fail('NAL trop grand.'); B:=B*256+ByteAt(At); Inc(At);
    End;
    If (B=0) Or (B>E-At) Then Fail('NAL AVCC invalide.');
    LE:=False; W32(1); CopyBytes(At,B); Inc(At,B);
   End;
  End;
 End Else CopyBytes(V^.Pos,V^.Size);
 LE:=OldLE;
End;
{ MP4 classique: tables explicites, un paquet par chunk, moov final. }

Procedure Matrix;Begin
 W32($10000); W32(0); W32(0); W32(0); W32($10000); W32(0); W32(0); W32(0); W32($40000000);
End;

Procedure DescLength(N: LongInt);Begin
 W8($80 Or ((N Shr 21) And 127)); W8($80 Or ((N Shr 14) And 127));
 W8($80 Or ((N Shr 7) And 127)); W8(N And 127);
End;

Procedure ESD(T: Integer);
Var
 ObjectType: Byte;
Begin
 With Tracks^[T] Do Begin
  ObjectType:=$40;
  If Codec='mp4v' Then ObjectType:=$20 Else If Codec='.mp3' Then ObjectType:=$6B;
  StartBox('esds'); W32(0); W8(3); DescLength(3+5+13+5+ConfigSize+3);
  W16(T); W8(0); W8(4); DescLength(13+5+ConfigSize); W8(ObjectType);
  If Video Then W8($11) Else W8($15); Zero(3); W32(0); W32(0);
  W8(5); DescLength(ConfigSize); If ConfigSize>0 Then WriteBytes(Config,ConfigSize);
  W8(6); W8(1); W8(2); EndBox;
 End;
End;

Procedure WriteMPTrack(T: Integer);
Var
 V: PSample;
 Keys: LongInt;
 HasCTS: Boolean;
Begin
 With Tracks^[T] Do Begin
  StartBox('trak'); StartBox('tkhd'); W32(7); W32(0); W32(0); W32(T); W32(0);
  W32(Ticks((Duration-Skip+StartDelay)*1000.0/Scale)); Zero(8); W16(0); W16(0);
  If Video Then W16(0) Else W16(256); W16(0); Matrix;
  If Video And (AspectNum>0) Then W32(Ticks(Height*65536.0*AspectNum/AspectDen))
  Else W32(Width Shl 16);
  W32(Height Shl 16); EndBox;
  If (Skip>0) Or (StartDelay>0) Then Begin
   StartBox('edts'); StartBox('elst'); W32(0);
   If StartDelay>0 Then Begin
    W32(2); W32(Ticks(StartDelay*1000.0/Scale)); W32(-1); W16(1); W16(0);
   End Else W32(1);
   W32(Ticks((Duration-Skip)*1000.0/Scale)); W32(Skip); W16(1); W16(0); EndBox; EndBox;
  End;
  StartBox('mdia'); StartBox('mdhd'); W32(0); W32(0); W32(0); W32(Scale); W32(Duration);
  W16($55C4); W16(0); EndBox;
  StartBox('hdlr'); W32(0); W32(0); If Video Then WTag('vide') Else WTag('soun');
  Zero(12); W8(0); EndBox;
  StartBox('minf'); If Video Then Begin
   StartBox('vmhd'); W32(1); Zero(8); EndBox;
  End
   Else
  Begin
   StartBox('smhd'); W32(0); W32(0); EndBox;
  End;
  StartBox('dinf'); StartBox('dref'); W32(0); W32(1); StartBox('url '); W32(1); EndBox;
  EndBox; EndBox;
  StartBox('stbl'); StartBox('stsd'); W32(0); W32(1);
  If Codec='.mp3' Then StartBox('mp4a') Else StartBox(Codec);
  Zero(6); W16(1);
  If Video Then Begin
   Zero(16); W16(Width); W16(Height); W32($00480000); W32($00480000); W32(0); W16(1);
   Zero(32); W16(24); W16(65535);
  End Else
  Begin
   Zero(8); W16(Channels); W16(16); W32(0); W32(Rate Shl 16);
  End;
  If (Codec='avc1') Or (Codec='vp09') Or (Codec='Opus') Then Begin
   If Codec='avc1' Then StartBox('avcC') Else If Codec='vp09' Then StartBox('vpcC')
                   Else StartBox('dOps');
   WriteBytes(Config,ConfigSize); EndBox;
  End Else ESD(T);
  If Video And (SARNum>0) Then Begin
   StartBox('pasp'); W32(SARNum); W32(SARDen); EndBox;
  End;
  EndBox; EndBox;
  StartBox('stts'); W32(0); W32(Count); V:=First;
  While V<>Nil Do Begin
   W32(1); W32(V^.Duration); V:=V^.Next;
  End; EndBox;
  HasCTS:=False; Keys:=0; V:=First;
  While V<>Nil Do Begin
   If V^.Composition<>0 Then HasCTS:=True; If V^.Key Then Inc(Keys); V:=V^.Next;
  End;
  If HasCTS Then Begin
   StartBox('ctts'); W32($01000000); W32(Count); V:=First;
   While V<>Nil Do Begin
    W32(1); W32(V^.Composition); V:=V^.Next;
   End; EndBox;
  End;
  If Video Then Begin
   StartBox('stss'); W32(0); W32(Keys); V:=First; Keys:=0;
   While V<>Nil Do Begin
    Inc(Keys); If V^.Key Then W32(Keys); V:=V^.Next;
   End; EndBox;
  End;
  StartBox('stsc'); W32(0); W32(1); W32(1); W32(1); W32(1); EndBox;
  StartBox('stsz'); W32(0); W32(0); W32(Count); V:=First;
  While V<>Nil Do Begin
   W32(V^.OutputSize); V:=V^.Next;
  End; EndBox;
  StartBox('stco'); W32(0); W32(Count); V:=First;
  While V<>Nil Do Begin
   W32(V^.OutputPos); V:=V^.Next;
  End; EndBox;
  EndBox; EndBox; EndBox; EndBox;
 End;
End;

Procedure WriteMP4;
Var
 T: Integer;
 MovieDuration: LongInt;
Begin
 LE:=False; StartBox('ftyp'); WTag('isom'); W32(512); WTag('isom'); WTag('iso6');
 WTag('mp41'); EndBox;
 StartBox('mdat');
 For T:=1 To TrackCount Do Tracks^[T].Cursor:=Tracks^[T].First;
 Repeat
 Pick:=0; Best:=1E100;
 For T:=1 To TrackCount Do If Tracks^[T].Cursor<>Nil Then Begin
  Clock:=Tracks^[T].Cursor^.Time*1.0/Tracks^[T].Scale;
  If Clock<Best Then Begin
   Best:=Clock; Pick:=T;
  End;
 End;
 If Pick<>0 Then Begin
  S:=Tracks^[Pick].Cursor; S^.OutputPos:=OutPos; Packet(Pick,S);
  S^.OutputSize:=OutPos-S^.OutputPos;
  Tracks^[Pick].Cursor:=S^.Next;
 End;
 Until Pick=0;
 EndBox; StartBox('moov'); MovieDuration:=0;
 For T:=1 To TrackCount Do Begin
  P:=Ticks((Tracks^[T].Duration-Tracks^[T].Skip+Tracks^[T].StartDelay)*1000.0/
  Tracks^[T].Scale); If P>MovieDuration Then MovieDuration:=P;
 End;
 StartBox('mvhd'); W32(0); W32(0); W32(0); W32(1000); W32(MovieDuration);
 W32($10000); W16(256); Zero(10); Matrix; Zero(24); W32(TrackCount+1); EndBox;
 For T:=1 To TrackCount Do WriteMPTrack(T);
 If HasAlbum Or HasComment Then Begin
  StartBox('udta'); StartBox('meta'); W32(0);
  StartBox('hdlr'); W32(0); W32(0); WTag('mdir'); WTag('appl'); Zero(8); W8(0); EndBox;
  StartBox('ilst');
  If HasAlbum Then Begin
   StartBox(#169+'alb'); StartBox('data'); W32(1); W32(0);
   If AlbumUTF8Size>0 Then WriteBytes(AlbumUTF8,AlbumUTF8Size); EndBox; EndBox;
  End;
  If HasComment Then Begin
   StartBox(#169+'cmt'); StartBox('data'); W32(1); W32(0);
   If CommentUTF8Size>0 Then WriteBytes(CommentUTF8,CommentUTF8Size); EndBox; EndBox;
  End;
  EndBox; EndBox; EndBox;
 End;
 EndBox;
End;

Function ChunkTag(T: Integer): String;
Var
 Name: String[4];
Begin
 Name:='00dc'; Name[1]:=Chr(48+(T-1) Div 10); Name[2]:=Chr(48+(T-1) Mod 10);
 If Not Tracks^[T].Video Then Begin
  Name[3]:='w'; Name[4]:='b';
 End; ChunkTag:=Name;
End;
{ AVI n'a pas d'elst: appliquer l'intervalle media puis representer le retard
  par dwStart, a la precision d'un paquet/image. Pas de reencodage cache. }

Procedure ApplyMPEdits;
Var
 T,A,Version,Code: Integer;
 At,B,E,N,EntrySize,Media,Length,Lead,Offset,Step,Removed,Kept: LongInt;
 Seg,MediaValue,StartValue,EndValue,FirstDTS,Shift: Double;
 HaveMedia,Selected: Boolean;
 V,NextV,FirstKeep,LastKeep: PSample;

Function Read64(Position: LongInt; Signed: Boolean): Double;
Var
 High,Low: Double;
Begin
 High:=U32(Position,False); Low:=U32(Position+4,False);
 If Signed And (High>=2147483648.0) Then High:=High-4294967296.0;
 Read64:=High*4294967296.0+Low;
End;
Begin
 FirstDTS:=0;
 For T:=1 To TrackCount Do With Tracks^[T] Do Begin
  If EditAt<>0 Then Begin
   MPBox(EditAt,FileLimit,B,E); If E-B<8 Then Fail('elst tronquee.');
   Version:=ByteAt(B); If Version>1 Then Fail('Version elst inconnue.');
   N:=Number(B+4,False); EntrySize:=12; If Version=1 Then EntrySize:=20;
   If (N<1) Or (N>32) Or (N>(E-B-8) Div EntrySize) Then Fail('Liste elst incorrecte.');
   At:=B+8; Lead:=0; Media:=0; Length:=0; HaveMedia:=False;
   For A:=1 To N Do Begin
    If Version=0 Then Begin
     Seg:=U32(At,False); MediaValue:=Signed32(At+4); Code:=8;
    End
     Else
    Begin
     Seg:=Read64(At,False); MediaValue:=Read64(At+8,True); Code:=16;
    End;
    If (U16(At+Code,False)<>1) Or (U16(At+Code+2,False)<>0) Then Fail(
    'Montage MP4: seule la vitesse 1 est prise en charge.');
    If Seg<=0 Then Fail('Montage MP4 de duree nulle non pris en charge.');
    If MediaValue=-1 Then Begin
     If HaveMedia Then Fail(
     'Montage MP4: segment vide apres le media non pris en charge.');
     Lead:=Ticks(Lead*1.0+Seg*Scale/MovieScale);
    End Else
    Begin
     If (MediaValue<0) Or HaveMedia Then Fail(
     'Montage MP4: un seul intervalle media continu est pris en charge.');
     Media:=Ticks(MediaValue*Scale/InputScale); Length:=Ticks(Seg*Scale/MovieScale);
     HaveMedia:=True;
    End;
    Inc(At,EntrySize);
   End;
   If Not HaveMedia Then Fail('Montage MP4 sans intervalle media.');
   If OutKind='mp4' Then Begin
    Skip:=Media; StartDelay:=Lead; Duration:=Ticks(Media*1.0+Length);
    Continue;
   End;
   Offset:=Ticks(Lead*1.0-Media); EndValue:=Media*1.0+Length;
   FirstKeep:=Nil; LastKeep:=Nil; V:=First;
   While V<>Nil Do Begin
    StartValue:=V^.Time*1.0+V^.Composition;
    If Not Video And (V<>First) And (StartValue<Media) And (StartValue+V^.Duration>Media+
    1) Then     Fail('Debut montage MP4 au milieu dun paquet audio: reencodage requis.');
    If ((StartValue>=Media-1.0) Or (Not Video And (V=First) And (StartValue+V^.Duration>
    Media))) And
    (StartValue<EndValue-1.0) Then Begin
     If FirstKeep=Nil Then FirstKeep:=V; LastKeep:=V;
    End;
    V:=V^.Next;
   End;
   If FirstKeep=Nil Then Fail('Montage MP4 sans paquets dans intervalle demande.');
   If Not Video And (Media>First^.Time) Then Begin
    { AAC/MP3 peuvent dependre du preroll pour l'etat du decodeur. AVI ne
      peut pas cacher ces echantillons avec une edit list. Les conserver,
      puis decaler ensemble toutes les pistes; ne pas abimer le debut audio. }
    If Media>First^.Time+First^.Duration+1 Then     Fail(
    'Coupe audio MP4 au-dela de lamorcage: reencodage requis pour AVI.');
    FirstKeep:=First;
    If Not HideBanner Then WriteLn('AVI piste ',T,
    ': preroll audio conserve; origine commune ajustee.');
   End;
   If Video And Not FirstKeep^.Key Then Fail(
   'Debut montage video hors image cle: reencodage requis.');
   { Ne jamais enlever une reference necessaire aux B-frames conservees. }
   V:=FirstKeep;
   Repeat
   StartValue:=V^.Time*1.0+V^.Composition;
   If Video And ((StartValue<Media-1.0) Or (StartValue>=EndValue-1.0)) Then     Fail(
   'Coupe MP4 traversant des references B-frames: reencodage requis.');
   If V=LastKeep Then Break; V:=V^.Next;
   Until V=Nil;
   V:=First; Selected:=False; Kept:=0; Removed:=0;
   While V<>Nil Do Begin
    NextV:=V^.Next;
    If V=FirstKeep Then Selected:=True;
    If Selected Then Begin
     V^.Time:=Ticks(V^.Time*1.0+Offset); Inc(Kept);
    End
     Else
    Begin
     Dispose(V); Inc(Removed);
    End;
    If V=LastKeep Then Selected:=False;
    V:=NextV;
   End;
   First:=FirstKeep; Last:=LastKeep; Last^.Next:=Nil; Count:=Kept;
   If Not HideBanner Then WriteLn('Montage piste ',T,': ',Removed,
   ' paquet(s) retires, decalage applique.');
  End;
  If First^.Time*1.0/Scale<FirstDTS Then FirstDTS:=First^.Time*1.0/Scale;
 End;
 If OutKind='mp4' Then Exit;
 { Un decalage commun conserve l'alignement des pistes lorsque le decodeur
   video a besoin de paquets avant la premiere presentation. }
 Shift:=-FirstDTS;
 For T:=1 To TrackCount Do With Tracks^[T] Do Begin
  Step:=First^.Duration; If Step<=0 Then Fail('Duree de paquet AVI invalide.');
  V:=First;
  While V<>Nil Do Begin
   If (V^.Next<>Nil) And (Abs(V^.Duration-Step)>1) Then Fail(
   'AVI: cadence variable non prise en charge.');
   If (V^.Next=Nil) And (V^.Duration>Step+1) Then Fail(
   'AVI: derniere duree variable non prise en charge.');
   V:=V^.Next;
  End;
  AVIStep:=Step;
  StartValue:=First^.Time+Shift*Scale;
  HeaderStart:=Ticks(StartValue/Step);
  If HeaderStart<0 Then Fail('Origine AVI negative.');
  If (Abs(StartValue-HeaderStart*1.0*Step)>1) And Not HideBanner Then   WriteLn(
  'AVI piste ',T,': retard arrondi a la precision dun paquet.');
  V:=First; At:=Ticks(HeaderStart*1.0*Step);
  While V<>Nil Do Begin
   V^.Time:=At;
   If (V^.Next=Nil) And (V^.Duration<Step) And Not HideBanner Then    WriteLn(
   'AVI piste ',T,': fin arrondie au paquet complet (sans reencodage).');
   V^.Duration:=Step; At:=Ticks(At*1.0+Step); V:=V^.Next;
  End;
  Duration:=Ticks(Count*1.0*Step);
 End;
End;

Procedure WriteAVI;
Var
 T,VideoTrack: Integer;
 V: PSample;
 Delta,Divisor,AVIUnit,AVIRate: LongInt;

Function GCD(A,B: LongInt): LongInt;
Var
 C: LongInt;
Begin
 While B<>0 Do Begin
  C:=A Mod B; A:=B; B:=C;
 End; GCD:=A;
End;
Procedure RestoreAVIHolds;
Var T,J,N: Integer; V,NextV,Hold: PSample; Step: LongInt;
Begin
 For T:=1 To TrackCount Do With Tracks^[T] Do If Video Then Begin
  Step:=Ticks(DefaultDuration*1.0*Scale/InputScale);
  If Step<=0 Then Fail('AVI: cadence invalide.');
  V:=First;
  While V<>Nil Do Begin
   NextV:=V^.Next; Delta:=Ticks(V^.Duration*1.0/Step);
   If (Delta<1) Or (Delta>30000) Or (Abs(V^.Duration-Delta*1.0*Step)>1) Then
    Fail('AVI: duree non multiple de la cadence.');
   N:=Delta; V^.Duration:=Step;
   For J:=2 To N Do Begin
    New(Hold); FillChar(Hold^,SizeOf(TSample),0);
    Hold^.Pos:=V^.Pos; Hold^.Time:=Ticks(V^.Time*1.0+Step); Hold^.Duration:=Step;
    Hold^.Next:=NextV; V^.Next:=Hold; V:=Hold; Inc(Count);
   End;
   If NextV=Nil Then Last:=V;
   V:=NextV;
  End;
 End;
End;
Begin
 If InKind='avi' Then RestoreAVIHolds;
 VideoTrack:=0;
 For T:=1 To TrackCount Do With Tracks^[T] Do Begin
  If Video Then Begin
   If VideoTrack<>0 Then Fail('AVI: une seule piste video prise en charge.');
   VideoTrack:=T;
   If (Codec<>'avc1') And (Codec<>'mp4v') And (Codec<>'FFV1') Then Fail('AVI: codec video non pris en charge.');
  End Else If (Codec<>'mp4a') And (Codec<>'.mp3') Then Fail('AVI: AAC ou MP3 requis.');
  V:=First; Delta:=Ticks(Duration*1.0/Count);
  While V<>Nil Do Begin
   If Abs(V^.Duration-Delta)>1 Then Fail('AVI: cadence variable non prise en charge.');
   V:=V^.Next;
  End;
 End;
 If VideoTrack=0 Then Fail('Aucune piste video.');
 LE:=True; StartBox('RIFF'); WTag('AVI '); StartBox('LIST'); WTag('hdrl');
 StartBox('avih');
 With Tracks^[VideoTrack] Do Begin
  W32(Ticks(Duration*1000000.0/Scale/Count)); W32(0); W32(0); W32($10); W32(Count);
  W32(0);
  W32(TrackCount); W32(0); W32(Width); W32(Height); Zero(16);
 End; EndBox;
 For T:=1 To TrackCount Do With Tracks^[T] Do Begin
  StartBox('LIST'); WTag('strl'); StartBox('strh');
  If Video Then Begin
   WTag('vids'); If Codec='FFV1' Then WTag('FFV1') Else If Codec='avc1' Then WTag('H264') Else WTag('XVID');
  End Else
  Begin
   WTag('auds'); W32(0);
  End;
  Divisor:=GCD(Duration,Count); AVIUnit:=Duration Div Divisor;
  AVIRate:=Count Div Divisor; Divisor:=GCD(AVIUnit,Scale);
  AVIUnit:=AVIUnit Div Divisor; AVIRate:=Ticks(AVIRate*1.0*(Scale Div Divisor));
  W32(0); W16(0); W16(0); W32(0); W32(AVIUnit); W32(AVIRate); W32(HeaderStart);
  W32(Count);
  W32(0); W32(-1); W32(0); W16(0); W16(0); W16(Width); W16(Height); EndBox;
  StartBox('strf');
  If Video Then Begin
   W32(40); W32(Width); W32(Height); W16(1); W16(24);
   If Codec='FFV1' Then WTag('FFV1') Else If Codec='avc1' Then WTag('H264') Else WTag('XVID'); W32(0); Zero(16);
   If Codec='mp4v' Then WriteBytes(Config,ConfigSize) Else If Codec='avc1' Then WriteAVCInitialization(T);
  End Else
  Begin
   If Codec='mp4a' Then W16($FF) Else W16($55);
   W16(Channels); W32(Rate); W32(0); W16(0); W16(0);
   If Codec='mp4a' Then Begin
    W16(ConfigSize); WriteBytes(Config,ConfigSize);
   End Else W16(0);
  End;
  EndBox;
  If Video And (AspectNum>0) Then Begin
   If (AspectNum>65535) Or (AspectDen>65535) Then Fail('AVI: ratio limite a 65535:65535.');
   StartBox('vprp'); W32(0); W32(0); W32(Ticks(Scale*1.0*Count/Duration));
   W32(Width); W32(Height); W16(AspectDen); W16(AspectNum);
   W32(Width); W32(Height); W32(1);
   W32(Height); W32(Width); W32(Height); W32(Width); Zero(16); EndBox;
  End;
  EndBox;
 End;
 EndBox;
 If HasAlbum Then Begin
  StartBox('LIST'); WTag('INFO'); StartBox('IPRD');
  If AlbumUTF8Size>0 Then WriteBytes(AlbumUTF8,AlbumUTF8Size); W8(0);
  EndBox; EndBox;
 End;
 If HasComment Then Begin
  StartBox('LIST'); WTag('INFO'); StartBox('ICMT');
  If CommentUTF8Size>0 Then WriteBytes(CommentUTF8,CommentUTF8Size); W8(0);
  EndBox; EndBox;
 End;
 StartBox('LIST'); Movi:=OutPos; WTag('movi');
 For T:=1 To TrackCount Do Tracks^[T].Cursor:=Tracks^[T].First;
 Repeat
 Pick:=0; Best:=1E100;
 For T:=1 To TrackCount Do If Tracks^[T].Cursor<>Nil Then Begin
  Clock:=Tracks^[T].Cursor^.Time*1.0/Tracks^[T].Scale;
  If Clock<Best Then Begin
   Best:=Clock; Pick:=T;
  End;
 End;
 If Pick<>0 Then Begin
  V:=Tracks^[Pick].Cursor; V^.OutputPos:=OutPos; StartBox(ChunkTag(Pick)); P:=OutPos;
  Packet(Pick,V); V^.OutputSize:=OutPos-P; EndBox; Tracks^[Pick].Cursor:=V^.Next;
 End;
 Until Pick=0;
 EndBox; StartBox('idx1');
 { Index entries follow file order, not grouped by stream. }
 For T:=1 To TrackCount Do Tracks^[T].Cursor:=Tracks^[T].First;
 Repeat
 Pick:=0; P:=2147483647;
 For T:=1 To TrackCount Do If Tracks^[T].Cursor<>
 Nil Then   If Tracks^[T].Cursor^.OutputPos<P Then Begin
  P:=Tracks^[T].Cursor^.OutputPos; Pick:=T;
 End;
 If Pick<>0 Then Begin
  V:=Tracks^[Pick].Cursor; WTag(ChunkTag(Pick)); If V^.Key Then W32($10) Else W32(0);
  W32(V^.OutputPos-Movi); W32(V^.OutputSize); Tracks^[Pick].Cursor:=V^.Next;
 End;
 Until Pick=0;
 EndBox; EndBox;
End;

Procedure ReadM4V;
Var A,LastVOP,FrameStart,VOLAt,VOLEnd,VOLSize,J: LongInt; T: Integer; V: PSample;
Begin
 T:=AddTrack; Tracks^[T].Video:=True; Tracks^[T].Codec:='mp4v';
 A:=0; LastVOP:=-1; FrameStart:=0; VOLAt:=-1; VOLSize:=0;
 While A+4<FileLimit Do Begin
  If (ByteAt(A)=0) And (ByteAt(A+1)=0) And (ByteAt(A+2)=1) And
   (ByteAt(A+3)>=$20) And (ByteAt(A+3)<=$2F) Then Begin
   VOLEnd:=A+4;
   While VOLEnd+3<FileLimit Do Begin
    If (ByteAt(VOLEnd)=0) And (ByteAt(VOLEnd+1)=0) And (ByteAt(VOLEnd+2)=1) Then Break;
    Inc(VOLEnd);
   End;
   If VOLAt<0 Then Begin VOLAt:=A; VOLSize:=VOLEnd-A; End Else Begin
    If VOLEnd-A<>VOLSize Then Fail('M4V: changement de configuration VOL non pris en charge.');
    For J:=0 To VOLSize-1 Do If ByteAt(A+J)<>ByteAt(VOLAt+J) Then
     Fail('M4V: changement de configuration VOL non pris en charge.');
   End;
  End;
  If (ByteAt(A)=0) And (ByteAt(A+1)=0) And (ByteAt(A+2)=1) And (ByteAt(A+3)=$B6) Then Begin
   If LastVOP<0 Then ConfigFrom(T,0,A)
   Else V:=AddSample(T,FrameStart,A-FrameStart,Tracks^[T].Count,1,0,False);
   LastVOP:=A; FrameStart:=A;
  End;
  Inc(A);
 End;
 If LastVOP<0 Then Fail('M4V: aucune image VOP.');
 V:=AddSample(T,FrameStart,FileLimit-FrameStart,Tracks^[T].Count,1,0,False);
 ReconstructAVI(T);
End;

Procedure WriteM4V;
Var T,Selected: Integer; V: PSample;
Begin
 Selected:=0;
 For T:=1 To TrackCount Do If Tracks^[T].Video Then Begin
  If Selected<>0 Then Fail('M4V: plusieurs pistes video non prises en charge.');
  Selected:=T;
 End;
 If Selected=0 Then Fail('M4V: piste video absente.');
 With Tracks^[Selected] Do Begin
  If Codec<>'mp4v' Then Fail('M4V exige une piste MPEG-4 Part 2, sans reencodage.');
  If ConfigSize=0 Then Fail('M4V: configuration VOL absente.');
  WriteBytes(Config,ConfigSize); V:=First;
  While V<>Nil Do Begin CopyBytes(V^.Pos,V^.Size); V:=V^.Next; End;
 End;
End;

Procedure RemoveAudioTracks;
Var T,Keep: Integer; V,N: PSample;
Begin
 If Not NoAudio Then Exit;
 Keep:=0;
 For T:=1 To TrackCount Do Begin
  If Tracks^[T].Video Then Begin
   Inc(Keep); If Keep<>T Then Tracks^[Keep]:=Tracks^[T];
  End Else Begin
   V:=Tracks^[T].First;
   While V<>Nil Do Begin N:=V^.Next; Dispose(V); V:=N; End;
  End;
 End;
 TrackCount:=Keep;
 If Keep=0 Then Fail('-an: aucune piste video a ecrire.');
End;

Procedure PrepareTracks;
Var
 T,A,ConfigCode,Frames,N: Integer;
 V: PSample;
 Position,Finish,Payload: LongInt;
 Time,Origin: Double;
 SavedConfig: Array[0..31] Of Byte;
Begin
 If TrackCount=0 Then Fail('Aucune piste video/audio.');
 For T:=1 To TrackCount Do With Tracks^[T] Do Begin
  If First=Nil Then Fail('Piste vide non prise en charge.');
  If ((Codec='AASC') Or (Codec='AAS4')) And (OutKind<>'yuv4mpegpipe') Then Fail('aasc: decodage vers Y4M requis, pas de copie.');
  If (Codec='8BPS') And (OutKind<>'yuv4mpegpipe') Then Fail('8bps: decodage vers Y4M requis, pas de copie.');
  If Video Then Begin
   If (Width<1) Or (Height<1) Or (Width>32767) Or (Height>32767) Then Fail(
   'Dimensions video invalides.');
  End Else If (Channels<1) Or (Channels>2) Or (Rate<8000) Or (Rate>65535) Then Fail(
  'Audio mono/stereo 8..65 kHz requis.');
  If (Codec='avc1') And AnnexB Then AVCConfig(T,First);
  If (Codec='mp4v') And (ConfigSize=0) Then Begin
   Position:=First^.Pos; Finish:=Position+First^.Size; Payload:=Position;
   While (Payload+4<Finish) And Not ((ByteAt(Payload)=0) And (ByteAt(Payload+1)=0) And (
   ByteAt(Payload+2)=1) And (ByteAt(Payload+3)=$B6)) Do Inc(Payload);
   If Payload+4>=Finish Then Fail('Configuration MPEG-4 VOL absente.');
   ConfigFrom(T,Position,Payload-Position);
  End;
  If (Codec='mp4a') And (ConfigSize<2) Then Fail('Configuration AAC absente.');
  If (InKind='webm') And (Codec='vp09') Then Begin
   A:=ByteAt(First^.Pos);
   If (A And $FC)<>$80 Then Fail(
   'WebM VP9: premiere image cle visible, profil 0 requise.');
   If (ByteAt(First^.Pos+1)<>$49) Or (ByteAt(First^.Pos+2)<>$83) Or (ByteAt(First^.Pos+3)
   <>$42) Then Fail('Synchronisation VP9 incorrecte.');
   FillChar(Config,SizeOf(Config),0); ConfigSize:=12; Config[0]:=1; Config[4]:=0;
   Config[5]:=0;
   Config[6]:=$82 Or ((ByteAt(First^.Pos+4) Shr 4) And 1); Config[7]:=2; Config[8]:=2;
   Config[9]:=2;
   If ((ByteAt(First^.Pos+4) Shr 5) And 7)=7 Then Fail('VP9 RGB non pris en charge.');
  End;
  If (InKind='webm') And (Codec='Opus') Then Begin
   If (ConfigSize<>19) Or (Config[18]<>0) Or (Config[9]<>Channels) Then Fail(
   'OpusHead mono/stereo mapping 0 requis.');
   For A:=0 To 18 Do SavedConfig[A]:=Config[A];
   If (Config[0]<>79) Or (Config[1]<>112) Or (Config[2]<>117) Or (Config[3]<>115)
   Then Fail('OpusHead absent.');
   Skip:=LongInt(Config[10])+LongInt(Config[11])*256;
   If Delay<>Skip Then Fail('CodecDelay WebM incompatible avec OpusHead.');
   ConfigSize:=11; Config[0]:=0; Config[1]:=Channels;
   Config[2]:=SavedConfig[11]; Config[3]:=SavedConfig[10];
   Config[4]:=SavedConfig[15]; Config[5]:=SavedConfig[14]; Config[6]:=SavedConfig[13];
   Config[7]:=SavedConfig[12];
   Config[8]:=SavedConfig[17]; Config[9]:=SavedConfig[16]; Config[10]:=0;
  End;
  V:=First; Time:=0; Origin:=First^.Time;
  If InKind='avi' Then StartDelay:=Ticks(Origin);
  While V<>Nil Do Begin
   If InKind='avi' Then V^.Time:=V^.Time-Ticks(Origin);
   If InKind='webm' Then Begin
    V^.Time:=V^.Time-Ticks(Origin);
    If Codec='Opus' Then Begin
     A:=ByteAt(V^.Pos); ConfigCode:=A Shr 3; Frames:=1;
     Case (A And 3) Of 1,2: Frames:=2; 3:
     Begin
      If V^.Size<2 Then Fail('Paquet Opus tronque.'); Frames:=ByteAt(V^.Pos+1) And 63;
     End;
    End;
    If ConfigCode>=16 Then N:=120 Shl (ConfigCode And 3) Else
    If ConfigCode>=12 Then N:=480 Shl (ConfigCode And 1) Else
    If (ConfigCode And 3)=3 Then N:=2880 Else N:=480 Shl (ConfigCode And 3);
    If (Frames=0) Or (LongInt(N)*Frames>5760) Then Fail('Duree Opus invalide.');
    If Abs(V^.Time-Time)>96 Then Fail(
    'Discontinuite temporelle Opus non prise en charge.');
    V^.Duration:=LongInt(N)*Frames; V^.Time:=Ticks(Time); V^.Key:=True;
    If V^.Next=Nil Then Begin
     If LastTrim>=V^.Duration Then Fail('DiscardPadding Opus excessif.');
     Dec(V^.Duration,LastTrim);
    End;
   End Else
   Begin
    If V^.Next<>Nil Then V^.Duration:=V^.Next^.Time-Ticks(Origin)-V^.Time;
    If V^.Duration<=0 Then Begin
     If DefaultDuration>0 Then V^.Duration:=DefaultDuration Else Fail(
     'Duree derniere image WebM inconnue (DefaultDuration/BlockDuration requis).');
    End;
   End;
  End;
  If (InKind='avi') And Not Video Then V^.Key:=True;
  If (V^.Time<0) Or (V^.Duration<=0) Then Fail('Chronologie video/audio invalide.');
  If Abs(V^.Time-Time)>2 Then Fail('Chronologie avec decalage/trou non prise en charge.');
  Time:=V^.Time*1.0+V^.Duration; V:=V^.Next;
 End;
 Duration:=Ticks(Time);
 If (InKind='avi') And Video And (Codec<>'FFV1') And (Codec<>'AASC') And (Codec<>'AAS4') Then ReconstructAVI(T);
 If (Codec='FFV1') And (InKind<>'yuv4mpegpipe') And (OutKind<>'yuv4mpegpipe') Then
  Fail('FFV1: sortie Y4M requise pour le decodage.');
End;
End;
Begin
