  End Else If WaveFormatTag(InputPath)=$45 Then Begin
   Temps[0]:=NewTemporary; DecodeG726(InputPath,Temps[0],False,4,8000);
    Intermediate:=Temps[0];
  End Else If WaveFormatTag(InputPath)=$594A Then Begin
   Temps[0]:=NewTemporary; DecodeXanWav(InputPath,Temps[0]); Intermediate:=
    Temps[0];
  End Else If WaveFormatTag(InputPath)=$401 Then Begin
   Temps[0]:=NewTemporary; DecodeIMC(InputPath,Temps[0]); Intermediate:=Temps[
    0];
  End Else If
 WaveFormatTag(InputPath)=$270 Then Begin
  Temps[0]:=NewTemporary; DecodeATRAC3(InputPath,Temps[0]); Intermediate:=Temps[
   0];
 End Else If (WaveFormatTag(InputPath)=$61) Or (WaveFormatTag(InputPath)=$62) Or
 (WaveFormatTag(InputPath)=$11) Or (WaveFormatTag(InputPath)=$02) Or (
  WaveFormatTag(
 InputPath)=$20) Then Begin
  Temps[0]:=NewTemporary; DecodeWaveBlocks(InputPath,Temps[0]); Intermediate:=
   Temps[0];
 End;
 If
PcmCodecOut<>'' Then Begin
   If (RequestedRate<>0) Or (RequestedChannels<>0) Then Begin
    Temps[1]:=NewTemporary; SwrWantFmt:=SwrFmtOfCodec(PcmCodecOut);
    If Not SwrNormalize(Intermediate,Temps[1],False) Then Begin
     SwrWantFmt:=1;
     Temps[3]:=NewTemporary; PcmEncodeFile(Intermediate,Temps[3],'wav',
      'pcm_s16le');
     NormalizeWave(Temps[3],Temps[1],False);
    End;
    SwrWantFmt:=1; Intermediate:=Temps[1];
   End;
   PcmEncodeFile(Intermediate,Temps[2],OutputFormat,PcmCodecOut);
  End Else
  If
 (OutputFormat='wav') And (AudioCodec='adpcm_ima_wav') Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
  EncodeWaveBlocks(Temps[1],Temps[2],0);
 End Else If (OutputFormat='wav') And (AudioCodec='adpcm_ms') Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
  EncodeWaveBlocks(Temps[1],Temps[2],1);
 End Else If (
(OutputFormat='wav') Or (OutputFormat='avi')) And ((AudioCodec='sonic') Or (
 AudioCodec='sonicls')) Then Begin
   If Not LJUnofficial Then Fail('Codec '+AudioCodec+
    ' is experimental but experimental codecs are not enabled, add -strict -2 '+
    'if you want to use it.');
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   EncodeSonic(Temps[1],Temps[2],AudioCodec='sonicls',0,OutputFormat='avi');
  End Else If (
OutputFormat='wav') And (AudioCodec='adpcm_yamaha') Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
  EncodeWaveYamaha(Temps[1],Temps[2]);
 End Else If OutputFormat='mp4' Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
  EncodeALACM4A(Temps[1],Temps[2]);
 End Else If OutputFormat='flv' Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
   If AudioCodec='nellymoser' Then EncodeNellyFLV(Temps[1],Temps[2]) Else

  EncodeFLVSWF(Temps[1],Temps[2]);
 End Else If
(OutputFormat='flac') Then F1FlacFromWav(Intermediate,Temps[2]) { F1 }
   Else If OutputFormat='tta' Then F1TtaFromWav(Intermediate,Temps[2])
   Else If OutputFormat='wsaud' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
     F1MuxWsaud(Temps[1],Temps[2]);
   End
   Else If OutputFormat='mmf' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False); Temps[
     3]:=NewTemporary;
    EncodeWaveYamaha(Temps[1],Temps[3]); F1MuxMMF(Temps[3],Temps[2]);
   End
   Else If (OutputFormat='wav') And F1WavMulti(Intermediate) Then PcmEncodeFile(
    Intermediate,Temps[2],'wav','pcm_s16le')
   Else If
 OutputFormat='wav' Then NormalizeWave(Intermediate,Temps[2],False) Else
 If OutputFormat=
'roq' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    EncodeRoQDpcm(Temps[1],Temps[2]);
   End
   Else If OutputFormat=
'adx' Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
  EncodeADX(Temps[1],Temps[2]);
 End
 Else If OutputFormat='aiff' Then Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
  EncodeIMAQT(Temps[1],Temps[2]);
 End
 Else If
(OutputFormat='asf') Or (OutputFormat='avi') Then Begin
    Temps[1]:=NewTemporary; SwrWantFmt:=3; NormalizeWave(Intermediate,Temps[1],
     False); SwrWantFmt:=1;
    If Not HasBitrate Then RequestedBitRateK:=128;
    If AudioCodec='wmav1' Then EncodeWMAFile(Temps[1],Temps[2],1,
     RequestedBitRateK*1000,Ord(OutputFormat='avi')) Else EncodeWMAFile(Temps[
     1],Temps[2],2,RequestedBitRateK*1000,Ord(OutputFormat='avi'));
   End
   Else If
 OutputFormat='ac3' Then Begin
  Temps[1]:=NewTemporary;
    F1A3Ok:=F1Ac3Info(Intermediate,F1A3Rate,F1A3Ch,F1A3Mask);
    If F1A3Ok Then Begin
     F1A3OC:=F1A3Ch; If RequestedChannels<>0 Then F1A3OC:=RequestedChannels;
     If (F1A3OC=F1A3Ch) And (F1A3Mask<>0) And (SwrBitCount(F1A3Mask)=F1A3Ch)
      Then F1A3OM:=F1A3Mask Else F1A3OM:=F1Ac3DefMask(F1A3OC);
     F1A3Ok:=(F1A3OC>=1) And (F1A3OC<=6) And F1Ac3MaskOk(F1A3OM);
    End;
    If F1A3Ok Then Begin
     F1A3Old:=RequestedRate;
     If RequestedRate=0 Then RequestedRate:=F1Ac3PickRate(F1A3Rate);
     SwrWantFmt:=3; NormalizeWave(Intermediate,Temps[1],False); SwrWantFmt:=1;
      RequestedRate:=F1A3Old;
     F1Ac3FromWav(Temps[1],Temps[2],Ord(HasBitrate)*RequestedBitRateK,F1A3OM,0);
    End Else Begin
     If NonStdBitrate Then Fail(
      'Debit audio normalise requis: MP3 32..320k ou AC3 32..640k.');
 NormalizeWave(Intermediate,Temps[1],False);
  If Not HasBitrate Then RequestedBitRateK:=192;
  ProcessAC3(Temps[1],Temps[2],True,RequestedBitRateK);
 End
;
   End
   Else If OutputFormat='eac3' Then Begin
    Temps[1]:=NewTemporary;
    F1A3Ok:=F1Ac3Info(Intermediate,F1A3Rate,F1A3Ch,F1A3Mask);
    If F1A3Ok Then Begin
     F1A3OC:=F1A3Ch; If RequestedChannels<>0 Then F1A3OC:=RequestedChannels;
     If (F1A3OC=F1A3Ch) And (F1A3Mask<>0) And (SwrBitCount(F1A3Mask)=F1A3Ch)
      Then F1A3OM:=F1A3Mask Else F1A3OM:=F1Ac3DefMask(F1A3OC);
     F1A3Ok:=(F1A3OC>=1) And (F1A3OC<=6) And F1Ac3MaskOk(F1A3OM);
    End;
    If Not F1A3Ok Then Fail(
     'eac3: disposition des canaux non prise en charge.');
    F1A3Old:=RequestedRate;
    If RequestedRate=0 Then RequestedRate:=F1Ac3PickRate(F1A3Rate);
    SwrWantFmt:=3; NormalizeWave(Intermediate,Temps[1],False); SwrWantFmt:=1;
     RequestedRate:=F1A3Old;
    F1Ac3FromWav(Temps[1],Temps[2],Ord(HasBitrate)*RequestedBitRateK,F1A3OM,1);
   End
   Else If OutputFormat='ogg' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    If AudioCodec='vorbis' Then VGEncodeFile(Temps[1],Temps[2]) Else
    If HasBitrate Then EncodeVorbis(Temps[1],Temps[2],RequestedBitRateK) Else
     EncodeVorbis(Temps[1],Temps[2],0);
   End
   Else If OutputFormat='aac' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    If HasBitrate Then AEEncodeAAC(Temps[1],Temps[2],RequestedBitRateK) Else
     AEEncodeAAC(Temps[1],Temps[2],0);
   End Else If OutputFormat='mp2' Then Begin
    Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],False);
    If HasBitrate Then EncodeMP2(Temps[1],Temps[2],RequestedBitRateK) Else
     EncodeMP2(Temps[1],Temps[2],0);
   End
 Else
 Begin
  Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],True);
  EncodeMP3(Temps[1],Temps[2],RequestedBitRateK);
 End;
End;
Commit(Temps[2]); Temps[2]:='';
WriteLn('Sortie creee: ',OutputPath);
END.
