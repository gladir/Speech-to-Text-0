Procedure CASPredVert(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St: LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=T^[1+X];
End;

Procedure CASPredHoriz(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St: LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=L^[1+Y];
End;

Procedure CASPredDc128(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St: LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=128;
End;

Procedure CASPredPlane(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St: LongInt);
Var
 X,Y,Ia,Ih,Iv: LongInt;
Begin
 Ih:=0; Iv:=0;
 For X:=0 To 3 Do Begin
  Inc(Ih,(X+1)*(T^[5+X]-T^[3-X]));
  Inc(Iv,(X+1)*(L^[5+X]-L^[3-X]));
 End;
 Ia:=(T^[8]+L^[8]) Shl 4;
 Ih:=AVSar(17*Ih+16,5); Iv:=AVSar(17*Iv+16,5);
 For Y:=0 To 7 Do
 For X:=0 To 7 Do  D^[Dof+Y*St+X]:=CASClip8(AVSar(Ia+(X-3)*Ih+(Y-3)*Iv+16,5));
End;

Function CASLp(A: PEABuffer; I: LongInt): LongInt;Begin
 CASLp:=(A^[I-1]+2*A^[I]+A^[I+1]+2) Shr 2;
End;

Procedure CASPredLp(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St: LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=(CASLp(T,X+1)+CASLp(L,Y+1)) Shr 1;
End;

Procedure CASPredDownLeft(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St:
 LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=(CASLp(T,X+Y+2)+CASLp(L,X+Y+2)) Shr 1;
End;

Procedure CASPredDownRight(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St:
 LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do  If X=Y Then D^[Dof+Y*St+X]:=(L^[1]+2*T^[0]+T^[1]+2) Shr 2
  Else
 If X>Y Then D^[Dof+Y*St+X]:=CASLp(T,X-Y)
        Else D^[Dof+Y*St+X]:=CASLp(L,Y-X);
End;

Procedure CASPredLpLeft(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St:
 LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=CASLp(L,Y+1);
End;

Procedure CASPredLpTop(D: PEABuffer; Dof: LongInt; T,L: PEABuffer; St: LongInt);
Var
 X,Y: LongInt;
Begin
 For Y:=0 To 7 Do
 For X:=0 To 7 Do D^[Dof+Y*St+X]:=CASLp(T,X+1);
End;

Procedure CASIntraL(Mode: LongInt; D: PEABuffer; Dof: LongInt; T,L: PEABuffer;
                    St: LongInt);Begin
 Case Mode Of
 0: CASPredVert(D,Dof,T,L,St); 1: CASPredHoriz(D,Dof,T,L,St); 2: CASPredLp(D,
  Dof,T,L,St);
 3: CASPredDownLeft(D,Dof,T,L,St);
 4: CASPredDownRight(D,Dof,T,L,St); 5: CASPredLpLeft(D,Dof,T,L,St);
 6: CASPredLpTop(D,Dof,T,L,St); Else CASPredDc128(D,Dof,T,L,St);
End;
End;

Procedure CASIntraC(Mode: LongInt; D: PEABuffer; Dof: LongInt; T,L: PEABuffer;
                    St: LongInt);Begin
 Case Mode Of
 0: CASPredLp(D,Dof,T,L,St); 1: CASPredHoriz(D,Dof,T,L,St); 2: CASPredVert(D,
  Dof,T,L,St);
 3: CASPredPlane(D,Dof,T,L,St);
 4: CASPredLpLeft(D,Dof,T,L,St); 5: CASPredLpTop(D,Dof,T,L,St);
 Else CASPredDc128(D,Dof,T,L,St);
End;
End;
