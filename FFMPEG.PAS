  ModeID,First,FullFrame,IsWide,CountLost,FrameSize,SubSize,NbSub,LpcSize,
   LastPitch,SubmodeID,VocOffset: LongInt;
  LastOlGain,LastPitchGain,VocM1,VocM2,VocMean: Single; Seed: LongWord;
