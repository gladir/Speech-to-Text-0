Type
 TDCI32=Array[0..4000000] Of LongInt;
 PDCI32=^TDCI32;
 TDCF=Array[0..1048575] Of Single;
 PDCF=^TDCF;

Const
 DCStride=516;
 { 4 echantillons d'historique ADPCM + 512 }
 DCCbSel: Array[0..9] Of Byte=(1,2,2,2,2,3,3,3,3,3);
 DCCbGrp: Array[0..9] Of Byte=(1,3,3,3,3,7,7,7,7,7);
 DCCbSize: Array[0..9] Of Byte=(3,5,7,9,13,17,25,33,65,129);
 DCCbOff: Array[0..9] Of ShortInt=(-1,-2,-3,-4,-6,-8,-12,-16,-32,-64);
 DCRates: Array[0..15] Of LongInt=(0,8000,16000,32000,0,0,11025,22050,44100,0,0,
  12000,
 24000,48000,96000,192000);
 DCBlockBits: Array[0..6] Of Byte=(7,10,12,13,15,17,19);
 DCPrmSpk: Array[0..9,0..4] Of ShortInt=((0,-1,-1,-1,-1),(1,2,-1,-1,-1),(1,2,-1,
  -1,-1),(1,
 2,-1,-1,-1),(1,2,-1,-1,-1),(0,1,2,-1,-1),(1,2,6,-1,-1),(0,1,2,6,-1),(1,2,3,4,-
  1),(0,1,2,
 3,4));
 { masque haut-parleurs DCA par mode: C=1 L=2 R=4 Ls=8 Rs=16 LFE=32 Cs=64 }
