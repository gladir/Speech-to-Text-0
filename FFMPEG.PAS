  Case I Of 0: S:=27; 1: S:=25; 2: S:=7; 3: S:=9; 4: S:=15; 5: S:=31; Else S:=
   63; End;
  Case I Of 2: Q:=-3; 3: Q:=-4; 4: Q:=-7; 5: Q:=-15; 6: Q:=-31; Else Q:=0; End;
  For J:=0 To 1 Do Begin
   MPCBuild7(3+I*2+J,MPC7Quant,Off,S,Q);
   Inc(Off,2*S);
  End;
 End;
