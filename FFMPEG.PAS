 QXFcc: String[4]; QXPos,QXLen: PALLong; QXPal: Array[0..255] Of LongWord;
  QXHasPal,QXIsMov,QXGray,QXNeg: Boolean;

Function QXB32(At: LongInt): LongInt;
Begin QXB32:=EAByte(QXF,QXSize,At)*16777216+EAByte(QXF,QXSize,At+1)*65536+
 EAByte(QXF,QXSize,At+2)*256+EAByte(QXF,QXSize,At+3); End;
Function QXB16(At: LongInt): LongInt;
Begin QXB16:=EAByte(QXF,QXSize,At)*256+EAByte(QXF,QXSize,At+1); End;
Function QXT4(At: LongInt): String;
Var S4: String[4]; Z: Integer;
Begin S4:=''; For Z:=0 To 3 Do S4:=S4+Chr(EAByte(QXF,QXSize,At+Z)); QXT4:=S4;
 End;
Function QXFind(Start,Finish: LongInt; Const Name: String; Var APos,ASize:
 LongInt): Boolean;
Var P,Sz: LongInt;
Begin
 QXFind:=False; P:=Start;
 If Finish>QXSize Then Finish:=QXSize;
 While Finish-P>=8 Do Begin
  Sz:=QXB32(P);
  If Sz=0 Then Sz:=Finish-P;
  If (Sz<8) Or (Sz>Finish-P) Then Exit;
  If QXT4(P+4)=Name Then Begin APos:=P; ASize:=Sz; QXFind:=True; Exit; End;
  Inc(P,Sz);
 End;
End;

{ libavformat/qtpalette.c : EntryPos = debut de l'entree stsd video }
Procedure QXQtPalette(EntryPos,EntrySize: LongInt);
Var Tmp,BitDepth,Ctid,I,CS,CE,Cnt,Idx,At: LongInt; Grey: Boolean;
Begin
 Tmp:=QXB16(EntryPos+82); BitDepth:=Tmp And $1F; Grey:=(Tmp And $20)<>0; Ctid:=
  QXB16(EntryPos+84);
 If Not (BitDepth In [1,2,4,8]) Then Exit;
 Cnt:=1 Shl BitDepth;
 If Grey And (BitDepth>1) And (Ctid<>0) Then Begin
  Idx:=255;
  For I:=0 To Cnt-1 Do Begin
   QXPal[I]:=$FF000000 Or (LongWord(Idx) Shl 16) Or (LongWord(Idx) Shl 8) Or
    LongWord(Idx);
   Dec(Idx,256 Div (Cnt-1)); If Idx<0 Then Idx:=0;
  End;
  QXHasPal:=True; QXGray:=True;
 End Else If Ctid<>0 Then Begin
  For I:=0 To Cnt-1 Do Begin
   Case BitDepth Of
    1: Idx:=QXPal2[I*3]*65536+QXPal2[I*3+1]*256+QXPal2[I*3+2];
    2: Idx:=QXPal4[I*3]*65536+QXPal4[I*3+1]*256+QXPal4[I*3+2];
    4: Idx:=QXPal16[I*3]*65536+QXPal16[I*3+1]*256+QXPal16[I*3+2];
    Else Idx:=QXPal256[I*3]*65536+QXPal256[I*3+1]*256+QXPal256[I*3+2];
   End;
   QXPal[I]:=$FF000000 Or LongWord(Idx);
  End;
  QXHasPal:=True;
 End Else Begin
  CS:=QXB32(EntryPos+86); CE:=QXB16(EntryPos+86+6);
  If (CS<=255) And (CE<=255) Then Begin
   At:=EntryPos+86+8;
   For I:=CS To CE Do Begin
    QXPal[I]:=$FF000000 Or (LongWord(EAByte(QXF,QXSize,At+2)) Shl 16) Or (
     LongWord(EAByte(QXF,QXSize,At+4)) Shl 8) Or LongWord(EAByte(QXF,QXSize,At+
     6));
    Inc(At,8);
   End;
   QXHasPal:=True;
  End;
 End;
End;

Procedure QXOpenMov;
Var
 MoovPos,MoovSize,P,TrakPos,TrakSize,MdiaPos,MdiaSize,HdlrPos,HdlrSize,MinfPos,
  MinfSize,StblPos,StblSize,StsdPos,StsdSize,MdhdPos,MdhdSize: LongInt;
 SzPos,SzSize,ScPos,ScSize,CoPos,CoSize,SttsPos,SttsSize,FixedSize,Samples,
  Entries,Chunks,Ts,Delta,Chunk,Sample,PerChunk,J,K,I,Pos,EntryPos,EntrySize,Q,
  Q2,TsOff: LongInt;
 Tbl: PALLong; Is64,Found: Boolean;
Begin
 If Not QXFind(0,QXSize,'moov',MoovPos,MoovSize) Then Fail(
  'mov: atome moov absent.');
 P:=MoovPos+8; Found:=False;
 While QXFind(P,MoovPos+MoovSize,'trak',TrakPos,TrakSize) Do Begin
  If QXFind(TrakPos+8,TrakPos+TrakSize,'mdia',MdiaPos,MdiaSize) Then
   If QXFind(MdiaPos+8,MdiaPos+MdiaSize,'hdlr',HdlrPos,HdlrSize) And (QXT4(
    HdlrPos+16)='vide') Then
    If QXFind(MdiaPos+8,MdiaPos+MdiaSize,'minf',MinfPos,MinfSize) Then
     If QXFind(MinfPos+8,MinfPos+MinfSize,'stbl',StblPos,StblSize) Then
      If QXFind(StblPos+8,StblPos+StblSize,'stsd',StsdPos,StsdSize) Then Begin
       Found:=True; Break; End;
  P:=TrakPos+TrakSize;
 End;
 If Not Found Then Fail('mov: aucune piste video.');
 EntryPos:=StsdPos+16; EntrySize:=QXB32(EntryPos);
 If EntrySize<86 Then Fail('mov: description video trop courte.');
 QXFcc:=QXT4(EntryPos+4);
 QXW:=QXB16(EntryPos+32); QXH:=QXB16(EntryPos+34); QXDepth:=QXB16(EntryPos+82);
 QXHasPal:=False; QXGray:=False;
 QXQtPalette(EntryPos,EntrySize);
 If QXHasPal Then QXDepth:=QXDepth And $1F;
 QXExtPos:=EntryPos+86;
 If (QXB16(EntryPos+84)=0) And ((QXB16(EntryPos+82) And $1F) In [1,2,4,8]) And (
  QXB16(EntryPos+92)>=QXB32(EntryPos+86)) Then Inc(QXExtPos,8+(QXB16(EntryPos+
  92)-QXB32(EntryPos+86)+1)*8);
 QXExtLen:=EntryPos+EntrySize-QXExtPos; If QXExtLen<0 Then QXExtLen:=0;
 { pasp : rapport d'aspect des pixels }
 QXSarN:=0; QXSarD:=1;
 Q:=QXExtPos;
 While Q+8<=EntryPos+EntrySize Do Begin
  Q2:=QXB32(Q); If Q2<8 Then Break;
  If QXT4(Q+4)='pasp' Then Begin QXSarN:=QXB32(Q+8); QXSarD:=QXB32(Q+12); NVGcd(
   QXSarN,QXSarD); Break; End;
  Inc(Q,Q2);
 End;
 If Not QXFind(MdiaPos+8,MdiaPos+MdiaSize,'mdhd',MdhdPos,MdhdSize) Then Fail(
  'mov: mdhd absent.');
 If EAByte(QXF,QXSize,MdhdPos+8)=1 Then TsOff:=28 Else TsOff:=20;
 Ts:=QXB32(MdhdPos+TsOff);
 If Not QXFind(StblPos+8,StblPos+StblSize,'stsz',SzPos,SzSize) Then Fail(
  'mov: stsz absent.');
 If Not QXFind(StblPos+8,StblPos+StblSize,'stsc',ScPos,ScSize) Then Fail(
  'mov: stsc absent.');
 If Not QXFind(StblPos+8,StblPos+StblSize,'stts',SttsPos,SttsSize) Then Fail(
  'mov: stts absent.');
 Is64:=False;
 If Not QXFind(StblPos+8,StblPos+StblSize,'stco',CoPos,CoSize) Then Begin
  If Not QXFind(StblPos+8,StblPos+StblSize,'co64',CoPos,CoSize) Then Fail(
   'mov: stco absent.');
  Is64:=True;
 End;
 Delta:=QXB32(SttsPos+20); If Ts<=0 Then Fail('mov: cadence incorrecte.');
 If Delta<=0 Then Delta:=1;
 QXRn:=Ts; QXRd:=Delta; NVGcd(QXRn,QXRd);
 FixedSize:=QXB32(SzPos+12); Samples:=QXB32(SzPos+16);
 If (Samples<=0) Or (Samples>16777216) Then Fail(
  'mov: nombre d''echantillons incorrect.');
 GetMem(QXPos,Samples*4); GetMem(QXLen,Samples*4);
 Entries:=QXB32(ScPos+12); If (Entries<1) Or (Entries>1048576) Then Fail(
  'mov: stsc incorrect.');
 GetMem(Tbl,Entries*8);
 For I:=0 To Entries-1 Do Begin Tbl^[2*I]:=QXB32(ScPos+16+12*I); Tbl^[2*I+1]:=
  QXB32(ScPos+20+12*I); End;
 Chunks:=QXB32(CoPos+12);
 Sample:=0; K:=0;
 For Chunk:=1 To Chunks Do Begin
  While (K+1<Entries) And (Tbl^[2*(K+1)]<=Chunk) Do Inc(K);
  PerChunk:=Tbl^[2*K+1];
  If Is64 Then Pos:=QXB32(CoPos+16+8*(Chunk-1)+4) Else Pos:=QXB32(CoPos+16+4*(
   Chunk-1));
  For J:=1 To PerChunk Do Begin
   If Sample>=Samples Then Break;
   If FixedSize<>0 Then QXLen^[Sample]:=FixedSize Else QXLen^[Sample]:=QXB32(
    SzPos+20+4*Sample);
   QXPos^[Sample]:=Pos; Inc(Pos,QXLen^[Sample]); Inc(Sample);
  End;
 End;
 FreeMem(Tbl,Entries*8);
 QXCount:=Sample;
 If QXCount<1 Then Fail('mov: aucun echantillon video.');
End;

Procedure QXOpenAvi(Const Source: String);
Var Pos,PkPos,PkLen,N,I,Q,Pass: LongInt;
Begin
 AXWatchPC:=False;
 AXScan(Source);
 QXF:=AXF; QXSize:=AXSize; QXIsMov:=False;
 QXW:=AXW; QXH:=AXH; QXDepth:=AXBits; QXFcc:=AXFcc; QXExtPos:=AXExtra;
  QXExtLen:=AXExtraLen;
 QXRn:=AXRate; QXRd:=AXScale; NVGcd(QXRn,QXRd);
 QXHasPal:=False; QXGray:=False; QXSarN:=0; QXSarD:=1; QXNeg:=AXNegH;
 FillChar(QXPal,SizeOf(QXPal),0);
 If (QXDepth<=8) And (QXExtLen>0) Then Begin
  N:=(4 Shl QXDepth); If N>QXExtLen Then N:=QXExtLen;
  Q:=QXExtPos+QXExtLen-N;
  If (Q-QXExtPos>=9) And (QXT4(QXExtPos+QXExtLen-9)='Bott') Then Dec(Q,9);
  For I:=0 To (N Div 4)-1 Do If I<256 Then QXPal[I]:=$FF000000 Or LongWord(
   NVRL32(QXF,QXSize,Q+4*I) And $FFFFFF);
  QXHasPal:=True;
 End;
 QXCount:=0;
 For Pass:=0 To 1 Do Begin
  Pos:=AXMovie; N:=0;
  While AXNext(Pos,PkPos,PkLen) Do Begin
   If Pass=1 Then Begin QXPos^[N]:=PkPos; QXLen^[N]:=PkLen; End;
   Inc(N);
  End;
  If Pass=0 Then Begin
   If N<1 Then Fail('avi: aucun chunk video.');
   GetMem(QXPos,N*4); GetMem(QXLen,N*4); QXCount:=N;
  End;
 End;
End;

{ ouvre un fichier MOV/MP4 ou AVI et prepare la liste des paquets video }
Procedure QXOpen(Const Source: String);
Begin
 FillChar(QXPal,SizeOf(QXPal),0);
 NVVN:=0; NVVD:=0;
 NVLoad(Source,QXF,QXSize);
 If (QXT4(0)='RIFF') And (QXT4(8)='AVI ') Then Begin FreeMem(QXF,QXSize+64);
  QXOpenAvi(Source); Exit; End;
 QXIsMov:=True; QXOpenMov;
End;

Procedure QXClose;
Begin
 FreeMem(QXPos,QXCount*4); FreeMem(QXLen,QXCount*4);
End;


Function QXFccKind(Const F: String): LongInt;
Begin
 QXFccKind:=0;
 If F='rle ' Then QXFccKind:=59
 Else If F='rpza' Then QXFccKind:=60
 Else If F='SNOW' Then QXFccKind:=1601
 Else If F='smc ' Then QXFccKind:=61
 Else If F='qdrw' Then QXFccKind:=62
 Else If (F='QPEG') Or (F='Q1.0') Or (F='Q1.1') Then QXFccKind:=63
 Else If F='theo' Then QXFccKind:=172
 Else If (F='SVQ1') Or (F='svq1') Or (F='svqi') Then QXFccKind:=160
 Else If F='SVQ3' Then QXFccKind:=161
 Else If (F='raw ') Or (F=#0#0#0#0) Or (F='I420') Or (F='IYUV') Or (F='YV12') Or
  (F='Y800') Or (F='GREY') Then QXFccKind:=64;
End;

{ fichier MOV/MP4 : fourcc de la premiere piste video, via lecture directe du
 fichier }
Function QXMovKind(Const Name: String): LongInt;
Var
 MoovPos,MoovSize,P,TrakPos,TrakSize,MdiaPos,MdiaSize,HdlrPos,HdlrSize,MinfPos,
  MinfSize,StblPos,StblSize,StsdPos,StsdSize: LongInt;
Begin
 QXMovKind:=0;
 OpenRead(Name);
 If MP4Find(0,InputSize,'moov',MoovPos,MoovSize) Then Begin
  P:=MoovPos+8;
  While MP4Find(P,MoovPos+MoovSize,'trak',TrakPos,TrakSize) Do Begin
   If MP4Find(TrakPos+8,TrakPos+TrakSize,'mdia',MdiaPos,MdiaSize) Then
    If MP4Find(MdiaPos+8,MdiaPos+MdiaSize,'hdlr',HdlrPos,HdlrSize) And (MP4Tag(
     HdlrPos+16)='vide') Then
     If MP4Find(MdiaPos+8,MdiaPos+MdiaSize,'minf',MinfPos,MinfSize) Then
      If MP4Find(MinfPos+8,MinfPos+MinfSize,'stbl',StblPos,StblSize) Then
       If MP4Find(StblPos+8,StblPos+StblSize,'stsd',StsdPos,StsdSize) Then Begin
        If StsdSize>=24 Then QXMovKind:=QXFccKind(MP4Tag(StsdPos+20));
        Break;
       End;
   P:=TrakPos+TrakSize;
  End;
 End;
 CloseRead;
End;

{ ---- QuickTime Animation (libavcodec/qtrle.c) : MOV / AVI ---- }
Procedure DecodeQTRLE(Const Source,Target: String; Mode: LongInt);
Var
 Fr,Out,Pk: PEABuffer; Fmt,Bpp,Bits,Stride,I,J,K,Sz,PIdx,Hdr,StartLine,Height,
  RowPtr,Need,Plen: LongInt;
 Sp: LongInt; Dup,Begun,Bad: Boolean;
Function GB: LongInt;
Begin If Sp<Sz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function GB16: LongInt;
Var A: LongInt;
Begin A:=GB; GB16:=A*256+GB; End;
Function GS: LongInt;
Var A: LongInt;
Begin A:=GB; If A>127 Then A:=A-256; GS:=A; End;
Function Left: LongInt;
Var Q0: LongInt;
Begin Q0:=Sz-Sp; If Q0<0 Then Q0:=0; Left:=Q0; End;
{ verifie pixel_ptr+n dans [0, limite] ; sinon abandon de l'image }
Function Chk(Pp,N: LongInt): Boolean;
Begin
 Chk:=True;
 If (Pp+N>Stride*QXH) Or (Pp+N<0) Then Begin Bad:=True; Chk:=False; End;
End;
Procedure Put8(Pp,V: LongInt);Begin Fr^[Pp]:=V; End;
Procedure Dec1(RowPtr0,Lines: LongInt);
Var Rc,Pp,RowP,Skip,X,Pi0,Pi1,N: LongInt;
Begin
 RowP:=RowPtr0-Stride; Pp:=RowP; Inc(Lines);
 While Lines<>0 Do Begin
  Skip:=GB; Rc:=GS;
  If Rc=0 Then Break;
  If (Skip And $80)<>0 Then Begin Dec(Lines); Inc(RowP,Stride); Pp:=RowP+16*(
   Skip And $7F); End
  Else Inc(Pp,16*Skip);
  If Not Chk(Pp,0) Then Exit;
  If Rc=-1 Then Continue;
  If Rc<0 Then Begin
   Rc:=-Rc; Pi0:=GB; Pi1:=GB;
   If Not Chk(Pp,Rc*16) Then Exit;
   While Rc>0 Do Begin
    For N:=7 Downto 0 Do Begin Fr^[Pp]:=(Pi0 Shr N) And 1; Inc(Pp); End;
    For N:=7 Downto 0 Do Begin Fr^[Pp]:=(Pi1 Shr N) And 1; Inc(Pp); End;
    Dec(Rc);
   End;
  End Else Begin
   Rc:=Rc*2;
   If Not Chk(Pp,Rc*8) Then Exit;
   While Rc>0 Do Begin
    X:=GB;
    For N:=7 Downto 0 Do Begin Fr^[Pp]:=(X Shr N) And 1; Inc(Pp); End;
    Dec(Rc);
   End;
  End;
 End;
End;
Procedure Dec24(RowPtr0,Lines,B: LongInt);
Var Rc,Pp,RowP,Np,Z,N,Nb,V: LongInt; Pi: Array[0..15] Of Byte;
Begin
 RowP:=RowPtr0;
 If B=4 Then Np:=8 Else Np:=16;
 While Lines>0 Do Begin
  Dec(Lines);
  Pp:=RowP+Np*(GB-1);
  If Not Chk(Pp,0) Then Exit;
  Rc:=GS;
  While Rc<>-1 Do Begin
   If Left<1 Then Exit;
   If Rc=0 Then Begin
    Pp:=Pp+Np*(GB-1);
    If Not Chk(Pp,0) Then Exit;
   End Else If Rc<0 Then Begin
    Rc:=-Rc;
    For Z:=Np-1 Downto 0 Do Begin
     V:=0; If Sp<Sz Then V:=Pk^[Sp];
     Pi[Np-1-Z]:=(V Shr ((Z*B) And 7)) And ((1 Shl B)-1);
     If (Z And ((Np Shr 2)-1))=0 Then Inc(Sp);
    End;
    If Not Chk(Pp,Rc*Np) Then Exit;
    While Rc>0 Do Begin Move(Pi,Fr^[Pp],Np); Inc(Pp,Np); Dec(Rc); End;
   End Else Begin
    Rc:=Rc*4;
    If Not Chk(Pp,Rc*(Np Shr 2)) Then Exit;
    While Rc>0 Do Begin
     V:=GB;
     If B=4 Then Begin Fr^[Pp]:=(V Shr 4) And 15; Fr^[Pp+1]:=V And 15; Inc(Pp,
      2); End
     Else Begin Fr^[Pp]:=(V Shr 6) And 3; Fr^[Pp+1]:=(V Shr 4) And 3; Fr^[Pp+
      2]:=(V Shr 2) And 3; Fr^[Pp+3]:=V And 3; Inc(Pp,4); End;
     Dec(Rc);
    End;
   End;
   Rc:=GS;
  End;
  Inc(RowP,Stride);
 End;
End;
Procedure Dec8(RowPtr0,Lines: LongInt);
Var Rc,Pp,RowP,Z,P1,P2,P3,P4: LongInt;
Begin
 RowP:=RowPtr0;
 While Lines>0 Do Begin
  Dec(Lines);
  Pp:=RowP+4*(GB-1);
  If Not Chk(Pp,0) Then Exit;
  Rc:=GS;
  While Rc<>-1 Do Begin
   If Left<1 Then Exit;
   If Rc=0 Then Begin Pp:=Pp+4*(GB-1); If Not Chk(Pp,0) Then Exit; End
   Else If Rc<0 Then Begin
    Rc:=-Rc; P1:=GB; P2:=GB; P3:=GB; P4:=GB;
    If Not Chk(Pp,Rc*4) Then Exit;
    While Rc>0 Do Begin Fr^[Pp]:=P1; Fr^[Pp+1]:=P2; Fr^[Pp+2]:=P3; Fr^[Pp+3]:=
     P4; Inc(Pp,4); Dec(Rc); End;
   End Else Begin
    Rc:=Rc*4;
    If Not Chk(Pp,Rc) Then Exit;
    For Z:=0 To Rc-1 Do Fr^[Pp+Z]:=GB;
    Inc(Pp,Rc);
   End;
   Rc:=GS;
  End;
  Inc(RowP,Stride);
 End;
End;
Procedure Dec16(RowPtr0,Lines: LongInt);
Var Rc,Pp,RowP,V: LongInt;
Begin
 RowP:=RowPtr0;
 While Lines>0 Do Begin
  Dec(Lines);
  Pp:=RowP+(GB-1)*2;
  If Not Chk(Pp,0) Then Exit;
  Rc:=GS;
  While Rc<>-1 Do Begin
   If Left<1 Then Exit;
   If Rc=0 Then Begin Pp:=Pp+(GB-1)*2; If Not Chk(Pp,0) Then Exit; End
   Else If Rc<0 Then Begin
    Rc:=-Rc; V:=GB16;
    If Not Chk(Pp,Rc*2) Then Exit;
    While Rc>0 Do Begin Fr^[Pp]:=V And 255; Fr^[Pp+1]:=V Shr 8; Inc(Pp,2); Dec(
     Rc); End;
   End Else Begin
    If Not Chk(Pp,Rc*2) Then Exit;
    While Rc>0 Do Begin V:=GB16; Fr^[Pp]:=V And 255; Fr^[Pp+1]:=V Shr 8; Inc(Pp,
     2); Dec(Rc); End;
   End;
   Rc:=GS;
  End;
  Inc(RowP,Stride);
 End;
End;
Procedure Dec24b(RowPtr0,Lines,B: LongInt);
Var Rc,Pp,RowP,Z,V1,V2,V3,V4: LongInt;
Begin
 RowP:=RowPtr0;
 While Lines>0 Do Begin
  Dec(Lines);
  Pp:=RowP+(GB-1)*B;
  If Not Chk(Pp,0) Then Exit;
  Rc:=GS;
  While Rc<>-1 Do Begin
   If Left<1 Then Exit;
   If Rc=0 Then Begin Pp:=Pp+(GB-1)*B; If Not Chk(Pp,0) Then Exit; End
   Else If Rc<0 Then Begin
    Rc:=-Rc; V1:=GB; V2:=GB; V3:=GB; If B=4 Then V4:=GB Else V4:=0;
    If Not Chk(Pp,Rc*B) Then Exit;
    While Rc>0 Do Begin
     Fr^[Pp]:=V1; Fr^[Pp+1]:=V2; Fr^[Pp+2]:=V3; If B=4 Then Fr^[Pp+3]:=V4;
     Inc(Pp,B); Dec(Rc);
    End;
   End Else Begin
    If Not Chk(Pp,Rc*B) Then Exit;
    While Rc>0 Do Begin
     For Z:=0 To B-1 Do Fr^[Pp+Z]:=GB;
     Inc(Pp,B); Dec(Rc);
    End;
   End;
   Rc:=GS;
  End;
  Inc(RowP,Stride);
 End;
End;
Begin
 QXOpen(Source);
 Bits:=QXDepth;
 If Bits In [33,34,36,40] Then Dec(Bits,32);
 Case Bits Of
  1,2,4,8: Begin Fmt:=0; Bpp:=1; End;
  16: Begin Fmt:=2; Bpp:=2; End;
  24: Begin Fmt:=9; Bpp:=3; End;
  32: Begin Fmt:=3; Bpp:=4; End;
  Else Begin Fmt:=0; Bpp:=1; Fail('qtrle: profondeur non prise en charge.');
   End;
 End;
 If (QXW<1) Or (QXH<1) Or (QXW>16000) Or (QXH>16000) Then Fail(
  'qtrle: dimensions invalides.');
 If Fmt=0 Then Begin
  If Not QXHasPal Then Begin
   { 8 bits sans table : palette par defaut Macintosh via QXQtPalette n'a rien
    trouve ; ffmpeg laisse le tableau a zero }
  End;
  For I:=0 To 255 Do Begin NVPalR[I]:=(QXPal[I] Shr 16) And 255; NVPalG[I]:=(
   QXPal[I] Shr 8) And 255; NVPalB[I]:=QXPal[I] And 255; End;
 End;
 Stride:=QXW*Bpp;
 NVBegin(Mode,Target,QXW,QXH,Fmt,QXRn,QXRd);
 If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End Else
  NVSarN:=0;
 If Not QXIsMov Then NVAviSar(QXW,QXH);
 NVHasAlpha:=Fmt=3;
 GetMem(Fr,Stride*QXH+64); FillChar(Fr^,Stride*QXH+64,0);
 GetMem(Out,QXW*QXH*Bpp+64);
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]); Sp:=0; Dup:=False; Bad:=False;
  If Sz<8 Then Dup:=True
  Else Begin
   Sp:=4;
   Hdr:=GB16;
   If (Hdr And 8)<>0 Then Begin
    If Sz<14 Then Dup:=True
    Else Begin
     StartLine:=GB16; Inc(Sp,2); Height:=GB16; Inc(Sp,2);
     If Height>QXH-StartLine Then Dup:=True;
    End;
   End Else Begin StartLine:=0; Height:=QXH; End;
  End;
  If Not Dup Then Begin
   RowPtr:=Stride*StartLine;
   Case Bits Of
    1: Dec1(RowPtr,Height);
    2: Dec24(RowPtr,Height,2);
    4: Dec24(RowPtr,Height,4);
    8: Dec8(RowPtr,Height);
    16: Dec16(RowPtr,Height);
    24: Dec24b(RowPtr,Height,3);
    32: Dec24b(RowPtr,Height,4);
   End;
  End;
  If Fmt=3 Then Begin
   For I:=0 To QXW*QXH-1 Do Begin
    Out^[I*4]:=Fr^[I*4+3]; Out^[I*4+1]:=Fr^[I*4+2]; Out^[I*4+2]:=Fr^[I*4+1];
     Out^[I*4+3]:=Fr^[I*4];
   End;
  End Else Move(Fr^,Out^,Stride*QXH);
  NVEmit(Out);
  If NVDone Then Break;
 End;
 FreeMem(Out,QXW*QXH*Bpp+64); FreeMem(Fr,Stride*QXH+64); QXClose;
 NVFinish('qtrle');
End;


{ ---- Encodeur QuickTime Animation (libavcodec/qtrleenc.c) + muxeur MOV
 (libavformat/movenc.c) depuis Y4M ---- }
Procedure EncodeQTRLE(Const Source,Target: String);
Const
 MaxBulk=127; MaxRepeat=128; MaxSkip=254;
Var
 Limit,Cur,At,Q,W,Hh,CW,CH,K,Code,X,Y,Frame,NFrames,PixSize,LogW,PixFmtKind,Gop,
  LenAll,I,J,TS,Delta,MDur,MvDur,SarN,SarD,FpsN,FpsD,Moov,MdatSize,ChunkOff,
  Keys,SzUni: LongInt;
 Line,Token: String; H: Array[0..255] Of Byte;
 Yp,Up,Vp,Cu,Pv,Enc,Fr,FrPrev: PEABuffer; EncCap,EncLen: LongInt;
 FSizes,FKeys: PALLong; KeyFrame: Boolean; RleCode,LenTab: PALLong; SkipTab:
  PEABuffer;
 Tab: Array[0..2047] Of Byte; Crv,Cbu,Cgu,Cgv,Cy,Oy,Yb: Int64; Yoffs,Ix,Cn:
  LongInt;
 Rg,Gg,Bg,Yv,Uv,Vv: LongInt; Gv: Int64;
 QTW: Int64; QParOk: Boolean; QG2: LongInt;
 Mv: PEABuffer; MvLen: LongInt; Stack: Array[0..15] Of LongInt; Sp: LongInt;
Function Clip(V: LongInt): LongInt;Begin If V<0 Then Clip:=0 Else If V>255 Then
 Clip:=255 Else Clip:=V; End;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-((-V+(Int64(1) Shl N)-1) Shr N); End;
Procedure EPut(V: LongInt);
Begin
 If EncLen>=EncCap Then Begin Inc(EncCap,EncCap Div 2+65536); ReAllocMem(Enc,
  EncCap); End;
 Enc^[EncLen]:=V And 255; Inc(EncLen);
End;
Procedure EPut16(V: LongInt);Begin EPut(V Shr 8); EPut(V); End;
Procedure EPut32(V: LongInt);Begin EPut(V Shr 24); EPut(V Shr 16); EPut(V Shr
 8); EPut(V); End;
{ --- ecriture MOV --- }
Procedure MPut(V: LongInt);Begin Mv^[MvLen]:=V And 255; Inc(MvLen); End;
Procedure M16(V: LongInt);Begin MPut(V Shr 8); MPut(V); End;
Procedure M32(V: LongInt);Begin MPut(V Shr 24); MPut(V Shr 16); MPut(V Shr 8);
 MPut(V); End;
Procedure MTag(Const S: String);Var Z: Integer;Begin For Z:=1 To Length(S) Do
 MPut(Ord(S[Z])); End;
Procedure MZero(N: LongInt);Var Z: Integer;Begin For Z:=1 To N Do MPut(0); End;
Procedure BoxBegin(Const Tg: String);Begin Stack[Sp]:=MvLen; Inc(Sp); M32(0);
 MTag(Tg); End;
Procedure BoxEnd;
Var P0,Sz: LongInt;
Begin
 Dec(Sp); P0:=Stack[Sp]; Sz:=MvLen-P0;
 Mv^[P0]:=Sz Shr 24; Mv^[P0+1]:=Sz Shr 16; Mv^[P0+2]:=Sz Shr 8; Mv^[P0+3]:=Sz;
End;
Procedure Matrix;Begin M32($10000); M32(0); M32(0); M32(0); M32($10000); M32(0);
 M32(0); M32(0); M32($40000000); End;
Function RescaleUp(A,B,C: Int64): Int64;
Begin RescaleUp:=(A*B+C-1) Div C; End;
{ ligne qtrle_encode_line }
Procedure EncodeLine(Line0: LongInt);
Var
 Width,Ii,RC,SkipCount,RepeatCount,TotalSkip,TotalRepeat,BaseBulk,LowBulk,
  LowIdx,SecBulk,SecIdx,PrevBulk,Z: LongInt;
 TL,PL: LongInt; SameSkip,SameRep: Boolean;
Function Cmp(A,B,N: LongInt; Const PA,PB: PEABuffer): Boolean;
Var Zz: LongInt;
Begin Cmp:=True; For Zz:=0 To N-1 Do If PA^[A+Zz]<>PB^[B+Zz] Then Begin Cmp:=
 False; Exit; End; End;
Begin
 Width:=LogW;
 TL:=Line0*LogW*PixSize+Width*PixSize; PL:=TL;
 LenTab^[Width]:=0; SkipCount:=0; RepeatCount:=1;
 LowBulk:=MaxLongInt Div 2; LowIdx:=Width; SecBulk:=MaxLongInt Div 2; SecIdx:=
  Width;
 BaseBulk:=1+PixSize;
 For Ii:=Width-1 Downto 0 Do Begin
  Dec(TL,PixSize); Dec(PL,PixSize);
  Z:=Width; If Ii+MaxBulk<Z Then Z:=Ii+MaxBulk;
  If Z<LowIdx Then Begin
   LowBulk:=SecBulk; LowIdx:=SecIdx; SecBulk:=MaxLongInt Div 2; SecIdx:=Width;
  End;
  If Ii=0 Then Begin Inc(BaseBulk); Inc(LowBulk); Inc(SecBulk); End;
  PrevBulk:=LenTab^[Ii+1]+BaseBulk;
  If PrevBulk<=SecBulk Then Begin
   If PrevBulk<=LowBulk Then Begin SecBulk:=MaxLongInt Div 2; LowBulk:=PrevBulk;
    LowIdx:=Ii+1; End
   Else Begin SecBulk:=PrevBulk; SecIdx:=Ii+1; End;
  End;
  If Not KeyFrame And Cmp(TL,PL,PixSize,Fr,FrPrev) Then Begin SkipCount:=
   SkipCount+1; If SkipCount>MaxSkip Then SkipCount:=MaxSkip; End
  Else SkipCount:=0;
  TotalSkip:=LenTab^[Ii+SkipCount]+2;
  SkipTab^[Ii]:=SkipCount;
  If (Ii<Width-1) And Cmp(TL,TL+PixSize,PixSize,Fr,Fr) Then Begin RepeatCount:=
   RepeatCount+1; If RepeatCount>MaxRepeat Then RepeatCount:=MaxRepeat; End
  Else RepeatCount:=1;
  TotalRepeat:=LenTab^[Ii+RepeatCount]+1+PixSize;
  If Ii=0 Then Begin Dec(TotalSkip); Inc(TotalRepeat); End;
  If (RepeatCount>1) And ((SkipCount=0) Or (TotalRepeat<TotalSkip)) Then Begin
   LenTab^[Ii]:=TotalRepeat; RleCode^[Ii]:=-RepeatCount; End
  Else If SkipCount>0 Then Begin LenTab^[Ii]:=TotalSkip; RleCode^[Ii]:=0; End
  Else Begin LenTab^[Ii]:=LowBulk; RleCode^[Ii]:=LowIdx-Ii; End;
  Inc(LowBulk,PixSize); Inc(SecBulk,PixSize);
 End;
 Ii:=0; TL:=Line0*LogW*PixSize;
 If RleCode^[0]=0 Then Begin EPut(SkipTab^[0]+1); Inc(Ii,SkipTab^[0]); End Else
  EPut(1);
 While Ii<Width Do Begin
  RC:=RleCode^[Ii];
  EPut(RC);
  If RC=0 Then Begin EPut(SkipTab^[Ii]+1); Inc(Ii,SkipTab^[Ii]); End
  Else If RC>0 Then Begin
   For Z:=0 To RC*PixSize-1 Do
    If PixFmtKind=2 Then EPut(Fr^[TL+Ii*PixSize+Z] Xor $FF) Else EPut(Fr^[TL+Ii*
     PixSize+Z]);
   Inc(Ii,RC);
  End Else Begin
   For Z:=0 To PixSize-1 Do
    If PixFmtKind=2 Then EPut(Fr^[TL+Ii*PixSize+Z] Xor $FF) Else EPut(Fr^[TL+Ii*
     PixSize+Z]);
   Dec(Ii,RC);
  End;
 End;
 EPut(255);
End;
Procedure EncodeFrame;
Var StartLine,EndLine,Sz0,LineSize,Ln,Sz: LongInt; Same: Boolean;
Begin
 StartLine:=0; EndLine:=Hh; Sz0:=EncLen;
 If Not KeyFrame Then Begin
  LineSize:=LogW*PixSize;
  StartLine:=0;
  While StartLine<Hh Do Begin
   Same:=True; For Ln:=0 To LineSize-1 Do If Fr^[StartLine*LineSize+
    Ln]<>FrPrev^[StartLine*LineSize+Ln] Then Begin Same:=False; Break; End;
   If Not Same Then Break;
   Inc(StartLine);
  End;
  EndLine:=Hh;
  While EndLine>StartLine Do Begin
   Same:=True; For Ln:=0 To LineSize-1 Do If Fr^[(EndLine-1)*LineSize+
    Ln]<>FrPrev^[(EndLine-1)*LineSize+Ln] Then Begin Same:=False; Break; End;
   If Not Same Then Break;
   Dec(EndLine);
  End;
 End;
 EPut32(0);
 If ((StartLine=0) And (EndLine=Hh)) Or (StartLine=Hh) Then EPut16(0)
 Else Begin EPut16(8); EPut16(StartLine); EPut16(0); EPut16(EndLine-StartLine);
  EPut16(0); End;
 For Ln:=StartLine To EndLine-1 Do EncodeLine(Ln);
 EPut(0);
 Sz:=EncLen-Sz0;
 Enc^[Sz0]:=Sz Shr 24; Enc^[Sz0+1]:=Sz Shr 16; Enc^[Sz0+2]:=Sz Shr 8; Enc^[Sz0+
  3]:=Sz;
End;
Begin
 { tables yuv2rgb.c }
 Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16;
 Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279;
 Crv:=((Crv Shl 16)+$8000) Div Cy; Cbu:=((Cbu Shl 16)+$8000) Div Cy;
 Cgu:=(Int64(-25675)*65536+$8000) Div Cy; Cgv:=(Int64(-53279)*65536+$8000) Div
  Cy;
 Yoffs:=326+512; Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For Ix:=0 To 2047 Do Begin Tab[Ix]:=Clip(Sar(Yb+$8000,16)); Yb:=Yb+Cy; End;
 OpenRead(Source); Limit:=InputSize; Cur:=0; Line:='';
 While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break; If
  Length(Line)<250 Then Line:=Line+Chr(H[0]); End;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('qtrle: entree Y4M requise.');
 W:=0; Hh:=0; FpsN:=25; FpsD:=1; SarN:=0; SarD:=1; Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),Hh,Code);
   'F': Begin K:=Pos(':',Token); Val(Copy(Token,2,K-2),FpsN,Code); Val(Copy(
    Token,K+1,20),FpsD,Code); End;
   'A': Begin K:=Pos(':',Token); Val(Copy(Token,2,K-2),SarN,Code); Val(Copy(
    Token,K+1,20),SarD,Code); End;
   'C': If (Token<>'C420') And (Token<>'C420jpeg') And (Token<>'C420mpeg2') And
    (Token<>'C420paldv') Then Fail('qtrle: Y4M YUV420 8 bits requis.');
  End;
 End;
 If (W<1) Or (Hh<1) Or (W>16000) Or (Hh>16000) Then Fail(
  'qtrle: dimensions Y4M incorrectes.');
 If (FpsN<1) Or (FpsD<1) Then Fail('qtrle: cadence invalide.');
 If OptPixFmt='gray' Then PixFmtKind:=2 Else If OptPixFmt='argb' Then
  PixFmtKind:=1 Else If (OptPixFmt='') Or (OptPixFmt='yuv420p') Or (
  OptPixFmt='rgb24') Then PixFmtKind:=0
 Else Begin PixFmtKind:=0; Fail('qtrle: -pix_fmt rgb24, argb ou gray requis.');
  End;
 Case PixFmtKind Of 0: PixSize:=3; 1: PixSize:=4; Else PixSize:=4; End;
 If PixFmtKind=2 Then Begin
  If W Mod 4<>0 Then Fail('qtrle: largeur multiple de 4 requise en gris.');
  LogW:=W Div 4;
 End Else LogW:=W;
 CW:=(W+1) Div 2; CH:=(Hh+1) Div 2;
 GetMem(Yp,W*Hh+16); GetMem(Up,CW*CH+16); GetMem(Vp,CW*CH+16);
 GetMem(Fr,LogW*PixSize*Hh+16); GetMem(FrPrev,LogW*PixSize*Hh+16);
 GetMem(RleCode,(LogW+2)*4); GetMem(LenTab,(LogW+2)*4); GetMem(SkipTab,LogW+16);
 EncCap:=65536; EncLen:=0; GetMem(Enc,EncCap);
 GetMem(FSizes,4*100000); GetMem(FKeys,4*100000);
 NFrames:=0;
 While Cur+6+W*Hh+2*CW*CH<=Limit Do Begin
  ReadAt(Cur,H,5); If (H[0]<>70) Or (H[1]<>82) Then Break;
  Inc(Cur,5); While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10
   Then Break; End;
  At:=0; While At<W*Hh Do Begin If W*Hh-At>60000 Then Q:=60000 Else Q:=W*Hh-At;
   ReadAt(Cur+At,Yp^[At],Q); Inc(At,Q); End;
  Inc(Cur,W*Hh);
  At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
   At; ReadAt(Cur+At,Up^[At],Q); Inc(At,Q); End;
  Inc(Cur,CW*CH);
  At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
   At; ReadAt(Cur+At,Vp^[At],Q); Inc(At,Q); End;
  Inc(Cur,CW*CH);
  If NFrames>=100000 Then Fail('qtrle: trop d''images.');
  { conversion }
  For Y:=0 To Hh-1 Do For X:=0 To W-1 Do Begin
   Yv:=Yp^[Y*W+X];
   If PixFmtKind=2 Then Begin
    Gv:=Yv Shl 7; If Gv>30189 Then Gv:=30189;
    Gv:=Sar(Gv*19077-39057361,14); Gv:=Sar(Gv+64,7); If Gv<0 Then Gv:=0; If
     Gv>255 Then Gv:=255;
    Fr^[Y*W+X]:=Gv;
   End Else Begin
    Uv:=Up^[(Y Shr 1)*CW+(X Shr 1)]; Vv:=Vp^[(Y Shr 1)*CW+(X Shr 1)];
    Rg:=Tab[Yoffs-Sar(Crv,9)+Sar(Vv*Crv,16)+Yv];
    Gg:=Tab[Yoffs-Sar(Cgu,9)+Sar(Uv*Cgu,16)-Sar(Cgv,9)+Sar(Vv*Cgv,16)+Yv];
    Bg:=Tab[Yoffs-Sar(Cbu,9)+Sar(Uv*Cbu,16)+Yv];
    If PixFmtKind=0 Then Begin Fr^[(Y*W+X)*3]:=Rg; Fr^[(Y*W+X)*3+1]:=Gg; Fr^[(Y*
     W+X)*3+2]:=Bg; End
    Else Begin Fr^[(Y*W+X)*4]:=255; Fr^[(Y*W+X)*4+1]:=Rg; Fr^[(Y*W+X)*4+2]:=Gg;
     Fr^[(Y*W+X)*4+3]:=Bg; End;
   End;
  End;
  KeyFrame:=(NFrames=0) Or ((NFrames Mod 12)=0);
  K:=EncLen;
  EncodeFrame;
  FSizes^[NFrames]:=EncLen-K; FKeys^[NFrames]:=Ord(KeyFrame);
  Move(Fr^,FrPrev^,LogW*PixSize*Hh);
  Inc(NFrames);
 End;
 CloseRead;
 If NFrames=0 Then Fail('qtrle: aucune image Y4M.');
 { --- MOV --- }
 TS:=FpsN; While TS<10000 Do TS:=TS*2;
 Delta:=Int64(FpsD)*TS Div FpsN;
 MDur:=NFrames*Delta;
 MvDur:=RescaleUp(MDur,1000,TS);
 GetMem(Mv,65536+NFrames*16); MvLen:=0; Sp:=0;
 OpenWrite(Target);
 { ftyp, wide, mdat }
 BoxBegin('ftyp'); MTag('qt  '); M32($200); MTag('qt  '); BoxEnd;
 BoxBegin('wide'); BoxEnd;
 M32(EncLen+8); MTag('mdat');
 WriteBytes(Mv^,MvLen);
 At:=0; While At<EncLen Do Begin If EncLen-At>60000 Then Q:=60000 Else Q:=
  EncLen-At; WriteBytes(Enc^[At],Q); Inc(At,Q); End;
 MvLen:=0;
 QParOk:=True;
 If (SarD<=0) Or (SarN<0) Then QParOk:=False
 Else If (SarN<>0) And (SarN<>SarD) Then Begin
  If SarN<SarD Then QTW:=(Int64(W)*SarN) Div SarD Else QTW:=(Int64(Hh)*SarD) Div
   SarN;
  If QTW<=0 Then QParOk:=False;
 End;
 BoxBegin('moov');
 BoxBegin('mvhd'); M32(0); M32(0); M32(0); M32(1000); M32(MvDur); M32($10000);
  M16(256); MZero(10); Matrix; MZero(24); M32(2); BoxEnd;
 BoxBegin('trak');
 BoxBegin('tkhd'); M32(3); M32(0); M32(0); M32(1); M32(0); M32(MvDur); MZero(8);
  M16(0); M16(0); M16(0); M16(0); Matrix;
 M32(W Shl 16);
 M32(Hh Shl 16); BoxEnd;
 BoxBegin('edts'); BoxBegin('elst'); M32(0); M32(1); M32(MvDur); M32(0); M32(
  $10000); BoxEnd; BoxEnd;
 BoxBegin('mdia');
 BoxBegin('mdhd'); M32(0); M32(0); M32(0); M32(TS); M32(MDur); M16($7FFF); M16(
  0); BoxEnd;
 BoxBegin('hdlr'); M32(0); MTag('mhlr'); MTag('vide'); M32(0); M32(0); M32(0);
  MPut(12); MTag('VideoHandler'); BoxEnd;
 BoxBegin('minf');
 BoxBegin('vmhd'); M32(1); MZero(8); BoxEnd;
 BoxBegin('hdlr'); M32(0); MTag('dhlr'); MTag('url '); M32(0); M32(0); M32(0);
  MPut(11); MTag('DataHandler'); BoxEnd;
 BoxBegin('dinf'); BoxBegin('dref'); M32(0); M32(1); BoxBegin('url '); M32(1);
  BoxEnd; BoxEnd; BoxEnd;
 BoxBegin('stbl');
 BoxBegin('stsd'); M32(0); M32(1);
 BoxBegin('rle '); MZero(6); M16(1);
 M16(0); M16(0); MTag('FFMP'); M32($200); M32($200); M16(W); M16(Hh); M32(
  $480000); M32($480000); M32(0); M16(1);
 MPut(19); MTag('Lavc60.31.102 qtrle'); MZero(31-19);
 If PixFmtKind=0 Then M16(24) Else If PixFmtKind=1 Then M16(32) Else M16(40);
 M16($FFFF);
 BoxBegin('fiel'); MPut(1); MPut(0); BoxEnd;
 If QParOk And (SarN>0) Then Begin
  QG2:=SarN; K:=SarD; While K<>0 Do Begin I:=QG2 Mod K; QG2:=K; K:=I; End;
  BoxBegin('pasp'); M32(SarN Div QG2); M32(SarD Div QG2); BoxEnd;
 End;
 BoxEnd; BoxEnd;
 BoxBegin('stts'); M32(0); M32(1); M32(NFrames); M32(Delta); BoxEnd;
 Keys:=0; For I:=0 To NFrames-1 Do If FKeys^[I]<>0 Then Inc(Keys);
 If Keys<>NFrames Then Begin
  BoxBegin('stss'); M32(0); M32(Keys);
  For I:=0 To NFrames-1 Do If FKeys^[I]<>0 Then M32(I+1);
  BoxEnd;
 End;
 BoxBegin('stsc'); M32(0); M32(1); M32(1); M32(NFrames); M32(1); BoxEnd;
 SzUni:=FSizes^[0]; For I:=1 To NFrames-1 Do If FSizes^[I]<>SzUni Then SzUni:=-
  1;
 BoxBegin('stsz'); M32(0);
 If SzUni>=0 Then Begin M32(SzUni); M32(NFrames); End
 Else Begin M32(0); M32(NFrames); For I:=0 To NFrames-1 Do M32(FSizes^[I]); End;
 BoxEnd;
 BoxBegin('stco'); M32(0); M32(1); M32(36); BoxEnd;
 BoxEnd; BoxEnd; BoxEnd;
 If (SarN>0) And ((SarD<=0) Or (SarN<>SarD)) Then Begin
  QTW:=0; If QParOk Then QTW:=(Int64(SarN)*W+SarD Div 2) Div SarD;
  BoxBegin('tapt');
  M32(20); MTag('clef'); M32(0); M32(QTW Shl 16); M32(Hh Shl 16);
  M32(20); MTag('prof'); M32(0); M32(QTW Shl 16); M32(Hh Shl 16);
  M32(20); MTag('enof'); M32(0); M32(W Shl 16); M32(Hh Shl 16);
  BoxEnd;
 End;
 BoxEnd;
 BoxBegin('udta'); BoxBegin(#169+'swr'); M16(13); M16($55C4); MTag(
  'Lavf60.16.100'); BoxEnd; BoxEnd;
 BoxEnd;
 WriteBytes(Mv^,MvLen);
 CloseWrite;
 FreeMem(Mv,65536+NFrames*16); FreeMem(Enc,EncCap); FreeMem(FSizes,4*100000);
  FreeMem(FKeys,4*100000);
 FreeMem(Yp,W*Hh+16); FreeMem(Up,CW*CH+16); FreeMem(Vp,CW*CH+16); FreeMem(Fr,
  LogW*PixSize*Hh+16); FreeMem(FrPrev,LogW*PixSize*Hh+16);
 FreeMem(RleCode,(LogW+2)*4); FreeMem(LenTab,(LogW+2)*4); FreeMem(SkipTab,LogW+
  16);
End;

{ ---- QuickTime RPZA (libavcodec/rpza.c) et SMC (libavcodec/smc.c) : MOV / AVI
 ---- }
Procedure DecodeRPZA(Const Source,Target: String; Mode: LongInt);
Var
 Fr,Pk: PEABuffer; W,H,Stride,PIdx,Sz,Sp,TotalBlocks,RowPtr,PixelPtr,BlockPtr,
  NB,Op,ColorA,ColorB,Ta,Tb,I,Px,Py,Idx,Ix,Left0: LongInt;
 C4: Array[0..3] Of LongInt; Bad: Boolean; Chunk: LongInt;
Function GB: LongInt;
Begin If Sp<Sz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function GB16: LongInt;
Var A: LongInt;
Begin A:=GB; GB16:=A*256+GB; End;
Function LeftB: LongInt;
Var Q0: LongInt;
Begin Q0:=Sz-Sp; If Q0<0 Then Q0:=0; LeftB:=Q0; End;
Procedure PutPx(Ptr,V: LongInt);
Begin Fr^[Ptr*2]:=V And 255; Fr^[Ptr*2+1]:=V Shr 8; End;
Procedure Adv;
Begin
 Inc(PixelPtr,4);
 If PixelPtr>=W Then Begin PixelPtr:=0; Inc(RowPtr,Stride*4); End;
 Dec(TotalBlocks);
End;
Begin
 QXOpen(Source);
 W:=QXW; H:=QXH;
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail(
  'rpza: dimensions invalides.');
 Stride:=((W+3) Div 4)*4;
 NVBegin(Mode,Target,W,H,2,QXRn,QXRd);
 If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End Else
  NVSarN:=0;
 If Not QXIsMov Then NVAviSar(W,H);
 GetMem(Fr,Stride*(((H+3) Div 4)*4)*2+64); FillChar(Fr^,Stride*(((H+3) Div 4)*
  4)*2+64,0);
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]); Sp:=0; Bad:=False;
  Sp:=1; Chunk:=GB; Chunk:=GB16; { taille ignoree }
  TotalBlocks:=((W+3) Div 4)*((H+3) Div 4);
  If (TotalBlocks Div 32)>LeftB Then Bad:=True;
  RowPtr:=0; PixelPtr:=0; ColorA:=0;
  While Not Bad And (LeftB>0) Do Begin
   Op:=GB; NB:=(Op And $1F)+1;
   If (Op And $80)=0 Then Begin
    ColorA:=(Op Shl 8) Or GB;
    Op:=0;
    If Sp<Sz Then Left0:=Pk^[Sp] Else Left0:=0;
    If (Left0 And $80)<>0 Then Begin Op:=$20; NB:=1; End;
   End;
   If NB>TotalBlocks Then NB:=TotalBlocks;
   Case Op And $E0 Of
    $80: While NB>0 Do Begin Dec(NB); If TotalBlocks<1 Then Begin Bad:=True;
     Break; End; Adv; End;
    $A0: Begin
     ColorA:=GB16;
     While NB>0 Do Begin
      Dec(NB); If TotalBlocks<1 Then Begin Bad:=True; Break; End;
      BlockPtr:=RowPtr+PixelPtr;
      For Py:=0 To 3 Do Begin
       For Px:=0 To 3 Do Begin PutPx(BlockPtr,ColorA); Inc(BlockPtr); End;
       Inc(BlockPtr,Stride-4);
      End;
      Adv;
     End;
    End;
    $C0,$20: Begin
     If (Op And $E0)=$C0 Then ColorA:=GB16;
     ColorB:=GB16;
     C4[0]:=ColorB; C4[1]:=0; C4[2]:=0; C4[3]:=ColorA;
     Ta:=(ColorA Shr 10) And $1F; Tb:=(ColorB Shr 10) And $1F;
     C4[1]:=C4[1] Or (((11*Ta+21*Tb) Shr 5) Shl 10); C4[2]:=C4[2] Or (((21*Ta+
      11*Tb) Shr 5) Shl 10);
     Ta:=(ColorA Shr 5) And $1F; Tb:=(ColorB Shr 5) And $1F;
     C4[1]:=C4[1] Or (((11*Ta+21*Tb) Shr 5) Shl 5); C4[2]:=C4[2] Or (((21*Ta+11*
      Tb) Shr 5) Shl 5);
     Ta:=ColorA And $1F; Tb:=ColorB And $1F;
     C4[1]:=C4[1] Or ((11*Ta+21*Tb) Shr 5); C4[2]:=C4[2] Or ((21*Ta+11*Tb) Shr
      5);
     If LeftB<NB*4 Then Bad:=True
     Else
      While NB>0 Do Begin
       Dec(NB); If TotalBlocks<1 Then Begin Bad:=True; Break; End;
       BlockPtr:=RowPtr+PixelPtr;
       For Py:=0 To 3 Do Begin
        Ix:=GB;
        For Px:=0 To 3 Do Begin
         Idx:=(Ix Shr (2*(3-Px))) And 3;
         PutPx(BlockPtr,C4[Idx]); Inc(BlockPtr);
        End;
        Inc(BlockPtr,Stride-4);
       End;
       Adv;
      End;
    End;
    $00: Begin
     If LeftB<30 Then Bad:=True
     Else If TotalBlocks<1 Then Bad:=True
     Else Begin
      BlockPtr:=RowPtr+PixelPtr;
      For Py:=0 To 3 Do Begin
       For Px:=0 To 3 Do Begin
        If (Py<>0) Or (Px<>0) Then ColorA:=GB16;
        PutPx(BlockPtr,ColorA); Inc(BlockPtr);
       End;
       Inc(BlockPtr,Stride-4);
      End;
      Adv;
     End;
    End;
    Else Bad:=True;
   End;
  End;
  If Bad Then NVRepeat
  Else Begin
   { recadrage de l'image decodee (pas = Stride) }
   GetMem(Pk,W*H*2+64);
   For I:=0 To H-1 Do Move(Fr^[I*Stride*2],Pk^[I*W*2],W*2);
   NVEmit(Pk); FreeMem(Pk,W*H*2+64);
  End;
  If NVDone Then Break;
 End;
 FreeMem(Fr,Stride*(((H+3) Div 4)*4)*2+64); QXClose;
 NVFinish('rpza');
End;

Procedure DecodeSMC(Const Source,Target: String; Mode: LongInt);
Var
 Fr,Pk: PEABuffer; W,H,Stride,PIdx,Sz,Sp,TotalBlocks,RowPtr,PixelPtr,BlockPtr,
  NB,Op,I,Px,Py,Pixel,CTI,CPI,CQI,COI,Prev1,Prev2,PrevPtr,PrevFlag,ImageSize,
  RowInc,ColorFlags,FlagMask,FlagsA,FlagsB,V1,V2,V3: LongInt;
 Pairs: Array[0..511] Of Byte; Quads: Array[0..1023] Of Byte; Octets: Array[
  0..2047] Of Byte; Bad: Boolean;
 Pal: Array[0..255] Of LongWord;
Function GB: LongInt;
Begin If Sp<Sz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function GB16: LongInt;
Var A: LongInt;
Begin A:=GB; GB16:=A*256+GB; End;
Function LeftB: LongInt;
Var Q0: LongInt;
Begin Q0:=Sz-Sp; If Q0<0 Then Q0:=0; LeftB:=Q0; End;
Function Count: LongInt;
Begin If (Op And $10)<>0 Then Count:=1+GB Else Count:=1+(Op And $0F); End;
{ ADVANCE_BLOCK : retourne False en cas d'erreur }
Function Adv: Boolean;
Begin
 Inc(PixelPtr,4);
 If PixelPtr>=W Then Begin PixelPtr:=0; Inc(RowPtr,Stride*4); End;
 Dec(TotalBlocks);
 Adv:=True;
 If NB>0 Then If TotalBlocks<1 Then Adv:=False;
End;
Function Px8(Ptr: LongInt): LongInt;
Begin If (Ptr>=0) And (Ptr<ImageSize) Then Px8:=Fr^[Ptr] Else Px8:=0; End;
Procedure Put8(Ptr,V: LongInt);
Begin If (Ptr>=0) And (Ptr<ImageSize) Then Fr^[Ptr]:=V; End;
Function Decode: Boolean;
Var Py,Px,I: LongInt;
Begin
 Decode:=False;
 TotalBlocks:=((W+3) Div 4)*((H+3) Div 4);
 Sp:=4; RowPtr:=0; PixelPtr:=0; CPI:=0; CQI:=0; COI:=0;
 While TotalBlocks>0 Do Begin
  If RowPtr>=ImageSize Then Exit;
  If LeftB<1 Then Exit;
  Op:=GB;
  Case Op And $F0 Of
   $00,$10: Begin
    NB:=Count;
    While NB>0 Do Begin Dec(NB); If Not Adv Then Exit; End;
   End;
   $20,$30: Begin
    NB:=Count;
    If (RowPtr=0) And (PixelPtr=0) Then Exit;
    If PixelPtr=0 Then Prev1:=(RowPtr-W*4)+W-4 Else Prev1:=RowPtr+PixelPtr-4;
    While NB>0 Do Begin
     Dec(NB);
     BlockPtr:=RowPtr+PixelPtr; PrevPtr:=Prev1;
     For Py:=0 To 3 Do Begin
      For Px:=0 To 3 Do Begin Put8(BlockPtr,Px8(PrevPtr)); Inc(BlockPtr); Inc(
       PrevPtr); End;
      Inc(BlockPtr,RowInc); Inc(PrevPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
   $40,$50: Begin
    NB:=Count*2;
    If (RowPtr=0) And (PixelPtr<8) Then Exit;
    If PixelPtr=0 Then Prev1:=(RowPtr-W*4)+W-8
    Else If PixelPtr=4 Then Prev1:=(RowPtr-W*4)+RowInc
    Else Prev1:=RowPtr+PixelPtr-8;
    If PixelPtr=0 Then Prev2:=(RowPtr-W*4)+RowInc Else Prev2:=RowPtr+PixelPtr-4;
    PrevFlag:=0;
    While NB>0 Do Begin
     Dec(NB);
     BlockPtr:=RowPtr+PixelPtr;
     If PrevFlag<>0 Then PrevPtr:=Prev2 Else PrevPtr:=Prev1;
     PrevFlag:=1-PrevFlag;
     For Py:=0 To 3 Do Begin
      For Px:=0 To 3 Do Begin Put8(BlockPtr,Px8(PrevPtr)); Inc(BlockPtr); Inc(
       PrevPtr); End;
      Inc(BlockPtr,RowInc); Inc(PrevPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
   $60,$70: Begin
    NB:=Count; Pixel:=GB;
    While NB>0 Do Begin
     Dec(NB);
     BlockPtr:=RowPtr+PixelPtr;
     For Py:=0 To 3 Do Begin
      For Px:=0 To 3 Do Begin Put8(BlockPtr,Pixel); Inc(BlockPtr); End;
      Inc(BlockPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
   $80,$90: Begin
    NB:=(Op And $0F)+1;
    If (Op And $F0)=$80 Then Begin
     For I:=0 To 1 Do Pairs[2*CPI+I]:=GB;
     CTI:=2*CPI; Inc(CPI); If CPI=256 Then CPI:=0;
    End Else CTI:=2*GB;
    While NB>0 Do Begin
     Dec(NB);
     ColorFlags:=GB16; FlagMask:=$8000;
     BlockPtr:=RowPtr+PixelPtr;
     For Py:=0 To 3 Do Begin
      For Px:=0 To 3 Do Begin
       If (ColorFlags And FlagMask)<>0 Then Pixel:=CTI+1 Else Pixel:=CTI;
       FlagMask:=FlagMask Shr 1;
       Put8(BlockPtr,Pairs[Pixel]); Inc(BlockPtr);
      End;
      Inc(BlockPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
   $A0,$B0: Begin
    NB:=(Op And $0F)+1;
    If (Op And $F0)=$A0 Then Begin
     For I:=0 To 3 Do Quads[4*CQI+I]:=GB;
     CTI:=4*CQI; Inc(CQI); If CQI=256 Then CQI:=0;
    End Else CTI:=4*GB;
    While NB>0 Do Begin
     Dec(NB);
     V1:=GB16; V2:=GB16; ColorFlags:=V1*65536+V2; FlagMask:=30;
     BlockPtr:=RowPtr+PixelPtr;
     For Py:=0 To 3 Do Begin
      For Px:=0 To 3 Do Begin
       Pixel:=CTI+((ColorFlags Shr FlagMask) And 3);
       Dec(FlagMask,2);
       Put8(BlockPtr,Quads[Pixel]); Inc(BlockPtr);
      End;
      Inc(BlockPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
   $C0,$D0: Begin
    NB:=(Op And $0F)+1;
    If (Op And $F0)=$C0 Then Begin
     For I:=0 To 7 Do Octets[8*COI+I]:=GB;
     CTI:=8*COI; Inc(COI); If COI=256 Then COI:=0;
    End Else CTI:=8*GB;
    While NB>0 Do Begin
     Dec(NB);
     V1:=GB16; V2:=GB16; V3:=GB16;
     FlagsA:=((V1 And $FFF0) Shl 8) Or (V2 Shr 4);
     FlagsB:=((V3 And $FFF0) Shl 8) Or ((V1 And $0F) Shl 8) Or ((V2 And $0F) Shl
      4) Or (V3 And $0F);
     ColorFlags:=FlagsA; FlagMask:=21;
     BlockPtr:=RowPtr+PixelPtr;
     For Py:=0 To 3 Do Begin
      If Py=2 Then Begin ColorFlags:=FlagsB; FlagMask:=21; End;
      For Px:=0 To 3 Do Begin
       Pixel:=CTI+((ColorFlags Shr FlagMask) And 7);
       Dec(FlagMask,3);
       Put8(BlockPtr,Octets[Pixel]); Inc(BlockPtr);
      End;
      Inc(BlockPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
   Else Begin
    NB:=(Op And $0F)+1;
    While NB>0 Do Begin
     Dec(NB);
     BlockPtr:=RowPtr+PixelPtr;
     For Py:=0 To 3 Do Begin
      For Px:=0 To 3 Do Begin Put8(BlockPtr,GB); Inc(BlockPtr); End;
      Inc(BlockPtr,RowInc);
     End;
     If Not Adv Then Exit;
    End;
   End;
  End;
 End;
 Decode:=True;
End;
Begin
 QXOpen(Source);
 W:=QXW; H:=QXH;
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail(
  'smc: dimensions invalides.');
 Stride:=W; RowInc:=Stride-4;
 For I:=0 To 255 Do Begin NVPalR[I]:=(QXPal[I] Shr 16) And 255; NVPalG[I]:=(
  QXPal[I] Shr 8) And 255; NVPalB[I]:=QXPal[I] And 255; End;
 NVBegin(Mode,Target,W,H,0,QXRn,QXRd);
 If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End Else
  NVSarN:=0;
 If Not QXIsMov Then NVAviSar(W,H);
 ImageSize:=H*Stride;
 { l'image est decodee par blocs 4x4 : zone de travail arrondie a 4 lignes }
 GetMem(Fr,Stride*(((H+3) Div 4)*4+4)+64); FillChar(Fr^,Stride*(((H+3) Div 4)*4+
  4)+64,0);
 FillChar(Pairs,SizeOf(Pairs),0); FillChar(Quads,SizeOf(Quads),0); FillChar(
  Octets,SizeOf(Octets),0);
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]); Sp:=0;
  TotalBlocks:=((W+3) Div 4)*((H+3) Div 4);
  If (TotalBlocks Div 1024)>Sz Then NVRepeat
  Else If Decode Then NVEmit(Fr) Else NVRepeat;
  If NVDone Then Break;
 End;
 FreeMem(Fr,Stride*(((H+3) Div 4)*4+4)+64); QXClose;
 NVFinish('smc');
End;

{ ---- Apple QuickDraw (libavcodec/qdrw.c) : MOV / AVI ---- }
Procedure DecodeQDRAW(Const Source,Target: String; Mode: LongInt);
Var
 Pk,Fr,Out: PEABuffer; Sz,Sp,PIdx,W,H,Fmt,Bpp,Ver,Op,BppCnt,BppSz,Colors,Flags,
  Rowbytes,PackType,I,J,Y,Stride,Idx,R,G,B,Begun,FW,FH: LongInt;
 Got,Bad,Began: Boolean; Pal: Array[0..255] Of LongWord;
Function GB: LongInt;
Begin If Sp<Sz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function GB16: LongInt;
Var A: LongInt;
Begin A:=GB; GB16:=A*256+GB; End;
Function LeftB: LongInt;
Var Q0: LongInt;
Begin Q0:=Sz-Sp; If Q0<0 Then Q0:=0; LeftB:=Q0; End;
Function Hdr(At: LongInt; Len: LongInt): LongInt;
Var A,B2,V0,V1,Ww,Hh: LongInt;
Begin
 Hdr:=0; If Len<40 Then Exit;
 Ww:=Pk^[At+6]*256+Pk^[At+7]; Hh:=Pk^[At+8]*256+Pk^[At+9]; V0:=Pk^[At+10]*256+
  Pk^[At+11]; V1:=Pk^[At+12]*256+Pk^[At+13];
 If (Ww=0) Or (Hh=0) Then Exit;
 If V0=$1101 Then Hdr:=1 Else If (V0=$0011) And (V1=$02FF) Then Hdr:=2;
End;
Procedure PutF(Row,Pos,V: LongInt);
Begin If (Row*Stride+Pos>=0) And (Row*Stride+Pos<FH*Stride) Then Fr^[Row*Stride+
 Pos]:=V; End;
Function Pal0: Boolean;
Begin Pal0:=True; End;
Function DecRle(Step: LongInt; Bits: LongInt; Is16: Boolean): Boolean;
Var Y2,Size,Left,Code,Pix,J2,Pos,Offset,K: LongInt;
Begin
 DecRle:=False;
 If Is16 Then Offset:=FW Else If Bits In [2,4] Then Offset:=FW Else Offset:=FW*
  Step;
 For Y2:=0 To FH-1 Do Begin
  Pos:=0;
  If (Bits=2) And ((Offset Div 4)<=200) Then Size:=GB
  Else If (Bits=2) Or (Bits=4) Or Is16 Or True Then Size:=GB16;
  If LeftB<Size Then Exit;
  Left:=Size;
  While Left>0 Do Begin
   Code:=GB;
   If (Code And $80)<>0 Then Begin
    If Is16 Then Pix:=GB16 Else Pix:=GB;
    For J2:=1 To 257-Code Do Begin
     If Is16 Then Begin If Pos<Offset Then Begin PutF(Y2,Pos*2,Pix And 255);
      PutF(Y2,Pos*2+1,Pix Shr 8); Inc(Pos); End; End
     Else If Bits=2 Then Begin
      For K:=0 To 3 Do If Pos<Offset Then Begin PutF(Y2,Pos,(Pix Shr (6-2*K))
       And 3); Inc(Pos); End;
     End Else If Bits=4 Then Begin
      For K:=0 To 1 Do If Pos<Offset Then Begin PutF(Y2,Pos,(Pix Shr (4-4*K))
       And 15); Inc(Pos); End;
     End Else Begin
      If Pos<Offset Then PutF(Y2,Pos,Pix);
      Inc(Pos,Step);
      If (Pos>=Offset) And (Step>1) Then Begin Dec(Pos,Offset); Inc(Pos); End;
     End;
    End;
    If Is16 Then Dec(Left,3) Else Dec(Left,2);
   End Else Begin
    For J2:=1 To Code+1 Do Begin
     If Is16 Then Begin
      If Pos<Offset Then Begin Pix:=GB16; PutF(Y2,Pos*2,Pix And 255); PutF(Y2,
       Pos*2+1,Pix Shr 8); Inc(Pos); End Else Inc(Sp,2);
     End Else Begin
      Pix:=GB;
      If Bits=2 Then Begin
       For K:=0 To 3 Do If Pos<Offset Then Begin PutF(Y2,Pos,(Pix Shr (6-2*K))
        And 3); Inc(Pos); End;
      End Else If Bits=4 Then Begin
       For K:=0 To 1 Do If Pos<Offset Then Begin PutF(Y2,Pos,(Pix Shr (4-4*K))
        And 15); Inc(Pos); End;
      End Else Begin
       If Pos<Offset Then PutF(Y2,Pos,Pix);
       Inc(Pos,Step);
       If (Pos>=Offset) And (Step>1) Then Begin Dec(Pos,Offset); Inc(Pos); End;
      End;
     End;
    End;
    If Is16 Then Dec(Left,1+(Code+1)*2) Else If Bits In [2,4] Then Dec(Left,1+(
     Code+1)) Else Dec(Left,2+Code);
   End;
  End;
 End;
 DecRle:=True;
End;
Function DecodePkt: Boolean;
Var Skip512,Eop,I: LongInt; Pm: Boolean;
Begin
 DecodePkt:=False; Got:=False; Sp:=0;
 If (LeftB>=552) And (Hdr(512,Sz-512)<>0) Then Sp:=512;
 Ver:=Hdr(Sp,Sz-Sp);
 If Sz-Sp<40 Then Exit;
 Inc(Sp,6); H:=GB16; W:=GB16;
 If Ver<>2 Then Exit;
 Inc(Sp,30);
 While LeftB>=4 Do Begin
  Op:=GB16;
  Case Op Of
   $0001: Inc(Sp,10);
   $0098,$0099: Begin
    Flags:=GB16 And $C000; Inc(Sp,28);
    BppCnt:=GB16; BppSz:=GB16;
    If (BppCnt=1) And (BppSz=8) Then Fmt:=0
    Else If (BppCnt=1) And ((BppSz=4) Or (BppSz=2)) Then Fmt:=0
    Else If (BppCnt=3) And (BppSz=5) Then Fmt:=2
    Else Exit;
    Inc(Sp,18);
    Colors:=GB16;
    If Colors>255 Then Exit;
    If LeftB<(Colors+1)*8 Then Exit;
    FW:=W; FH:=H;
    If Not Began Then Begin
     If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Exit;
     If Fmt=0 Then Stride:=W Else Stride:=W*2;
     GetMem(Fr,Stride*H+64); FillChar(Fr^,Stride*H+64,0);
     NVBegin(Mode,Target,W,H,Fmt,QXRn,QXRd);
     If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End
      Else NVSarN:=0;
     Began:=True;
     GetMem(Out,W*H*4+64);
    End;
    FillChar(Fr^,Stride*H+64,0);
    FillChar(Pal,SizeOf(Pal),0);
    Pm:=(Flags And $8000)<>0;
    For I:=0 To Colors Do Begin
     Idx:=GB16;
     If (Idx>255) And Not Pm Then Inc(Sp,6)
     Else Begin
      If Fmt<>0 Then Exit;
      R:=GB; Inc(Sp); G:=GB; Inc(Sp); B:=GB; Inc(Sp);
      If Pm Then Idx:=I;
      Pal[Idx And 255]:=(R Shl 16) Or (G Shl 8) Or B;
     End;
    End;
    For I:=0 To 255 Do Begin NVPalR[I]:=(Pal[I] Shr 16) And 255; NVPalG[I]:=(
     Pal[I] Shr 8) And 255; NVPalB[I]:=Pal[I] And 255; End;
    Inc(Sp,18);
    If Op=$0099 Then Inc(Sp,10);
    If Fmt=2 Then Got:=DecRle(1,0,True)
    Else If BppSz=2 Then Got:=DecRle(1,2,False)
    Else If BppSz=4 Then Got:=DecRle(1,4,False)
    Else Got:=DecRle(BppCnt,8,False);
    If Not Got Then Exit;
   End;
   $009A,$009B: Begin
    Inc(Sp,4);
    Rowbytes:=GB16 And $3FFF;
    If Rowbytes<=250 Then Exit;
    Inc(Sp,4); H:=GB16; W:=GB16; Inc(Sp,2);
    PackType:=GB16; Inc(Sp,16);
    BppCnt:=GB16; BppSz:=GB16;
    If (BppCnt=3) And (BppSz=8) Then Fmt:=9
    Else If ((BppCnt=3) And (BppSz=5)) Or ((BppCnt=2) And (BppSz=8)) Then Fmt:=2
    Else If (BppCnt=4) And (BppSz=8) Then Fmt:=3
    Else Exit;
    If PackType=0 Then PackType:=BppCnt;
    If (PackType<>3) And (PackType<>4) Then Exit;
    If LeftB<30 Then Exit;
    FW:=W; FH:=H;
    If Not Began Then Begin
     If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Exit;
     Stride:=W*NVBpp(Fmt);
     GetMem(Fr,Stride*H+64);
     NVBegin(Mode,Target,W,H,Fmt,QXRn,QXRd);
     If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End
      Else NVSarN:=0;
     NVHasAlpha:=Fmt=3;
     Began:=True;
     GetMem(Out,W*H*4+64);
    End;
    FillChar(Fr^,Stride*H+64,0);
    Inc(Sp,30);
    If Op=$009B Then Inc(Sp,10);
    If Fmt=2 Then Got:=DecRle(1,0,True) Else Got:=DecRle(BppCnt,8,False);
    If Not Got Then Exit;
   End;
   $00A1: Begin GB16; Inc(Sp,GB16); End;
  End;
  If Got Then Begin
   If (LeftB Mod 2)=1 Then Inc(Sp);
   Eop:=GB16;
   Break;
  End;
 End;
 DecodePkt:=Got;
End;
Begin
 QXOpen(Source);
 Began:=False; Fmt:=0; FW:=0; FH:=0; Stride:=0;
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]);
  If DecodePkt Then Begin
   If Fmt=3 Then Begin
    For I:=0 To W*H-1 Do Begin Out^[I*4]:=Fr^[I*4+3]; Out^[I*4+1]:=Fr^[I*4+2];
     Out^[I*4+2]:=Fr^[I*4+1]; Out^[I*4+3]:=Fr^[I*4]; End;
    NVEmit(Out);
   End Else NVEmit(Fr);
  End Else If Began Then NVRepeat;
  If NVDone Then Break;
 End;
 If Began Then Begin FreeMem(Out,W*H*4+64); End;
 QXClose;
 NVFinish('qdraw');
End;

{ ---- Q-team QPEG (libavcodec/qpeg.c) : AVI ---- }
Procedure DecodeQPEG(Const Source,Target: String; Mode: LongInt);
Const
 TabH: Array[0..15] Of Byte=($00,$20,$20,$20,$18,$10,$10,$20,$10,$08,$18,$08,
  $08,$18,$10,$04);
 TabW: Array[0..15] Of Byte=($00,$20,$18,$08,$18,$10,$20,$10,$08,$10,$20,$20,
  $08,$10,$18,$04);
Var
 Pk,Cur,Ref: PEABuffer; W,H,PIdx,Sz,Sp,I,Delta,Total: LongInt; CTab: Array[
  0..127] Of Byte; HaveRef: Boolean;
Function GB: LongInt;
Begin If Sp<Sz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function LeftB: LongInt;
Var Q0: LongInt;
Begin Q0:=Sz-Sp; If Q0<0 Then Q0:=0; LeftB:=Q0; End;
Procedure PutC(At,V: LongInt);
Begin If (At>=0) And (At<Total) Then Cur^[At]:=V; End;
Function GetR(At: LongInt): LongInt;
Begin If (At>=0) And (At<Total) Then GetR:=Ref^[At] Else GetR:=0; End;
Procedure Intra;
Var Code,C0,C1,Run,Copy,Filled,RowsToGo,Dst,Step,P,Z,Ii: LongInt;
Begin
 Filled:=0; RowsToGo:=H; Dst:=(H-1)*W;
 While (LeftB>0) And (RowsToGo>0) Do Begin
  Code:=GB; Run:=0; Copy:=0;
  If Code=$FC Then Break;
  If Code>=$F8 Then Begin C0:=GB; C1:=GB; Run:=((Code And 7) Shl 16)+(C0 Shl 8)+
   C1+2; End
  Else If Code>=$F0 Then Begin C0:=GB; Run:=((Code And $F) Shl 8)+C0+2; End
  Else If Code>=$E0 Then Run:=(Code And $1F)+2
  Else If Code>=$C0 Then Begin C0:=GB; C1:=GB; Copy:=((Code And $3F) Shl 16)+(C0
   Shl 8)+C1+1; End
  Else If Code>=$80 Then Begin C0:=GB; Copy:=((Code And $7F) Shl 8)+C0+1; End
  Else Copy:=Code+1;
  If Run>0 Then Begin
   P:=GB; Ii:=0;
   While Ii<Run Do Begin
    Step:=Run-Ii; If W-Filled<Step Then Step:=W-Filled;
    For Z:=0 To Step-1 Do PutC(Dst+Filled+Z,P);
    Inc(Filled,Step); Inc(Ii,Step-1);
    If Filled>=W Then Begin
     Filled:=0; Dec(Dst,W); Dec(RowsToGo);
     While (Run-Ii>W) And (RowsToGo>0) Do Begin
      For Z:=0 To W-1 Do PutC(Dst+Z,P);
      Dec(Dst,W); Dec(RowsToGo); Inc(Ii,W);
     End;
     If RowsToGo<=0 Then Break;
    End;
    Inc(Ii);
   End;
  End Else Begin
   If LeftB<Copy Then Copy:=LeftB;
   While Copy>0 Do Begin
    Step:=Copy; If W-Filled<Step Then Step:=W-Filled;
    For Z:=0 To Step-1 Do Begin PutC(Dst+Filled+Z,GB); End;
    Inc(Filled,Step); Dec(Copy,Step);
    If Filled>=W Then Begin
     Filled:=0; Dec(Dst,W); Dec(RowsToGo);
     If RowsToGo<=0 Then Break;
    End;
   End;
  End;
 End;
End;
Procedure Inter(Dl: LongInt);
Var Code,Filled,Hh,Dst,OrigH,MeIdx,MeW,MeH,MeX,MeY,Corr,Val,J,Ii,P,Skip,MePl:
 LongInt; Break2: Boolean;
Begin
 If HaveRef Then Move(Ref^,Cur^,Total);
 Filled:=0; OrigH:=H; Hh:=H-1; Dst:=Hh*W;
 While (LeftB>0) And (Hh>=0) Do Begin
  Code:=GB;
  If Dl<>0 Then Begin
   While (LeftB>0) And ((Code And $F0)=$F0) Do Begin
    If Dl=1 Then Begin
     MeIdx:=Code And $F; MeW:=TabW[MeIdx]; MeH:=TabH[MeIdx];
     Corr:=GB;
     Val:=Corr Shr 4; If Val>7 Then Dec(Val,16); MeX:=Val;
     Val:=Corr And $F; If Val>7 Then Dec(Val,16); MeY:=Val;
     If (MeX+Filled<0) Or (MeX+MeW+Filled>W) Or (Hh-MeY-MeH<0) Or (Hh-
      MeY>=OrigH) Or (Filled+MeW>W) Or (Hh-MeH<0) Then
     Else Begin
      MePl:=(Filled+MeX)+(Hh-MeY)*W;
      For J:=0 To MeH-1 Do For Ii:=0 To MeW-1 Do
       PutC(Dst+Filled+Ii-J*W,GetR(MePl+Ii-J*W));
     End;
    End;
    Code:=GB;
   End;
  End;
  If Code=$E0 Then Break;
  If Code>$E0 Then Begin
   Code:=Code And $1F; P:=GB;
   For Ii:=0 To Code Do Begin
    PutC(Dst+Filled,P); Inc(Filled);
    If Filled>=W Then Begin Filled:=0; Dec(Dst,W); Dec(Hh); If Hh<0 Then Break;
     End;
   End;
  End Else If Code>=$C0 Then Begin
   Code:=Code And $1F;
   If Code+1>LeftB Then Break;
   For Ii:=0 To Code Do Begin
    PutC(Dst+Filled,GB); Inc(Filled);
    If Filled>=W Then Begin Filled:=0; Dec(Dst,W); Dec(Hh); If Hh<0 Then Break;
     End;
   End;
  End Else If Code>=$80 Then Begin
   Code:=Code And $3F;
   If Code=0 Then Skip:=GB+64 Else If Code=1 Then Skip:=GB+320 Else Skip:=Code;
   Inc(Filled,Skip);
   While Filled>=W Do Begin
    Dec(Filled,W); Dec(Dst,W); Dec(Hh);
    If Hh<0 Then Break;
   End;
  End Else Begin
   If Code<>0 Then Begin PutC(Dst+Filled,CTab[Code And $7F]); Inc(Filled); End
    Else Inc(Filled);
   If Filled>=W Then Begin Filled:=0; Dec(Dst,W); Dec(Hh); End;
  End;
 End;
End;
Begin
 QXOpen(Source);
 W:=QXW; H:=QXH;
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail(
  'qpeg: dimensions invalides.');
 For I:=0 To 255 Do Begin NVPalR[I]:=(QXPal[I] Shr 16) And 255; NVPalG[I]:=(
  QXPal[I] Shr 8) And 255; NVPalB[I]:=QXPal[I] And 255; End;
 NVBegin(Mode,Target,W,H,0,QXRn,QXRd);
 If Not QXIsMov Then NVAviSar(W,H);
 Total:=W*H;
 GetMem(Cur,Total+64); GetMem(Ref,Total+64); HaveRef:=False;
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]);
  If Sz<$86 Then NVRepeat
  Else Begin
   Sp:=4; For I:=0 To 127 Do CTab[I]:=GB; Inc(Sp);
   Delta:=GB;
   FillChar(Cur^,Total+64,0);
   If Delta=$10 Then Intra Else Inter(Delta);
   Move(Cur^,Ref^,Total); HaveRef:=True;
   NVEmit(Cur);
  End;
  If NVDone Then Break;
 End;
 FreeMem(Cur,Total+64); FreeMem(Ref,Total+64); QXClose;
 NVFinish('qpeg');
End;

{ ---- rawvideo : Y4M -> pixels bruts (yuv420p, gray, rgb24, bgr24) ---- }
Var RawAvi: Boolean; AWBpsOverride: LongInt;
Procedure EncodeRawVideo(Const Source,Target: String);
Var
 Limit,Cur,At,Q,W,Hh,CW,CH,K,Code,X,Y,Kind,N,FN,FD,G2,Pl: LongInt; PkB:
  PEABuffer; Line,Token: String; H: Array[0..255] Of Byte;
 Yp,Up,Vp,Row: PEABuffer; Tab: Array[0..2047] Of Byte; Crv,Cbu,Cgu,Cgv,Cy,Oy,Yb,
  Gv: Int64; Yoffs,Ix,Rg,Gg,Bg,Yv,Uv,Vv: LongInt;
Function Clip(V: LongInt): LongInt;Begin If V<0 Then Clip:=0 Else If V>255 Then
 Clip:=255 Else Clip:=V; End;
Function Sar(V: Int64; Nn: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr Nn Else Sar:=-((-V+(Int64(1) Shl Nn)-1) Shr Nn);
 End;
Begin
 Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16;
 Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279;
 Crv:=((Crv Shl 16)+$8000) Div Cy; Cbu:=((Cbu Shl 16)+$8000) Div Cy;
 Cgu:=(Int64(-25675)*65536+$8000) Div Cy; Cgv:=(Int64(-53279)*65536+$8000) Div
  Cy;
 Yoffs:=326+512; Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For Ix:=0 To 2047 Do Begin Tab[Ix]:=Clip(Sar(Yb+$8000,16)); Yb:=Yb+Cy; End;
 If (OptPixFmt='') Or (OptPixFmt='yuv420p') Then Kind:=0 Else If
  OptPixFmt='gray' Then Kind:=1
 Else If OptPixFmt='rgb24' Then Kind:=2 Else If OptPixFmt='bgr24' Then Kind:=3
 Else Begin Kind:=0; Fail(
  'rawvideo: -pix_fmt yuv420p, gray, rgb24 ou bgr24 requis.'); End;
 OpenRead(Source); Limit:=InputSize; Cur:=0; Line:='';
 While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break; If
  Length(Line)<250 Then Line:=Line+Chr(H[0]); End;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('rawvideo: entree Y4M requise.');
 W:=0; Hh:=0; FN:=25; FD:=1; Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),Hh,Code);
   'F': Begin K:=Pos(':',Token); If K>0 Then Begin Val(Copy(Token,2,K-2),FN,
    Code); Val(Copy(Token,K+1,20),FD,Code); End; End;
   'C': If (Token<>'C420') And (Token<>'C420jpeg') And (Token<>'C420mpeg2') And
    (Token<>'C420paldv') Then Fail('rawvideo: Y4M YUV420 8 bits requis.');
  End;
 End;
 If (W<1) Or (Hh<1) Or (W>16000) Or (Hh>16000) Then Fail(
  'rawvideo: dimensions Y4M incorrectes.');
 CW:=(W+1) Div 2; CH:=(Hh+1) Div 2;
 GetMem(Yp,W*Hh+16); GetMem(Up,CW*CH+16); GetMem(Vp,CW*CH+16); GetMem(Row,W*3+
  16);
 If RawAvi Then Begin
  If (Kind<>0) And (Kind<>1) Then Fail(
   'rawvideo: AVI seulement pour yuv420p et gray.');
  If (FN<=0) Or (FD<=0) Then Begin FN:=25; FD:=1; End;
  G2:=FN; K:=FD; While K<>0 Do Begin Code:=G2 Mod K; G2:=K; K:=Code; End;
  If Kind=0 Then Pl:=W*Hh+2*CW*CH Else Pl:=W*Hh;
  GetMem(PkB,Pl+16);
  AWBpsOverride:=(Int64(Pl)*8*FN) Div (FD*8);
  If Kind=0 Then AWBegin(Target,'I420',W,Hh,FN Div G2,FD Div G2,12,Nil,0) Else
   AWBegin(Target,'Y800',W,Hh,FN Div G2,FD Div G2,8,Nil,0);
 End Else
 OpenWrite(Target);
 N:=0;
 While Cur+6+W*Hh+2*CW*CH<=Limit Do Begin
  ReadAt(Cur,H,5); If (H[0]<>70) Or (H[1]<>82) Then Break;
  Inc(Cur,5); While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10
   Then Break; End;
  At:=0; While At<W*Hh Do Begin If W*Hh-At>60000 Then Q:=60000 Else Q:=W*Hh-At;
   ReadAt(Cur+At,Yp^[At],Q); Inc(At,Q); End;
  Inc(Cur,W*Hh);
  At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
   At; ReadAt(Cur+At,Up^[At],Q); Inc(At,Q); End;
  Inc(Cur,CW*CH);
  At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
   At; ReadAt(Cur+At,Vp^[At],Q); Inc(At,Q); End;
  Inc(Cur,CW*CH);
  Inc(N);
  If RawAvi Then Begin
   Move(Yp^,PkB^,W*Hh);
   If Kind=0 Then Begin Move(Up^,PkB^[W*Hh],CW*CH); Move(Vp^,PkB^[W*Hh+CW*CH],
    CW*CH); End
   Else Begin
    For Y:=0 To Hh-1 Do For X:=0 To W-1 Do Begin
     Gv:=Yp^[Y*W+X] Shl 7; If Gv>30189 Then Gv:=30189;
     Gv:=Sar(Gv*19077-39057361,14); Gv:=Sar(Gv+64,7); If Gv<0 Then Gv:=0; If
      Gv>255 Then Gv:=255;
     PkB^[Y*W+X]:=Gv;
    End;
   End;
   AWFrame(PkB,Pl);
  End Else
  If Kind=0 Then Begin
   At:=0; While At<W*Hh Do Begin If W*Hh-At>60000 Then Q:=60000 Else Q:=W*Hh-At;
    WriteBytes(Yp^[At],Q); Inc(At,Q); End;
   At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
    At; WriteBytes(Up^[At],Q); Inc(At,Q); End;
   At:=0; While At<CW*CH Do Begin If CW*CH-At>60000 Then Q:=60000 Else Q:=CW*CH-
    At; WriteBytes(Vp^[At],Q); Inc(At,Q); End;
  End Else
   For Y:=0 To Hh-1 Do Begin
    For X:=0 To W-1 Do Begin
     Yv:=Yp^[Y*W+X];
     If Kind=1 Then Begin
      Gv:=Yv Shl 7; If Gv>30189 Then Gv:=30189;
      Gv:=Sar(Gv*19077-39057361,14); Gv:=Sar(Gv+64,7); If Gv<0 Then Gv:=0; If
       Gv>255 Then Gv:=255;
      Row^[X]:=Gv;
     End Else Begin
      Uv:=Up^[(Y Shr 1)*CW+(X Shr 1)]; Vv:=Vp^[(Y Shr 1)*CW+(X Shr 1)];
      Rg:=Tab[Yoffs-Sar(Crv,9)+Sar(Vv*Crv,16)+Yv];
      Gg:=Tab[Yoffs-Sar(Cgu,9)+Sar(Uv*Cgu,16)-Sar(Cgv,9)+Sar(Vv*Cgv,16)+Yv];
      Bg:=Tab[Yoffs-Sar(Cbu,9)+Sar(Uv*Cbu,16)+Yv];
      If Kind=2 Then Begin Row^[X*3]:=Rg; Row^[X*3+1]:=Gg; Row^[X*3+2]:=Bg; End
      Else Begin Row^[X*3]:=Bg; Row^[X*3+1]:=Gg; Row^[X*3+2]:=Rg; End;
     End;
    End;
    If Kind=1 Then WriteBytes(Row^,W) Else WriteBytes(Row^,W*3);
   End;
 End;
 If RawAvi Then AWEnd Else Begin CloseRead; CloseWrite; End;
 If N=0 Then Fail('rawvideo: aucune image Y4M.');
 FreeMem(Yp,W*Hh+16); FreeMem(Up,CW*CH+16); FreeMem(Vp,CW*CH+16); FreeMem(Row,W*
  3+16);
End;

{ ---- rawvideo dans AVI / MOV (libavcodec/rawdec.c) ---- }
Procedure DecodeRawQX(Const Source,Target: String; Mode: LongInt);
Var
 Pk,Out: PEABuffer; W,H,Fmt,Bpp,SrcStride,PIdx,Sz,Y,X,I,Cw,Ch,Bits: LongInt;
  Flip,Planar,Swap,IsAvi: Boolean; Fc: String[4];
Begin
 QXOpen(Source);
 W:=QXW; H:=QXH; Bits:=QXDepth; Fc:=QXFcc; IsAvi:=Not QXIsMov; Flip:=False;
  Planar:=False; Swap:=False;
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail(
  'rawvideo: dimensions invalides.');
 If IsAvi Then Begin
  Fc:=QXFcc;
  If (Fc='I420') Or (Fc='IYUV') Or (Fc='YV12') Then Begin Planar:=True; Swap:=
   Fc='YV12'; Fmt:=7; End
  Else If (Fc='Y800') Or (Fc='GREY') Or (Fc='Y8  ') Then Begin Fmt:=4; Bpp:=1;
   End
  Else Begin
   Flip:=Not QXNeg;
   Case Bits Of
    8: Begin Fmt:=0; Bpp:=1; End;
    16: Begin Fmt:=2; Bpp:=2; End;
    24: Begin Fmt:=1; Bpp:=3; End;
    32: Begin Fmt:=3; Bpp:=4; End;
    Else Begin Fmt:=0; Bpp:=1; Fail(
     'rawvideo: profondeur AVI non prise en charge.'); End;
   End;
  End;
 End Else Begin
  Case Bits Of
   8,40: Begin Fmt:=0; Bpp:=1; End;
   16: Begin Fmt:=2; Bpp:=2; End;
   24: Begin Fmt:=9; Bpp:=3; End;
   32: Begin Fmt:=3; Bpp:=4; End;
   Else Begin Fmt:=0; Bpp:=1; Fail(
    'rawvideo: profondeur MOV non prise en charge.'); End;
  End;
 End;
 If Fmt=0 Then Begin
  For I:=0 To 255 Do Begin NVPalR[I]:=(QXPal[I] Shr 16) And 255; NVPalG[I]:=(
   QXPal[I] Shr 8) And 255; NVPalB[I]:=QXPal[I] And 255; End;
 End;
 NVBegin(Mode,Target,W,H,Fmt,QXRn,QXRd);
 If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End Else
  NVSarN:=0;
 If Not QXIsMov Then NVAviSar(W,H);
 If Planar Then Begin
  If Odd(W) Or Odd(H) Then Fail(
   'rawvideo: dimensions paires requises en YUV 4:2:0.');
  Cw:=W Div 2; Ch:=H Div 2;
  NVSubX:=1; NVSubY:=1; NVCW:=Cw; NVCH:=Ch; NVYTag:='C420jpeg'; NVIl:='p';
  GetMem(Out,W*H+2*Cw*Ch+64);
 End Else Begin
  If IsAvi And (Fc<>'Y800') And (Fc<>'GREY') And (Fc<>'Y8  ') Then SrcStride:=((
   W*Bpp+3) Div 4)*4 Else SrcStride:=W*Bpp;
  GetMem(Out,W*H*Bpp+64);
 End;
 NVHasAlpha:=Fmt=3;
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]);
  If Planar Then Begin
   If Sz<W*H+2*Cw*Ch Then NVRepeat
   Else Begin
    Move(Pk^[0],Out^[0],W*H);
    If Swap Then Begin Move(Pk^[W*H+Cw*Ch],Out^[W*H],Cw*Ch); Move(Pk^[W*H],Out^[
     W*H+Cw*Ch],Cw*Ch); End
    Else Move(Pk^[W*H],Out^[W*H],2*Cw*Ch);
    NVEmit(Out);
   End;
  End Else If Sz<SrcStride*(H-1)+W*Bpp Then NVRepeat
  Else Begin
   For Y:=0 To H-1 Do Begin
    If Flip Then Move(Pk^[(H-1-Y)*SrcStride],Out^[Y*W*Bpp],W*Bpp) Else Move(Pk^[
     Y*SrcStride],Out^[Y*W*Bpp],W*Bpp);
   End;
   If (Fmt=2) And QXIsMov Then
    For I:=0 To W*H-1 Do Begin X:=Out^[I*2]; Out^[I*2]:=Out^[I*2+1]; Out^[I*2+
     1]:=X; End;
   If (Fmt=3) And QXIsMov Then
    For I:=0 To W*H-1 Do Begin
     X:=Out^[I*4]; Out^[I*4]:=Out^[I*4+3]; Out^[I*4+3]:=X; X:=Out^[I*4+1]; Out^[
      I*4+1]:=Out^[I*4+2]; Out^[I*4+2]:=X;
    End;
   NVEmit(Out);
  End;
  If NVDone Then Break;
 End;
 QXClose;
 NVFinish('rawvideo');
End;

{ ---- id RoQ video (libavcodec/roqvideo*.c, libavformat/idroqdec.c) ---- }
Procedure DecodeRoQ(Const Source,Target: String; Mode: LongInt);
Type TCell=Record Y: Array[0..3] Of Byte; U,V: Byte; End;
Var
 F: PEABuffer; Size,Pos,Fps,W,H,CType,CSize,Ctr,CbPos,PkPos,PkLen,I,Plane:
  LongInt;
 Cb2: Array[0..255] Of TCell; Cb4: Array[0..255,0..3] Of Byte;
 BufA,BufB,Cur,Last: PEABuffer; AllocA,AllocB,Begun,Done: Boolean; FrameSize:
  LongInt;
 Sp: LongInt; Pk: PEABuffer; PSz: LongInt;
Function GB: LongInt;
Begin If Sp<PSz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function GL16: LongInt;
Var A: LongInt;
Begin A:=GB; GL16:=A+GB*256; End;
Function GL32: LongInt;
Var A: LongInt;
Begin A:=GL16; GL32:=A+GL16*65536; End;
Procedure Apply2(X,Y: LongInt; Const C: TCell);
Var Q: LongInt;
Begin
 If (X<0) Or (Y<0) Or (X+2>W) Or (Y+2>H) Then Exit;
 Q:=Y*W+X;
 Cur^[Q]:=C.Y[0]; Cur^[Q+1]:=C.Y[1]; Cur^[Q+W]:=C.Y[2]; Cur^[Q+W+1]:=C.Y[3];
 Cur^[W*H+Q]:=C.U; Cur^[W*H+Q+1]:=C.U; Cur^[W*H+Q+W]:=C.U; Cur^[W*H+Q+W+1]:=C.U;
 Cur^[2*W*H+Q]:=C.V; Cur^[2*W*H+Q+1]:=C.V; Cur^[2*W*H+Q+W]:=C.V; Cur^[2*W*H+Q+W+
  1]:=C.V;
End;
Procedure Apply4(X,Y: LongInt; Const C: TCell);
Var Q,Ry,Rx,Pl: LongInt;
Begin
 If (X<0) Or (Y<0) Or (X+4>W) Or (Y+4>H) Then Exit;
 For Ry:=0 To 3 Do For Rx:=0 To 3 Do Begin
  Q:=(Y+Ry)*W+X+Rx;
  Cur^[Q]:=C.Y[(Ry Shr 1)*2+(Rx Shr 1)];
  Cur^[W*H+Q]:=C.U; Cur^[2*W*H+Q]:=C.V;
 End;
End;
Procedure Motion(X,Y,Dx,Dy,Sz: LongInt);
Var Mx,My,R,Pl: LongInt;
Begin
 Mx:=X+Dx; My:=Y+Dy;
 If (Mx<0) Or (Mx>W-Sz) Or (My<0) Or (My>H-Sz) Then Exit;
 If Not ((Last=BufA) And AllocA) And Not ((Last=BufB) And AllocB) Then Exit;
 For Pl:=0 To 2 Do For R:=0 To Sz-1 Do
  Move(Last^[Pl*W*H+(My+R)*W+Mx],Cur^[Pl*W*H+(Y+R)*W+X],Sz);
End;
Procedure DecFrame;
Var
 ChId,ChArg,ChSize,Nv1,Nv2,J,K,VqFlg,VqPos,VqId,Xpos,Ypos,Xp,Yp,Xx,Yy,Mx,My,
  Byte1,ChStart: LongInt;
Function Sgn(V: LongInt): LongInt;
Begin V:=V And 255; If V>127 Then Sgn:=V-256 Else Sgn:=V; End;
Function NextVq: LongInt;
Begin
 If VqPos<0 Then Begin VqFlg:=GL16; VqPos:=7; End;
 NextVq:=(VqFlg Shr (VqPos*2)) And 3; Dec(VqPos);
End;
Begin
 ChId:=0; ChArg:=0; ChSize:=0; VqFlg:=0; VqPos:=-1;
 While PSz-Sp>=8 Do Begin
  ChId:=GL16; ChSize:=GL32; ChArg:=GL16;
  If ChId=$1011 Then Break;
  If ChId=$1002 Then Begin
   Nv1:=ChArg Shr 8; If Nv1=0 Then Nv1:=256;
   Nv2:=ChArg And 255; If (Nv2=0) And (Nv1*6<ChSize) Then Nv2:=256;
   For J:=0 To Nv1-1 Do Begin
    Cb2[J].Y[0]:=GB; Cb2[J].Y[1]:=GB; Cb2[J].Y[2]:=GB; Cb2[J].Y[3]:=GB; Cb2[
     J].U:=GB; Cb2[J].V:=GB;
   End;
   For J:=0 To Nv2-1 Do For K:=0 To 3 Do Cb4[J,K]:=GB;
  End;
 End;
 ChStart:=Sp; Xpos:=0; Ypos:=0;
 If ChSize>PSz-Sp Then ChSize:=PSz-Sp;
 While Sp<ChStart+ChSize Do Begin
  Yp:=Ypos;
  While Yp<Ypos+16 Do Begin
   Xp:=Xpos;
   While Xp<Xpos+16 Do Begin
    If Sp>=ChStart+ChSize Then Exit;
    VqId:=NextVq;
    Case VqId Of
     0: ;
     1: Begin
      Byte1:=GB; Mx:=8-(Byte1 Shr 4)-Sgn(ChArg Shr 8); My:=8-(Byte1 And 15)-Sgn(
       ChArg);
      Motion(Xp,Yp,Mx,My,8);
     End;
     2: Begin
      K:=GB;
      Apply4(Xp,Yp,Cb2[Cb4[K,0]]); Apply4(Xp+4,Yp,Cb2[Cb4[K,1]]); Apply4(Xp,Yp+
       4,Cb2[Cb4[K,2]]); Apply4(Xp+4,Yp+4,Cb2[Cb4[K,3]]);
     End;
     3: For K:=0 To 3 Do Begin
      Xx:=Xp; Yy:=Yp;
      If (K And 1)<>0 Then Inc(Xx,4);
      If (K And 2)<>0 Then Inc(Yy,4);
      If Sp>=ChStart+ChSize Then Exit;
      VqId:=NextVq;
      Case VqId Of
       0: ;
       1: Begin
        Byte1:=GB; Mx:=8-(Byte1 Shr 4)-Sgn(ChArg Shr 8); My:=8-(Byte1 And 15)-
         Sgn(ChArg);
        Motion(Xx,Yy,Mx,My,4);
       End;
       2: Begin
        J:=GB;
        Apply2(Xx,Yy,Cb2[Cb4[J,0]]); Apply2(Xx+2,Yy,Cb2[Cb4[J,1]]); Apply2(Xx,
         Yy+2,Cb2[Cb4[J,2]]); Apply2(Xx+2,Yy+2,Cb2[Cb4[J,3]]);
       End;
       3: Begin
        J:=GB; Apply2(Xx,Yy,Cb2[J]); J:=GB; Apply2(Xx+2,Yy,Cb2[J]); J:=GB;
         Apply2(Xx,Yy+2,Cb2[J]); J:=GB; Apply2(Xx+2,Yy+2,Cb2[J]);
       End;
      End;
     End;
    End;
    Inc(Xp,8);
   End;
   Inc(Yp,8);
  End;
  Inc(Xpos,16);
  If Xpos>=W Then Begin Dec(Xpos,W); Inc(Ypos,16); End;
  If Ypos>=H Then Break;
 End;
End;
Begin
 NVLoad(Source,F,Size);
 If (Size<16) Or (F^[0]<>$84) Or (F^[1]<>$10) Or (NVRL32(F,Size,2)<>-1) Then
  Fail('roq: signature invalide.');
 Fps:=NVRL16(F,Size,6); If Fps<1 Then Fail('roq: cadence invalide.');
 Pos:=8; W:=0; H:=0; Begun:=False; AllocA:=False; AllocB:=False;
 BufA:=Nil; BufB:=Nil; FillChar(Cb2,SizeOf(Cb2),0); FillChar(Cb4,SizeOf(Cb4),0);
 While Pos+8<=Size Do Begin
  CType:=NVRL16(F,Size,Pos); CSize:=NVRL32(F,Size,Pos+2);
  If (CSize<0) Or (CSize>Size) Then Break;
  If CType=$1001 Then Begin
   If Not Begun Then Begin
    If Pos+16>Size Then Break;
    W:=NVRL16(F,Size,Pos+8); H:=NVRL16(F,Size,Pos+10);
    If (W<16) Or (H<16) Or (W Mod 16<>0) Or (H Mod 16<>0) Or (W>8192) Or (
     H>8192) Then Fail('roq: dimensions invalides (multiples de 16 requis).');
    FrameSize:=W*H*3;
    GetMem(BufA,FrameSize+64); GetMem(BufB,FrameSize+64); FillChar(BufA^,
     FrameSize+64,0); FillChar(BufB^,FrameSize+64,0);
    Cur:=BufA; Last:=BufB;
    NVBegin(Mode,Target,W,H,7,Fps,1);
    NVSubX:=0; NVSubY:=0; NVCW:=W; NVCH:=H; NVIl:='p';
    If OptPixFmt='yuv420p' Then Begin
     NVTo420:=True; NVFullRng:=True; NVYTag:=
      'C420jpeg XYSCSS=420JPEG XCOLORRANGE=LIMITED';
    End Else NVYTag:='C444 XYSCSS=444 XCOLORRANGE=FULL';
    NVHdrOk:=True;
    Begun:=True;
   End;
   Inc(Pos,16); Continue;
  End;
  If (CType=$1002) Or (CType=$1011) Then Begin
   If Not Begun Then Fail('roq: image sans en-tete.');
   If CType=$1002 Then Begin
    { paquet = codebook + chunk VQ suivant }
    If Pos+8+CSize+8>Size Then Break;
    PkPos:=Pos; PkLen:=8+CSize+8+NVRL32(F,Size,Pos+8+CSize+2);
    If PkPos+PkLen>Size Then PkLen:=Size-PkPos;
   End Else Begin
    PkPos:=Pos; PkLen:=8+CSize;
    If PkPos+PkLen>Size Then PkLen:=Size-PkPos;
   End;
   Pk:=PEABuffer(@F^[PkPos]); PSz:=PkLen; Sp:=0;
   If Cur=BufA Then Begin
    If Not AllocA And AllocB Then Move(BufB^,BufA^,FrameSize);
    AllocA:=True;
   End Else Begin
    If Not AllocB And AllocA Then Move(BufA^,BufB^,FrameSize);
    AllocB:=True;
   End;
   DecFrame;
   NVEmit(Cur);
   If Cur=BufA Then Begin Cur:=BufB; Last:=BufA; End Else Begin Cur:=BufA;
    Last:=BufB; End;
   Inc(Pos,PkLen);
   If NVDone Then Break;
   Continue;
  End;
  { audio ou chunk inconnu : saute }
  Inc(Pos,8+CSize);
 End;
 If Begun Then Begin FreeMem(BufA,FrameSize+64); FreeMem(BufB,FrameSize+64);
  End;
 FreeMem(F,Size+64);
 NVFinish('roq');
End;

{ ---- id RoQ DPCM : decodeur (libavcodec/dpcm.c) et encodeur
 (libavcodec/roqaudioenc.c) + muxeur roq ---- }
Procedure DecodeRoQAudio(Const Source,Target: String);
Var
 F: PEABuffer; Size,Pos,CType,CSize,Chn,I,N,Pred0,Pred1,Ch,Stereo,Out: LongInt;
  Arr: Array[0..255] Of LongInt; Pred: Array[0..1] Of LongInt;
 Began: Boolean; Pk: PEABuffer; PSz,Sp,Ss: LongInt;
Function Clip16(V: LongInt): LongInt;Begin If V>32767 Then V:=32767 Else If V<-
 32768 Then V:=-32768; Clip16:=V; End;
Function GB: LongInt;
Begin If Sp<PSz Then GB:=Pk^[Sp] Else GB:=0; Inc(Sp); End;
Function SE16(V: LongInt): LongInt;Begin V:=V And 65535; If V>32767 Then V:=V-
 65536; SE16:=V; End;
Begin
 NVLoad(Source,F,Size);
 If (Size<16) Or (F^[0]<>$84) Or (F^[1]<>$10) Or (NVRL32(F,Size,2)<>-1) Then
  Fail('roq: signature invalide.');
 For I:=0 To 127 Do Begin Arr[I]:=I*I; Arr[I+128]:=-(I*I); End;
 Pos:=8; Chn:=0; Began:=False; Ch:=0;
 Pred[0]:=0; Pred[1]:=0;
 While Pos+8<=Size Do Begin
  CType:=NVRL16(F,Size,Pos); CSize:=NVRL32(F,Size,Pos+2);
  If (CSize<0) Or (CSize>Size) Then Break;
  If CType=$1001 Then Begin Inc(Pos,16); Continue; End;
  If (CType=$1020) Or (CType=$1021) Then Begin
   If Not Began Then Begin
    If CType=$1021 Then Chn:=2 Else Chn:=1;
    EAReset; OpenWrite(Target); ADPCMWaveHeader(22050,Chn,0); Began:=True;
   End;
   Stereo:=Chn-1;
   Pk:=PEABuffer(@F^[Pos]); PSz:=8+CSize; If Pos+PSz>Size Then PSz:=Size-Pos;
   Ss:=PSz; If (Stereo<>0) And Odd(Ss) Then Dec(Ss);
   Out:=Ss-8;
   If Out>0 Then Begin
    Sp:=6;
    If Stereo<>0 Then Begin Pred[1]:=SE16(GB Shl 8); Pred[0]:=SE16(GB Shl 8);
     End
    Else Begin N:=GB; Pred[0]:=SE16(N+GB*256); End;
    Ch:=0;
    For I:=1 To Out Do Begin
     Pred[Ch]:=Clip16(Pred[Ch]+Arr[GB]);
     EAPut(Pred[Ch]);
     Ch:=Ch Xor Stereo;
    End;
   End;
  End;
  Inc(Pos,8+CSize);
 End;
 If Not Began Then Fail('roq: aucun flux audio.');
 EAFlush;
 ADPCMPatchHeader(22050,Chn,EAWritten); CloseRead; CloseWrite;
 FreeMem(F,Size+64);
End;

Procedure EncodeRoQDpcm(Const Source,Target: String);
Const FrameSize=735;
Var
 Head: Array[0..43] Of Byte; Limit,Channels,Samples,Frames,Fr,InputFrames,
  Buffered,I,K,DataSize,Ch,Stereo,Rate: LongInt;
 Buf: PALLong; Last: Array[0..1] Of LongInt; Hdr: Array[0..7] Of Byte; Tmp:
  Array[0..1] Of Byte; Src: PALLong; Raw: PEABuffer;
 InPtr: LongInt; Fb: PALLong; FirstFrameLen: LongInt;
Function ISqrt(V: LongInt): LongInt;
Var R: LongInt;
Begin R:=Trunc(Sqrt(V)); While R*R>V Do Dec(R); While (R+1)*(R+1)<=V Do Inc(R);
 ISqrt:=R; End;
Function Predict(Var Prev: LongInt; Cur: LongInt): LongInt;
Var Diff,Neg,Res,Predicted: LongInt;
Begin
 Diff:=Cur-Prev; Neg:=Ord(Diff<0); Diff:=Abs(Diff);
 If Diff>=127*127 Then Res:=127
 Else Begin Res:=ISqrt(Diff); If Diff>Res*Res+Res Then Inc(Res); End;
 Repeat
  Diff:=Res*Res; If Neg<>0 Then Diff:=-Diff;
  Predicted:=Prev+Diff;
  If (Predicted>32767) Or (Predicted<-32768) Then Dec(Res) Else Break;
 Until False;
 Res:=Res Or (Neg Shl 7);
 Prev:=Predicted;
 Predict:=Res;
End;
Procedure EmitPacket(Src2: PALLong; FromAt: LongInt; Cnt: LongInt);
Var Z,S1: LongInt; Pk: PEABuffer;
Begin
 If Stereo<>0 Then Begin Last[0]:=Last[0] And Not 255; Last[1]:=Last[1] And Not
  255; End;
 { mots 16 bits signes : forme "short" }
 GetMem(Pk,Cnt+16);
 If Stereo<>0 Then Begin
  Hdr[0]:=$21; Hdr[1]:=$10;
 End Else Begin Hdr[0]:=$20; Hdr[1]:=$10; End;
 Hdr[2]:=Cnt And 255; Hdr[3]:=(Cnt Shr 8) And 255; Hdr[4]:=(Cnt Shr 16) And 255;
  Hdr[5]:=(Cnt Shr 24) And 255;
 If Stereo<>0 Then Begin Hdr[6]:=(Last[1] Shr 8) And 255; Hdr[7]:=(Last[0] Shr
  8) And 255; End
 Else Begin Hdr[6]:=Last[0] And 255; Hdr[7]:=(Last[0] Shr 8) And 255; End;
 WriteBytes(Hdr,8);
 For Z:=0 To Cnt-1 Do Begin
  If Stereo<>0 Then S1:=Z And 1 Else S1:=0;
  Pk^[Z]:=Predict(Last[S1],Src2^[FromAt+Z]);
 End;
 WriteBytes(Pk^,Cnt);
 FreeMem(Pk,Cnt+16);
End;
Begin
 OpenRead(Source); Limit:=InputSize;
 If Limit<44 Then Fail('roq_dpcm: WAV intermediaire tronque.');
 ReadAt(0,Head,44); Channels:=Head[22];
 Rate:=LongInt(Head[24])+LongInt(Head[25])*256+LongInt(Head[26])*65536;
 If (Channels<1) Or (Channels>2) Or (Head[34]<>16) Then Fail(
  'roq_dpcm: WAV PCM16 mono/stereo requis.');
 If Rate<>22050 Then Fail('roq_dpcm: 22050 Hz requis (utilisez -ar 22050).');
 Stereo:=Channels-1;
 Samples:=(Limit-44) Div (Channels*2);
 Frames:=(Samples+FrameSize-1) Div FrameSize;
 If Frames=0 Then Fail('roq_dpcm: aucune donnee audio.');
 GetMem(Raw,Limit-44+16);
 I:=0; While I<Limit-44 Do Begin If Limit-44-I>60000 Then K:=60000 Else K:=
  Limit-44-I; ReadAt(44+I,Raw^[I],K); Inc(I,K); End;
 CloseRead;
 GetMem(Src,Frames*FrameSize*Channels*4+16); FillChar(Src^,Frames*FrameSize*
  Channels*4+16,0);
 For I:=0 To Samples*Channels-1 Do Begin
  K:=Raw^[2*I]+Raw^[2*I+1]*256; If K>32767 Then K:=K-65536; Src^[I]:=K;
 End;
 FreeMem(Raw,Limit-44+16);
 Last[0]:=0; Last[1]:=0;
 OpenWrite(Target);
 Hdr[0]:=$84; Hdr[1]:=$10; Hdr[2]:=255; Hdr[3]:=255; Hdr[4]:=255; Hdr[5]:=255;
  Hdr[6]:=30; Hdr[7]:=0;
 WriteBytes(Hdr,8);
 InputFrames:=0; Buffered:=0;
 For Fr:=0 To Frames-1 Do Begin
  { appel avec une trame }
  If InputFrames<8 Then Begin
   Inc(Buffered,FrameSize);
   If InputFrames<7 Then Begin Inc(InputFrames); Continue; End;
   DataSize:=Channels*Buffered;
   EmitPacket(Src,0,DataSize);
   Inc(InputFrames);
  End Else Begin
   DataSize:=Channels*FrameSize;
   EmitPacket(Src,Fr*FrameSize*Channels,DataSize);
   Inc(InputFrames);
  End;
 End;
 { vidage : tant que moins de 8 trames ont ete comptees, l'encodeur ressort la
  trame 0 }
 While InputFrames<8 Do Begin
  If InputFrames=7 Then DataSize:=Channels*Buffered Else DataSize:=Channels*
   FrameSize;
  EmitPacket(Src,0,DataSize);
  Inc(InputFrames);
 End;
 CloseWrite;
 FreeMem(Src,Frames*FrameSize*Channels*4+16);
End;

{ ---- RL2 (libavformat/rl2.c, libavcodec/rl2.c) ---- }
Procedure DecodeRL2(Const Source,Target: String; Mode: LongInt);
Const W=320; H=200;
Var
 F,Fr,Back,Out: PEABuffer; Size,BackSize,FrameCount,SoundRate,Rate,Chans,DefSnd,
  VideoBase,Ex,ExLen,I,Pk,PkLen,Rn,Rd,TabPos: LongInt;
 Sig: LongInt; HasBack: Boolean; Cs,Co,As_: LongInt;
Procedure RleDecode(Inp: PEABuffer; InSize: LongInt; OutB: PEABuffer; VBase:
 LongInt; UseBack: Boolean);
Var
 BaseX,BaseY,Ip,Op,LineEnd,OutEnd,Bp,V,Len,Cp,Z: LongInt;
Begin
 BaseX:=VBase Mod W; BaseY:=VBase Div W;
 OutEnd:=W*H; Op:=0; Bp:=0;
 If UseBack Then Begin
  For Z:=0 To BaseY Do Begin Move(Back^[Bp],OutB^[Op],W); Inc(Op,W); Inc(Bp,W);
   End;
  Inc(Bp,BaseX-W);
 End Else Inc(Op,W*(BaseY+1));
 LineEnd:=Op; Inc(Op,BaseX-W);
 Ip:=0;
 While Ip<InSize Do Begin
  V:=Inp^[Ip]; Inc(Ip); Len:=1;
  If V>=$80 Then Begin
   If Ip>=InSize Then Break;
   Len:=Inp^[Ip]; Inc(Ip);
   If Len=0 Then Break;
   V:=V And $7F;
  End;
  If UseBack Then Begin
   If V=0 Then Begin
    Repeat
     Cp:=LineEnd-Op; If Len<Cp Then Cp:=Len;
     If (Op>=0) And (Bp>=0) Then Move(Back^[Bp],OutB^[Op],Cp);
     Inc(Op,Cp); Inc(Bp,Cp); Dec(Len,Cp);
     If Op=LineEnd Then Begin
      If Op=OutEnd Then Exit;
      LineEnd:=LineEnd+W;
     End;
    Until Len<=0;
    Continue;
   End;
   Inc(Bp,Len);
   V:=V Or $80;
  End;
  While Len>0 Do Begin
   Dec(Len);
   If (Op>=0) And (Op<OutEnd+W) Then OutB^[Op]:=V;
   Inc(Op);
   If Op=LineEnd Then Begin
    If Op=OutEnd Then Exit;
    LineEnd:=LineEnd+W;
   End;
  End;
 End;
 If UseBack Then Begin
  While True Do Begin
   If LineEnd-Op>0 Then Move(Back^[Bp],OutB^[Op],LineEnd-Op);
   If LineEnd=OutEnd Then Break;
   Inc(Bp,LineEnd-Op);
   Op:=LineEnd; LineEnd:=LineEnd+W;
  End;
 End;
End;
Begin
 NVLoad(Source,F,Size);
 If (Size<30+774) Or (F^[0]<>70) Or (F^[1]<>79) Or (F^[2]<>82) Or (F^[3]<>77)
  Then Fail('rl2: signature invalide.');
 BackSize:=NVRL32(F,Size,4);
 Sig:=F^[8]*16777216+F^[9]*65536+F^[10]*256+F^[11];
 FrameCount:=NVRL32(F,Size,16);
 SoundRate:=NVRL16(F,Size,22); Rate:=NVRL16(F,Size,24); Chans:=NVRL16(F,Size,
  26); DefSnd:=NVRL16(F,Size,28);
 If (Sig<>$524C5632) And (Sig<>$524C5633) Then Fail(
  'rl2: signature RLV2/RLV3 requise.');
 If (BackSize<0) Or (BackSize>1073741823) Or (FrameCount<0) Or (
  FrameCount>268435455) Then Fail('rl2: en-tete invalide.');
 ExLen:=6+768; If (Sig=$524C5633) And (BackSize>0) Then Inc(ExLen,BackSize);
 Ex:=30; If Ex+ExLen>Size Then Fail('rl2: en-tete tronque.');
 VideoBase:=NVRL16(F,Size,Ex);
 If VideoBase>=W*H Then Fail('rl2: video_base invalide.');
 If SoundRate<>0 Then Begin
  If (Chans=0) Or (Chans>42) Then Fail('rl2: nombre de canaux invalide.');
  Rn:=Rate; Rd:=DefSnd;
 End Else Begin Rn:=11025; Rd:=1103; End;
 If (Rn<1) Or (Rd<1) Then Fail('rl2: cadence invalide.');
 NVGcd(Rn,Rd);
 For I:=0 To 255 Do Begin NVPalR[I]:=F^[Ex+6+I*3]; NVPalG[I]:=F^[Ex+7+I*3];
  NVPalB[I]:=F^[Ex+8+I*3]; End;
 GetMem(Fr,W*H+W+64); GetMem(Back,W*H+254+64); HasBack:=ExLen-(6+768)>0;
 If HasBack Then Begin
  FillChar(Back^,W*H+254,0);
  RleDecode(PEABuffer(@F^[Ex+6+768]),ExLen-(6+768),Back,0,False);
 End;
 TabPos:=Ex+ExLen;
 NVBegin(Mode,Target,W,H,0,Rn,Rd); NVSarN:=0; NVSarD:=0;
 For I:=0 To FrameCount-1 Do Begin
  Cs:=NVRL32(F,Size,TabPos+4*I); Co:=NVRL32(F,Size,TabPos+4*FrameCount+4*I);
   As_:=NVRL32(F,Size,TabPos+8*FrameCount+4*I) And $FFFF;
  If TabPos+12*FrameCount>Size Then Break;
  If (Cs<0) Or (As_>Cs) Then Break;
  Pk:=Co+As_; PkLen:=Cs-As_;
  If (Pk<0) Or (Pk+PkLen>Size) Then Break;
  FillChar(Fr^,W*H+W+64,0);
  RleDecode(PEABuffer(@F^[Pk]),PkLen,Fr,VideoBase,HasBack);
  NVEmit(Fr);
  If NVDone Then Break;
 End;
 FreeMem(Fr,W*H+W+64); FreeMem(Back,W*H+254+64); FreeMem(F,Size+64);
 NVFinish('rl2');
End;

{ ---- RealMedia : demuxeur (libavformat/rmdec.c) ---- }
Const RM_MAXS=8;
Type
 TI64A=Array[0..134217727] Of Int64; PI64A=^TI64A;
 TRMStream=Record
  Id,Kind,Tag,W,H,Fps,ExtPos,ExtLen: LongInt;           { Kind: 0 autre, 1
   audio, 2 video }
  Ver,Rate,Chans,Deint,CodedFS,SubH,SubSize,BlockAlign,AudioFS,Flavor,Bitrate:
   LongInt;
  { etat video }
  CurPic,Slices,CurSlice,VBufSize,VBufPos: LongInt; VBuf: PEABuffer;
  { etat audio }
  SubCnt: LongInt; ABuf: PEABuffer; ATs: Int64; HaveTs: Boolean;
 End;
Var
 RMF: PEABuffer; RMSize,RMCp,RMNS,RMNPk,RMCap: LongInt; RMSt: Array[0..RM_MAXS-
  1] Of TRMStream;
 RMPkS,RMPkF,RMPkOff,RMPkLen: PALLong; RMTsArr: PI64A;
 RMArena: PEABuffer; RMArenaLen,RMArenaCap: LongInt; RMOld: Boolean;

Function RMB(At: LongInt): LongInt;Begin If (At>=0) And (At<RMSize) Then RMB:=
 RMF^[At] Else RMB:=0; End;
Function RMb16(At: LongInt): LongInt;Begin RMb16:=RMB(At)*256+RMB(At+1); End;
Function RMb32(At: LongInt): LongInt;Begin RMb32:=RMb16(At)*65536+RMb16(At+2);
 End;
Function RMl32(At: LongInt): LongInt;Begin RMl32:=RMB(At)+RMB(At+1)*256+RMB(At+
 2)*65536+RMB(At+3)*16777216; End;
Function RMTag(At: LongInt): String;
Begin RMTag:=Chr(RMB(At))+Chr(RMB(At+1))+Chr(RMB(At+2))+Chr(RMB(At+3)); End;

Procedure RMAddPacket(S: LongInt; Ts: Int64; Flags: LongInt; D: PEABuffer; Len:
 LongInt);
Var Z: LongInt;
Begin
 If RMNPk>=RMCap Then Begin
  Inc(RMCap,RMCap Div 2+1024);
  ReAllocMem(RMPkS,RMCap*4); ReAllocMem(RMPkF,RMCap*4); ReAllocMem(RMPkOff,
   RMCap*4); ReAllocMem(RMPkLen,RMCap*4);
  ReAllocMem(RMTsArr,RMCap*8);
 End;
 If RMArenaLen+Len+16>RMArenaCap Then Begin
  Inc(RMArenaCap,RMArenaCap Div 2+Len+65536); ReAllocMem(RMArena,RMArenaCap);
 End;
 Move(D^,RMArena^[RMArenaLen],Len);
 RMPkS^[RMNPk]:=S; RMPkF^[RMNPk]:=Flags; RMPkOff^[RMNPk]:=RMArenaLen; RMPkLen^[
  RMNPk]:=Len;
 RMTsArr^[RMNPk]:=Ts;
 Inc(RMArenaLen,Len); Inc(RMNPk);
End;

{ lecture de l'en-tete audio "ra" (rm_read_audio_stream_info) ; Cp pointe apres
 '.ra\xfd' }
Function RMReadAudioInfo(Var S: TRMStream; ReadAll: Boolean): Boolean;
Var Ver,HdrSize,Start,Q,Cl: LongInt;
Function Str8: String;
Var N,Z: LongInt; R: String;
Begin N:=RMB(RMCp); Inc(RMCp); R:=''; For Z:=0 To N-1 Do Begin If Z<250 Then R:=
 R+Chr(RMB(RMCp)); Inc(RMCp); End; Str8:=R; End;
Function ToLE(Const Sx: String): LongInt;
Var Z,V: LongInt;
Begin V:=0; For Z:=Length(Sx) Downto 1 Do If Length(Sx)-Z<4 Then V:=V*256+Ord(
 Sx[Z]); ToLE:=V; End;
Begin
 RMReadAudioInfo:=False;
 Ver:=RMb16(RMCp); Inc(RMCp,2);
 S.Kind:=1; S.Ver:=Ver;
 If Ver=3 Then Begin
  HdrSize:=RMb16(RMCp); Inc(RMCp,2); Start:=RMCp;
  Inc(RMCp,8); Q:=RMb16(RMCp); Inc(RMCp,2); Inc(RMCp,4);
  { metadata : 4 chaines de 8 bits }
  For Cl:=0 To 3 Do Begin Cl:=Cl; Q:=Q; Str8; End;
  If Start+HdrSize>=RMCp+2 Then Begin Inc(RMCp); Str8; End;
  If Start+HdrSize>RMCp Then RMCp:=Start+HdrSize;
  S.Tag:=ToLE('lpcJ'); S.Rate:=8000; S.Chans:=1; S.Deint:=ToLE('Int0');
   S.BlockAlign:=0;
 End Else Begin
  Inc(RMCp,2); Inc(RMCp,4); Inc(RMCp,4); Inc(RMCp,2); Inc(RMCp,4);
  S.Flavor:=RMb16(RMCp); Inc(RMCp,2);
  S.CodedFS:=RMb32(RMCp); Inc(RMCp,4);
  If S.CodedFS<0 Then Exit;
  Inc(RMCp,4); Q:=RMb32(RMCp); Inc(RMCp,4); S.Bitrate:=Q; Inc(RMCp,4);
  S.SubH:=RMb16(RMCp); Inc(RMCp,2); S.BlockAlign:=RMb16(RMCp); Inc(RMCp,2);
   S.SubSize:=RMb16(RMCp); Inc(RMCp,2); Inc(RMCp,2);
  If Ver=5 Then Inc(RMCp,6);
  S.Rate:=RMb16(RMCp); Inc(RMCp,2); Inc(RMCp,4); S.Chans:=RMb16(RMCp); Inc(RMCp,
   2);
  If Ver=5 Then Begin
   S.Deint:=RMl32(RMCp); Inc(RMCp,4); S.Tag:=RMl32(RMCp); Inc(RMCp,4);
  End Else Begin
   S.Deint:=ToLE(Str8); S.Tag:=ToLE(Str8);
  End;
  S.AudioFS:=0;
  { codecs sans donnees supplementaires : ra288 (28_8) }
  If S.Tag=ToLE('28_8') Then Begin
   S.AudioFS:=S.BlockAlign; S.BlockAlign:=S.CodedFS;
  End Else If (S.Tag=ToLE('cook')) Or (S.Tag=ToLE('atrc')) Or (S.Tag=ToLE(
   'sipr')) Then Begin
   S.AudioFS:=S.BlockAlign; S.BlockAlign:=S.SubSize;
   If Not ReadAll Then Begin
    Inc(RMCp,2); Inc(RMCp); If Ver=5 Then Inc(RMCp);
    S.ExtLen:=RMb32(RMCp); Inc(RMCp,4); S.ExtPos:=RMCp; Inc(RMCp,S.ExtLen);
   End;
  End;
  If (S.Deint=ToLE('Int4')) Or (S.Deint=ToLE('genr')) Or (S.Deint=ToLE('sipr'))
   Then Begin
   If (S.BlockAlign<=0) Or (Int64(S.AudioFS)*S.SubH<S.BlockAlign) Or (Int64(
    S.AudioFS)*S.SubH>100000000) Then Exit;
   If S.Deint=ToLE('Int4') Then
    If (S.CodedFS>S.AudioFS) Or (S.SubH<=1) Or (Int64(S.CodedFS)*S.SubH<>2*
     Int64(S.AudioFS)) Then Exit;
   If S.Deint=ToLE('genr') Then
    If (S.SubSize<=0) Or (S.SubSize>S.AudioFS) Or (S.AudioFS Mod S.SubSize<>0)
     Then Exit;
   GetMem(S.ABuf,S.AudioFS*S.SubH+64);
  End;
 End;
 RMReadAudioInfo:=True;
End;

{ parse le fichier entier ; remplit les paquets RMPk* }
Procedure RMParse(Const Source: String);
Var
 Tg,Mime,Desc: String; TagSize,Pos2,I,K,N,DataOff,Sz,CodecPos,V,ShCnt,SId,NS,
  Len,Num,Flags,Mlti,AudioPktCnt,CurStream,RemLen: LongInt;
 Ts: Int64; State: Int64; St: ^TRMStream; Sq: LongInt;
Function GetNum(Var L: LongInt): LongInt;
Var Nn,N1: LongInt;
Begin
 Nn:=RMb16(RMCp); Inc(RMCp,2); Dec(L,2); Nn:=Nn And $7FFF;
 If Nn>=$4000 Then GetNum:=Nn-$4000
 Else Begin N1:=RMb16(RMCp); Inc(RMCp,2); Dec(L,2); GetNum:=(Nn Shl 16) Or N1;
  End;
End;
Function Str8: String;
Var Nn,Z: LongInt; R: String;
Begin Nn:=RMB(RMCp); Inc(RMCp); R:=''; For Z:=0 To Nn-1 Do Begin If Z<250 Then
 R:=R+Chr(RMB(RMCp)); Inc(RMCp); End; Str8:=R; End;
{ paquet video : retourne 0 si une image est prete (placee dans Pk), 1 si
 partiel, <0 si erreur }
Function AssembleVideo(Var S: TRMStream; LenIn: LongInt; Var Pk: PEABuffer; Var
 PkLen: LongInt; Var Tstamp: Int64): LongInt;
Var Hdr,Seq,Pic,Len2,Pos3,Typ,L,Z,Ln,Kk: LongInt;
Begin
 AssembleVideo:=-1; Ln:=LenIn;
 Hdr:=RMB(RMCp); Inc(RMCp); Dec(Ln); Typ:=Hdr Shr 6;
 Seq:=0; Pic:=0; Len2:=0; Pos3:=0;
 If Typ<>3 Then Begin Seq:=RMB(RMCp); Inc(RMCp); Dec(Ln); End;
 If Typ<>1 Then Begin Len2:=GetNum(Ln); Pos3:=GetNum(Ln); Pic:=RMB(RMCp); Inc(
  RMCp); Dec(Ln); End;
 If Ln<0 Then Exit;
 RemLen:=Ln;
 If (Typ And 1)<>0 Then Begin
  If Typ=3 Then Begin Ln:=Len2; Tstamp:=Pos3; End;
  If RemLen<Ln Then Exit;
  Dec(RemLen,Ln);
  GetMem(Pk,Ln+9+16);
  Pk^[0]:=0; Pk^[1]:=1; Pk^[2]:=0; Pk^[3]:=0; Pk^[4]:=0; Pk^[5]:=0; Pk^[6]:=0;
   Pk^[7]:=0; Pk^[8]:=0;
  For Z:=0 To Ln-1 Do Pk^[9+Z]:=RMB(RMCp+Z);
  Inc(RMCp,Ln); PkLen:=Ln+9;
  AssembleVideo:=0; Exit;
 End;
 If ((Seq And $7F)=1) Or (S.CurPic<>Pic) Then Begin
  If Len2>RMSize Then Exit;
  S.Slices:=((Hdr And $3F) Shl 1)+1;
  S.VBufSize:=Len2+8*S.Slices+1;
  If S.VBuf<>Nil Then FreeMem(S.VBuf);
  GetMem(S.VBuf,S.VBufSize+64); FillChar(S.VBuf^,S.VBufSize+64,0);
  S.VBufPos:=8*S.Slices+1; S.CurSlice:=0; S.CurPic:=Pic;
 End;
 If Typ=2 Then If Pos3<Ln Then Ln:=Pos3;
 Inc(S.CurSlice);
 If S.CurSlice>S.Slices Then Begin AssembleVideo:=1; Exit; End;
 If S.VBuf=Nil Then Exit;
 L:=8*S.CurSlice-7;
 S.VBuf^[L]:=1; S.VBuf^[L+1]:=0; S.VBuf^[L+2]:=0; S.VBuf^[L+3]:=0;
 L:=8*S.CurSlice-3; Kk:=S.VBufPos-8*S.Slices-1;
 S.VBuf^[L]:=Kk And 255; S.VBuf^[L+1]:=(Kk Shr 8) And 255; S.VBuf^[L+2]:=(Kk Shr
  16) And 255; S.VBuf^[L+3]:=(Kk Shr 24) And 255;
 If S.VBufPos+Ln>S.VBufSize Then Begin AssembleVideo:=1; Exit; End;
 For Z:=0 To Ln-1 Do S.VBuf^[S.VBufPos+Z]:=RMB(RMCp+Z);
 Inc(RMCp,Ln); Inc(S.VBufPos,Ln); Dec(RemLen,Ln);
 If (Typ=2) Or (S.VBufPos=S.VBufSize) Then Begin
  S.VBuf^[0]:=S.CurSlice-1;
  If S.Slices<>S.CurSlice Then
   Move(S.VBuf^[1+8*S.Slices],S.VBuf^[1+8*S.CurSlice],S.VBufPos-1-8*S.Slices);
  PkLen:=S.VBufPos+8*(S.CurSlice-S.Slices);
  Pk:=S.VBuf; S.VBuf:=Nil;
  S.Slices:=0;
  AssembleVideo:=0; Exit;
 End;
 AssembleVideo:=1;
End;
Var Pk: PEABuffer; PkLen,R,X,Y,H,W,Sps,Cfs: LongInt; Tstamp: Int64; Tmp:
 PEABuffer; Z: LongInt; Ok: Boolean;
Begin
 NVLoad(Source,RMF,RMSize);
 RMNPk:=0; RMCap:=0; RMArenaLen:=0; RMArenaCap:=0; RMNS:=0; RMOld:=False;
 RMPkS:=Nil; RMPkF:=Nil; RMPkOff:=Nil; RMPkLen:=Nil; RMTsArr:=Nil; RMArena:=Nil;
 FillChar(RMSt,SizeOf(RMSt),0);
 If (RMB(0)=$2E) And (RMB(1)=$72) And (RMB(2)=$61) And (RMB(3)=$FD) Then Begin
  { ancien format .ra }
  RMOld:=True; RMCp:=4; RMNS:=1;
  RMSt[0].Id:=0;
  If Not RMReadAudioInfo(RMSt[0],True) Then Fail('rm: en-tete .ra invalide.');
  Pos2:=RMCp; Y:=1;
  While Pos2<RMSize Do Begin
   If RMSt[0].AudioFS=0 Then Len:=1000 Else Len:=RMSt[0].CodedFS*RMSt[0].SubH
    Div 2;
   If Len<=0 Then Break;
   If Pos2+Len>RMSize Then Len:=RMSize-Pos2;
   If Len<=0 Then Break;
   If RMSt[0].AudioFS=0 Then RMAddPacket(0,-1,Ord(Y=1)*2,PEABuffer(@RMF^[Pos2]),
    Len)
   Else Begin
    { memes regles de desentrelacement que les paquets RM }
    RMAddPacket(0,-1,Ord(Y=1)*2,PEABuffer(@RMF^[Pos2]),Len);
   End;
   Inc(Y); Inc(Pos2,Len);
  End;
  Exit;
 End;
 If RMTag(0)<>'.RMF' Then Fail('rm: signature .RMF requise.');
 TagSize:=RMb32(4); If TagSize<8 Then Fail('rm: en-tete invalide.');
 Pos2:=TagSize; DataOff:=0;
 While True Do Begin
  If Pos2+10>RMSize Then Fail('rm: bloc DATA introuvable.');
  Tg:=RMTag(Pos2); TagSize:=RMb32(Pos2+4);
  If (TagSize<10) And (Tg<>'DATA') Then Fail('rm: bloc invalide.');
  If Tg='DATA' Then Begin RMCp:=Pos2+10; Break; End;
  If Tg='MDPR' Then Begin
   If RMNS>=RM_MAXS Then Begin Inc(Pos2,TagSize); Continue; End;
   FillChar(RMSt[RMNS],SizeOf(TRMStream),0);
   RMSt[RMNS].CurPic:=-1;
   RMCp:=Pos2+10;
   RMSt[RMNS].Id:=RMb16(RMCp); Inc(RMCp,2);
   Inc(RMCp,4); RMSt[RMNS].Bitrate:=RMb32(RMCp); Inc(RMCp,4); Inc(RMCp,8); Inc(
    RMCp,12);
   Desc:=Str8; Mime:=Str8;
   Sz:=RMb32(RMCp); Inc(RMCp,4); CodecPos:=RMCp;
   If Sz>0 Then Begin
    V:=RMb32(RMCp);
    If V=$4D4C5449 Then Begin
     { MLTI : seul le premier MDPR est pris en compte }
     Inc(RMCp,4); K:=RMb16(RMCp); Inc(RMCp,2+2*K); Inc(RMCp,2); { nombre de MDPR
      }
     Sz:=RMb32(RMCp); Inc(RMCp,4); CodecPos:=RMCp; V:=RMb32(RMCp);
    End;
    If V=$2E7261FD Then Begin
     Inc(RMCp,4);
     If RMReadAudioInfo(RMSt[RMNS],False) Then Inc(RMNS);
    End Else If V=$4C53443A Then Begin
    End Else Begin
     If RMTag(RMCp+4)='VIDO' Then Begin
      RMSt[RMNS].Tag:=RMl32(RMCp+8);
      RMSt[RMNS].W:=RMb16(RMCp+12); RMSt[RMNS].H:=RMb16(RMCp+14);
      RMSt[RMNS].Fps:=RMb32(RMCp+22);
      RMSt[RMNS].ExtPos:=RMCp+26; RMSt[RMNS].ExtLen:=Sz-26;
      RMSt[RMNS].Kind:=2;
      Inc(RMNS);
     End;
    End;
   End;
  End;
  Inc(Pos2,TagSize);
 End;
 { donnees : nb de paquets (4), prochain en-tete (4) }
 Inc(RMCp,8);
 { rm_sync + rm_parse_packet }
 State:=$FFFFFFFF; AudioPktCnt:=0; RemLen:=0;
 While RMCp<RMSize Do Begin
  Len:=0;
  If RemLen>0 Then Begin Num:=CurStream; Len:=RemLen; Ts:=-1; Flags:=0; Mlti:=0;
   End
  Else Begin
   State:=((State Shl 8)+RMB(RMCp)) And $FFFFFFFF; Inc(RMCp);
   If State=$494E4458 Then Break;
   If (State>$FFFF) Or (State<=12) Then Continue;
   Len:=State-12; State:=$FFFFFFFF;
   If RMCp+8>RMSize Then Break;
   Num:=RMb16(RMCp); Ts:=RMb32(RMCp+2); Mlti:=(RMB(RMCp+6) Shr 1)-1; If Mlti<0
    Then Mlti:=0; Flags:=RMB(RMCp+7);
   Inc(RMCp,8);
  End;
  { recherche du flux }
  K:=-1; For I:=0 To RMNS-1 Do If RMSt[I].Id=Num Then Begin K:=I; Break; End;
  If (K<0) Or (Mlti<>0) Then Begin Inc(RMCp,Len); RemLen:=0; Continue; End;
  RemLen:=0;
  If RMSt[K].Kind=2 Then Begin
   CurStream:=RMSt[K].Id;
   Tstamp:=Ts;
   R:=AssembleVideo(RMSt[K],Len,Pk,PkLen,Tstamp);
   If R=0 Then Begin
    RMAddPacket(K,Tstamp,Flags,Pk,PkLen); FreeMem(Pk);
   End;
   If R<0 Then RemLen:=0;
  End Else If RMSt[K].Kind=1 Then Begin
   With RMSt[K] Do Begin
    If (Deint=$726E6567) Or (Deint=$34746E49) Or (Deint=$72706973) Then Begin
     Y:=SubCnt; W:=AudioFS; H:=SubH; Sps:=SubSize; Cfs:=CodedFS;
     If (Flags And 2)<>0 Then Begin Y:=0; SubCnt:=0; End;
     If Y=0 Then Begin ATs:=Ts; End;
     If Deint=$34746E49 Then Begin
      For X:=0 To H Div 2-1 Do Begin
       For Z:=0 To Cfs-1 Do ABuf^[X*2*W+Y*Cfs+Z]:=RMB(RMCp+Z);
       Inc(RMCp,Cfs);
      End;
     End Else If Deint=$726E6567 Then Begin
      For X:=0 To W Div Sps-1 Do Begin
       For Z:=0 To Sps-1 Do ABuf^[Sps*(H*X+((H+1) Div 2)*(Y And 1)+(Y Shr 1))+
        Z]:=RMB(RMCp+Z);
       Inc(RMCp,Sps);
      End;
     End Else Begin
      For Z:=0 To W-1 Do ABuf^[Y*W+Z]:=RMB(RMCp+Z);
      Inc(RMCp,W);
     End;
     Inc(SubCnt);
     If SubCnt>=H Then Begin
      SubCnt:=0;
      If BlockAlign>0 Then Begin
       N:=H*W Div BlockAlign;
       For X:=0 To N-1 Do Begin
        If X=0 Then RMAddPacket(K,ATs,2,PEABuffer(@ABuf^[0]),BlockAlign)
        Else RMAddPacket(K,-1,0,PEABuffer(@ABuf^[BlockAlign*X]),BlockAlign);
       End;
      End;
     End;
    End Else Begin
     RMAddPacket(K,Ts,Flags,PEABuffer(@RMF^[RMCp]),Len); Inc(RMCp,Len);
    End;
   End;
  End Else Inc(RMCp,Len);
 End;
End;

Procedure RMFree;
Begin
 If RMPkS<>Nil Then Begin FreeMem(RMPkS); FreeMem(RMPkF); FreeMem(RMPkOff);
  FreeMem(RMPkLen); FreeMem(RMTsArr); End;
 If RMArena<>Nil Then FreeMem(RMArena);
 FreeMem(RMF);
End;

