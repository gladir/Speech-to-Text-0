{ planarCopyWrapper : plan 16 bits (profondeur Bps, plage pleine) vers 8 bits,
 tramage ordonne (swscale_unscaled.c DITHER_COPY) }
Procedure H4SCopyDown(Src: PEABuffer; W,H,Bps: LongInt; Dst: PEABuffer;
 ShiftOnly: Boolean);
Var X,Y,Sh,V,Sl: LongInt;
Begin
 Sh:=Bps-8;
 { le tramage repart a zero a chaque tranche de la mise a l'echelle multi-fils
  (comme NVSliceJobs) }
 Sl:=(H+NVSliceJobs-1) Div NVSliceJobs; If Sl<1 Then Sl:=1;
 For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
  V:=Src^[(Y*W+X)*2]+Src^[(Y*W+X)*2+1]*256;
  If ShiftOnly Then Begin V:=(V+H4SDt[Sh-1,(Y Mod Sl) And 7,X And 7]) Shr Sh;
   Dst^[Y*W+X]:=V-(V Shr 8); End
  Else Dst^[Y*W+X]:=(V-(V Shr 8)+H4SDt[Sh-1,(Y Mod Sl) And 7,X And 7]) Shr Sh;
 End;
End;

{ planarCopyWrapper : YUV plus de 8 bits, plage limitee, meme
 sous-echantillonnage, vers 8 bits (decalage + tramage) }
Procedure H4SCopyYuvDown(Const F: H4SFm; Src: PEABuffer; Dhs,Dvs: LongInt; OY,
 OU,OV: PEABuffer);
Var Pl,X,Y,Sh,V,Sl,Al,PW,PH,Hh,Rel: LongInt; Off: Int64; Dt: PEABuffer;
Begin
 Sh:=F.Bps-8; Off:=0;
 Al:=1 Shl Dvs;
 Sl:=(F.H+NVSliceJobs-1) Div NVSliceJobs; If Sl<1 Then Sl:=1; Sl:=((Sl+Al-1) Div
  Al)*Al;
 For Pl:=0 To 2 Do Begin
  If Pl=0 Then Begin PW:=F.W; PH:=F.H; Dt:=OY; Hh:=Sl; End
  Else Begin PW:=F.CW; PH:=F.CH; If Pl=1 Then Dt:=OU Else Dt:=OV; Hh:=Sl Shr
   Dvs; If Hh<1 Then Hh:=1; End;
  For Y:=0 To PH-1 Do Begin
   Rel:=Y Mod Hh;
   For X:=0 To PW-1 Do Begin
    V:=Src^[Off+(Int64(Y)*PW+X)*2]+Src^[Off+(Int64(Y)*PW+X)*2+1]*256;
    V:=(V+H4SDt[Sh-1,Rel And 7,X And 7]) Shr Sh;
    Dt^[Y*PW+X]:=V-(V Shr 8);
   End;
  End;
  Off:=Off+Int64(PW)*PH*2;
 End;
End;

{ plan 8..16 bits vers 16 bits (profondeur 16) : replication des bits de poids
 fort }
Procedure H4SCopyUp(Src: PEABuffer; W,H,Bps: LongInt; Dst: PEABuffer);
Var I,V: LongInt;
Begin
 For I:=0 To W*H-1 Do Begin
  If Bps=8 Then V:=Src^[I] Else V:=Src^[I*2]+Src^[I*2+1]*256;
  V:=((V Shl (16-Bps)) Or (V Shr (2*Bps-16))) And $FFFF;
  Dst^[I*2]:=V And 255; Dst^[I*2+1]:=V Shr 8;
 End;
End;

Function H4SPx(P: PEABuffer; At,B: LongInt): LongInt;
Begin
 If B=1 Then H4SPx:=P^[At] Else H4SPx:=P^[At]+P^[At+1]*256;
End;

{ un plan : filtre horizontal (15 bits), conversion de plage, filtre vertical +
 tramage (swscale.c, hscale.c, output.c) }
Var H4SToJpeg: Boolean;
Procedure H4SPlane(Src: PEABuffer; SW,SH,B,Bps,DW,DH: LongInt; IsChroma,Full:
 Boolean; DOff: LongInt; Dst: PEABuffer);
Var HF,VF: TSwsF; HS,FS,X,Y,J,Shf,Dv: LongInt; H15: PSwsI32; Val: Int64; Dth:
 Boolean;
Begin
 SwsInitF(HF,SW,DW,128,128,16384); HS:=HF.FS;
 SwsInitF(VF,SH,DH,128,128,4096); FS:=VF.FS;
 GetMem(H15,Int64(SH)*DW*4+64);
 If Bps=8 Then Shf:=7 Else Shf:=Bps-1;
 Dth:=Bps>8;
 For Y:=0 To SH-1 Do For X:=0 To DW-1 Do Begin
  Val:=0;
  For J:=0 To HS-1 Do Val:=Val+Int64(H4SPx(Src,(Y*SW+HF.Pos^[X]+J)*B,B))*
   HF.Coef^[X*HS+J];
  Val:=AVSar(Val,Shf); If Val>32767 Then Val:=32767;
  Val:=Val And $FFFF; If Val>=32768 Then Val:=Val-65536;
  If Full Then Begin
   If IsChroma Then Val:=AVSar(Val*1799+4081085,11) Else Val:=AVSar(Val*14071+
    33561947,14);
   Val:=Val And $FFFF; If Val>=32768 Then Val:=Val-65536;
  End Else If H4SToJpeg Then Begin
   { plage limitee vers pleine (lumRangeToJpeg_c / chrRangeToJpeg_c) }
   If IsChroma Then Begin If Val>30775 Then Val:=30775; Val:=AVSar(Val*4663-
    9289992,12); End
   Else Begin If Val>30189 Then Val:=30189; Val:=AVSar(Val*19077-39057361,14);
    End;
   Val:=Val And $FFFF; If Val>=32768 Then Val:=Val-65536;
  End;
  H15^[Y*DW+X]:=Val;
 End;
 For Y:=0 To DH-1 Do
  For X:=0 To DW-1 Do Begin
   If Dth Then Dv:=H4SDith[Y And 7,(X+DOff) And 7] Else Dv:=64;
   Val:=Int64(Dv) Shl 12;
   For J:=0 To FS-1 Do Val:=Val+Int64(H15^[(VF.Pos^[Y]+J)*DW+X])*VF.Coef^[Y*FS+
    J];
   Val:=AVSar(Val,19); If Val<0 Then Val:=0 Else If Val>255 Then Val:=255;
   Dst^[Y*DW+X]:=Val;
  End;
 FreeMem(H15,Int64(SH)*DW*4+64); SwsFreeF(HF); SwsFreeF(VF);
End;

{ image source (plans consecutifs Y,U,V[,A]) -> yuv410p DW x DH }
Procedure H4SConv(Const F: H4SFm; Src: PEABuffer; DW,DH,Dhs,Dvs: LongInt; OY,OU,
 OV: PEABuffer);
Var B,DCW,DCH,Q: LongInt; Off: Int64; Cst: PEABuffer;
Begin
 If F.Bps>8 Then B:=2 Else B:=1;
 H4SPlane(Src,F.W,F.H,B,F.Bps,DW,DH,False,F.Full,0,OY);
 DCW:=(DW+(1 Shl Dhs)-1) Shr Dhs; DCH:=(DH+(1 Shl Dvs)-1) Shr Dvs;
 If F.Gray Then Begin
  { gris : les plans de chroma sont une constante 128 passee par les memes
   filtres (le tramage fait apparaitre 127/129) }
  GetMem(Cst,Int64(F.W)*F.H*B+64);
  If B=1 Then FillChar(Cst^,Int64(F.W)*F.H,128)
  Else For Q:=0 To F.W*F.H-1 Do Begin Cst^[Q*2]:=0; Cst^[Q*2+1]:=128 Shl (F.Bps-
   8) Shr 8; Cst^[Q*2]:=(128 Shl (F.Bps-8)) And 255; End;
  H4SPlane(Cst,F.W,F.H,B,F.Bps,DCW,DCH,True,F.Full,0,OU);
  H4SPlane(Cst,F.W,F.H,B,F.Bps,DCW,DCH,True,F.Full,3,OV);
  FreeMem(Cst);
 End Else Begin
  Off:=Int64(F.W)*F.H*B;
  H4SPlane(PEABuffer(@Src^[Off]),F.CW,F.CH,B,F.Bps,DCW,DCH,True,F.Full,0,OU);
  Off:=Off+Int64(F.CW)*F.CH*B;
  H4SPlane(PEABuffer(@Src^[Off]),F.CW,F.CH,B,F.Bps,DCW,DCH,True,F.Full,3,OV);
 End;
End;

{ ---- encodeurs Targa et TIFF : lecture de la premiere image Y4M ---- }
Var
 G1YW,G1YH,G1YCw,G1YCh,G1YKind,G1YSarN,G1YSarD,G1YLoc: LongInt; G1BlackCol,
  G1YFull,G1YAlpha: Boolean;
 G1YY,G1YU,G1YV,G1YA,G1Raw: PEABuffer; G1Fm: H4SFm;
 { G1YKind : 0 mono 8 bits, 1 4:2:0, 2 4:2:2, 3 4:4:4, 4 4:1:1, 5 autre (plus de
  8 bits) ; G1YLoc : 0 inconnu, 1 centre, 2 gauche, 3 haut-gauche }

Procedure G1LoadY4M(Const Source: String; Const Who: String);
Var
 Cur,Limit,At,Q,K,Code,Sz,Hl,Bp: LongInt; H: Array[0..255] Of Byte; Line,Token,
  Ctag: String; Fn,Fd,Sn,Sd: LongInt; Il: Char; Okh: Boolean;
Begin
 OpenRead(Source); Limit:=InputSize; Cur:=0; Line:='';
 While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break; If
  Length(Line)<250 Then Line:=Line+Chr(H[0]); End;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail(Who+': entree Y4M requise.');
 H4SParseHdr(Line,G1Fm,Fn,Fd,Sn,Sd,Il);
 G1YW:=G1Fm.W; G1YH:=G1Fm.H; G1YSarN:=Sn; G1YSarD:=Sd; G1YLoc:=1; G1YFull:=
  G1Fm.Full; G1YAlpha:=G1Fm.Alpha;
 Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  If Token[1]='C' Then Begin
   Ctag:=Copy(Token,2,40);
   If Copy(Ctag,1,7)='420jpeg' Then G1YLoc:=1 Else If Copy(Ctag,1,8)='420mpeg2'
    Then G1YLoc:=2 Else If Copy(Ctag,1,8)='420paldv' Then G1YLoc:=3
   Else If Copy(Ctag,1,3)='420' Then G1YLoc:=0;
  End;
 End;
 If (G1YW<1) Or (G1YH<1) Or (G1YW>16000) Or (G1YH>16000) Then Fail(Who+
  ': dimensions Y4M incorrectes.');
 G1YCw:=G1Fm.CW; G1YCh:=G1Fm.CH;
 If G1Fm.Bps>8 Then G1YKind:=5
 Else If G1Fm.Gray Then G1YKind:=0
 Else If (G1Fm.Hs=1) And (G1Fm.Vs=1) Then G1YKind:=1
 Else If (G1Fm.Hs=1) And (G1Fm.Vs=0) Then G1YKind:=2
 Else If (G1Fm.Hs=0) And (G1Fm.Vs=0) Then G1YKind:=3
 Else G1YKind:=4;
 { en-tete FRAME }
 Hl:=0; Okh:=False;
 While (Hl<=80) And (Cur+Hl<Limit) Do Begin ReadAt(Cur+Hl,H,1); If H[0]=10 Then
  Begin Okh:=True; Break; End; Inc(Hl); End;
 If Not Okh Then Fail(Who+': aucune image Y4M.');
 ReadAt(Cur,H,5); If (H[0]<>70) Or (H[1]<>82) Then Fail(Who+
  ': marqueur FRAME requis.');
 Cur:=Cur+Hl+1;
 If Int64(Cur)+G1Fm.FrameBytes>Limit Then Fail(Who+': aucune image Y4M.');
 GetMem(G1Raw,G1Fm.FrameBytes+64); FillChar(G1Raw^,G1Fm.FrameBytes+64,0);
 Sz:=G1Fm.FrameBytes; At:=0;
 While At<Sz Do Begin If Sz-At>60000 Then Q:=60000 Else Q:=Sz-At; ReadAt(Cur+At,
  G1Raw^[At],Q); Inc(At,Q); End;
 CloseRead;
 If G1Fm.Bps>8 Then Bp:=2 Else Bp:=1;
 G1YY:=G1Raw; G1YU:=PEABuffer(@G1Raw^[Int64(G1YW)*G1YH*Bp]);
 G1YV:=PEABuffer(@G1Raw^[Int64(G1YW)*G1YH*Bp+Int64(G1YCw)*G1YCh*Bp]);
 G1YA:=PEABuffer(@G1Raw^[Int64(G1YW)*G1YH*Bp+2*Int64(G1YCw)*G1YCh*Bp]);
End;

{ YUV 8 bits (4:2:0, 4:2:2, 4:4:4, 4:1:1) -> RGB (swscale yuv2rgb_c /
 yuv2rgb_X_c / yuv2rgb_full_X_c) : Out = W*H*3 octets R,G,B.
  Chemin non mis a l'echelle (420/422 et hauteur paire), sinon chemin mis a
   l'echelle : interpolation pleine de la chroma
  (largeur impaire ou 4:4:4) ou chroma a demi-largeur ; filtres bicubiques
   horizontal puis vertical. }
Procedure G1Yuv420ToRgb(Out: PEABuffer);
Var
 Tab: Array[0..2047] Of Byte; Crv,Cbu,Cgu,Cgv,Cy,Oy,Yb: Int64; Yoffs,Ix,X,Y,Yv,
  Uv,Vv,J,FS,Bp,Xc,CW2,Cr: LongInt;
 VF,HF: TSwsF; Su,Sv,Yf,Rr,Gg,Bb: Int64; HS,Cyy,Cyo,Cv2r,Cv2g,Cu2g,Cu2b:
  LongInt; HU,HV: PSwsI32; One,Unscaled,FullP: Boolean;
 Bps,Shf,ChH,ChV: LongInt; Y15: Int64;
Function Smp(P: PEABuffer; I: LongInt): LongInt;
Begin If Bps>8 Then Smp:=P^[I*2]+P^[I*2+1]*256 Else Smp:=P^[I]; End;
Function Lum15(I: LongInt): Int64;
Begin If Bps<=15 Then Lum15:=Int64(Smp(G1YY,I)) Shl (15-Bps) Else Lum15:=Smp(
 G1YY,I) Shr 1; End;
Function Clip(V: LongInt): LongInt;Begin If V<0 Then Clip:=0 Else If V>255 Then
 Clip:=255 Else Clip:=V; End;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-((-V+(Int64(1) Shl N)-1) Shr N); End;
Function RI16(F: Int64): LongInt;
Var R: Int64;
Begin
 R:=Sar(F+32768,16); If R<-32767 Then R:=-32768 Else If R>32767 Then R:=32767;
  RI16:=R;
End;
Function TabAt(I: LongInt): LongInt;
Begin If I<0 Then TabAt:=Tab[0] Else If I>2047 Then TabAt:=Tab[2047] Else
 TabAt:=Tab[I]; End;
Procedure PutRgb(Xp,Yp,Yv2,Uv2,Vv2: LongInt);
Begin
 { les tables table_rV/gU/gV/bU de swscale bornent la chroma a 0..255 }
 Uv2:=Clip(Uv2); Vv2:=Clip(Vv2);
 Out^[(Yp*G1YW+Xp)*3]:=TabAt(Yoffs-Sar(Crv,9)+Sar(Int64(Vv2)*Crv,16)+Yv2);
 Out^[(Yp*G1YW+Xp)*3+1]:=TabAt(Yoffs-Sar(Cgu,9)+Sar(Int64(Uv2)*Cgu,16)-Sar(Cgv,
  9)+Sar(Int64(Vv2)*Cgv,16)+Yv2);
 Out^[(Yp*G1YW+Xp)*3+2]:=TabAt(Yoffs-Sar(Cbu,9)+Sar(Int64(Uv2)*Cbu,16)+Yv2);
End;
Begin
 If G1YFull Then Begin
  Cy:=65536; Oy:=0;
  Crv:=(Int64(104597)*224) Div 255; Cbu:=(Int64(132201)*224) Div 255;
  Cgu:=-((Int64(25675)*224) Div 255); Cgv:=-((Int64(53279)*224) Div 255);
  Yoffs:=384+512;
 End Else Begin
  Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16;
  Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279;
  Yoffs:=326+512;
 End;
 Cyy:=RI16(Cy*8192); Cyo:=RI16(Oy*512); Cv2r:=RI16(Crv*8192); Cv2g:=RI16(Cgv*
  8192); Cu2g:=RI16(Cgu*8192); Cu2b:=RI16(Cbu*8192);
 Crv:=((Crv Shl 16)+$8000) Div Cy; Cbu:=((Cbu Shl 16)+$8000) Div Cy;
 Cgu:=(Cgu*65536+$8000) Div Cy; Cgv:=(Cgv*65536+$8000) Div Cy;
 Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For Ix:=0 To 2047 Do Begin Tab[Ix]:=Clip(Sar(Yb+$8000,16)); Yb:=Yb+Cy; End;
 G1BlackCol:=False;
 Bps:=G1Fm.Bps; If Bps=8 Then Shf:=7 Else Shf:=Bps-1;
 ChH:=G1Fm.Hs; ChV:=G1Fm.Vs;
 Unscaled:=((G1YKind=1) Or (G1YKind=2)) And Not Odd(G1YH);
 FullP:=Not Unscaled And (Odd(G1YW) Or ((ChH=0) And (ChV=0)));
 If FullP Then Begin
  { interpolation pleine de la chroma (yuv2rgb_full_X_c) }
  SwsInitF(HF,G1YCw,G1YW,128,128,16384); HS:=HF.FS;
  GetMem(HU,Int64(G1YCh)*G1YW*4+64); GetMem(HV,Int64(G1YCh)*G1YW*4+64);
  For Y:=0 To G1YCh-1 Do For X:=0 To G1YW-1 Do Begin
   Su:=0; Sv:=0;
   For J:=0 To HS-1 Do Begin
    Su:=Su+Int64(Smp(G1YU,Y*G1YCw+HF.Pos^[X]+J))*HF.Coef^[X*HS+J]; Sv:=Sv+Int64(
     Smp(G1YV,Y*G1YCw+HF.Pos^[X]+J))*HF.Coef^[X*HS+J];
   End;
   Su:=AVSar(Su,Shf); If Su>32767 Then Su:=32767; Sv:=AVSar(Sv,Shf); If Sv>32767
    Then Sv:=32767;
   HU^[Y*G1YW+X]:=Su; HV^[Y*G1YW+X]:=Sv;
  End;
  SwsInitF(VF,G1YCh,G1YH,128,128,4096); FS:=VF.FS;
  For Y:=0 To G1YH-1 Do Begin
   One:=(FS=2) And (VF.Coef^[Y*FS]+VF.Coef^[Y*FS+1]=4096) And (VF.Coef^[Y*FS+
    1]>=0) And (VF.Coef^[Y*FS+1]<=4096);
   For X:=0 To G1YW-1 Do Begin
    If One Then Begin
     { yuv2rgb_full_1_c : une ligne, ou moyenne de deux lignes de chroma }
     Bp:=VF.Pos^[Y]*G1YW+X;
     If VF.Coef^[Y*FS+1]<2048 Then Begin
      Uv:=(Int64(HU^[Bp])-(128 Shl 7))*4; Vv:=(Int64(HV^[Bp])-(128 Shl 7))*4;
     End Else Begin
      Uv:=(Int64(HU^[Bp])+HU^[Bp+G1YW]-(128 Shl 8))*2; Vv:=(Int64(HV^[Bp])+HV^[
       Bp+G1YW]-(128 Shl 8))*2;
     End;
    End Else Begin
    Su:=(Int64(1) Shl 9)-(Int64(128) Shl 19); Sv:=Su;
    For J:=0 To FS-1 Do Begin
     Bp:=(VF.Pos^[Y]+J)*G1YW+X;
     Su:=Su+Int64(HU^[Bp])*VF.Coef^[Y*FS+J]; Sv:=Sv+Int64(HV^[Bp])*VF.Coef^[Y*
      FS+J];
    End;
    Uv:=Sar(Su,10); Vv:=Sar(Sv,10);
    End;
    Yf:=(Lum15(Y*G1YW+X) Shl 2)-Cyo;
    Yf:=Yf*Cyy+(Int64(1) Shl 21);
    Rr:=Yf+Int64(Vv)*Cv2r; Gg:=Yf+Int64(Vv)*Cv2g+Int64(Uv)*Cu2g; Bb:=Yf+Int64(
     Uv)*Cu2b;
    { arithmetique 32 bits de swscale (debordement possible) }
    Rr:=Rr And $FFFFFFFF; If Rr>=2147483648 Then Rr:=Rr-4294967296;
    Gg:=Gg And $FFFFFFFF; If Gg>=2147483648 Then Gg:=Gg-4294967296;
    Bb:=Bb And $FFFFFFFF; If Bb>=2147483648 Then Bb:=Bb-4294967296;
    If Rr<0 Then Rr:=0 Else If Rr>1073741823 Then Rr:=1073741823;
    If Gg<0 Then Gg:=0 Else If Gg>1073741823 Then Gg:=1073741823;
    If Bb<0 Then Bb:=0 Else If Bb>1073741823 Then Bb:=1073741823;
    Out^[(Y*G1YW+X)*3]:=Rr Shr 22; Out^[(Y*G1YW+X)*3+1]:=Gg Shr 22; Out^[(Y*
     G1YW+X)*3+2]:=Bb Shr 22;
   End;
  End;
  SwsFreeF(VF); SwsFreeF(HF); FreeMem(HU); FreeMem(HV);
  Exit;
 End;
 If Not Unscaled Then Begin
  { chroma a demi-largeur : filtre horizontal puis vertical, yuv2rgb_X_c / _1_c
   (yuv2rgb_template) }
  CW2:=G1YW Div 2;
  SwsInitF(HF,G1YCw,CW2,128,128,16384); HS:=HF.FS;
  GetMem(HU,Int64(G1YCh)*CW2*4+64); GetMem(HV,Int64(G1YCh)*CW2*4+64);
  For Y:=0 To G1YCh-1 Do For X:=0 To CW2-1 Do Begin
   Su:=0; Sv:=0;
   For J:=0 To HS-1 Do Begin
    Su:=Su+Int64(Smp(G1YU,Y*G1YCw+HF.Pos^[X]+J))*HF.Coef^[X*HS+J]; Sv:=Sv+Int64(
     Smp(G1YV,Y*G1YCw+HF.Pos^[X]+J))*HF.Coef^[X*HS+J];
   End;
   Su:=AVSar(Su,Shf); If Su>32767 Then Su:=32767; Sv:=AVSar(Sv,Shf); If Sv>32767
    Then Sv:=32767;
   HU^[Y*CW2+X]:=Su; HV^[Y*CW2+X]:=Sv;
  End;
  SwsInitF(VF,G1YCh,G1YH,128,128,4096); FS:=VF.FS;
  For Y:=0 To G1YH-1 Do Begin
   One:=(FS=2) And (VF.Coef^[Y*FS]+VF.Coef^[Y*FS+1]=4096) And (VF.Coef^[Y*FS+
    1]>=0) And (VF.Coef^[Y*FS+1]<=4096);
   For X:=0 To G1YW-1 Do Begin
    Xc:=X Shr 1;
    If FS=1 Then Begin
     Bp:=VF.Pos^[Y]*CW2+Xc;
     Uv:=AVSar(Int64(HU^[Bp])+64,7); Vv:=AVSar(Int64(HV^[Bp])+64,7);
    End Else If One Then Begin
     Bp:=VF.Pos^[Y]*CW2+Xc;
     If VF.Coef^[Y*FS+1]<2048 Then Begin Uv:=AVSar(Int64(HU^[Bp])+64,7); Vv:=
      AVSar(Int64(HV^[Bp])+64,7); End
     Else Begin Uv:=AVSar(Int64(HU^[Bp])+HU^[Bp+CW2]+128,8); Vv:=AVSar(Int64(
      HV^[Bp])+HV^[Bp+CW2]+128,8); End;
    End Else Begin
     Su:=Int64(1) Shl 18; Sv:=Int64(1) Shl 18;
     For J:=0 To FS-1 Do Begin
      Bp:=(VF.Pos^[Y]+J)*CW2+Xc;
      Su:=Su+Int64(HU^[Bp])*VF.Coef^[Y*FS+J]; Sv:=Sv+Int64(HV^[Bp])*VF.Coef^[Y*
       FS+J];
     End;
     Uv:=AVSar(Su,19); Vv:=AVSar(Sv,19);
    End;
    PutRgb(X,Y,Sar(Lum15(Y*G1YW+X)+64,7),Uv,Vv);
   End;
  End;
  SwsFreeF(VF); SwsFreeF(HF); FreeMem(HU); FreeMem(HV);
  Exit;
 End;
 G1BlackCol:=Odd(G1YW);
 For Y:=0 To G1YH-1 Do For X:=0 To G1YW-1 Do Begin
  If Odd(G1YW) And (X=G1YW-1) Then Begin
   { le chemin non mis a l'echelle de swscale ne convertit pas le dernier pixel
    d'une largeur impaire }
   Out^[(Y*G1YW+X)*3]:=0; Out^[(Y*G1YW+X)*3+1]:=0; Out^[(Y*G1YW+X)*3+2]:=0;
    Continue;
  End;
  If G1YKind=2 Then Cr:=Y And Not 1 Else Cr:=Y Shr 1;
  PutRgb(X,Y,G1YY^[Y*G1YW+X],G1YU^[Cr*G1YCw+(X Shr 1)],G1YV^[Cr*G1YCw+(X Shr
   1)]);
 End;
End;

{ gris 8 bits (plage pleine) -> RGB : replication }
Procedure G1GrayToRgb(Out: PEABuffer);
Var I,V: LongInt; Yf: Int64;
Begin
 If G1YKind=5 Then Begin
  { gris plus de 8 bits : Y15 = v << (15-bps), (Y15+64)>>7 }
  For I:=0 To G1YW*G1YH-1 Do Begin
   If G1Fm.Bps<=15 Then V:=(G1YY^[I*2]+G1YY^[I*2+1]*256) Shl (15-G1Fm.Bps) Else
    V:=(G1YY^[I*2]+G1YY^[I*2+1]*256) Shr 1;
   If G1YFull Then Begin V:=(V+64) Shr 7; If V>255 Then V:=255; End
   Else Begin
    { plage limitee explicite : coefficients YUV limites, chroma nulle
     (yuv2rgb_full) }
    Yf:=((Int64(V) Shl 2)-8192)*9539+(Int64(1) Shl 21);
    Yf:=Yf And $FFFFFFFF; If Yf>=2147483648 Then Yf:=Yf-4294967296;
    If Yf<0 Then Yf:=0 Else If Yf>1073741823 Then Yf:=1073741823;
    V:=Yf Shr 22;
   End;
   Out^[I*3]:=V; Out^[I*3+1]:=V; Out^[I*3+2]:=V;
  End;
 End Else
 For I:=0 To G1YW*G1YH-1 Do Begin Out^[I*3]:=G1YY^[I]; Out^[I*3+1]:=G1YY^[I];
  Out^[I*3+2]:=G1YY^[I]; End;
 G1BlackCol:=False;
End;

{ YUV (8 a 16 bits) -> RGB48LE (swscale : hScale8To19/hScale16To19, yuv2rgba64_X
 / _1 / full) : Out = W*H*6 octets R,G,B en mots 16 bits petit-boutiste }
Procedure G1YuvToRgb48(Out: PEABuffer);
Var
 Crv,Cbu,Cgu,Cgv,Cy,Oy: Int64; X,Y,J,FS,Bp,Xc,CWd,Bps,Sh19: LongInt;
 VF,HF: TSwsF; Su,Sv,Yy,Uu,Vv,Rr,Gg,Bb: Int64; HS,Cyy,Cyo,Cv2r,Cv2g,Cu2g,Cu2b:
  LongInt; HU,HV: PSwsI32; One,FullP: Boolean;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-((-V+(Int64(1) Shl N)-1) Shr N); End;
Function RI16(F: Int64): LongInt;
Var R: Int64;
Begin R:=Sar(F+32768,16); If R<-32767 Then R:=-32768 Else If R>32767 Then R:=
 32767; RI16:=R; End;
Function W32(V: Int64): Int64;
Begin V:=V And $FFFFFFFF; If V>=2147483648 Then V:=V-4294967296; W32:=V; End;
Function Smp(P: PEABuffer; I: LongInt): LongInt;
Begin If Bps>8 Then Smp:=P^[I*2]+P^[I*2+1]*256 Else Smp:=P^[I]; End;
Function Lum19(I: LongInt): Int64;
Begin Lum19:=Int64(Smp(G1YY,I)) Shl (19-Bps); End;
Function C16(V: Int64): Int64;
Begin If V<0 Then C16:=0 Else If V>65535 Then C16:=65535 Else C16:=V; End;
Procedure Put(Xp,Yp: LongInt; Y19,U,V: Int64);
{ Y19 : luma deja ramene a 17 bits (>>2 ou equivalent) ; U,V : chroma 17 bits
 centree }
Var Yt,R,G,B: Int64;
Begin
 Yt:=W32(Y19-Cyo);
 Yt:=W32(Yt*Cyy);
 Yt:=W32(Yt+(Int64(1) Shl 13)-(Int64(1) Shl 29));
 R:=W32(V*Cv2r); G:=W32(V*Cv2g+U*Cu2g); B:=W32(U*Cu2b);
 Rr:=C16(Sar(W32(R+Yt),14)+(1 Shl 15)); Gg:=C16(Sar(W32(G+Yt),14)+(1 Shl 15));
  Bb:=C16(Sar(W32(B+Yt),14)+(1 Shl 15));
 Out^[(Yp*G1YW+Xp)*6]:=Rr And 255; Out^[(Yp*G1YW+Xp)*6+1]:=Rr Shr 8;
 Out^[(Yp*G1YW+Xp)*6+2]:=Gg And 255; Out^[(Yp*G1YW+Xp)*6+3]:=Gg Shr 8;
 Out^[(Yp*G1YW+Xp)*6+4]:=Bb And 255; Out^[(Yp*G1YW+Xp)*6+5]:=Bb Shr 8;
End;
Begin
 Bps:=G1Fm.Bps; If Bps=8 Then Sh19:=3 Else Sh19:=Bps-5;
 If G1YFull Then Begin
  Cy:=65536; Oy:=0;
  Crv:=(Int64(104597)*224) Div 255; Cbu:=(Int64(132201)*224) Div 255;
  Cgu:=-((Int64(25675)*224) Div 255); Cgv:=-((Int64(53279)*224) Div 255);
 End Else Begin
  Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16;
  Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279;
 End;
 Cyy:=RI16(Cy*8192); Cyo:=RI16(Oy*512); Cv2r:=RI16(Crv*8192); Cv2g:=RI16(Cgv*
  8192); Cu2g:=RI16(Cgu*8192); Cu2b:=RI16(Cbu*8192);
 FullP:=Odd(G1YW) Or ((G1Fm.Hs=0) And (G1Fm.Vs=0));
 If FullP Then CWd:=G1YW Else CWd:=G1YW Div 2;
 SwsInitF(HF,G1YCw,CWd,128,128,16384); HS:=HF.FS;
 GetMem(HU,Int64(G1YCh)*CWd*4+64); GetMem(HV,Int64(G1YCh)*CWd*4+64);
 For Y:=0 To G1YCh-1 Do For X:=0 To CWd-1 Do Begin
  Su:=0; Sv:=0;
  For J:=0 To HS-1 Do Begin
   Su:=Su+Int64(Smp(G1YU,Y*G1YCw+HF.Pos^[X]+J))*HF.Coef^[X*HS+J]; Sv:=Sv+Int64(
    Smp(G1YV,Y*G1YCw+HF.Pos^[X]+J))*HF.Coef^[X*HS+J];
  End;
  Su:=AVSar(Su,Sh19); If Su>524287 Then Su:=524287; Sv:=AVSar(Sv,Sh19); If
   Sv>524287 Then Sv:=524287;
  HU^[Y*CWd+X]:=Su; HV^[Y*CWd+X]:=Sv;
 End;
 SwsInitF(VF,G1YCh,G1YH,128,128,4096); FS:=VF.FS;
 For Y:=0 To G1YH-1 Do Begin
  One:=(FS=2) And (VF.Coef^[Y*FS]+VF.Coef^[Y*FS+1]=4096) And (VF.Coef^[Y*FS+
   1]>=0) And (VF.Coef^[Y*FS+1]<=4096);
  For X:=0 To G1YW-1 Do Begin
   If FullP Then Xc:=X Else Xc:=X Shr 1;
   Yy:=Sar(Lum19(Y*G1YW+X),2);
   If FS=1 Then Begin
    Bp:=VF.Pos^[Y]*CWd+Xc;
    Uu:=Sar(Int64(HU^[Bp])-(128 Shl 11),2); Vv:=Sar(Int64(HV^[Bp])-(128 Shl 11),
     2);
   End Else If One Then Begin
    Bp:=VF.Pos^[Y]*CWd+Xc;
    If VF.Coef^[Y*FS+1]<2048 Then Begin Uu:=Sar(Int64(HU^[Bp])-(128 Shl 11),2);
     Vv:=Sar(Int64(HV^[Bp])-(128 Shl 11),2); End
    Else Begin Uu:=Sar(Int64(HU^[Bp])+HU^[Bp+CWd]-(128 Shl 12),3); Vv:=Sar(
     Int64(HV^[Bp])+HV^[Bp+CWd]-(128 Shl 12),3); End;
   End Else Begin
    Su:=-(Int64(128) Shl 23); Sv:=Su;
    For J:=0 To FS-1 Do Begin
     Bp:=(VF.Pos^[Y]+J)*CWd+Xc;
     Su:=Su+Int64(HU^[Bp])*VF.Coef^[Y*FS+J]; Sv:=Sv+Int64(HV^[Bp])*VF.Coef^[Y*
      FS+J];
    End;
    Uu:=Sar(W32(Su),14); Vv:=Sar(W32(Sv),14);
   End;
   Put(X,Y,Yy,Uu,Vv);
  End;
 End;
 SwsFreeF(VF); SwsFreeF(HF); FreeMem(HU); FreeMem(HV);
End;

{ luma -> monob / monow (swscale : yuv2mono_1_c / yuv2mono_X_c, tramage ordonne
 ff_dither_8x8_220) : Out = ((W+7) Div 8)*H octets }
Procedure G1ToMono(Out: PEABuffer; White: Boolean);
Const
 Dt220: Array[0..7,0..7] Of Byte=((117,62,158,103,113,58,155,100),(34,199,21,
  186,31,196,17,182),(144,89,131,76,141,86,127,72),(0,165,41,206,10,175,52,217),
  (110,55,151,96,120,65,162,107),(28,193,14,179,38,203,24,189),(138,83,124,69,
   148,93,134,79),(7,172,48,213,3,168,45,210));
Var
 Bpr,X,Y,B,Acc,I,FS,Ch0,Bps,Yoffs,Ix,Adj: LongInt; VF: TSwsF; UseX,One: Boolean;
 Cy,Oy,Cgu,Cgv,Yb: Int64; Tab: Array[0..2047] Of Byte;
Function Sar2(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar2:=V Shr N Else Sar2:=-((-V+(Int64(1) Shl N)-1) Shr N);
 End;
Function Ypx(Xp,Yp: LongInt): LongInt;
Var V: Int64;
Begin
 If Xp>=G1YW Then Begin Ypx:=128; Exit; End;
 If Bps>8 Then V:=G1YY^[(Yp*G1YW+Xp)*2]+G1YY^[(Yp*G1YW+Xp)*2+1]*256 Else V:=
  G1YY^[Yp*G1YW+Xp];
 If Bps<=8 Then V:=V Shl 7 Else If Bps<=15 Then V:=V Shl (15-Bps) Else V:=V Shr
  1;
 V:=(V+64) Shr 7;
 If UseX And ((V And $100)<>0) Then Begin If V<0 Then V:=0 Else If V>255 Then
  V:=255; End;
 Ypx:=V;
End;
Begin
 Bps:=G1Fm.Bps; Bpr:=(G1YW+7) Shr 3;
 If (Not White) And ((G1YKind=1) Or (G1YKind=2)) And Not Odd(G1YH) Then Begin
  { chemin non mis a l'echelle yuv2rgb_c_1_ordered_dither (monob, 420/422 8
   bits, hauteur paire) : groupes de 8 pixels seulement }
  If G1YFull Then Begin
   Cy:=65536; Oy:=0; Cgu:=-((Int64(25675)*224) Div 255); Cgv:=-((Int64(53279)*
    224) Div 255); Yoffs:=384+512;
  End Else Begin
   Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16; Cgu:=-25675; Cgv:=-
    53279; Yoffs:=326+512;
  End;
  Cgu:=(Cgu*65536+$8000) Div Cy; Cgv:=(Cgv*65536+$8000) Div Cy;
  Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
  For Ix:=0 To 2047 Do Begin
   Tab[Ix]:=Sar2(Yb+$8000,16)+0; Yb:=Yb+Cy;
  End;
  Adj:=-Sar2(Cgu,9)+Sar2(128*Cgu,16)-Sar2(Cgv,9)+Sar2(128*Cgv,16);
  FillChar(Out^,Int64(Bpr)*G1YH,0);
  For Y:=0 To G1YH-1 Do
   For B:=0 To (G1YW Shr 3)-1 Do Begin
    Acc:=0;
    For I:=0 To 7 Do Begin
     Ix:=Yoffs+Adj+G1YY^[Y*G1YW+B*8+I]+Dt220[Y And 7,I]-110;
     If Ix<0 Then Ix:=0 Else If Ix>2047 Then Ix:=2047;
     Acc:=(Acc Shl 1) Or ((Tab[Ix] Shr 7) And 1);
    End;
    Out^[Y*Bpr+B]:=Acc And 255;
   End;
  Exit;
 End;
 If G1Fm.Gray Then Ch0:=G1YH Else Ch0:=G1YCh;
 SwsInitF(VF,Ch0,G1YH,128,128,4096); FS:=VF.FS;
 One:=(FS=2) And (VF.Coef^[0]+VF.Coef^[1]=4096) And (VF.Coef^[1]>=0) And (
  VF.Coef^[1]<=4096);
 SwsFreeF(VF);
 UseX:=Not ((FS=1) Or One);
 { le choix packed1/X est identique pour toutes les lignes : verifie sur la
  ligne 0 seulement }
 For Y:=0 To G1YH-1 Do Begin
  If Not UseX Then Begin
   For B:=0 To Bpr-1 Do Begin
    Acc:=0;
    For I:=0 To 7 Do Begin
     Acc:=Acc Shl 1;
     If Ypx(B*8+I,Y)+Dt220[Y And 7,I]>=234 Then Acc:=Acc Or 1;
    End;
    If White Then Acc:=Not Acc;
    Out^[Y*Bpr+B]:=Acc And 255;
   End;
  End Else Begin
   Acc:=0; B:=0; X:=0;
   While X<G1YW Do Begin
    Acc:=(Acc Shl 1) Or Ord(Ypx(X,Y)+Dt220[Y And 7,X And 7]>=234);
    Acc:=(Acc Shl 1) Or Ord(Ypx(X+1,Y)+Dt220[Y And 7,(X+1) And 7]>=234);
    Acc:=Acc And $FFFF;
    If (X And 7)=6 Then Begin
     If White Then Out^[Y*Bpr+B]:=Not Acc And 255 Else Out^[Y*Bpr+B]:=Acc And
      255;
     Inc(B);
    End;
    Inc(X,2);
   End;
   If (X And 6)<>0 Then Begin
    If White Then Out^[Y*Bpr+B]:=Not Acc And 255 Else Out^[Y*Bpr+B]:=Acc And
     255;
   End;
  End;
 End;
End;

{ yuv420p (plage limitee) -> gray (plage pleine), comme pgm }
Procedure G1YuvToGray(Out: PEABuffer);
Var X,Y: LongInt; GV: Int64;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-((-V+(Int64(1) Shl N)-1) Shr N); End;
Begin
 If G1YFull Then Begin Move(G1YY^,Out^,G1YW*G1YH); Exit; End;
 For Y:=0 To G1YH-1 Do For X:=0 To G1YW-1 Do Begin
  GV:=G1YY^[Y*G1YW+X] Shl 7; If GV>30189 Then GV:=30189;
  GV:=Sar(GV*19077-39057361,14);
  GV:=Sar(GV+64,7); If GV<0 Then GV:=0; If GV>255 Then GV:=255;
  Out^[Y*G1YW+X]:=GV;
 End;
End;

{ ff_rle_count_pixels / ff_rle_encode (libavcodec/rle.c) }
Function G1RleCount(S: PEABuffer; At,Len,Bpp: LongInt; Same: Boolean): LongInt;
Var Pos,Count,Lim: LongInt; Eq: Boolean;
Begin
 Count:=1; Pos:=At+Bpp; If Len<127 Then Lim:=Len Else Lim:=127;
 While Count<Lim Do Begin
  Eq:=CompareByte(S^[Pos-Bpp],S^[Pos],Bpp)=0;
  If Same<>Eq Then Begin
   If Not Same Then Begin
    If (Bpp=1) And (Count+1<Lim) And (S^[Pos]<>S^[Pos+1]) Then Begin Inc(Pos,
     Bpp); Inc(Count); Continue; End;
    Dec(Count);
   End;
   Break;
  End;
  Inc(Pos,Bpp); Inc(Count);
 End;
 G1RleCount:=Count;
End;
{ retourne le nombre d'octets ecrits ou -1 ; AddRep/XorRep/AddRaw/XorRaw comme
 ff_rle_encode }
Function G1RleEnc(Out: PEABuffer; OutSize: LongInt; Src: PEABuffer; SrcOfs,Bpp,
 W,AddRep,XorRep,AddRaw,XorRaw: LongInt): LongInt;
Var Count,X,O,P: LongInt;
Begin
 O:=0; X:=0; P:=SrcOfs;
 While X<W Do Begin
  Count:=G1RleCount(Src,P,W-X,Bpp,True);
  If Count>1 Then Begin
   If O+Bpp+1>OutSize Then Begin G1RleEnc:=-1; Exit; End;
   Out^[O]:=((Count Xor XorRep)+AddRep) And 255; Inc(O);
   Move(Src^[P],Out^[O],Bpp); Inc(O,Bpp);
  End Else Begin
   Count:=G1RleCount(Src,P,W-X,Bpp,False);
   If O+Bpp*Count>=OutSize Then Begin G1RleEnc:=-1; Exit; End;
   Out^[O]:=((Count Xor XorRaw)+AddRaw) And 255; Inc(O);
   Move(Src^[P],Out^[O],Bpp*Count); Inc(O,Bpp*Count);
  End;
  Inc(P,Count*Bpp); Inc(X,Count);
 End;
 G1RleEnc:=O;
End;

{ ---- encodeur Targa (libavcodec/targaenc.c) ---- }
Procedure EncodeTarga(Const Source,Target: String);
Var
 Px: PEABuffer; Rgb,Pk,Rl: PEABuffer; Kind,Bpp,Pic,Y,X,N,O,Row,Ds: LongInt; Fmt:
  String; Hdr: Array[0..17] Of Byte;
Begin
 G1LoadY4M(Source,'targa');
 Fmt:=OptPixFmt;
 If Fmt='' Then Begin If G1Fm.Gray Then Fmt:='gray' Else If G1YAlpha Then Fmt:=
  'bgra' Else Fmt:='bgr24'; End;
 If (Fmt<>'bgr24') And (Fmt<>'bgra') And (Fmt<>'gray') Then Fail(
  'targa: -pix_fmt bgr24, bgra ou gray seulement.');
 If Fmt='gray' Then Bpp:=1 Else If Fmt='bgra' Then Bpp:=4 Else Bpp:=3;
 Pic:=G1YW*G1YH*Bpp;
 GetMem(Px,Pic+64);
 If Fmt='gray' Then Begin
  If G1YKind=0 Then Move(G1YY^,Px^,Pic)
  Else If (G1YKind=5) And G1Fm.Gray Then H4SCopyDown(G1YY,G1YW,G1YH,G1Fm.Bps,Px,
   Not G1YFull)
  Else If (G1YKind=5) And G1YFull Then H4SCopyDown(G1YY,G1YW,G1YH,G1Fm.Bps,Px,
   False)
  Else If G1YKind=5 Then Begin H4SToJpeg:=True; H4SPlane(G1YY,G1YW,G1YH,2,
   G1Fm.Bps,G1YW,G1YH,False,False,0,Px); H4SToJpeg:=False; End
  Else G1YuvToGray(Px);
 End Else Begin
  GetMem(Rgb,G1YW*G1YH*3+64);
  If G1Fm.Gray Then G1GrayToRgb(Rgb) Else G1Yuv420ToRgb(Rgb);
  For Y:=0 To G1YW*G1YH-1 Do Begin
   Px^[Y*Bpp]:=Rgb^[Y*3+2]; Px^[Y*Bpp+1]:=Rgb^[Y*3+1]; Px^[Y*Bpp+2]:=Rgb^[Y*3];
   If Bpp=4 Then Begin
    Px^[Y*4+3]:=255; If G1BlackCol And ((Y Mod G1YW)=G1YW-1) Then Px^[Y*4+3]:=0;
    If G1YAlpha Then Px^[Y*4+3]:=G1YA^[Y];
   End;
  End;
  FreeMem(Rgb);
 End;
 FillChar(Hdr,SizeOf(Hdr),0);
 Hdr[12]:=G1YW And 255; Hdr[13]:=G1YW Shr 8; Hdr[14]:=G1YH And 255; Hdr[15]:=
  G1YH Shr 8;
 Hdr[17]:=$20; If Fmt='bgra' Then Hdr[17]:=$28;
 If Fmt='gray' Then Begin Hdr[2]:=3; Hdr[16]:=8; End Else Begin Hdr[2]:=2; Hdr[
  16]:=Bpp*8; End;
 { RLE par defaut ; -rle 0 non pris en charge ici }
 GetMem(Rl,Pic+Pic Div 2+4096);
 Ds:=0; O:=0; Row:=Pic;
 If G1TgaRle<>0 Then Ds:=-1 Else
 For Y:=0 To G1YH-1 Do Begin
  N:=G1RleEnc(PEABuffer(@Rl^[O]),Row,Px,Y*G1YW*Bpp,Bpp,G1YW,$7F,0,-1,0);
  If N<0 Then Begin Ds:=-1; Break; End;
  Inc(O,N); Dec(Row,N);
 End;
 If Ds>=0 Then Begin Ds:=O; Hdr[2]:=Hdr[2] Or 8; End;
 OpenWrite(Target);
 WriteBytes(Hdr,18);
 If Ds>=0 Then Begin
  X:=0; While X<Ds Do Begin If Ds-X>32768 Then N:=32768 Else N:=Ds-X;
   WriteBytes(Rl^[X],N); Inc(X,N); End;
 End Else Begin
  X:=0; While X<Pic Do Begin If Pic-X>32768 Then N:=32768 Else N:=Pic-X;
   WriteBytes(Px^[X],N); Inc(X,N); End;
 End;
 Fmt:=#0#0#0#0#0#0#0#0+'TRUEVISION-XFILE.'+#0;
 WriteBytes(Fmt[1],26);
 CloseWrite;
 FreeMem(Rl); FreeMem(Px); FreeMem(G1Raw);
End;

{ ---- encodeur LZW TIFF (libavcodec/lzwenc.c) ---- }
Var
 TEPre,TECode: Array[0..16410] Of LongInt; TESuf: Array[0..16410] Of Byte;
 TETabSize,TEBits,TELast: LongInt;
 TEOut: PEABuffer; TEOutPos: LongInt; TEBitBuf: Int64; TEBitN: LongInt;

Procedure TEPut(N,V: LongInt);
Begin
 TEBitBuf:=((TEBitBuf Shl N) Or V) And $FFFFFFFFFF; Inc(TEBitN,N);
 While TEBitN>=8 Do Begin
  TEOut^[TEOutPos]:=(TEBitBuf Shr (TEBitN-8)) And 255; Inc(TEOutPos); Dec(
   TEBitN,8);
 End;
End;
Function TEHash(Head,Add: LongInt): LongInt;
Begin
 Head:=Head Xor (Add Shl 6);
 If Head>=16411 Then Dec(Head,16411);
 TEHash:=Head;
End;
Procedure TEClear;
Var I,H: LongInt;
Begin
 TEPut(TEBits,256);
 TEBits:=9;
 For I:=0 To 16410 Do TEPre[I]:=-2;
 For I:=0 To 255 Do Begin
  H:=TEHash(0,I); TECode[H]:=I; TESuf[H]:=I; TEPre[H]:=-1;
 End;
 TETabSize:=258;
End;
Procedure TELzInit(Out: PEABuffer; Pos: LongInt);
Begin
 TEOut:=Out; TEOutPos:=Pos; TEBitBuf:=0; TEBitN:=0; TELast:=-1; TEBits:=9;
End;
Procedure TELzEncode(Src: PEABuffer; SrcOfs,N: LongInt);
Var I,C,Code,H,Off: LongInt;
Begin
 If TELast=-1 Then TEClear;
 For I:=0 To N-1 Do Begin
  C:=Src^[SrcOfs+I];
  If TELast<0 Then H:=TEHash(0,C) Else H:=TEHash(TELast,C);
  Off:=H; If Off<>0 Then Off:=16411-Off Else Off:=1;
  While TEPre[H]<>-2 Do Begin
   If (TESuf[H]=C) And (TEPre[H]=TELast) Then Break;
   H:=H-Off; If H<0 Then Inc(H,16411);
  End;
  Code:=H;
  If TEPre[Code]=-2 Then Begin
   TEPut(TEBits,TELast);
   TECode[Code]:=TETabSize; TESuf[Code]:=C; TEPre[Code]:=TELast;
   Inc(TETabSize);
   If TETabSize>=(1 Shl TEBits) Then Inc(TEBits);
   Code:=TEHash(0,C);
  End;
  TELast:=TECode[Code];
  If TETabSize>=4096-1 Then TEClear;
 End;
End;
Procedure TELzFlush;
Begin
 If TELast<>-1 Then TEPut(TEBits,TELast);
 TEPut(TEBits,257);
 If TEBitN>0 Then Begin
  TEOut^[TEOutPos]:=(TEBitBuf Shl (8-TEBitN)) And 255; Inc(TEOutPos); TEBitN:=0;
 End;
 TELast:=-1;
End;

{ ---- encodeur TIFF (libavcodec/tiffenc.c) ---- }
Var
 TEBuf: PEABuffer; TEPos: LongInt;           { tampon de sortie et position
  d'ecriture }
 TEEnt: Array[0..32*12-1] Of Byte; TENum: LongInt;

Procedure TEPutLe16(P: LongInt; V: LongInt);
Begin TEBuf^[P]:=V And 255; TEBuf^[P+1]:=(V Shr 8) And 255; End;
Procedure TEPutLe32(P: LongInt; V: Int64);
Begin TEBuf^[P]:=V And 255; TEBuf^[P+1]:=(V Shr 8) And 255; TEBuf^[P+2]:=(V Shr
 16) And 255; TEBuf^[P+3]:=(V Shr 24) And 255; End;
Function TESz2(Typ: LongInt): LongInt;
Begin
 Case Typ Of 1,2,6,7: TESz2:=1; 3,8: TESz2:=2; 4,9,11,13: TESz2:=4; 5,10,12:
  TESz2:=8; Else TESz2:=0; End;
End;
Function TESz1(Typ: LongInt): LongInt;
Begin
 If Typ=2 Then TESz1:=100 Else TESz1:=TESz2(Typ);
End;
{ Vals : octets deja en ordre little-endian ; Cnt valeurs de type Typ }
Procedure TEAddEntry(Tag,Typ,Cnt: LongInt; Vals: PEABuffer);
Var P,N,I: LongInt;
Begin
 P:=TENum*12;
 TEEnt[P]:=Tag And 255; TEEnt[P+1]:=Tag Shr 8; TEEnt[P+2]:=Typ And 255; TEEnt[P+
  3]:=Typ Shr 8;
 TEEnt[P+4]:=Cnt And 255; TEEnt[P+5]:=(Cnt Shr 8) And 255; TEEnt[P+6]:=(Cnt Shr
  16) And 255; TEEnt[P+7]:=(Cnt Shr 24) And 255;
 N:=Cnt*TESz2(Typ);
 If Int64(TESz1(Typ))*Cnt<=4 Then Begin
  For I:=0 To N-1 Do TEEnt[P+8+I]:=Vals^[I];
 End Else Begin
  TEEnt[P+8]:=TEPos And 255; TEEnt[P+9]:=(TEPos Shr 8) And 255; TEEnt[P+10]:=(
   TEPos Shr 16) And 255; TEEnt[P+11]:=(TEPos Shr 24) And 255;
  For I:=0 To N-1 Do TEBuf^[TEPos+I]:=Vals^[I];
  Inc(TEPos,N);
 End;
 Inc(TENum);
End;
Procedure TEAddEntry1(Tag,Typ,Val: LongInt);
Var B: Array[0..3] Of Byte;
Begin
 B[0]:=Val And 255; B[1]:=(Val Shr 8) And 255; B[2]:=(Val Shr 16) And 255; B[
  3]:=(Val Shr 24) And 255;
 TEAddEntry(Tag,Typ,1,@B);
End;

Procedure EncodeTiff(Const Source,Target: String);
Var
 Kind,Bits,Nc,Photo,Sub0,Sub1,Rps,Strips,Bpr,I,J,K,Y,Row,W,H,N,Zn,Lnum,Q:
  LongInt; Pf: String;
 Planes: Array[0..2] Of PEABuffer; Str: Array[0..2] Of LongInt; Gray,Rgb:
  PEABuffer; Alpha,IsYuv: Boolean;
 StripOffs,StripSizes: Array[0..16383] Of LongInt; Line,Zbuf,Cbuf: PEABuffer;
  Dpi: LongInt;
 Res: Array[0..11] Of LongInt; ResB: Array[0..95] Of Byte; Bp: Array[0..3] Of
  Word; Ver: String; Total: Int64;
 Sw,Hw: LongInt; Pal: Array[0..767] Of Word; Ret,Wr: LongInt; Zout: PEABuffer;
  SarN,SarD,G: LongInt; Tmp: Array[0..255] Of Byte;
 Refbw: Array[0..11] Of LongInt; Dhs,Dvs,CwT,ChT: LongInt;
Procedure PackYuv(Dst: PEABuffer; Lnum: LongInt);
Var Ii,Jj,Kk,Ww,Pu,Pv,Dp: LongInt;
Begin
 Ww:=(W-1) Div Sub0+1;
 Pu:=(Lnum Div Sub1)*Str[1]; Pv:=(Lnum Div Sub1)*Str[2]; Dp:=0;
 For Ii:=0 To Ww-1 Do Begin
  For Jj:=0 To Sub1-1 Do For Kk:=0 To Sub0-1 Do Begin
   Y:=Lnum+Jj; If Y>H-1 Then Y:=H-1;
   Q:=Ii*Sub0+Kk; If Q>W-1 Then Q:=W-1;
   Dst^[Dp]:=Planes[0]^[Y*Str[0]+Q]; Inc(Dp);
  End;
  Dst^[Dp]:=Planes[1]^[Pu]; Inc(Dp); Inc(Pu);
  Dst^[Dp]:=Planes[2]^[Pv]; Inc(Dp); Inc(Pv);
 End;
End;
Procedure Fin;
Begin End;
Begin
 G1LoadY4M(Source,'tiff');
 W:=G1YW; H:=G1YH;
 Pf:=OptPixFmt;
 If Pf='' Then Begin
  If G1YKind=5 Then Begin If G1Fm.Gray Then Pf:='gray16le' Else Pf:='rgb48le';
   End
  Else If G1YAlpha Then Pf:='rgba'
  Else Case G1YKind Of 0: Pf:='gray'; 1: Pf:='yuv420p'; 2: Pf:='yuv422p'; 3:
   Pf:='yuv444p'; Else Pf:='yuv411p'; End;
 End;
 IsYuv:=Copy(Pf,1,3)='yuv'; Alpha:=False;
 If IsYuv Then Begin
  If Pf='yuv420p' Then Begin Sub0:=2; Sub1:=2; End Else If Pf='yuv422p' Then
   Begin Sub0:=2; Sub1:=1; End
  Else If Pf='yuv440p' Then Begin Sub0:=1; Sub1:=2; End Else If Pf='yuv444p'
   Then Begin Sub0:=1; Sub1:=1; End
  Else If Pf='yuv410p' Then Begin Sub0:=4; Sub1:=4; End Else If Pf='yuv411p'
   Then Begin Sub0:=4; Sub1:=1; End
  Else Fail(
   'tiff: -pix_fmt yuv420p, yuv422p, yuv440p, yuv444p, yuv410p ou yuv411p pour'+
   ' les formats YUV.');
  Photo:=6; Nc:=3; Bits:=8+16 Div (Sub0*Sub1);
  Dhs:=0; While (1 Shl Dhs)<Sub0 Do Inc(Dhs);
  Dvs:=0; While (1 Shl Dvs)<Sub1 Do Inc(Dvs);
  CwT:=(W+Sub0-1) Div Sub0; ChT:=(H+Sub1-1) Div Sub1;
  If (G1YKind>=1) And (G1YKind<=4) And (G1Fm.Hs=Dhs) And (G1Fm.Vs=Dvs) And Not (
   G1YAlpha And G1YFull) Then Begin
   Planes[0]:=G1YY; Planes[1]:=G1YU; Planes[2]:=G1YV;
  End Else If (G1YKind=5) And Not G1Fm.Gray And Not G1YFull And (G1Fm.Hs=Dhs)
   And (G1Fm.Vs=Dvs) And Not G1YAlpha Then Begin
   GetMem(Planes[0],Int64(W)*H+64); GetMem(Planes[1],Int64(CwT)*ChT+64); GetMem(
    Planes[2],Int64(CwT)*ChT+64);
   H4SCopyYuvDown(G1Fm,G1Raw,Dhs,Dvs,Planes[0],Planes[1],Planes[2]);
  End Else Begin
   GetMem(Planes[0],Int64(W)*H+64); GetMem(Planes[1],Int64(CwT)*ChT+64); GetMem(
    Planes[2],Int64(CwT)*ChT+64);
   H4SConv(G1Fm,G1Raw,W,H,Dhs,Dvs,Planes[0],Planes[1],Planes[2]);
  End;
  Str[0]:=W; Str[1]:=CwT; Str[2]:=CwT;
 End Else Begin
  Sub0:=1; Sub1:=1;
  If (Pf<>'gray') And (Pf<>'gray16le') And (Pf<>'ya8') And (Pf<>'rgb24') And (
   Pf<>'rgba') And (Pf<>'rgb48le') And (Pf<>'monob') And (Pf<>'monow') Then
   Fail(
   'tiff: -pix_fmt gray, gray16le, ya8, rgb24, rgba, rgb48le, monob, monow ou '+
   'format YUV natif.');
  If (Pf='rgb48le') And G1Fm.Gray And Not G1YFull Then Fail(
   'tiff: gris en plage limitee vers rgb48le non pris en charge.');
  If (G1YKind=5) And G1Fm.Gray And (Pf='ya8') Then Fail(
   'tiff: gris a plus de 8 bits vers ya8 non pris en charge.');
  If (G1YKind=5) And Not G1Fm.Gray And ((Pf='gray16le') Or (Pf='ya8')) Then
   Fail('tiff: YUV a plus de 8 bits vers gray16le / ya8 non pris en charge.');
  If (Pf='gray16le') And (G1YKind<>0) And (G1YKind<>5) Then Fail(
   'tiff: conversion YUV vers gray16le non prise en charge.');
  If ((Pf='gray16le') Or (Pf='ya8')) And G1Fm.Gray And Not G1YFull Then Fail(
   'tiff: gris en plage limitee vers gray16le / ya8 non pris en charge.');
  If (Pf='monob') Or (Pf='monow') Then Begin
   If Pf='monob' Then Photo:=1 Else Photo:=0;
   Bits:=1; Nc:=1;
   GetMem(Gray,Int64((W+7) Shr 3)*H+64);
   If ((G1YKind=1) Or (G1YKind=2)) And Not Odd(G1YH) Then Fail(
    'tiff: monob/monow depuis YUV 4:2:0/4:2:2 de hauteur paire non pris en cha'+
    'rge.');
   G1ToMono(Gray,Pf='monow');
   Planes[0]:=Gray; Str[0]:=(W+7) Shr 3;
  End Else If Pf='rgb48le' Then Begin
   Photo:=2; Bits:=48; Nc:=3;
   GetMem(Rgb,Int64(W)*H*6+64);
   If G1Fm.Gray Then Begin
    For I:=0 To W*H-1 Do Begin
     If G1Fm.Bps>8 Then Q:=G1YY^[I*2]+G1YY^[I*2+1]*256 Else Q:=G1YY^[I];
     Q:=Q Shl (16-G1Fm.Bps);
     Rgb^[I*6]:=Q And 255; Rgb^[I*6+1]:=Q Shr 8; Rgb^[I*6+2]:=Q And 255; Rgb^[I*
      6+3]:=Q Shr 8; Rgb^[I*6+4]:=Q And 255; Rgb^[I*6+5]:=Q Shr 8;
    End;
   End Else If ((G1YKind=1) Or (G1YKind=2)) And Not Odd(H) Then Begin
    { chemin non mis a l'echelle yuv2rgb_c_48 : octet de 8 bits duplique dans le
     mot 16 bits }
    GetMem(Gray,Int64(W)*H*3+64); G1Yuv420ToRgb(Gray);
    For I:=0 To W*H*3-1 Do Begin Rgb^[I*2]:=Gray^[I]; Rgb^[I*2+1]:=Gray^[I];
     End;
    FreeMem(Gray);
   End Else G1YuvToRgb48(Rgb);
   Planes[0]:=Rgb; Str[0]:=W*6;
  End Else If Pf='gray16le' Then Begin
   Photo:=1; Bits:=16; Nc:=1;
   GetMem(Gray,W*H*2+64);
   If G1Fm.Bps=16 Then Move(G1YY^,Gray^,W*H*2) Else H4SCopyUp(G1YY,W,H,G1Fm.Bps,
    Gray);
   Planes[0]:=Gray; Str[0]:=W*2;
  End Else If (Pf='gray') Or (Pf='ya8') Then Begin
   Photo:=1; Bits:=8; Nc:=1;
   GetMem(Gray,W*H+64);
   If G1YKind=0 Then Move(G1YY^,Gray^,W*H)
   Else If (G1YKind=5) And G1Fm.Gray Then H4SCopyDown(G1YY,W,H,G1Fm.Bps,Gray,Not
    G1YFull)
   Else If (G1YKind=5) And G1YFull Then H4SCopyDown(G1YY,W,H,G1Fm.Bps,Gray,
    False)
   Else If G1YKind=5 Then Begin H4SToJpeg:=True; H4SPlane(G1YY,W,H,2,G1Fm.Bps,W,
    H,False,False,0,Gray); H4SToJpeg:=False; End
   Else G1YuvToGray(Gray);
   Planes[0]:=Gray; Str[0]:=W;
   If Pf='ya8' Then Begin
    Alpha:=True; Bits:=16; Nc:=2;
    GetMem(Rgb,W*H*2+64);
    For I:=0 To W*H-1 Do Begin Rgb^[I*2]:=Gray^[I]; Rgb^[I*2+1]:=255; If
     G1YAlpha Then Rgb^[I*2+1]:=G1YA^[I]; End;
    FreeMem(Gray); Planes[0]:=Rgb; Str[0]:=W*2;
   End;
  End Else Begin
   Photo:=2; Alpha:=Pf='rgba';
   If Alpha Then Begin Bits:=32; Nc:=4; End Else Begin Bits:=24; Nc:=3; End;
   GetMem(Rgb,W*H*3+64);
   If G1Fm.Gray Then G1GrayToRgb(Rgb) Else G1Yuv420ToRgb(Rgb);
   If Alpha Then Begin
    GetMem(Gray,W*H*4+64);
    For I:=0 To W*H-1 Do Begin
     Gray^[I*4]:=Rgb^[I*3]; Gray^[I*4+1]:=Rgb^[I*3+1]; Gray^[I*4+2]:=Rgb^[I*3+
      2]; Gray^[I*4+3]:=255;
     If G1BlackCol And ((I Mod W)=W-1) Then Gray^[I*4+3]:=0;
     If G1YAlpha Then Gray^[I*4+3]:=G1YA^[I];
    End;
    FreeMem(Rgb); Planes[0]:=Gray; Str[0]:=W*4;
   End Else Begin Planes[0]:=Rgb; Str[0]:=W*3; End;
  End;
 End;
 Dpi:=G1TifDpi; If Dpi=0 Then Dpi:=72;
 If G1TifCompr=0 Then G1TifCompr:=$8005;
 { rps, strips }
 If (G1TifCompr=$80B2) Or (G1TifCompr=5) Then Rps:=H
 Else Begin
  Rps:=8192 Div (((W*Bits) Shr 3)+1); If Rps<1 Then Rps:=1;
 End;
 Rps:=((Rps-1) Div Sub1+1)*Sub1;
 Strips:=(H-1) Div Rps+1;
 If Strips>16383 Then Fail('tiff: image trop haute.');
 Bpr:=(((W-1) Div Sub0+1)*Bits*Sub0*Sub1+7) Shr 3;
 Total:=Int64(H)*Bpr*2+Int64(H)*4+16384+W*64;
 GetMem(TEBuf,Total+W*H*4); FillChar(TEBuf^,Total+W*H*4,0);
 GetMem(Line,Bpr+64);
 TEPos:=0;
 TEBuf^[0]:=$49; TEBuf^[1]:=$49; TEBuf^[2]:=42; TEBuf^[3]:=0;
 TEPos:=8;
 FillChar(StripOffs,SizeOf(StripOffs),0); FillChar(StripSizes,SizeOf(
  StripSizes),0);
 If (G1TifCompr=$80B2) Then Begin
  GetMem(Zbuf,Int64(Bpr)*Rps+64); Zn:=0; J:=0;
  While J<Rps Do Begin
   If IsYuv Then Begin
    PackYuv(Line,J); Move(Line^,Zbuf^[Zn],Bpr); Inc(J,Sub1-1);
   End Else Move(Planes[0]^[J*Str[0]],Zbuf^[J*Bpr],Bpr);
   Inc(Zn,Bpr); Inc(J);
  End;
  StripOffs[0]:=TEPos;
  { compress() : zlib niveau par defaut, un seul appel }
  GetMem(Zout,Zn+Zn Div 8+4096);
  ZLDeflateInit(-1);
  ZLIn:=Zbuf; ZLInPos:=0; ZLAvailIn:=Zn; ZLOut:=Zout; ZLOutPos:=0; ZLAvailOut:=
   Zn+Zn Div 8+4096;
  Ret:=ZLDeflate(4);
  If Ret<>1 Then Fail('tiff: erreur de compression.');
  Wr:=Zn+Zn Div 8+4096-ZLAvailOut;
  ZLDeflateEnd;
  Move(Zout^,TEBuf^[TEPos],Wr); Inc(TEPos,Wr); StripSizes[0]:=Wr;
  FreeMem(Zout); FreeMem(Zbuf);
 End Else Begin
  I:=0;
  While I<H Do Begin
   If StripSizes[I Div Rps]=0 Then Begin
    If G1TifCompr=5 Then TELzInit(TEBuf,TEPos);
    StripOffs[I Div Rps]:=TEPos;
   End;
   If IsYuv Then Begin PackYuv(Line,I); Cbuf:=Line; End Else Cbuf:=Nil;
   If G1TifCompr=1 Then Begin
    If IsYuv Then Move(Line^,TEBuf^[TEPos],Bpr) Else Move(Planes[0]^[I*Str[0]],
     TEBuf^[TEPos],Bpr);
    N:=Bpr;
   End Else If G1TifCompr=$8005 Then Begin
    If IsYuv Then N:=G1RleEnc(PEABuffer(@TEBuf^[TEPos]),Total-TEPos,Line,0,1,
     Bpr,2,$FF,-1,0)
    Else N:=G1RleEnc(PEABuffer(@TEBuf^[TEPos]),Total-TEPos,Planes[0],I*Str[0],1,
     Bpr,2,$FF,-1,0);
    If N<0 Then Fail('tiff: erreur de compression.');
   End Else Begin
    K:=TEOutPos;
    If IsYuv Then TELzEncode(Line,0,Bpr) Else TELzEncode(Planes[0],I*Str[0],
     Bpr);
    N:=TEOutPos-K;
   End;
   If IsYuv Then Inc(I,Sub1-1);
   If G1TifCompr<>5 Then Begin Inc(StripSizes[I Div Rps],N); Inc(TEPos,N); End
   Else Begin Inc(StripSizes[I Div Rps],N); TEPos:=TEOutPos; End;
   If (G1TifCompr=5) And ((I=H-1) Or (I Mod Rps=Rps-1)) Then Begin
    K:=TEOutPos; TELzFlush; N:=TEOutPos-K;
    Inc(StripSizes[I Div Rps],N); TEPos:=TEOutPos;
   End;
   Inc(I);
  End;
 End;
 { entrees }
 TENum:=0;
 FillChar(TEEnt,SizeOf(TEEnt),0);
 TEAddEntry1($FE,4,0);
 TEAddEntry1($100,4,W);
 TEAddEntry1($101,4,H);
 For I:=0 To Nc-1 Do Begin
  If IsYuv Then Bp[I]:=8 Else Bp[I]:=Bits Div Nc;
 End;
 If Nc<>0 Then Begin
  For I:=0 To Nc-1 Do Begin ResB[I*2]:=Bp[I] And 255; ResB[I*2+1]:=Bp[I] Shr 8;
   End;
  TEAddEntry($102,3,Nc,@ResB);
 End;
 TEAddEntry1($103,3,G1TifCompr);
 TEAddEntry1($106,3,Photo);
 For I:=0 To Strips-1 Do Begin
  ResB[0]:=0;
 End;
 GetMem(Zbuf,Strips*4+16);
 For I:=0 To Strips-1 Do Begin
  Zbuf^[I*4]:=StripOffs[I] And 255; Zbuf^[I*4+1]:=(StripOffs[I] Shr 8) And 255;
   Zbuf^[I*4+2]:=(StripOffs[I] Shr 16) And 255; Zbuf^[I*4+3]:=(StripOffs[I] Shr
   24) And 255;
 End;
 TEAddEntry($111,4,Strips,Zbuf);
 If Nc<>0 Then TEAddEntry1($115,3,Nc);
 TEAddEntry1($116,4,Rps);
 For I:=0 To Strips-1 Do Begin
  Zbuf^[I*4]:=StripSizes[I] And 255; Zbuf^[I*4+1]:=(StripSizes[I] Shr 8) And
   255; Zbuf^[I*4+2]:=(StripSizes[I] Shr 16) And 255; Zbuf^[I*4+3]:=(StripSizes[
   I] Shr 24) And 255;
 End;
 TEAddEntry($117,4,Strips,Zbuf);
 FreeMem(Zbuf);
 Res[0]:=Dpi; Res[1]:=1;
 FillChar(ResB,SizeOf(ResB),0);
 ResB[0]:=Res[0] And 255; ResB[1]:=(Res[0] Shr 8) And 255; ResB[2]:=(Res[0] Shr
  16) And 255; ResB[3]:=(Res[0] Shr 24) And 255; ResB[4]:=1;
 TEAddEntry($11A,5,1,@ResB);
 If (G1YSarN>0) And (G1YSarD>0) Then Begin
  { y = dpi * sar, reduit }
  SarN:=Dpi*G1YSarN; SarD:=G1YSarD;
  I:=SarN; J:=SarD; While J<>0 Do Begin K:=I Mod J; I:=J; J:=K; End;
  If I>1 Then Begin SarN:=SarN Div I; SarD:=SarD Div I; End;
  ResB[0]:=SarN And 255; ResB[1]:=(SarN Shr 8) And 255; ResB[2]:=(SarN Shr 16)
   And 255; ResB[3]:=(SarN Shr 24) And 255;
  ResB[4]:=SarD And 255; ResB[5]:=(SarD Shr 8) And 255; ResB[6]:=(SarD Shr 16)
   And 255; ResB[7]:=(SarD Shr 24) And 255;
 End;
 TEAddEntry($11B,5,1,@ResB);
 TEAddEntry1($128,3,2);
 Ver:='Lavc60.31.102'#0;
 TEAddEntry($131,2,Length(Ver),@Ver[1]);
 If Alpha Then TEAddEntry1($152,3,2);
 If IsYuv Then Begin
  ResB[0]:=Sub0; ResB[1]:=0; ResB[2]:=Sub1; ResB[3]:=0;
  TEAddEntry($212,3,2,@ResB);
  If G1YLoc=3 Then TEAddEntry1($213,3,2);
  Refbw[0]:=15; Refbw[1]:=1; Refbw[2]:=235; Refbw[3]:=1; Refbw[4]:=128; Refbw[
   5]:=1; Refbw[6]:=240; Refbw[7]:=1; Refbw[8]:=128; Refbw[9]:=1; Refbw[10]:=
   240; Refbw[11]:=1;
  For I:=0 To 11 Do Begin ResB[I*4]:=Refbw[I]; ResB[I*4+1]:=0; ResB[I*4+2]:=0;
   ResB[I*4+3]:=0; End;
  TEAddEntry($214,5,6,@ResB);
 End;
 { en-tete : decalage de l'IFD, puis IFD }
 TEPutLe32(4,TEPos);
 TEPutLe16(TEPos,TENum); Inc(TEPos,2);
 Move(TEEnt,TEBuf^[TEPos],TENum*12); Inc(TEPos,TENum*12);
 TEPutLe32(TEPos,0); Inc(TEPos,4);
 OpenWrite(Target);
 I:=0; While I<TEPos Do Begin If TEPos-I>32768 Then N:=32768 Else N:=TEPos-I;
  WriteBytes(TEBuf^[I],N); Inc(I,N); End;
 CloseWrite;
 FreeMem(TEBuf); FreeMem(Line); FreeMem(G1Raw);
 If (Not IsYuv) Then FreeMem(Planes[0]);
End;

