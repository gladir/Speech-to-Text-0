  End;
  If HasAlbum Then Begin
   N:=AlbumUTF8Size+1; PartSize:=N; If Odd(PartSize) Then Inc(PartSize);
   PutTag('LIST'); PutSize(12+PartSize,True,False); PutTag('INFO'); PutTag(
    'IPRD');
   PutSize(N,True,False);
   If AlbumUTF8Size>0 Then WriteBytes(AlbumUTF8,AlbumUTF8Size); PutByte(0);
   If Odd(N) Then PutByte(0);
  End;
  If HasComment Then Begin
   N:=CommentUTF8Size+1; PartSize:=N; If Odd(PartSize) Then Inc(PartSize);
   PutTag('LIST'); PutSize(12+PartSize,True,False); PutTag('INFO'); PutTag(
    'ICMT');
   PutSize(N,True,False);
