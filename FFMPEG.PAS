Function CKBits(N: LongInt): LongInt;
Var
 V: Int64;
 I,B: LongInt;
Begin
 V:=0;
 For I:=1 To N Do Begin
  B:=CKGBit Shr 3;
  If B<CKGSize Then V:=V*2+((CKGB^[B] Shr (7-(CKGBit And 7))) And 1) Else V:=V*
   2;
  Inc(CKGBit);
 End;
 CKBits:=V;
End;

Function CKLfgGet: Int64;
Var
 A: Int64;
Begin
 A:=(Int64(CKLfg[(CKLfgIdx-24) And 63]) And $FFFFFFFF)+(Int64(CKLfg[(CKLfgIdx-
  55) And 63])
 And $FFFFFFFF);
 A:=A And $FFFFFFFF;
 If A>=$80000000 Then CKLfg[CKLfgIdx And 63]:=A-$100000000 Else CKLfg[CKLfgIdx
  And 63]:=A;
 Inc(CKLfgIdx);
 CKLfgGet:=A;
End;
{ Construit la table VLC T a partir des comptes par longueur (build_vlc) }

Procedure CKBuildVlc(T: LongInt; Const Counts: Array Of Byte; CBase: LongInt;
                     SymW: Boolean; SymBase,Off: LongInt);
Var
 I,N,K,L: LongInt;
 Cd: Int64;
 P: LongInt;
Begin
 If T=0 Then P:=0 Else P:=CKVStart[T-1]+CKVNum[T-1];
 CKVStart[T]:=P; N:=0; Cd:=0; CKVMax[T]:=0;
 For I:=0 To 15 Do
 For K:=1 To Counts[CBase+I] Do Begin
  L:=I+1;
  CKVLen[P+N]:=L; CKVCode[P+N]:=Cd Shr (32-L);
  Cd:=Cd+(Int64(1) Shl (32-L));
  If L>CKVMax[T] Then CKVMax[T]:=L;
  Inc(N);
 End;
 CKVNum[T]:=N; CKVOff[T]:=Off;
 CKVBuilt[T]:=True;
End;

Function CKVlc(T: LongInt): LongInt;
Var
 V: Int64;
 L,E,S: LongInt;
Begin
 V:=0; S:=CKVStart[T];
 For L:=1 To CKVMax[T] Do Begin
  V:=V*2+CKBits(1);
  For E:=0 To CKVNum[T]-1 Do   If (CKVLen[S+E]=L) And (CKVCode[S+E]=V) Then
   Begin
   CKVlc:=CKVSym[S+E]+CKVOff[T]; Exit;
  End;
 End;
 CKVlc:=0;
End;

Procedure CKInitTables;
Var
 I,J,K,N,P,S: LongInt;
 Ex,Rt: Single;
 Sq: Single;
Begin
 Move(CKDither,CKDith,36); Move(CKCentroid,CKCent,392); Move(CKCplScale,CKCplS,
  516);
 Ex:=1;
 For I:=1 To 63 Do Ex:=Ex/2;
 Rt:=1;
 For I:=1 To 32 Do Rt:=Rt/2;
 Sq:=1.41421356237309504880;
 For I:=-63 To 63 Do Begin
  If (I And 1)=0 Then Rt:=Rt*2;
  CKPow2[63+I]:=Ex;
  If (I And 1)<>0 Then CKRootPow2[63+I]:=Rt*Sq Else CKRootPow2[63+I]:=Rt;
  Ex:=Ex*2;
 End;
 For I:=0 To 63 Do CKLfg[I]:=CKLfgInit[I];
 CKLfgIdx:=0;
 { symboles des tables VLC }
 N:=0;
 For I:=0 To 12 Do Begin
  CKBuildVlc(I,CKEnvCnt,I*16,False,0,-12);
  P:=CKVStart[I]; S:=0;
  For J:=0 To 15 Do Inc(S,CKEnvCnt[I*16+J]);
  For J:=0 To S-1 Do CKVSym[P+J]:=CKEnvSym[I*24+J];
 End;
 P:=0;
 For I:=0 To 6 Do Begin
  CKBuildVlc(13+I,CKCvhCnt,I*16,False,0,0);
  S:=0;
  For J:=0 To 15 Do Inc(S,CKCvhCnt[I*16+J]);
  For J:=0 To S-1 Do CKVSym[CKVStart[13+I]+J]:=CKCvhSym[P+J];
  Inc(P,S);
 End;
 P:=0;
 For I:=0 To 4 Do Begin
  CKBuildVlc(20+I,CKCcplCnt,I*16,False,0,0);
  S:=0;
  For J:=0 To 15 Do Inc(S,CKCcplCnt[I*16+J]);
  For J:=0 To S-1 Do CKVSym[CKVStart[20+I]+J]:=CKCcplSym[P+J];
  Inc(P,S);
 End;
End;

Procedure CKGainInfo(Var Gain: Array Of LongInt);
Var
 I,N,Idx,G,Left: LongInt;
Begin
 Left:=CKGLimit-CKGBit; N:=0;
 While (N<Left) And (CKBits(1)<>0) Do Inc(N);
 I:=0;
 While N>0 Do Begin
  Dec(N);
  Idx:=CKBits(3);
  If CKBits(1)<>0 Then G:=CKBits(4)-7 Else G:=-1;
  While I<=Idx Do Begin
   Gain[I]:=G; Inc(I);
  End;
 End;
 While I<=8 Do Begin
  Gain[I]:=0; Inc(I);
 End;
End;

Function CKEnvelope(P: LongInt; Var QT: Array Of LongInt): Boolean;
Var
 I,J,V: LongInt;
Begin
 CKEnvelope:=False;
 QT[0]:=CKBits(6)-6;
 For I:=1 To CKSub[P].Total-1 Do Begin
  V:=I;
  If I>=CKSub[P].JsStart*2 Then V:=V-CKSub[P].JsStart
   Else
  Begin
   V:=V Div 2; If V<1 Then V:=1;
  End;
  If V>13 Then V:=13;
  J:=CKVlc(V-1);
  QT[I]:=QT[I-1]+J;
  If (QT[I]>63) Or (QT[I]<-63) Then Exit;
 End;
 CKEnvelope:=True;
End;

Procedure CKCategorize(P: LongInt; Const QT: Array Of LongInt;
                       Var Cat,CatIdx: Array Of LongInt);
Var
 ExpIdx,Bias,TB1,TB2,BitsLeft,NumBits,Index,V,I,J,Mx,Mn: LongInt;
 E2,E1: Array[0..101] Of LongInt;
 Tmp: Array[0..255] Of LongInt;
 T1,T2: LongInt;

Function Clip3(X: LongInt): LongInt;Begin
 If X<0 Then X:=0; If X>7 Then X:=7; Clip3:=X;
End;
Begin
 FillChar(E2,SizeOf(E2),0); FillChar(E1,SizeOf(E1),0); FillChar(Tmp,SizeOf(Tmp),
  0);
 T1:=CKSub[P].NvSize; T2:=CKSub[P].NvSize;
 BitsLeft:=CKSub[P].BitsSub-CKGBit;
 If BitsLeft>CKSpc Then BitsLeft:=CKSpc+((BitsLeft-CKSpc)*5) Div 8;
 Bias:=-32;
 I:=32;
 While I>0 Do Begin
  NumBits:=0; Index:=0;
  For J:=CKSub[P].Total Downto 1 Do Begin
   ExpIdx:=Clip3((I-QT[Index]+Bias) Div 2);
   Inc(Index);
   Inc(NumBits,CKExpBits[ExpIdx]);
  End;
  If NumBits>=BitsLeft-32 Then Inc(Bias,I);
  I:=I Div 2;
 End;
 NumBits:=0;
 For I:=0 To CKSub[P].Total-1 Do Begin
  ExpIdx:=Clip3((Bias-QT[I]) Div 2);
  Inc(NumBits,CKExpBits[ExpIdx]);
  E1[I]:=ExpIdx; E2[I]:=ExpIdx;
 End;
 TB1:=NumBits; TB2:=NumBits;
 For J:=1 To CKSub[P].NvSize-1 Do Begin
  If TB1+TB2>2*BitsLeft Then Begin
   Mx:=-999999; Index:=-1;
   For I:=0 To CKSub[P].Total-1 Do    If E1[I]<7 Then Begin
    V:=(-2*E1[I])-QT[I]+Bias;
    If V>=Mx Then Begin
     Mx:=V; Index:=I;
    End;
   End;
   If Index=-1 Then Break;
   Tmp[T1]:=Index; Inc(T1);
   Dec(TB1,CKExpBits[E1[Index]]-CKExpBits[E1[Index]+1]);
   Inc(E1[Index]);
  End Else
  Begin
   Mn:=999999; Index:=-1;
   For I:=0 To CKSub[P].Total-1 Do    If E2[I]>0 Then Begin
    V:=(-2*E2[I])-QT[I]+Bias;
    If V<Mn Then Begin
     Mn:=V; Index:=I;
    End;
   End;
   If Index=-1 Then Break;
   Dec(T2); Tmp[T2]:=Index;
   Dec(TB2,CKExpBits[E2[Index]]-CKExpBits[E2[Index]-1]);
   Dec(E2[Index]);
  End;
 End;
 For I:=0 To CKSub[P].Total-1 Do Cat[I]:=E2[I];
 For I:=0 To CKSub[P].NvSize-2 Do Begin
  CatIdx[I]:=Tmp[T2]; Inc(T2);
 End;
End;

Procedure CKDequant(Idx,QI: LongInt; Const CI,CS: Array Of LongInt; Dest: PCKF;
                    Base: LongInt);
Var
 I: LongInt;
 F1: Single;
Begin
 For I:=0 To 19 Do Begin
  If CI[I]<>0 Then Begin
   F1:=CKCent[Idx*14+CI[I]];
   If CS[I]<>0 Then F1:=-F1;
  End Else
  Begin
   F1:=CKDith[Idx];
   If CKLfgGet<$80000000 Then F1:=-F1;
  End;
  Dest^[Base+I]:=F1*CKRootPow2[QI+63];
 End;
End;

Function CKUnpackSQVH(P,Cat: LongInt; Var CI,CS: Array Of LongInt): Boolean;
Var
 I,J,Vlc,Vd,Tmp: LongInt;
 Res: Boolean;
Begin
 Vd:=CKVd[Cat]; Res:=False;
 For I:=0 To CKVpr[Cat]-1 Do Begin
  Vlc:=CKVlc(13+Cat);
  If CKSub[P].BitsSub<CKGBit Then Begin
   Vlc:=0; Res:=True;
  End;
  For J:=Vd-1 Downto 0 Do Begin
   Tmp:=(Vlc*CKInvRadix[Cat]) Div $100000;
   CI[Vd*I+J]:=Vlc-Tmp*(CKKmax[Cat]+1);
   Vlc:=Tmp;
  End;
  For J:=0 To Vd-1 Do Begin
   If CI[I*Vd+J]<>0 Then Begin
    If CKGBit<CKSub[P].BitsSub Then CS[I*Vd+J]:=CKBits(1)
     Else
    Begin
     Res:=True; CS[I*Vd+J]:=0;
    End;
   End Else CS[I*Vd+J]:=0;
  End;
 End;
 CKUnpackSQVH:=Res;
End;

Procedure CKDecodeVectors(P: LongInt; Var Cat: Array Of LongInt;
                          Const QT: Array Of LongInt; Dest: PCKF);
Var
 CI,CS: Array[0..19] Of LongInt;
 Band,J,Index: LongInt;
Begin
 For Band:=0 To CKSub[P].Total-1 Do Begin
  Index:=Cat[Band];
  If Cat[Band]<7 Then   If CKUnpackSQVH(P,Cat[Band],CI,CS) Then Begin
   Index:=7;
   For J:=0 To CKSub[P].Total-1 Do Cat[Band+J]:=7;
  End;
  If Index>=7 Then Begin
   FillChar(CI,SizeOf(CI),0); FillChar(CS,SizeOf(CS),0);
  End;
  CKDequant(Index,QT[Band],CI,CS,Dest,Band*20);
 End;
End;

Function CKMonoDecode(P: LongInt; Dest: PCKF): Boolean;
Var
 CatIdx,Cat: Array[0..127] Of LongInt;
 QT: Array[0..101] Of LongInt;
 I,Idx: LongInt;
Begin
 CKMonoDecode:=False;
 FillChar(CatIdx,SizeOf(CatIdx),0); FillChar(Cat,SizeOf(Cat),0);
 If Not CKEnvelope(P,QT) Then Exit;
 CKNumVectors:=CKBits(CKSub[P].Log2Nv);
 CKCategorize(P,QT,Cat,CatIdx);
 For I:=0 To CKNumVectors-1 Do Begin
  Idx:=CatIdx[I];
  Inc(Cat[Idx]);
  If Cat[Idx]>=9 Then Dec(Cat[Idx]);
 End;
 For I:=0 To CKSub[P].Total-1 Do If Cat[I]>7 Then Exit;
 CKDecodeVectors(P,Cat,QT,Dest);
 CKMonoDecode:=True;
End;
