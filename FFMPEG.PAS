 For J:=0 To AlbumWideSize-1 Do Begin
  U:=AlbumWide[J]; N:=AlbumUTF8Size;
  If U<128 Then Begin
   AlbumUTF8[N]:=U; Inc(N);
  End Else
  If U<2048 Then Begin
   AlbumUTF8[N]:=$C0 Or (U Shr 6); AlbumUTF8[N+1]:=$80 Or (U And 63); Inc(N,2);
  End Else
  Begin
   AlbumUTF8[N]:=$E0 Or (U Shr 12); AlbumUTF8[N+1]:=$80 Or ((U Shr 6) And 63);
   AlbumUTF8[N+2]:=$80 Or (U And 63); Inc(N,3);
  End;
  AlbumUTF8Size:=N;
 End;
End;

