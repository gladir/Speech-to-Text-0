 ligne ==== }

{ ---- H8 : zmbv, conversion yuv420p -> pal8 (BGR8) / rgb555le / rgb565le
 (libswscale/yuv2rgb.c, chemin non mis a l'echelle) ---- }
Const
 H8Dith2x2_8: Array[0..2,0..1] Of Byte=((6,2),(0,4),(6,2));
 H8Dith2x2_4: Array[0..2,0..1] Of Byte=((1,3),(2,0),(1,3));
 H8Dith8x8_32: Array[0..8,0..7] Of Byte=(
  (17,9,23,15,16,8,22,14),(5,29,3,27,4,28,2,26),(21,13,19,11,20,12,18,10),(0,24,
   6,30,1,25,7,31),
  (16,8,22,14,17,9,23,15),(4,28,2,26,5,29,3,27),(20,12,18,10,21,13,19,11),(1,25,
   7,31,0,24,6,30),
  (17,9,23,15,16,8,22,14));
 H8Dith8x8_73: Array[0..8,0..7] Of Byte=(
  (0,55,14,68,3,58,17,72),(37,18,50,32,40,22,54,35),(9,64,5,59,13,67,8,63),(46,
   27,41,23,49,31,44,26),
  (2,57,16,71,1,56,15,70),(39,21,52,34,38,19,51,33),(11,66,7,62,10,65,6,60),(48,
   30,43,25,47,29,42,24),
  (0,55,14,68,3,58,17,72));

Procedure H8YGeneral(Out: PEABuffer; Bpp: LongInt);
Var Q: PEABuffer; X,Y,O: LongInt;
Begin
 G1YW:=G2YW; G1YH:=G2YH; G1YCw:=G2YCW; G1YCh:=G2YCH; G1YY:=G2YYp; G1YU:=G2YUp;
  G1YV:=G2YVp;
 GetMem(Q,G2YW*G2YH*3+16);
 G1Yuv420ToRgb(Q);
 For Y:=0 To G2YH-1 Do For X:=0 To G2YW-1 Do Begin
  O:=(Y*G2YW+X)*Bpp;
  Out^[O]:=Q^[(Y*G2YW+X)*3+2]; Out^[O+1]:=Q^[(Y*G2YW+X)*3+1]; Out^[O+2]:=Q^[(Y*
   G2YW+X)*3];
  If Bpp=4 Then Out^[O+3]:=255;
 End;
 FreeMem(Q);
End;

Procedure H8YConv(Fmt: LongInt; Out: PEABuffer);
Var
 TR,TG,TB: Array[0..2047] Of Word; OffR,OffB,OffGU,OffGV: Array[0..255] Of
  LongInt;
 Cy,Oy,Yb: Int64; I,X,Y,Yv,U,V,YD,Q,Yoffs,Bpp,W,H,Cw,Rb,Y2,XE: LongInt; Dr,Dg,
  Db: LongInt; Yval: LongInt; Px: LongInt;
Function Cl(Z: Int64): LongInt; Begin If Z<0 Then Cl:=0 Else If Z>255 Then Cl:=
 255 Else Cl:=Z; End;
Begin
 W:=G2YW; H:=G2YH; Cw:=G2YCW;
 If Odd(H) Then Fail(
  'zmbv: hauteur impaire non prise en charge pour pal8/rgb555le/rgb565le (chem'+
  'in general de swscale).');
 If (Fmt=4) And Odd(W) Then Fail(
  'zmbv: pal8 avec largeur impaire (diffusion d''erreur de swscale) non pris e'+
  'n charge.');
 If Fmt=4 Then Bpp:=8 Else If Fmt=5 Then Bpp:=15 Else Bpp:=16;
 Cy:=(Int64(65536)*255) Div 219; Oy:=Int64(16) Shl 16;
 Yoffs:=326+512;
 FillChar(TR,SizeOf(TR),0); FillChar(TG,SizeOf(TG),0); FillChar(TB,SizeOf(TB),
  0);
 Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For I:=0 To 2047 Do Begin
  Yval:=Cl(G2YSar(Yb+$8000,16));
  If Bpp=8 Then Begin
   If I<2048-38 Then Begin
    TR[I+16]:=((Yval+18) Div 36);
    TG[I+16]:=((Yval+18) Div 36) Shl 3;
    TB[I+37]:=((Yval+43) Div 85) Shl 6;
   End;
  End Else Begin
   TR[I]:=(Yval Shr 3) Shl (Bpp-5);
   TG[I]:=(Yval Shr (18-Bpp)) Shl 5;
   TB[I]:=(Yval Shr 3);
  End;
  Inc(Yb,Cy);
 End;
 For I:=0 To 255 Do Begin
  OffR[I]:=Yoffs-LongInt(G2YSar(G2YCrv,9))+LongInt(G2YSar(I*G2YCrv,16));
  OffB[I]:=Yoffs-LongInt(G2YSar(G2YCbu,9))+LongInt(G2YSar(I*G2YCbu,16));
  OffGU[I]:=Yoffs-LongInt(G2YSar(G2YCgu,9))+LongInt(G2YSar(I*G2YCgu,16));
  OffGV[I]:=-LongInt(G2YSar(G2YCgv,9))+LongInt(G2YSar(I*G2YCgv,16));
 End;
 if Bpp=8 then Rb:=W else Rb:=W*2;
 FillChar(Out^,Rb*H,0);
 { les variantes 15/16 bits n'ont pas de traitement du reste (CLOSEYUV2RGBFUNC)
  : seuls les groupes de 8 pixels sont convertis ;
   la variante 8 bits traite aussi des groupes de 4 et 2 pixels, jamais le
    dernier pixel d'une largeur impaire }
 If Bpp=8 Then XE:=W And Not 1 Else XE:=W And Not 7;
 For Y:=0 To H-1 Do Begin
  YD:=Y; Q:=Y And 1;
  For X:=0 To XE-1 Do Begin
   Yv:=G2YYp^[Y*W+X]; U:=G2YUp^[(Y Shr 1)*Cw+(X Shr 1)]; V:=G2YVp^[(Y Shr 1)*Cw+
    (X Shr 1)];
   If Bpp=16 Then Begin
    Dr:=H8Dith2x2_8[Q,X And 1]; Dg:=H8Dith2x2_4[Q,X And 1]; Db:=H8Dith2x2_8[Q+1,
     X And 1];
    Px:=TR[OffR[V]+Yv+Dr]+TG[OffGU[U]+OffGV[V]+Yv+Dg]+TB[OffB[U]+Yv+Db];
   End Else If Bpp=15 Then Begin
    If (X And 1)=0 Then Begin
     Dr:=H8Dith2x2_8[Q,0]; Dg:=H8Dith2x2_8[Q,1]; Db:=H8Dith2x2_8[Q+1,0];
    End Else Begin
     Dr:=H8Dith2x2_8[Q,1]; Dg:=H8Dith2x2_8[Q,0]; Db:=H8Dith2x2_8[Q+1,1];
    End;
    Px:=TR[OffR[V]+Yv+Dr]+TG[OffGU[U]+OffGV[V]+Yv+Dg]+TB[OffB[U]+Yv+Db];
   End Else Begin
    Dr:=H8Dith8x8_32[(YD And 7),X And 7]; Db:=H8Dith8x8_73[(YD And 7),X And 7];
    Px:=TR[OffR[V]+Yv+Dr]+TG[OffGU[U]+OffGV[V]+Yv+Dr]+TB[OffB[U]+Yv+Db];
   End;
   If Bpp=8 Then Out^[Y*W+X]:=Px And 255
   Else Begin Out^[Y*Rb+X*2]:=Px And 255; Out^[Y*Rb+X*2+1]:=Px Shr 8; End;
  End;
 End;
End;

{ ---- H8 : xan_dpcm dans AVI (flux audio, wFormatTag 0x594A) ---- }
{ Mode 0 : retourne True si un flux audio AVI porte l'etiquette 0x594A ; Mode 1
 : decode vers WAV (Target) }
Function H8XanAvi(Const Source,Target: String; Mode: LongInt): Boolean;
Var
 F: PEABuffer; Size,Pos,Sz,Idx,AIdx,Chn,Rate,Tag,Q,E2,Sz2,Id,P2,E3,Sz3: LongInt;
  Found,IsAud: Boolean;
 Procedure Walk(P,E: LongInt);
 Var Z,Cid: LongInt;
 Begin
  While P+8<=E Do Begin
   Z:=NVRL32(F,Size,P+4); If (Z<0) Or (P+8+Z>Size) Then Z:=Size-P-8;
   If (F^[P]=76) And (F^[P+1]=73) And (F^[P+2]=83) And (F^[P+3]=84) Then Begin
    If (F^[P+8]=109) And (F^[P+9]=111) And (F^[P+10]=118) And (F^[P+11]=105)
     Then Walk(P+12,P+8+Z)
    Else If (F^[P+8]=104) And (F^[P+9]=100) And (F^[P+10]=114) And (F^[P+
     11]=108) Then Walk(P+12,P+8+Z)
    Else If (F^[P+8]=115) And (F^[P+9]=116) And (F^[P+10]=114) And (F^[P+
     11]=108) Then Begin
     { liste de flux : le numero est compte au passage }
     Inc(Idx); IsAud:=False;
     Q:=P+12; E3:=P+8+Z;
     While Q+8<=E3 Do Begin
      Sz3:=NVRL32(F,Size,Q+4); If (Sz3<0) Or (Q+8+Sz3>Size) Then Break;
      If (F^[Q]=115) And (F^[Q+1]=116) And (F^[Q+2]=114) And (F^[Q+3]=104) Then
       IsAud:=(F^[Q+8]=97) And (F^[Q+9]=117) And (F^[Q+10]=100) And (F^[Q+
       11]=115);
      If (F^[Q]=115) And (F^[Q+1]=116) And (F^[Q+2]=114) And (F^[Q+3]=102) And
       IsAud And (Sz3>=16) And (Not Found) Then Begin
       Tag:=NVRL16(F,Size,Q+8);
       If Tag=$594A Then Begin Found:=True; AIdx:=Idx; Chn:=NVRL16(F,Size,Q+10);
        Rate:=NVRL32(F,Size,Q+12); End;
      End;
      Inc(Q,8+Sz3+(Sz3 And 1));
     End;
    End;
   End Else If (Mode=1) And Found And (F^[P]=48+(AIdx Div 10)) And (F^[P+1]=48+(
    AIdx Mod 10)) And (F^[P+2]=119) And (F^[P+3]=98) Then Begin
    Cid:=Z;
    If Cid>0 Then XDPacket(PEABuffer(@F^[P+8]),Cid,Chn);
   End;
   Inc(P,8+Z+(Z And 1));
  End;
 End;
Begin
 H8XanAvi:=False;
 G2Load(Source,F,Size);
 If (Size<12) Or (F^[0]<>82) Or (F^[1]<>73) Or (F^[2]<>70) Or (F^[3]<>70) Or (
  F^[8]<>65) Or (F^[9]<>86) Or (F^[10]<>73) Then Begin FreeMem(F,Size+64); Exit;
  End;
 Found:=False; Idx:=-1; AIdx:=-1; Chn:=0; Rate:=0;
 { premiere passe : en-tetes seulement }
 Walk(12,Size);
 If Mode=0 Then Begin H8XanAvi:=Found; FreeMem(F,Size+64); Exit; End;
 If Not Found Then Fail('xan_dpcm: aucun flux audio 0x594a dans l''AVI.');
 If (Chn<1) Or (Chn>2) Then Fail('xan_dpcm: mono ou stereo requis.');
 If Rate<1 Then Fail('xan_dpcm: frequence invalide.');
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,Chn,0);
 Mode:=1; Idx:=-1; Walk(12,Size);
 EAFlush;
 ADPCMPatchHeader(Rate,Chn,EAWritten); CloseWrite;
 FreeMem(F,Size+64);
 H8XanAvi:=True;
End;

