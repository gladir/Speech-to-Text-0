Function G2ABits(N: LongInt): LongInt;
Var V,Z: LongInt;
Begin
 V:=0;
 For Z:=0 To N-1 Do Begin
  If ((G2AB(G2ABp Shr 3) Shr (G2ABp And 7)) And 1)<>0 Then V:=V Or (LongInt(1)
   Shl Z);
  Inc(G2ABp);
 End;
 G2ABits:=V;
End;

