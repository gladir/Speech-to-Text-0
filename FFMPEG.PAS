 Inc(Q,MPCBuild8(19,MPC8Q9Len,0,MPC8QSyms,Q,0));
 Off:=0; S:=0; Tmp:=0;
 For I:=0 To 1 Do Begin
  Inc(Off,MPCBuild8(20+I,MPC8ScfiLen,I*16,MPC8ScfiSyms,Off,0));
 End;
 Off:=0;
 For I:=0 To 1 Do Inc(Off,MPCBuild8(22+I,MPC8DscfLen,I*16,MPC8DscfSyms,Off,0));
 Off:=0;
 For I:=0 To 1 Do Inc(Off,MPCBuild8(24+I,MPC8ResLen,I*16,MPC8ResSyms,Off,0));
 For I:=0 To 1 Do Begin
  Inc(Q,MPCBuild8(26+I,MPC8Q2Len,I*16,MPC8QSyms,Q,0));
  Inc(Q,MPCBuild8(28+I,MPC8Q34Len,I*16,MPC8QSyms,Q,-48-16*I));
  For J:=0 To 3 Do
   Inc(Q,MPCBuild8(30+J*2+I,MPC8Q58Len,I*64+J*16,MPC8QSyms,Q,-((8 Shl J)-1)));
 End;
End;

Procedure MPCLfgInit;
Var Tmp: Array[0..15] Of Byte; I,J: LongInt; Seed: LongWord;
Begin
 Seed:=$DEADBEEF;
 FillChar(MPCC^.Lfg,SizeOf(MPCC^.Lfg),0); FillChar(Tmp,16,0);
 I:=8;
 While I<64 Do Begin
  Tmp[0]:=Seed And 255; Tmp[1]:=(Seed Shr 8) And 255; Tmp[2]:=(Seed Shr 16) And
   255; Tmp[3]:=Seed Shr 24; Tmp[4]:=I;
  EC3Md5(Tmp);
  For J:=0 To 3 Do MPCC^.Lfg[I+J]:=Tmp[J*4] Or (LongWord(Tmp[J*4+1]) Shl 8) Or (
   LongWord(Tmp[J*4+2]) Shl 16) Or (LongWord(Tmp[J*4+3]) Shl 24);
  Inc(I,4);
 End;
 MPCC^.LfgIdx:=0;
End;
Function MPCLfgGet: LongWord;
Var A: LongWord;
Begin
 A:=MPCC^.Lfg[(MPCC^.LfgIdx-24) And 63]+MPCC^.Lfg[(MPCC^.LfgIdx-55) And 63];
 MPCC^.Lfg[MPCC^.LfgIdx And 63]:=A; Inc(MPCC^.LfgIdx); MPCLfgGet:=A;
End;

Function MPCClipF(V: Single): LongInt;
Begin
 If V<-2147483648.0 Then V:=-2147483648.0;
 If V>2147483648.0 Then V:=2147483648.0;
 If V>=2147483648.0 Then MPCClipF:=LongInt($80000000) Else MPCClipF:=Trunc(V);
End;

Procedure MPCSynthStep(Ch,I: LongInt);
Begin
 MPASynthFilterFix(MPCC^.Syn,Ch,PMPASingles(@MPCC^.Plane[Ch]^[32*I]),1,32*I);
End;

{ ff_mpc_dequantize_and_synth : maxband = dernier sous-bande utilise }
Procedure MPCDequantSynth(MaxBand: LongInt);
Var
 C: PMPC; I,J,Ch,Off,Idx: LongInt; Mul,V: Single; T1,T2: LongWord;
Begin
 C:=MPCC;
 FillChar(C^.Syn^.SbI,SizeOf(C^.Syn^.SbI),0);
 Off:=0;
 For I:=0 To MaxBand Do Begin
  For Ch:=0 To 1 Do If C^.Bands[I].Res[Ch]<>0 Then Begin
   For J:=0 To 35 Do Begin
    Idx:=C^.Bands[I].Scf[Ch,J Div 12] And $FF;
    Mul:=MPCCC[C^.Bands[I].Res[Ch]+1]; Mul:=Mul*MPCScf[Idx];
    V:=C^.Q[Ch,J+Off]; V:=Mul*V;
    C^.Syn^.SbI[Ch,J*32+I]:=MPCClipF(V);
   End;
  End;
  If C^.Bands[I].Msf<>0 Then
   For J:=0 To 35 Do Begin
    T1:=LongWord(C^.Syn^.SbI[0,J*32+I]); T2:=LongWord(C^.Syn^.SbI[1,J*32+I]);
    C^.Syn^.SbI[0,J*32+I]:=LongInt(T1+T2); C^.Syn^.SbI[1,J*32+I]:=LongInt(T1-
     T2);
   End;
  Inc(Off,36);
 End;
 C^.Syn^.Dither:=0;
 For Ch:=0 To C^.Channels-1 Do
  For I:=0 To 35 Do MPCSynthStep(Ch,I);
End;

{ ---- SV7 ---- }
Procedure MPC7ReadQuant(Idx: LongInt; Q: Integer; Off: LongInt);
Var I,I1,T: LongInt;
Begin
 Case Idx Of
  -1: For I:=0 To 35 Do MPCC^.Q[Q,Off+I]:=LongInt(MPCLfgGet And $3FC)-510;
  1: Begin
   I1:=MPCGet(1);
   For I:=0 To 11 Do Begin
    T:=MPCVlcGet(3+0*2+I1);
    MPCC^.Q[Q,Off+3*I]:=MPC7Idx30[T]; MPCC^.Q[Q,Off+3*I+1]:=MPC7Idx31[T];
     MPCC^.Q[Q,Off+3*I+2]:=MPC7Idx32[T];
   End;
  End;
  2: Begin
   I1:=MPCGet(1);
   For I:=0 To 17 Do Begin
    T:=MPCVlcGet(3+1*2+I1);
    MPCC^.Q[Q,Off+2*I]:=MPC7Idx50[T]; MPCC^.Q[Q,Off+2*I+1]:=MPC7Idx51[T];
   End;
  End;
  3..7: Begin
   I1:=MPCGet(1);
   For I:=0 To 35 Do MPCC^.Q[Q,Off+I]:=MPCVlcGet(3+(Idx-1)*2+I1);
  End;
  8..17: Begin
   T:=(LongInt(1) Shl (Idx-2))-1;
   For I:=0 To 35 Do MPCC^.Q[Q,Off+I]:=MPCGet(Idx-1)-T;
  End;
 End;
End;

Function MPC7ScaleIdx(Ref: LongInt): LongInt;
Var T: LongInt;
Begin
 T:=MPCVlcGet(1);
 If T=8 Then MPC7ScaleIdx:=MPCGet(6) Else MPC7ScaleIdx:=Ref+T;
End;

{ renvoie 1 si une trame est produite (0 si erreur) ; Lastf = drapeau de
 derniere trame ; Skip = decalage de bits }
Function MPC7Frame(Skip,LastFrame: LongInt; Var Samples: LongInt): LongInt;
Var
 C: PMPC; I,Ch,T,Mb,Off,BitsUsed,BitsAvail: LongInt;
Begin
 C:=MPCC; MPC7Frame:=0; Mb:=-1;
 FillChar(C^.Bands,SizeOf(TMPCBand)*(C^.Maxbands+1),0);
 MPCSkip(Skip);
 For I:=0 To C^.Maxbands Do Begin
  For Ch:=0 To 1 Do Begin
   If I<>0 Then T:=MPCVlcGet(2) Else T:=4;
   If T=4 Then C^.Bands[I].Res[Ch]:=MPCGet(4) Else C^.Bands[I].Res[Ch]:=
    C^.Bands[I-1].Res[Ch]+T;
   If (C^.Bands[I].Res[Ch]<-1) Or (C^.Bands[I].Res[Ch]>17) Then Exit;
  End;
  If (C^.Bands[I].Res[0]<>0) Or (C^.Bands[I].Res[1]<>0) Then Begin
   Mb:=I;
   If C^.MSS<>0 Then C^.Bands[I].Msf:=MPCGet(1);
  End;
 End;
 For I:=0 To Mb Do For Ch:=0 To 1 Do If C^.Bands[I].Res[Ch]<>0 Then C^.Bands[
  I].Scfi[Ch]:=MPCVlcGet(0);
 For I:=0 To Mb Do For Ch:=0 To 1 Do If C^.Bands[I].Res[Ch]<>0 Then Begin
  With C^.Bands[I] Do Begin
   Scf[Ch,2]:=C^.OldDSCF[Ch,I];
   Scf[Ch,0]:=MPC7ScaleIdx(Scf[Ch,2]);
   Case Scfi[Ch] Of
    0: Begin Scf[Ch,1]:=MPC7ScaleIdx(Scf[Ch,0]); Scf[Ch,2]:=MPC7ScaleIdx(Scf[Ch,
     1]); End;
    1: Begin Scf[Ch,1]:=MPC7ScaleIdx(Scf[Ch,0]); Scf[Ch,2]:=Scf[Ch,1]; End;
    2: Begin Scf[Ch,1]:=Scf[Ch,0]; Scf[Ch,2]:=MPC7ScaleIdx(Scf[Ch,1]); End;
    3: Begin Scf[Ch,1]:=Scf[Ch,0]; Scf[Ch,2]:=Scf[Ch,0]; End;
   End;
   C^.OldDSCF[Ch,I]:=Scf[Ch,2];
  End;
 End;
 FillChar(C^.Q,SizeOf(C^.Q),0);
 Off:=0;
 For I:=0 To 31 Do Begin
  For Ch:=0 To 1 Do MPC7ReadQuant(C^.Bands[I].Res[Ch],Ch,Off);
  Inc(Off,36);
 End;
 MPCDequantSynth(Mb);
 Samples:=1152; If LastFrame<>0 Then Samples:=C^.LastFrameLen;
 BitsUsed:=C^.BitPos; BitsAvail:=C^.BitLimit;
 MPC7Frame:=1;
 If (LastFrame=0) And ((BitsAvail<BitsUsed) Or (BitsUsed+32<=BitsAvail)) Then
  MPC7Frame:=0;
End;

{ ---- SV8 ---- }
Function MPC8DecBase(K,N: LongInt): LongInt;
Var Len,Code,Lost: LongInt;
Begin
 Len:=MPC8CnkLen[(K-1)*33+N-1]-1;
 If Len<>0 Then Code:=MPCGet(Len) Else Code:=0;
 Lost:=MPC8CnkLost[(K-1)*33+N-1];
 If LongWord(Code)>=LongWord(Lost) Then Code:=LongInt(((LongWord(Code) Shl 1) Or
  LongWord(MPCGet(1)))-LongWord(Lost));
 MPC8DecBase:=Code;
End;

Function MPC8DecEnum(K,N: LongInt): LongInt;
Var Bits,Code,Row: LongInt;
Begin
 Bits:=0; Row:=K-1;
 Code:=MPC8DecBase(K,N);
 Repeat
  Dec(N);
  If LongWord(Code)>=MPC8Cnk[Row*32+N] Then Begin
   Bits:=Bits Or (LongInt(1) Shl N);
   Code:=LongInt(LongWord(Code)-MPC8Cnk[Row*32+N]);
   Dec(Row); Dec(K);
  End;
 Until K<=0;
 MPC8DecEnum:=Bits;
End;

Function MPC8ModGolomb(M: LongInt): LongInt;
Begin
 If MPC8CnkLen[M]<1 Then Begin MPC8ModGolomb:=0; Exit; End;
 MPC8ModGolomb:=MPC8DecBase(1,M+1);
End;

Function MPC8GetMask(Size,T: LongInt): LongInt;
Var Mask,M: LongInt;
Begin
 Mask:=0;
 If (T<>0) And (T<>Size) Then Begin
  M:=T; If Size-T<M Then M:=Size-T;
  Mask:=MPC8DecEnum(M,Size);
 End;
 If (T Shl 1)>Size Then Mask:=Not Mask;
 MPC8GetMask:=Mask;
End;

{ Ret = octets consommes ; renvoie False si erreur ; Got = trame produite }
Function MPC8Frame(BufSize: LongInt; Var Got: Boolean; Var Ret: LongInt):
 Boolean;
Var
 C: PMPC; I,J,K,Ch,Cnt,Res,T,Off,MaxBand,Mask: LongInt; Keyframe: Boolean; Last:
  Array[0..1] Of LongInt; Th: LongInt; V: LongInt;
Begin
 C:=MPCC; MPC8Frame:=False; Got:=False; Ret:=BufSize;
 Keyframe:=C^.CurFrame=0;
 If Keyframe Then Begin FillChar(C^.Q,SizeOf(C^.Q),0); C^.LastBitsUsed:=0; End;
 C^.BitPos:=0; C^.BitLimit:=BufSize*8;
 MPCSkip(C^.LastBitsUsed And 7);
 If Keyframe Then MaxBand:=MPC8ModGolomb(C^.Maxbands+1)
 Else Begin
  MaxBand:=C^.LastMaxBand+MPCVlcGet(17);
  If MaxBand>32 Then Dec(MaxBand,33);
 End;
 If MPCLeft<0 Then Begin MPC8Frame:=True; Exit; End;
 If MaxBand>C^.Maxbands+1 Then Exit;
 C^.LastMaxBand:=MaxBand;
 If MaxBand<>0 Then Begin
  Last[0]:=0; Last[1]:=0;
  For I:=MaxBand-1 DownTo 0 Do
   For Ch:=0 To 1 Do Begin
    Last[Ch]:=MPCVlcGet(24+Ord(Last[Ch]>2))+Last[Ch];
    If Last[Ch]>15 Then Dec(Last[Ch],17);
    C^.Bands[I].Res[Ch]:=Last[Ch];
   End;
  If C^.MSS<>0 Then Begin
   Cnt:=0;
   For I:=0 To MaxBand-1 Do If (C^.Bands[I].Res[0]<>0) Or (C^.Bands[I].Res[
    1]<>0) Then Inc(Cnt);
   T:=MPC8ModGolomb(Cnt);
   Mask:=MPC8GetMask(Cnt,T);
   For I:=MaxBand-1 DownTo 0 Do
    If (C^.Bands[I].Res[0]<>0) Or (C^.Bands[I].Res[1]<>0) Then Begin
     C^.Bands[I].Msf:=Mask And 1;
     Mask:=LongInt(MPASarL(Mask,1));
    End;
  End;
 End;
 For I:=MaxBand To C^.Maxbands-1 Do Begin C^.Bands[I].Res[0]:=0; C^.Bands[
  I].Res[1]:=0; End;
 If Keyframe Then For I:=0 To 31 Do Begin C^.OldDSCF[0,I]:=1; C^.OldDSCF[1,I]:=
  1; End;
 For I:=0 To MaxBand-1 Do
  If (C^.Bands[I].Res[0]<>0) Or (C^.Bands[I].Res[1]<>0) Then Begin
   Cnt:=Ord(C^.Bands[I].Res[0]<>0)+Ord(C^.Bands[I].Res[1]<>0)-1;
   If Cnt>=0 Then Begin
    T:=MPCVlcGet(20+Cnt);
    If C^.Bands[I].Res[0]<>0 Then C^.Bands[I].Scfi[0]:=T Shr (2*Cnt);
    If C^.Bands[I].Res[1]<>0 Then C^.Bands[I].Scfi[1]:=T And 3;
   End;
  End;
 For I:=0 To MaxBand-1 Do
  For Ch:=0 To 1 Do Begin
   If C^.Bands[I].Res[Ch]=0 Then Continue;
   With C^.Bands[I] Do Begin
    If C^.OldDSCF[Ch,I]<>0 Then Begin
     Scf[Ch,0]:=MPCGet(7)-6; C^.OldDSCF[Ch,I]:=0;
    End Else Begin
     T:=MPCVlcGet(23);
     If T=64 Then Inc(T,MPCGet(6));
     Scf[Ch,0]:=((Scf[Ch,2]+T-25) And $7F)-6;
    End;
    For J:=0 To 1 Do Begin
     If ((Scfi[Ch] Shl J) And 2)<>0 Then Scf[Ch,J+1]:=Scf[Ch,J]
     Else Begin
      T:=MPCVlcGet(22);
      If T=31 Then T:=64+MPCGet(6);
      Scf[Ch,J+1]:=((Scf[Ch,J]+T-25) And $7F)-6;
     End;
    End;
   End;
  End;
 Off:=0;
 For I:=0 To MaxBand-1 Do Begin
  For Ch:=0 To 1 Do Begin
   Res:=C^.Bands[I].Res[Ch];
   Case Res Of
    -1: For J:=0 To 35 Do C^.Q[Ch,Off+J]:=LongInt(MPCLfgGet And $3FC)-510;
    0: ;
    1: Begin
     J:=0;
     While J<36 Do Begin
      Cnt:=MPCVlcGet(18);
      T:=MPC8GetMask(18,Cnt);
      For K:=0 To 17 Do
       If T And (LongInt(1) Shl (17-K))<>0 Then C^.Q[Ch,Off+J+K]:=(MPCGet(1) Shl
        1)-1 Else C^.Q[Ch,Off+J+K]:=0;
      Inc(J,18);
     End;
    End;
    2: Begin
     Cnt:=6; J:=0;
     While J<36 Do Begin
      T:=MPCVlcGet(26+Ord(Cnt>3));
      C^.Q[Ch,Off+J]:=MPC8Idx50[T]; C^.Q[Ch,Off+J+1]:=MPC8Idx51[T]; C^.Q[Ch,Off+
       J+2]:=MPC8Idx52[T];
      Cnt:=(Cnt Shr 1)+MPC8Huffq2[T];
      Inc(J,3);
     End;
    End;
    3,4: Begin
     J:=0;
     While J<36 Do Begin
      T:=MPCVlcGet(28+Res-3);
      C^.Q[Ch,Off+J+1]:=LongInt(MPASarL(T,4));
      C^.Q[Ch,Off+J]:=LongInt(MPASarL(Int64(LongInt((LongWord(T) Shl 28) And
       $FFFFFFFF)),28));
      Inc(J,2);
     End;
    End;
    5..8: Begin
     Th:=MPC8Thres[Res]; Cnt:=2*Th;
     For J:=0 To 35 Do Begin
      V:=MPCVlcGet(30+(Res-5)*2+Ord(Cnt>Th));
      C^.Q[Ch,Off+J]:=V;
      Cnt:=(Cnt Shr 1)+Abs(V);
     End;
    End;
    Else Begin
     For J:=0 To 35 Do Begin
      V:=MPCVlcGet(19);
      If Res<>9 Then Begin
       V:=LongInt(LongWord(V) Shl (Res-9));
       V:=V Or MPCGet(Res-9);
      End;
      V:=V-((LongInt(1) Shl (Res-2))-1);
      C^.Q[Ch,Off+J]:=V;
     End;
    End;
   End;
  End;
  Inc(Off,36);
 End;
 MPCDequantSynth(MaxBand-1);
 Inc(C^.CurFrame);
 C^.LastBitsUsed:=C^.BitPos;
 If C^.CurFrame>=C^.Frames Then C^.CurFrame:=0;
 If MPCLeft<0 Then C^.LastBitsUsed:=BufSize Shl 3
 Else If (C^.CurFrame=0) And (MPCLeft<8) Then C^.LastBitsUsed:=BufSize Shl 3;
 Got:=True;
 If C^.CurFrame<>0 Then Ret:=C^.LastBitsUsed Shr 3 Else Ret:=BufSize;
 MPC8Frame:=True;
End;

{ debut du flux apres un eventuel en-tete ID3v2 }
Function MPCBase: LongInt;
Var H: Array[0..9] Of Byte; N: LongInt;
Begin
 MPCBase:=0;
 If InputSize<10 Then Exit;
 ReadAt(0,H,10);
 If (H[0]=Ord('I')) And (H[1]=Ord('D')) And (H[2]=Ord('3')) And (H[6] And $80=0)
  And (H[7] And $80=0) And (H[8] And $80=0) And (H[9] And $80=0) Then Begin
  N:=(LongInt(H[6]) Shl 21) Or (LongInt(H[7]) Shl 14) Or (LongInt(H[8]) Shl 7)
   Or H[9];
  N:=N+10; If H[5] And $10<>0 Then Inc(N,10);
  MPCBase:=N;
 End;
End;

Function MPCKind: LongInt;
Var H: Array[0..3] Of Byte; B: LongInt;
Begin
 MPCKind:=0; B:=MPCBase;
 If InputSize<B+4 Then Exit;
 ReadAt(B,H,4);
 If (H[0]=Ord('M')) And (H[1]=Ord('P')) And (H[2]=Ord('+')) And ((H[3]=7) Or (H[
  3]=$17)) Then MPCKind:=7
 Else If (H[0]=Ord('M')) And (H[1]=Ord('P')) And (H[2]=Ord('C')) And (H[3]=Ord(
  'K')) Then MPCKind:=8;
End;

Function MPCProbeFile(Const Name: String): LongInt;
Begin
 OpenRead(Name); MPCProbeFile:=MPCKind; CloseRead;
End;

Procedure MPCSetup;
Begin
 MPAInit; EAReset; MPCInitVlcs;
 GetMem(MPCC,SizeOf(TMPC)); FillChar(MPCC^,SizeOf(TMPC),0);
 GetMem(MPCC^.Syn,SizeOf(TMPA)); FillChar(MPCC^.Syn^,SizeOf(TMPA),0);
 GetMem(MPCC^.Plane[0],1200*SizeOf(Single)); GetMem(MPCC^.Plane[1],1200*SizeOf(
  Single));
 FillChar(MPCC^.Plane[0]^,1200*SizeOf(Single),0); FillChar(MPCC^.Plane[1]^,1200*
  SizeOf(Single),0);
 MPCLfgInit;
End;

Procedure MPCEmit(Samples,Nch: LongInt);
Var I,Ch: LongInt;
Begin
 For I:=0 To Samples-1 Do For Ch:=0 To Nch-1 Do EAPut(Round(MPCC^.Plane[Ch]^[
  I]));
End;

Procedure DecodeMPC7(Const Source,Target: String);
Var
 H: Array[0..23] Of Byte; Sw: Array[0..31] Of Byte; Base,FCount,I,Cur,Pos,
  CurBits,Tmp,Size2,Size,Fsz,Last,Skip,Samples,Rate,Total: LongInt;
 W: Array[0..7] Of Byte; Pk: PEABuffer; Started: Boolean; Rates: Array[0..3] Of
  LongInt;
Begin
 Rates[0]:=44100; Rates[1]:=48000; Rates[2]:=37800; Rates[3]:=32000;
 MPCSetup; OpenRead(Source);
 Base:=MPCBase;
 If InputSize<Base+24 Then Fail('mpc7: fichier tronque.');
 ReadAt(Base,H,24);
 FCount:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+LongInt(H[7])*
  16777216;
 If FCount<0 Then Fail('mpc7: nombre de trames incorrect.');
 Rate:=Rates[H[10] And 3];
 FillChar(Sw,SizeOf(Sw),0);
 For I:=0 To 3 Do Begin Sw[I*4]:=H[8+I*4+3]; Sw[I*4+1]:=H[8+I*4+2]; Sw[I*4+2]:=
  H[8+I*4+1]; Sw[I*4+3]:=H[8+I*4]; End;
 MPCC^.Buf:=PEABuffer(@Sw[0]); MPCC^.BitPos:=0; MPCC^.BitLimit:=128;
 MPCC^.IS:=MPCGet(1); MPCC^.MSS:=MPCGet(1); MPCC^.Maxbands:=MPCGet(6);
 If MPCC^.Maxbands>=32 Then Fail('mpc7: trop de sous-bandes.');
 MPCSkip(88);
 MPCC^.Gapless:=MPCGet(1); MPCC^.LastFrameLen:=MPCGet(11);
 MPCC^.Channels:=2;
 OpenWrite(Target); Started:=False;
 Pos:=Base+24; CurBits:=8; Cur:=0;
 While (Cur<FCount) Or (FCount=0) Do Begin
  Tmp:=0;
  If Pos+4<=InputSize Then Begin ReadAt(Pos,W,4); Tmp:=LongInt(LongWord(W[0]) Or
   (LongWord(W[1]) Shl 8) Or (LongWord(W[2]) Shl 16) Or (LongWord(W[3]) Shl
   24)); End;
  If CurBits<=12 Then Size2:=(LongWord(Tmp) Shr (12-CurBits)) And $FFFFF
  Else Begin
   If Pos+8<=InputSize Then Begin ReadAt(Pos+4,W,4); Total:=LongInt(LongWord(W[
    0]) Or (LongWord(W[1]) Shl 8) Or (LongWord(W[2]) Shl 16) Or (LongWord(W[3])
    Shl 24)); End Else Total:=0;
   Size2:=((LongWord(Tmp) Shl (CurBits-12)) Or (LongWord(Total) Shr (44-
    CurBits))) And $FFFFF;
  End;
  Inc(CurBits,20);
  Size:=((Size2+CurBits+31) And Not 31) Shr 3;
  Inc(Cur);
  If Pos+Size>InputSize Then Break;
  Last:=0; If (Cur>FCount) And (FCount<>0) Then Last:=1;
  Fsz:=CurBits; Skip:=Fsz And 255;
  CurBits:=Fsz;
  GetMem(Pk,Size+16); FillChar(Pk^,Size+16,0);
  I:=0;
  While I<Size Do Begin
   Total:=Size-I; If Total>4096 Then Total:=4096;
   ReadAt(Pos+I,Pk^[I],Total); Inc(I,Total);
  End;
  { echange d octets par mot de 32 bits }
  I:=0;
  While I<Size Do Begin
   Total:=Pk^[I]; Pk^[I]:=Pk^[I+3]; Pk^[I+3]:=Total; Total:=Pk^[I+1]; Pk^[I+1]:=
    Pk^[I+2]; Pk^[I+2]:=Total;
   Inc(I,4);
  End;
  MPCC^.Buf:=Pk; MPCC^.BitPos:=0; MPCC^.BitLimit:=Size*8;
  If MPC7Frame(Skip,Last,Samples)<>0 Then Begin
   If Not Started Then Begin Started:=True; ADPCMWaveHeader(Rate,2,0); End;
   MPCEmit(Samples,2);
  End;
  FreeMem(Pk,Size+16);
  CurBits:=(CurBits+Size2) And 31;
  Pos:=Pos+Size; If CurBits<>0 Then Dec(Pos,4);
 End;
 EAFlush;
 If EAWritten=0 Then Fail('mpc7: aucune donnee audio decodee.');
 ADPCMPatchHeader(Rate,2,EAWritten);
 CloseRead; CloseWrite;
End;

{ debut d une etiquette APE en fin de fichier (0 si absente) }
Function MPCApeStart: LongInt;
Var F: Array[0..31] Of Byte; P,Sz,Fl: LongInt; K: LongInt;
Begin
 MPCApeStart:=0;
 For K:=0 To 1 Do Begin
  If K=0 Then P:=InputSize-32 Else P:=InputSize-128-32;
  If P<0 Then Continue;
  ReadAt(P,F,32);
  If (F[0]=Ord('A')) And (F[1]=Ord('P')) And (F[2]=Ord('E')) And (F[3]=Ord('T'))
   And (F[4]=Ord('A')) And (F[5]=Ord('G')) And (F[6]=Ord('E')) And (F[7]=Ord(
   'X')) Then Begin
   Sz:=LongInt(F[12])+LongInt(F[13])*256+LongInt(F[14])*65536+LongInt(F[15] And
    127)*16777216;
   Fl:=F[23];
   P:=P+32-Sz; If Fl And $80<>0 Then Dec(P,32);
   If P>0 Then MPCApeStart:=P;
   Exit;
  End;
 End;
End;

Function MPCReadVarlen(Var Pos: LongInt): Int64;
Var V: Int64; T: Byte;
Begin
 V:=0;
 Repeat
  If Pos>=InputSize Then T:=0 Else ReadAt(Pos,T,1);
  Inc(Pos);
  V:=(V Shl 7)+(T And $7F);
 Until (T And $80=0) Or (Pos>InputSize);
 MPCReadVarlen:=V;
End;

Procedure DecodeMPC8(Const Source,Target: String);
Var
 Base,Pos,ChunkPos,ApeEnd,Nch,Rate,Rated,I,PSize,Off,Ret,Hdr,Total,Ex0,Ex1:
  LongInt; Tag: Word; Size: Int64; T2: Byte;
 Pk: PEABuffer; Got,Ok,Started: Boolean; Rates: Array[0..7] Of LongInt; Tmp:
  Array[0..1] Of Byte; Samples: LongInt; Ver: Byte;
Begin
 Rates[0]:=44100; Rates[1]:=48000; Rates[2]:=37800; Rates[3]:=32000; Rates[4]:=-
  1; Rates[5]:=-1; Rates[6]:=-1; Rates[7]:=-1;
 MPCSetup; OpenRead(Source);
 Base:=MPCBase; Pos:=Base+4; Tag:=0; Started:=False;
 While Pos+2<=InputSize Do Begin
  ChunkPos:=Pos;
  ReadAt(Pos,Tmp,2); Tag:=Tmp[0]+Tmp[1]*256; Inc(Pos,2);
  Size:=MPCReadVarlen(Pos);
  Size:=Size-(Pos-ChunkPos);
  If (Size<0) Or (Size>2147483647) Then Fail(
   'mpc8: longueur de bloc incorrecte.');
  If Tag=Ord('S')+Ord('H')*256 Then Break;
  Inc(Pos,Size);
 End;
 If Tag<>Ord('S')+Ord('H')*256 Then Fail('mpc8: en-tete de flux absent.');
 Hdr:=Pos;
 Inc(Pos,4);
 ReadAt(Pos,Ver,1); Inc(Pos);
 If Ver<>8 Then Fail('mpc8: version de flux non prise en charge.');
 MPCReadVarlen(Pos); MPCReadVarlen(Pos);
 ReadAt(Pos,Tmp,2); Ex0:=Tmp[0]; Ex1:=Tmp[1]; Inc(Pos,2);
 Nch:=(Ex1 Shr 4)+1; Rate:=Rates[Ex0 Shr 5];
 { init du decodeur }
 MPCC^.Maxbands:=(Ex0 And 31)+1;
 If MPCC^.Maxbands>=32 Then Fail('mpc8: trop de sous-bandes.');
 If Nch>2 Then Fail('mpc8: multicanal non pris en charge.');
 MPCC^.MSS:=(Ex1 Shr 3) And 1; MPCC^.Frames:=1 Shl (((Ex1) And 7)*2);
 MPCC^.Channels:=Nch;
 Pos:=Hdr+Size;
 ApeEnd:=MPCApeStart;
 OpenWrite(Target);
 While Pos+2<=InputSize Do Begin
  If (ApeEnd<>0) And (Pos>=ApeEnd) Then Break;
  ChunkPos:=Pos;
  ReadAt(Pos,Tmp,2); Tag:=Tmp[0]+Tmp[1]*256; Inc(Pos,2);
  Size:=MPCReadVarlen(Pos);
  Size:=Size-(Pos-ChunkPos);
  If (Size<0) Or (Size>2147483647) Then Break;
  If Tag=Ord('A')+Ord('P')*256 Then Begin
   PSize:=Size;
   If Pos+PSize>InputSize Then PSize:=InputSize-Pos;
   GetMem(Pk,PSize+16); FillChar(Pk^,PSize+16,0);
   I:=0;
   While I<PSize Do Begin
    Total:=PSize-I; If Total>4096 Then Total:=4096;
    ReadAt(Pos+I,Pk^[I],Total); Inc(I,Total);
   End;
   Off:=0;
   While Off<PSize Do Begin
    MPCC^.Buf:=PEABuffer(@Pk^[Off]);
    Ok:=MPC8Frame(PSize-Off,Got,Ret);
    If Not Ok Then Break;
    If Got Then Begin
     If Not Started Then Begin Started:=True; ADPCMWaveHeader(Rate,Nch,0); End;
     MPCEmit(1152,Nch);
    End;
    If (Ret<=0) And Not Got Then Break;
    Inc(Off,Ret);
   End;
   FreeMem(Pk,PSize+16);
  End Else If Tag=Ord('S')+Ord('E')*256 Then Break;
  Inc(Pos,Size);
 End;
 EAFlush;
 If EAWritten=0 Then Fail('mpc8: aucune donnee audio decodee.');
 ADPCMPatchHeader(Rate,Nch,EAWritten);
 CloseRead; CloseWrite;
End;

Procedure DecodeMPC(Const Source,Target: String);
Begin
 OpenRead(Source);
 If MPCKind=7 Then Begin CloseRead; DecodeMPC7(Source,Target); End
 Else If MPCKind=8 Then Begin CloseRead; DecodeMPC8(Source,Target); End
 Else Fail('Fichier Musepack non reconnu.');
End;
{ MPC-END }

