Function VPSar(X,N: LongInt): LongInt;
Begin
 If X>=0 Then VPSar:=X Shr N Else VPSar:=Not((Not X) Shr N);
End;

Function VPClip(X: LongInt): LongInt;
Begin
 If X<0 Then VPClip:=0 Else If X>255 Then VPClip:=255 Else VPClip:=X;
End;

Function VPAbs(X: LongInt): LongInt;
Begin If X<0 Then VPAbs:=-X Else VPAbs:=X; End;

{ ---- codeur arithmetique (vpx_rac.h) ---- }
Function VPRacInit(Var R: TVPRng; Pos,Size: LongInt): Boolean;
Begin
 R.High:=255; R.Bits:=-16; R.Buf:=Pos; R.EndP:=Pos+Size; R.EndRch:=0; R.Code:=0;
 If Size<1 Then Begin VPRacInit:=False; Exit; End;
 R.Code:=Int64(VPM^[Pos])*65536+VPM^[Pos+1]*256+VPM^[Pos+2]; R.Buf:=Pos+3;
 VPRacInit:=True;
End;

Function VPGet(Var R: TVPRng; Prob: LongInt): LongInt;
Var Sh,Bt,Low: LongInt; Cw,Ls: Int64;
Begin
 Sh:=VPNorm[R.High]; Bt:=R.Bits; Cw:=R.Code;
 R.High:=R.High Shl Sh; Cw:=(Cw Shl Sh) And $FFFFFFFF; Bt:=Bt+Sh;
 If (Bt>=0) And (R.Buf<R.EndP) Then Begin
  Cw:=Cw Or (Int64(VPM^[R.Buf]*256+VPM^[R.Buf+1]) Shl Bt); Inc(R.Buf,2); Bt:=Bt-
   16;
 End;
 R.Bits:=Bt;
 Low:=1+(((R.High-1)*Prob) Shr 8);
 Ls:=Int64(Low) Shl 16;
 If Cw>=Ls Then Begin R.High:=R.High-Low; R.Code:=Cw-Ls; VPGet:=1; End
 Else Begin R.High:=Low; R.Code:=Cw; VPGet:=0; End;
End;

Function VPIsEnd(Var R: TVPRng): Boolean;
Begin
 If (R.EndP<=R.Buf) And (R.Bits>=0) Then Inc(R.EndRch);
 VPIsEnd:=R.EndRch>10;
End;

Function VPGets(Var R: TVPRng; N: LongInt): LongInt;
Var V: LongInt;
Begin
 V:=0;
 While N>0 Do Begin V:=V*2+VPGet(R,128); Dec(N); End;
 VPGets:=V;
End;

Function VPGetsNN(Var R: TVPRng): LongInt;
Var V: LongInt;
Begin
 V:=VPGets(R,7)*2;
 If V=0 Then V:=1;
 VPGetsNN:=V;
End;

Function VPTree(Var R: TVPRng; Const TV,TP: Array Of ShortInt; Probs: PVPB):
 LongInt;
Var I: LongInt;
Begin
 I:=0;
 While TV[I]>0 Do Begin
  If VPGet(R,Probs^[TP[I]])<>0 Then I:=I+TV[I] Else I:=I+1;
 End;
 VPTree:=-TV[I];
End;

{ ---- lecteur de bits (get_bits, lecture sure) ---- }
Function VPGB(Var S: TVPCtx; N: LongInt): LongInt;
Var I,P,V: LongInt;
Begin
 V:=0;
 For I:=0 To N-1 Do Begin
  P:=S.GPos+I;
  V:=V*2+((VPM^[S.GBase+(P Shr 3)] Shr (7-(P And 7))) And 1);
 End;
 S.GPos:=S.GPos+N; If S.GPos>S.GSize+8 Then S.GPos:=S.GSize+8;
 VPGB:=V;
End;

Function VPVlc(Var S: TVPCtx; Var H: TVPHuf): LongInt;
Var L,I,P,Code,Bit: LongInt;
Begin
 Code:=0; VPVlc:=0;
 For L:=1 To 12 Do Begin
  P:=S.GPos+L-1;
  Bit:=(VPM^[S.GBase+(P Shr 3)] Shr (7-(P And 7))) And 1;
  Code:=Code*2+Bit;
  For I:=0 To H.N-1 Do
   If (H.Len[I]=L) And (H.Code[I]=Code) Then Begin
    S.GPos:=S.GPos+L; If S.GPos>S.GSize+8 Then S.GPos:=S.GSize+8;
    VPVlc:=H.Sym[I]; Exit;
   End;
 End;
 S.GPos:=S.GPos+12; If S.GPos>S.GSize+8 Then S.GPos:=S.GSize+8;
End;

{ ---- arbre de Huffman (huffman.c, vp6_build_huff_tree) ---- }
Procedure VPBuildHuff(Var H: TVPHuf; Model: PVPB; IsRun: Boolean; Size:
 LongInt);
Var Nodes: Array[0..25] Of TVPNode; I,J,A,B,CurNode,NB,Pos: LongInt; Cur:
 LongInt; T: TVPNode;
Function Cmp(Var X,Y: TVPNode): LongInt;
Begin Cmp:=(X.Count-Y.Count)*16+(Y.Sym-X.Sym); End;
Procedure Codes(Node,Pfx,Pl: LongInt);
Begin
 If (Nodes[Node].Sym<>-1) Or (Nodes[Node].Count=0) Then Begin
  H.Code[Pos]:=Pfx; H.Len[Pos]:=Pl; H.Sym[Pos]:=Nodes[Node].Sym; Inc(Pos);
 End Else Begin
  Codes(Nodes[Node].N0,Pfx*2,Pl+1);
  Codes(Nodes[Node].N0+1,Pfx*2+1,Pl+1);
 End;
End;
Begin
 FillChar(Nodes,SizeOf(Nodes),0);
 NB:=Size;
 Nodes[NB].Count:=256;
 For I:=0 To Size-2 Do Begin
  A:=(Nodes[NB+I].Count*Model^[I]) Shr 8;
  B:=(Nodes[NB+I].Count*(255-Model^[I])) Shr 8;
  If IsRun Then Begin
   Nodes[VP6HuffRunMap[2*I]].Count:=A+Ord(A=0); Nodes[VP6HuffRunMap[2*I+
    1]].Count:=B+Ord(B=0);
  End Else Begin
   Nodes[VP6HuffCoeffMap[2*I]].Count:=A+Ord(A=0); Nodes[VP6HuffCoeffMap[2*I+
    1]].Count:=B+Ord(B=0);
  End;
 End;
 For I:=0 To NB-1 Do Begin Nodes[I].Sym:=I; Nodes[I].N0:=-2; End;
 { tri par insertion (ordre total) }
 For I:=1 To NB-1 Do Begin
  T:=Nodes[I]; J:=I-1;
  While (J>=0) And (Cmp(Nodes[J],T)>0) Do Begin Nodes[J+1]:=Nodes[J]; Dec(J);
   End;
  Nodes[J+1]:=T;
 End;
 CurNode:=NB;
 Nodes[NB*2-1].Count:=0;
 I:=0;
 While I<NB*2-1 Do Begin
  Cur:=Nodes[I].Count+Nodes[I+1].Count;
  J:=CurNode;
  While J>I+2 Do Begin
   If Cur>Nodes[J-1].Count Then Break;
   Nodes[J]:=Nodes[J-1]; Dec(J);
  End;
  Nodes[J].Sym:=-1; Nodes[J].Count:=Cur; Nodes[J].N0:=I;
  Inc(CurNode);
  Inc(I,2);
 End;
 Pos:=0;
 Codes(NB*2-2,0,0);
 H.N:=Pos;
End;

{ ---- IDCT VP3 (vp3dsp.c) : blocs de 8x8 dans un plan (Dst = decalage, St =
 pas) ---- }
Function VPM16(A,B: LongInt): LongInt;
Var V: Int64;
Begin
 V:=(Int64(A)*B) And $FFFFFFFF;
 If V>=$80000000 Then V:=V-$100000000;
 VPM16:=VPSar(LongInt(V),16);
End;

Procedure VPIdct(Var Blk: TVPCoef; Buf: PEABuffer; Dst,St,Typ: LongInt);
Var
 I,K,A,B,C,D,Ad,Bd,Cd,Dd,E,F,G,H,Ed,Gd,Add,Bdd,Fd,Hd,V,Ip: LongInt;
Begin
 For I:=0 To 7 Do Begin
  If (Blk[I] Or Blk[8+I] Or Blk[16+I] Or Blk[24+I] Or Blk[32+I] Or Blk[40+I] Or
   Blk[48+I] Or Blk[56+I])<>0 Then Begin
   A:=VPM16(64277,Blk[8+I])+VPM16(12785,Blk[56+I]);
   B:=VPM16(12785,Blk[8+I])-VPM16(64277,Blk[56+I]);
   C:=VPM16(54491,Blk[24+I])+VPM16(36410,Blk[40+I]);
   D:=VPM16(54491,Blk[40+I])-VPM16(36410,Blk[24+I]);
   Ad:=VPM16(46341,A-C); Bd:=VPM16(46341,B-D);
   Cd:=A+C; Dd:=B+D;
   E:=VPM16(46341,Blk[I]+Blk[32+I]); F:=VPM16(46341,Blk[I]-Blk[32+I]);
   G:=VPM16(60547,Blk[16+I])+VPM16(25080,Blk[48+I]);
   H:=VPM16(25080,Blk[16+I])-VPM16(60547,Blk[48+I]);
   Ed:=E-G; Gd:=E+G; Add:=F+Ad; Bdd:=Bd-H; Fd:=F-Ad; Hd:=Bd+H;
   Blk[I]:=Gd+Cd; Blk[56+I]:=Gd-Cd;
   Blk[8+I]:=Add+Hd; Blk[16+I]:=Add-Hd;
   Blk[24+I]:=Ed+Dd; Blk[32+I]:=Ed-Dd;
   Blk[40+I]:=Fd+Bdd; Blk[48+I]:=Fd-Bdd;
  End;
 End;
 For I:=0 To 7 Do Begin
  Ip:=I*8;
  If (Blk[Ip+1] Or Blk[Ip+2] Or Blk[Ip+3] Or Blk[Ip+4] Or Blk[Ip+5] Or Blk[Ip+6]
   Or Blk[Ip+7])<>0 Then Begin
   A:=VPM16(64277,Blk[Ip+1])+VPM16(12785,Blk[Ip+7]);
   B:=VPM16(12785,Blk[Ip+1])-VPM16(64277,Blk[Ip+7]);
   C:=VPM16(54491,Blk[Ip+3])+VPM16(36410,Blk[Ip+5]);
   D:=VPM16(54491,Blk[Ip+5])-VPM16(36410,Blk[Ip+3]);
   Ad:=VPM16(46341,A-C); Bd:=VPM16(46341,B-D);
   Cd:=A+C; Dd:=B+D;
   E:=VPM16(46341,Blk[Ip]+Blk[Ip+4])+8; F:=VPM16(46341,Blk[Ip]-Blk[Ip+4])+8;
   If Typ=1 Then Begin E:=E+16*128; F:=F+16*128; End;
   G:=VPM16(60547,Blk[Ip+2])+VPM16(25080,Blk[Ip+6]);
   H:=VPM16(25080,Blk[Ip+2])-VPM16(60547,Blk[Ip+6]);
   Ed:=E-G; Gd:=E+G; Add:=F+Ad; Bdd:=Bd-H; Fd:=F-Ad; Hd:=Bd+H;
   { colonne I : la sortie est ecrite en ligne (dst[k*stride]) pour la colonne
    dst++ }
   K:=I;
   If Typ=1 Then Begin
    Buf^[Dst+K+0*St]:=VPClip(VPSar(Gd+Cd,4)); Buf^[Dst+K+7*St]:=VPClip(VPSar(Gd-
     Cd,4));
    Buf^[Dst+K+1*St]:=VPClip(VPSar(Add+Hd,4)); Buf^[Dst+K+2*St]:=VPClip(VPSar(
     Add-Hd,4));
    Buf^[Dst+K+3*St]:=VPClip(VPSar(Ed+Dd,4)); Buf^[Dst+K+4*St]:=VPClip(VPSar(Ed-
     Dd,4));
    Buf^[Dst+K+5*St]:=VPClip(VPSar(Fd+Bdd,4)); Buf^[Dst+K+6*St]:=VPClip(VPSar(
     Fd-Bdd,4));
   End Else Begin
    Buf^[Dst+K+0*St]:=VPClip(Buf^[Dst+K+0*St]+VPSar(Gd+Cd,4)); Buf^[Dst+K+7*
     St]:=VPClip(Buf^[Dst+K+7*St]+VPSar(Gd-Cd,4));
    Buf^[Dst+K+1*St]:=VPClip(Buf^[Dst+K+1*St]+VPSar(Add+Hd,4)); Buf^[Dst+K+2*
     St]:=VPClip(Buf^[Dst+K+2*St]+VPSar(Add-Hd,4));
    Buf^[Dst+K+3*St]:=VPClip(Buf^[Dst+K+3*St]+VPSar(Ed+Dd,4)); Buf^[Dst+K+4*
     St]:=VPClip(Buf^[Dst+K+4*St]+VPSar(Ed-Dd,4));
    Buf^[Dst+K+5*St]:=VPClip(Buf^[Dst+K+5*St]+VPSar(Fd+Bdd,4)); Buf^[Dst+K+6*
     St]:=VPClip(Buf^[Dst+K+6*St]+VPSar(Fd-Bdd,4));
   End;
  End Else Begin
   If Typ=1 Then Begin
    V:=VPClip(128+VPSar(46341*Blk[Ip]+(8 Shl 16),20));
    For K:=0 To 7 Do Buf^[Dst+I+K*St]:=V;
   End Else If Blk[Ip]<>0 Then Begin
    V:=VPSar(46341*Blk[Ip]+(8 Shl 16),20);
    For K:=0 To 7 Do Buf^[Dst+I+K*St]:=VPClip(Buf^[Dst+I+K*St]+V);
   End;
  End;
 End;
 FillChar(Blk,SizeOf(Blk),0);
End;

Procedure VPIdct10(Var Blk: TVPCoef; Buf: PEABuffer; Dst,St,Typ: LongInt);
Var
 I,K,A,B,C,D,Ad,Bd,Cd,Dd,E,F,G,H,Ed,Gd,Add,Bdd,Fd,Hd,Ip: LongInt;
Begin
 For I:=0 To 3 Do Begin
  If (Blk[I] Or Blk[8+I] Or Blk[16+I] Or Blk[24+I])<>0 Then Begin
   A:=VPM16(64277,Blk[8+I]); B:=VPM16(12785,Blk[8+I]);
   C:=VPM16(54491,Blk[24+I]); D:=-VPM16(36410,Blk[24+I]);
   Ad:=VPM16(46341,A-C); Bd:=VPM16(46341,B-D);
   Cd:=A+C; Dd:=B+D;
   E:=VPM16(46341,Blk[I]); F:=E;
   G:=VPM16(60547,Blk[16+I]); H:=VPM16(25080,Blk[16+I]);
   Ed:=E-G; Gd:=E+G; Add:=F+Ad; Bdd:=Bd-H; Fd:=F-Ad; Hd:=Bd+H;
   Blk[I]:=Gd+Cd; Blk[56+I]:=Gd-Cd;
   Blk[8+I]:=Add+Hd; Blk[16+I]:=Add-Hd;
   Blk[24+I]:=Ed+Dd; Blk[32+I]:=Ed-Dd;
   Blk[40+I]:=Fd+Bdd; Blk[48+I]:=Fd-Bdd;
  End;
 End;
 For I:=0 To 7 Do Begin
  Ip:=I*8;
  If (Blk[Ip] Or Blk[Ip+1] Or Blk[Ip+2] Or Blk[Ip+3])<>0 Then Begin
   A:=VPM16(64277,Blk[Ip+1]); B:=VPM16(12785,Blk[Ip+1]);
   C:=VPM16(54491,Blk[Ip+3]); D:=-VPM16(36410,Blk[Ip+3]);
   Ad:=VPM16(46341,A-C); Bd:=VPM16(46341,B-D);
   Cd:=A+C; Dd:=B+D;
   E:=VPM16(46341,Blk[Ip]);
   If Typ=1 Then E:=E+16*128;
   F:=E;
   G:=VPM16(60547,Blk[Ip+2]); H:=VPM16(25080,Blk[Ip+2]);
   Ed:=E-G; Gd:=E+G; Add:=F+Ad; Bdd:=Bd-H; Fd:=F-Ad; Hd:=Bd+H;
   Gd:=Gd+8; Add:=Add+8; Ed:=Ed+8; Fd:=Fd+8;
   K:=I;
   If Typ=1 Then Begin
    Buf^[Dst+K+0*St]:=VPClip(VPSar(Gd+Cd,4)); Buf^[Dst+K+7*St]:=VPClip(VPSar(Gd-
     Cd,4));
    Buf^[Dst+K+1*St]:=VPClip(VPSar(Add+Hd,4)); Buf^[Dst+K+2*St]:=VPClip(VPSar(
     Add-Hd,4));
    Buf^[Dst+K+3*St]:=VPClip(VPSar(Ed+Dd,4)); Buf^[Dst+K+4*St]:=VPClip(VPSar(Ed-
     Dd,4));
    Buf^[Dst+K+5*St]:=VPClip(VPSar(Fd+Bdd,4)); Buf^[Dst+K+6*St]:=VPClip(VPSar(
     Fd-Bdd,4));
   End Else Begin
    Buf^[Dst+K+0*St]:=VPClip(Buf^[Dst+K+0*St]+VPSar(Gd+Cd,4)); Buf^[Dst+K+7*
     St]:=VPClip(Buf^[Dst+K+7*St]+VPSar(Gd-Cd,4));
    Buf^[Dst+K+1*St]:=VPClip(Buf^[Dst+K+1*St]+VPSar(Add+Hd,4)); Buf^[Dst+K+2*
     St]:=VPClip(Buf^[Dst+K+2*St]+VPSar(Add-Hd,4));
    Buf^[Dst+K+3*St]:=VPClip(Buf^[Dst+K+3*St]+VPSar(Ed+Dd,4)); Buf^[Dst+K+4*
     St]:=VPClip(Buf^[Dst+K+4*St]+VPSar(Ed-Dd,4));
    Buf^[Dst+K+5*St]:=VPClip(Buf^[Dst+K+5*St]+VPSar(Fd+Bdd,4)); Buf^[Dst+K+6*
     St]:=VPClip(Buf^[Dst+K+6*St]+VPSar(Fd-Bdd,4));
   End;
  End Else If Typ=1 Then
   For K:=0 To 7 Do Buf^[Dst+I+K*St]:=128;
 End;
 FillChar(Blk,SizeOf(Blk),0);
End;

Procedure VPIdctDc(Var Blk: TVPCoef; Buf: PEABuffer; Dst,St: LongInt);
Var I,J,Dc: LongInt;
Begin
 Dc:=VPSar(Blk[0]+15,5);
 For I:=0 To 7 Do For J:=0 To 7 Do Buf^[Dst+I*St+J]:=VPClip(Buf^[Dst+I*St+J]+
  Dc);
 Blk[0]:=0;
End;

{ ---- contexte ---- }
Procedure VPFreeCtx(Var S: TVPCtx);
Var F,P: LongInt;
Begin
 For F:=0 To 2 Do Begin
  For P:=0 To 2 Do If S.Fr[F,P]<>Nil Then Begin FreeMem(S.Fr[F,P]); S.Fr[F,P]:=
   Nil; End;
  S.FrOk[F]:=False;
 End;
 If S.Above<>Nil Then Begin FreeMem(S.Above); S.Above:=Nil; End;
 If S.Mbs<>Nil Then Begin FreeMem(S.Mbs); S.Mbs:=Nil; End;
End;

Procedure VPInitCtx(Var S: TVPCtx; VP5,Alpha: Boolean);
Begin
 FillChar(S,SizeOf(S),0);
 S.IsVP5:=VP5; S.IsAlpha:=Alpha; S.Quant:=-1;
 If VP5 Then S.Deblock:=1 Else S.Deblock:=0;
End;

Procedure VPInitDequant(Var S: TVPCtx; Q: LongInt);
Var X,Value,Lim: LongInt;
Begin
 If S.Quant<>Q Then Begin
  Lim:=VPDFiltThr[Q];
  FillChar(S.Bound,SizeOf(S.Bound),0);
  For X:=0 To Lim-1 Do Begin S.Bound[127-X]:=-X; S.Bound[127+X]:=X; End;
  X:=Lim; Value:=Lim;
  While (X<128) And (Value<>0) Do Begin
   S.Bound[127+X]:=Value; S.Bound[127-X]:=-Value; Inc(X); Dec(Value);
  End;
  If Value<>0 Then S.Bound[127+128]:=Value;
 End;
 S.Quant:=Q;
 S.DeqDc:=VPDDcDeq[Q] Shl 2; S.DeqAc:=VPDAcDeq[Q] Shl 2;
End;

{ allocation des plans apres changement de taille (vp56_size_changed) ; faux si
 trop grand }
Function VPAlloc(Var S: TVPCtx): Boolean;
Var F,P,Sz: LongInt;
Begin
 VPFreeCtx(S);
 S.CW:=VPDCW; S.CH:=VPDCH;
 S.PWd[0]:=S.CW; S.PWd[1]:=S.CW Div 2; S.PWd[2]:=S.CW Div 2;
 S.PHt[0]:=S.CH; S.PHt[1]:=S.CH Div 2; S.PHt[2]:=S.CH Div 2;
 S.HaveUndamaged:=False;
 S.MbW:=(S.CW+15) Div 16; S.MbH:=(S.CH+15) Div 16;
 VPAlloc:=False;
 If (S.MbW>1000) Or (S.MbH>1000) Or (S.MbW*S.MbH>100000) Then Exit;
 For F:=0 To 2 Do For P:=0 To 2 Do Begin
  Sz:=S.PWd[P]*S.PHt[P];
  GetMem(S.Fr[F,P],Sz+64); FillChar(S.Fr[F,P]^,Sz+64,0);
 End;
 GetMem(S.Above,(4*S.MbW+6)*SizeOf(TVPRef)); FillChar(S.Above^,(4*S.MbW+6)*
  SizeOf(TVPRef),0);
 GetMem(S.Mbs,S.MbW*S.MbH*SizeOf(TVPMb)); FillChar(S.Mbs^,S.MbW*S.MbH*SizeOf(
  TVPMb),0);
 S.MbOk:=True;
 VPAlloc:=True;
End;

{ ---- en-tetes ---- }
Const VPSizeChange=1;

Function VPParseHeaderVP5(Var S: TVPCtx; Pos,Size: LongInt): LongInt;
Var Rows,Cols,RenderX,RenderY: LongInt;
Begin
 VPParseHeaderVP5:=-1;
 If Not VPRacInit(S.C,Pos,Size) Then Exit;
 S.Key:=VPGet(S.C,128)=0;
 VPGet(S.C,128);
 VPInitDequant(S,VPGets(S.C,6));
 If S.Key Then Begin
  VPGets(S.C,8);
  If VPGets(S.C,5)>5 Then Exit;
  VPGets(S.C,2);
  If VPGet(S.C,128)<>0 Then Exit;
  Rows:=VPGets(S.C,8); Cols:=VPGets(S.C,8);
  If (Rows=0) Or (Cols=0) Then Exit;
  RenderY:=VPGets(S.C,8); RenderX:=VPGets(S.C,8);
  If (RenderX=0) Or (RenderX>Cols) Or (RenderY=0) Or (RenderY>Rows) Then Exit;
  VPGets(S.C,2);
  If (Not S.MbOk) Or (16*Cols<>VPDCW) Or (16*Rows<>VPDCH) Then Begin
   VPDW:=16*Cols; VPDH:=16*Rows; VPDCW:=VPDW; VPDCH:=VPDH;
   VPParseHeaderVP5:=VPSizeChange; Exit;
  End;
 End Else If Not S.MbOk Then Exit;
 VPParseHeaderVP5:=0;
End;

Function VPParseHeaderVP6(Var S: TVPCtx; Pos,Size: LongInt): LongInt;
Var
 ParseFilter,CoeffOff,VrtShift,Sub,Rows,Cols,Res,Sep: LongInt; Buf,BSz: LongInt;
 Function B(I: LongInt): LongInt;
 Begin B:=VPM^[Buf+I]; End;
Begin
 ParseFilter:=0; CoeffOff:=0; VrtShift:=0; Res:=0;
 Buf:=Pos; BSz:=Size;
 Sep:=B(0) And 1;
 S.Key:=(B(0) And $80)=0;
 VPInitDequant(S,(B(0) Shr 1) And $3F);
 VPParseHeaderVP6:=-1;
 If S.Key Then Begin
  Sub:=B(1) Shr 3;
  If Sub>8 Then Exit;
  S.FilterHeader:=B(1) And 6;
  If (B(1) And 1)<>0 Then Exit;
  If (Sep<>0) Or (S.FilterHeader=0) Then Begin
   CoeffOff:=B(2)*256+B(3)-2; Inc(Buf,2); Dec(BSz,2);
  End;
  Rows:=B(2); Cols:=B(3);
  If (Rows=0) Or (Cols=0) Then Exit;
  If (Not S.MbOk) Or (16*Cols<>VPDCW) Or (16*Rows<>VPDCH) Then Begin
   If (VPDExtraN=0) And (((VPDW+15) And Not 15)=16*Cols) And (((VPDH+15) And Not
    15)=16*Rows) Then Begin
    VPDCW:=16*Cols; VPDCH:=16*Rows;
   End Else Begin
    VPDW:=16*Cols; VPDH:=16*Rows; VPDCW:=VPDW; VPDCH:=VPDH;
    If VPDExtraN=1 Then Begin
     VPDW:=VPDW-(VPDExtra0 Shr 4); VPDH:=VPDH-(VPDExtra0 And 15);
    End;
   End;
   Res:=VPSizeChange;
  End;
  If Not VPRacInit(S.C,Buf+6,BSz-6) Then Begin
   If Res=VPSizeChange Then Begin VPDW:=0; VPDH:=0; VPDCW:=0; VPDCH:=0; End;
   Exit;
  End;
  VPGets(S.C,2);
  ParseFilter:=S.FilterHeader;
  If Sub<8 Then VrtShift:=5;
  S.SubVersion:=Sub;
  S.GoldenFrame:=0;
 End Else Begin
  If (S.SubVersion=0) Or (VPDCW=0) Or (VPDCH=0) Then Exit;
  If (Sep<>0) Or (S.FilterHeader=0) Then Begin
   CoeffOff:=B(1)*256+B(2)-2; Inc(Buf,2); Dec(BSz,2);
  End;
  If Not VPRacInit(S.C,Buf+1,BSz-1) Then Exit;
  S.GoldenFrame:=VPGet(S.C,128);
  If S.FilterHeader<>0 Then Begin
   S.Deblock:=VPGet(S.C,128);
   If S.Deblock<>0 Then VPGet(S.C,128);
   If S.SubVersion>7 Then ParseFilter:=VPGet(S.C,128);
  End;
 End;
 If ParseFilter<>0 Then Begin
  If VPGet(S.C,128)<>0 Then Begin
   S.FilterMode:=2;
   S.SampleVar:=VPGets(S.C,5) Shl VrtShift;
   S.MaxVecLen:=2 Shl VPGets(S.C,3);
  End Else If VPGet(S.C,128)<>0 Then Begin S.FilterMode:=1; End Else Begin
   S.FilterMode:=0; End;
  If S.SubVersion>7 Then S.FilterSel:=VPGets(S.C,4) Else S.FilterSel:=16;
 End;
 S.UseHuff:=VPGet(S.C,128)<>0;
 S.Huffman:=False;

 If CoeffOff<>0 Then Begin
  Buf:=Buf+CoeffOff; BSz:=BSz-CoeffOff;
  If BSz<0 Then Begin
   If Res=VPSizeChange Then Begin VPDW:=0; VPDH:=0; VPDCW:=0; VPDCH:=0; End;
   Exit;
  End;
  If S.UseHuff Then Begin
   S.Huffman:=True; S.GBase:=Buf; S.GSize:=BSz*8; S.GPos:=0;
  End Else Begin
   If Not VPRacInit(S.CC,Buf,BSz) Then Begin
    If Res=VPSizeChange Then Begin VPDW:=0; VPDH:=0; VPDCW:=0; VPDCH:=0; End;
    Exit;
   End;
   S.CcIsCC:=True;
  End;
 End Else S.CcIsCC:=False;
 VPParseHeaderVP6:=Res;
End;

{ ---- modeles ---- }
Procedure VPMbTypeModels(Var S: TVPCtx);
Var Ctx,I,Typ,Idx,Delta,Sign: LongInt; P: Array[0..9] Of LongInt;
 P02,P34,P0234,P17,P56,P89,P5689,P156789: LongInt;
Begin
 For Ctx:=0 To 2 Do Begin
  If VPGet(S.C,174)<>0 Then Begin
   Idx:=VPGets(S.C,4);
   Move(VPDPreStats[Idx,Ctx],S.M.MbS[Ctx],20);
  End;
  If VPGet(S.C,254)<>0 Then Begin
   For Typ:=0 To 9 Do For I:=0 To 1 Do Begin
    If VPGet(S.C,205)<>0 Then Begin
     Sign:=VPGet(S.C,128);
     Delta:=VPTree(S.C,VPDPmbtmV,VPDPmbtmP,@VPDMbtmModel);
     If Delta=0 Then Begin Delta:=4*VPGets(S.C,7); End;
     S.M.MbS[Ctx,Typ,I]:=S.M.MbS[Ctx,Typ,I]+((Delta Xor (-Sign))+Sign);
    End;
   End;
  End;
 End;
 For Ctx:=0 To 2 Do Begin
  For Typ:=0 To 9 Do P[Typ]:=100*S.M.MbS[Ctx,Typ,1];
  For Typ:=0 To 9 Do Begin
   S.M.MbT[Ctx,Typ,0]:=255-(255*S.M.MbS[Ctx,Typ,0]) Div (1+S.M.MbS[Ctx,Typ,0]+
    S.M.MbS[Ctx,Typ,1]);
   P[Typ]:=0;
   P02:=P[0]+P[2]; P34:=P[3]+P[4]; P0234:=P02+P34; P17:=P[1]+P[7]; P56:=P[5]+P[
    6]; P89:=P[8]+P[9];
   P5689:=P56+P89; P156789:=P17+P5689;
   S.M.MbT[Ctx,Typ,1]:=1+255*P0234 Div (1+P0234+P156789);
   S.M.MbT[Ctx,Typ,2]:=1+255*P02 Div (1+P0234);
   S.M.MbT[Ctx,Typ,3]:=1+255*P17 Div (1+P156789);
   S.M.MbT[Ctx,Typ,4]:=1+255*P[0] Div (1+P02);
   S.M.MbT[Ctx,Typ,5]:=1+255*P[3] Div (1+P34);
   S.M.MbT[Ctx,Typ,6]:=1+255*P[1] Div (1+P17);
   S.M.MbT[Ctx,Typ,7]:=1+255*P56 Div (1+P5689);
   S.M.MbT[Ctx,Typ,8]:=1+255*P[5] Div (1+P56);
   S.M.MbT[Ctx,Typ,9]:=1+255*P[8] Div (1+P89);
   P[Typ]:=100*S.M.MbS[Ctx,Typ,1];
  End;
 End;
End;

Procedure VP6CoeffOrder(Var S: TVPCtx);
Var I,Pos,Idx,Mx,V: LongInt;
Begin
 S.M.IdxPos[0]:=0; Idx:=1;
 For I:=0 To 15 Do For Pos:=1 To 63 Do
  If S.M.Reorder[Pos]=I Then Begin S.M.IdxPos[Idx]:=Pos; Inc(Idx); End;
 For Idx:=0 To 63 Do Begin
  Mx:=0;
  For I:=0 To Idx Do Begin V:=S.M.IdxPos[I]; If V>Mx Then Mx:=V; End;
  If S.SubVersion>6 Then Inc(Mx);
  S.M.IdxSel[Idx]:=Mx;
 End;
End;

Procedure VP6DefaultModels(Var S: TVPCtx);
Begin
 S.M.VDct[0]:=$A2; S.M.VDct[1]:=$A4; S.M.VSig[0]:=$80; S.M.VSig[1]:=$80;
 Move(VPDDefStats,S.M.MbS,SizeOf(S.M.MbS));
 Move(VP6DefFdv,S.M.VFdv,SizeOf(S.M.VFdv));
 Move(VP6DefPdv,S.M.VPdv,SizeOf(S.M.VPdv));
 Move(VP6DefRunv,S.M.Runv,SizeOf(S.M.Runv));
 Move(VP6DefReorder,S.M.Reorder,SizeOf(S.M.Reorder));
 VP6CoeffOrder(S);
End;

Procedure VP5DefaultModels(Var S: TVPCtx);
Var I: LongInt;
Begin
 For I:=0 To 1 Do Begin
  S.M.VSig[I]:=$80; S.M.VDct[I]:=$80; S.M.VPdi[I,0]:=$55; S.M.VPdi[I,1]:=$80;
 End;
 Move(VPDDefStats,S.M.MbS,SizeOf(S.M.MbS));
 FillChar(S.M.VPdv,SizeOf(S.M.VPdv),$80);
End;

Procedure VP6VectorModels(Var S: TVPCtx);
Var Comp,Node: LongInt;
Begin
 For Comp:=0 To 1 Do Begin
  If VPGet(S.C,VP6SigDct[Comp,0])<>0 Then S.M.VDct[Comp]:=VPGetsNN(S.C);
  If VPGet(S.C,VP6SigDct[Comp,1])<>0 Then S.M.VSig[Comp]:=VPGetsNN(S.C);
 End;
 For Comp:=0 To 1 Do For Node:=0 To 6 Do
  If VPGet(S.C,VP6PdvPct[Comp,Node])<>0 Then S.M.VPdv[Comp,Node]:=VPGetsNN(S.C);
 For Comp:=0 To 1 Do For Node:=0 To 7 Do
  If VPGet(S.C,VP6FdvPct[Comp,Node])<>0 Then S.M.VFdv[Comp,Node]:=VPGetsNN(S.C);
End;

Procedure VP5VectorModels(Var S: TVPCtx);
Var Comp,Node: LongInt;
Begin
 For Comp:=0 To 1 Do Begin
  If VPGet(S.C,VP5Vmc[Comp,0])<>0 Then S.M.VDct[Comp]:=VPGetsNN(S.C);
  If VPGet(S.C,VP5Vmc[Comp,1])<>0 Then S.M.VSig[Comp]:=VPGetsNN(S.C);
  If VPGet(S.C,VP5Vmc[Comp,2])<>0 Then S.M.VPdi[Comp,0]:=VPGetsNN(S.C);
  If VPGet(S.C,VP5Vmc[Comp,3])<>0 Then S.M.VPdi[Comp,1]:=VPGetsNN(S.C);
 End;
 For Comp:=0 To 1 Do For Node:=0 To 6 Do
  If VPGet(S.C,VP5Vmc[Comp,4+Node])<>0 Then S.M.VPdv[Comp,Node]:=VPGetsNN(S.C);
End;

Procedure VP6CoeffModels(Var S: TVPCtx);
Var DefProb: Array[0..10] Of Byte; Node,Cg,Ctx,Pos,Ct,Pt: LongInt; V: LongInt;
Begin
 FillChar(DefProb,SizeOf(DefProb),$80);
 For Pt:=0 To 1 Do For Node:=0 To 10 Do
  If VPGet(S.C,VP6DccvPct[Pt,Node])<>0 Then Begin
   DefProb[Node]:=VPGetsNN(S.C); S.M.Dccv[Pt,Node]:=DefProb[Node];
  End Else If S.Key Then S.M.Dccv[Pt,Node]:=DefProb[Node];
 If VPGet(S.C,128)<>0 Then Begin
  For Pos:=1 To 63 Do
   If VPGet(S.C,VP6ReorderPct[Pos])<>0 Then S.M.Reorder[Pos]:=VPGets(S.C,4);
  VP6CoeffOrder(S);
 End;
 For Cg:=0 To 1 Do For Node:=0 To 13 Do
  If VPGet(S.C,VP6RunvPct[Cg,Node])<>0 Then S.M.Runv[Cg,Node]:=VPGetsNN(S.C);
 For Ct:=0 To 2 Do For Pt:=0 To 1 Do For Cg:=0 To 5 Do For Node:=0 To 10 Do
  If VPGet(S.C,VP6RactPct[Ct,Pt,Cg,Node])<>0 Then Begin
   DefProb[Node]:=VPGetsNN(S.C); S.M.Ract[Pt,Ct,Cg,Node]:=DefProb[Node];
  End Else If S.Key Then S.M.Ract[Pt,Ct,Cg,Node]:=DefProb[Node];
 If S.UseHuff Then Begin
  For Pt:=0 To 1 Do Begin
   VPBuildHuff(S.DccvV[Pt],PVPB(@S.M.Dccv[Pt,0]),False,12);
   VPBuildHuff(S.RunvV[Pt],PVPB(@S.M.Runv[Pt,0]),True,9);
   For Ct:=0 To 2 Do For Cg:=0 To 5 Do
    VPBuildHuff(S.RactV[Pt,Ct,Cg],PVPB(@S.M.Ract[Pt,Ct,Cg,0]),False,12);
  End;
  FillChar(S.NbNull,SizeOf(S.NbNull),0);
 End Else Begin
  For Pt:=0 To 1 Do For Ctx:=0 To 2 Do For Node:=0 To 4 Do Begin
   V:=VPSar(S.M.Dccv[Pt,Node]*VP6DccvLc[Ctx,Node,0]+128,8)+VP6DccvLc[Ctx,Node,
    1];
   If V<1 Then V:=1 Else If V>255 Then V:=255;
   S.M.Dcct[Pt,Ctx,Node]:=V;
  End;
 End;
End;

Procedure VP5CoeffModels(Var S: TVPCtx);
Var DefProb: Array[0..10] Of Byte; Node,Cg,Ctx,Ct,Pt,V: LongInt;
Begin
 FillChar(DefProb,SizeOf(DefProb),$80);
 For Pt:=0 To 1 Do For Node:=0 To 10 Do
  If VPGet(S.C,VP5Dccv[Pt,Node])<>0 Then Begin
   DefProb[Node]:=VPGetsNN(S.C); S.M.Dccv[Pt,Node]:=DefProb[Node];
  End Else If S.Key Then S.M.Dccv[Pt,Node]:=DefProb[Node];
 For Ct:=0 To 2 Do For Pt:=0 To 1 Do For Cg:=0 To 5 Do For Node:=0 To 10 Do
  If VPGet(S.C,VP5Ract[Ct,Pt,Cg,Node])<>0 Then Begin
   DefProb[Node]:=VPGetsNN(S.C); S.M.Ract[Pt,Ct,Cg,Node]:=DefProb[Node];
  End Else If S.Key Then S.M.Ract[Pt,Ct,Cg,Node]:=DefProb[Node];
 For Pt:=0 To 1 Do For Ctx:=0 To 35 Do For Node:=0 To 4 Do Begin
  V:=VPSar(S.M.Dccv[Pt,Node]*VP5DccvLc[Node,Ctx,0]+128,8)+VP5DccvLc[Node,Ctx,1];
  If V<1 Then V:=1 Else If V>254 Then V:=254;
  S.M.Dcct[Pt,Ctx,Node]:=V;
 End;
 For Ct:=0 To 2 Do For Pt:=0 To 1 Do For Cg:=0 To 2 Do For Ctx:=0 To 5 Do For
  Node:=0 To 4 Do Begin
  V:=VPSar(S.M.Ract[Pt,Ct,Cg,Node]*VP5RactLc[Ct,Cg,Node,Ctx,0]+128,8)+VP5RactLc[
   Ct,Cg,Node,Ctx,1];
  If V<1 Then V:=1 Else If V>254 Then V:=254;
  S.M.Acct[Pt,Ct,Cg,Ctx,Node]:=V;
 End;
End;

{ ---- coefficients ---- }
Function VP6NbNull(Var S: TVPCtx): LongInt;
Var Val: LongInt;
Begin
 Val:=VPGB(S,2);
 If Val=2 Then Val:=Val+VPGB(S,2)
 Else If Val=3 Then Begin
  Val:=VPGB(S,1) Shl 2;
  Val:=6+Val+VPGB(S,2+Val);
 End;
 VP6NbNull:=Val;
End;

Function VP6ParseCoeffHuff(Var S: TVPCtx): LongInt;
Var
 B,Pt,Ct,CoeffIdx,Run,Coeff,Coeff2,Sign,Idx,Cg,Pt2: LongInt; Vlc: Integer; VCt,
  VCg: LongInt; UseDccv,Done: Boolean;
Begin
 VP6ParseCoeffHuff:=0;
 Pt:=0;
 For B:=0 To 5 Do Begin
  Ct:=0;
  If B>3 Then Pt:=1;
  UseDccv:=True; VCt:=0; VCg:=0;
  CoeffIdx:=0;
  Done:=False;
  While Not Done Do Begin
   Run:=1;
   If (CoeffIdx<2) And (S.NbNull[CoeffIdx,Pt]<>0) Then Begin
    Dec(S.NbNull[CoeffIdx,Pt]);
    If CoeffIdx<>0 Then Break;
   End Else Begin
    If S.GSize-S.GPos<=0 Then Begin VP6ParseCoeffHuff:=-1; Exit; End;
    If UseDccv Then Coeff:=VPVlc(S,S.DccvV[Pt]) Else Coeff:=VPVlc(S,S.RactV[Pt,
     VCt,VCg]);
    If Coeff=0 Then Begin
     If CoeffIdx<>0 Then Begin
      Pt2:=Ord(CoeffIdx>=6);
      Run:=Run+VPVlc(S,S.RunvV[Pt2]);
      If Run>=9 Then Begin Run:=Run+VPGB(S,6); End;
     End Else S.NbNull[0,Pt]:=VP6NbNull(S);
     Ct:=0;
    End Else If Coeff=11 Then Begin
     If CoeffIdx=1 Then Begin S.NbNull[1,Pt]:=VP6NbNull(S); End;
     Break;
    End Else Begin
     Coeff2:=VPDBias[Coeff];
     If Coeff>4 Then Begin
      If Coeff<=9 Then Coeff2:=Coeff2+VPGB(S,Coeff-4) Else Coeff2:=Coeff2+VPGB(
       S,11);
     End;
     Ct:=1+Ord(Coeff2>1);
     Sign:=VPGB(S,1);
     If Sign<>0 Then Coeff2:=-Coeff2;
     If CoeffIdx<>0 Then Coeff2:=Coeff2*S.DeqAc;
     Idx:=S.M.IdxPos[CoeffIdx];
     S.BC[B][VPScan[Idx]]:=Coeff2;
    End;
   End;
   CoeffIdx:=CoeffIdx+Run;
   If CoeffIdx>=64 Then Break;
   Cg:=VP6Groups[CoeffIdx]; If Cg>3 Then Cg:=3;
   UseDccv:=False; VCt:=Ct; VCg:=Cg;
  End;
  If CoeffIdx>63 Then S.Sel[B]:=S.M.IdxSel[63] Else S.Sel[B]:=S.M.IdxSel[
   CoeffIdx];
 End;
End;

Function VP6ParseCoeff(Var S: TVPCtx): LongInt;
Var
 B,I,Pt,Ct,Run,CoeffIdx,Coeff,Sign,Idx,Cg,Ctx: LongInt; M1,M2,M3: PVPB;
 R: ^TVPRng; Done: Boolean;
Begin
 VP6ParseCoeff:=0;
 If S.CcIsCC Then R:=@S.CC Else R:=@S.C;
 If VPIsEnd(R^) Then Begin VP6ParseCoeff:=-1; Exit; End;
 Pt:=0;
 For B:=0 To 5 Do Begin
  Ct:=1; Run:=1;
  If B>3 Then Pt:=1;
  Ctx:=S.Left[VPDB6to4[B]].NotNull+S.Above^[S.AIdx[B]].NotNull;
  M1:=PVPB(@S.M.Dccv[Pt,0]); M2:=PVPB(@S.M.Dcct[Pt,Ctx,0]);
  CoeffIdx:=0;
  While True Do Begin
   If ((CoeffIdx>1) And (Ct=0)) Or (VPGet(R^,M2^[0])<>0) Then Begin
    If VPGet(R^,M2^[2])<>0 Then Begin
     If VPGet(R^,M2^[3])<>0 Then Begin
      Idx:=VPTree(R^,VPDPcV,VPDPcP,M1);
      Coeff:=VPDBias[Idx+5];
      For I:=VPDBitLen[Idx] Downto 0 Do Coeff:=Coeff+(VPGet(R^,VPDCoeffParse[
       Idx,I]) Shl I);
     End Else Begin
      If VPGet(R^,M2^[4])<>0 Then Coeff:=3+VPGet(R^,M1^[5]) Else Coeff:=2;
     End;
     Ct:=2;
    End Else Begin Ct:=1; Coeff:=1; End;
    Sign:=VPGet(R^,128);
    If Sign<>0 Then Coeff:=-Coeff;
    If CoeffIdx<>0 Then Coeff:=Coeff*S.DeqAc;
    Idx:=S.M.IdxPos[CoeffIdx];
    S.BC[B][VPScan[Idx]]:=Coeff;
    Run:=1;
   End Else Begin
    Ct:=0;
    If CoeffIdx>0 Then Begin
     If VPGet(R^,M2^[1])=0 Then Break;
     M3:=PVPB(@S.M.Runv[Ord(CoeffIdx>=6),0]);
     Run:=VPTree(R^,VPDPcrV,VPDPcrP,M3);
     If Run=0 Then Begin
      Run:=9;
      For I:=0 To 5 Do Run:=Run+(VPGet(R^,M3^[I+8]) Shl I);
     End;
    End;
   End;
   CoeffIdx:=CoeffIdx+Run;
   If CoeffIdx>=64 Then Break;
   Cg:=VP6Groups[CoeffIdx];
   M1:=PVPB(@S.M.Ract[Pt,Ct,Cg,0]); M2:=M1;
  End;
  If S.BC[B][0]<>0 Then I:=1 Else I:=0;
  S.Left[VPDB6to4[B]].NotNull:=I;
  S.Above^[S.AIdx[B]].NotNull:=I;
  If CoeffIdx>63 Then S.Sel[B]:=S.M.IdxSel[63] Else S.Sel[B]:=S.M.IdxSel[
   CoeffIdx];
 End;
End;

Function VP5ParseCoeff(Var S: TVPCtx): LongInt;
Var
 B,I,Pt,Ct,CoeffIdx,Coeff,Sign,Idx,Cg,Ctx,CtxLast,L4: LongInt; M1,M2: PVPB;
Begin
 VP5ParseCoeff:=0;
 If VPIsEnd(S.C) Then Begin VP5ParseCoeff:=-1; Exit; End;
 Pt:=0;
 For B:=0 To 5 Do Begin
  Ct:=1;
  If B>3 Then Pt:=1;
  L4:=VPDB6to4[B];
  Ctx:=6*S.CoeffCtx[L4,0]+S.Above^[S.AIdx[B]].NotNull;
  M1:=PVPB(@S.M.Dccv[Pt,0]); M2:=PVPB(@S.M.Dcct[Pt,Ctx,0]);
  CoeffIdx:=0;
  While True Do Begin
   If VPGet(S.C,M2^[0])<>0 Then Begin
    If VPGet(S.C,M2^[2])<>0 Then Begin
     If VPGet(S.C,M2^[3])<>0 Then Begin
      S.CoeffCtx[L4,CoeffIdx]:=4;
      Idx:=VPTree(S.C,VPDPcV,VPDPcP,M1);
      Sign:=VPGet(S.C,128);
      Coeff:=VPDBias[Idx+5];
      For I:=VPDBitLen[Idx] Downto 0 Do Coeff:=Coeff+(VPGet(S.C,VPDCoeffParse[
       Idx,I]) Shl I);
     End Else Begin
      If VPGet(S.C,M2^[4])<>0 Then Begin
       Coeff:=3+VPGet(S.C,M1^[5]); S.CoeffCtx[L4,CoeffIdx]:=3;
      End Else Begin
       Coeff:=2; S.CoeffCtx[L4,CoeffIdx]:=2;
      End;
      Sign:=VPGet(S.C,128);
     End;
     Ct:=2;
    End Else Begin
     Ct:=1; S.CoeffCtx[L4,CoeffIdx]:=1; Sign:=VPGet(S.C,128); Coeff:=1;
    End;
    If Sign<>0 Then Coeff:=-Coeff;
    If CoeffIdx<>0 Then Coeff:=Coeff*S.DeqAc;
    S.BC[B][VPScan[CoeffIdx]]:=Coeff;
   End Else Begin
    If (Ct<>0) And (VPGet(S.C,M2^[1])=0) Then Break;
    Ct:=0;
    S.CoeffCtx[L4,CoeffIdx]:=0;
   End;
   Inc(CoeffIdx);
   If CoeffIdx>=64 Then Break;
   Cg:=VP5Groups[CoeffIdx];
   Ctx:=S.CoeffCtx[L4,CoeffIdx];
   M1:=PVPB(@S.M.Ract[Pt,Ct,Cg,0]);
   If Cg>2 Then M2:=M1 Else M2:=PVPB(@S.M.Acct[Pt,Ct,Cg,Ctx,0]);
  End;
  CtxLast:=S.CoeffCtxLast[L4]; If CtxLast>24 Then CtxLast:=24;
  S.CoeffCtxLast[L4]:=CoeffIdx;
  If CoeffIdx<CtxLast Then
   For I:=CoeffIdx To CtxLast Do S.CoeffCtx[L4,I]:=5;
  S.Above^[S.AIdx[B]].NotNull:=S.CoeffCtx[L4,0];
  S.Sel[B]:=63;
 End;
End;

{ ---- vecteurs ---- }
Procedure VP6VectAdj(Var S: TVPCtx; Var V: TVPMv);
Var Comp,I,J,Delta: LongInt;
Begin
 V.X:=0; V.Y:=0;
 If S.VCandPos<2 Then V:=S.VCand[0];
 For Comp:=0 To 1 Do Begin
  Delta:=0;
  If VPGet(S.C,S.M.VDct[Comp])<>0 Then Begin
   For I:=0 To 6 Do Begin
    J:=VPDPoOrder[I];
    Delta:=Delta Or (VPGet(S.C,S.M.VFdv[Comp,J]) Shl J);
   End;
   If (Delta And $F0)<>0 Then Delta:=Delta Or (VPGet(S.C,S.M.VFdv[Comp,3]) Shl
    3)
   Else Delta:=Delta Or 8;

  End Else Begin Delta:=VPTree(S.C,VPDPvaV,VPDPvaP,PVPB(@S.M.VPdv[Comp,0]));
   End;
  If (Delta<>0) And (VPGet(S.C,S.M.VSig[Comp])<>0) Then Delta:=-Delta;
  If Comp=0 Then V.X:=V.X+Delta Else V.Y:=V.Y+Delta;
 End;
End;

Procedure VP5VectAdj(Var S: TVPCtx; Var V: TVPMv);
Var Comp,Delta,Di,Sign: LongInt;
Begin
 For Comp:=0 To 1 Do Begin
  Delta:=0;
  If VPGet(S.C,S.M.VDct[Comp])<>0 Then Begin
   Sign:=VPGet(S.C,S.M.VSig[Comp]);
   Di:=VPGet(S.C,S.M.VPdi[Comp,0]);
   Di:=Di Or (VPGet(S.C,S.M.VPdi[Comp,1]) Shl 1);
   Delta:=VPTree(S.C,VPDPvaV,VPDPvaP,PVPB(@S.M.VPdv[Comp,0]));
   Delta:=Di Or (Delta Shl 2);
   If Sign<>0 Then Delta:=-Delta;
  End;
  If Comp=0 Then V.X:=Delta Else V.Y:=Delta;
 End;
End;

Procedure VPVectAdj(Var S: TVPCtx; Var V: TVPMv);
Begin
 If S.IsVP5 Then VP5VectAdj(S,V) Else VP6VectAdj(S,V);
End;

Function VPVectPred(Var S: TVPCtx; Row,Col,RefFrame: LongInt): LongInt;
Var NbPred,Pos,Offset,MX,MY: LongInt; V0,V1: TVPMv;
Begin
 NbPred:=0; V0.X:=0; V0.Y:=0; V1.X:=0; V1.Y:=0;
 For Pos:=0 To 11 Do Begin
  MX:=Col+VPDCand[Pos,0]; MY:=Row+VPDCand[Pos,1];
  If (MX<0) Or (MX>=S.MbW) Or (MY<0) Or (MY>=S.MbH) Then Continue;
  Offset:=MX+S.MbW*MY;
  If VPDRef[S.Mbs^[Offset].T]<>RefFrame Then Continue;
  If ((S.Mbs^[Offset].Mv.X=V0.X) And (S.Mbs^[Offset].Mv.Y=V0.Y)) Or ((S.Mbs^[
   Offset].Mv.X=0) And (S.Mbs^[Offset].Mv.Y=0)) Then Continue;
  If NbPred=0 Then V0:=S.Mbs^[Offset].Mv Else V1:=S.Mbs^[Offset].Mv;
  Inc(NbPred);
  If NbPred>1 Then Begin NbPred:=-1; Break; End;
  S.VCandPos:=Pos;
 End;
 S.VCand[0]:=V0; S.VCand[1]:=V1;
 VPVectPred:=NbPred+1;
End;

Function VPParseMbType(Var S: TVPCtx; Prev,Ctx: LongInt): LongInt;
Begin
 If VPGet(S.C,S.M.MbT[Ctx,Prev,0])<>0 Then VPParseMbType:=Prev
 Else VPParseMbType:=VPTree(S.C,VPDPmbtV,VPDPmbtP,PVPB(@S.M.MbT[Ctx,Prev,0]));
End;

Function VPRshift2(A: LongInt): LongInt;
Begin
 If A>0 Then VPRshift2:=VPSar(A+2,2) Else VPRshift2:=VPSar(A+1,2);
End;

Procedure VPDecode4Mv(Var S: TVPCtx; Row,Col: LongInt);
Var Mv: TVPMv; Typ: Array[0..3] Of LongInt; B: LongInt; SX,SY: LongInt;
Begin
 SX:=0; SY:=0;
 For B:=0 To 3 Do Begin
  Typ[B]:=VPGets(S.C,2);
  If Typ[B]<>0 Then Inc(Typ[B]);
 End;
 For B:=0 To 3 Do Begin
  Case Typ[B] Of
   0: Begin S.Mv[B].X:=0; S.Mv[B].Y:=0; End;
   2: VPVectAdj(S,S.Mv[B]);
   3: S.Mv[B]:=S.VCand[0];
   4: S.Mv[B]:=S.VCand[1];
  End;
  SX:=SmallInt(SX+S.Mv[B].X); SY:=SmallInt(SY+S.Mv[B].Y);
 End;
 S.Mbs^[Row*S.MbW+Col].Mv:=S.Mv[3];
 S.Mv[4].X:=VPRshift2(SX); S.Mv[5].X:=S.Mv[4].X;
 S.Mv[4].Y:=VPRshift2(SY); S.Mv[5].Y:=S.Mv[4].Y;
End;

Function VPDecodeMv(Var S: TVPCtx; Row,Col: LongInt): LongInt;
Var Ctx,B: LongInt; Vect,Mv: TVPMv;
Begin
 Vect.X:=0; Vect.Y:=0;
 Ctx:=VPVectPred(S,Row,Col,1);
 S.MbType:=VPParseMbType(S,S.MbType,Ctx);
 S.Mbs^[Row*S.MbW+Col].T:=S.MbType;
 Mv:=Vect;
 Case S.MbType Of
  3: Mv:=S.VCand[0];
  4: Mv:=S.VCand[1];
  8: Begin VPVectPred(S,Row,Col,2); Mv:=S.VCand[0]; End;
  9: Begin VPVectPred(S,Row,Col,2); Mv:=S.VCand[1]; End;
  2: Begin VPVectAdj(S,Vect); Mv:=Vect; End;
  6: Begin VPVectPred(S,Row,Col,2); VPVectAdj(S,Vect); Mv:=Vect; End;
  7: Begin VPDecode4Mv(S,Row,Col); VPDecodeMv:=S.MbType; Exit; End;
 End;
 S.Mbs^[Row*S.MbW+Col].Mv:=Mv;
 For B:=0 To 5 Do S.Mv[B]:=Mv;
 VPDecodeMv:=S.MbType;
End;

Function VPConcealMv(Var S: TVPCtx; Row,Col: LongInt): LongInt;
Var B: LongInt; Z: TVPMv;
Begin
 Z.X:=0; Z.Y:=0;
 S.MbType:=0;
 S.Mbs^[Row*S.MbW+Col].T:=0;
 S.Mbs^[Row*S.MbW+Col].Mv:=Z;
 For B:=0 To 5 Do S.Mv[B]:=Z;
 VPConcealMv:=0;
End;

Procedure VPAddPredDc(Var S: TVPCtx; RefFrame: LongInt);
Var Idx,B,Count,Dc,I,AI,L4,P: LongInt;
Begin
 Idx:=VPScan[0];
 For B:=0 To 5 Do Begin
  AI:=S.AIdx[B]; L4:=VPDB6to4[B];
  Count:=0; Dc:=0;
  If RefFrame=S.Left[L4].Ref Then Begin Dc:=Dc+S.Left[L4].Dc; Inc(Count); End;
  If RefFrame=S.Above^[AI].Ref Then Begin Dc:=Dc+S.Above^[AI].Dc; Inc(Count);
   End;
  If S.IsVP5 Then
   For I:=0 To 1 Do
    If (Count<2) And (RefFrame=S.Above^[AI-1+2*I].Ref) Then Begin Dc:=Dc+
     S.Above^[AI-1+2*I].Dc; Inc(Count); End;
  P:=VPDB2P[B];
  If Count=0 Then Begin Dc:=S.PrevDc[P,RefFrame]; End
  Else If Count=2 Then Begin Dc:=Dc Div 2; End;
  S.BC[B][Idx]:=S.BC[B][Idx]+Dc;
  S.PrevDc[P,RefFrame]:=S.BC[B][Idx];
  S.Above^[AI].Dc:=S.BC[B][Idx]; S.Above^[AI].Ref:=RefFrame;
  S.Left[L4].Dc:=S.BC[B][Idx]; S.Left[L4].Ref:=RefFrame;
  S.BC[B][Idx]:=S.BC[B][Idx]*S.DeqDc;
 End;
End;

{ ---- compensation de mouvement ---- }
Type TVPWin=Array[0..255] Of Byte;

Procedure VPDeblock(Var S: TVPCtx; Var W: TVPWin; Dx,Dy: LongInt);
Var Thr: LongInt;
Procedure Filt(Base,PixI,LineI: LongInt);
Var K,At,V,S1: LongInt;
Begin
 For K:=0 To 11 Do Begin
  At:=Base+K*LineI;
  If S.IsVP5 Then Begin
   V:=VPSar(W[At-2*PixI]+3*(W[At]-W[At-PixI])-W[At+PixI]+4,3);
   If V<0 Then S1:=-1 Else S1:=0;
   If S1<>0 Then V:=-V;
   If V>=2*Thr Then V:=0;
   V:=V-Thr;
   If V<0 Then V:=-V;
   V:=Thr-V;
   If S1<>0 Then V:=-V;
  End Else Begin
   V:=(W[At-2*PixI]-W[At+PixI])+(W[At]-W[At-PixI])*3;
   V:=S.Bound[127+VPSar(V+4,3)];
  End;
  W[At-PixI]:=VPClip(W[At-PixI]+V);
  W[At]:=VPClip(W[At]-V);
 End;
End;
Begin
 Thr:=VPDFiltThr[S.Quant];
 If Dx<>0 Then Begin Filt(10-Dx,1,16); End;
 If Dy<>0 Then Begin Filt(16*(10-Dy),16,1); End;
End;

{ bloc B du macroblock : prediction 8x8 ecrite dans le plan courant (PX,PY =
 position du bloc luma / MB) }
Procedure VPMc(Var S: TVPCtx; B,Pl,PX,PY: LongInt; Ref: PEABuffer);
Var
 W: TVPWin; Dst: PEABuffer; DX,DY,X,Y,I,J,Dv,Mask,MvX,MvY,PWw,PHh,DstX,DstY,DB:
  LongInt;
 Ovl,Off1,Off2,X8,Y8,Filter4,Sel,Sh: LongInt; Luma: Boolean;
 Tmp: Array[0..10,0..7] Of LongInt; Sm,Sq,V: LongInt;
Function WP(Off: LongInt): LongInt;
Begin If (Off<0) Or (Off>255) Then WP:=0 Else WP:=W[Off]; End;
Procedure Hv4(Base,Delta,Wt: LongInt);
Var XX,YY,Vv: LongInt;
Begin
 For YY:=0 To 7 Do For XX:=0 To 7 Do Begin
  Vv:=WP(Base+YY*16+XX-Delta)*VP6CopyFilt[Sel,Wt,0]+WP(Base+YY*16+XX)*
   VP6CopyFilt[Sel,Wt,1]
    +WP(Base+YY*16+XX+Delta)*VP6CopyFilt[Sel,Wt,2]+WP(Base+YY*16+XX+2*Delta)*
     VP6CopyFilt[Sel,Wt,3]+64;
  Dst^[DB+YY*PWw+XX]:=VPClip(VPSar(Vv,7));
 End;
End;
Begin
 PWw:=S.PWd[Pl]; PHh:=S.PHt[Pl];
 Dst:=S.Fr[0,Pl];
 If S.IsVP5 Then Dv:=2 Else Dv:=4;
 If B>=4 Then Dv:=Dv*2;
 Mask:=Dv-1;
 MvX:=S.Mv[B].X; MvY:=S.Mv[B].Y;
 DX:=MvX Div Dv; DY:=MvY Div Dv;
 If B>=4 Then Begin DstX:=PX Div 2; DstY:=PY Div 2; End Else Begin DstX:=PX;
  DstY:=PY; End;
 DB:=DstY*PWw+DstX;
 X:=DstX+DX-2; Y:=DstY+DY-2;
 If (X<0) Or (X+12>=PWw) Or (Y<0) Or (Y+12>=PHh) Then Begin
  For J:=0 To 11 Do For I:=0 To 11 Do Begin
   DX:=X+I; DY:=Y+J;
   If DX<0 Then DX:=0 Else If DX>=PWw Then DX:=PWw-1;
   If DY<0 Then DY:=0 Else If DY>=PHh Then DY:=PHh-1;
   W[J*16+I]:=Ref^[DY*PWw+DX];
  End;
  DX:=MvX Div Dv; DY:=MvY Div Dv;
 End Else
  For J:=0 To 11 Do For I:=0 To 11 Do W[J*16+I]:=Ref^[(Y+J)*PWw+X+I];
 If S.Deblock<>0 Then VPDeblock(S,W,DX And 7,DY And 7);
 Off1:=2+2*16;
 Ovl:=0;
 If (MvX And Mask)<>0 Then Begin If MvX>0 Then Inc(Ovl) Else Dec(Ovl); End;
 If (MvY And Mask)<>0 Then Begin If MvY>0 Then Inc(Ovl,16) Else Dec(Ovl,16);
  End;
 If Ovl<>0 Then Begin
  If S.IsVP5 Then Begin
   For J:=0 To 7 Do For I:=0 To 7 Do
    Dst^[DB+J*PWw+I]:=(W[Off1+J*16+I]+W[Off1+Ovl+J*16+I]) Shr 1;
  End Else Begin
   Luma:=B<4;
   Sel:=S.FilterSel;
   X8:=MvX And Mask; Y8:=MvY And Mask;
   Filter4:=0;
   If Luma Then Begin
    X8:=X8*2; Y8:=Y8*2;
    Filter4:=S.FilterMode;
    If Filter4=2 Then Begin
     If (S.MaxVecLen<>0) And ((VPAbs(MvX)>S.MaxVecLen) Or (VPAbs(
      MvY)>S.MaxVecLen)) Then Begin Filter4:=0; End
     Else If S.SampleVar<>0 Then Begin
      Sm:=0; Sq:=0;
      J:=0;
      While J<8 Do Begin
       I:=0;
       While I<8 Do Begin Sm:=Sm+W[Off1+J*16+I]; Sq:=Sq+W[Off1+J*16+I]*W[Off1+J*
        16+I]; Inc(I,2); End;
       Inc(J,2);
      End;
      If VPSar(16*Sq-Sm*Sm,8)<S.SampleVar Then Begin Filter4:=0; End;
     End;
    End;
   End;
   Off2:=Off1+Ovl;
   If Ovl<0 Then Off1:=Off2;
   If (MvX Xor MvY)<0 Then Sh:=-1 Else Sh:=0;
   If Filter4<>0 Then Begin
    If Y8=0 Then Begin Hv4(Off1,1,X8); End
    Else If X8=0 Then Begin Hv4(Off1,16,Y8); End
    Else Begin
     { vp6_filter_diag4 }
     For J:=0 To 10 Do For I:=0 To 7 Do
      Tmp[J,I]:=VPClip(VPSar(WP(Off1+Sh+(J-1)*16+I-1)*VP6CopyFilt[Sel,X8,0]+WP(
       Off1+Sh+(J-1)*16+I)*VP6CopyFilt[Sel,X8,1]
        +WP(Off1+Sh+(J-1)*16+I+1)*VP6CopyFilt[Sel,X8,2]+WP(Off1+Sh+(J-1)*16+I+
         2)*VP6CopyFilt[Sel,X8,3]+64,7));
     For J:=0 To 7 Do For I:=0 To 7 Do
      Dst^[DB+J*PWw+I]:=VPClip(VPSar(Tmp[J,I]*VP6CopyFilt[Sel,Y8,0]+Tmp[J+1,I]*
       VP6CopyFilt[Sel,Y8,1]
        +Tmp[J+2,I]*VP6CopyFilt[Sel,Y8,2]+Tmp[J+3,I]*VP6CopyFilt[Sel,Y8,3]+64,
         7));
    End;
   End Else Begin
    If (X8=0) Or (Y8=0) Then Begin
     For J:=0 To 7 Do For I:=0 To 7 Do
      Dst^[DB+J*PWw+I]:=((8-X8)*(8-Y8)*WP(Off1+J*16+I)+X8*(8-Y8)*WP(Off1+J*16+I+
       1)
        +(8-X8)*Y8*WP(Off1+(J+1)*16+I)+X8*Y8*WP(Off1+(J+1)*16+I+1)+32) Shr 6;
    End Else Begin
     { vp6_filter_diag2 }
     For J:=0 To 8 Do For I:=0 To 7 Do
      Tmp[J,I]:=(((8-X8)*8*WP(Off1+Sh+J*16+I)+X8*8*WP(Off1+Sh+J*16+I+1))+32) Shr
       6;
     For J:=0 To 7 Do For I:=0 To 7 Do
      Dst^[DB+J*PWw+I]:=((8*(8-Y8)*Tmp[J,I]+8*Y8*Tmp[J+1,I])+32) Shr 6;
    End;
   End;
  End;
 End Else
  Begin For J:=0 To 7 Do For I:=0 To 7 Do Dst^[DB+J*PWw+I]:=W[Off1+J*16+I]; End;
End;

Procedure VPIdctPut(Var S: TVPCtx; B: LongInt; Buf: PEABuffer; Dst,St: LongInt);
Begin
 If (S.Sel[B]>10) Or (S.Sel[B]=1) Then Begin VPIdct(S.BC[B],Buf,Dst,St,1); End
 Else Begin VPIdct10(S.BC[B],Buf,Dst,St,1); End;
End;

Procedure VPIdctAdd(Var S: TVPCtx; B: LongInt; Buf: PEABuffer; Dst,St: LongInt);
Begin
 If S.Sel[B]>10 Then Begin VPIdct(S.BC[B],Buf,Dst,St,2); End
 Else If S.Sel[B]>1 Then Begin VPIdct10(S.BC[B],Buf,Dst,St,2); End
 Else Begin VPIdctDc(S.BC[B],Buf,Dst,St); End;
End;

Procedure VPRenderMb(Var S: TVPCtx; Row,Col,MbType: LongInt);
Var RefFrame,B,Bmax,Pl,XO,YO,PX,PY,Dst,I,J,St: LongInt; Ref: PEABuffer;
Begin
 RefFrame:=VPDRef[MbType];
 VPAddPredDc(S,RefFrame);
 If (MbType<>1) And Not S.FrOk[RefFrame] Then Exit;
 If S.IsAlpha Then Bmax:=4 Else Bmax:=6;
 For B:=0 To Bmax-1 Do Begin
  If S.IsAlpha Then Pl:=0 Else Pl:=VPDB2P[B];
  If B<4 Then Begin
   XO:=(B And 1)*8; YO:=(B Shr 1)*8; PX:=16*Col+XO; PY:=16*Row+YO;
  End Else Begin PX:=8*Col; PY:=8*Row; XO:=0; YO:=0; End;
  St:=S.PWd[Pl];
  Dst:=PY*St+PX;
  Case MbType Of
   1: VPIdctPut(S,B,S.Fr[0,Pl],Dst,St);
   0,5: Begin
    Ref:=S.Fr[RefFrame,Pl];
    For J:=0 To 7 Do For I:=0 To 7 Do S.Fr[0,Pl]^[Dst+J*St+I]:=Ref^[Dst+J*St+I];
    VPIdctAdd(S,B,S.Fr[0,Pl],Dst,St);
   End;
   Else Begin
    If B<4 Then VPMc(S,B,Pl,PX,PY,S.Fr[RefFrame,Pl])
    Else VPMc(S,B,Pl,16*Col,16*Row,S.Fr[RefFrame,Pl]);
    VPIdctAdd(S,B,S.Fr[0,Pl],Dst,St);
   End;
  End;
 End;
 If S.IsAlpha Then Begin S.BC[4][0]:=0; S.BC[5][0]:=0; End;
End;

Function VPDecodeMb(Var S: TVPCtx; Row,Col: LongInt): LongInt;
Var T,Ret: LongInt;
Begin
 If S.Key Then T:=1 Else T:=VPDecodeMv(S,Row,Col);
 If S.IsVP5 Then Ret:=VP5ParseCoeff(S)
 Else If S.Huffman Then Ret:=VP6ParseCoeffHuff(S)
 Else Ret:=VP6ParseCoeff(S);
 If Ret<0 Then Begin VPDecodeMb:=Ret; Exit; End;
 VPRenderMb(S,Row,Col,T);
 VPDecodeMb:=0;
End;

Function VPDecodeMbs(Var S: TVPCtx): LongInt;
Var Blk,Row,Col,Y,Uv,P,Sz: LongInt; Damaged: Boolean; T: LongInt; Tmp:
 PEABuffer;
Begin
 VPDecodeMbs:=0;
 If S.Key Then Begin
  If S.IsVP5 Then VP5DefaultModels(S) Else VP6DefaultModels(S);
  For Blk:=0 To S.MbH*S.MbW-1 Do S.Mbs^[Blk].T:=1;
 End Else Begin
  VPMbTypeModels(S);
  If S.IsVP5 Then VP5VectorModels(S) Else VP6VectorModels(S);
  S.MbType:=0;
 End;
 If S.IsVP5 Then VP5CoeffModels(S) Else VP6CoeffModels(S);
 FillChar(S.PrevDc,SizeOf(S.PrevDc),0);
 S.PrevDc[1,0]:=128; S.PrevDc[2,0]:=128;
 For Blk:=0 To 4*S.MbW+5 Do Begin
  S.Above^[Blk].Ref:=-1; S.Above^[Blk].Dc:=0; S.Above^[Blk].NotNull:=0;
 End;
 S.Above^[2*S.MbW+2].Ref:=0;
 S.Above^[3*S.MbW+4].Ref:=0;
 Damaged:=False;
 For Row:=0 To S.MbH-1 Do Begin
  For Blk:=0 To 3 Do Begin S.Left[Blk].Ref:=-1; S.Left[Blk].Dc:=0; S.Left[
   Blk].NotNull:=0; End;
  FillChar(S.CoeffCtx,SizeOf(S.CoeffCtx),0);
  For Blk:=0 To 3 Do S.CoeffCtxLast[Blk]:=24;
  S.AIdx[0]:=1; S.AIdx[1]:=2; S.AIdx[2]:=1; S.AIdx[3]:=2;
  S.AIdx[4]:=2*S.MbW+2+1; S.AIdx[5]:=3*S.MbW+4+1;
  For Col:=0 To S.MbW-1 Do Begin
   If Not Damaged Then Begin
    If VPDecodeMb(S,Row,Col)<0 Then Begin
     Damaged:=True;
     If Not S.HaveUndamaged Then Begin S.Discard:=True; VPDecodeMbs:=-1; Exit;
      End;
    End;
   End;
   If Damaged Then Begin
    If S.Key Then T:=1 Else T:=VPConcealMv(S,Row,Col);
    VPRenderMb(S,Row,Col,T);
   End;
   For Y:=0 To 3 Do Inc(S.AIdx[Y],2);
   For Uv:=4 To 5 Do Inc(S.AIdx[Uv]);
  End;
 End;
 If Not Damaged Then S.HaveUndamaged:=True;
 If S.Key Or (S.GoldenFrame<>0) Then Begin

  For P:=0 To 2 Do Begin
   Sz:=S.PWd[P]*S.PHt[P];
   Move(S.Fr[0,P]^,S.Fr[2,P]^,Sz);
  End;
  S.FrOk[2]:=True;
 End;
 For P:=0 To 2 Do Begin Tmp:=S.Fr[0,P]; S.Fr[0,P]:=S.Fr[1,P]; S.Fr[1,P]:=Tmp;
  End;
 S.FrOk[1]:=True; S.FrOk[0]:=False;
End;

{ ---- trame complete ; Pos/Size = paquet dans VPM ; >=0 si une image est sortie
 ---- }
Function VPFrame(Pos,Size: LongInt; HasAlpha: Boolean): LongInt;
Var AlphaOff,P,Rem,Res,F,I,B0,B1,B2,B3: LongInt; SW,SH,SCW,SCH: LongInt;
Begin
 VPFrame:=-1;
 AlphaOff:=Size; P:=Pos; Rem:=Size;
 If HasAlpha Then Begin
  If Size<3 Then Exit;
  AlphaOff:=VPM^[Pos]*65536+VPM^[Pos+1]*256+VPM^[Pos+2];
  P:=Pos+3; Rem:=Size-3;
  If Rem<AlphaOff Then Exit;
  AlphaOff:=AlphaOff;
 End;
 If VPC[0].IsVP5 Then Res:=VPParseHeaderVP5(VPC[0],P,AlphaOff)
 Else Res:=VPParseHeaderVP6(VPC[0],P,AlphaOff);
 If Res<0 Then Exit;
 If Res=VPSizeChange Then Begin
  For F:=0 To 2 Do Begin VPC[0].FrOk[F]:=False; VPC[1].FrOk[F]:=False; End;
  VPC[0].Key:=True;
  If Not VPAlloc(VPC[0]) Then Begin VPDW:=0; VPDH:=0; VPDCW:=0; VPDCH:=0; Exit;
   End;
  If HasAlpha Then If Not VPAlloc(VPC[1]) Then Begin VPDW:=0; VPDH:=0; VPDCW:=0;
   VPDCH:=0; Exit; End;
 End;
 If HasAlpha Then Begin
  SW:=VPDW; SH:=VPDH; SCW:=VPDCW; SCH:=VPDCH;
  Res:=VPParseHeaderVP6(VPC[1],P+AlphaOff,Rem-AlphaOff);
  If Res<>0 Then Begin
   VPDW:=SW; VPDH:=SH; VPDCW:=SCW; VPDCH:=SCH;
   Exit;
  End;
 End;
 VPC[0].Discard:=False; VPC[1].Discard:=False;
 I:=VPDecodeMbs(VPC[0]);
 If HasAlpha Then VPDecodeMbs(VPC[1]);
 If VPC[0].Discard Then Exit;
 VPFrame:=Size;
End;

{ ---- initialisation d'un flux : Kind 5 vp5, 6 vp6, 7 vp6f, 8 vp6a ---- }
Procedure VPDInitStream(Kind: LongInt; W,H,ExtraN,Extra0: LongInt);
Var I,Z,Sh: LongInt;
Begin
 For I:=0 To 255 Do Begin
  If I=0 Then VPNorm[I]:=8
  Else Begin Sh:=0; Z:=I; While Z<128 Do Begin Z:=Z Shl 1; Inc(Sh); End; VPNorm[
   I]:=Sh; End;
 End;
 For I:=0 To 63 Do Begin Z:=VPDZigzag[I]; VPScan[I]:=(Z Shr 3) Or ((Z And 7) Shl
  3); End;
 VPFreeCtx(VPC[0]); VPFreeCtx(VPC[1]);
 VPInitCtx(VPC[0],Kind=5,False); VPInitCtx(VPC[1],False,True);
 VPDAlpha:=Kind=8;
 VPDInitFlip:=(Kind=5) Or (Kind=6);
 VPDW:=W; VPDH:=H; VPDCW:=0; VPDCH:=0; VPDExtraN:=ExtraN; VPDExtra0:=Extra0;
 VPMCap:=0; VPM:=Nil;
End;

Procedure VPDLoadPacket(Src: PEABuffer; Size: LongInt);
Begin
 If VPMCap<Size+128 Then Begin
  If VPM<>Nil Then FreeMem(VPM);
  VPMCap:=Size+65536; GetMem(VPM,VPMCap);
 End;
 If Size>0 Then Move(Src^,VPM^,Size);
 FillChar(VPM^[Size],64,0);
End;

{ image de sortie (planaire 4:2:0, rognee, retournee pour VP5/VP6) ; renvoie la
 taille }
Procedure VPDBuildOut(Out: PEABuffer);
Var W,H,CWo,CHo,R,Src,P,A: LongInt; Fl: Boolean;
Begin
 W:=VPDW; H:=VPDH; CWo:=(W+1) Div 2; CHo:=(H+1) Div 2; Fl:=VPDInitFlip;
 For R:=0 To H-1 Do Begin
  If Fl Then Src:=VPC[0].PHt[0]-1-R Else Src:=R;
  Move(VPC[0].Fr[1,0]^[Src*VPC[0].PWd[0]],Out^[R*W],W);
 End;
 For P:=1 To 2 Do
  For R:=0 To CHo-1 Do Begin
   If Fl Then Src:=VPC[0].PHt[1]-1-R Else Src:=R;
   Move(VPC[0].Fr[1,P]^[Src*VPC[0].PWd[1]],Out^[W*H+(P-1)*CWo*CHo+R*CWo],CWo);
  End;
 If VPDAlpha Then
  For R:=0 To H-1 Do Begin
   If Fl Then Src:=VPC[1].PHt[0]-1-R Else Src:=R;
   If VPC[1].Discard Then Move(VPC[1].Fr[0,0]^[Src*VPC[1].PWd[0]],Out^[W*H+2*
    CWo*CHo+R*W],W)
   Else Move(VPC[1].Fr[1,0]^[Src*VPC[1].PWd[0]],Out^[W*H+2*CWo*CHo+R*W],W);
  End;
End;

Procedure VPDNVBegin(Mode: LongInt; Const Target: String; RN,RD: LongInt);
Var W,H: LongInt;
Begin
 W:=VPDW; H:=VPDH;
 If VPDAlpha And (Mode=0) And (OutputFormat='yuv4mpegpipe') Then
  If OptPixFmt<>'yuv420p' Then Fail(
   'vp6a: yuv4mpeg ne gere pas yuva420p ; utiliser -pix_fmt yuv420p.');
 If VPDAlpha And (Mode<>0) Then NVBegin(Mode,Target,W,H,3,RN,RD)
 Else If Mode<>0 Then NVBegin(Mode,Target,W,H,9,RN,RD)
 Else NVBegin(Mode,Target,W,H,7,RN,RD);
 NVSubX:=1; NVSubY:=1; NVCW:=(W+1) Div 2; NVCH:=(H+1) Div 2;
 If VPDAlpha And (Mode=0) Then NVYTag:=
  'C420jpeg XYSCSS=420JPEG XCOLORRANGE=LIMITED'
 Else NVYTag:='C420jpeg XYSCSS=420JPEG';
 If VPDAlpha And (Mode<>0) Then NVHasAlpha:=True;
End;

{ swscale yuv420p -> rgb24 / yuva420p -> rgba sans mise a l'echelle (yuv2rgb.c),
 matrice ITU601 plage limitee ;
  Mode 1/2 : tampon RGB24 (R,G,B) ou, avec alpha, BGRA (octets B,G,R,A) }
Function VPDToRgb(Out: PEABuffer): PEABuffer;
Var
 YTab: Array[0..2047] Of Byte; Crv,Cbu,Cgu,Cgv,Cy,Oy,Yb: Int64; I,X,Y,CW,CHh,U,
  V,Yv,YOffs,W,H,Bp,P: LongInt;
 TabR,TabB,TabGU,TabGV: Array[0..255] Of LongInt; Q,Q2: PEABuffer; R,G,B:
  LongInt;
Function Cl(Z: Int64): LongInt; Begin If Z<0 Then Cl:=0 Else If Z>255 Then Cl:=
 255 Else Cl:=Z; End;
Function Sr(X: Int64; N: LongInt): Int64;
Begin If X>=0 Then Sr:=X Shr N Else Sr:=-((-X+(Int64(1) Shl N)-1) Shr N); End;
Begin
 W:=VPDW; H:=VPDH; CW:=(W+1) Div 2; CHh:=(H+1) Div 2;
 If VPDAlpha Then Bp:=4 Else Bp:=3;
 GetMem(Q,W*H*Bp+16); FillChar(Q^,W*H*Bp+16,0);
 Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279; Cy:=65536; Oy:=0;
 Cy:=(Cy*255) Div 219; Oy:=Int64(16) Shl 16;
 Crv:=((Crv*65536)+$8000) Div Cy; Cbu:=((Cbu*65536)+$8000) Div Cy;
 Cgu:=((Cgu*65536)+$8000) Div Cy; Cgv:=((Cgv*65536)+$8000) Div Cy;
 YOffs:=326+512;
 Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For I:=0 To 2047 Do Begin YTab[I]:=Cl(Sr(Yb+$8000,16)); Inc(Yb,Cy); End;
 For I:=0 To 255 Do Begin
  TabR[I]:=YOffs-LongInt(Sr(Crv,9))+LongInt(Sr(I*Crv,16));
  TabB[I]:=YOffs-LongInt(Sr(Cbu,9))+LongInt(Sr(I*Cbu,16));
  TabGU[I]:=YOffs-LongInt(Sr(Cgu,9))+LongInt(Sr(I*Cgu,16));
  TabGV[I]:=-LongInt(Sr(Cgv,9))+LongInt(Sr(I*Cgv,16));
 End;
 If Odd(W) Or Odd(H) Then Begin
  { dimensions impaires : chemin general de swscale (partage avec G1Yuv420ToRgb)
   }
  G1YW:=W; G1YH:=H; G1YCw:=CW; G1YCh:=CHh; G1YY:=Out; G1YU:=@Out^[W*H]; G1YV:=
   @Out^[W*H+CW*CHh];
  If VPDAlpha Then Begin
   GetMem(Q2,W*H*3+16); G1Yuv420ToRgb(Q2);
   For Y:=0 To H-1 Do
    For X:=0 To W-1 Do Begin
     P:=(Y*W+X)*4;
     Q^[P]:=Q2^[(Y*W+X)*3+2]; Q^[P+1]:=Q2^[(Y*W+X)*3+1]; Q^[P+2]:=Q2^[(Y*W+X)*
      3]; Q^[P+3]:=Out^[W*H+2*CW*CHh+Y*W+X];
    End;
   FreeMem(Q2);
  End Else G1Yuv420ToRgb(Q);
  VPDToRgb:=Q; Exit;
 End;
 For Y:=0 To H-1 Do
  For X:=0 To W-1 Do Begin
   Yv:=Out^[Y*W+X]; U:=Out^[W*H+(Y Shr 1)*CW+(X Shr 1)]; V:=Out^[W*H+CW*CHh+(Y
    Shr 1)*CW+(X Shr 1)];
   R:=YTab[TabR[V]+Yv]; G:=YTab[TabGU[U]+TabGV[V]+Yv]; B:=YTab[TabB[U]+Yv];
   P:=(Y*W+X)*Bp;
   If VPDAlpha Then Begin Q^[P]:=B; Q^[P+1]:=G; Q^[P+2]:=R; Q^[P+3]:=Out^[W*H+2*
    CW*CHh+Y*W+X]; End
   Else Begin Q^[P]:=R; Q^[P+1]:=G; Q^[P+2]:=B; End;
  End;
 VPDToRgb:=Q;
End;

Function VPDOutSize: LongInt;
Var W,H,R: LongInt;
Begin
 W:=VPDW; H:=VPDH;
 R:=W*H+2*((W+1) Div 2)*((H+1) Div 2);
 If VPDAlpha Then R:=R+W*H;
 VPDOutSize:=R;
End;

Function VPDAviKind(Const F: String): LongInt;
Var U: String; I: Integer;
Begin
 U:=F; For I:=1 To Length(U) Do U[I]:=UpCase(U[I]);
 VPDAviKind:=0;
 If U='VP50' Then VPDAviKind:=480
 Else If (U='VP60') Or (U='VP61') Or (U='VP62') Then VPDAviKind:=481
 Else If (U='VP6F') Or (U='FLV4') Then VPDAviKind:=482
 Else If U='VP6A' Then VPDAviKind:=483;
End;

{ ---- AVI : VP50/VP6x ---- }
Procedure VPDDecodeAvi(Const Source,Target: String; Mode,Kind: LongInt);
Var
 PIdx,Sz,SzOut: LongInt; Out,Bg: PEABuffer; Begun: Boolean; Ok: Boolean; FKind:
  LongInt;
Begin
 QXOpen(Source);
 FKind:=Kind-475; { 480 -> 5 ... 483 -> 8 }
 If (QXW<1) Or (QXH<1) Or (QXW>32767) Or (QXH>32767) Then Fail(
  'vp6: dimensions invalides.');
 If QXExtLen>=2 Then VPDInitStream(FKind,QXW,QXH,2,QXF^[QXExtPos])
 Else If QXExtLen=1 Then VPDInitStream(FKind,QXW,QXH,1,QXF^[QXExtPos])
 Else VPDInitStream(FKind,QXW,QXH,0,0);
 Begun:=False; Out:=Nil;
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx];
  If (QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  VPDLoadPacket(PEABuffer(@QXF^[QXPos^[PIdx]]),Sz);
  Ok:=False;
  If Sz>0 Then Ok:=VPFrame(0,Sz,VPDAlpha)>=0;
  If Ok Then Begin
   If Not Begun Then Begin
    VPDNVBegin(Mode,Target,QXRn,QXRd);
    NVAviSar(VPDW,VPDH);
    SzOut:=VPDOutSize; GetMem(Out,SzOut+64);
    Begun:=True;
   End;
   If VPDOutSize<>SzOut Then Fail(
    'vp6: changement de taille en cours de flux non pris en charge.');
   VPDBuildOut(Out);
   If Mode<>0 Then Begin Bg:=VPDToRgb(Out); NVEmit(Bg); FreeMem(Bg); End
   Else NVEmit(Out);
   If NVDone Then Break;
  End Else If Begun Then NVRepeat;
 End;
 QXClose;
 If Not Begun Then Fail('vp6: aucune image decodee.');
 NVFinish('vp6');
End;

{ ---- FLV : VP6 (4) / VP6 avec alpha (5) ---- }
Procedure VPDDecodeFlv(Const Source,Target: String; Mode: LongInt);
Var
 F: PEABuffer; Size,At,N,TS,I,K,Cnt,Kind,FKind: LongInt; Fps: Double; Bits:
  Int64;
 FOff,FSz: PGFArr; FTs: PTLArr; Dts,Dur: PTLArr; Ok,Begun: Boolean;
 RN,RD: LongInt; AvgN,AvgD,Start,AudioFirst: Int64; NbF,NbP: Int64; Cap:
  LongInt; Best: Double;
 Out,Bg: PEABuffer; SzOut,Adj,VCodec: LongInt;
Begin
 NVLoad(Source,F,Size);
 If (F^[0]<>70) Or (F^[1]<>76) Or (F^[2]<>86) Or (F^[3]<>1) Then Fail(
  'flv: entete invalide.');
 Cap:=Size Div 16+16;
 GetMem(FOff,Cap*4); GetMem(FSz,Cap*4); GetMem(FTs,Cap*8);
 At:=F^[5]*16777216+F^[6]*65536+F^[7]*256+F^[8]+4;
 Cnt:=0; Fps:=0; AudioFirst:=-1; Adj:=0; VCodec:=0;
 While At+15<=Size Do Begin
  Kind:=F^[At]; N:=F^[At+1]*65536+F^[At+2]*256+F^[At+3];
  TS:=F^[At+4]*65536+F^[At+5]*256+F^[At+6]+F^[At+7]*16777216;
  If At+11+N>Size Then Break;
  If Kind=9 Then Begin
   If (N>=1) And (VCodec=0) Then VCodec:=F^[At+11] And 15;
   If (N>=1) And ((F^[At+11] And 15)<>VCodec) Then Fail(
    'flv: changement de codec video non pris en charge.');
   If (N>=3) And (Cnt<Cap) And ((F^[At+11] Shr 4)<>5) Then Begin
    If Cnt=0 Then Adj:=F^[At+12];
    FOff^[Cnt]:=At+13; FSz^[Cnt]:=N-2; FTs^[Cnt]:=TS; Inc(Cnt);
   End;
  End Else If Kind=8 Then Begin
   If AudioFirst<0 Then AudioFirst:=TS;
  End Else If Kind=18 Then Begin
   For I:=At+11 To At+11+N-12 Do
    If (F^[I]=0) And (F^[I+1]=9) And (F^[I+2]=102) And (F^[I+3]=114) And (F^[I+
     4]=97) And (F^[I+5]=109) And (F^[I+6]=101) And (F^[I+7]=114) And (F^[I+
     8]=97) And (F^[I+9]=116) And (F^[I+10]=101) And (F^[I+11]=0) Then Begin
     If I+20<=At+11+N Then Begin
      Bits:=0; For K:=0 To 7 Do Bits:=Bits*256+F^[I+12+K];
      Move(Bits,Fps,8);
     End;
     Break;
    End;
  End;
  Inc(At,N+15);
 End;
 If Cnt=0 Then Fail('flv: aucune image video.');
 If VCodec=5 Then FKind:=8 Else FKind:=7;
 AvgN:=0; AvgD:=0;
 If (Fps>0) And (Fps<1000) Then Begin
  For K:=1 To 1001000 Do Begin
   Best:=Fps*K;
   If Abs(Best-Round(Best))<1e-7*K Then Begin AvgN:=Round(Best); AvgD:=K; Break;
    End;
  End;
 End;
 GetMem(Dts,Cnt*8); GetMem(Dur,Cnt*8);
 For I:=0 To Cnt-1 Do Begin Dts^[I]:=FTs^[I]; Dur^[I]:=0; End;
 TLRFrameRate(Dts,Dur,FSz,Cnt,1,1000,True,AvgN,AvgD,0,0,RN,RD);
 If (AvgN>0) And (AvgD>0) And (AvgN/AvgD<70) And (RN/RD>210) Then Begin RN:=
  AvgN; RD:=AvgD; End;
 Start:=FTs^[0]; If (AudioFirst>=0) And (AudioFirst<Start) Then Start:=
  AudioFirst;
 VPDInitStream(FKind,0,0,1,Adj);
 Begun:=False; NVVN:=0; NVVD:=0; Out:=Nil; SzOut:=0;
 CFTbN:=1; CFTbD:=1000; CFFn:=RN; CFFd:=RD; CFNext:=0; CFFrameNo:=0; CFHist[0]:=
  0; CFHist[1]:=0; CFHist[2]:=0; CFLastDropped:=False;
 For I:=0 To Cnt-1 Do Begin
  VPDLoadPacket(PEABuffer(@F^[FOff^[I]]),FSz^[I]);
  Ok:=VPFrame(0,FSz^[I],VPDAlpha)>=0;
  If Ok Then Begin
   If Not Begun Then Begin
    VPDNVBegin(Mode,Target,RN,RD);
    SzOut:=VPDOutSize; GetMem(Out,SzOut+64);
    Begun:=True;
   End;
   If VPDOutSize<>SzOut Then Fail(
    'vp6: changement de taille en cours de flux non pris en charge.');
   VPDBuildOut(Out);
   CFSync(FTs^[I]-Start,(Int64(1000)*RD) Div RN,NbF,NbP);
   If Mode<>0 Then Begin Bg:=VPDToRgb(Out); NVEmitN(Bg,NbP,NbF); FreeMem(Bg);
    End
   Else NVEmitN(Out,NbP,NbF);
   Inc(CFNext,NbF); Inc(CFFrameNo,NbF);
   If NVDone Then Break;
  End;
 End;
 If Begun Then Begin
  If Mode=0 Then CFFlush(Out);
 End;
 If NVLast<>Nil Then Begin FreeMem(NVLast,NVLastSize); NVLast:=Nil; End;
 If Not Begun Then Fail('flv: aucune image decodee.');
 CloseRead; If NVOpened Then CloseWrite;
End;

Procedure DecodeVPD(Const Source,Target: String; Mode,Kind: LongInt);
Begin
 If Kind=484 Then VPDDecodeFlv(Source,Target,Mode) Else VPDDecodeAvi(Source,
  Target,Mode,Kind);
End;
Function VPDAudioOut: Boolean;
Begin
 VPDAudioOut:=(OutputFormat='wav') Or (OutputFormat='roq') Or (
  OutputFormat='mp3') Or (OutputFormat='mp2') Or (OutputFormat='ac3') Or (
  OutputFormat='aac') Or (OutputFormat='adx') Or (OutputFormat='aiff');
End;
{ VPD-END }

{ ==== BLOCK-ANCHOR-G4B : inserer le code du groupe G4B juste au-dessus de cette
 ligne ==== }

Procedure G2ADrive(Fn: TG2AFn);
Var PIdx,Sz: LongInt; Pk: PEABuffer;
Begin
 G2CFBegin(AXScale,AXRate,QXRn,QXRd,True);
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx];
  If (QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0
  Else If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx];
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]);
  G2APk:=Pk; G2ASz:=Sz; G2ABp:=0;
  If (Sz>0) And Fn(Pk,Sz) Then G2CFOut(PIdx,1);
  If NVDone Then Break;
 End;
 G2CFEnd;
End;

Procedure G2AYUVBegin(Mode: LongInt; Const Target: String; W,H,SubX,SubY:
 LongInt; Const Tag: String);
Begin
 NVBegin(Mode,Target,W,H,7,QXRn,QXRd);
 NVSubX:=SubX; NVSubY:=SubY; NVCW:=(W+(1 Shl SubX)-1) Shr SubX; NVCH:=(H+(1 Shl
  SubY)-1) Shr SubY;
 NVYTag:=Tag; NVIl:='p'; NVAviSar(W,H);
 If ((OptPixFmt='yuv420p') And ((SubX<>1) Or (SubY<>1))) Or ((SubX=2) And (
  SubY=2)) Then Begin
  NVTo420:=True; NVYTag:='C420jpeg XYSCSS=420JPEG XCOLORRANGE=LIMITED';
 End;
 G2AFrSize:=W*H+2*NVCW*NVCH;
 GetMem(G2AFr,G2AFrSize+64); FillChar(G2AFr^,G2AFrSize+64,0);
End;

{ ---- Winnov WNV1 (libavcodec/wnv1.c) ---- }
Const
 G2WNLen: Array[0..15] Of Byte=(1,3,3,4,4,5,5,6,6,7,7,8,8,9,9,8);
 G2WNSym: Array[0..15] Of Byte=(7,8,6,9,5,10,4,11,3,12,2,13,1,14,0,15);

Function G2WNCode(Shift,Base: LongInt): LongInt;
Var Code,Len,I,V,Cl: LongInt; B: Int64; Found: Boolean;
Begin
 { codes canoniques lus bit a bit dans l'ordre du flux }
 Code:=0; Len:=0; V:=0; Found:=False;
 While (Len<9) And Not Found Do Begin
  Code:=Code*2+G2ABits(1); Inc(Len);
  B:=0;
  For I:=0 To 15 Do Begin
   Cl:=G2WNLen[I];
   If (Cl=Len) And (Int64(Code)=(B Shr (32-Len))) Then Begin Found:=True; V:=
    G2WNSym[I]-7; Break; End;
   B:=B+(Int64(1) Shl (32-Cl));
  End;
 End;
 If Not Found Then V:=0;
 If V=8 Then G2WNCode:=G2ABits(8-Shift) Shl Shift
 Else G2WNCode:=Base+V*(1 Shl Shift);
