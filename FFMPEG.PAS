Procedure BPFrame(T:Integer; Sample:PSample);
Type
 TBPRow=Array[0..4095] Of Byte;
 PBPRow=^TBPRow;
 TBPPlane=Array[0..4095] Of PBPRow;
 PBPPlane=^TBPPlane;
