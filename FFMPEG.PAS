 B:=(LongInt(W^.NoiseHi[(NoiseIndex+40) And 63])+W^.NoiseHi[(NoiseIndex+9) And 63]+(A Shr 16)) And 65535;
 W^.NoiseLo[NoiseIndex]:=A And 65535; W^.NoiseHi[NoiseIndex]:=B;
