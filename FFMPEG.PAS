Type
 TVector=Array[0..2047] Of Single;
 TFFT=Array[0..8191] Of Single;
 PFFT=^TFFT;
 TState=Record
  Spectrum,Exponent,Overlap: Array[0..1] Of TVector;
  Window: TVector;
 End;
 PState=^TState;
 TTree=Array[0..1023,0..1] Of Integer;
 PTree=^TTree;
 TRun=Array[0..475] Of Integer;
 TBytes=Array[0..8191] Of Byte;
