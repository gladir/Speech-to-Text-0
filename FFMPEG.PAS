 MOWWavTag:=0;
 Case C Of
  FC_ADPCM_MS: MOWWavTag:=$0002;
  FC_ADPCM_IMA_WAV: MOWWavTag:=$0011;
  FC_ADPCM_SWF: MOWWavTag:=$5346;
