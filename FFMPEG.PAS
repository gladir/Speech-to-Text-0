{ ==== F4-BEGIN : Matroska / WebM / NUT (muxeurs et demuxeurs ; reference FFmpeg
 6.1.1 matroskaenc.c, matroskadec.c, nutenc.c, nutdec.c) ==== }
Procedure Commit(Const Stage: String); Forward;
Procedure F4MuxNut(Const Target: String); Forward;
Procedure F4NutDemux(Var Inter: String); Forward;
Const
 F4MaxSt=8; F4MaxMeta=12;
Type
 TF4Pkt=Record Pos,Len: LongInt; Pts,Dts,Dur: Int64; Key: Boolean; SkipS,SkipE:
  LongInt; End;
 TF4PktA=Array[0..20000000] Of TF4Pkt; PF4PktA=^TF4PktA;
 TF4St=Record
  Typ: LongInt;                    { 0 video, 1 audio }
  Codec: String[24];               { nom du codec ffmpeg }
  Tag: LongWord;                   { codec_tag }
  W,H,Bits: LongInt;               { video : taille, bits_per_coded_sample }
  SarN,SarD: LongInt;
  AvgN,AvgD,RN,RD: Int64;          { avg_frame_rate, r_frame_rate }
  TbN,TbD: Int64;                  { base de temps des paquets }
  Rate,Chans,RawBits,SampBytes,BlockAlign: LongInt;
  BitRate: LongInt;                { bit_rate du flux audio }
  InitPad: LongInt;                { initial_padding (echantillons) }
  Dflt: Boolean;                   { disposition par defaut }
  FieldOrder,ChromaLoc,CRange,CSpace,CTrc,CPri: LongInt;
  PixFmt: String[16];
  EncTag: String[64];              { valeur du tag ENCODER du flux ('' : aucun)
   }
  Off: Int64;                      { decalage des horodatages (-start_time du
   fichier source) en ticks de TbN/TbD }
  MetaN: LongInt; MetaK,MetaV: Array[0..F4MaxMeta-1] Of String[64];   {
   metadonnees de flux (ordre d'insertion) }
  Adts: Boolean;                   { AAC : paquets ADTS bruts (en-tete conserve)
   }
  RsvPce: Boolean;                 { AAC : espace reserve pour l'extradata
   (MAX_PCE_SIZE) }
  Lang: String[8];
  VDelay: LongInt;                 { video_delay (has_b_frames) }
  Title: String[64];
  Extra: PEABuffer; ExtraLen: LongInt;
  Data: PEABuffer; DataLen,DataCap: LongInt;
  P: PF4PktA; NPk,PCap: LongInt;
 End;
 TF4B=Record P: PEABuffer; N,Cap: LongInt; End;
Var
 F4S: Array[0..F4MaxSt-1] Of TF4St; F4NS: LongInt;
 F4Err: String;
 F4GN: LongInt; F4GK,F4GV: Array[0..15] Of String[120];   { metadonnees globales
  (cle generique ffmpeg) }

{ ---- arithmetique 128 bits : a*b/c avec les modes d'arrondi de av_rescale_rnd
 (0 zero, 1 inf, 2 bas, 3 haut, 4 plus proche) ---- }
Function F4MulDivR(A,B,C: Int64; Rnd: LongInt): Int64;
Var
 Neg: Boolean; X,Y,Z,Q,R,Hi,Lo,A0,A1,B0,B1,P00,P01,P10,P11,Mid,Bit: QWord; I:
  LongInt; Up: Boolean;
Begin
 Neg:=False;
 If A<0 Then Begin A:=-A; Neg:=Not Neg; End;
 If B<0 Then Begin B:=-B; Neg:=Not Neg; End;
 If C<0 Then Begin C:=-C; Neg:=Not Neg; End;
 If C=0 Then Begin F4MulDivR:=0; Exit; End;
 X:=QWord(A); Y:=QWord(B); Z:=QWord(C);
 A0:=X And $FFFFFFFF; A1:=X Shr 32; B0:=Y And $FFFFFFFF; B1:=Y Shr 32;
 P00:=A0*B0; P01:=A0*B1; P10:=A1*B0; P11:=A1*B1;
 Mid:=(P00 Shr 32)+(P01 And $FFFFFFFF)+(P10 And $FFFFFFFF);
 Lo:=(P00 And $FFFFFFFF) Or ((Mid And $FFFFFFFF) Shl 32);
 Hi:=P11+(P01 Shr 32)+(P10 Shr 32)+(Mid Shr 32);
 Q:=0; R:=0;
 For I:=127 Downto 0 Do Begin
  If I>=64 Then Bit:=(Hi Shr (I-64)) And 1 Else Bit:=(Lo Shr I) And 1;
  If R>=QWord($8000000000000000) Then Begin R:=(R Shl 1) Or Bit; R:=R-Z; Q:=(Q
   Shl 1) Or 1; End
  Else Begin
   R:=(R Shl 1) Or Bit;
   If R>=Z Then Begin R:=R-Z; Q:=(Q Shl 1) Or 1; End Else Q:=Q Shl 1;
  End;
 End;
 { Q quotient (tronque), R reste }
 Case Rnd Of
  0: Up:=False;
  1: Up:=R<>0;
  2: Up:=Neg And (R<>0);
  3: Up:=(Not Neg) And (R<>0);
  Else Begin
   If R>=QWord($8000000000000000) Then Up:=True Else Up:=(R*2>=Z);
  End;
 End;
 If Up Then Inc(Q);
 If Neg Then F4MulDivR:=-Int64(Q) Else F4MulDivR:=Int64(Q);
End;

{ av_rescale_q_rnd avec NOPTS conserve (AV_ROUND_PASS_MINMAX) }
Const F4NoPts: Int64 = -9223372036854775807-1;
Function F4RescQ(A,Bn,Bd,Cn,Cd: Int64; Rnd: LongInt): Int64;
Begin
 If (A=F4NoPts) Or (A=9223372036854775807) Then Begin F4RescQ:=A; Exit; End;
 F4RescQ:=F4MulDivR(A,Bn*Cd,Bd*Cn,Rnd);
End;

Function F4LcS(Const S: String): String;
Var I: LongInt;
Begin
 F4LcS:=S;
 For I:=1 To Length(S) Do If S[I] In ['A'..'Z'] Then F4LcS[I]:=Chr(Ord(S[I])+
  32);
End;
Function F4Gcd(A,B: Int64): Int64;
Var T: Int64;
Begin
 If A<0 Then A:=-A; If B<0 Then B:=-B;
 While B<>0 Do Begin T:=A Mod B; A:=B; B:=T; End;
 F4Gcd:=A;
End;

{ av_reduce }
Procedure F4Reduce(Var DstN,DstD: Int64; Num,Den,Max: Int64);
Var A0n,A0d,A1n,A1d,X,NextDen,A2n,A2d,G: Int64; Sign: Boolean;
Begin
 A0n:=0; A0d:=1; A1n:=1; A1d:=0;
 Sign:=(Num<0)<>(Den<0);
 G:=F4Gcd(Num,Den);
 If Num<0 Then Num:=-Num; If Den<0 Then Den:=-Den;
 If G<>0 Then Begin Num:=Num Div G; Den:=Den Div G; End;
 If (Num<=Max) And (Den<=Max) Then Begin A1n:=Num; A1d:=Den; Den:=0; End;
 While Den<>0 Do Begin
  X:=Num Div Den; NextDen:=Num-Den*X;
  A2n:=X*A1n+A0n; A2d:=X*A1d+A0d;
  If (A2n>Max) Or (A2d>Max) Then Begin
   If A1n<>0 Then X:=(Max-A0n) Div A1n;
   If A1d<>0 Then Begin If (Max-A0d) Div A1d<X Then X:=(Max-A0d) Div A1d; End;
   If Den*(2*X*A1d+A0d)>Num*A1d Then Begin A1n:=X*A1n+A0n; A1d:=X*A1d+A0d; End;
   Break;
  End;
  A0n:=A1n; A0d:=A1d; A1n:=A2n; A1d:=A2d; Num:=Den; Den:=NextDen;
 End;
 If Sign Then DstN:=-A1n Else DstN:=A1n;
 DstD:=A1d;
End;

{ ---- tampons d'octets extensibles (equivalent des avio dyn_buf) ---- }
Procedure F4BInit(Var B: TF4B);
Begin B.Cap:=4096; GetMem(B.P,B.Cap); B.N:=0; End;
Procedure F4BFree(Var B: TF4B);
Begin If B.P<>Nil Then FreeMem(B.P); B.P:=Nil; B.N:=0; B.Cap:=0; End;
Procedure F4BGrow(Var B: TF4B; Need: LongInt);
Var NC: LongInt;
Begin
 If B.N+Need>B.Cap Then Begin
  NC:=B.Cap*2; If NC<B.N+Need Then NC:=B.N+Need+4096;
  ReAllocMem(Pointer(B.P),NC); B.Cap:=NC;
 End;
End;
Procedure F4B1(Var B: TF4B; V: LongInt);
Begin F4BGrow(B,1); B.P^[B.N]:=V And 255; Inc(B.N); End;
Procedure F4BN(Var B: TF4B; Src: Pointer; Len: LongInt);
Begin
 If Len<=0 Then Exit;
 F4BGrow(B,Len); Move(Src^,B.P^[B.N],Len); Inc(B.N,Len);
End;
Procedure F4BCopy(Var B: TF4B; Const S: TF4B);
Begin F4BN(B,S.P,S.N); End;
Procedure F4BFill(Var B: TF4B; V,Cnt: LongInt);
Begin
 If Cnt<=0 Then Exit;
 F4BGrow(B,Cnt); FillChar(B.P^[B.N],Cnt,V); Inc(B.N,Cnt);
End;
Procedure F4BWb(Var B: TF4B; V: Int64; Cnt: LongInt);
Var I: LongInt;
Begin For I:=Cnt-1 DownTo 0 Do F4B1(B,LongInt((V Shr (I*8)) And 255)); End;
Procedure F4BWl(Var B: TF4B; V: Int64; Cnt: LongInt);
Var I: LongInt;
Begin For I:=0 To Cnt-1 Do F4B1(B,LongInt((V Shr (I*8)) And 255)); End;

{ ---- ecriture EBML ---- }
Function F4IdSize(Id: Int64): LongInt;
Var N: LongInt;
Begin N:=1; While (Id Shr (8*N))<>0 Do Inc(N); F4IdSize:=N; End;
Procedure F4BId(Var B: TF4B; Id: Int64);
Begin F4BWb(B,Id,F4IdSize(Id)); End;
Function F4NumSize(Num: Int64): LongInt;
Var N: LongInt;
Begin N:=0; Repeat Inc(N); Num:=Num Shr 7; Until Num=0; F4NumSize:=N; End;
Function F4LenSize(Len: Int64): LongInt;
Begin F4LenSize:=F4NumSize(Len+1); End;
Procedure F4BNum(Var B: TF4B; Num: Int64; Bytes: LongInt);
Begin Num:=Num Or (Int64(1) Shl (Bytes*7)); F4BWb(B,Num,Bytes); End;
Procedure F4BLen(Var B: TF4B; Len: Int64; Bytes: LongInt);
Begin If Bytes=0 Then Bytes:=F4LenSize(Len); F4BNum(B,Len,Bytes); End;
Function F4UIntSize(V: Int64): LongInt;
Var N: LongInt;
Begin N:=1; While (N<8) And ((V Shr (8*N))<>0) Do Inc(N); F4UIntSize:=N; End;
Procedure F4BUid(Var B: TF4B; Id,V: Int64);
Begin F4BId(B,Id); F4BLen(B,8,0); F4BWb(B,V,8); End;
Procedure F4BUInt(Var B: TF4B; Id,V: Int64);
Var N: LongInt;
Begin N:=F4UIntSize(V); F4BId(B,Id); F4BLen(B,N,0); F4BWb(B,V,N); End;
Procedure F4BFloat(Var B: TF4B; Id: Int64; D: Double);
Var Q: Int64;
Begin Move(D,Q,8); F4BId(B,Id); F4BLen(B,8,0); F4BWb(B,Q,8); End;
Procedure F4BBin(Var B: TF4B; Id: Int64; Src: Pointer; Len: LongInt);
Begin F4BId(B,Id); F4BLen(B,Len,0); F4BN(B,Src,Len); End;
Procedure F4BStr(Var B: TF4B; Id: Int64; Const S: String);
Begin F4BId(B,Id); F4BLen(B,Length(S),0); If Length(S)>0 Then F4BN(B,@S[1],
 Length(S)); End;
Procedure F4BSInt(Var B: TF4B; Id,V: Int64);
Var T: Int64; N: LongInt;
Begin
 If V<0 Then T:=(V Xor -1)*2 Else T:=V*2;
 N:=F4UIntSize(T);
 F4BId(B,Id); F4BLen(B,N,0); F4BWb(B,V,N);
End;
Procedure F4BVoid(Var B: TF4B; Size: LongInt);
Begin
 F4BId(B,$EC);
 If Size<10 Then Begin Dec(Size,2); F4BLen(B,Size,0); End
 Else Begin Dec(Size,9); F4BLen(B,Size,8); End;
 F4BFill(B,0,Size);
End;
{ element maitre dont le contenu est dans C ; longueur minimale ou Bytes octets
 }
Procedure F4BMaster(Var B: TF4B; Id: Int64; Const C: TF4B; Bytes: LongInt);
Begin F4BId(B,Id); F4BLen(B,C.N,Bytes); F4BCopy(B,C); End;

{ CRC-32 IEEE (identique a av_crc(AV_CRC_32_IEEE_LE, UINT32_MAX, ..) ^
 UINT32_MAX) }
Var F4CrcT: Array[0..255] Of LongWord; F4CrcOk: Boolean;
Function F4Crc(P: PEABuffer; Start,Len: LongInt): LongWord;
Var I,K: LongInt; C: LongWord;
Begin
 If Not F4CrcOk Then Begin
  For I:=0 To 255 Do Begin
   C:=I;
   For K:=1 To 8 Do If (C And 1)<>0 Then C:=(C Shr 1) Xor $EDB88320 Else C:=C
    Shr 1;
   F4CrcT[I]:=C;
  End;
  F4CrcOk:=True;
 End;
 C:=$FFFFFFFF;
 For I:=Start To Start+Len-1 Do C:=(C Shr 8) Xor F4CrcT[(C Xor P^[I]) And 255];
 F4Crc:=C Xor $FFFFFFFF;
End;

{ ---- modele de flux / paquets ---- }
Procedure F4Reset;
Var I: LongInt;
Begin
 For I:=0 To F4NS-1 Do Begin
  If F4S[I].Extra<>Nil Then FreeMem(F4S[I].Extra);
  If F4S[I].Data<>Nil Then FreeMem(F4S[I].Data);
  If F4S[I].P<>Nil Then FreeMem(F4S[I].P);
 End;
 FillChar(F4S,SizeOf(F4S),0); F4NS:=0; F4Err:=''; F4GN:=0;
End;

Procedure F4GAdd(Const K,V: String);
Begin
 If F4GN<16 Then Begin F4GK[F4GN]:=K; F4GV[F4GN]:=V; Inc(F4GN); End;
End;
Function F4GFind(Const K: String): LongInt;
Var I: LongInt;
Begin F4GFind:=-1; For I:=0 To F4GN-1 Do If F4GK[I]=K Then F4GFind:=I; End;

Function F4AddStream(Typ: LongInt; Const Codec: String): LongInt;
Var I: LongInt;
Begin
 If F4NS>=F4MaxSt Then Fail('Trop de flux (8 maximum).');
 I:=F4NS; Inc(F4NS);
 FillChar(F4S[I],SizeOf(F4S[I]),0);
 F4S[I].Typ:=Typ; F4S[I].Codec:=Codec;
 F4S[I].SarN:=0; F4S[I].SarD:=1; F4S[I].TbN:=1; F4S[I].TbD:=1000;
 F4S[I].CSpace:=2; F4S[I].CTrc:=2; F4S[I].CPri:=2;
 F4S[I].Lang:='und';
 F4AddStream:=I;
End;

Procedure F4SetExtra(S: LongInt; Src: Pointer; Len: LongInt);
Begin
 If F4S[S].Extra<>Nil Then Begin FreeMem(F4S[S].Extra); F4S[S].Extra:=Nil; End;
 F4S[S].ExtraLen:=Len;
 If Len>0 Then Begin GetMem(F4S[S].Extra,Len+64); Move(Src^,F4S[S].Extra^,Len);
  End;
End;

Procedure F4AddPkt(S: LongInt; Src: Pointer; Len: LongInt; Pts,Dts,Dur: Int64;
 Key: Boolean; SkipS,SkipE: LongInt);
Var NC: LongInt;
Begin
 With F4S[S] Do Begin
  If P=Nil Then Begin PCap:=1024; GetMem(P,PCap*SizeOf(TF4Pkt)); End
  Else If NPk>=PCap Then Begin
   NC:=PCap*2; ReAllocMem(Pointer(P),NC*SizeOf(TF4Pkt)); PCap:=NC;
  End;
  If Data=Nil Then Begin DataCap:=65536; GetMem(Data,DataCap); DataLen:=0; End;
  If DataLen+Len+16>DataCap Then Begin
   NC:=DataCap*2; If NC<DataLen+Len+16 Then NC:=DataLen+Len+65536;
   ReAllocMem(Pointer(Data),NC); DataCap:=NC;
  End;
  If Len>0 Then Move(Src^,Data^[DataLen],Len);
  P^[NPk].Pos:=DataLen; P^[NPk].Len:=Len; P^[NPk].Pts:=Pts; P^[NPk].Dts:=Dts;
   P^[NPk].Dur:=Dur;
  P^[NPk].Key:=Key; P^[NPk].SkipS:=SkipS; P^[NPk].SkipE:=SkipE;
  Inc(DataLen,Len); Inc(NPk);
 End;
End;

{ ---- Matroska : table des codecs ---- }
Function F4MkNative(Const C: String; Webm: Boolean; Var Id: String): Boolean;
Begin
 F4MkNative:=True; Id:='';
 If Webm Then Begin
  If C='vp8' Then Id:='V_VP8' Else If C='vp9' Then Id:='V_VP9' Else If C='av1'
   Then Id:='V_AV1'
  Else If C='vorbis' Then Id:='A_VORBIS' Else If C='opus' Then Id:='A_OPUS'
  Else F4MkNative:=False;
  Exit;
 End;
 If C='mpeg4' Then Id:='V_MPEG4/ISO/ASP'
 Else If C='msmpeg4v3' Then Id:='V_MPEG4/MS/V3'
 Else If C='mjpeg' Then Id:='V_MJPEG'
 Else If C='h264' Then Id:='V_MPEG4/ISO/AVC'
 Else If C='hevc' Then Id:='V_MPEGH/ISO/HEVC'
 Else If C='mpeg1video' Then Id:='V_MPEG1'
 Else If C='mpeg2video' Then Id:='V_MPEG2'
 Else If C='theora' Then Id:='V_THEORA'
 Else If C='vp8' Then Id:='V_VP8'
 Else If C='vp9' Then Id:='V_VP9'
 Else If C='av1' Then Id:='V_AV1'
 Else If C='snow' Then Id:='V_SNOW'
 Else If C='rv10' Then Id:='V_REAL/RV10'
 Else If C='rv20' Then Id:='V_REAL/RV20'
 Else If C='rv30' Then Id:='V_REAL/RV30'
 Else If C='rv40' Then Id:='V_REAL/RV40'
 Else If C='prores' Then Id:='V_PRORES'
 Else If C='mp2' Then Id:='A_MPEG/L2'
 Else If C='mp1' Then Id:='A_MPEG/L1'
 Else If C='mp3' Then Id:='A_MPEG/L3'
 Else If C='ac3' Then Id:='A_AC3'
 Else If C='eac3' Then Id:='A_EAC3'
 Else If C='aac' Then Id:='A_AAC'
 Else If C='flac' Then Id:='A_FLAC'
 Else If C='vorbis' Then Id:='A_VORBIS'
 Else If C='opus' Then Id:='A_OPUS'
 Else If C='dts' Then Id:='A_DTS'
 Else If C='truehd' Then Id:='A_TRUEHD'
 Else If C='mlp' Then Id:='A_MLP'
 Else If C='alac' Then Id:='A_ALAC'
 Else If C='tta' Then Id:='A_TTA1'
 Else If C='wavpack' Then Id:='A_WAVPACK4'
 Else If (C='pcm_s16le') Or (C='pcm_s24le') Or (C='pcm_s32le') Or (C='pcm_u8')
  Then Id:='A_PCM/INT/LIT'
 Else If (C='pcm_s16be') Or (C='pcm_s24be') Or (C='pcm_s32be') Then Id:=
  'A_PCM/INT/BIG'
 Else If (C='pcm_f32le') Or (C='pcm_f64le') Then Id:='A_PCM/FLOAT/IEEE'
 Else If C='rawvideo' Then Id:='V_UNCOMPRESSED'
 Else F4MkNative:=False;
End;

{ duree d'une trame audio d'apres av_get_audio_frame_duration2(par, 0) }
Function F4AudioFrameSamples(Const C: String; Rate: LongInt): LongInt;
Begin
 F4AudioFrameSamples:=0;
 If C='mp1' Then F4AudioFrameSamples:=384
 Else If C='mp2' Then F4AudioFrameSamples:=1152
 Else If C='ac3' Then F4AudioFrameSamples:=1536
 Else If C='mp3' Then Begin If (Rate>0) And (Rate<=24000) Then
  F4AudioFrameSamples:=576 Else If Rate>0 Then F4AudioFrameSamples:=1152; End;
End;

{ ---- muxeur Matroska ---- }
Type
 TF4Trk=Record
  Num,NumSize: LongInt; Uid: Int64; Native,WriteDts,HasCue: Boolean; CodecId:
   String[40];
  TsOffset: Int64; DefLo,DefHi: Int64; LastTs,Dur: Int64; Cur: LongInt;
   FrameSamples: LongInt;
 End;
Var
 F4T: Array[0..F4MaxSt-1] Of TF4Trk;
 F4Out,F4Cl: TF4B; F4ClOpen: Boolean; F4ClPos,F4ClPts,F4SegOff,F4Dur: Int64;
 F4Crcw,F4Webm,F4HaveVideo,F4MBitExact: Boolean;
 F4CueN,F4CueCap: LongInt;
 F4CueA: PEABuffer;
 F4AudPkt: LongInt; F4AudStream: LongInt; F4AudValid: Boolean;

Var F4AscTmp: Array[0..1] Of Byte;

Procedure F4MkTrackEntry(Var Tr: TF4B; S: LongInt);
Var
 C,V,A,Cc,Co,Pr: TF4B; St: ^TF4St; T: ^TF4Trk; Id,VfwId: String; FRn,FRd: Int64;
  Native: Boolean;
 DWidth,Ar,Ap: Int64; I,Hc: LongInt; BDepth: LongInt; CodecPrivMax: LongInt;
  Pri: Int64;
 PadN: LongInt;
Begin
 St:=@F4S[S]; T:=@F4T[S];
 F4BInit(C);
 F4BUInt(C,$D7,T^.Num);
 F4BUid(C,$73C5,T^.Uid);
 F4BUInt(C,$9C,0);
 If St^.Title<>'' Then F4BStr(C,$536E,St^.Title);
 If St^.Lang<>'' Then F4BStr(C,$22B59C,St^.Lang) Else F4BStr(C,$22B59C,'und');
 If Not St^.Dflt Then F4BUInt(C,$88,0);
 Native:=T^.Native;
 If Native Then F4BStr(C,$86,T^.CodecId);
 If St^.Typ=0 Then Begin
  F4BUInt(C,$83,1);
  FRn:=0; FRd:=1;
  If (St^.AvgN>0) And (St^.AvgD>0) Then Begin FRn:=St^.AvgN; FRd:=St^.AvgD; End
  Else If (St^.RN>0) And (St^.RD>0) Then Begin FRn:=St^.RN; FRd:=St^.RD; End;
  If FRn>0 Then Begin
   F4BUInt(C,$23E383,Int64(1000000000)*FRd Div FRn);
   T^.DefLo:=Int64(1000)*FRd Div FRn;
   T^.DefHi:=T^.DefLo; If (Int64(1000)*FRd Mod FRn)<>0 Then Inc(T^.DefHi);
  End;
  If Not Native Then Begin
   F4BStr(C,$86,'V_MS/VFW/FOURCC'); T^.WriteDts:=True;
  End;
  { Video }
  F4BInit(V);
  F4BUInt(V,$B0,St^.W); F4BUInt(V,$BA,St^.H);
  If St^.FieldOrder=1 Then F4BUInt(V,$9A,2)
  Else If St^.FieldOrder>=2 Then Begin
   F4BUInt(V,$9A,1);
   If Not F4Webm Then Case St^.FieldOrder Of 2: F4BUInt(V,$9D,1); 3: F4BUInt(V,
    $9D,6); 4: F4BUInt(V,$9D,9); 5: F4BUInt(V,$9D,14); End;
  End;
  If St^.PixFmt='yuva420p' Then F4BUInt(V,$53C0,1);
  If St^.SarN>0 Then Begin
   DWidth:=F4MulDivR(St^.W,St^.SarN,St^.SarD,4);
   If DWidth<>St^.W Then Begin
    If F4Webm Then Begin F4BUInt(V,$54B0,DWidth); F4BUInt(V,$54BA,St^.H); End
    Else Begin
     F4Reduce(Ar,Ap,Int64(St^.W)*St^.SarN,Int64(St^.H)*St^.SarD,1024*1024);
     F4BUInt(V,$54B0,Ar); F4BUInt(V,$54BA,Ap); F4BUInt(V,$54B2,3);
    End;
   End;
  End Else If Not F4Webm Then F4BUInt(V,$54B2,4);
  If St^.Codec='rawvideo' Then Begin
   F4BId(V,$2EB524); F4BLen(V,4,0); F4BWl(V,St^.Tag,4);
  End;
  { Colour }
  F4BInit(Co);
  If (St^.CTrc<>2) And (St^.CTrc<19) Then F4BUInt(Co,$55BA,St^.CTrc);
  If (St^.CSpace<>2) And (St^.CSpace<15) Then F4BUInt(Co,$55B1,St^.CSpace);
  If (St^.CPri<>2) And (St^.CPri<23) Then F4BUInt(Co,$55BB,St^.CPri);
  If (St^.CRange<>0) And (St^.CRange<3) Then F4BUInt(Co,$55B9,St^.CRange);
  If (St^.ChromaLoc<>0) And (St^.ChromaLoc<=4) Then Begin
   Case St^.ChromaLoc Of
    1: Begin F4BUInt(Co,$55B7,1); F4BUInt(Co,$55B8,2); End;
    2: Begin F4BUInt(Co,$55B7,2); F4BUInt(Co,$55B8,2); End;
    3: Begin F4BUInt(Co,$55B7,1); F4BUInt(Co,$55B8,1); End;
    4: Begin F4BUInt(Co,$55B7,2); F4BUInt(Co,$55B8,1); End;
   End;
  End;
  If Co.N>0 Then F4BMaster(V,$55B0,Co,0);
  F4BFree(Co);
  F4BMaster(C,$E0,V,0);
  F4BFree(V);
 End Else Begin
  If St^.InitPad<>0 Then
   F4BUInt(C,$56AA,F4MulDivR(St^.InitPad,1000000000,St^.Rate,4));
  F4BUInt(C,$83,2);
  If T^.FrameSamples>0 Then Begin
   F4BUInt(C,$23E383,Int64(1000000000)*T^.FrameSamples Div St^.Rate);
   T^.DefLo:=Int64(1000)*T^.FrameSamples Div St^.Rate;
   T^.DefHi:=T^.DefLo; If (Int64(1000)*T^.FrameSamples Mod St^.Rate)<>0 Then
    Inc(T^.DefHi);
  End;
  If Not Native Then F4BStr(C,$86,'A_MS/ACM');
  F4BInit(A);
  F4BUInt(A,$9F,St^.Chans);
  F4BFloat(A,$B5,St^.Rate);
  If (St^.Codec='aac') And St^.RsvPce Then F4BFloat(A,$78B5,St^.Rate);
  If St^.Bits>0 Then F4BUInt(A,$6264,St^.Bits);
  F4BId(C,$E1); F4BLen(C,A.N,F4LenSize(42)); F4BCopy(C,A);
  F4BFree(A);
 End;
 If Not F4Webm Then Begin
  F4BUInt(C,$55EE,0);
  If St^.Typ=0 Then F4BVoid(C,11);
 End;
 { CodecPrivate }
 F4BInit(Pr);
 If Native Then Begin
  If St^.Codec='flac' Then Begin
   If St^.ExtraLen>=34 Then Begin
    F4B1(Pr,$66); F4B1(Pr,$4C); F4B1(Pr,$61); F4B1(Pr,$43); F4B1(Pr,$80); F4BWb(
     Pr,34,3); F4BN(Pr,St^.Extra,34);
   End;
  End Else If St^.ExtraLen>0 Then F4BN(Pr,St^.Extra,St^.ExtraLen);
 End Else If St^.Typ=0 Then Begin
  { en-tete BITMAPINFOHEADER (ff_put_bmp_header) }
  Hc:=St^.Bits; If Hc=0 Then Hc:=24;
  F4BWl(Pr,40+St^.ExtraLen,4); F4BWl(Pr,St^.W,4); F4BWl(Pr,St^.H,4); F4BWl(Pr,1,
   2); F4BWl(Pr,Hc,2);
  F4BWl(Pr,St^.Tag,4); F4BWl(Pr,(Int64(St^.W)*St^.H*Hc+7) Div 8,4); F4BWl(Pr,0,
   4); F4BWl(Pr,0,4); F4BWl(Pr,0,4); F4BWl(Pr,0,4);
  If St^.ExtraLen>0 Then Begin
   F4BN(Pr,St^.Extra,St^.ExtraLen);
   If Odd(St^.ExtraLen) Then F4B1(Pr,0);
  End;
 End;
 If Pr.N>0 Then Begin
  F4BId(C,$63A2); F4BLen(C,Pr.N,0); F4BCopy(C,Pr);
 End;
 If St^.RsvPce Then Begin
  { espace reserve : 2 + longueur(MAX_PCE_SIZE) + MAX_PCE_SIZE octets au total }
  PadN:=2+F4LenSize(320)+320-(Pr.N+2+F4LenSize(Pr.N));
  If Pr.N=0 Then PadN:=2+F4LenSize(320)+320;
  If PadN>=2 Then F4BVoid(C,PadN);
 End;
 F4BFree(Pr);
 F4BMaster(Tr,$AE,C,8);
 F4BFree(C);
End;

Procedure F4MkWrap(Var Dst: TF4B; Id: Int64; Const Inner: TF4B; Crc: Boolean);
Var C: LongWord; B4: TF4B;
Begin
 F4BId(Dst,Id); F4BLen(Dst,Inner.N,0);
 If Crc Then Begin
  C:=F4Crc(Inner.P,6,Inner.N-6);
  F4BId(Dst,$BF); F4BLen(Dst,4,0); F4BWl(Dst,C,4);
  F4BN(Dst,@Inner.P^[6],Inner.N-6);
 End Else F4BCopy(Dst,Inner);
End;

Var F4SegUid: Array[0..15] Of Byte;

Procedure F4MkBuildInfo(Var Dst: TF4B; Dur: Int64);
Var I: TF4B; D: Double;
Begin
 F4BInit(I);
 If F4Crcw Then F4BVoid(I,6);
 F4BUInt(I,$2AD7B1,1000000);
 If F4GFind('title')>=0 Then F4BStr(I,$7BA9,F4GV[F4GFind('title')]);
 If F4MBitExact Then Begin
  F4BStr(I,$4D80,'Lavf'); F4BStr(I,$5741,'Lavf');
 End Else Begin
  F4BStr(I,$4D80,'Lavf60.16.100'); F4BStr(I,$5741,'Lavf60.16.100');
  If Not F4Webm Then F4BBin(I,$73A4,@F4SegUid[0],16);
 End;
 D:=Dur; F4BFloat(I,$4489,D);
 F4MkWrap(Dst,$1549A966,I,F4Crcw);
 F4BFree(I);
End;

Procedure F4MkDurStr(Dur: Int64; Var S: String);
Var H,M,Sec,Ms: Int64; T: String;
Begin
 H:=Dur Div 3600000; M:=(Dur Div 60000) Mod 60; Ms:=Dur Mod 60000;
 Sec:=Ms Div 1000; Ms:=Ms Mod 1000;
 S:='';
 Str(H:2,T); If T[1]=' ' Then T[1]:='0'; S:=S+T+':';
 Str(M:2,T); If T[1]=' ' Then T[1]:='0'; S:=S+T+':';
 Str(Sec:2,T); If T[1]=' ' Then T[1]:='0'; S:=S+T+'.';
 Str(Ms:3,T); While Pos(' ',T)>0 Do T[Pos(' ',T)]:='0';
 S:=S+T+'000000';
End;

Procedure F4MkSimpleTag(Var Dst: TF4B; Const Key,Val: String);
Var C: TF4B;
Begin
 F4BInit(C);
 F4BStr(C,$45A3,Key); F4BStr(C,$4487,Val);
 F4BMaster(Dst,$67C8,C,0);
 F4BFree(C);
End;

Procedure F4MkBuildTags(Var Dst: TF4B);
Var I: TF4B; S,J,Q,Cnt: LongInt; Tg,Tc,Sc: TF4B; Ds: String;
Begin
 F4BInit(I);
 If F4Crcw Then F4BVoid(I,6);
 Cnt:=0;
 For J:=0 To F4GN-1 Do If (F4GK[J]<>'title') And (F4GK[J]<>'stereo_mode') And (
  F4GK[J]<>'creation_time') And (F4GK[J]<>'encoding_tool') And (F4GK[
  J]<>'duration') Then Inc(Cnt);
 If (Not F4MBitExact) Or (Cnt>0) Then Begin
  F4BInit(Tg);
  F4BInit(Tc); F4BId(Tc,$63C0); F4BLen(Tc,0,F4LenSize(13)); F4BCopy(Tg,Tc);
   F4BFree(Tc);
  For J:=0 To F4GN-1 Do If (F4GK[J]<>'title') And (F4GK[J]<>'stereo_mode') And (
   F4GK[J]<>'creation_time') And (F4GK[J]<>'encoding_tool') And (F4GK[
   J]<>'duration') And (F4GK[J]<>'encoder') Then Begin
   Ds:=F4GK[J]; For Q:=1 To Length(Ds) Do Begin If Ds[Q]=' ' Then Ds[Q]:='_'
    Else If Ds[Q] In ['a'..'z'] Then Ds[Q]:=Chr(Ord(Ds[Q])-32); End;
   F4MkSimpleTag(Tg,Ds,F4GV[J]);
  End;
  If Not F4MBitExact Then F4MkSimpleTag(Tg,'ENCODER','Lavf60.16.100');
  F4BMaster(I,$7373,Tg,0);
  F4BFree(Tg);
 End;
 For S:=0 To F4NS-1 Do Begin
  F4BInit(Tg);
  F4BInit(Tc); F4BUid(Tc,$63C5,F4T[S].Uid);
  F4BId(Tg,$63C0); F4BLen(Tg,Tc.N,F4LenSize(13)); F4BCopy(Tg,Tc); F4BFree(Tc);
  If F4S[S].MetaN>0 Then Begin
   For J:=0 To F4S[S].MetaN-1 Do If (F4LcS(F4S[S].MetaK[J])<>'language') And (
    F4LcS(F4S[S].MetaK[J])<>'title') And (F4LcS(F4S[S].MetaK[J])<>'duration')
    Then Begin
    Ds:=F4S[S].MetaK[J]; For Q:=1 To Length(Ds) Do Begin If Ds[Q]=' ' Then Ds[
     Q]:='_' Else If Ds[Q] In ['a'..'z'] Then Ds[Q]:=Chr(Ord(Ds[Q])-32); End;
    F4MkSimpleTag(Tg,Ds,F4S[S].MetaV[J]);
   End;
  End Else
  If F4S[S].EncTag<>'' Then F4MkSimpleTag(Tg,'ENCODER',F4S[S].EncTag);
  { DURATION : 19 octets (chaine + NUL) }
  F4MkDurStr(F4T[S].Dur,Ds);
  F4BInit(Sc); F4BStr(Sc,$45A3,'DURATION');
  F4BId(Sc,$4487); F4BLen(Sc,19,0); F4BN(Sc,@Ds[1],Length(Ds)); F4B1(Sc,0);
  F4BId(Tg,$67C8); F4BLen(Tg,Sc.N,F4LenSize(34)); F4BCopy(Tg,Sc); F4BFree(Sc);
  F4BMaster(I,$7373,Tg,0);
  F4BFree(Tg);
 End;
 F4MkWrap(Dst,$1254C367,I,F4Crcw);
 F4BFree(I);
End;

Procedure F4MkBuildTracks(Var Dst: TF4B);
Var I: TF4B; S: LongInt;
Begin
 F4BInit(I);
 If F4Crcw Then F4BVoid(I,6);
 For S:=0 To F4NS-1 Do F4MkTrackEntry(I,S);
 F4MkWrap(Dst,$1654AE6B,I,F4Crcw);
 F4BFree(I);
End;

Procedure F4MkEndCluster;
Var C: LongWord;
Begin
 If Not F4ClOpen Then Exit;
 F4BId(F4Out,$1F43B675); F4BLen(F4Out,F4Cl.N,0);
 If F4Crcw Then Begin
  C:=F4Crc(F4Cl.P,6,F4Cl.N-6);
  F4BId(F4Out,$BF); F4BLen(F4Out,4,0); F4BWl(F4Out,C,4);
  F4BN(F4Out,@F4Cl.P^[6],F4Cl.N-6);
 End Else F4BCopy(F4Out,F4Cl);
 F4Cl.N:=0; F4ClOpen:=False;
 If Not F4HaveVideo Then Begin
  { has_cue remis a zero pour chaque piste }
  C:=0;
 End;
End;

Procedure F4MkAddCue(Pts: Int64; Stream: LongInt; ClPos,Rel: Int64);
Var Idx,K: LongInt; P: ^Int64;
Begin
 If Pts<0 Then Exit;
 If F4CueN>=F4CueCap Then Begin
  If F4CueCap=0 Then F4CueCap:=256 Else F4CueCap:=F4CueCap*2;
  ReAllocMem(Pointer(F4CueA),F4CueCap*32);
 End;
 Idx:=F4CueN;
 { tableau de 4 Int64 par entree : pts, flux, position de cluster, position
  relative }
 While (Idx>0) And (PInt64(PtrUInt(F4CueA)+(Idx-1)*32)^>Pts) Do Dec(Idx);
 If Idx<F4CueN Then Move(Pointer(PtrUInt(F4CueA)+Idx*32)^,Pointer(PtrUInt(
  F4CueA)+(Idx+1)*32)^,(F4CueN-Idx)*32);
 PInt64(PtrUInt(F4CueA)+Idx*32)^:=Pts;
 PInt64(PtrUInt(F4CueA)+Idx*32+8)^:=Stream;
 PInt64(PtrUInt(F4CueA)+Idx*32+16)^:=ClPos-F4SegOff;
 PInt64(PtrUInt(F4CueA)+Idx*32+24)^:=Rel;
 Inc(F4CueN);
End;

Procedure F4MkInternal(S,K: LongInt);
Var
 P: ^TF4Pkt; Ts,Dur,CT,Dp: Int64; Keyf,Simple,Gdur: Boolean; RelPos,I: LongInt;
  Blk,Bg: TF4B; Rel: LongInt;
Begin
 P:=@F4S[S].P^[K];
 Keyf:=P^.Key; Dur:=P^.Dur; If Dur<0 Then Dur:=0;
 If F4T[S].WriteDts Then Ts:=P^.Dts Else Ts:=P^.Pts;
 If Ts=F4NoPts Then Fail('Can''t write packet with unknown timestamp');
 Ts:=Ts+F4T[S].TsOffset;
 If F4ClOpen Then Begin
  CT:=Ts-F4ClPts;
  If SmallInt(CT)<>CT Then F4MkEndCluster;
 End;
 If Not F4ClOpen Then Begin
  F4Cl.N:=0;
  If F4Crcw Then F4BVoid(F4Cl,6);
  F4ClPos:=F4Out.N;
  If Ts>0 Then F4ClPts:=Ts Else F4ClPts:=0;
  F4BUInt(F4Cl,$E7,F4ClPts);
  F4ClOpen:=True;
 End;
 RelPos:=F4Cl.N;
 Rel:=SmallInt(Ts-F4ClPts);
 Gdur:=(Dur>0) And (F4T[S].DefHi>0) And (Dur<>F4T[S].DefHi) And (Dur<>F4T[
  S].DefLo);
 Dp:=0;
 If P^.SkipE<>0 Then Dp:=F4MulDivR(P^.SkipE,1000000000,F4S[S].Rate,4);
 Simple:=(Not Gdur) And (Dp=0);
 F4BInit(Blk);
 F4BNum(Blk,F4T[S].Num,F4T[S].NumSize);
 F4BWb(Blk,Rel And $FFFF,2);
 If Simple And Keyf Then F4B1(Blk,$80) Else F4B1(Blk,0);
 F4BN(Blk,@F4S[S].Data^[P^.Pos],P^.Len);
 If Simple Then Begin
  F4BId(F4Cl,$A3); F4BLen(F4Cl,Blk.N,0); F4BCopy(F4Cl,Blk);
 End Else Begin
  F4BInit(Bg);
  F4BId(Bg,$A1); F4BLen(Bg,Blk.N,0); F4BCopy(Bg,Blk);
  If Gdur Then F4BUInt(Bg,$9B,Dur);
  If Dp<>0 Then F4BSInt(Bg,$75A2,Dp);
  If Not Keyf Then F4BSInt(Bg,$FB,F4T[S].LastTs-Ts);
  F4BMaster(F4Cl,$A0,Bg,0);
  F4BFree(Bg);
 End;
 F4BFree(Blk);
 If Keyf And ((F4S[S].Typ=0) Or ((Not F4HaveVideo) And (Not F4T[S].HasCue)))
  Then Begin
  F4MkAddCue(Ts,S,F4ClPos,RelPos);
  F4T[S].HasCue:=True;
 End;
 F4T[S].LastTs:=Ts;
 If Ts+Dur>F4Dur Then F4Dur:=Ts+Dur;
 If Ts+Dur>F4T[S].Dur Then F4T[S].Dur:=Ts+Dur;
End;

Procedure F4MkEndClusterX;
Var I: LongInt;
Begin
 If Not F4HaveVideo Then For I:=0 To F4NS-1 Do F4T[I].HasCue:=False;
 F4MkEndCluster;
End;

Procedure F4MkPacket(S,K: LongInt);
Var P: ^TF4Pkt; CT: Int64; Start: Boolean; Sz: LongInt;
Begin
 P:=@F4S[S].P^[K];
 If F4ClOpen Then Begin
  If F4T[S].WriteDts Then CT:=P^.Dts-F4ClPts Else CT:=P^.Pts-F4ClPts;
  CT:=CT+F4T[S].TsOffset;
  Sz:=F4Cl.N;
  Start:=(Sz>5*1024*1024) Or (CT>5000) Or ((F4S[S].Typ=0) And P^.Key And (Sz>4*
   1024));
  If Start Then F4MkEndClusterX;
 End;
 If F4AudValid Then Begin
  F4MkInternal(F4AudStream,F4AudPkt); F4AudValid:=False;
 End;
 If F4S[S].Typ=1 Then Begin
  If P^.Len>0 Then Begin F4AudStream:=S; F4AudPkt:=K; F4AudValid:=True; End;
 End Else F4MkInternal(S,K);
End;

{ duree de trame audio pour guess_pkt_duration (av_get_audio_frame_duration2) }
Function F4AudioPktSamples(Const C: String; Rate,Chans,Len: LongInt): LongInt;
Var Bps: LongInt;
Begin
 F4AudioPktSamples:=0;
 Bps:=0;
 If (C='pcm_s16le') Or (C='pcm_s16be') Then Bps:=16
 Else If (C='pcm_s24le') Or (C='pcm_s24be') Then Bps:=24
 Else If (C='pcm_s32le') Or (C='pcm_s32be') Or (C='pcm_f32le') Then Bps:=32
 Else If C='pcm_f64le' Then Bps:=64
 Else If C='pcm_u8' Then Bps:=8;
 If (Bps>0) And (Chans>0) And (Len>0) Then F4AudioPktSamples:=(Int64(Len)*8) Div
  (Bps*Chans)
 Else If C='aac' Then F4AudioPktSamples:=1024
 Else F4AudioPktSamples:=F4AudioFrameSamples(C,Rate);
End;

{ ecrit le fichier Matroska/WebM ; flux et paquets dans F4S ; Target : fichier a
 creer }
Procedure F4MuxMkv(Const Target: String; Webm: Boolean);
Var
 S,K,I,J,Best,Done,Total: LongInt; Id: String; Nat: Boolean; P: ^TF4Pkt; Hdr,Tr,
  Info,Tags,Sk,Cu,Cp,Tp,Ent,Seek: TF4B;
 InfoPos,TracksPos,TagsPos,CuesPos,EndPos: Int64; Shift,Mn,V: Int64; Cn,Cs:
  LongInt; Fo: File; Wr: LongInt; Code: LongInt;
 BestDts: Int64; Pt: PEABuffer; Cl2: Int64; Num: Int64; G: Int64; Tm: Int64;
 Got: Boolean; Lead: Int64; UseDts: Boolean; Entries: Array[0..7] Of Int64;
  EntId: Array[0..7] Of Int64; NE: LongInt;
 PtsTmp: Int64; PkTr: LongInt;
Begin
 F4Webm:=Webm; F4Crcw:=Not Webm; F4MBitExact:=VGBitExact;
 If F4NS<1 Then Fail('Aucun flux a ecrire.');
 F4HaveVideo:=False;
 For S:=0 To F4NS-1 Do Begin
  FillChar(F4T[S],SizeOf(F4T[S]),0);
  Nat:=F4MkNative(F4S[S].Codec,Webm,Id);
  If Webm And Not Nat Then Fail(
   'Only VP8 or VP9 or AV1 video and Vorbis or Opus audio and WebVTT subtitles'+
   ' are supported for WebM.');
  If (Not Webm) And (F4S[S].Typ=0) Then Begin
   If F4S[S].Codec='ffv1' Then Nat:=False
   Else If (F4S[S].Codec='rawvideo') And (F4S[S].Tag=0) Then Fail(
    'Raw RGB is not supported Natively in Matroska, you can use AVI or '+
    'NUT or'#10'If you would like to store it anyway using VFW mode, '+
    'enable allow_raw_vfw (-allow_raw_vfw 1)');
  End;
  If (Not Nat) And (F4S[S].Typ=1) Then Fail('No wav codec tag found for codec '+
   F4S[S].Codec);
  If (Not Nat) And (F4S[S].Typ=0) And (F4S[S].Tag=0) Then Fail(
   'No bmp codec tag found for codec '+F4S[S].Codec);
  F4T[S].Native:=Nat; F4T[S].CodecId:=Id;
  F4T[S].Num:=S+1; F4T[S].NumSize:=F4NumSize(S+1);
  If F4MBitExact Then F4T[S].Uid:=S+1
  Else Begin F4T[S].Uid:=(Int64(Random($7FFFFFFF)) Shl 32) Or Int64(Random(
   $7FFFFFFF)) Or 1; End;
  If F4S[S].Typ=0 Then F4HaveVideo:=True;
  If F4S[S].Typ=1 Then Begin
   F4T[S].FrameSamples:=F4AudioFrameSamples(F4S[S].Codec,F4S[S].Rate);
   If F4S[S].InitPad<>0 Then F4T[S].TsOffset:=F4MulDivR(F4S[S].InitPad,1000,F4S[
    S].Rate,4);
  End;
  { VFW : horodatage dts }
  If (F4S[S].Typ=0) And (Not Nat) Then F4T[S].WriteDts:=True;
 End;
 For I:=0 To 15 Do F4SegUid[I]:=Random(256);
 { aac_adtstoasc : en-tete ADTS retire, AudioSpecificConfig deduite du premier
  paquet }
 For S:=0 To F4NS-1 Do If F4S[S].Adts Then Begin
  If F4S[S].NPk>0 Then Begin
   Id:=Chr(0);
   P:=@F4S[S].P^[0];
   J:=F4S[S].Data^[P^.Pos+2];
   F4S[S].ExtraLen:=0;
   F4SetExtra(S,@F4AscTmp[0],2);
   F4AscTmp[0]:=(((J Shr 6)+1) Shl 3) Or (((J Shr 2) And 15) Shr 1);
   F4AscTmp[1]:=((((J Shr 2) And 15) And 1) Shl 7) Or ((((J And 1) Shl 2) Or (
    F4S[S].Data^[P^.Pos+3] Shr 6)) Shl 3);
   Move(F4AscTmp[0],F4S[S].Extra^,2);
  End;
  For K:=0 To F4S[S].NPk-1 Do Begin
   P:=@F4S[S].P^[K];
   If (F4S[S].Data^[P^.Pos+1] And 1)=0 Then J:=9 Else J:=7;
   Inc(P^.Pos,J); Dec(P^.Len,J);
  End;
  F4S[S].RsvPce:=True;
 End;
 { conversion des horodatages en ms (av_packet_rescale_ts), duree par defaut
  (guess_pkt_duration) }
 For S:=0 To F4NS-1 Do Begin
  For K:=0 To F4S[S].NPk-1 Do Begin
   P:=@F4S[S].P^[K];
   If (P^.Pts=F4NoPts) And (P^.Dts<>F4NoPts) Then P^.Pts:=P^.Dts;
   If (P^.Dts=F4NoPts) And (P^.Pts<>F4NoPts) Then P^.Dts:=P^.Pts;
   If P^.Pts<>F4NoPts Then P^.Pts:=P^.Pts+F4S[S].Off;
   If P^.Dts<>F4NoPts Then P^.Dts:=P^.Dts+F4S[S].Off;
   P^.Pts:=F4RescQ(P^.Pts,F4S[S].TbN,F4S[S].TbD,1,1000,4);
   P^.Dts:=F4RescQ(P^.Dts,F4S[S].TbN,F4S[S].TbD,1,1000,4);
   P^.Dur:=F4MulDivR(P^.Dur,F4S[S].TbN*1000,F4S[S].TbD,4);
   If P^.Dur=0 Then Begin
    If F4S[S].Typ=0 Then Begin
     If (F4S[S].AvgN>0) And (F4S[S].AvgD>0) Then P^.Dur:=F4MulDivR(1,F4S[
      S].AvgD*1000,F4S[S].AvgN,4);
    End Else Begin
     J:=F4AudioPktSamples(F4S[S].Codec,F4S[S].Rate,F4S[S].Chans,P^.Len);
     If (J>0) And (F4S[S].Rate>0) Then P^.Dur:=F4MulDivR(J,1000,F4S[S].Rate,4);
    End;
   End;
  End;
 End;
 { tete : EBML + Segment + SeekHead reserve }
 F4BInit(F4Out); F4BInit(F4Cl);
 F4BInit(Hdr);
 F4BUInt(Hdr,$4286,1); F4BUInt(Hdr,$42F7,1); F4BUInt(Hdr,$42F2,4); F4BUInt(Hdr,
  $42F3,8);
 If Webm Then Id:='webm' Else Id:='matroska';
 F4BStr(Hdr,$4282,Id);
 If Not Webm Then F4BUInt(Hdr,$4287,4) Else F4BUInt(Hdr,$4287,2);
 F4BUInt(Hdr,$4285,2);
 F4BMaster(F4Out,$1A45DFA3,Hdr,0);
 F4BFree(Hdr);
 F4BId(F4Out,$18538067); F4B1(F4Out,$01); F4BFill(F4Out,255,7);
 F4SegOff:=F4Out.N;
 F4BVoid(F4Out,7*21+14);
 F4Dur:=0;
 For S:=0 To F4NS-1 Do F4T[S].Dur:=0;
 InfoPos:=F4Out.N; F4BInit(Info); F4MkBuildInfo(Info,0); F4BCopy(F4Out,Info);
 TracksPos:=F4Out.N; F4BInit(Tr); F4MkBuildTracks(Tr); F4BCopy(F4Out,Tr);
 TagsPos:=F4Out.N; F4BInit(Tags); F4MkBuildTags(Tags); F4BCopy(F4Out,Tags);
 NE:=3; EntId[0]:=$1549A966; Entries[0]:=InfoPos-F4SegOff;
 EntId[1]:=$1654AE6B; Entries[1]:=TracksPos-F4SegOff;
 EntId[2]:=$1254C367; Entries[2]:=TagsPos-F4SegOff;
 F4ClOpen:=False; F4AudValid:=False; F4CueN:=0; F4CueCap:=0; F4CueA:=Nil;
 { ordre d'ecriture : entrelacement par dts (ordre croissant, a egalite le plus
  petit indice de flux) }
 Total:=0;
 For S:=0 To F4NS-1 Do Begin F4T[S].Cur:=0; Inc(Total,F4S[S].NPk); End;
 { avoid_negative_ts : decalage calcule sur le premier paquet de chaque flux }
 Shift:=0; Got:=False; Mn:=0; UseDts:=False;
 For S:=0 To F4NS-1 Do If F4T[S].WriteDts Then UseDts:=True;
 For S:=0 To F4NS-1 Do If F4S[S].NPk>0 Then Begin
  P:=@F4S[S].P^[0];
  If UseDts Then V:=P^.Dts Else V:=P^.Pts;
  If V<>F4NoPts Then Begin
   V:=V+F4T[S].TsOffset;
   If (Not Got) Or (V<Mn) Then Begin Mn:=V; Got:=True; End;
  End;
 End;
 { NB : avoid_negative_ts_use_pts vaut 0 des qu'une piste VFW existe ; la
  premiere cle suit le premier paquet ecrit }
 If Got And (Mn<0) Then Shift:=-Mn;
 If Shift<>0 Then
  For S:=0 To F4NS-1 Do For K:=0 To F4S[S].NPk-1 Do Begin
   P:=@F4S[S].P^[K];
   If P^.Dts<>F4NoPts Then P^.Dts:=P^.Dts+Shift;
   If P^.Pts<>F4NoPts Then P^.Pts:=P^.Pts+Shift;
  End;
 For Done:=1 To Total Do Begin
  Best:=-1; BestDts:=0;
  For S:=0 To F4NS-1 Do If F4T[S].Cur<F4S[S].NPk Then Begin
   If (Best<0) Or (F4S[S].P^[F4T[S].Cur].Dts<BestDts) Then Begin Best:=S;
    BestDts:=F4S[S].P^[F4T[S].Cur].Dts; End;
  End;
  K:=F4T[Best].Cur; Inc(F4T[Best].Cur);
  F4MkPacket(Best,K);
 End;
 { fin : paquet audio en attente, dernier cluster }
 If F4AudValid Then Begin F4MkInternal(F4AudStream,F4AudPkt); F4AudValid:=False;
  End;
 If F4ClOpen Then F4MkEndCluster;
 EndPos:=F4Out.N;
 { Cues }
 If F4CueN>0 Then Begin
  F4BInit(Cu);
  If F4Crcw Then F4BVoid(Cu,6);
  I:=0;
  While I<F4CueN Do Begin
   Tm:=PInt64(PtrUInt(F4CueA)+I*32)^;
   F4BInit(Cp);
   F4BUInt(Cp,$B3,Tm);
   For S:=0 To F4NS-1 Do F4T[S].HasCue:=False;
   Repeat
    Cs:=LongInt(PInt64(PtrUInt(F4CueA)+I*32+8)^);
    If Not F4T[Cs].HasCue Then Begin
     F4T[Cs].HasCue:=True;
     F4BInit(Tp);
     F4BUInt(Tp,$F7,F4T[Cs].Num);
     F4BUInt(Tp,$F1,PInt64(PtrUInt(F4CueA)+I*32+16)^);
     F4BUInt(Tp,$F0,PInt64(PtrUInt(F4CueA)+I*32+24)^);
     F4BId(Cp,$B7); F4BLen(Cp,Tp.N,F4LenSize(40)); F4BCopy(Cp,Tp);
     F4BFree(Tp);
    End;
    Inc(I);
   Until (I>=F4CueN) Or (PInt64(PtrUInt(F4CueA)+I*32)^<>Tm);
   F4BMaster(Cu,$BB,Cp,0);
   F4BFree(Cp);
  End;
  CuesPos:=F4Out.N;
  F4BInit(Ent);
  F4MkWrap(Ent,$1C53BB6B,Cu,F4Crcw);
  F4BCopy(F4Out,Ent);
  F4BFree(Ent); F4BFree(Cu);
  EntId[NE]:=$1C53BB6B; Entries[NE]:=CuesPos-F4SegOff; Inc(NE);
  EndPos:=F4Out.N;
 End;
 FreeMem(F4CueA); F4CueA:=Nil;
 { taille du segment }
 V:=EndPos-F4SegOff;
 For I:=0 To 7 Do F4Out.P^[F4SegOff-8+I]:=(((Int64(1) Shl 56) Or V) Shr ((7-I)*
  8)) And 255;
 { SeekHead }
 F4BInit(Sk);
 If F4Crcw Then F4BVoid(Sk,6);
 For I:=0 To NE-1 Do Begin
  F4BInit(Ent);
  F4BId(Ent,$53AB); F4BLen(Ent,F4IdSize(EntId[I]),0); F4BId(Ent,EntId[I]);
  F4BUInt(Ent,$53AC,Entries[I]);
  F4BId(Sk,$4DBB); F4BLen(Sk,Ent.N,F4LenSize(21)); F4BCopy(Sk,Ent);
  F4BFree(Ent);
 End;
 F4BInit(Seek);
 F4MkWrap(Seek,$114D9B74,Sk,F4Crcw);
 If Seek.N+2>7*21+14 Then Fail('SeekHead: espace reserve insuffisant.');
 F4BVoid(Seek,7*21+14-Seek.N);
 Move(Seek.P^,F4Out.P^[F4SegOff],Seek.N);
 F4BFree(Seek); F4BFree(Sk);
 { Info, Tracks et Tags definitifs }
 F4BFree(Info); F4BInit(Info); F4MkBuildInfo(Info,F4Dur);
 Move(Info.P^,F4Out.P^[InfoPos],Info.N);
 F4BFree(Tags); F4BInit(Tags); F4MkBuildTags(Tags);
 Move(Tags.P^,F4Out.P^[TagsPos],Tags.N);
 F4BFree(Info); F4BFree(Tags); F4BFree(Tr);
 { ecriture du fichier }
 OpenWrite(Target);
 K:=0;
 While K<F4Out.N Do Begin
  If F4Out.N-K>32768 Then J:=32768 Else J:=F4Out.N-K;
  WriteBytes(F4Out.P^[K],J); Inc(K,J);
 End;
 CloseWrite;
 F4BFree(F4Out); F4BFree(F4Cl);
End;

Var F4OutNut: Boolean;
{ selection automatique des flux comme ffmpeg : meilleure video (surface),
 meilleur audio (canaux), defaut favorise }
Procedure F4SelectStreams;
Var S,BV,BA,NV,NA: LongInt; Sc,BVs,BAs: Int64; Tmp: Array[0..1] Of TF4St;
Begin
 BV:=-1; BA:=-1; BVs:=-1; BAs:=-1; NV:=0; NA:=0;
 For S:=0 To F4NS-1 Do Begin
  If F4S[S].Typ=0 Then Begin
   Inc(NV); Sc:=Int64(F4S[S].W)*F4S[S].H; If F4S[S].Dflt Then Inc(Sc,100000000);
   If Sc>BVs Then Begin BVs:=Sc; BV:=S; End;
  End Else Begin
   Inc(NA); Sc:=F4S[S].Chans; If F4S[S].Dflt Then Inc(Sc,100000000);
   If Sc>BAs Then Begin BAs:=Sc; BA:=S; End;
  End;
 End;
 If (NV<=1) And (NA<=1) And ((NV=0) Or (NA=0) Or (F4S[0].Typ=0)) Then Exit;
 Tmp[0]:=F4S[0]; Tmp[1]:=F4S[0]; FillChar(Tmp,SizeOf(Tmp),0);
 If BV>=0 Then Tmp[0]:=F4S[BV];
 If BA>=0 Then Tmp[1]:=F4S[BA];
 S:=0;
 If BV>=0 Then Begin F4S[S]:=Tmp[0]; Inc(S); End;
 If BA>=0 Then Begin F4S[S]:=Tmp[1]; Inc(S); End;
 F4NS:=S;
End;

Procedure F4MuxOut(Const Target: String; Webm: Boolean);
Begin
 F4SelectStreams;
 If F4OutNut Then F4MuxNut(Target) Else F4MuxMkv(Target,Webm);
End;

{ ---- lecture d'un fichier entier en memoire ---- }
Function F4RL16(P: PEABuffer; At: LongInt): LongInt;
Begin F4RL16:=P^[At]+P^[At+1]*256; End;
Function F4RL32(P: PEABuffer; At: LongInt): Int64;
Begin F4RL32:=Int64(P^[At])+Int64(P^[At+1])*256+Int64(P^[At+2])*65536+Int64(P^[
 At+3])*16777216; End;
Function F4RB32(P: PEABuffer; At: LongInt): Int64;
Begin F4RB32:=Int64(P^[At+3])+Int64(P^[At+2])*256+Int64(P^[At+1])*65536+Int64(
 P^[At])*16777216; End;
Function F4Tag4(P: PEABuffer; At: LongInt): String;
Begin F4Tag4:=Chr(P^[At])+Chr(P^[At+1])+Chr(P^[At+2])+Chr(P^[At+3]); End;

{ WAV -> flux PCM (wav demuxer de ffmpeg : paquets de 4096 octets alignes sur
 block_align) }
Function F4WavStream(Const Source: String): LongInt;
Var
 F: PEABuffer; Size,At,Sz,FmtAt,DataAt,DataSz,Tag,Ch,Rate,Bits,BA,S,Left,Chunk,
  Pos: LongInt; Cid: String; Tg: String; T: Int64;
 Fmt3: Boolean; N: LongInt;
Begin
 NVLoad(Source,F,Size);
 If (F4Tag4(F,0)<>'RIFF') Or (F4Tag4(F,8)<>'WAVE') Then Fail(
  'wav: en-tete RIFF/WAVE requis.');
 At:=12; FmtAt:=-1; DataAt:=-1; DataSz:=0;
 While At+8<=Size Do Begin
  Tg:=F4Tag4(F,At); Sz:=F4RL32(F,At+4);
  If Tg='fmt ' Then FmtAt:=At+8
  Else If Tg='data' Then Begin DataAt:=At+8; DataSz:=Sz; If DataAt+DataSz>Size
   Then DataSz:=Size-DataAt; Break; End;
  At:=At+8+Sz+(Sz And 1);
 End;
 If (FmtAt<0) Or (DataAt<0) Then Fail('wav: chunks fmt/data requis.');
 Tag:=F4RL16(F,FmtAt); Ch:=F4RL16(F,FmtAt+2); Rate:=F4RL32(F,FmtAt+4); BA:=
  F4RL16(F,FmtAt+12); Bits:=F4RL16(F,FmtAt+14);
 If Tag=$FFFE Then Tag:=F4RL16(F,FmtAt+24);
 Cid:='';
 If Tag=1 Then Begin
  Case Bits Of 8: Cid:='pcm_u8'; 16: Cid:='pcm_s16le'; 24: Cid:='pcm_s24le'; 32:
   Cid:='pcm_s32le'; End;
 End Else If Tag=3 Then Begin
  Case Bits Of 32: Cid:='pcm_f32le'; 64: Cid:='pcm_f64le'; End;
 End;
 If Cid='' Then Fail(
  'wav: format WAV non pris en charge pour Matroska (PCM entier 8/16/24/32 bit'+
  's ou flottant).');
 S:=F4AddStream(1,Cid);
 F4S[S].Rate:=Rate; F4S[S].Chans:=Ch; F4S[S].Bits:=Bits; F4S[S].BlockAlign:=BA;
 F4S[S].TbN:=1; F4S[S].TbD:=Rate; F4S[S].Tag:=Tag;
 If BA<1 Then BA:=1;
 Pos:=0; T:=0;
 While Pos<DataSz Do Begin
  Chunk:=4096;
  If BA>1 Then Begin If Chunk<BA Then Chunk:=BA; Chunk:=(Chunk Div BA)*BA; End;
  If Chunk>DataSz-Pos Then Chunk:=DataSz-Pos;
  N:=Chunk Div BA;
  F4AddPkt(S,@F^[DataAt+Pos],Chunk,T,T,N,True,0,0);
  Inc(T,N); Inc(Pos,Chunk);
 End;
 FreeMem(F);
 F4WavStream:=S;
End;

{ ---- point d'entree : sortie Matroska / WebM ---- }
Function F4EncTagFor(Const Name: String): String;
Begin
 If VGBitExact Or VGCodecBX Then F4EncTagFor:='Lavc '+Name Else F4EncTagFor:=
  'Lavc60.31.102 '+Name;
End;

Procedure F4MkvFromWav(Const Source,Target: String; Webm: Boolean; Const Codec:
 String);
Var S: LongInt;
Begin
 F4Reset;
 S:=F4WavStream(Source);
 If (Codec<>'') And (Codec<>'copy') Then Begin
  If Codec<>F4S[S].Codec Then Fail('Matroska: conversion vers '+Codec+
   ' non prise en charge depuis ce WAV.');
  F4S[S].EncTag:=F4EncTagFor(Codec);
 End;
 F4MuxOut(Target,Webm);
 F4Reset;
End;

Const
 F4BrM1: Array[1..3,0..15] Of Integer = ((0,32,64,96,128,160,192,224,256,288,
  320,352,384,416,448,0),(0,32,48,56,64,80,96,112,128,160,192,224,256,320,384,
  0),(0,32,40,48,56,64,80,96,112,128,160,192,224,256,320,0));
 F4BrM2: Array[1..3,0..15] Of Integer = ((0,32,48,56,64,80,96,112,128,144,160,
  176,192,224,256,0),(0,8,16,24,32,40,48,56,64,80,96,112,128,144,160,0),(0,8,16,
  24,32,40,48,56,64,80,96,112,128,144,160,0));
 F4AacSr: Array[0..12] Of LongInt = (96000,88200,64000,48000,44100,32000,24000,
  22050,16000,12000,11025,8000,7350);
 F4Ac3Br: Array[0..18] Of Integer = (32,40,48,56,64,80,96,112,128,160,192,224,
  256,320,384,448,512,576,640);
 F4Ac3Ch: Array[0..7] Of Integer = (2,1,2,3,3,4,4,5);

Var F4MpaBr: LongInt;
{ en-tete audio MPEG : retourne la taille de trame (0 si invalide) }
Function F4MpaHdr(P: PEABuffer; At,Avail: LongInt; Var Layer,Sr,Ch,Spf,Lsf:
 LongInt): LongInt;
Var B1,B2,B3,Ver,Br,Si,Pad: LongInt;
Begin
 F4MpaHdr:=0;
 If Avail<4 Then Exit;
 If (P^[At]<>$FF) Or ((P^[At+1] And $E0)<>$E0) Then Exit;
 B1:=P^[At+1]; B2:=P^[At+2]; B3:=P^[At+3];
 Ver:=(B1 Shr 3) And 3; Layer:=4-((B1 Shr 1) And 3);
 If (Ver=1) Or (Layer=4) Then Exit;
 Si:=(B2 Shr 2) And 3; If Si=3 Then Exit;
 Br:=B2 Shr 4; If (Br=0) Or (Br=15) Then Exit;
 Pad:=(B2 Shr 1) And 1;
 If Ver=3 Then Begin Lsf:=0; Br:=F4BrM1[Layer,Br]; Case Si Of 0: Sr:=44100; 1:
  Sr:=48000; 2: Sr:=32000; End; End
 Else Begin Lsf:=1; Br:=F4BrM2[Layer,Br]; Case Si Of 0: Sr:=22050; 1: Sr:=24000;
  2: Sr:=16000; End; If Ver=0 Then Sr:=Sr Div 2; End;
 F4MpaBr:=Br;
 If ((B3 Shr 6) And 3)=3 Then Ch:=1 Else Ch:=2;
 If Layer=1 Then Begin Spf:=384; F4MpaHdr:=(12*Br*1000 Div Sr+Pad)*4; End
 Else If Layer=2 Then Begin Spf:=1152; F4MpaHdr:=144*Br*1000 Div Sr+Pad; End
 Else Begin
  If Lsf=0 Then Begin Spf:=1152; F4MpaHdr:=144*Br*1000 Div Sr+Pad; End
  Else Begin Spf:=576; F4MpaHdr:=72*Br*1000 Div Sr+Pad; End;
 End;
End;


{ ---- AVI -> flux (copie de flux vers Matroska) ---- }
Function F4Up(Const S: String): String;
Var I: LongInt; R: String;
Begin R:=S; For I:=1 To Length(R) Do If R[I] In ['a'..'z'] Then R[I]:=Chr(Ord(R[
 I])-32); F4Up:=R; End;

Procedure F4Mpeg4Extra(S: LongInt);
Var D: PEABuffer; N,I: LongInt;
Begin
 If F4S[S].NPk<1 Then Exit;
 D:=F4S[S].Data; N:=F4S[S].P^[0].Len;
 If N<4 Then Exit;
 If (D^[0]<>0) Or (D^[1]<>0) Or (D^[2]<>1) Or (D^[3]<>$B0) Then Exit;
 For I:=4 To N-4 Do
  If (D^[I]=0) And (D^[I+1]=0) And (D^[I+2]=1) And ((D^[I+3]=$B3) Or (D^[I+
   3]=$B6)) Then Begin
   F4SetExtra(S,@D^[0],I); Exit;
  End;
End;

Procedure F4AviStreams(Const Source: String);
Var
 F: PEABuffer; Size,At,Sz,ListEnd,Movi,MoviEnd,I,NStr,Cur,SAt,SEnd,St,Idx1,
  Idx1N,Ch,P,Q: LongInt;
 Tg,Lt,Fcc,Hnd,Typ,Cd: String; Info: Array[0..F4MaxSt-1] Of Record
  IsVid: Boolean; Scale,Rate,SampSz,Tag,W,H,Bits,Chans,SRate,BA,ExtAt,ExtLen,
   Cnt: LongInt; Start: LongInt; AvgB: LongInt; Ok: Boolean; Pos: Int64; Cid:
   String[24];
 End;
 Sid: LongInt; Keys: PEABuffer; NKey: LongInt; G: Int64; K: Boolean; Dur: Int64;
  Gn,Gd: Int64;
 StrmOf: Array[0..F4MaxSt-1] Of LongInt; NS0: LongInt; Fl: LongInt; Xl,Xs,Xc,Xf,
  Xg,K2: LongInt;
Procedure Strl(A,E: LongInt);
Var Aa,Sz2,StrhAt,StrfAt,StrfSz: LongInt; T2: String;
Begin
 StrhAt:=-1; StrfAt:=-1; StrfSz:=0; Aa:=A;
 While Aa+8<=E Do Begin
  T2:=F4Tag4(F,Aa); Sz2:=F4RL32(F,Aa+4);
  If T2='strh' Then StrhAt:=Aa+8 Else If T2='strf' Then Begin StrfAt:=Aa+8;
   StrfSz:=Sz2; End;
  Aa:=Aa+8+Sz2+(Sz2 And 1);
 End;
 If (StrhAt<0) Or (StrfAt<0) Or (NStr>=F4MaxSt) Then Begin Inc(NStr); Exit; End;
 With Info[NStr] Do Begin
  Typ:=F4Tag4(F,StrhAt); Hnd:=F4Tag4(F,StrhAt+4);
  Scale:=F4RL32(F,StrhAt+20); Rate:=F4RL32(F,StrhAt+24); Start:=F4RL32(F,StrhAt+
   28); SampSz:=F4RL32(F,StrhAt+44);
  ExtAt:=-1; ExtLen:=0; Cnt:=0; Pos:=0; Ok:=False; IsVid:=Typ='vids';
  If IsVid Then Begin
   W:=F4RL32(F,StrfAt+4); H:=F4RL32(F,StrfAt+8); If H<0 Then H:=-H; Bits:=
    F4RL16(F,StrfAt+14); Tag:=F4RL32(F,StrfAt+16);
   If StrfSz>40 Then Begin ExtAt:=StrfAt+40; ExtLen:=StrfSz-40; End;
   Ok:=True;
  End Else If Typ='auds' Then Begin
   AvgB:=F4RL32(F,StrfAt+8); Tag:=F4RL16(F,StrfAt); Chans:=F4RL16(F,StrfAt+2);
    SRate:=F4RL32(F,StrfAt+4); BA:=F4RL16(F,StrfAt+12); Bits:=F4RL16(F,StrfAt+
    14);
   If StrfSz>=18 Then Begin Sz2:=F4RL16(F,StrfAt+16); If Sz2>0 Then Begin
    ExtAt:=StrfAt+18; ExtLen:=Sz2; End; End;
   Ok:=True;
  End;
 End;
 Inc(NStr);
End;
Procedure Hdrl(A,E: LongInt);
Var Aa,Sz2: LongInt; T2,L2: String;
Begin
 Aa:=A;
 While Aa+8<=E Do Begin
  T2:=F4Tag4(F,Aa); Sz2:=F4RL32(F,Aa+4);
  If (T2='LIST') And (F4Tag4(F,Aa+8)='strl') Then Strl(Aa+12,Aa+8+Sz2);
  Aa:=Aa+8+Sz2+(Sz2 And 1);
 End;
End;
Begin
 NVLoad(Source,F,Size);
 If (F4Tag4(F,0)<>'RIFF') Or (F4Tag4(F,8)<>'AVI ') Then Fail(
  'avi: en-tete RIFF AVI requis.');
 NStr:=0; Movi:=-1; MoviEnd:=0; Idx1:=-1; Idx1N:=0;
 At:=12;
 While At+8<=Size Do Begin
  Tg:=F4Tag4(F,At); Sz:=F4RL32(F,At+4);
  If Tg='LIST' Then Begin
   Lt:=F4Tag4(F,At+8);
   If Lt='hdrl' Then Hdrl(At+12,At+8+Sz)
   Else If Lt='INFO' Then Begin
    Q:=At+12;
    While Q+8<=At+8+Sz Do Begin
     Tg:=F4Tag4(F,Q); I:=F4RL32(F,Q+4);
     If Q+8+I>Size Then Break;
     Cd:=''; For Xs:=0 To I-1 Do If (F^[Q+8+Xs]<>0) And (Length(Cd)<119) Then
      Cd:=Cd+Chr(F^[Q+8+Xs]);
     Fcc:='';
     If Tg='ISFT' Then Fcc:='software' Else If Tg='INAM' Then Fcc:='title' Else
      If Tg='IART' Then Fcc:='artist' Else If Tg='ICMT' Then Fcc:='comment'
     Else If Tg='ICOP' Then Fcc:='copyright' Else If Tg='ICRD' Then Fcc:='date'
      Else If Tg='IGNR' Then Fcc:='genre' Else If Tg='IPRD' Then Fcc:='product'
     Else If Tg='ISBJ' Then Fcc:='subject' Else If Tg='ISRC' Then Fcc:='source'
      Else If Tg='IENG' Then Fcc:='engineer' Else If Tg='IKEY' Then Fcc:=
      'keywords'
     Else If Tg='ITCH' Then Fcc:='technician' Else If Tg='IARL' Then Fcc:=
      'archival_location' Else If Tg='IMED' Then Fcc:='medium';
     If Fcc<>'' Then F4GAdd(Fcc,Cd);
     Q:=Q+8+I+(I And 1);
    End;
   End
   Else If (Lt='movi') And (Movi<0) Then Begin Movi:=At+12; MoviEnd:=At+8+Sz; If
    MoviEnd>Size Then MoviEnd:=Size; End;
  End Else If (Tg='idx1') And (Idx1<0) Then Begin Idx1:=At+8; Idx1N:=Sz Div 16;
   End;
  At:=At+8+Sz+(Sz And 1);
 End;
 If (NStr=0) Or (Movi<0) Then Fail('avi: structure incorrecte.');
 NS0:=0;
 For I:=0 To NStr-1 Do Begin
  StrmOf[I]:=-1;
  If I>=F4MaxSt Then Break;
  With Info[I] Do If Ok Then Begin
   If IsVid Then Begin
    Fcc:=F4Up(Chr(Tag And 255)+Chr((Tag Shr 8) And 255)+Chr((Tag Shr 16) And
     255)+Chr((Tag Shr 24) And 255));
    Cid:='';
    If (Fcc='FMP4') Or (Fcc='DIVX') Or (Fcc='DX50') Or (Fcc='XVID') Or (
     Fcc='MP4V') Or (Fcc='FVFW') Then Cid:='mpeg4'
    Else If (Fcc='MP43') Or (Fcc='DIV3') Or (Fcc='COL1') Then Cid:='msmpeg4v3'
    Else If Fcc='MP42' Then Cid:='msmpeg4v2' Else If Fcc='MPG4' Then Cid:=
     'msmpeg4v1'
    Else If (Fcc='MJPG') Or (Fcc='AVRN') Then Cid:='mjpeg'
    Else If Fcc='FFV1' Then Cid:='ffv1' Else If Fcc='HFYU' Then Cid:='huffyuv'
     Else If Fcc='FFVH' Then Cid:='ffvhuff'
    Else If Fcc='FLV1' Then Cid:='flv1' Else If Fcc='H263' Then Cid:='h263'
    Else If (Fcc='I420') Or (Fcc='IYUV') Or (Fcc='YV12') Or (Fcc='Y42B') Or (
     Fcc='422P') Or (Fcc='Y41B') Or (Fcc='411P') Or (Fcc='Y800') Or (Fcc='GREY')
     Or (Fcc='Y8  ') Or (Fcc='YUY2') Or (Fcc='YUYV') Or (Fcc='Y422') Or (
     Fcc='UYVY') Or (Fcc='RGBA') Or (Fcc='BGRA') Or (Fcc='ABGR') Or (Fcc='ARGB')
     Or (Fcc='Y444') Or (Fcc='444P') Or (Fcc='YVU9') Or (Fcc='440P') Or (
     Fcc=#0#0#0#0) Then Cid:='rawvideo';
    If Cid='' Then Fail('Matroska: codec video AVI '+Fcc+
     ' non pris en charge pour la copie.');
    St:=F4AddStream(0,Cid);
    F4S[St].Tag:=Tag; F4S[St].W:=W; F4S[St].H:=H; F4S[St].Bits:=Bits; F4S[
     St].SarN:=1; F4S[St].SarD:=1;
    G:=F4Gcd(Rate,Scale); If G=0 Then G:=1;
    F4S[St].AvgN:=Rate Div G; F4S[St].AvgD:=Scale Div G; F4S[St].RN:=F4S[
     St].AvgN; F4S[St].RD:=F4S[St].AvgD;
    F4S[St].TbN:=Scale Div G; F4S[St].TbD:=Rate Div G; F4S[St].PixFmt:=
     'yuv420p';
    If Cid='mpeg4' Then F4S[St].ChromaLoc:=1
    Else If Cid='mjpeg' Then Begin F4S[St].ChromaLoc:=2; F4S[St].CRange:=2; F4S[
     St].CSpace:=5; End
    Else If Cid='h263' Then F4S[St].ChromaLoc:=2;
    If Cid='huffyuv' Then F4S[St].PixFmt:='yuv422p';
    If (ExtLen>0) And (Cid<>'mpeg4') Then F4SetExtra(St,@F^[ExtAt],ExtLen);
   End Else Begin
    Cid:='';
    Case Tag Of
     1: Case Bits Of 8: Cid:='pcm_u8'; 16: Cid:='pcm_s16le'; 24: Cid:=
      'pcm_s24le'; 32: Cid:='pcm_s32le'; End;
     3: If Bits=32 Then Cid:='pcm_f32le' Else If Bits=64 Then Cid:='pcm_f64le';
     $50: Cid:='mp2'; $55: Cid:='mp3'; $2000: Cid:='ac3'; $FF: Cid:='aac';
      $F1AC: Cid:='flac';
    End;
    If Cid='' Then Fail(
     'Matroska: codec audio AVI non pris en charge pour la copie.');
    St:=F4AddStream(1,Cid);
    F4S[St].Tag:=Tag; F4S[St].Rate:=SRate; F4S[St].Chans:=Chans; F4S[
     St].BlockAlign:=BA; F4S[St].BitRate:=AvgB*8; If (Cid='mp3') Or (Cid='ac3')
     Or (Cid='aac') Or (Cid='flac') Then F4S[St].BlockAlign:=0;
    If Copy(Cid,1,4)='pcm_' Then F4S[St].Bits:=Bits Else If Cid='mp2' Then F4S[
     St].Bits:=16 Else F4S[St].Bits:=32;
    G:=F4Gcd(Rate,Scale); If G=0 Then G:=1;
    F4S[St].TbN:=Scale Div G; F4S[St].TbD:=Rate Div G;
    If ExtLen>0 Then F4SetExtra(St,@F^[ExtAt],ExtLen);
    If (SampSz>0) And (F4S[St].TbN<>1) Then Begin F4S[St].TbN:=Scale; End;
   End;
   StrmOf[I]:=St; Inc(NS0);
  End;
 End;
 { cles d'apres idx1 : une entree par morceau, dans l'ordre }
 GetMem(Keys,Idx1N+16); NKey:=0;
 For I:=0 To Idx1N-1 Do Begin
  Fl:=F4RL32(F,Idx1+I*16+4); If (Fl And $10)<>0 Then Keys^[I]:=1 Else Keys^[I]:=
   0;
 End;
 NKey:=Idx1N;
 { morceaux }
 At:=Movi; Cur:=0;
 While At+8<=MoviEnd Do Begin
  Tg:=F4Tag4(F,At); Sz:=F4RL32(F,At+4);
  If Tg='LIST' Then Begin At:=At+12; Continue; End;
  If (Tg[1] In ['0'..'9']) And (Tg[2] In ['0'..'9']) And ((Tg[3]='d') Or (Tg[
   3]='w')) Then Begin
   Sid:=(Ord(Tg[1])-48)*10+Ord(Tg[2])-48;
   If (Sid<NStr) And (Sid<F4MaxSt) And (StrmOf[Sid]>=0) Then Begin
    St:=StrmOf[Sid];
    If At+8+Sz>Size Then Sz:=Size-At-8;
    K:=True;
    If (Idx1>=0) And (Cur<NKey) And (F4S[St].Typ=0) Then K:=Keys^[Cur]=1;
    Inc(Cur);
    If (F4S[St].Codec='h263') Or (Sz=0) Then K:=True; { observe : ffmpeg marque
     toutes les images h263 AVI comme cles }
    If F4S[St].Typ=0 Then Begin
     F4AddPkt(St,@F^[At+8],Sz,Info[Sid].Cnt,Info[Sid].Cnt,1,K,0,0); Inc(Info[
      Sid].Cnt);
    End Else Begin
     If Info[Sid].SampSz>0 Then Begin
      Q:=Info[Sid].SampSz; If Q>1 Then Begin If Q<32 Then Q:=1024*Q; End Else
       Q:=Sz+1;
      P:=0;
      While P<Sz Do Begin
       Ch:=Q; If Ch>Sz-P Then Ch:=Sz-P;
       Dur:=Ch Div Info[Sid].SampSz;
       F4AddPkt(St,@F^[At+8+P],Ch,Info[Sid].Pos,Info[Sid].Pos,Dur,True,0,0);
        Inc(Info[Sid].Pos,Dur);
       Inc(P,Ch);
      End;
     End Else Begin
      F4AddPkt(St,@F^[At+8],Sz,Info[Sid].Cnt,Info[Sid].Cnt,1,True,0,0); Inc(
       Info[Sid].Cnt);
     End;
    End;
   End Else If Sid<F4MaxSt Then Inc(Cur);
  End;
  At:=At+8+Sz+(Sz And 1);
 End;
 FreeMem(Keys); FreeMem(F);
 For I:=0 To F4NS-1 Do If F4S[I].Codec='mpeg4' Then F4Mpeg4Extra(I);
 { audio+video, mp3 sans debit moyen : debit estime par ffmpeg = octets / duree
  de (n-1) trames }
 Q:=0; For I:=0 To F4NS-1 Do If F4S[I].Typ=0 Then Q:=1;
 If Q=1 Then For I:=0 To F4NS-1 Do If (F4S[I].Codec='mp3') And (F4S[
  I].BitRate=0) And (F4S[I].NPk>1) And (F4S[I].Rate>0) Then Begin
  F4S[I].BitRate:=LongInt(F4MulDivR(Int64(F4S[I].DataLen)*8*F4S[I].Rate,1,Int64(
   F4S[I].NPk-1)*F4AudioFrameSamples('mp3',F4S[I].Rate),4));
 End;
 For I:=0 To F4NS-1 Do If ((F4S[I].Codec='mp3') Or (F4S[I].Codec='mp2')) And (
  F4S[I].BitRate=0) And (F4S[I].NPk>0) Then Begin
  Q:=F4MpaHdr(PEABuffer(@F4S[I].Data^[F4S[I].P^[0].Pos]),0,F4S[I].P^[0].Len,Xl,
   Xs,Xc,Xf,Xg);
  If Q>0 Then F4S[I].BitRate:=F4MpaBr*1000;
 End;
End;

Procedure F4MkvFromAvi(Const Source,Target: String; Webm: Boolean);
Begin
 F4Reset;
 F4AviStreams(Source);
 F4MuxOut(Target,Webm);
 F4Reset;
End;

{ ---- flux audio elementaires (mp1/mp2/mp3, ac3, aac ADTS, flac) -> flux
 Matroska ---- }
Procedure F4MpaStream(F: PEABuffer; Size,At0: LongInt);
Var
 At,Fs,Layer,Sr,Ch,Spf,Lsf,S,N,Off,Fl,Frames,V,EndPad,StartPad,TagAt,Tk,Q,Q1,Q2,
  Q3,Q4,Q5: LongInt; Cid: String; Dur,T: Int64; Info: Boolean; Ver: String;
  HaveDelay: Boolean;
 FirstDisc,LastDisc,Smp,Dr,Endp: Int64;
Begin
 At:=At0;
 { cherche la premiere trame }
 While At+4<=Size Do Begin
  Fs:=F4MpaHdr(F,At,Size-At,Layer,Sr,Ch,Spf,Lsf);
  If (Fs>0) And (At+Fs<=Size) Then Begin
   { verifie la trame suivante }
   If (At+Fs+4>Size) Or (F4MpaHdr(F,At+Fs,Size-At-Fs,Q1,Q2,Q3,Q4,Q5)>0) Then
    Break;
  End;
  Inc(At);
 End;
 If At+4>Size Then Fail('Matroska: flux audio MPEG introuvable.');
 Fs:=F4MpaHdr(F,At,Size-At,Layer,Sr,Ch,Spf,Lsf);
 If Layer=1 Then Cid:='mp1' Else If Layer=2 Then Cid:='mp2' Else Cid:='mp3';
 S:=F4AddStream(1,Cid);
 F4S[S].Rate:=Sr; F4S[S].Chans:=Ch; F4S[S].Bits:=32; F4S[S].TbN:=1; F4S[S].TbD:=
  14112000;
 { etiquette Xing / Info }
 Info:=False; Frames:=0; FirstDisc:=0; LastDisc:=0;
 Off:=4; If Lsf=0 Then Begin If Ch=1 Then Inc(Off,17) Else Inc(Off,32); End Else
  Begin If Ch=1 Then Inc(Off,9) Else Inc(Off,17); End;
 If (At+Off+8<=Size) And (((F4Tag4(F,At+Off)='Xing')) Or (F4Tag4(F,At+
  Off)='Info')) Then Begin
  Info:=True; TagAt:=At+Off+4;
  Fl:=F4RB32(F,TagAt); Inc(TagAt,4);
  If (Fl And 1)<>0 Then Begin Frames:=F4RB32(F,TagAt); Inc(TagAt,4); End;
  If (Fl And 2)<>0 Then Inc(TagAt,4);
  If (Fl And 4)<>0 Then Inc(TagAt,100);
  If (Fl And 8)<>0 Then Inc(TagAt,4);
  Ver:=F4Tag4(F,TagAt);
  Inc(TagAt,9+1+1+4+2+2+1+1);
  V:=F^[TagAt]*65536+F^[TagAt+1]*256+F^[TagAt+2];
  If (Ver='LAME') Or (Ver='Lavf') Or (Ver='Lavc') Then Begin
   StartPad:=V Shr 12; EndPad:=V And 4095;
   If Frames>0 Then Begin
    FirstDisc:=-EndPad+528+1+Int64(Frames)*Spf; LastDisc:=Int64(Frames)*Spf;
   End;
  End;
  At:=At+Fs;
  If (Ver='LAME') Or (Ver='Lavf') Or (Ver='Lavc') Then Begin
   { start_time = echantillons ignores en debut, puis ts_offset = -start_time
    (microsecondes) }
   Dr:=F4MulDivR(StartPad+528+1,14112000 Div Sr,1,4);
   Smp:=F4MulDivR(Dr,1000000,14112000,4);
   F4S[S].Off:=F4MulDivR(-Smp,14112000,1000000,4);
  End;
 End;
 T:=0; Dur:=Int64(Spf)*(14112000 Div Sr);
 While At+4<=Size Do Begin
  Fs:=F4MpaHdr(F,At,Size-At,Layer,Sr,Ch,Spf,Lsf);
  If Fs<=0 Then Begin Inc(At); Continue; End;
  If At+Fs>Size Then Fs:=Size-At;
  Endp:=0;
  If FirstDisc<>0 Then Begin
   Smp:=T*Sr Div 14112000; Dr:=Dur*Sr Div 14112000;
   If (Dr>0) And (Smp+Dr>=FirstDisc) And (Smp<LastDisc) Then Begin
    Endp:=Smp+Dr-FirstDisc; If Endp>Dr Then Endp:=Dr;
   End;
  End;
  If T=0 Then F4S[S].BitRate:=F4MpaBr*1000;
  F4AddPkt(S,@F^[At],Fs,T,T,Dur,True,0,LongInt(Endp));
  Inc(T,Dur); Inc(At,Fs);
 End;
End;

Procedure F4Ac3Stream(F: PEABuffer; Size: LongInt);
Var At,Fs,Fscod,Frm,Br,Sr,Acmod,Lfe,S,Ch,Bsid,Bp: LongInt; T,Dur: Int64;
Begin
 At:=0; S:=-1; T:=0;
 While At+8<=Size Do Begin
  If (F^[At]<>$0B) Or (F^[At+1]<>$77) Then Begin Inc(At); Continue; End;
  Fscod:=F^[At+4] Shr 6; Frm:=F^[At+4] And 63; Bsid:=F^[At+5] Shr 3;
  If (Fscod=3) Or (Frm>37) Or (Bsid>10) Then Begin Inc(At); Continue; End;
  Br:=F4Ac3Br[Frm Shr 1];
  Case Fscod Of 0: Sr:=48000; 1: Sr:=44100; Else Sr:=32000; End;
  Fs:=4*Br; If Fscod=2 Then Fs:=6*Br;
  If Fscod=1 Then Fs:=2*((Br*1000*1536 Div (44100*16))+(Frm And 1));
  Acmod:=(F^[At+6] Shr 5);
  If S<0 Then Begin
   Ch:=F4Ac3Ch[Acmod];
   { bit LFE : apres acmod et eventuels mix levels }
   Bp:=3;
   If ((Acmod And 1)<>0) And (Acmod<>1) Then Inc(Bp,2);
   If (Acmod And 4)<>0 Then Inc(Bp,2);
   If Acmod=2 Then Inc(Bp,2);
   Lfe:=(F^[At+6] Shr (7-Bp)) And 1;
   S:=F4AddStream(1,'ac3');
   F4S[S].Rate:=Sr; F4S[S].Bits:=32; F4S[S].TbN:=1; F4S[S].TbD:=90000; F4S[
    S].BitRate:=Br*1000;
   F4S[S].Chans:=Ch+Lfe;
   Dur:=F4MulDivR(1,1536*90000,Sr,0);
  End;
  If At+Fs>Size Then Fs:=Size-At;
  F4AddPkt(S,@F^[At],Fs,T,T,Dur,True,0,0);
  Inc(T,Dur); Inc(At,Fs);
 End;
 If S<0 Then Fail('Matroska: flux AC-3 introuvable.');
End;

Procedure F4AdtsStream(F: PEABuffer; Size: LongInt);
Var At,Fl,Prof,Sri,Chc,S,Hd: LongInt; T,Dur: Int64; Asc: Array[0..1] Of Byte;
 Sr: LongInt;
Begin
 At:=0; S:=-1; T:=0;
 While At+7<=Size Do Begin
  If (F^[At]<>$FF) Or ((F^[At+1] And $F6)<>$F0) Then Begin Inc(At); Continue;
   End;
  Fl:=((F^[At+3] And 3) Shl 11) Or (F^[At+4] Shl 3) Or (F^[At+5] Shr 5);
  If Fl<7 Then Begin Inc(At); Continue; End;
  If (F^[At+1] And 1)=0 Then Hd:=9 Else Hd:=7;
  Prof:=(F^[At+2] Shr 6) And 3; Sri:=(F^[At+2] Shr 2) And 15; Chc:=((F^[At+2]
   And 1) Shl 2) Or (F^[At+3] Shr 6);
  If (Sri>12) Or (Chc=0) Then Begin Inc(At); Continue; End;
  If S<0 Then Begin
   Sr:=F4AacSr[Sri];
   S:=F4AddStream(1,'aac');
   F4S[S].Rate:=Sr; F4S[S].Chans:=Chc; If Chc=7 Then F4S[S].Chans:=8; F4S[
    S].Bits:=32; F4S[S].TbN:=1; F4S[S].TbD:=28224000;
   F4S[S].Adts:=True;
   Dur:=1024*(28224000 Div Sr);
  End;
  If At+Fl>Size Then Fl:=Size-At;
  F4AddPkt(S,@F^[At],Fl,T,T,Dur,True,0,0);
  Inc(T,Dur); Inc(At,Fl);
 End;
 If S<0 Then Fail('Matroska: flux AAC ADTS introuvable.');
End;

Function F4FlacCrc8(P: PEABuffer; At,Len: LongInt): LongInt;
Var C,I,K: LongInt;
Begin
 C:=0;
 For I:=At To At+Len-1 Do Begin
  C:=C Xor P^[I];
  For K:=1 To 8 Do If (C And $80)<>0 Then C:=((C Shl 1) Xor 7) And 255 Else C:=(
   C Shl 1) And 255;
 End;
 F4FlacCrc8:=C;
End;

{ en-tete de trame FLAC : retourne la taille de l'en-tete (0 si invalide) ; Blk
 = taille de bloc }
Function F4FlacHdr(P: PEABuffer; At,Size: LongInt; Var Blk: LongInt): LongInt;
Var B2,B3,Bs,Sr,N,L: LongInt;
Begin
 F4FlacHdr:=0;
 If At+6>Size Then Exit;
 If (P^[At]<>$FF) Or ((P^[At+1] And $FE)<>$F8) Then Exit;
 B2:=P^[At+2]; B3:=P^[At+3];
 If (B3 And 1)<>0 Then Exit;
 Bs:=B2 Shr 4; Sr:=B2 And 15;
 If (Bs=0) Or (Sr=15) Then Exit;
 N:=4;
 If P^[At+4]<$80 Then L:=1 Else If P^[At+4]<$C0 Then Exit Else If P^[At+4]<$E0
  Then L:=2 Else If P^[At+4]<$F0 Then L:=3 Else If P^[At+4]<$F8 Then L:=4 Else
  If P^[At+4]<$FC Then L:=5 Else If P^[At+4]<$FE Then L:=6 Else L:=7;
 Inc(N,L);
 Case Bs Of
  1: Blk:=192;
  2..5: Blk:=576 Shl (Bs-2);
  6: Begin Blk:=P^[At+N]+1; Inc(N); End;
  7: Begin Blk:=P^[At+N]*256+P^[At+N+1]+1; Inc(N,2); End;
  Else Blk:=256 Shl (Bs-8);
 End;
 If Sr=12 Then Inc(N) Else If (Sr=13) Or (Sr=14) Then Inc(N,2);
 If At+N>=Size Then Exit;
 If F4FlacCrc8(P,At,N)<>P^[At+N] Then Exit;
 F4FlacHdr:=N+1;
End;

Procedure F4FlacStream(F: PEABuffer; Size: LongInt);
Var At,Last,Hd,Blk,B2,Nx,S,Rate,Ch,Bps: LongInt; Sinfo: Array[0..33] Of Byte; T:
 Int64; Typ,Len,I: LongInt; Cur,Nb: LongInt;
Begin
 At:=4; Last:=0; Rate:=0;
 Repeat
  If At+4>Size Then Fail('flac: en-tete incorrect.');
  Typ:=F^[At] And 127; Last:=F^[At] Shr 7; Len:=F^[At+1]*65536+F^[At+2]*256+F^[
   At+3];
  If (Typ=0) And (Len>=34) Then Begin
   For I:=0 To 33 Do Sinfo[I]:=F^[At+4+I];
   Rate:=(Sinfo[10] Shl 12) Or (Sinfo[11] Shl 4) Or (Sinfo[12] Shr 4);
   Ch:=((Sinfo[12] Shr 1) And 7)+1;
   Bps:=(((Sinfo[12] And 1) Shl 4) Or (Sinfo[13] Shr 4))+1;
  End;
  Inc(At,4+Len);
 Until Last=1;
 If Rate=0 Then Fail('flac: STREAMINFO absent.');
 S:=F4AddStream(1,'flac');
 F4S[S].Rate:=Rate; F4S[S].Chans:=Ch; F4S[S].Bits:=Bps; F4S[S].TbN:=1; F4S[
  S].TbD:=Rate;
 F4SetExtra(S,@Sinfo[0],34);
 T:=0;
 While At<Size Do Begin
  Hd:=F4FlacHdr(F,At,Size,Blk);
  If Hd=0 Then Begin Inc(At); Continue; End;
  Nx:=At+Hd+2;
  While Nx<Size Do Begin
   If F4FlacHdr(F,Nx,Size,B2)>0 Then Break;
   Inc(Nx);
  End;
  If Nx>Size Then Nx:=Size;
  F4AddPkt(S,@F^[At],Nx-At,T,T,Blk,True,0,0);
  Inc(T,Blk); At:=Nx;
 End;
End;

Procedure F4MkvFromEs(Const Source,Target: String; Webm: Boolean);
Var F: PEABuffer; Size,At: LongInt;
Begin
 F4Reset;
 NVLoad(Source,F,Size);
 At:=0;
 If (Copy(F4Tag4(F,0),1,3)<>'ID3') Then Begin End Else Begin
  At:=10+((F^[6] And 127) Shl 21)+((F^[7] And 127) Shl 14)+((F^[8] And 127) Shl
   7)+(F^[9] And 127);
  If (F^[5] And $10)<>0 Then Inc(At,10);
 End;
 If F4Tag4(F,At)='fLaC' Then F4FlacStream(PEABuffer(@F^[At]),Size-At)
 Else If (F^[At]=$0B) And (F^[At+1]=$77) Then F4Ac3Stream(PEABuffer(@F^[At]),
  Size-At)
 Else If (F^[At]=$FF) And ((F^[At+1] And $F6)=$F0) Then F4AdtsStream(PEABuffer(
  @F^[At]),Size-At)
 Else F4MpaStream(F,Size,At);
 F4MuxOut(Target,Webm);
 F4Reset;
 FreeMem(F);
End;

{ ---- sorties encodees (Y4M -> AVI intermediaire -> Matroska ; WAV -> mp2
 intermediaire -> Matroska) ---- }
Var F4Pending: Boolean; F4Target,F4Kind,F4OutFmt: String; F4WebmOut: Boolean;

{ proprietes d'un flux video d'apres l'en-tete Y4M ffmpeg (yuv4mpegdec.c) }
Procedure F4Y4mProps(Const Path: String; S: LongInt);
Var Hd: Array[0..511] Of Byte; N,I,P: LongInt; L,Tok: String; Fn,Fd: Int64; An,
 Ad: LongInt; Code: Integer; Loc: LongInt; Cstr: String;
Begin
 OpenRead(Path); N:=InputSize; If N>512 Then N:=512; ReadAt(0,Hd,N); CloseRead;
 L:=''; For I:=0 To N-1 Do Begin If Hd[I]=10 Then Break; L:=L+Chr(Hd[I]); End;
 F4S[S].FieldOrder:=0; F4S[S].ChromaLoc:=0; F4S[S].CRange:=0; F4S[S].SarN:=0;
  F4S[S].SarD:=1;
 Loc:=0; Cstr:='';
 P:=Pos(' ',L);
 While P>0 Do Begin
  Delete(L,1,P); P:=Pos(' ',L);
  If P>0 Then Tok:=Copy(L,1,P-1) Else Tok:=L;
  If Tok='' Then Continue;
  Case Tok[1] Of
   'C': Cstr:=Copy(Tok,2,40);
   'I': Begin
     If Tok='Ip' Then F4S[S].FieldOrder:=1 Else If Tok='It' Then F4S[
      S].FieldOrder:=2 Else If Tok='Ib' Then F4S[S].FieldOrder:=3;
    End;
   'A': Begin
     I:=Pos(':',Tok);
     If I>0 Then Begin Val(Copy(Tok,2,I-2),An,Code); Val(Copy(Tok,I+1,20),Ad,
      Code); End;
     If (I>0) And (An>0) And (Ad>0) Then Begin F4S[S].SarN:=An; F4S[S].SarD:=Ad;
      End;
    End;
   'X': Begin
     If Copy(Tok,1,12)='XCOLORRANGE=' Then Begin
      If Copy(Tok,13,4)='FULL' Then F4S[S].CRange:=2 Else If Copy(Tok,13,
       7)='LIMITED' Then F4S[S].CRange:=1;
     End;
    End;
  End;
 End;
 If (Cstr='') Or (Cstr='420') Or (Cstr='420jpeg') Then Loc:=2
 Else If Cstr='420mpeg2' Then Loc:=1
 Else If Cstr='420paldv' Then Loc:=3
 Else Fail(
  'Matroska: seul le Y4M YUV 4:2:0 8 bits est pris en charge pour l''encodage '+
  'vers Matroska.');
 If Cstr='' Then Loc:=0;
 F4S[S].ChromaLoc:=Loc;
End;

Function F4CommitStage(Const Stage: String): String;
Var Tmp: String; S,K,N,Data,Hd: LongInt; F: PEABuffer; Size: LongInt; Sr:
 LongInt; Dur: Int64; T: Int64;
Begin
 F4Pending:=False;
 Tmp:=NewTemporary; Temps[4]:=Tmp;
 F4Reset;
 If F4Kind='mp2' Then Begin
  F4WavStream(InputPath); { lit les echantillons d'entree pour la derniere duree
   }
  N:=0; For K:=0 To F4S[0].NPk-1 Do Inc(N,LongInt(F4S[0].P^[K].Dur));
  F4Reset;
  NVLoad(Stage,F,Size);
  F4MpaStream(F,Size,0);
  FreeMem(F);
  Sr:=F4S[0].Rate;
  F4S[0].Bits:=16; F4S[0].InitPad:=481; F4S[0].Off:=-481*(14112000 Div Sr);
  F4S[0].EncTag:=F4EncTagFor('mp2');
  { durees : 1152 echantillons sauf le dernier paquet }
  For K:=0 To F4S[0].NPk-1 Do Begin
   Dur:=1152; If N-Int64(K)*1152<Dur Then Dur:=N-Int64(K)*1152;
   F4S[0].P^[K].Dur:=Dur*(14112000 Div Sr);
  End;
 End Else Begin
  F4AviStreams(Stage); F4GN:=0;
  F4Y4mProps(InputPath,0);
  If (F4Kind='mpeg4') And (F4S[0].ExtraLen>0) And (F4S[0].NPk>0) Then Begin
   Inc(F4S[0].P^[0].Pos,F4S[0].ExtraLen); Dec(F4S[0].P^[0].Len,F4S[0].ExtraLen);
  End;
  If F4Kind='msmpeg4' Then F4S[0].EncTag:=F4EncTagFor('msmpeg4') Else F4S[
   0].EncTag:=F4EncTagFor(F4Kind);
  If F4Kind='huffyuv' Then F4S[0].CRange:=1;
  F4S[0].Dflt:=False;
 End;
 F4MuxOut(Tmp,F4WebmOut);
 F4Reset;
 OutputPath:=F4Target; OutputFormat:=F4OutFmt;
 F4CommitStage:=Tmp;
End;

{ ---- demuxeur Matroska/WebM generique : conversion vers un AVI/flux
 elementaire temporaire, puis decodeurs existants ---- }
Procedure F4MkRational(Var Rate,Scale: LongInt; Fps: Double);
Var N: LongInt; R: Double;
Begin
 Rate:=Round(Fps*1000); Scale:=1000;
 R:=Round(Fps);
 If (R>0) And (Abs(Fps-R)<0.0005*R) Then Begin Rate:=Round(R); Scale:=1; Exit;
  End;
 N:=Round(Fps*1001);
 If (N>0) And (Abs(N/1001.0-Fps)<0.000002*Fps) Then Begin Rate:=N; Scale:=1001;
  Exit; End;
End;

Function F4MkFourcc(Const C: String; Var Fcc: String; Var Vfw: Boolean):
 Boolean;
Begin
 Vfw:=False; F4MkFourcc:=True;
 If C='V_MPEG4/ISO/ASP' Then Fcc:='FMP4' Else If (C='V_MPEG4/ISO/SP') Or (
  C='V_MPEG4/ISO/AP') Then Fcc:='FMP4'
 Else If C='V_MPEG4/MS/V3' Then Fcc:='MP43'
 Else If C='V_MJPEG' Then Fcc:='MJPG'
 Else If C='V_FFV1' Then Fcc:='FFV1'
 Else If C='V_MPEG4/ISO/AVC' Then Fcc:='H264'
 Else If C='V_MS/VFW/FOURCC' Then Vfw:=True
 Else F4MkFourcc:=False;
End;

Procedure F4MkWriteWav(Rate,Ch,Bits,Fl: LongInt; Const Tmp: String; T: LongInt);
Var I,K,L,Tot: LongInt; H: Array[0..43] Of Byte; V: LongInt; Ba: LongInt;
Procedure P32(At,X: LongInt);Begin H[At]:=X And 255; H[At+1]:=(X Shr 8) And 255;
 H[At+2]:=(X Shr 16) And 255; H[At+3]:=(X Shr 24) And 255; End;
Procedure P16(At,X: LongInt);Begin H[At]:=X And 255; H[At+1]:=(X Shr 8) And 255;
 End;
Begin
 Tot:=0; For I:=0 To MKNPk-1 Do If MKPkTr^[I]=T Then Inc(Tot,MKPkLen^[I]);
 Ba:=Ch*(Bits Div 8);
 H[0]:=82; H[1]:=73; H[2]:=70; H[3]:=70; P32(4,36+Tot); H[8]:=87; H[9]:=65; H[
  10]:=86; H[11]:=69;
 H[12]:=102; H[13]:=109; H[14]:=116; H[15]:=32; P32(16,16); P16(20,Fl); P16(22,
  Ch); P32(24,Rate); P32(28,Rate*Ba); P16(32,Ba); P16(34,Bits);
 H[36]:=100; H[37]:=97; H[38]:=116; H[39]:=97; P32(40,Tot);
 OpenWrite(Tmp); WriteBytes(H,44);
 For I:=0 To MKNPk-1 Do If MKPkTr^[I]=T Then Begin
  K:=0; L:=MKPkLen^[I];
  While K<L Do Begin
   V:=L-K; If V>32768 Then V:=32768;
   WriteBytes(MKF^[MKPkPos^[I]+K],V); Inc(K,V);
  End;
 End;
 CloseWrite;
End;

Var F4TrimN: LongInt;
{ coupe les derniers echantillons (DiscardPadding) d'un WAV PCM 16 bits en place
 }
Procedure F4TrimWav(Const Path: String);
Var F: File; Hd: Array[0..511] Of Byte; N,Code: Integer; Actual: LongInt; I,Dat,
 Ba,Tot: LongInt; Sz: LongInt;
Begin
 If OutputFormat<>'wav' Then Exit;
 Assign(F,Path); {$I-}Reset(F,1); Code:=IOResult;{$I+}
 If Code<>0 Then Exit;
 Sz:=FileSize(F);
 If Sz<64 Then Begin Close(F); Exit; End;
 If Sz>512 Then Actual:=512 Else Actual:=Sz;
 BlockRead(F,Hd,Actual);
 Dat:=-1; Ba:=2;
 I:=12;
 While I+8<=Actual Do Begin
  If (Hd[I]=102) And (Hd[I+1]=109) And (Hd[I+2]=116) Then Ba:=Hd[I+20]+Hd[I+21]*
   256;
  If (Hd[I]=100) And (Hd[I+1]=97) And (Hd[I+2]=116) And (Hd[I+3]=97) Then Begin
   Dat:=I; Break; End;
  I:=I+8+Hd[I+4]+Hd[I+5]*256+Hd[I+6]*65536+Hd[I+7]*16777216;
 End;
 If Dat<0 Then Begin Close(F); Exit; End;
 Tot:=Hd[Dat+4]+Hd[Dat+5]*256+Hd[Dat+6]*65536+Hd[Dat+7]*16777216;
 If Tot>Sz-Dat-8 Then Tot:=Sz-Dat-8;
 Tot:=Tot-F4TrimN*Ba; If Tot<0 Then Tot:=0;
 Seek(F,Dat+4); Hd[0]:=Tot And 255; Hd[1]:=(Tot Shr 8) And 255; Hd[2]:=(Tot Shr
  16) And 255; Hd[3]:=(Tot Shr 24) And 255;
 BlockWrite(F,Hd,4);
 Seek(F,4); Tot:=Dat+8+Tot-8+0; Hd[0]:=Tot And 255; Hd[1]:=(Tot Shr 8) And 255;
  Hd[2]:=(Tot Shr 16) And 255; Hd[3]:=(Tot Shr 24) And 255;
 BlockWrite(F,Hd,4);
 Seek(F,Dat+8+(Tot-Dat)); Truncate(F);
 Close(F);
End;

Procedure F4MkvDemux(Var Inter: String);
Var
 I,T,Vt,At,Cnt,Rate,Scale,W,H,Bpp,ExtP,ExtL,K,L,Sr,Sri,Prof,Ch,Hd: LongInt; Fcc,
  Cd,Tmp,Kind: String; Vfw,IsVid: Boolean; Fps,Dd: Double;
 First,Last: Int64; Buf: PEABuffer; N,Q,Ps,Ns,Nl: LongInt; B7: Array[0..8] Of
  Byte; Ext: PEABuffer; Fl: LongInt;
Begin
 If InputFormat='nut' Then Begin F4NutDemux(Inter); Exit; End;
 If Not ((OutputFormat='yuv4mpegpipe') Or (OutputFormat='png') Or (
  OutputFormat='bmp') Or (OutputFormat='wav') Or (OutputFormat='mp3') Or
  (OutputFormat='mp2') Or (OutputFormat='ac3') Or (OutputFormat='aac') Or (
   OutputFormat='aiff') Or (OutputFormat='ogg') Or (OutputFormat='adx')) Then
   Exit;
 IsVid:=(OutputFormat='yuv4mpegpipe') Or (OutputFormat='png') Or (
  OutputFormat='bmp');
 MKParse(InputPath);
 T:=-1;
 For I:=0 To MKNTr-1 Do If (T<0) And (((MKTr[I].Typ=1) And IsVid) Or ((MKTr[
  I].Typ=2) And Not IsVid)) Then T:=I;
 If T<0 Then Begin MKFree; Exit; End;
 If MKTr[T].Enc Then Fail(
  'matroska: ContentEncodings (compression/chiffrement) non pris en charge.');
 Cd:=MKTr[T].Codec;
 If (Cd='V_THEORA') Or (Cd='A_VORBIS') Or (Copy(Cd,1,5)='V_VP9') Or (
  Cd='A_OPUS') Then Begin MKFree; Exit; End;
 Tmp:=NewTemporary; Temps[5]:=Tmp;
 If IsVid Then Begin
  If Not F4MkFourcc(Cd,Fcc,Vfw) Then Fail('matroska: codec video '+Cd+
   ' non pris en charge.');
  W:=MKTr[T].W; H:=MKTr[T].H; Bpp:=24; ExtP:=-1; ExtL:=0;
  If Vfw Then Begin
   If MKTr[T].PrivLen<40 Then Fail('matroska: BITMAPINFOHEADER absent.');
   Fcc:=Chr(MKB(MKTr[T].PrivPos+16))+Chr(MKB(MKTr[T].PrivPos+17))+Chr(MKB(MKTr[
    T].PrivPos+18))+Chr(MKB(MKTr[T].PrivPos+19));
   Bpp:=MKB(MKTr[T].PrivPos+14)+MKB(MKTr[T].PrivPos+15)*256; If Bpp=0 Then Bpp:=
    24;
   If MKTr[T].PrivLen>40 Then Begin ExtP:=MKTr[T].PrivPos+40; ExtL:=MKTr[
    T].PrivLen-40; End;
  End Else If (Cd='V_FFV1') And (MKTr[T].PrivLen>0) Then Begin ExtP:=MKTr[
   T].PrivPos; ExtL:=MKTr[T].PrivLen; End;
  F4YRange:='';
  For I:=0 To 16000 Do If (I+3<MKSize) And (MKB(I)=$55) And (MKB(I+1)=$B9) And (
   MKB(I+2)=$81) Then Begin
   If MKB(I+3)=1 Then F4YRange:=' XCOLORRANGE=LIMITED' Else If MKB(I+3)=2 Then
    F4YRange:=' XCOLORRANGE=FULL';
   Break;
  End;
  { cadence }
  Cnt:=0; First:=0; Last:=0;
  For I:=0 To MKNPk-1 Do If MKPkTr^[I]=T Then Begin
   If Cnt=0 Then First:=MKPkPts^[I]; Last:=MKPkPts^[I]; Inc(Cnt);
  End;
  If MKTr[T].DefDur>0 Then Fps:=1.0e9/MKTr[T].DefDur
  Else If (Cnt>1) And (Last>First) Then Begin Dd:=Last-First; Fps:=(Cnt-1)*(
   1.0e9/MKScale)/Dd; End
  Else Fps:=25;
  F4MkRational(Rate,Scale,Fps);
  { Ext : extradata pour FFV1/VFW ; pour mpeg4 l'en-tete (CodecPrivate) est
   prefixe au premier paquet }
  If ExtL>0 Then Begin GetMem(Ext,ExtL+16); Move(MKF^[ExtP],Ext^,ExtL); End Else
   Ext:=Nil;
  AWBegin(Tmp,Fcc,W,H,Rate,Scale,Bpp,Ext,ExtL);
  First:=0;
  For I:=0 To MKNPk-1 Do If MKPkTr^[I]=T Then Begin
   L:=MKPkLen^[I]; Q:=0;
   If (First=0) And (Cd='V_MPEG4/ISO/ASP') And (MKTr[T].PrivLen>0) Then Q:=MKTr[
    T].PrivLen;
   If Cd='V_MPEG4/ISO/AVC' Then Begin
    { avcC + paquets a longueurs -> Annex B }
    GetMem(Buf,L*2+MKTr[T].PrivLen*2+64); Q:=0;
    If (First=0) And (MKTr[T].PrivLen>=7) Then Begin
     Ps:=MKTr[T].PrivPos+5; Ns:=MKB(Ps) And 31; Inc(Ps);
     For K:=1 To Ns Do Begin
      N:=MKB(Ps)*256+MKB(Ps+1); Inc(Ps,2); Buf^[Q]:=0; Buf^[Q+1]:=0; Buf^[Q+2]:=
       0; Buf^[Q+3]:=1; Inc(Q,4);
      Move(MKF^[Ps],Buf^[Q],N); Inc(Q,N); Inc(Ps,N);
     End;
     Ns:=MKB(Ps); Inc(Ps);
     For K:=1 To Ns Do Begin
      N:=MKB(Ps)*256+MKB(Ps+1); Inc(Ps,2); Buf^[Q]:=0; Buf^[Q+1]:=0; Buf^[Q+2]:=
       0; Buf^[Q+3]:=1; Inc(Q,4);
      Move(MKF^[Ps],Buf^[Q],N); Inc(Q,N); Inc(Ps,N);
     End;
    End;
    Nl:=(MKB(MKTr[T].PrivPos+4) And 3)+1; Ps:=0;
    While Ps+Nl<=L Do Begin
     N:=0; For K:=0 To Nl-1 Do N:=N*256+MKB(MKPkPos^[I]+Ps+K);
     Inc(Ps,Nl); If (N<0) Or (Ps+N>L) Then Break;
     Buf^[Q]:=0; Buf^[Q+1]:=0; Buf^[Q+2]:=0; Buf^[Q+3]:=1; Inc(Q,4);
     Move(MKF^[MKPkPos^[I]+Ps],Buf^[Q],N); Inc(Q,N); Inc(Ps,N);
    End;
    AWFrame(Buf,Q); FreeMem(Buf);
   End Else Begin
   GetMem(Buf,L+Q+16);
   If Q>0 Then Move(MKF^[MKTr[T].PrivPos],Buf^,Q);
   Move(MKF^[MKPkPos^[I]],Buf^[Q],L);
   AWFrame(Buf,L+Q); FreeMem(Buf);
   End;
   Inc(First);
  End;
  AWEnd;
  Kind:='avi';
 End Else Begin
  Sr:=Round(MKTr[T].Rate); Ch:=MKTr[T].Ch;
  F4TrimN:=0;
  For I:=0 To MKNPk-1 Do If (MKPkTr^[I]=T) And (MKPkDisc^[I]>0) Then Inc(
   F4TrimN,LongInt((MKPkDisc^[I]*Sr+500000000) Div 1000000000));
  If Cd='A_MPEG/L3' Then Kind:='mp3' Else If Cd='A_MPEG/L2' Then Kind:='mp2'
   Else If Cd='A_MPEG/L1' Then Kind:='mp1'
  Else If Cd='A_AC3' Then Kind:='ac3' Else If Cd='A_EAC3' Then Kind:='eac3'
  Else If Cd='A_AAC' Then Kind:='aac' Else If Cd='A_FLAC' Then Kind:='flac'
  Else If Cd='A_PCM/INT/LIT' Then Kind:='wav' Else If Cd='A_PCM/FLOAT/IEEE' Then
   Kind:='wavf'
  Else Fail('matroska: codec audio '+Cd+' non pris en charge.');
  If (Kind='wav') Or (Kind='wavf') Then Begin
   Bpp:=0; Cnt:=0;
   For I:=0 To MKNPk-1 Do If MKPkTr^[I]=T Then Begin
    If Cnt=0 Then Begin Bpp:=0; End; Inc(Cnt);
   End;
   { profondeur : lue dans la piste (BitDepth) ; on la retrouve par le
    CodecPrivate absent -> element 6264 }
   Bpp:=MKTr[T].Bits;
   If Bpp=0 Then Bpp:=16;
   If Kind='wavf' Then Fl:=3 Else Fl:=1;
   F4MkWriteWav(Sr,Ch,Bpp,Fl,Tmp,T);
   Kind:='wav';
  End Else Begin
   OpenWrite(Tmp);
   If Kind='flac' Then Begin
    If MKTr[T].PrivLen>0 Then WriteBytes(MKF^[MKTr[T].PrivPos],MKTr[T].PrivLen);
   End;
   Sri:=-1; Prof:=1;
   If Kind='aac' Then Begin
    If MKTr[T].PrivLen<2 Then Fail('matroska: AudioSpecificConfig AAC absent.');
    Prof:=(MKB(MKTr[T].PrivPos) Shr 3)-1;
    Sri:=((MKB(MKTr[T].PrivPos) And 7) Shl 1) Or (MKB(MKTr[T].PrivPos+1) Shr 7);
    Ch:=(MKB(MKTr[T].PrivPos+1) Shr 3) And 15;
   End;
   For I:=0 To MKNPk-1 Do If MKPkTr^[I]=T Then Begin
    L:=MKPkLen^[I];
    If Kind='aac' Then Begin
     N:=L+7;
     B7[0]:=$FF; B7[1]:=$F1; B7[2]:=((Prof And 3) Shl 6) Or (Sri Shl 2) Or ((Ch
      Shr 2) And 1);
     B7[3]:=((Ch And 3) Shl 6) Or ((N Shr 11) And 3); B7[4]:=(N Shr 3) And 255;
      B7[5]:=((N And 7) Shl 5) Or $1F; B7[6]:=$FC;
     WriteBytes(B7,7);
    End;
    K:=0;
    While K<L Do Begin
     Q:=L-K; If Q>32768 Then Q:=32768;
     WriteBytes(MKF^[MKPkPos^[I]+K],Q); Inc(K,Q);
    End;
   End;
   CloseWrite;
  End;
 End;
 MKFree;
 Inter:=Tmp; InputPath:=Tmp; InputFormat:=Kind;
End;

{ ---- muxeur NUT (nutenc.c / nut.c) ---- }
Type
 TF4NFc=Record Flags,Sid,Mul,Lsb,Pd,Hi: LongInt; End;
 TF4NSt=Record Tb,Shift,MaxD,LastFlags,KfN: LongInt; LastPts: Int64; Kf:
  PEABuffer; Cur: LongInt; End;
Var
 F4NFc: Array[0..255] Of TF4NFc;
 F4NHLen: Array[0..7] Of LongInt; F4NH: Array[0..7,0..4] Of Byte; F4NHCount:
  LongInt;
 F4NTbN,F4NTbD: Array[0..15] Of Int64; F4NTbC: LongInt;
 F4NSt: Array[0..F4MaxSt-1] Of TF4NSt;
 F4NOut: TF4B;
 F4NSpA: PEABuffer; F4NSpN,F4NSpCap: LongInt;
 F4NLastSp: Int64; F4NMaxPts: Int64; F4NMaxTb: LongInt;
 F4NIdxPos: Array[0..F4MaxSt-1] Of PEABuffer; F4NIdxN,F4NIdxCap: Array[
  0..F4MaxSt-1] Of LongInt;
 F4NCrcT: Array[0..255] Of LongWord; F4NCrcOk: Boolean;

Procedure F4NCrcInit;
Var I,K: LongInt; C: LongWord;
Begin
 For I:=0 To 255 Do Begin
  C:=LongWord(I) Shl 24;
  For K:=1 To 8 Do If (C And $80000000)<>0 Then C:=(C Shl 1) Xor $04C11DB7 Else
   C:=C Shl 1;
  F4NCrcT[I]:=C;
 End;
 F4NCrcOk:=True;
End;
Function F4NCrc(P: PEABuffer; Start,Len: LongInt): LongWord;
Var I: LongInt; C: LongWord;
Begin
 If Not F4NCrcOk Then F4NCrcInit;
 C:=0;
 For I:=Start To Start+Len-1 Do C:=(C Shl 8) Xor F4NCrcT[((C Shr 24) Xor P^[I])
  And 255];
 F4NCrc:=C;
End;

Function F4NVLen(V: QWord): LongInt;
Var I: LongInt;
Begin I:=1; V:=V Shr 7; While V<>0 Do Begin Inc(I); V:=V Shr 7; End; F4NVLen:=I;
 End;
Procedure F4NPutV(Var B: TF4B; V: QWord);
Var I: LongInt;
Begin
 I:=F4NVLen(V);
 While I>1 Do Begin Dec(I); F4B1(B,128 Or LongInt((V Shr (7*I)) And 127)); End;
 F4B1(B,LongInt(V And 127));
End;
Procedure F4NPutS(Var B: TF4B; V: Int64);
Begin
 If V>0 Then F4NPutV(B,QWord(2*V-1)) Else F4NPutV(B,QWord(-2*V));
End;
Procedure F4NPutStr(Var B: TF4B; Const S: String);
Begin F4NPutV(B,Length(S)); If Length(S)>0 Then F4BN(B,@S[1],Length(S)); End;
Procedure F4NPutTt(Var B: TF4B; Tb: LongInt; V: Int64);
Begin F4NPutV(B,QWord(V*F4NTbC+Tb)); End;

Procedure F4NPutPacket(Var Dst: TF4B; Start: QWord; Const P: TF4B);
Var Fwd: LongInt; C: LongWord; H: TF4B; I: LongInt;
Begin
 Fwd:=P.N+4;
 F4BInit(H);
 For I:=7 DownTo 0 Do F4B1(H,LongInt((Start Shr (I*8)) And 255));
 F4NPutV(H,Fwd);
 F4BCopy(Dst,H);
 If Fwd>4096 Then Begin C:=F4NCrc(H.P,0,H.N); F4BWb(Dst,C,4); End;
 F4BFree(H);
 F4BCopy(Dst,P);
 C:=F4NCrc(P.P,0,P.N); F4BWb(Dst,C,4);
End;

Function F4NStart(Ch: Char; Lo: QWord): QWord;
Begin F4NStart:=Lo+((QWord(78)*256+Ord(Ch)) Shl 48); End;

{ en-tete attendu pour l'elision (find_expected_header) ; retourne la longueur
 (-1 erreur) }
Function F4NExpHdr(S: LongInt; Size: LongInt; Key: Boolean; Var Out: Array Of
 Byte): LongInt;
Var Sr,Lsf,Mpeg25,Si,Bi,Fs,Layer: LongInt; H: LongWord; C: String;
Begin
 F4NExpHdr:=0; C:=F4S[S].Codec; Sr:=F4S[S].Rate;
 If Size>4096 Then Exit;
 Out[0]:=0; Out[1]:=0; Out[2]:=1;
 If C='mpeg4' Then Begin
  If Key Then F4NExpHdr:=3 Else Begin Out[3]:=$B6; F4NExpHdr:=4; End;
 End Else If (C='mpeg1video') Or (C='mpeg2video') Or (C='h264') Then F4NExpHdr:=
  3
 Else If (C='mp3') Or (C='mp2') Then Begin
  If C='mp3' Then Layer:=3 Else Layer:=2;
  H:=$FFF00000;
  If Sr<28000 Then Lsf:=1 Else Lsf:=0;
  If Sr<14000 Then Mpeg25:=1 Else Mpeg25:=0;
  Sr:=Sr Shl (Lsf+Mpeg25);
  If Sr<(32000+44100) Div 2 Then Si:=2 Else If Sr<(44100+48000) Div 2 Then Si:=0
   Else Si:=1;
  Case Si Of 0: Sr:=44100; 1: Sr:=48000; Else Sr:=32000; End;
  Sr:=Sr Shr (Lsf+Mpeg25);
  Bi:=2; Fs:=0;
  While Bi<30 Do Begin
   If Lsf=0 Then Fs:=F4BrM1[Layer,Bi Shr 1] Else Fs:=F4BrM2[Layer,Bi Shr 1];
   Fs:=(Fs*144000) Div (Sr Shl Lsf)+(Bi And 1);
   If Fs=Size Then Break;
   Inc(Bi);
  End;
  If Lsf=0 Then H:=H Or $80000;
  H:=H Or (LongWord(4-Layer) Shl 17); H:=H Or $10000;
  Out[0]:=(H Shr 24) And 255; Out[1]:=(H Shr 16) And 255; Out[2]:=(H Shr 8) And
   255; Out[3]:=H And 255;
  If Size<=0 Then Begin F4NExpHdr:=2; Exit; End;
  If Bi=30 Then Begin F4NExpHdr:=-1; Exit; End;
  F4NExpHdr:=2;
 End;
End;

Function F4NFindHdrIdx(S,Size: LongInt; Key: Boolean): LongInt;
Var Out: Array[0..63] Of Byte; Len,I,K: LongInt; Same: Boolean;
Begin
 Len:=F4NExpHdr(S,Size,Key,Out);
 For I:=1 To F4NHCount-1 Do Begin
  If Len=F4NHLen[I] Then Begin
   Same:=True; For K:=0 To Len-1 Do If Out[K]<>F4NH[I,K] Then Same:=False;
   If Same Then Begin F4NFindHdrIdx:=I; Exit; End;
  End;
 End;
 F4NFindHdrIdx:=0;
End;

Procedure F4NBuildElision;
Const
 Hd: Array[1..6,0..4] Of Byte = ((3,0,0,1,0),(4,0,0,1,$B6),(2,$FF,$FA,0,0),(2,
  $FF,$FB,0,0),(2,$FF,$FC,0,0),(2,$FF,$FD,0,0));
Var I,K: LongInt;
Begin
 F4NHCount:=7;
 For I:=1 To 6 Do Begin
  F4NHLen[I]:=Hd[I,0];
  For K:=0 To 3 Do F4NH[I,K]:=Hd[I,K+1];
 End;
End;

Procedure F4NBuildFrameCode;
Var
 KeyF,Idx,Pred,Sid,Start,EndC,Start2,End2,Start3,End3,PredCount,FrameSize,
  FrameBytes,Pts,Esc: LongInt;
 PredTab: Array[0..9] Of LongInt; IsAudio,Intra,K0Esc: Boolean; Fn,Fd,Q: Int64;
  Par: String; Fs2: LongInt;
 I: LongInt; Kf: LongInt;
Begin
 FillChar(F4NFc,SizeOf(F4NFc),0);
 Start:=1; EndC:=254; K0Esc:=F4NS>2;
 F4NFc[Start].Flags:=4096; F4NFc[Start].Mul:=1; F4NFc[Start].Pd:=1; Inc(Start);
 If K0Esc Then Begin
  F4NFc[Start].Flags:=16 Or 32 Or 8; F4NFc[Start].Mul:=1; Inc(Start);
 End;
 For Sid:=0 To F4NS-1 Do Begin
  Start2:=Start+(EndC-Start)*Sid Div F4NS;
  End2:=Start+(EndC-Start)*(Sid+1) Div F4NS;
  IsAudio:=F4S[Sid].Typ=1; Intra:=IsAudio;
  FrameSize:=0;
  If IsAudio Then Begin
   FrameSize:=F4AudioFrameSamples(F4S[Sid].Codec,F4S[Sid].Rate);
   If (F4S[Sid].Codec='vorbis') And (FrameSize=0) Then FrameSize:=64;
  End Else Begin
   { f = 1/avg_frame_rate / time_base ; entier si den=1 }
   If (F4S[Sid].AvgN>0) And (F4S[Sid].AvgD>0) Then Begin
    Fn:=F4S[Sid].AvgD*F4NTbD[F4NSt[Sid].Tb]; Fd:=F4S[Sid].AvgN*F4NTbN[F4NSt[
     Sid].Tb];
    Q:=F4Gcd(Fn,Fd); If Q<>0 Then Begin Fn:=Fn Div Q; Fd:=Fd Div Q; End;
    If (Fd=1) And (Fn>0) Then FrameSize:=Fn;
   End;
  End;
  If FrameSize=0 Then FrameSize:=1;
  For KeyF:=0 To 1 Do Begin
   If (Not Intra) Or (Not K0Esc) Or (KeyF<>0) Then Begin
    F4NFc[Start2].Flags:=KeyF*1; F4NFc[Start2].Flags:=F4NFc[Start2].Flags Or 32
     Or 8;
    F4NFc[Start2].Sid:=Sid; F4NFc[Start2].Mul:=1;
    If IsAudio Then F4NFc[Start2].Hi:=F4NFindHdrIdx(Sid,-1,KeyF=1);
    Inc(Start2);
   End;
  End;
  If Intra Then Kf:=1 Else Kf:=0;
  If IsAudio Then Begin
   If F4S[Sid].BlockAlign>0 Then FrameBytes:=F4S[Sid].BlockAlign
   Else Begin
    Fs2:=F4AudioFrameSamples(F4S[Sid].Codec,F4S[Sid].Rate);
    FrameBytes:=LongInt(Int64(Fs2)*F4S[Sid].BitRate Div (8*Int64(F4S[
     Sid].Rate)));
   End;
   For Pts:=0 To 1 Do For Pred:=0 To 1 Do Begin
    F4NFc[Start2].Flags:=Kf; F4NFc[Start2].Sid:=Sid; F4NFc[Start2].Mul:=Word(
     FrameBytes+2); F4NFc[Start2].Lsb:=Word(FrameBytes+Pred);
    F4NFc[Start2].Pd:=SmallInt(Pts*FrameSize); F4NFc[Start2].Hi:=F4NFindHdrIdx(
     Sid,FrameBytes+Pred,Kf=1);
    Inc(Start2);
   End;
  End Else Begin
   F4NFc[Start2].Flags:=1 Or 32; F4NFc[Start2].Sid:=Sid; F4NFc[Start2].Mul:=1;
    F4NFc[Start2].Pd:=SmallInt(FrameSize); Inc(Start2);
  End;
  If F4S[Sid].VDelay>0 Then Begin PredCount:=5; PredTab[0]:=-2; PredTab[1]:=-1;
   PredTab[2]:=1; PredTab[3]:=3; PredTab[4]:=4; End
  Else If F4S[Sid].Codec='vorbis' Then Begin PredCount:=3; PredTab[0]:=2;
   PredTab[1]:=9; PredTab[2]:=16; End
  Else Begin PredCount:=1; PredTab[0]:=1; End;
  For Pred:=0 To PredCount-1 Do Begin
   Start3:=Start2+(End2-Start2)*Pred Div PredCount;
   End3:=Start2+(End2-Start2)*(Pred+1) Div PredCount;
   PredTab[Pred]:=PredTab[Pred]*FrameSize;
   For Idx:=Start3 To End3-1 Do Begin
    F4NFc[Idx].Flags:=Kf Or 32; F4NFc[Idx].Sid:=Sid; F4NFc[Idx].Mul:=End3-
     Start3; F4NFc[Idx].Lsb:=Idx-Start3;
    F4NFc[Idx].Pd:=SmallInt(PredTab[Pred]);
    If IsAudio Then F4NFc[Idx].Hi:=F4NFindHdrIdx(Sid,-1,Kf=1);
   End;
  End;
 End;
 Move(F4NFc[Ord('N')],F4NFc[Ord('N')+1],SizeOf(TF4NFc)*(255-Ord('N')));
 F4NFc[0].Flags:=8192; F4NFc[255].Flags:=8192; F4NFc[Ord('N')].Flags:=8192;
End;

Procedure F4NChooseTb(Var N,D: Int64; MinP: Int64);
Var J: LongInt;
Begin
 J:=2;
 While J<14 Do Begin
  While (D Div N<MinP) And (N Mod J=0) Do N:=N Div J;
  If J>2 Then Inc(J,2) Else Inc(J);
 End;
 While (D Div N<MinP) And (D<(1 Shl 24)) Do D:=D*2;
End;

Function F4NCmpTs(A: Int64; ANum,ADen: Int64; B: Int64; BNum,BDen: Int64):
 LongInt;
Var X,Y: Int64;
Begin
 X:=A*ANum*BDen; Y:=B*BNum*ADen;
 If X<Y Then F4NCmpTs:=-1 Else If X>Y Then F4NCmpTs:=1 Else F4NCmpTs:=0;
End;

Procedure F4NWriteStreamHeader(Var P: TF4B; S: LongInt);
Begin
 F4NPutV(P,S);
 If F4S[S].Typ=0 Then F4NPutV(P,0) Else F4NPutV(P,1);
 F4NPutV(P,4);
 If F4S[S].Tag=0 Then Fail('No codec tag defined for stream '+Chr(48+S));
 F4BWl(P,F4S[S].Tag,4);
 F4NPutV(P,F4NSt[S].Tb);
 F4NPutV(P,F4NSt[S].Shift);
 F4NPutV(P,F4NSt[S].MaxD);
 F4NPutV(P,F4S[S].VDelay);
 F4B1(P,0);
 F4NPutV(P,F4S[S].ExtraLen);
 If F4S[S].ExtraLen>0 Then F4BN(P,F4S[S].Extra,F4S[S].ExtraLen);
 If F4S[S].Typ=1 Then Begin
  F4NPutV(P,F4S[S].Rate); F4NPutV(P,1); F4NPutV(P,F4S[S].Chans);
 End Else Begin
  F4NPutV(P,F4S[S].W); F4NPutV(P,F4S[S].H);
  If (F4S[S].SarN<=0) Or (F4S[S].SarD<=0) Then Begin F4NPutV(P,0); F4NPutV(P,0);
   End
  Else Begin F4NPutV(P,F4S[S].SarN); F4NPutV(P,F4S[S].SarD); End;
  F4NPutV(P,0);
 End;
End;

Procedure F4NAddInfo(Var B: TF4B; Const K,V: String);
Begin F4NPutStr(B,K); F4NPutS(B,-1); F4NPutStr(B,V); End;

Procedure F4NWriteHeaders;
Var P,E: TF4B; I,J,Cnt,Tf,TPts,TFlags,TStream,TMul,TSize,THead: LongInt; TMatch:
 QWord; S: String; T1,T2: String;
Begin
 F4BInit(P);
 { en-tete principal }
 F4NPutV(P,3);
 F4NPutV(P,F4NS); F4NPutV(P,32767); F4NPutV(P,F4NTbC);
 For I:=0 To F4NTbC-1 Do Begin F4NPutV(P,F4NTbN[I]); F4NPutV(P,F4NTbD[I]); End;
 TPts:=0; TMul:=1; TStream:=0; TSize:=0; THead:=0; TMatch:=QWord(1)-(QWord(1)
  Shl 62);
 I:=0;
 While I<256 Do Begin
  Tf:=0; TSize:=0;
  If TPts<>F4NFc[I].Pd Then Tf:=1;
  If TMul<>F4NFc[I].Mul Then Tf:=2;
  If TStream<>F4NFc[I].Sid Then Tf:=3;
  If TSize<>F4NFc[I].Lsb Then Tf:=4;
  If THead<>F4NFc[I].Hi Then Tf:=8;
  TPts:=F4NFc[I].Pd; TFlags:=F4NFc[I].Flags; TStream:=F4NFc[I].Sid; TMul:=F4NFc[
   I].Mul; TSize:=F4NFc[I].Lsb; THead:=F4NFc[I].Hi;
  J:=0;
  While I<256 Do Begin
   If I=Ord('N') Then Begin Dec(J); Inc(I); Inc(J); Continue; End;
   If (F4NFc[I].Pd<>TPts) Or (F4NFc[I].Flags<>TFlags) Or (F4NFc[I].Sid<>TStream)
    Or (F4NFc[I].Mul<>TMul) Or (F4NFc[I].Lsb<>TSize+J) Or (F4NFc[I].Hi<>THead)
    Then Break;
   Inc(J); Inc(I);
  End;
  If J<>TMul-TSize Then Tf:=6;
  F4NPutV(P,TFlags); F4NPutV(P,Tf);
  If Tf>0 Then F4NPutS(P,TPts);
  If Tf>1 Then F4NPutV(P,TMul);
  If Tf>2 Then F4NPutV(P,TStream);
  If Tf>3 Then F4NPutV(P,TSize);
  If Tf>4 Then F4NPutV(P,0);
  If Tf>5 Then F4NPutV(P,J);
  If Tf>6 Then F4NPutV(P,TMatch);
  If Tf>7 Then F4NPutV(P,THead);
 End;
 F4NPutV(P,F4NHCount-1);
 For I:=1 To F4NHCount-1 Do Begin
  F4NPutV(P,F4NHLen[I]); For J:=0 To F4NHLen[I]-1 Do F4B1(P,F4NH[I,J]);
 End;
 F4NPutPacket(F4NOut,F4NStart('M',$7A561F5F04AD),P);
 P.N:=0;
 For I:=0 To F4NS-1 Do Begin
  F4NWriteStreamHeader(P,I);
  F4NPutPacket(F4NOut,F4NStart('S',$11405BF2F9DB),P); P.N:=0;
 End;
 { informations globales }
 F4NPutV(P,0); F4NPutV(P,0); F4NPutV(P,0); F4NPutV(P,0);
 F4BInit(E); Cnt:=0;
 For J:=0 To F4GN-1 Do If F4GK[J]<>'encoder' Then Begin
  T1:=F4GK[J];
  If T1='artist' Then T1:='Author' Else If T1='date' Then T1:='X-CreationTime'
   Else If T1='filename' Then T1:='SourceFilename' Else If T1='language' Then
   T1:='X-Language';
  F4NAddInfo(E,T1,F4GV[J]); Inc(Cnt);
 End;
 If Not F4MBitExact Then Begin F4NAddInfo(E,'encoder','Lavf60.16.100'); Inc(
  Cnt); End;
 F4NPutV(P,Cnt); F4BCopy(P,E); F4BFree(E);
 F4NPutPacket(F4NOut,F4NStart('I',$AB68B596BA78),P); P.N:=0;
 For I:=0 To F4NS-1 Do Begin
  F4BInit(E); Cnt:=0;
  If F4S[I].MetaN>0 Then Begin
   For J:=0 To F4S[I].MetaN-1 Do Begin
    T1:=F4S[I].MetaK[J];
    If T1='artist' Then T1:='Author' Else If T1='date' Then T1:='X-CreationTime'
     Else If T1='filename' Then T1:='SourceFilename' Else If T1='language' Then
     T1:='X-Language';
    F4NAddInfo(E,T1,F4S[I].MetaV[J]); Inc(Cnt); End;
  End Else If F4S[I].EncTag<>'' Then Begin F4NAddInfo(E,'encoder',F4S[
   I].EncTag); Inc(Cnt); End;
  If F4S[I].Dflt Then Begin F4NAddInfo(E,'Disposition','default'); Inc(Cnt);
   End;
  If F4S[I].Typ=0 Then Begin
   If (F4S[I].RN>0) And (F4S[I].RD>0) Then Begin Str(F4S[I].RN,T1); Str(F4S[
    I].RD,T2); End
   Else Begin Str(F4S[I].AvgN,T1); Str(F4S[I].AvgD,T2); End;
   F4NAddInfo(E,'r_frame_rate',T1+'/'+T2); Inc(Cnt);
  End;
  If Cnt>0 Then Begin
   F4NPutV(P,I+1); F4NPutV(P,0); F4NPutV(P,0); F4NPutV(P,0); F4NPutV(P,Cnt);
    F4BCopy(P,E);
   F4NPutPacket(F4NOut,F4NStart('I',$AB68B596BA78),P); P.N:=0;
  End;
  F4BFree(E);
 End;
 F4BFree(P);
End;

Function F4NLsb2Full(S: LongInt; Lsb: Int64): Int64;
Var Mask,Delta: Int64;
Begin
 Mask:=(Int64(1) Shl F4NSt[S].Shift)-1;
 Delta:=F4NSt[S].LastPts-Mask Div 2;
 F4NLsb2Full:=((Lsb-Delta) And Mask)+Delta;
End;

Function F4NNeededFlags(S: LongInt; Fc: LongInt; Size: LongInt; Key: Boolean;
 Pts: Int64; Pdata: PEABuffer): LongInt;
Var Fl: LongInt; K: LongInt; Bad: Boolean;
Begin
 Fl:=0;
 If Key Then Fl:=Fl Or 1;
 If S<>F4NFc[Fc].Sid Then Fl:=Fl Or 16;
 If (F4NFc[Fc].Mul>0) And (Size Div F4NFc[Fc].Mul<>0) Then Fl:=Fl Or 32;
 If Pts-F4NSt[S].LastPts<>F4NFc[Fc].Pd Then Fl:=Fl Or 8;
 If Size>2*32767 Then Fl:=Fl Or 64;
 If Abs(Pts-F4NSt[S].LastPts)>F4NSt[S].MaxD Then Fl:=Fl Or 64;
 If F4NFc[Fc].Hi<>0 Then Begin
  Bad:=(Size<F4NHLen[F4NFc[Fc].Hi]) Or (Size>4096);
  If Not Bad Then For K:=0 To F4NHLen[F4NFc[Fc].Hi]-1 Do If Pdata^[K]<>F4NH[
   F4NFc[Fc].Hi,K] Then Bad:=True;
  If Bad Then Fl:=Fl Or 1024;
 End;
 F4NNeededFlags:=Fl Or (F4NFc[Fc].Flags And 4096);
End;

Function F4NBestHdr(Size: LongInt; Pdata: PEABuffer): LongInt;
Var I,K,Best,BL: LongInt; Ok: Boolean;
Begin
 Best:=0; BL:=0;
 If Size>4096 Then Begin F4NBestHdr:=0; Exit; End;
 For I:=1 To F4NHCount-1 Do Begin
  If (Size>=F4NHLen[I]) And (F4NHLen[I]>BL) Then Begin
   Ok:=True; For K:=0 To F4NHLen[I]-1 Do If Pdata^[K]<>F4NH[I,K] Then Ok:=False;
   If Ok Then Begin Best:=I; BL:=F4NHLen[I]; End;
  End;
 End;
 F4NBestHdr:=Best;
End;

Procedure F4NSpAdd(Pos,Ts: Int64);
Var NC,S: LongInt;
Begin
 If F4NSpN>=F4NSpCap Then Begin
  If F4NSpCap=0 Then F4NSpCap:=64 Else F4NSpCap:=F4NSpCap*2;
  ReAllocMem(Pointer(F4NSpA),F4NSpCap*16);
 End;
 PInt64(PtrUInt(F4NSpA)+F4NSpN*16)^:=Pos; PInt64(PtrUInt(F4NSpA)+F4NSpN*16+8)^:=
  Ts;
 Inc(F4NSpN);
 If ((Int64(1) Shl 60) Mod F4NSpN)=0 Then
  For S:=0 To F4NS-1 Do Begin
   NC:=2*F4NSpN;
   ReAllocMem(Pointer(F4NSt[S].Kf),NC*8);
   For NC:=(F4NSpN*Ord(F4NSpN<>1)) To 2*F4NSpN-1 Do PInt64(PtrUInt(F4NSt[S].Kf)+
    NC*8)^:=F4NoPts;
   F4NSt[S].KfN:=2*F4NSpN;
  End;
End;

Procedure F4NWritePacket(S,K: LongInt);
Var
 P: ^TF4Pkt; Pts,Dts,CodedPts: Int64; Key,StoreSp: Boolean; I,J,BestLen,
  FrameCode,Flags,Needed,HdrIdx,BestHdr,Len,Idx,Sz: LongInt;
 Fc: LongInt; Fl: LongInt; Sp: TF4B; SpPos,Dtt: Int64; Pdata: PEABuffer; Hdr:
  TF4B; C: LongWord; Tell: Int64; Ix,Lo: LongInt;
 EPos,ETs: Int64;
Begin
 P:=@F4S[S].P^[K];
 Pts:=P^.Pts; Dts:=P^.Dts; Key:=P^.Key; Sz:=P^.Len;
 Pdata:=PEABuffer(@F4S[S].Data^[P^.Pos]);
 If Pts<0 Then Fail('Negative pts not supported stream '+Chr(48+S));
 Tell:=F4NOut.N;
 StoreSp:=False;
 If Key And ((F4NSt[S].LastFlags And 1)=0) Then StoreSp:=True;
 If Sz+30+Tell>=F4NLastSp+32767 Then StoreSp:=True;
 If StoreSp Then Begin
  { ff_nut_reset_ts }
  For I:=0 To F4NS-1 Do
   F4NSt[I].LastPts:=F4MulDivR(Dts,F4NTbN[F4NSt[S].Tb]*F4NTbD[F4NSt[I].Tb],
    F4NTbD[F4NSt[S].Tb]*F4NTbN[F4NSt[I].Tb],2);
  SpPos:=High(Int64);
  For I:=0 To F4NS-1 Do Begin
   Dtt:=F4MulDivR(Dts,F4NTbN[F4NSt[S].Tb]*F4NTbD[F4NSt[I].Tb],F4NTbD[F4NSt[
    S].Tb]*F4NTbN[F4NSt[I].Tb],2);
   Ix:=-1;
   For J:=0 To F4NIdxN[I]-1 Do If PInt64(PtrUInt(F4NIdxPos[I])+J*16+8)^<=Dtt
    Then Ix:=J;
   If Ix>=0 Then Begin
    EPos:=PInt64(PtrUInt(F4NIdxPos[I])+Ix*16)^;
    If EPos<SpPos Then SpPos:=EPos;
   End;
  End;
  F4NLastSp:=Tell;
  F4BInit(Sp);
  F4NPutTt(Sp,F4NSt[S].Tb,Dts);
  If SpPos<>High(Int64) Then F4NPutV(Sp,QWord((F4NLastSp-SpPos) Shr 4)) Else
   F4NPutV(Sp,0);
  F4NPutPacket(F4NOut,F4NStart('K',$E4ADEECA4569),Sp);
  F4BFree(Sp);
  F4NSpAdd(F4NLastSp,Dts);
 End;
 CodedPts:=Pts And ((Int64(1) Shl F4NSt[S].Shift)-1);
 If F4NLsb2Full(S,CodedPts)<>Pts Then CodedPts:=Pts+(Int64(1) Shl F4NSt[
  S].Shift);
 BestHdr:=F4NBestHdr(Sz,Pdata);
 BestLen:=High(LongInt); FrameCode:=-1;
 For I:=0 To 255 Do Begin
  Len:=0; Fl:=F4NFc[I].Flags;
  If (Fl And 8192)<>0 Then Continue;
  Needed:=F4NNeededFlags(S,I,Sz,Key,Pts,Pdata);
  If (Fl And 4096)<>0 Then Begin Inc(Len); Fl:=Needed; End;
  If (Fl And Needed)<>Needed Then Continue;
  If ((Fl Xor Needed) And 1)<>0 Then Continue;
  If (Fl And 16)<>0 Then Inc(Len,F4NVLen(S));
  If F4NFc[I].Mul=0 Then Continue;
  If Sz Mod F4NFc[I].Mul<>F4NFc[I].Lsb Then Continue;
  If (Fl And 32)<>0 Then Inc(Len,F4NVLen(Sz Div F4NFc[I].Mul));
  If (Fl And 64)<>0 Then Inc(Len,4);
  If (Fl And 8)<>0 Then Inc(Len,F4NVLen(CodedPts));
  If ((F4NFc[I].Flags And 4096)<>0) And (F4NHLen[BestHdr]>F4NHLen[F4NFc[I].Hi]+
   1) Then Fl:=Fl Or 1024;
  If (Fl And 1024)<>0 Then Len:=Len+1-F4NHLen[BestHdr] Else Len:=Len-F4NHLen[
   F4NFc[I].Hi];
  Len:=Len*4;
  If (Fl And 8)=0 Then Inc(Len);
  If (Fl And 64)=0 Then Inc(Len);
  If Len<BestLen Then Begin BestLen:=Len; FrameCode:=I; End;
 End;
 If FrameCode<0 Then Fail('nut: aucun code de trame');
 Fc:=FrameCode; Flags:=F4NFc[Fc].Flags;
 Needed:=F4NNeededFlags(S,Fc,Sz,Key,Pts,Pdata);
 HdrIdx:=F4NFc[Fc].Hi;
 F4BInit(Hdr);
 F4B1(Hdr,Fc);
 If (Flags And 4096)<>0 Then Begin
  F4NPutV(Hdr,QWord((Flags Xor Needed) And (Not 4096)));
  Flags:=Needed;
 End;
 If (Flags And 16)<>0 Then F4NPutV(Hdr,S);
 If (Flags And 8)<>0 Then F4NPutV(Hdr,QWord(CodedPts));
 If (Flags And 32)<>0 Then F4NPutV(Hdr,QWord(Sz Div F4NFc[Fc].Mul));
 If (Flags And 1024)<>0 Then Begin HdrIdx:=BestHdr; F4NPutV(Hdr,HdrIdx); End;
 If (Flags And 64)<>0 Then Begin C:=F4NCrc(Hdr.P,0,Hdr.N); F4BWb(Hdr,C,4); End;
 F4BCopy(F4NOut,Hdr); F4BFree(Hdr);
 F4BN(F4NOut,@Pdata^[F4NHLen[HdrIdx]],Sz-F4NHLen[HdrIdx]);
 F4NSt[S].LastFlags:=Flags; F4NSt[S].LastPts:=Pts;
 If (Flags And 1)<>0 Then Begin
  If (F4NIdxN[S]>0) And (PInt64(PtrUInt(F4NIdxPos[S])+(F4NIdxN[S]-1)*16+8)^=Pts)
   Then
   PInt64(PtrUInt(F4NIdxPos[S])+(F4NIdxN[S]-1)*16)^:=F4NLastSp
  Else Begin
   If F4NIdxN[S]>=F4NIdxCap[S] Then Begin
    If F4NIdxCap[S]=0 Then F4NIdxCap[S]:=64 Else F4NIdxCap[S]:=F4NIdxCap[S]*2;
    ReAllocMem(Pointer(F4NIdxPos[S]),F4NIdxCap[S]*16);
   End;
   PInt64(PtrUInt(F4NIdxPos[S])+F4NIdxN[S]*16)^:=F4NLastSp; PInt64(PtrUInt(
    F4NIdxPos[S])+F4NIdxN[S]*16+8)^:=Pts;
   Inc(F4NIdxN[S]);
  End;
  If (F4NSt[S].Kf<>Nil) And (F4NSpN<F4NSt[S].KfN) Then
   If PInt64(PtrUInt(F4NSt[S].Kf)+F4NSpN*8)^=F4NoPts Then PInt64(PtrUInt(F4NSt[
    S].Kf)+F4NSpN*8)^:=Pts;
 End;
 If (F4NMaxTb<0) Or (F4NCmpTs(F4NMaxPts,F4NTbN[F4NMaxTb],F4NTbD[F4NMaxTb],Pts,
  F4NTbN[F4NSt[S].Tb],F4NTbD[F4NSt[S].Tb])<0) Then Begin
  F4NMaxPts:=Pts; F4NMaxTb:=F4NSt[S].Tb;
 End;
End;

Procedure F4NWriteIndex;
Var P: TF4B; I,J,K,N,Flag: LongInt; Last,Prev: Int64; Kf: PInt64; Payload:
 Int64; Lg: LongInt; Fl: Boolean; V: Int64;
Begin
 F4BInit(P);
 F4NPutTt(P,F4NMaxTb,F4NMaxPts);
 F4NPutV(P,F4NSpN);
 Prev:=0;
 For I:=0 To F4NSpN-1 Do Begin
  V:=PInt64(PtrUInt(F4NSpA)+I*16)^;
  F4NPutV(P,QWord((V Shr 4)-(Prev Shr 4))); Prev:=V;
 End;
 For I:=0 To F4NS-1 Do Begin
  Last:=-1; J:=0;
  While J<F4NSpN Do Begin
   N:=0;
   If (J>0) And (PInt64(PtrUInt(F4NSt[I].Kf)+J*8)^=PInt64(PtrUInt(F4NSt[I].Kf)+(
    J-1)*8)^) Then PInt64(PtrUInt(F4NSt[I].Kf)+J*8)^:=F4NoPts;
   Fl:=(PInt64(PtrUInt(F4NSt[I].Kf)+J*8)^<>F4NoPts) Xor (J+1=F4NSpN);
   While (J<F4NSpN) And ((PInt64(PtrUInt(F4NSt[I].Kf)+J*8)^<>F4NoPts)=Fl) Do
    Begin Inc(N); Inc(J); End;
   If Fl Then Flag:=1 Else Flag:=0;
   F4NPutV(P,1+2*Flag+4*N);
   For K:=J-N To J Do Begin
    If K>=F4NSpN Then Break;
    V:=PInt64(PtrUInt(F4NSt[I].Kf)+K*8)^;
    If V=F4NoPts Then Continue;
    F4NPutV(P,QWord(V-Last)); Last:=V;
   End;
   Inc(J);
  End;
 End;
 Payload:=P.N+8+4;
 Lg:=0; V:=Payload; While V>1 Do Begin V:=V Shr 1; Inc(Lg); End;
 V:=8+Payload+Lg Div 7+1; If Payload>4096 Then V:=V+4;
 F4BWb(P,V,8);
 F4NPutPacket(F4NOut,F4NStart('X',$DD672F23E64E),P);
 F4BFree(P);
End;

{ ecrit le fichier NUT ; flux et paquets dans F4S }
Procedure F4MuxNut(Const Target: String);
Var
 S,K,J,I,Total,Done,Best: LongInt; Q: Int64; Tn,Td: Int64; P: ^TF4Pkt; Found:
  Boolean; BestDts: Int64; Mn,V: Int64; Got: Boolean; Shift: Int64; Cmp:
  LongInt; ShS: Array[0..31] Of Int64;
 ID: String;
Begin
 F4MBitExact:=VGBitExact;
 If F4NS<1 Then Fail('Aucun flux a ecrire.');
 F4NTbC:=0;
 For S:=0 To F4NS-1 Do Begin
  FillChar(F4NSt[S],SizeOf(F4NSt[S]),0);
  If (F4S[S].Typ=1) And (F4S[S].Rate>0) Then Begin Tn:=1; Td:=F4S[S].Rate; End
  Else Begin Tn:=F4S[S].TbN; Td:=F4S[S].TbD; F4NChooseTb(Tn,Td,48000); End;
  J:=0; While J<F4NTbC Do Begin If (F4NTbN[J]=Tn) And (F4NTbD[J]=Td) Then Break;
   Inc(J); End;
  F4NTbN[J]:=Tn; F4NTbD[J]:=Td; F4NSt[S].Tb:=J; If J=F4NTbC Then Inc(F4NTbC);
  If Int64(1000)*Tn>=Td Then F4NSt[S].Shift:=7 Else F4NSt[S].Shift:=14;
  If Td>Tn Then F4NSt[S].MaxD:=LongInt(Td Div Tn) Else F4NSt[S].MaxD:=LongInt(Tn
   Div Tn);
  F4NSt[S].LastPts:=0; F4NSt[S].Kf:=Nil; F4NSt[S].KfN:=0;
  F4NIdxPos[S]:=Nil; F4NIdxN[S]:=0; F4NIdxCap[S]:=0;
 End;
 { etiquettes de codec NUT }
 For S:=0 To F4NS-1 Do Begin
  If F4S[S].Codec='pcm_s16le' Then F4S[S].Tag:=$10445350
  Else If F4S[S].Codec='pcm_s24le' Then F4S[S].Tag:=$18445350
  Else If F4S[S].Codec='pcm_s32le' Then F4S[S].Tag:=$20445350
  Else If F4S[S].Codec='pcm_u8' Then F4S[S].Tag:=$08445550
  Else If F4S[S].Codec='pcm_f32le' Then F4S[S].Tag:=$20444650
  Else If F4S[S].Codec='pcm_f64le' Then F4S[S].Tag:=$40444650
  Else If (F4S[S].Tag=0) And (F4S[S].Typ=0) Then Begin
   If F4S[S].Codec='mpeg4' Then F4S[S].Tag:=$34504D46 Else If F4S[
    S].Codec='msmpeg4v3' Then F4S[S].Tag:=$3334504D
   Else If F4S[S].Codec='msmpeg4v2' Then F4S[S].Tag:=$3234504D Else If F4S[
    S].Codec='mjpeg' Then F4S[S].Tag:=$47504A4D
   Else If F4S[S].Codec='h264' Then F4S[S].Tag:=$34363248 Else If F4S[
    S].Codec='mpeg1video' Then F4S[S].Tag:=$3147504D
   Else If F4S[S].Codec='mpeg2video' Then F4S[S].Tag:=$3247504D Else If F4S[
    S].Codec='rawvideo' Then F4S[S].Tag:=$0F424752;
  End
  Else If F4S[S].Tag=0 Then Begin
   If F4S[S].Codec='mp2' Then F4S[S].Tag:=$50 Else If F4S[S].Codec='mp3' Then
    F4S[S].Tag:=$55
   Else If F4S[S].Codec='ac3' Then F4S[S].Tag:=$2000 Else If F4S[S].Codec='aac'
    Then F4S[S].Tag:=$FF
   Else If F4S[S].Codec='flac' Then F4S[S].Tag:=$F1AC Else If F4S[
    S].Codec='vorbis' Then F4S[S].Tag:=$566F;
  End;
 End;
 { conversion des horodatages }
 For S:=0 To F4NS-1 Do For K:=0 To F4S[S].NPk-1 Do Begin
  P:=@F4S[S].P^[K];
  If P^.Pts<>F4NoPts Then P^.Pts:=P^.Pts+F4S[S].Off;
  If P^.Dts<>F4NoPts Then P^.Dts:=P^.Dts+F4S[S].Off;
  If (P^.Pts=F4NoPts) And (P^.Dts<>F4NoPts) Then P^.Pts:=P^.Dts;
  If (P^.Dts=F4NoPts) And (P^.Pts<>F4NoPts) Then P^.Dts:=P^.Pts;
  P^.Pts:=F4RescQ(P^.Pts,F4S[S].TbN,F4S[S].TbD,F4NTbN[F4NSt[S].Tb],F4NTbD[F4NSt[
   S].Tb],4);
  P^.Dts:=F4RescQ(P^.Dts,F4S[S].TbN,F4S[S].TbD,F4NTbN[F4NSt[S].Tb],F4NTbD[F4NSt[
   S].Tb],4);
 End;
 { avoid_negative_ts (dts) : decalage pris dans la base du flux au dts minimal,
  puis converti par flux }
 Got:=False; Mn:=0; Best:=0; FillChar(ShS,SizeOf(ShS),0);
 For S:=0 To F4NS-1 Do If F4S[S].NPk>0 Then Begin
  V:=F4S[S].P^[0].Dts;
  If V<>F4NoPts Then Begin
   If (Not Got) Or (F4NCmpTs(V,F4NTbN[F4NSt[S].Tb],F4NTbD[F4NSt[S].Tb],Mn,
    F4NTbN[F4NSt[Best].Tb],F4NTbD[F4NSt[Best].Tb])<0) Then Begin
    Mn:=V; Best:=S; Got:=True;
   End;
  End;
 End;
 If Got And (Mn<0) Then
  For S:=0 To F4NS-1 Do Begin
   Shift:=F4MulDivR(-Mn,F4NTbN[F4NSt[Best].Tb]*F4NTbD[F4NSt[S].Tb],F4NTbD[F4NSt[
    Best].Tb]*F4NTbN[F4NSt[S].Tb],4); ShS[S]:=Shift;
   For K:=0 To F4S[S].NPk-1 Do Begin
    P:=@F4S[S].P^[K];
    If P^.Dts<>F4NoPts Then P^.Dts:=P^.Dts+Shift;
    If P^.Pts<>F4NoPts Then P^.Pts:=P^.Pts+Shift;
   End;
  End;
 F4NBuildElision;
 F4NBuildFrameCode;
 F4BInit(F4NOut);
 ID:='nut/multimedia container'; F4BN(F4NOut,@ID[1],Length(ID)); F4B1(F4NOut,0);
 F4NWriteHeaders;
 F4NLastSp:=-2147483648; F4NSpN:=0; F4NSpCap:=0; F4NSpA:=Nil; F4NMaxTb:=-1;
  F4NMaxPts:=0;
 Total:=0; For S:=0 To F4NS-1 Do Begin F4NSt[S].Cur:=0; Inc(Total,F4S[S].NPk);
  End;
 For Done:=1 To Total Do Begin
  Best:=-1;
  For S:=0 To F4NS-1 Do If F4NSt[S].Cur<F4S[S].NPk Then Begin
   If Best<0 Then Begin Best:=S; End
   Else Begin
    Cmp:=F4NCmpTs(F4S[S].P^[F4NSt[S].Cur].Dts-ShS[S],F4NTbN[F4NSt[S].Tb],F4NTbD[
     F4NSt[S].Tb],F4S[Best].P^[F4NSt[Best].Cur].Dts-ShS[Best],F4NTbN[F4NSt[
     Best].Tb],F4NTbD[F4NSt[Best].Tb]);
    If Cmp<0 Then Best:=S;
   End;
  End;
  K:=F4NSt[Best].Cur; Inc(F4NSt[Best].Cur);
  F4NWritePacket(Best,K);
 End;
 If F4NSpN>0 Then F4NWriteIndex;
 OpenWrite(Target);
 K:=0;
 While K<F4NOut.N Do Begin
  If F4NOut.N-K>32768 Then J:=32768 Else J:=F4NOut.N-K;
  WriteBytes(F4NOut.P^[K],J); Inc(K,J);
 End;
 CloseWrite;
 F4BFree(F4NOut);
 For S:=0 To F4NS-1 Do Begin If F4NSt[S].Kf<>Nil Then FreeMem(F4NSt[S].Kf); If
  F4NIdxPos[S]<>Nil Then FreeMem(F4NIdxPos[S]); End;
 If F4NSpA<>Nil Then FreeMem(F4NSpA);
End;

{ ---- demuxeur NUT (nutdec.c) : flux et paquets vers F4S ---- }
Type TF4NDSt=Record Tb,Shift,MaxD,LastFlags: LongInt; LastPts: Int64; End;
Var
 F4NDBuf: PEABuffer; F4NDSize,F4NDPos: LongInt;
 F4NDSt: Array[0..F4MaxSt-1] Of TF4NDSt;
 F4NDFc: Array[0..255] Of TF4NFc;
 F4NDHLen: Array[0..127] Of LongInt; F4NDHPos: Array[0..127] Of LongInt; F4NDHC:
  LongInt;
 F4NDTbN,F4NDTbD: Array[0..31] Of Int64; F4NDTbC: LongInt; F4NDNs: LongInt;

Function F4NDByte: LongInt;
Begin
 If F4NDPos>=F4NDSize Then Begin F4NDByte:=0; Inc(F4NDPos); Exit; End;
 F4NDByte:=F4NDBuf^[F4NDPos]; Inc(F4NDPos);
End;
Function F4NDV: Int64;
Var R: Int64; B: LongInt; N: LongInt;
Begin
 R:=0; N:=0;
 Repeat
  B:=F4NDByte; R:=(R Shl 7) Or (B And 127); Inc(N);
 Until ((B And 128)=0) Or (N>9) Or (F4NDPos>F4NDSize);
 F4NDV:=R;
End;
Function F4NDS: Int64;
Var X: Int64;
Begin
 X:=F4NDV+1;
 If (X And 1)<>0 Then F4NDS:=-(X Shr 1) Else F4NDS:=X Shr 1;
End;

Procedure F4NDMainHeader(EndPos: LongInt);
Var Ver,I,J,Cnt,Fl,Tf,Pd,Mul,Sid,Sz,Hi,N: LongInt; K: LongInt;
Begin
 Ver:=F4NDV; If Ver>3 Then F4NDV;
 F4NDNs:=F4NDV; F4NDV; F4NDTbC:=F4NDV;
 If (F4NDNs<1) Or (F4NDNs>F4MaxSt) Or (F4NDTbC<1) Or (F4NDTbC>31) Then Fail(
  'nut: en-tete principal incorrect.');
 For I:=0 To F4NDTbC-1 Do Begin F4NDTbN[I]:=F4NDV; F4NDTbD[I]:=F4NDV; If (
  F4NDTbN[I]<1) Or (F4NDTbD[I]<1) Then Fail('nut: base de temps incorrecte.');
  End;
 FillChar(F4NDFc,SizeOf(F4NDFc),0);
 Pd:=0; Mul:=1; Sid:=0; Sz:=0; Hi:=0; I:=0;
 While I<256 Do Begin
  Fl:=F4NDV; Tf:=F4NDV; Sz:=0;
  If Tf>0 Then Pd:=F4NDS;
  If Tf>1 Then Mul:=F4NDV;
  If Tf>2 Then Sid:=F4NDV;
  If Tf>3 Then Sz:=F4NDV;
  If Tf>4 Then F4NDV;
  Cnt:=Mul-Sz;
  If Tf>5 Then Cnt:=F4NDV;
  If Tf>6 Then F4NDV;
  If Tf>7 Then Hi:=F4NDV;
  If (Cnt<=0) Or (F4NDPos>EndPos) Or (Cnt>256) Then Fail(
   'nut: table des codes incorrecte.');
  For J:=0 To Cnt-1 Do Begin
   If I=Ord('N') Then Begin F4NDFc[I].Flags:=8192; Inc(I); End;
   If I>=256 Then Break;
   F4NDFc[I].Flags:=Fl; F4NDFc[I].Sid:=Sid; F4NDFc[I].Mul:=Mul; F4NDFc[I].Lsb:=
    Sz+J; F4NDFc[I].Pd:=Pd; F4NDFc[I].Hi:=Hi;
   Inc(I);
  End;
 End;
 N:=F4NDV; F4NDHC:=N+1;
 If F4NDHC>127 Then Fail('nut: trop d''en-tetes.');
 For I:=1 To N Do Begin F4NDHLen[I]:=F4NDV; F4NDHPos[I]:=F4NDPos; Inc(F4NDPos,
  F4NDHLen[I]); End;
 F4NDHLen[0]:=0;
End;

Procedure F4NDStreamHeader;
Var Id,Cls,L,I,Tag,Ext: LongInt; S: LongInt; Tbi: LongInt; Codec: String;
Begin
 Id:=F4NDV; Cls:=F4NDV; L:=F4NDV;
 Tag:=0; For I:=0 To L-1 Do If I<4 Then Tag:=Tag Or (F4NDByte Shl (8*I)) Else
  F4NDByte;
 If (Id<0) Or (Id>=F4NDNs) Or (Cls>1) Then Begin Exit; End;
 S:=F4AddStream(Cls,'unknown');
 F4S[S].Tag:=LongWord(Tag);
 Tbi:=F4NDV; If Tbi>=F4NDTbC Then Fail(
  'nut: indice de base de temps incorrect.');
 F4NDSt[S].Tb:=Tbi; F4NDSt[S].Shift:=F4NDV; F4NDSt[S].MaxD:=F4NDV; F4NDV;
  F4NDByte;
 F4S[S].TbN:=F4NDTbN[Tbi]; F4S[S].TbD:=F4NDTbD[Tbi];
 Ext:=F4NDV;
 If (Ext<0) Or (F4NDPos+Ext>F4NDSize) Then Fail('nut: extradata incorrecte.');
 If Ext>0 Then F4SetExtra(S,@F4NDBuf^[F4NDPos],Ext);
 Inc(F4NDPos,Ext);
 If Cls=1 Then Begin
  F4S[S].Rate:=F4NDV; F4NDV; F4S[S].Chans:=F4NDV;
 End Else Begin
  F4S[S].W:=F4NDV; F4S[S].H:=F4NDV; F4S[S].SarN:=F4NDV; F4S[S].SarD:=F4NDV;
   F4NDV;
 End;
End;

Procedure F4NutParse(Const Source: String);
Var
 Sc,Pos0,Fwd,PayEnd,Fc,Fl,Sid,Hi,Sz,I,N,Rc,StartPay,Tmp: LongInt; Tt: Int64;
  Pts: Int64; Key: Boolean; Kind: Char;
 Pk: PEABuffer; Dat: PEABuffer; Q: Int64; L: LongInt; Nm,Vl: String;
Begin
 F4Reset;
 NVLoad(Source,F4NDBuf,F4NDSize);
 If F4Tag4(F4NDBuf,0)<>'nut/' Then Fail('nut: signature absente.');
 F4NDPos:=25; F4NDNs:=0; F4NDTbC:=0; FillChar(F4NDSt,SizeOf(F4NDSt),0);
 While F4NDPos<F4NDSize Do Begin
  Pos0:=F4NDPos;
  Fc:=F4NDByte;
  If Fc=Ord('N') Then Begin
   { code de debut sur 8 octets }
   Kind:=Chr(F4NDByte);
   Tmp:=F4NDByte; Tmp:=F4NDByte; Tmp:=F4NDByte; Tmp:=F4NDByte; Tmp:=F4NDByte;
    Tmp:=F4NDByte;
   Fwd:=F4NDV;
   If Fwd>4096 Then Inc(F4NDPos,4);
   StartPay:=F4NDPos; PayEnd:=StartPay+Fwd-4;
   If (Fwd<4) Or (PayEnd>F4NDSize) Then Break;
   Case Kind Of
    'M': F4NDMainHeader(PayEnd);
    'S': F4NDStreamHeader;
    'K': Begin
      Tt:=F4NDV;
      If F4NDTbC>0 Then Begin
       N:=LongInt(Tt Mod F4NDTbC); Q:=Tt Div F4NDTbC;
       For I:=0 To F4S[0].NPk*0+F4NS-1 Do
        F4NDSt[I].LastPts:=F4MulDivR(Q,F4NDTbN[N]*F4NDTbD[F4NDSt[I].Tb],F4NDTbD[
         N]*F4NDTbN[F4NDSt[I].Tb],2);
      End;
      F4NDPos:=PayEnd+4;
      { le code de trame suit directement }
      If F4NDPos>=F4NDSize Then Break;
      Fc:=F4NDByte;
      If Fc=Ord('N') Then Begin Dec(F4NDPos); Continue; End;
      Kind:='F';
    End;
    'I': Begin
      Sid:=F4NDV-1; F4NDS; F4NDV; F4NDV; N:=F4NDV;
      For I:=1 To N Do Begin
       Tmp:=F4NDV; Nm:=''; For Rc:=1 To Tmp Do Begin Fc:=F4NDByte; If Length(
        Nm)<60 Then Nm:=Nm+Chr(Fc And 255); End;
       Q:=F4NDS;
       If Q=-1 Then Begin
        Tmp:=F4NDV; Vl:=''; For Rc:=1 To Tmp Do Begin Fc:=F4NDByte; If Length(
         Vl)<60 Then Vl:=Vl+Chr(Fc And 255); End;
        If (Sid>=0) And (Sid<F4NS) Then Begin
         If Nm='encoder' Then F4S[Sid].EncTag:=Vl
         Else If Nm='r_frame_rate' Then Begin
          Rc:=Pos('/',Vl);
          If Rc>0 Then Begin Val(Copy(Vl,1,Rc-1),F4S[Sid].RN,Tmp); Val(Copy(Vl,
           Rc+1,20),F4S[Sid].RD,Tmp); F4S[Sid].AvgN:=F4S[Sid].RN; F4S[
           Sid].AvgD:=F4S[Sid].RD; End;
         End
         Else If (Nm='Disposition') And (Vl='default') Then F4S[Sid].Dflt:=True;
        End;
       End Else Break;
      End;
     End;
    Else Begin End;
   End;
   If Kind<>'F' Then Begin F4NDPos:=PayEnd+4; Continue; End;
  End;
  { trame }
  Fl:=F4NDFc[Fc].Flags;
  If (Fl And 8192)<>0 Then Fail('nut: code de trame invalide.');
  Sz:=F4NDFc[Fc].Lsb; Sid:=F4NDFc[Fc].Sid; Hi:=F4NDFc[Fc].Hi;
  If (Fl And 4096)<>0 Then Fl:=Fl Xor LongInt(F4NDV);
  If (Fl And 16)<>0 Then Sid:=F4NDV;
  If (Sid<0) Or (Sid>=F4NDNs) Or (Sid>=F4NS) Then Fail(
   'nut: flux de trame incorrect.');
  If (Fl And 8)<>0 Then Begin
   Q:=F4NDV;
   If Q<(Int64(1) Shl F4NDSt[Sid].Shift) Then Begin
    Tt:=(Int64(1) Shl F4NDSt[Sid].Shift)-1;
    Pts:=(((Q-(F4NDSt[Sid].LastPts-Tt Div 2)) And Tt))+(F4NDSt[Sid].LastPts-Tt
     Div 2);
   End Else Pts:=Q-(Int64(1) Shl F4NDSt[Sid].Shift);
  End Else Pts:=F4NDSt[Sid].LastPts+F4NDFc[Fc].Pd;
  If (Fl And 32)<>0 Then Inc(Sz,F4NDFc[Fc].Mul*LongInt(F4NDV));
  If (Fl And 2048)<>0 Then F4NDS;
  If (Fl And 1024)<>0 Then Hi:=F4NDV;
  If (Fl And 128)<>0 Then Rc:=F4NDV Else Rc:=0;
  For I:=1 To Rc Do F4NDV;
  If (Hi<0) Or (Hi>=F4NDHC) Then Fail('nut: indice d''en-tete incorrect.');
  If Sz>4096 Then Hi:=0;
  Dec(Sz,F4NDHLen[Hi]);
  If (Fl And 64)<>0 Then Inc(F4NDPos,4);
  F4NDSt[Sid].LastPts:=Pts; F4NDSt[Sid].LastFlags:=Fl;
  If (Sz<0) Or (F4NDPos+Sz>F4NDSize) Then Break;
  GetMem(Pk,Sz+F4NDHLen[Hi]+16);
  For I:=0 To F4NDHLen[Hi]-1 Do Pk^[I]:=F4NDBuf^[F4NDHPos[Hi]+I];
  Move(F4NDBuf^[F4NDPos],Pk^[F4NDHLen[Hi]],Sz);
  Inc(F4NDPos,Sz);
  F4AddPkt(Sid,Pk,Sz+F4NDHLen[Hi],Pts,Pts,0,(Fl And 1)<>0,0,0);
  FreeMem(Pk);
 End;
 FreeMem(F4NDBuf);
End;

Procedure F4NutCodecs;
Var S: LongInt; Fcc: String; T: LongWord;
Begin
 For S:=0 To F4NS-1 Do Begin
  T:=F4S[S].Tag;
  If F4S[S].Typ=0 Then Begin
   Fcc:=F4Up(Chr(T And 255)+Chr((T Shr 8) And 255)+Chr((T Shr 16) And 255)+Chr((
    T Shr 24) And 255));
   If (Fcc='FMP4') Or (Fcc='XVID') Or (Fcc='DIVX') Or (Fcc='DX50') Or (
    Fcc='MP4V') Then F4S[S].Codec:='mpeg4'
   Else If Fcc='MP43' Then F4S[S].Codec:='msmpeg4v3' Else If Fcc='MP42' Then
    F4S[S].Codec:='msmpeg4v2' Else If Fcc='MPG4' Then F4S[S].Codec:='msmpeg4v1'
   Else If Fcc='MJPG' Then F4S[S].Codec:='mjpeg' Else If Fcc='FFV1' Then F4S[
    S].Codec:='ffv1' Else If Fcc='HFYU' Then F4S[S].Codec:='huffyuv'
   Else If Fcc='FFVH' Then F4S[S].Codec:='ffvhuff' Else If Fcc='FLV1' Then F4S[
    S].Codec:='flv1' Else If Fcc='H263' Then F4S[S].Codec:='h263'
   Else If Fcc='I420' Then F4S[S].Codec:='rawvideo'
   Else Fail('nut: codec video '+Fcc+' non pris en charge pour la copie.');
   F4S[S].Bits:=24; F4S[S].PixFmt:='yuv420p'; F4S[S].Dflt:=F4S[S].Dflt;
   If F4S[S].Codec='mpeg4' Then F4S[S].ChromaLoc:=1
   Else If F4S[S].Codec='mjpeg' Then Begin F4S[S].ChromaLoc:=2; F4S[S].CRange:=
    2; F4S[S].CSpace:=5; End
   Else If F4S[S].Codec='h263' Then F4S[S].ChromaLoc:=2;
  End Else Begin
   Case T Of
    $55: Begin F4S[S].Codec:='mp3'; F4S[S].Bits:=32; End;
    $50: Begin F4S[S].Codec:='mp2'; F4S[S].Bits:=16; End;
    $2000: Begin F4S[S].Codec:='ac3'; F4S[S].Bits:=32; End;
    $FF: Begin F4S[S].Codec:='aac'; F4S[S].Bits:=32; If (F4S[S].NPk>0) And (F4S[
     S].ExtraLen=0) And (F4S[S].P^[0].Len>2) And (F4S[S].Data^[F4S[S].P^[
     0].Pos]=$FF) Then F4S[S].Adts:=True; End;
    $F1AC: Begin F4S[S].Codec:='flac'; F4S[S].Bits:=16; End;
    $10445350: Begin F4S[S].Codec:='pcm_s16le'; F4S[S].Bits:=16; End;
    $08445550: Begin F4S[S].Codec:='pcm_u8'; F4S[S].Bits:=8; End;
    $18445350: Begin F4S[S].Codec:='pcm_s24le'; F4S[S].Bits:=24; End;
    $20445350: Begin F4S[S].Codec:='pcm_s32le'; F4S[S].Bits:=32; End;
    $20444650: Begin F4S[S].Codec:='pcm_f32le'; F4S[S].Bits:=32; End;
    Else Fail('nut: codec audio non pris en charge pour la copie.');
   End;
   F4S[S].Tag:=0;
  End;
 End;
End;

Procedure F4MkvFromNut(Const Source,Target: String; Webm: Boolean);
Begin
 F4NutParse(Source);
 F4NutCodecs;
 F4MuxOut(Target,Webm);
 F4Reset;
End;

{ ---- NUT : conversion d'un flux vers un AVI / flux elementaire / WAV
 temporaire ---- }
Procedure F4PjWriteAll(Const Tmp: String; S: LongInt; Mode: LongInt; Sr,Ch,Prof,
 Sri: LongInt);
Var K,L,N,P0,Q: LongInt; B7: Array[0..6] Of Byte; Hdr: Array[0..43] Of Byte;
 Tot: LongInt; Bits,Fl,Ba: LongInt;
Procedure P32(At,X: LongInt);Begin Hdr[At]:=X And 255; Hdr[At+1]:=(X Shr 8) And
 255; Hdr[At+2]:=(X Shr 16) And 255; Hdr[At+3]:=(X Shr 24) And 255; End;
Procedure P16(At,X: LongInt);Begin Hdr[At]:=X And 255; Hdr[At+1]:=(X Shr 8) And
 255; End;
Begin
 OpenWrite(Tmp);
 If Mode=3 Then Begin
  { WAV PCM }
  Tot:=F4S[S].DataLen;
  If F4S[S].Codec='pcm_u8' Then Bits:=8 Else If F4S[S].Codec='pcm_s24le' Then
   Bits:=24 Else If (F4S[S].Codec='pcm_s32le') Or (F4S[S].Codec='pcm_f32le')
   Then Bits:=32 Else If F4S[S].Codec='pcm_f64le' Then Bits:=64 Else Bits:=16;
  If Copy(F4S[S].Codec,1,5)='pcm_f' Then Fl:=3 Else Fl:=1;
  Ba:=Ch*(Bits Div 8);
  Hdr[0]:=82; Hdr[1]:=73; Hdr[2]:=70; Hdr[3]:=70; P32(4,36+Tot); Hdr[8]:=87;
   Hdr[9]:=65; Hdr[10]:=86; Hdr[11]:=69;
  Hdr[12]:=102; Hdr[13]:=109; Hdr[14]:=116; Hdr[15]:=32; P32(16,16); P16(20,Fl);
   P16(22,Ch); P32(24,Sr); P32(28,Sr*Ba); P16(32,Ba); P16(34,Bits);
  Hdr[36]:=100; Hdr[37]:=97; Hdr[38]:=116; Hdr[39]:=97; P32(40,Tot);
  WriteBytes(Hdr,44);
 End;
 If Mode=2 Then Begin
  { FLAC : fLaC + bloc STREAMINFO }
  Hdr[0]:=$66; Hdr[1]:=$4C; Hdr[2]:=$61; Hdr[3]:=$43; Hdr[4]:=$80; Hdr[5]:=0;
   Hdr[6]:=0; Hdr[7]:=34;
  WriteBytes(Hdr,8);
  If F4S[S].ExtraLen>=34 Then WriteBytes(F4S[S].Extra^,34);
 End;
 For K:=0 To F4S[S].NPk-1 Do Begin
  P0:=F4S[S].P^[K].Pos; L:=F4S[S].P^[K].Len;
  If Mode=1 Then Begin
   N:=L+7;
   B7[0]:=$FF; B7[1]:=$F1; B7[2]:=((Prof And 3) Shl 6) Or (Sri Shl 2) Or ((Ch
    Shr 2) And 1);
   B7[3]:=((Ch And 3) Shl 6) Or ((N Shr 11) And 3); B7[4]:=(N Shr 3) And 255;
    B7[5]:=((N And 7) Shl 5) Or $1F; B7[6]:=$FC;
   WriteBytes(B7,7);
  End;
  Q:=0;
  While Q<L Do Begin
   N:=L-Q; If N>32768 Then N:=32768;
   WriteBytes(F4S[S].Data^[P0+Q],N); Inc(Q,N);
  End;
 End;
 CloseWrite;
End;

Procedure F4NutDemux(Var Inter: String);
Var
 S,I,T,Cnt,Rate,Scale,Bpp,Mode,Ch,Sr,Prof,Sri,Q,L,Cn: LongInt; IsVid: Boolean;
  Fcc,Tmp,Kind: String; Fps: Double; Tag: LongWord;
 Ext: PEABuffer; Buf: PEABuffer; Tb: Double; First,Last: Int64; Ws: String;
Begin
 If Not ((OutputFormat='yuv4mpegpipe') Or (OutputFormat='png') Or (
  OutputFormat='bmp') Or (OutputFormat='wav') Or (OutputFormat='mp3') Or
  (OutputFormat='mp2') Or (OutputFormat='ac3') Or (OutputFormat='aac') Or (
   OutputFormat='aiff') Or (OutputFormat='ogg') Or (OutputFormat='adx')) Then
   Exit;
 IsVid:=(OutputFormat='yuv4mpegpipe') Or (OutputFormat='png') Or (
  OutputFormat='bmp');
 F4NutParse(InputPath);
 T:=-1;
 For I:=0 To F4NS-1 Do If (T<0) And (((F4S[I].Typ=0) And IsVid) Or ((F4S[
  I].Typ=1) And Not IsVid)) Then T:=I;
 If T<0 Then Fail('nut: aucun flux du type demande.');
 Tmp:=NewTemporary; Temps[5]:=Tmp;
 Tag:=F4S[T].Tag;
 If IsVid Then Begin
  Fcc:=Chr(Tag And 255)+Chr((Tag Shr 8) And 255)+Chr((Tag Shr 16) And 255)+Chr((
   Tag Shr 24) And 255);
  Bpp:=24; Cnt:=F4S[T].NPk;
  First:=0; Last:=0;
  If Cnt>0 Then Begin First:=F4S[T].P^[0].Pts; Last:=F4S[T].P^[Cnt-1].Pts; End;
  Tb:=F4S[T].TbN; Tb:=Tb/F4S[T].TbD;
  If (Cnt>1) And (Last>First) Then Fps:=(Cnt-1)/((Last-First)*Tb) Else Fps:=25;
  F4MkRational(Rate,Scale,Fps);
  Ext:=Nil; L:=0;
  If (F4S[T].ExtraLen>0) And Not ((Fcc='FMP4') Or (Fcc='H264') Or (Fcc='XVID')
   Or (Fcc='DIVX') Or (Fcc='DX50') Or (Fcc='MP4V') Or (Fcc='mp4v') Or (
   Fcc='avc1') Or (Fcc='AVC1') Or (Fcc='X264')) Then Begin
   GetMem(Ext,F4S[T].ExtraLen+16); Move(F4S[T].Extra^,Ext^,F4S[T].ExtraLen); L:=
    F4S[T].ExtraLen;
  End;
  AWBegin(Tmp,Fcc,F4S[T].W,F4S[T].H,Rate,Scale,Bpp,Ext,L);
  For I:=0 To F4S[T].NPk-1 Do Begin
   Q:=0;
   If (I=0) And (L=0) And (F4S[T].ExtraLen>0) Then Q:=F4S[T].ExtraLen;
   GetMem(Buf,F4S[T].P^[I].Len+Q+16);
   If Q>0 Then Move(F4S[T].Extra^,Buf^,Q);
   Move(F4S[T].Data^[F4S[T].P^[I].Pos],Buf^[Q],F4S[T].P^[I].Len);
   AWFrame(Buf,F4S[T].P^[I].Len+Q); FreeMem(Buf);
  End;
  AWEnd;
  Kind:='avi';
 End Else Begin
  Sr:=F4S[T].Rate; Ch:=F4S[T].Chans; Prof:=1; Sri:=4;
  Mode:=0;
  Case Tag Of
   $55: Kind:='mp3'; $50: Kind:='mp2'; $2000: Kind:='ac3';
   $FF: Begin Kind:='aac'; Mode:=1; End;
   $F1AC: Begin Kind:='flac'; Mode:=2; End;
   $10445350: Begin F4S[T].Codec:='pcm_s16le'; Kind:='wav'; Mode:=3; End;
   $08445550: Begin F4S[T].Codec:='pcm_u8'; Kind:='wav'; Mode:=3; End;
   $18445350: Begin F4S[T].Codec:='pcm_s24le'; Kind:='wav'; Mode:=3; End;
   $20445350: Begin F4S[T].Codec:='pcm_s32le'; Kind:='wav'; Mode:=3; End;
   $20444650: Begin F4S[T].Codec:='pcm_f32le'; Kind:='wav'; Mode:=3; End;
   Else Fail('nut: codec audio non pris en charge.');
  End;
  If Mode=1 Then Begin
   { paquets bruts + AudioSpecificConfig, ou ADTS deja present }
   If (F4S[T].NPk>0) And (F4S[T].P^[0].Len>2) And (F4S[T].Data^[F4S[T].P^[
    0].Pos]=$FF) And ((F4S[T].Data^[F4S[T].P^[0].Pos+1] And $F0)=$F0) Then
    Mode:=0
   Else Begin
    If F4S[T].ExtraLen<2 Then Fail('nut: AudioSpecificConfig AAC absent.');
    Prof:=(F4S[T].Extra^[0] Shr 3)-1; Sri:=((F4S[T].Extra^[0] And 7) Shl 1) Or (
     F4S[T].Extra^[1] Shr 7); Ch:=(F4S[T].Extra^[1] Shr 3) And 15;
   End;
  End;
  F4PjWriteAll(Tmp,T,Mode,Sr,Ch,Prof,Sri);
 End;
 L:=F4NS; F4Reset;
 Inter:=Tmp; InputPath:=Tmp; InputFormat:=Kind;
End;

{ ---- Matroska -> flux (copie de Matroska/WebM vers Matroska/NUT) ---- }
Function F4EbNext(Var At: LongInt; Fin: LongInt; Var Id: Int64; Var DAt,DLen:
 LongInt; Var Unk: Boolean): Boolean;
Var L1,L2: LongInt; Sz: Int64;
Begin
 F4EbNext:=False; Unk:=False;
 If At>=Fin Then Exit;
 Id:=MKId(At,L1); If L1=0 Then Exit;
 Sz:=MKVint(At+L1,L2); If L2=0 Then Exit;
 DAt:=At+L1+L2;
 If Sz<0 Then Begin Unk:=True; DLen:=Fin-DAt; End
 Else Begin
  DLen:=LongInt(Sz); If (Sz>Fin-DAt) Then DLen:=Fin-DAt;
 End;
 At:=DAt+DLen;
 F4EbNext:=True;
End;

Procedure F4MkvStreams(Const Source: String);
Type TTr=Record
  Num,Typ,Dflt,Fo9A,Fo9D,Dw,Dh,Du,PrivAt,PrivLen,W,H,Ch,Bits,S: LongInt; Uid,
   DefDur,Delay,First,CumAll: Int64; HaveFirst: Boolean; Rate: Double;
  Codec: String[40]; Name,Lang: String[64]; Enc: String[64]; CSpace: LongWord;
   HasCs: Boolean;
  Trc,Mat,Pri,Rng,Sx,Sy,StripAt,StripLen: LongInt;
 End;
Var
 Tr: Array[0..F4MaxSt-1] Of TTr; NT,I,J,K,At,A2,A3,A4,Seg,SegEnd,Da,Dl,D2,L2,D3,
  L3,D4,L4,Bt,Fl,Lacing,Tn,Ts: LongInt; Id,Id2,Id3,Id4,Id5: Int64; Unk,U2,U3,U4,
  U5: Boolean; A5,D5,L5: LongInt; Algo: Int64;
 Scale,ClTime,Dur,TcAbs: Int64; Fcc,Cd: String; St: LongInt; Ext: PEABuffer;
 HaveBlk,Key: Boolean; BAt,BLen,BDur,BDisc: Int64; Ref: Boolean; Sar_n,Sar_d:
  Int64; MinPts: Int64; Pk: Int64;
 TagUid: Int64; TagEnc: String; TagName: String; Xl,Xl2,Xs,Xc,Xf,Xg: LongInt;
Procedure MetaAdd(Uid: Int64; Const Nm,Vl: String);
Var Q: LongInt;
Begin
 If Uid=0 Then Exit;
 For Q:=0 To NT-1 Do If Tr[Q].Uid=Uid Then With F4S[Tr[Q].S] Do Begin
  If MetaN<4 Then Begin MetaK[MetaN]:=Nm; MetaV[MetaN]:=Vl; Inc(MetaN); End;
  If Nm='ENCODER' Then EncTag:=Vl;
 End;
End;
Procedure DoBlock(DatA,DatL: LongInt; Cl,BlkDur,Disc: Int64; IsKey: Boolean);
Var Ln,Ti,Rel,Flg,Sk,Lacing,Laces,N,P0,PE,Ln2,Sum,SzN: LongInt; Num,PtsT,D,LD,
 Dv,Sg: Int64; Sizes: Array[0..255] Of LongInt; Buf: PEABuffer; St2,Cc: LongInt;
 Pts0,CumS: Int64;
Begin
 Num:=MKVint(DatA,Ln); If Ln=0 Then Exit;
 Ti:=-1; For Sk:=0 To NT-1 Do If Tr[Sk].Num=Num Then Ti:=Sk;
 If (Ti<0) Or (DatL<Ln+4) Then Exit;
 Rel:=MKB(DatA+Ln)*256+MKB(DatA+Ln+1); If Rel>=32768 Then Dec(Rel,65536);
 Flg:=MKB(DatA+Ln+2);
 PtsT:=Cl+Rel;
 If (Flg And 128)<>0 Then IsKey:=True;
 If PtsT<MinPts Then MinPts:=PtsT;
 St2:=Tr[Ti].S;
 If Not Tr[Ti].HaveFirst Then Begin Tr[Ti].HaveFirst:=True; Tr[Ti].First:=PtsT;
  End;
 P0:=DatA+Ln+3; PE:=DatA+DatL;
 Lacing:=(Flg And 6) Shr 1; Laces:=1;
 If Lacing<>0 Then Begin
  Laces:=MKB(P0)+1; Inc(P0);
  Case Lacing Of
   1: Begin
     Sum:=0;
     For N:=0 To Laces-2 Do Begin
      SzN:=0;
      Repeat
       If P0>=PE Then Exit;
       Cc:=MKB(P0); Inc(P0); Inc(SzN,Cc);
      Until Cc<>255;
      Sizes[N]:=SzN; Inc(Sum,SzN);
     End;
     If Sum>PE-P0 Then Exit;
     Sizes[Laces-1]:=PE-P0-Sum;
    End;
   2: Begin
     If (PE-P0) Mod Laces<>0 Then Exit;
     For N:=0 To Laces-1 Do Sizes[N]:=(PE-P0) Div Laces;
    End;
   3: Begin
     Sg:=MKVint(P0,Ln2); If Ln2=0 Then Exit;
     Inc(P0,Ln2); Sizes[0]:=Sg; Sum:=Sizes[0];
     For N:=1 To Laces-2 Do Begin
      Sg:=MKVint(P0,Ln2); If Ln2=0 Then Exit;
      Inc(P0,Ln2);
      Sg:=Sg-((Int64(1) Shl (7*Ln2-1))-1);
      Sizes[N]:=Sizes[N-1]+LongInt(Sg); If Sizes[N]<0 Then Exit;
      Inc(Sum,Sizes[N]);
     End;
     If Sum>PE-P0 Then Exit;
     Sizes[Laces-1]:=PE-P0-Sum;
    End;
  End;
 End Else Sizes[0]:=PE-P0;
 D:=BlkDur; Pts0:=PtsT; CumS:=0;
 If (D=0) And (Tr[Ti].DefDur>0) Then D:=Tr[Ti].DefDur*Laces Div Scale;
 For N:=0 To Laces-1 Do Begin
  LD:=D*(N+1) Div Laces-D*N Div Laces;
  Dv:=LD;
  If (Tr[Ti].Typ=2) And ((F4S[St2].Codec='mp2') Or (F4S[St2].Codec='mp3') Or (
   F4S[St2].Codec='mp1') Or (F4S[St2].Codec='ac3') Or (F4S[St2].Codec='aac') Or
   (F4S[St2].Codec='flac')) Then Dv:=0;
  If (Dv=0) And (Tr[Ti].Typ=2) Then Begin
   Sk:=F4AudioPktSamples(F4S[St2].Codec,F4S[St2].Rate,F4S[St2].Chans,Sizes[N]);
   If F4S[St2].Codec='flac' Then F4FlacHdr(PEABuffer(@MKF^[P0]),0,Sizes[N],Sk);
   If Sk>0 Then Dv:=F4MulDivR(Sk,1000000000 Div Scale,F4S[St2].Rate,0);
  End;
  Sk:=0;
  If (Disc>0) And (Tr[Ti].Typ=2) And (N=Laces-1) Then Sk:=LongInt(F4MulDivR(
   Disc,F4S[St2].Rate,1000000000,4));
  If F4S[St2].Codec='h263' Then IsKey:=True;
  If Sizes[N]>0 Then Begin
   GetMem(Buf,Sizes[N]+Tr[Ti].StripLen+16);
   If Tr[Ti].StripLen>0 Then Move(MKF^[Tr[Ti].StripAt],Buf^,Tr[Ti].StripLen);
   Move(MKF^[P0],Buf^[Tr[Ti].StripLen],Sizes[N]);
   F4AddPkt(St2,Buf,Sizes[N]+Tr[Ti].StripLen,PtsT,PtsT,Dv,IsKey,0,Sk);
   FreeMem(Buf);
  End;
  Inc(P0,Sizes[N]);
  If Tr[Ti].Typ=2 Then Inc(Tr[Ti].CumAll,F4AudioPktSamples(F4S[St2].Codec,F4S[
   St2].Rate,F4S[St2].Chans,Sizes[N]));
  If LD<>0 Then Inc(PtsT,LD)
  Else If (Tr[Ti].Typ=2) And (F4S[St2].Rate>0) Then Begin
   { pas de duree de bloc : horodatage exact d'apres les echantillons accumules
    }
   PtsT:=Tr[Ti].First+F4MulDivR(Tr[Ti].CumAll,1000000000 Div Scale,F4S[
    St2].Rate,4);
  End;
 End;
End;
Procedure Cluster(CA,CE: LongInt);
Var P,Da2,Dl2,Pa,Pe,Da3,Dl3,Aa: LongInt; I1,I2: Int64; Uk1,Uk2: Boolean; Cl2,Bd,
 Dsc: Int64; Bat,Bl: LongInt; Have,Refd: Boolean;
Begin
 Cl2:=0; P:=CA;
 While F4EbNext(P,CE,I1,Da2,Dl2,Uk1) Do Begin
  If Uk1 And ((I1=$1F43B675) Or (I1=$1C53BB6B)) Then Break;
  Case I1 Of
   $E7: Cl2:=MKUInt(Da2,Dl2);
   $A3: DoBlock(Da2,Dl2,Cl2,0,0,False);
   $A0: Begin
     Pa:=Da2; Pe:=Da2+Dl2; Bd:=0; Dsc:=0; Have:=False; Refd:=False; Bat:=0; Bl:=
      0;
     While F4EbNext(Pa,Pe,I2,Da3,Dl3,Uk2) Do Begin
      Case I2 Of
       $A1: Begin Have:=True; Bat:=Da3; Bl:=Dl3; End;
       $9B: Bd:=MKUInt(Da3,Dl3);
       $75A2: Dsc:=MKSInt(Da3,Dl3);
       $FB: Refd:=True;
      End;
     End;
     If Have Then DoBlock(Bat,Bl,Cl2,Bd,Dsc,Not Refd);
    End;
  End;
 End;
End;
Begin
 F4Reset;
 NVLoad(Source,MKF,MKSize);
 NT:=0; Scale:=1000000; MinPts:=High(Int64);
 At:=0;
 If (MKB(0)<>$1A) Or (MKB(1)<>$45) Or (MKB(2)<>$DF) Or (MKB(3)<>$A3) Then Fail(
  'matroska: en-tete EBML absent.');
 If Not F4EbNext(At,MKSize,Id,Da,Dl,Unk) Then Fail(
  'matroska: en-tete EBML invalide.');
 If Not F4EbNext(At,MKSize,Id,Seg,Dl,Unk) Or (Id<>$18538067) Then Fail(
  'matroska: segment absent.');
 SegEnd:=Seg+Dl;
 { premiere passe : Info, Tracks, Tags }
 A2:=Seg;
 While F4EbNext(A2,SegEnd,Id,Da,Dl,Unk) Do Begin
  If Id=$1549A966 Then Begin
   A3:=Da;
   While F4EbNext(A3,Da+Dl,Id2,D2,L2,U2) Do If Id2=$2AD7B1 Then Scale:=MKUInt(
    D2,L2);
  End Else If Id=$1654AE6B Then Begin
   A3:=Da;
   While F4EbNext(A3,Da+Dl,Id2,D2,L2,U2) Do If (Id2=$AE) And (NT<F4MaxSt) Then
    Begin
    FillChar(Tr[NT],SizeOf(Tr[NT]),0); Tr[NT].Dflt:=1; Tr[NT].Lang:='und'; Tr[
     NT].Rate:=8000; Tr[NT].Ch:=1;
    Tr[NT].Trc:=2; Tr[NT].Mat:=2; Tr[NT].Pri:=2;
    A4:=D2;
    While F4EbNext(A4,D2+L2,Id3,D3,L3,U3) Do Begin
     Case Id3 Of
      $D7: Tr[NT].Num:=MKUInt(D3,L3);
      $73C5: Tr[NT].Uid:=MKUInt(D3,L3);
      $83: Tr[NT].Typ:=MKUInt(D3,L3);
      $88: Tr[NT].Dflt:=MKUInt(D3,L3);
      $536E: Begin Tr[NT].Name:=''; For K:=0 To L3-1 Do If K<63 Then Tr[
       NT].Name:=Tr[NT].Name+Chr(MKB(D3+K)); End;
      $22B59C: Begin Tr[NT].Lang:=''; For K:=0 To L3-1 Do If K<63 Then Tr[
       NT].Lang:=Tr[NT].Lang+Chr(MKB(D3+K)); End;
      $86: Begin Tr[NT].Codec:=''; For K:=0 To L3-1 Do If (K<39) And (MKB(D3+
       K)<>0) Then Tr[NT].Codec:=Tr[NT].Codec+Chr(MKB(D3+K)); End;
      $63A2: Begin Tr[NT].PrivAt:=D3; Tr[NT].PrivLen:=L3; End;
      $23E383: Tr[NT].DefDur:=MKUInt(D3,L3);
      $56AA: Tr[NT].Delay:=MKUInt(D3,L3);
      $6D80: Begin
        K:=D3;
        While F4EbNext(K,D3+L3,Id4,D4,L4,U4) Do If Id4=$6240 Then Begin
         J:=D4;
         While F4EbNext(J,D4+L4,Id,Da,Dl,Unk) Do If Id=$5034 Then Begin
          A5:=Da; Algo:=0;
          While F4EbNext(A5,Da+Dl,Id5,D5,L5,U5) Do Begin
           If Id5=$4254 Then Algo:=MKUInt(D5,L5) Else If Id5=$4255 Then Begin
            Tr[NT].StripAt:=D5; Tr[NT].StripLen:=L5; End;
          End;
          If Algo<>3 Then Fail(
           'matroska: ContentEncodings (zlib/bzlib/lzo/chiffrement) non pris e'+
           'n charge.');
         End Else If Id=$5035 Then Fail(
          'matroska: ContentEncodings chiffres non pris en charge.');
        End;
       End;
      $E0: Begin
        K:=D3;
        While F4EbNext(K,D3+L3,Id4,D4,L4,U4) Do Begin
         Case Id4 Of
          $B0: Tr[NT].W:=MKUInt(D4,L4); $BA: Tr[NT].H:=MKUInt(D4,L4);
          $9A: Tr[NT].Fo9A:=MKUInt(D4,L4); $9D: Tr[NT].Fo9D:=MKUInt(D4,L4);
          $54B0: Tr[NT].Dw:=MKUInt(D4,L4); $54BA: Tr[NT].Dh:=MKUInt(D4,L4);
           $54B2: Tr[NT].Du:=MKUInt(D4,L4);
          $2EB524: Begin Tr[NT].CSpace:=LongWord(MKB(D4))+LongWord(MKB(D4+1))*
           256+LongWord(MKB(D4+2))*65536+LongWord(MKB(D4+3))*16777216; Tr[
           NT].HasCs:=True; End;
          $55B0: Begin
            J:=D4;
            While F4EbNext(J,D4+L4,Id,Da,Dl,Unk) Do Begin
             Case Id Of
              $55BA: Tr[NT].Trc:=MKUInt(Da,Dl); $55B1: Tr[NT].Mat:=MKUInt(Da,
               Dl); $55BB: Tr[NT].Pri:=MKUInt(Da,Dl);
              $55B9: Tr[NT].Rng:=MKUInt(Da,Dl); $55B7: Tr[NT].Sx:=MKUInt(Da,Dl);
               $55B8: Tr[NT].Sy:=MKUInt(Da,Dl);
             End;
            End;
           End;
         End;
        End;
       End;
      $E1: Begin
        K:=D3;
        While F4EbNext(K,D3+L3,Id4,D4,L4,U4) Do Begin
         Case Id4 Of
          $B5: Tr[NT].Rate:=MKFloat(D4,L4); $9F: Tr[NT].Ch:=MKUInt(D4,L4);
           $6264: Tr[NT].Bits:=MKUInt(D4,L4);
         End;
        End;
       End;
     End;
    End;
    Inc(NT);
   End;
  End;
 End;
 If NT=0 Then Fail('matroska: aucune piste.');
 { creation des flux }
 For I:=0 To NT-1 Do Begin
  Cd:=Tr[I].Codec; Fcc:=''; St:=-1;
  If Tr[I].Typ=1 Then Begin
   If Cd='V_MPEG4/ISO/ASP' Then Fcc:='mpeg4' Else If Cd='V_MPEG4/MS/V3' Then
    Fcc:='msmpeg4v3' Else If Cd='V_MJPEG' Then Fcc:='mjpeg'
   Else If Cd='V_MPEG4/ISO/AVC' Then Fcc:='h264' Else If Cd='V_MPEG1' Then Fcc:=
    'mpeg1video' Else If Cd='V_MPEG2' Then Fcc:='mpeg2video'
   Else If Cd='V_UNCOMPRESSED' Then Fcc:='rawvideo' Else If Cd='V_MS/VFW/FOURCC'
    Then Begin
    If Tr[I].PrivLen<40 Then Fail('matroska: BITMAPINFOHEADER absent.');
    Fcc:=F4Up(Chr(MKB(Tr[I].PrivAt+16))+Chr(MKB(Tr[I].PrivAt+17))+Chr(MKB(Tr[
     I].PrivAt+18))+Chr(MKB(Tr[I].PrivAt+19)));
    If Fcc='FFV1' Then Fcc:='ffv1' Else If Fcc='HFYU' Then Fcc:='huffyuv' Else
     If Fcc='FFVH' Then Fcc:='ffvhuff' Else If Fcc='FLV1' Then Fcc:='flv1'
    Else If Fcc='H263' Then Fcc:='h263' Else If Fcc='MP42' Then Fcc:='msmpeg4v2'
     Else If Fcc='MPG4' Then Fcc:='msmpeg4v1'
    Else If (Fcc='FMP4') Or (Fcc='XVID') Or (Fcc='DIVX') Or (Fcc='DX50') Then
     Fcc:='mpeg4'
    Else If Fcc='MJPG' Then Fcc:='mjpeg' Else Fcc:='';
   End;
   If Fcc='' Then Fail('matroska: codec video '+Cd+
    ' non pris en charge pour la copie.');
   St:=F4AddStream(0,Fcc);
   F4S[St].W:=Tr[I].W; F4S[St].H:=Tr[I].H;
   If Cd='V_MS/VFW/FOURCC' Then Begin
    F4S[St].Tag:=LongWord(MKB(Tr[I].PrivAt+16))+LongWord(MKB(Tr[I].PrivAt+17))*
     256+LongWord(MKB(Tr[I].PrivAt+18))*65536+LongWord(MKB(Tr[I].PrivAt+19))*
     16777216;
    F4S[St].Bits:=MKB(Tr[I].PrivAt+14)+MKB(Tr[I].PrivAt+15)*256;
    If Tr[I].PrivLen>40 Then F4SetExtra(St,@MKF^[Tr[I].PrivAt+40],Tr[I].PrivLen-
     40);
   End Else Begin
    If Tr[I].HasCs Then F4S[St].Tag:=Tr[I].CSpace;
    If Tr[I].PrivLen>0 Then F4SetExtra(St,@MKF^[Tr[I].PrivAt],Tr[I].PrivLen);
   End;
   If Tr[I].Fo9A=2 Then F4S[St].FieldOrder:=1
   Else If Tr[I].Fo9A=1 Then Begin
    Case Tr[I].Fo9D Of 1: F4S[St].FieldOrder:=2; 6: F4S[St].FieldOrder:=3; 9:
     F4S[St].FieldOrder:=4; 14: F4S[St].FieldOrder:=5; End;
   End;
   If (Tr[I].Dw>0) And (Tr[I].Dh>0) And (Tr[I].W>0) And (Tr[I].H>0) Then Begin
    F4Reduce(Sar_n,Sar_d,Int64(Tr[I].H)*Tr[I].Dw,Int64(Tr[I].W)*Tr[I].Dh,
     2147483647);
    F4S[St].SarN:=Sar_n; F4S[St].SarD:=Sar_d;
   End;
   If (Tr[I].Dw=0) Or (Tr[I].Dh=0) Then Begin Tr[I].Dw:=Tr[I].W; Tr[I].Dh:=Tr[
    I].H; End;
   F4Reduce(Sar_n,Sar_d,Int64(Tr[I].H)*Tr[I].Dw,Int64(Tr[I].W)*Tr[I].Dh,
    2147483647);
   F4S[St].SarN:=Sar_n; F4S[St].SarD:=Sar_d;
   F4S[St].CTrc:=Tr[I].Trc; F4S[St].CSpace:=Tr[I].Mat; F4S[St].CPri:=Tr[I].Pri;
    F4S[St].CRange:=Tr[I].Rng;
   If (Tr[I].Sx=1) And (Tr[I].Sy=2) Then F4S[St].ChromaLoc:=1 Else If (Tr[
    I].Sx=2) And (Tr[I].Sy=2) Then F4S[St].ChromaLoc:=2
   Else If (Tr[I].Sx=1) And (Tr[I].Sy=1) Then F4S[St].ChromaLoc:=3 Else If (Tr[
    I].Sx=2) And (Tr[I].Sy=1) Then F4S[St].ChromaLoc:=4;
   If Tr[I].DefDur>0 Then Begin
    F4Reduce(F4S[St].AvgN,F4S[St].AvgD,1000000000,Tr[I].DefDur,30000);
    F4S[St].RN:=F4S[St].AvgN; F4S[St].RD:=F4S[St].AvgD;
   End;
   F4S[St].PixFmt:='yuv420p';
   If Fcc='mpeg4' Then F4S[St].ChromaLoc:=1
   Else If Fcc='mjpeg' Then Begin F4S[St].ChromaLoc:=2; F4S[St].CRange:=2; F4S[
    St].CSpace:=5; End
   Else If Fcc='h263' Then F4S[St].ChromaLoc:=2;
  End Else If Tr[I].Typ=2 Then Begin
   If Cd='A_MPEG/L3' Then Fcc:='mp3' Else If Cd='A_MPEG/L2' Then Fcc:='mp2' Else
    If Cd='A_MPEG/L1' Then Fcc:='mp1'
   Else If Cd='A_AC3' Then Fcc:='ac3' Else If Cd='A_EAC3' Then Fcc:='eac3' Else
    If Cd='A_AAC' Then Fcc:='aac'
   Else If Cd='A_FLAC' Then Fcc:='flac' Else If Cd='A_VORBIS' Then Fcc:='vorbis'
    Else If Cd='A_DTS' Then Fcc:='dts'
   Else If Cd='A_PCM/INT/LIT' Then Begin
    Case Tr[I].Bits Of 8: Fcc:='pcm_u8'; 16: Fcc:='pcm_s16le'; 24: Fcc:=
     'pcm_s24le'; 32: Fcc:='pcm_s32le'; End;
   End Else If Cd='A_PCM/FLOAT/IEEE' Then Begin If Tr[I].Bits=64 Then Fcc:=
    'pcm_f64le' Else Fcc:='pcm_f32le'; End;
   If Fcc='' Then Fail('matroska: codec audio '+Cd+
    ' non pris en charge pour la copie.');
   St:=F4AddStream(1,Fcc);
   F4S[St].Rate:=Round(Tr[I].Rate); F4S[St].Chans:=Tr[I].Ch; F4S[St].Bits:=Tr[
    I].Bits;
   If (Fcc='mp2') or (Fcc='mp1') Then F4S[St].Bits:=16 Else If (Fcc='mp3') Or (
    Fcc='ac3') Or (Fcc='eac3') Or (Fcc='aac') Or (Fcc='vorbis') Then F4S[
    St].Bits:=32;
   If Tr[I].PrivLen>0 Then Begin
    If (Fcc='flac') And (Tr[I].PrivLen>=42) Then F4SetExtra(St,@MKF^[Tr[
     I].PrivAt+8],34)
    Else F4SetExtra(St,@MKF^[Tr[I].PrivAt],Tr[I].PrivLen);
   End;
   If Tr[I].Delay>0 Then F4S[St].InitPad:=LongInt(F4MulDivR(Tr[I].Delay,F4S[
    St].Rate,1000000000,4));
  End Else Fail(
   'matroska: seules les pistes audio et video sont prises en charge.');
  Tr[I].S:=St;
  F4S[St].Dflt:=Tr[I].Dflt<>0; F4S[St].Lang:=Tr[I].Lang; F4S[St].Title:=Tr[
   I].Name;
  F4S[St].TbN:=Scale; F4S[St].TbD:=1000000000;
  J:=F4Gcd(F4S[St].TbN,F4S[St].TbD); F4S[St].TbN:=F4S[St].TbN Div J; F4S[
   St].TbD:=F4S[St].TbD Div J;
 End;
 { Tags : ENCODER par piste }
 A2:=Seg;
 While F4EbNext(A2,SegEnd,Id,Da,Dl,Unk) Do Begin
  If Id=$1254C367 Then Begin
   A3:=Da;
   While F4EbNext(A3,Da+Dl,Id2,D2,L2,U2) Do If Id2=$7373 Then Begin
    TagUid:=0; TagEnc:='';
    A4:=D2;
    While F4EbNext(A4,D2+L2,Id3,D3,L3,U3) Do Begin
     If Id3=$63C0 Then Begin
      K:=D3;
      While F4EbNext(K,D3+L3,Id4,D4,L4,U4) Do If Id4=$63C5 Then TagUid:=MKUInt(
       D4,L4);
     End Else If Id3=$67C8 Then Begin
      K:=D3; TagName:='';
      While F4EbNext(K,D3+L3,Id4,D4,L4,U4) Do Begin
       If Id4=$45A3 Then Begin TagName:=''; For J:=0 To L4-1 Do If J<60 Then
        TagName:=TagName+Chr(MKB(D4+J)); End
       Else If Id4=$4487 Then Begin
        TagEnc:=''; For J:=0 To L4-1 Do If (J<60) And Not ((J=L4-1) And (MKB(D4+
         J)=0)) Then TagEnc:=TagEnc+Chr(MKB(D4+J));
        MetaAdd(TagUid,TagName,TagEnc);
       End;
      End;
     End;
    End;
   End;
  End;
 End;
 { paquets }
 A2:=Seg;
 While F4EbNext(A2,SegEnd,Id,Da,Dl,Unk) Do Begin
  If Id=$1F43B675 Then Begin
   If Unk Then Begin
    { fin de cluster : prochain element de premier niveau }
    K:=Da;
    While K<SegEnd Do Begin
     Id2:=MKId(K,L2); If L2=0 Then Begin Inc(K); Continue; End;
     If (K>Da) And MKIsTop(Id2) Then Break;
     D2:=LongInt(MKVint(K+L2,L3)); If (L3=0) Or (D2<0) Then Begin Inc(K);
      Continue; End;
     Inc(K,L2+L3+D2);
    End;
    Cluster(Da,K); A2:=K;
   End Else Cluster(Da,Da+Dl);
  End;
 End;
 { debit et alignement de bloc (utilises par NUT) }
 For I:=0 To F4NS-1 Do If F4S[I].Typ=1 Then Begin
  If Copy(F4S[I].Codec,1,4)='pcm_' Then F4S[I].BlockAlign:=F4S[I].Chans*(F4S[
   I].Bits Div 8);
  If ((F4S[I].Codec='mp3') Or (F4S[I].Codec='mp2')) And (F4S[I].NPk>0) Then
   Begin
   Xl:=F4MpaHdr(PEABuffer(@F4S[I].Data^[F4S[I].P^[0].Pos]),0,F4S[I].P^[0].Len,
    Xl2,Xs,Xc,Xf,Xg);
   If Xl>0 Then F4S[I].BitRate:=F4MpaBr*1000;
  End;
  If (F4S[I].Codec='ac3') And (F4S[I].NPk>0) And (F4S[I].P^[0].Len>8) Then Begin
   Xl:=F4S[I].Data^[F4S[I].P^[0].Pos+4] And 63;
   If Xl<=37 Then F4S[I].BitRate:=F4Ac3Br[Xl Shr 1]*1000;
  End;
 End;
 If MinPts=High(Int64) Then MinPts:=0;
 { ts_offset de ffmpeg.c : -start_time du fichier (microsecondes) }
 If MinPts<>0 Then Begin
  Pk:=F4MulDivR(MinPts,Scale,1000,4);
  For I:=0 To F4NS-1 Do F4S[I].Off:=F4MulDivR(-Pk,F4S[I].TbD,1000000*F4S[I].TbN,
   4);
 End;
 FreeMem(MKF); MKF:=Nil;
End;

{ copie vers NUT : ffmpeg donne aux paquets audio mp2/mp3/ac3/aac/pcm des
 horodatages exacts en echantillons }
Procedure F4SampleExactAudio;
Var S,K: LongInt; C: String; Cum,S0: Int64; N: LongInt;
Begin
 For S:=0 To F4NS-1 Do If F4S[S].Typ=1 Then Begin
  C:=F4S[S].Codec;
  If ((C='mp2') Or (C='mp3') Or (C='ac3') Or (C='aac') Or (Copy(C,1,4)='pcm_'))
   And (F4S[S].NPk>0) And (F4S[S].Rate>0) Then Begin
   S0:=F4RescQ(F4S[S].P^[0].Pts+F4S[S].Off,F4S[S].TbN,F4S[S].TbD,1,F4S[S].Rate,
    4);
   Cum:=S0;
   For K:=0 To F4S[S].NPk-1 Do Begin
    N:=F4AudioPktSamples(C,F4S[S].Rate,F4S[S].Chans,F4S[S].P^[K].Len);
    F4S[S].P^[K].Pts:=Cum; F4S[S].P^[K].Dts:=Cum; F4S[S].P^[K].Dur:=N;
    Inc(Cum,N);
   End;
   F4S[S].TbN:=1; F4S[S].TbD:=F4S[S].Rate; F4S[S].Off:=0;
  End;
 End;
End;

Procedure F4MkvFromMkv(Const Source,Target: String; Webm: Boolean);
Begin
 F4MkvStreams(Source);
 If F4OutNut Then F4SampleExactAudio;
 F4MuxOut(Target,Webm);
 F4Reset;
End;

{ ---- MP4 / MOV -> flux (copie vers Matroska / NUT) ---- }
Var F4MB: PEABuffer; F4MBSz: LongInt;
Function F4M32(At: LongInt): Int64;
Begin If (At<0) Or (At+4>F4MBSz) Then F4M32:=0 Else F4M32:=F4RB32(F4MB,At); End;
Function F4M16(At: LongInt): LongInt;
Begin If (At<0) Or (At+2>F4MBSz) Then F4M16:=0 Else F4M16:=F4MB^[At]*256+F4MB^[
 At+1]; End;
Function F4M64(At: LongInt): Int64;
Begin F4M64:=(F4M32(At) Shl 32) Or F4M32(At+4); End;
Function F4MBox(Var At: LongInt; Fin: LongInt; Var Typ: String; Var DAt,DEnd:
 LongInt): Boolean;
Var Sz: Int64; Hl: LongInt;
Begin
 F4MBox:=False;
 If At+8>Fin Then Exit;
 Sz:=F4M32(At); Typ:=F4Tag4(F4MB,At+4); Hl:=8;
 If Sz=1 Then Begin Sz:=F4M64(At+8); Hl:=16; End;
 If Sz=0 Then Sz:=Fin-At;
 If Sz<Hl Then Exit;
 If At+Sz>Fin Then Sz:=Fin-At;
 DAt:=At+Hl; DEnd:=At+LongInt(Sz); At:=DEnd;
 F4MBox:=True;
End;
{ longueur de descripteur MPEG-4 (7 bits par octet) }
Function F4MDescLen(Var At: LongInt): LongInt;
Var B,N,R: LongInt;
Begin R:=0; N:=0; Repeat B:=F4MB^[At]; Inc(At); R:=(R Shl 7) Or (B And 127);
 Inc(N); Until ((B And 128)=0) Or (N>=4); F4MDescLen:=R; End;

Type TMv=Record
  TS,Typ,Wd,Ht,Ch,Rt: LongInt; Cod: String[8]; Obj: LongInt; CAt,CLen: LongInt;
   Hnd: String[40]; Vend: String[40]; Enc: String[40]; Enabled: Boolean; PaspN,
   PaspD,Avg: LongInt; Lang: String[4];
  SttsAt,CttsAt,StssAt,StszAt,StscAt,StcoAt: LongInt; Co64: Boolean; Edit:
   Int64; HaveEdit: Boolean; Ok: Boolean;
 End;

Procedure F4MovParseSampleEntry(Var Tk: TMv; D6,E6: LongInt);
Var E0,Sz,Ver,A,Fin,D,E,P,L,Tg: LongInt; Ty,Xs: String;
Begin
 E0:=D6+8; Sz:=LongInt(F4M32(E0)); Tk.Cod:=F4Tag4(F4MB,E0+4); Fin:=E0+Sz; If
  Fin>E6 Then Fin:=E6;
 Tk.Vend:=''; For A:=0 To 3 Do Begin
  Ver:=F4MB^[E0+20+A]; If (Ver>=32) And (Ver<127) Then Tk.Vend:=Tk.Vend+Chr(Ver)
   Else Begin Str(Ver,Xs); Tk.Vend:=Tk.Vend+'['+Xs+']'; End;
 End;
 Tk.Enc:='';
 If Tk.Typ=1 Then Begin
  Ver:=F4MB^[E0+50]; If Ver>31 Then Ver:=31;
  For A:=1 To Ver Do If F4MB^[E0+50+A]<>0 Then Tk.Enc:=Tk.Enc+Chr(F4MB^[E0+50+
   A]);
 End;
 If Tk.Typ=1 Then Begin
  Tk.Wd:=F4M16(E0+32); Tk.Ht:=F4M16(E0+34); A:=E0+86;
 End Else Begin
  Ver:=F4M16(E0+16); Tk.Ch:=F4M16(E0+24); Tk.Rt:=F4M16(E0+32); A:=E0+36;
  If Ver=1 Then Inc(A,16);
 End;
 While F4MBox(A,Fin,Ty,D,E) Do Begin
  If Ty='wave' Then A:=D
  Else If Ty='pasp' Then Begin Tk.PaspN:=LongInt(F4M32(D)); Tk.PaspD:=LongInt(
   F4M32(D+4)); End
  Else If (Ty='avcC') Or (Ty='dac3') Then Begin Tk.CAt:=D; Tk.CLen:=E-D; End
  Else If Ty='esds' Then Begin
   P:=D+4;
   While P<E Do Begin
    Tg:=F4MB^[P]; Inc(P); L:=F4MDescLen(P);
    If Tg=3 Then Begin Inc(P,2); If (F4MB^[P-1] And $80)<>0 Then Inc(P,2); Inc(
     P); End
    Else If Tg=4 Then Begin Tk.Obj:=F4MB^[P]; Tk.Avg:=LongInt(F4M32(P+9)); Inc(
     P,13); End
    Else If Tg=5 Then Begin Tk.CAt:=P; Tk.CLen:=L; Break; End
    Else Inc(P,L);
   End;
  End;
 End;
End;

Procedure F4MovBuild(Const Tk: TMv; S: LongInt);
Var Ns,NCh,StN,CtN,SsN,Vers,SizeFix,Chk,J,N,Sample: LongInt; SIdx,SLeft,CtI,
 CtLeft,SsI: LongInt; Dl,Dts,CtVal,OffV,Sz1,Sub: Int64; KeyF: Boolean;
Begin
 SizeFix:=LongInt(F4M32(Tk.StszAt+4)); Ns:=LongInt(F4M32(Tk.StszAt+8)); NCh:=
  LongInt(F4M32(Tk.StcoAt+4));
 StN:=LongInt(F4M32(Tk.SttsAt+4)); SIdx:=0; SLeft:=0; Dl:=0;
 CtN:=0; Vers:=0; If Tk.CttsAt>0 Then Begin CtN:=LongInt(F4M32(Tk.CttsAt+4));
  Vers:=F4MB^[Tk.CttsAt]; End;
 CtI:=0; CtLeft:=0; CtVal:=0;
 SsN:=0; If Tk.StssAt>0 Then SsN:=LongInt(F4M32(Tk.StssAt+4)); SsI:=0;
 Dts:=0; Sample:=0; Sub:=0; If Tk.HaveEdit Then Sub:=Tk.Edit;
 For Chk:=1 To NCh Do Begin
  N:=0;
  For J:=0 To LongInt(F4M32(Tk.StscAt+4))-1 Do
   If LongInt(F4M32(Tk.StscAt+8+J*12))<=Chk Then N:=LongInt(F4M32(Tk.StscAt+8+J*
    12+4));
  If Tk.Co64 Then OffV:=F4M64(Tk.StcoAt+8+(Chk-1)*8) Else OffV:=F4M32(Tk.StcoAt+
   8+(Chk-1)*4);
  For J:=1 To N Do Begin
   If Sample>=Ns Then Exit;
   If SizeFix<>0 Then Sz1:=SizeFix Else Sz1:=F4M32(Tk.StszAt+12+Sample*4);
   While SLeft=0 Do Begin
    If SIdx>=StN Then Begin SLeft:=1; Dl:=0; Break; End;
    SLeft:=LongInt(F4M32(Tk.SttsAt+8+SIdx*8)); Dl:=F4M32(Tk.SttsAt+8+SIdx*8+4);
     Inc(SIdx);
   End;
   CtVal:=0;
   If CtN>0 Then Begin
    While (CtLeft=0) And (CtI<CtN) Do Begin
     CtLeft:=LongInt(F4M32(Tk.CttsAt+8+CtI*8)); CtVal:=F4M32(Tk.CttsAt+8+CtI*8+
      4);
     If CtVal>=$80000000 Then CtVal:=CtVal-$100000000;
     Inc(CtI);
    End;
    If CtLeft>0 Then Dec(CtLeft);
    If CtI>0 Then Begin CtVal:=F4M32(Tk.CttsAt+8+(CtI-1)*8+4); If
     CtVal>=$80000000 Then CtVal:=CtVal-$100000000; End;
   End;
   KeyF:=True;
   If Tk.StssAt>0 Then Begin
    KeyF:=False;
    While (SsI<SsN) And (F4M32(Tk.StssAt+8+SsI*4)<Sample+1) Do Inc(SsI);
    If (SsI<SsN) And (F4M32(Tk.StssAt+8+SsI*4)=Sample+1) Then KeyF:=True;
   End;
   If (OffV<0) Or (OffV+Sz1>F4MBSz) Then Exit;
   If Not (Tk.HaveEdit And (Dts+CtVal+Dl<Sub)) Then
    F4AddPkt(S,@F4MB^[LongInt(OffV)],LongInt(Sz1),Dts+CtVal-Sub,Dts-Sub,Dl,KeyF,
     0,0);
   Inc(Dts,Dl); Dec(SLeft); Inc(OffV,Sz1); Inc(Sample);
  End;
 End;
End;


{ ---- analyse du SPS H.264 (avcC) : dimensions rognees, VUI (SAR, couleur,
 position chroma) ---- }
Var F4HB: Array[0..511] Of Byte; F4HN, F4HP: LongInt;
Function F4HBit: LongInt;
Begin
 If F4HP>=F4HN*8 Then Begin F4HBit:=0; Inc(F4HP); Exit; End;
 F4HBit:=(F4HB[F4HP Shr 3] Shr (7-(F4HP And 7))) And 1; Inc(F4HP);
End;
Function F4HBits(N: LongInt): LongInt;
Var R: LongInt;
Begin R:=0; While N>0 Do Begin R:=(R Shl 1) Or F4HBit; Dec(N); End; F4HBits:=R;
 End;
Function F4HUe: LongInt;
Var Z: LongInt;
Begin
 Z:=0; While (F4HBit=0) And (Z<32) And (F4HP<F4HN*8+40) Do Inc(Z);
 If Z=0 Then F4HUe:=0 Else F4HUe:=LongInt((Int64(1) Shl Z)-1+F4HBits(Z));
End;
Function F4HSe: LongInt;
Var K: LongInt;
Begin K:=F4HUe; If (K And 1)<>0 Then F4HSe:=(K+1) Div 2 Else F4HSe:=-(K Div 2);
 End;
Procedure F4HScaling(Sz: LongInt);
Var L,N,D: LongInt;
Begin
 L:=8; N:=8;
 While Sz>0 Do Begin
  If N<>0 Then Begin D:=F4HSe; N:=(L+D+256) Mod 256; End;
  If N<>0 Then L:=N;
  Dec(Sz);
 End;
End;
Procedure F4H264Sps(S: LongInt; At,Len: LongInt);
Var P,Sl,I,Prof,Chroma,Bd,Pc,Cn,Wm,Hm,Fmo,Cl,Cr,Ct,Cb,Cux,Cuy,Idc,Sw,Sh,Vf,Lvl,
 Refs,Reorder: LongInt; Sep: Boolean; Restr: Boolean;
 Tab: Array[1..16] Of LongInt;
Begin
 If (Len<8) Or (F4MB^[At]<>1) Or ((F4MB^[At+5] And 31)<1) Then Exit;
 Sl:=F4MB^[At+6]*256+F4MB^[At+7]; P:=At+8;
 If (Sl<5) Or (Sl>500) Or (P+Sl>At+Len) Then Exit;
 { retire les octets d'emulation de depart, saute l'en-tete NAL }
 F4HN:=0; I:=1;
 While I<Sl Do Begin
  If (I>=3) And (F4MB^[P+I]=3) And (F4MB^[P+I-1]=0) And (F4MB^[P+I-2]=0) Then
   Begin Inc(I); Continue; End;
  F4HB[F4HN]:=F4MB^[P+I]; Inc(F4HN); Inc(I);
 End;
 F4HP:=0;
 Prof:=F4HBits(8); F4HBits(8); Lvl:=F4HBits(8); F4HUe;
 Chroma:=1; Bd:=8; Sep:=False;
 If (Prof=100) Or (Prof=110) Or (Prof=122) Or (Prof=244) Or (Prof=44) Or (
  Prof=83) Or (Prof=86) Or (Prof=118) Or (Prof=128) Or (Prof=138) Or (Prof=139)
  Or (Prof=134) Or (Prof=135) Then Begin
  Chroma:=F4HUe; If Chroma=3 Then Sep:=F4HBit=1;
  Bd:=F4HUe+8; F4HUe; F4HBit;
  If F4HBit=1 Then Begin
   If Chroma<>3 Then Cn:=8 Else Cn:=12;
   For I:=0 To Cn-1 Do If F4HBit=1 Then If I<6 Then F4HScaling(16) Else
    F4HScaling(64);
  End;
 End;
 F4HUe; Pc:=F4HUe;
 If Pc=0 Then F4HUe
 Else If Pc=1 Then Begin F4HBit; F4HSe; F4HSe; Cn:=F4HUe; For I:=1 To Cn Do
  F4HSe; End;
 Refs:=F4HUe; F4HBit; Wm:=F4HUe+1; Hm:=F4HUe+1; Fmo:=F4HBit;
 If Fmo=0 Then F4HBit;
 F4HBit;
 Cl:=0; Cr:=0; Ct:=0; Cb:=0;
 If F4HBit=1 Then Begin Cl:=F4HUe; Cr:=F4HUe; Ct:=F4HUe; Cb:=F4HUe; End;
 If F4HP>=F4HN*8 Then Exit;
 If (Chroma=1) Or (Chroma=2) Then Cux:=2 Else Cux:=1;
 If Chroma=1 Then Cuy:=2 Else Cuy:=1;
 If Sep Then Begin Cux:=1; Cuy:=1; End;
 Cuy:=Cuy*(2-Fmo);
 Sw:=Wm*16-(Cl+Cr)*Cux; Sh:=(2-Fmo)*Hm*16-(Ct+Cb)*Cuy;
 If (Sw>0) And (Sh>0) And (Sw<=65535) And (Sh<=65535) Then Begin F4S[S].W:=Sw;
  F4S[S].H:=Sh; End;
 If Fmo=1 Then F4S[S].FieldOrder:=1 Else F4S[S].FieldOrder:=2;
 If (Chroma=1) And (Bd=8) Then F4S[S].PixFmt:='yuv420p'
 Else If (Chroma=2) And (Bd=8) Then F4S[S].PixFmt:='yuv422p'
 Else If (Chroma=3) And (Bd=8) Then F4S[S].PixFmt:='yuv444p'
 Else If Chroma=0 Then F4S[S].PixFmt:='gray' Else F4S[S].PixFmt:='yuv420p10le';
 If Chroma=1 Then F4S[S].ChromaLoc:=2 Else F4S[S].ChromaLoc:=1;
 Restr:=False; Reorder:=0;
 If F4HBit=1 Then Begin  { vui_parameters_present }
  If F4HBit=1 Then Begin
   Idc:=F4HBits(8);
   If Idc=255 Then Begin Sw:=F4HBits(16); Sh:=F4HBits(16); If (Sw>0) And (Sh>0)
    Then Begin F4S[S].SarN:=Sw; F4S[S].SarD:=Sh; End; End
   Else If (Idc>=1) And (Idc<=16) Then Begin
    Tab[1]:=1; Tab[2]:=12; Tab[3]:=10; Tab[4]:=16; Tab[5]:=40; Tab[6]:=24; Tab[
     7]:=20; Tab[8]:=32; Tab[9]:=80; Tab[10]:=18; Tab[11]:=15; Tab[12]:=64; Tab[
     13]:=160; Tab[14]:=4; Tab[15]:=3; Tab[16]:=2;
    F4S[S].SarN:=Tab[Idc];
    Case Idc Of 1: Sh:=1; 2: Sh:=11; 3: Sh:=11; 4: Sh:=11; 5: Sh:=33; 6: Sh:=11;
     7: Sh:=11; 8: Sh:=11; 9: Sh:=33; 10: Sh:=11; 11: Sh:=11; 12: Sh:=33; 13:
     Sh:=99; 14: Sh:=3; 15: Sh:=2; Else Sh:=1; End;
    F4S[S].SarD:=Sh;
   End;
  End;
  If F4HBit=1 Then F4HBit;
  If F4HBit=1 Then Begin
   F4HBits(3); Vf:=F4HBit;
   If Vf=1 Then F4S[S].CRange:=2 Else F4S[S].CRange:=1;
   If F4HBit=1 Then Begin
    F4S[S].CPri:=F4HBits(8); F4S[S].CTrc:=F4HBits(8); F4S[S].CSpace:=F4HBits(8);
   End;
  End;
  If F4HBit=1 Then Begin
   Cl:=F4HUe; F4HUe;
   If (Cl>=0) And (Cl<=5) Then F4S[S].ChromaLoc:=Cl+1 Else F4S[S].ChromaLoc:=0;
  End;
  If F4HBit=1 Then Begin F4HBits(32); F4HBits(32); F4HBit; End;
  Cn:=0;
  For I:=1 To 2 Do If F4HBit=1 Then Begin
   Cn:=1; Idc:=F4HUe; F4HBits(8);
   For Vf:=0 To Idc Do Begin F4HUe; F4HUe; F4HBit; End;
   F4HBits(20);
  End;
  If Cn=1 Then F4HBit;
  F4HBit;
  If F4HBit=1 Then Begin
   F4HBit; F4HUe; F4HUe; F4HUe; F4HUe; Reorder:=F4HUe; F4HUe; Restr:=F4HP<=F4HN*
    8;
  End;
 End;
 If Not Restr Then Begin
  Reorder:=0;
  If Refs>0 Then Begin
   Reorder:=15;
   Case Lvl Of 9,10: Cn:=396; 11: Cn:=900; 12,13,20: Cn:=2376; 21: Cn:=4752; 22,
    30: Cn:=8100; 31: Cn:=18000; 32: Cn:=20480; 40,41: Cn:=32768; 42: Cn:=34816;
    50: Cn:=110400; 51,52: Cn:=184320; Else Cn:=0; End;
   If Cn>0 Then Begin Idc:=Cn Div (Wm*Hm); If Idc<Reorder Then Reorder:=Idc;
    End;
  End;
 End;
 F4S[S].VDelay:=Reorder;
End;


{ ---- metadonnees globales MOV/MP4 : udta (QuickTime) et udta/meta/ilst ---- }
Function F4MovKey(Const Ty: String): String;
Begin
 F4MovKey:='';
 If Ty=#169'nam' Then F4MovKey:='title' Else If Ty=#169'ART' Then F4MovKey:=
  'artist'
 Else If Ty=#169'wrt' Then F4MovKey:='composer' Else If Ty=#169'alb' Then
  F4MovKey:='album'
 Else If Ty=#169'day' Then F4MovKey:='date' Else If Ty=#169'too' Then F4MovKey:=
  'encoder'
 Else If Ty=#169'cmt' Then F4MovKey:='comment' Else If Ty=#169'gen' Then
  F4MovKey:='genre'
 Else If Ty=#169'cpy' Then F4MovKey:='copyright' Else If Ty=#169'grp' Then
  F4MovKey:='grouping'
 Else If Ty=#169'lyr' Then F4MovKey:='lyrics' Else If Ty=#169'des' Then
  F4MovKey:='description'
 Else If Ty='desc' Then F4MovKey:='description' Else If Ty='cprt' Then
  F4MovKey:='copyright'
 Else If Ty='aART' Then F4MovKey:='album_artist' Else If Ty=#169'swr' Then
  F4MovKey:='encoder'
 Else If Ty='keyw' Then F4MovKey:='keywords' Else If Ty='tvsh' Then F4MovKey:=
  'show'
 Else If Ty='tven' Then F4MovKey:='episode_id' Else If Ty='tvnn' Then F4MovKey:=
  'network'
 Else If Ty='trkn' Then F4MovKey:='track' Else If Ty='disk' Then F4MovKey:=
  'disc';
End;

Procedure F4MovUdta(Dat,Fin: LongInt);
Var A,A2,A3,A4,D,E,D2,E2,D3,E3,D4,E4,L: LongInt; Ty,T2,T3,T4,K,V: String;
Begin
 A:=Dat;
 While F4MBox(A,Fin,Ty,D,E) Do Begin
  If Ty='meta' Then Begin
   A2:=D; If F4M32(D)=0 Then Inc(A2,4);
   While F4MBox(A2,E,T2,D2,E2) Do If T2='ilst' Then Begin
    A3:=D2;
    While F4MBox(A3,E2,T3,D3,E3) Do Begin
     K:=F4MovKey(T3);
     If K<>'' Then Begin
      A4:=D3;
      While F4MBox(A4,E3,T4,D4,E4) Do If T4='data' Then Begin
       V:='';
       If (K='track') Or (K='disc') Then Begin
        L:=F4M16(D4+10); Str(L,V);
        If F4M16(D4+12)>0 Then Begin Str(F4M16(D4+12),T4); V:=V+'/'+T4; End;
       End Else Begin
        L:=D4+8; While (L<E4) And (Length(V)<250) Do Begin V:=V+Chr(F4MB^[L]);
         Inc(L); End;
       End;
       F4GAdd(K,V);
       Break;
      End;
     End;
    End;
   End;
  End Else If (Length(Ty)=4) And (Ty[1]=#169) Then Begin
   K:=F4MovKey(Ty);
   If K<>'' Then Begin
    L:=F4M16(D); V:=''; A2:=D+4;
    While (L>0) And (A2<E) And (Length(V)<250) Do Begin V:=V+Chr(F4MB^[A2]);
     Inc(A2); Dec(L); End;
    F4GAdd(K,V);
   End;
  End;
 End;
End;

Procedure F4MovStreams(Const Source: String);
Var
 Tr: Array[0..7] Of TMv; NT,At,A2,A3,A4,A5,A6,D,E,D2,E2,D3,E3,D4,E4,D5,E5,D6,E6,
  I,N,Vers,S,Q: LongInt; Ty,T2,T3,T4,T5,T6: String; Dts0: Int64; Tk: ^TMv;
 Brands: String; Isom: Boolean; Tot,Cnt0: Int64; Gn,Gd: Int64; Cid: String;
Begin
 F4Reset;
 NVLoad(Source,F4MB,F4MBSz);
 NT:=0; At:=0; Isom:=False;
 While F4MBox(At,F4MBSz,Ty,D,E) Do Begin
  If Ty='ftyp' Then Begin
   Brands:='';
   F4GAdd('major_brand',F4Tag4(F4MB,D)); Isom:=F4Tag4(F4MB,D)<>'qt  ';
   Str(F4M32(D+4),Brands); F4GAdd('minor_version',Brands);
   Brands:=''; Q:=D+8; While Q+4<=E Do Begin Brands:=Brands+F4Tag4(F4MB,Q); Inc(
    Q,4); End;
   F4GAdd('compatible_brands',Brands);
  End;
  If Ty='moov' Then Begin
   A2:=D;
   While F4MBox(A2,E,T2,D2,E2) Do If T2='udta' Then F4MovUdta(D2,E2) Else If (
    T2='trak') And (NT<8) Then Begin
    Tk:=@Tr[NT]; FillChar(Tk^,SizeOf(Tk^),0);
    A3:=D2;
    While F4MBox(A3,E2,T3,D3,E3) Do Begin
     If T3='tkhd' Then Tk^.Enabled:=(F4MB^[D3+3] And 1)<>0
     Else If T3='edts' Then Begin
      A4:=D3;
      While F4MBox(A4,E3,T4,D4,E4) Do If T4='elst' Then Begin
       N:=LongInt(F4M32(D4+4)); Vers:=F4MB^[D4];
       For I:=0 To N-1 Do Begin
        If Vers=1 Then Dts0:=F4M64(D4+8+I*20+8) Else Begin Dts0:=F4M32(D4+8+I*
         12+4); If Dts0>=$80000000 Then Dts0:=Dts0-$100000000; End;
        If Dts0>=0 Then Begin Tk^.Edit:=Dts0; Tk^.HaveEdit:=True; Break; End;
       End;
      End;
     End Else If T3='mdia' Then Begin
      A4:=D3;
      While F4MBox(A4,E3,T4,D4,E4) Do Begin
       If T4='mdhd' Then Begin
        If F4MB^[D4]=1 Then Begin Tk^.TS:=LongInt(F4M32(D4+20)); Q:=F4M16(D4+
         32); End Else Begin Tk^.TS:=LongInt(F4M32(D4+12)); Q:=F4M16(D4+20);
         End;
        Tk^.Lang:='';
        If (Q>=$400) And (Q<>$7FFF) Then Tk^.Lang:=Chr(((Q Shr 10) And 31)+$60)+
         Chr(((Q Shr 5) And 31)+$60)+Chr((Q And 31)+$60);
       End
       Else If T4='hdlr' Then Begin
        T5:=F4Tag4(F4MB,D4+8); If T5='vide' Then Tk^.Typ:=1 Else If T5='soun'
         Then Tk^.Typ:=2;
        Tk^.Hnd:=''; Q:=D4+24; If (Not Isom) And (Q<E4) Then Inc(Q); While (
         Q<E4) And (F4MB^[Q]<>0) And (Length(Tk^.Hnd)<39) Do Begin Tk^.Hnd:=
         Tk^.Hnd+Chr(F4MB^[Q]); Inc(Q); End;
       End Else If T4='minf' Then Begin
        A5:=D4;
        While F4MBox(A5,E4,T5,D5,E5) Do If T5='stbl' Then Begin
         A6:=D5;
         While F4MBox(A6,E5,T6,D6,E6) Do Begin
          If T6='stsd' Then F4MovParseSampleEntry(Tk^,D6,E6)
          Else If T6='stts' Then Tk^.SttsAt:=D6 Else If T6='ctts' Then
           Tk^.CttsAt:=D6 Else If T6='stss' Then Tk^.StssAt:=D6
          Else If T6='stsz' Then Tk^.StszAt:=D6 Else If T6='stsc' Then
           Tk^.StscAt:=D6
          Else If T6='stco' Then Tk^.StcoAt:=D6 Else If T6='co64' Then Begin
           Tk^.StcoAt:=D6; Tk^.Co64:=True; End;
         End;
        End;
       End;
      End;
     End;
    End;
    Tk^.Ok:=(Tk^.Typ>0) And (Tk^.SttsAt>0) And (Tk^.StszAt>0) And (Tk^.StscAt>0)
     And (Tk^.StcoAt>0) And (Tk^.TS>0);
    If Tk^.Ok Then Inc(NT);
   End;
  End;
 End;
 If NT=0 Then Fail('mp4: aucune piste exploitable.');
 For I:=0 To NT-1 Do Begin
  Tk:=@Tr[I]; Cid:='';
  If Tk^.Typ=1 Then Begin
   If (Tk^.Cod='mp4v') And (Tk^.Obj=$20) Then Cid:='mpeg4'
   Else If (Tk^.Cod='avc1') Or (Tk^.Cod='avc3') Then Cid:='h264';
   If Cid='' Then Fail('mp4: codec video '+Tk^.Cod+
    ' non pris en charge pour la copie.');
   S:=F4AddStream(0,Cid);
   F4S[S].W:=Tk^.Wd; F4S[S].H:=Tk^.Ht;
   F4S[S].SarN:=1; F4S[S].SarD:=1; F4S[S].PixFmt:='yuv420p';
   If Cid='mpeg4' Then F4S[S].ChromaLoc:=1;
   If Tk^.CLen>0 Then F4SetExtra(S,@F4MB^[Tk^.CAt],Tk^.CLen);
   If (Cid='h264') And (Tk^.CLen>0) Then F4H264Sps(S,Tk^.CAt,Tk^.CLen);
   If Cid='h264' Then F4S[S].Tag:=$31637661 Else F4S[S].Tag:=$7634706D;
   If Tk^.PaspN>0 Then Begin F4S[S].SarN:=Tk^.PaspN; F4S[S].SarD:=Tk^.PaspD;
    End;
  End Else Begin
   If Tk^.Cod='mp4a' Then Begin
    If (Tk^.Obj=$40) Or (Tk^.Obj=$66) Or (Tk^.Obj=$67) Or (Tk^.Obj=$68) Then
     Cid:='aac'
    Else If (Tk^.Obj=$6B) Or (Tk^.Obj=$69) Then Cid:='mp3';
   End Else If (Tk^.Cod='ac-3') Then Cid:='ac3' Else If Tk^.Cod='.mp3' Then
    Cid:='mp3';
   If Cid='' Then Fail('mp4: codec audio '+Tk^.Cod+
    ' non pris en charge pour la copie.');
   S:=F4AddStream(1,Cid);
   F4S[S].Rate:=Tk^.Rt; F4S[S].Chans:=Tk^.Ch; F4S[S].Bits:=32;
   If Tk^.Avg>0 Then F4S[S].BitRate:=Tk^.Avg;
   If (Cid='ac3') And (Tk^.CLen>=3) Then Begin
    N:=(F4MB^[Tk^.CAt+1]*256+F4MB^[Tk^.CAt+2]) Shr 5;
    N:=N And 31;
    Case N Of 0: Q:=32; 1: Q:=40; 2: Q:=48; 3: Q:=56; 4: Q:=64; 5: Q:=80; 6: Q:=
     96; 7: Q:=112; 8: Q:=128; 9: Q:=160; 10: Q:=192; 11: Q:=224; 12: Q:=256;
     13: Q:=320; 14: Q:=384; 15: Q:=448; 16: Q:=512; 17: Q:=576; 18: Q:=640;
     Else Q:=0; End;
    If Q>0 Then F4S[S].BitRate:=Q*1000;
   End;
   If (Cid='aac') And (Tk^.CLen>0) Then F4SetExtra(S,@F4MB^[Tk^.CAt],Tk^.CLen);
  End;
  F4S[S].TbN:=1; F4S[S].TbD:=Tk^.TS; F4S[S].Dflt:=Tk^.Enabled;
  F4S[S].MetaN:=0;
  If Tk^.Lang<>'' Then Begin F4S[S].Lang:=Tk^.Lang; F4S[S].MetaK[0]:='language';
   F4S[S].MetaV[0]:=Tk^.Lang; F4S[S].MetaN:=1; End;
  If Tk^.Hnd<>'' Then Begin F4S[S].MetaK[F4S[S].MetaN]:='handler_name'; F4S[
   S].MetaV[F4S[S].MetaN]:=Tk^.Hnd; Inc(F4S[S].MetaN); End;
  F4S[S].MetaK[F4S[S].MetaN]:='vendor_id'; F4S[S].MetaV[F4S[S].MetaN]:=Tk^.Vend;
   Inc(F4S[S].MetaN);
  If Tk^.Enc<>'' Then Begin F4S[S].MetaK[F4S[S].MetaN]:='encoder'; F4S[S].MetaV[
   F4S[S].MetaN]:=Tk^.Enc; Inc(F4S[S].MetaN); End;
  F4MovBuild(Tk^,S);
  If (Tk^.Typ=2) And (Cid='ac3') Then
   For N:=0 To F4S[S].NPk-1 Do F4S[S].P^[N].Dur:=0;
  If (Tk^.Typ=1) And (Cid='mpeg4') Then
   For N:=0 To F4S[S].NPk-1 Do If F4S[S].P^[N].Pts<>F4S[S].P^[N].Dts Then F4S[
    S].VDelay:=1;
  If (Tk^.Typ=1) And (F4S[S].NPk>0) Then Begin
   Tot:=0; For N:=0 To F4S[S].NPk-1 Do Inc(Tot,F4S[S].P^[N].Dur);
   If Tot>0 Then Begin
    F4Reduce(Gn,Gd,Int64(F4S[S].NPk)*Tk^.TS,Tot,2147483647);
    F4S[S].AvgN:=Gn; F4S[S].AvgD:=Gd; F4S[S].RN:=Gn; F4S[S].RD:=Gd;
   End;
  End;
 End;
 FreeMem(F4MB);
End;

Procedure F4MkvFromMov(Const Source,Target: String; Webm: Boolean);
Begin
 F4MovStreams(Source);
 F4MuxOut(Target,Webm);
 F4Reset;
End;
{ ---- Ogg Vorbis -> flux (copie vers Matroska / NUT) : reutilise le
 demultiplexeur Ogg du decodeur Vorbis ---- }
Procedure F4OggStreams(Const Source: String);
Var
 S: TVGOS; Cw87: Word; R,Et,St,I,L,Q,Nc,Ln: LongInt; Pts,Run,Dur: Int64; Ex:
  Array[0..70000] Of Byte; Eo: LongInt;
 Cm: PEABuffer; Cl: LongInt; Ks,Vs: String; Fnd: Boolean;
Procedure Lace(N: LongInt);
Begin
 While N>=255 Do Begin Ex[Eo]:=255; Inc(Eo); Dec(N,255); End;
 Ex[Eo]:=N; Inc(Eo);
End;
Begin
 F4Reset;
 VGInit; Cw87:=Get8087CW; Set8087CW($137F);
 If Not VGIsVorbisOgg(Source) Then Fail('ogg: aucun flux Vorbis.');
 VGONo:=Int64(1) Shl 63; VGOFinalPts:=VGONo; VGOFinalDur:=0; VGOStartTime:=
  VGONo; VGODataOffset:=0;
 VGOHeadersDone:=False; VGOHaveVp:=False; VGDHaveId:=False; VGDHaveModes:=False;
  VGDSoft:=False; VGDErr:=False;
 OpenRead(Source); VGOLimit:=InputSize;
 GetMem(VGDRaw,70000);
 VGOInit(S,VGDSerial);
 While Not VGOHeadersDone Do Begin
  R:=VGOPacket(S);
  If R<0 Then Fail('ogg: en-tetes Vorbis incomplets.');
 End;
 If Not VGOHaveVp Then Fail('ogg: en-tetes Vorbis incomplets.');
 St:=F4AddStream(1,'vorbis');
 F4S[St].Rate:=VGDRate; F4S[St].Chans:=VGDCh; F4S[St].Bits:=32;
 F4S[St].TbN:=1; F4S[St].TbD:=VGDRate;
 { extradata : en-tetes Xiph ; l'en-tete de commentaires est remplace par un
  en-tete minimal (vendeur "ffmpeg") }
 Eo:=0; Ex[Eo]:=2; Inc(Eo);
 Lace(S.PkLen[0]); Lace(22);
 Move(S.Pk[0]^,Ex[Eo],S.PkLen[0]); Inc(Eo,S.PkLen[0]);
 Ex[Eo]:=3; Move(('vorbis')[1],Ex[Eo+1],6); Inc(Eo,7);
 Ex[Eo]:=6; Ex[Eo+1]:=0; Ex[Eo+2]:=0; Ex[Eo+3]:=0; Move(('ffmpeg')[1],Ex[Eo+4],
  6); Inc(Eo,10);
 Ex[Eo]:=0; Ex[Eo+1]:=0; Ex[Eo+2]:=0; Ex[Eo+3]:=0; Ex[Eo+4]:=1; Inc(Eo,5);
 If Eo+S.PkLen[2]<=70000 Then Begin Move(S.Pk[2]^,Ex[Eo],S.PkLen[2]); Inc(Eo,
  S.PkLen[2]); End;
 F4SetExtra(St,@Ex[0],Eo);
 { commentaires Vorbis -> metadonnees du flux }
 Cm:=S.Pk[1]; Cl:=S.PkLen[1];
 If (Cm<>Nil) And (Cl>8) Then Begin
  Q:=7; Ln:=Cm^[Q]+Cm^[Q+1]*256+Cm^[Q+2]*65536; Inc(Q,4+Ln);
  If Q+4<=Cl Then Begin
   Nc:=Cm^[Q]+Cm^[Q+1]*256+Cm^[Q+2]*65536; Inc(Q,4);
   While (Nc>0) And (Q+4<=Cl) Do Begin
    Ln:=Cm^[Q]+Cm^[Q+1]*256+Cm^[Q+2]*65536; Inc(Q,4);
    If Q+Ln>Cl Then Break;
    Ks:=''; Vs:=''; Fnd:=False;
    For I:=0 To Ln-1 Do Begin
     If (Not Fnd) And (Cm^[Q+I]=61) Then Fnd:=True
     Else If Not Fnd Then Begin If Length(Ks)<63 Then Ks:=Ks+Chr(Cm^[Q+I]); End
     Else If Length(Vs)<63 Then Vs:=Vs+Chr(Cm^[Q+I]);
    End;
    If Fnd And (F4LcS(Ks)='title') Then F4S[St].Title:=Vs;
    If Fnd And (F4S[St].MetaN<F4MaxMeta) Then Begin
     F4S[St].MetaK[F4S[St].MetaN]:=Ks; F4S[St].MetaV[F4S[St].MetaN]:=Vs; Inc(
      F4S[St].MetaN);
    End;
    Inc(Q,Ln); Dec(Nc);
   End;
  End;
 End;
 Run:=0;
 While True Do Begin
  R:=VGOPacket(S);
  If R<0 Then Break;
  If R=0 Then Continue;
  Pts:=VGOCalcPts(S);
  Et:=S.EndTrim; S.EndTrim:=0;
  Dur:=S.PDur;
  If Pts<>VGONo Then Run:=Pts;
  F4AddPkt(St,@S.Buf^[S.OutStart],S.OutSize,Run,Run,Dur,True,0,Et);
  Inc(Run,Dur);
 End;
 CloseRead; Set8087CW(Cw87);
End;

Procedure F4MkvFromOgg(Const Source,Target: String; Webm: Boolean);
Begin
 F4OggStreams(Source);
 F4MuxOut(Target,Webm);
 F4Reset;
End;

{ ---- aiguillage de la sortie Matroska / WebM depuis le programme principal
 ---- }
Procedure F4MainMkv;
Var Webm: Boolean; Tmp: String;
Begin
 Webm:=OutputFormat='webm'; F4OutNut:=OutputFormat='nut'; F4OutFmt:=
  OutputFormat;
 If IsHTTP(InputPath) Then Fail('Matroska: entree locale requise.');
 If (InputFormat='yuv4mpegpipe') And ((VideoCodec='rawvideo') Or (
  VideoCodec='huffyuv') Or (VideoCodec='mpeg4') Or (VideoCodec='ffv1') Or (
  VideoCodec='msmpeg4') Or (VideoCodec='msmpeg4v2') Or (VideoCodec='mjpeg'))
  Then Begin
  F4Pending:=True; F4Target:=OutputPath; F4Kind:=VideoCodec; F4WebmOut:=Webm;
   OutputFormat:='avi'; Exit;
 End;
 If (InputFormat='wav') And (AudioCodec='mp2') Then Begin
  F4Pending:=True; F4Target:=OutputPath; F4Kind:='mp2'; F4WebmOut:=Webm;
   OutputFormat:='mp2'; Exit;
 End;
 If InputFormat='nut' Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromNut(InputPath,Tmp,Webm);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 If InputFormat='webm' Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromMkv(InputPath,Tmp,Webm);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 If InputFormat='ogg' Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromOgg(InputPath,Tmp,Webm);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 If InputFormat='mp4' Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromMov(InputPath,Tmp,Webm);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 If InputFormat='wav' Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromWav(InputPath,Tmp,Webm,AudioCodec);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 If InputFormat='avi' Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromAvi(InputPath,Tmp,Webm);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 If (InputFormat='mp3') Or (InputFormat='mp2') Or (InputFormat='ac3') Or (
  InputFormat='aac') Or (InputFormat='flac') Then Begin
  Tmp:=NewTemporary; Temps[2]:=Tmp;
  F4MkvFromEs(InputPath,Tmp,Webm);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie creee: ',OutputPath); Halt(0);
 End;
 Fail('Matroska/WebM: entree non prise en charge pour cette sortie.');
End;

