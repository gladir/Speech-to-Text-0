Procedure ParseAspect(S: String);
Var K,C,Dots,Digits: Integer; N,D,G,R: LongInt; Decimal: Boolean;
Begin
 N:=0; D:=1; Dots:=0; Digits:=0; Decimal:=False;
 K:=Pos(':',S);
 If K>0 Then Begin
  For C:=1 To Length(S) Do If (C<>K) And Not (S[C] In ['0'..'9']) Then
   Fail('-aspect: N:D positif attendu.');
  Val(Copy(S,1,K-1),N,C); If C<>0 Then Fail('-aspect: ratio invalide.');
  Val(Copy(S,K+1,Length(S)),D,C); If C<>0 Then Fail('-aspect: ratio invalide.');
 End Else Begin
  For K:=1 To Length(S) Do
   If S[K]='.' Then Begin Inc(Dots); Decimal:=True; End Else
   If S[K] In ['0'..'9'] Then Begin
    Inc(Digits);
    If (N>100000000) Or (Decimal And (D>=1000000)) Then Fail('-aspect: precision maximale 6 decimales.');
    N:=N*10+Ord(S[K])-48; If Decimal Then D:=D*10;
   End Else Fail('-aspect: nombre positif ou N:D attendu.');
  If (Dots>1) Or (Digits=0) Then Fail('-aspect: ratio invalide.');
 End;
 If (N<=0) Or (D<=0) Or (N>1000000000) Or (D>1000000) Then Fail('-aspect: ratio positif hors limites.');
 G:=N; R:=D; While R<>0 Do Begin
  AspectNum:=G Mod R; G:=R; R:=AspectNum;
 End;
 AspectNum:=N Div G; AspectDen:=D Div G;
End;

BEGIN
 HasBFrames:=False; BFrames:=0; HasBQuant:=False; BQuantFactor:=1.25; BQuantOffset:=1.25;
 HasVideoBitrate:=False; VideoBitrate:=200000;
 HasVideoTolerance:=False; VideoTolerance:=4000000; HasVideoBuffer:=False; VideoBuffer:=0;
 HasComment:=False; CommentName:=''; CommentWideSize:=0; CommentUTF8Size:=0;
 FourMV:=False; HasAlbum:=False; AlbumName:=''; AlbumWideSize:=0; AlbumUTF8Size:=0;
 InputActive:=False; OutputActive:=False;
 HLSListOpen:=False; AllStreams:=False; NoVideo:=False; HLSBase:='';
 AspectNum:=0; AspectDen:=1;
 DecodedVideo:=False; HasCrop:=False; CropTop:=0; CropBottom:=0; CropLeft:=0; CropRight:=0;
 NoAudio:=False; VideoCodec:=''; VideoFrames:=0; ImageWidth:=0; ImageHeight:=0;
 {$IFDEF MSWINDOWS}
  NetSession:=Nil; NetRequest:=Nil;
 {$ENDIF}
 For J:=0 To 6 Do Temps[J]:='';
 InputPath:=''; OutputPath:=''; InputFormat:=''; OutputFormat:='';
 AudioCodec:=''; InputCodec:=''; PendingFormat:=''; RequestedRate:=0; RequestedChannels:=0; RequestedBitRateK:=320;
 Overwrite:=False; NoOverwrite:=False; HideBanner:=False; HasBitrate:=False;
 SavedExit:=ExitProc; ExitProc:=@ExitCleanup; Randomize;
 I:=1;
 While I<=ParamCount Do Begin
  Argument:=ParamStr(I);
  If (Argument='-h') Or (Argument='--help') Or (Argument='/?') Or (Argument='-help')
  Then Begin
   Help; Halt(0);
  End
  Else If Argument='-version' Then Begin
   WriteLn(
   'FFMPEG Pascal 1.11; sources de reference FFmpeg 8.0.git; moteurs Pascal du projet.');
   Halt(0);
  End
  Else If Argument='-formats' Then Begin
   ShowFormats; Halt(0);
  End
  Else If Argument='-codecs' Then Begin
   WriteLn('Codecs:');
   WriteLn(' D = decodage, E = encodage, A = audio, V = video');
   WriteLn('D V    4xm             4X Movie');
   WriteLn('D V    amv             AMV Video');
