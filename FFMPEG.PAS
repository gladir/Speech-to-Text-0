Function NextArgument: String;Begin
 Inc(I); If I>ParamCount Then Fail('Valeur manquante pour '+Argument);
 NextArgument:=ParamStr(I);
End;

Function ParseBQuant(S,OptionName:String):Double;
Var J,Code:Integer; V:Double;
Begin
 If S='' Then Fail(OptionName+': valeur manquante.');
 For J:=1 To Length(S) Do
  If Not (S[J] In ['0'..'9','+','-','.']) Then Fail(OptionName+': nombre decimal requis.');
 Val(S,V,Code);
 If Code<>0 Then Fail(OptionName+': nombre decimal invalide.');
 If (V< -1000) Or (V>1000) Then Fail(OptionName+': valeur -1000..1000 requise.');
 ParseBQuant:=V;
End;

Function ParseVideoRate(S,OptionName:String; Minimum,Maximum:LongInt):LongInt;
Var J,Decimals: Integer; Multiplier,V,Scale: Double; Dot,Digit: Boolean;
Begin
 Multiplier:=1; If S='' Then Fail(OptionName+': debit manquant.');
 If S[Length(S)] In ['k','K','m','M'] Then Begin
  Multiplier:=1000; If S[Length(S)] In ['m','M'] Then Multiplier:=1000000;
  Delete(S,Length(S),1);
 End;
 V:=0; Scale:=1; Dot:=False; Digit:=False; Decimals:=0;
 For J:=1 To Length(S) Do Begin
  If S[J]='.' Then Begin If Dot Then Fail(OptionName+': debit invalide.'); Dot:=True; End Else
  If S[J] In ['0'..'9'] Then Begin
   Digit:=True; V:=V*10+Ord(S[J])-48;
   If Dot Then Begin Scale:=Scale*10; Inc(Decimals); End;
   If (V>1E15) Or (Decimals>6) Then Fail(OptionName+': debit hors limites.');
  End Else Fail(OptionName+': nombre positif attendu (200000, 200k, 1.5M).');
 End;
 V:=V*Multiplier/Scale;
 If Not Digit Or (V<Minimum) Or (V>Maximum) Or (V<>Trunc(V)) Then Fail(OptionName+': valeur entiere hors limites.');
 ParseVideoRate:=Trunc(V);
End;

Procedure PrepareAlbum;
Const OEM850: Array[128..255] Of Word=(
 199,252,233,226,228,224,229,231,234,235,232,239,238,236,196,197,
 201,230,198,244,246,242,251,249,255,214,220,248,163,216,215,402,
 225,237,243,250,241,209,170,186,191,174,172,189,188,161,171,187,
 9617,9618,9619,9474,9508,193,194,192,169,9571,9553,9559,9565,162,165,9488,
 9492,9524,9516,9500,9472,9532,227,195,9562,9556,9577,9574,9568,9552,9580,164,
 240,208,202,203,200,305,205,206,207,9496,9484,9608,9604,166,204,9600,
 211,223,212,210,245,213,181,254,222,218,219,217,253,221,175,180,
 173,177,8215,190,182,167,247,184,176,168,183,185,179,178,9632,160);
Var J,N: Integer; U: Word;
Begin
 AlbumWideSize:=Length(AlbumName); AlbumUTF8Size:=0;
 {$IFDEF MSWINDOWS}
 If AlbumWideSize>0 Then Begin
  AlbumWideSize:=MultiByteToWideChar(0,0,@AlbumName[1],Length(AlbumName),@AlbumWide,255);
  If AlbumWideSize=0 Then Fail('Conversion du nom album impossible.');
 End;
 {$ELSE}
 For J:=0 To AlbumWideSize-1 Do Begin
  N:=Ord(AlbumName[J+1]); If N<128 Then AlbumWide[J]:=N Else AlbumWide[J]:=OEM850[N];
 End;
 {$ENDIF}
 For J:=0 To AlbumWideSize-1 Do Begin
  U:=AlbumWide[J]; N:=AlbumUTF8Size;
  If U<128 Then Begin AlbumUTF8[N]:=U; Inc(N); End Else
  If U<2048 Then Begin AlbumUTF8[N]:=$C0 Or (U Shr 6); AlbumUTF8[N+1]:=$80 Or (U And 63); Inc(N,2); End Else
  Begin AlbumUTF8[N]:=$E0 Or (U Shr 12); AlbumUTF8[N+1]:=$80 Or ((U Shr 6) And 63);
   AlbumUTF8[N+2]:=$80 Or (U And 63); Inc(N,3); End;
  AlbumUTF8Size:=N;
 End;
End;

