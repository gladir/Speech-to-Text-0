 ligne ==== }
{ G1-BEGIN }
{ ---- Sun Rasterfile (libavcodec/sunrast.c) : profondeurs 1/4/8/24/32, RLE,
 palette ---- }
Procedure DecodeSunRast(Const Source,Target: String; Mode: LongInt);
Var
 F,Raw,Img,Mono: PEABuffer; Size,W,H,Depth,Typ,MapType,MapLen,Len,ALen,Stride,
  Pos,X,Y,Run,Value,Fmt,Q,I,LenP,Pix: LongInt;
 Bits,RowOut: LongInt; Tmp: Boolean; Dst,EndP: Int64; Cap: Int64;
Function RB32(At: LongInt): Int64;
Begin RB32:=Int64(EAByte(F,Size,At))*16777216+EAByte(F,Size,At+1)*65536+EAByte(
 F,Size,At+2)*256+EAByte(F,Size,At+3); End;
Function GB(At: LongInt): LongInt;
Begin GB:=EAByte(F,Size,At); End;
Begin
 NVLoad(Source,F,Size);
 If Size<32 Then Fail('sunrast: fichier trop court.');
 If RB32(0)<>$59A66A95 Then Fail('sunrast: signature invalide.');
 Cap:=RB32(4); If Cap>2147483647 Then Cap:=2147483647; W:=Cap;
 Cap:=RB32(8); If Cap>2147483647 Then Cap:=2147483647; H:=Cap;
 Depth:=RB32(12); Typ:=RB32(20); MapType:=RB32(24); MapLen:=RB32(28);
 Pos:=32;
 If Typ=$FFFF Then Fail('sunrast: type experimental non pris en charge.');
 If Typ>5 Then Fail('sunrast: type de compression invalide.');
 If MapType=2 Then Fail('sunrast: type de palette inconnu.');
 If MapType>2 Then Fail('sunrast: type de palette invalide.');
 If (Typ=4) Or (Typ=5) Then Fail(
  'sunrast: type de compression non pris en charge.');
 If (MapLen<0) Or (MapLen>768) Then Fail(
  'sunrast: longueur de palette invalide.');
 Case Depth Of
  1: If MapLen<>0 Then Fmt:=0 Else Fmt:=10;
  4: If MapLen<>0 Then Fmt:=0 Else Fail('sunrast: format de pixel invalide.');
  8: If MapLen<>0 Then Fmt:=0 Else Fmt:=4;
  24: If Typ=3 Then Fmt:=9 Else Fmt:=1;
  32: Fmt:=3;
  Else Fail('sunrast: profondeur invalide.');
 End;
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail(
  'sunrast: dimensions invalides.');
 Len:=(Depth*W+7) Shr 3; ALen:=Len+(Len And 1);
 If Int64(Size-Pos)<Int64(MapLen)+(Int64(Len)*H*3) Div 256 Then Fail(
  'sunrast: donnees insuffisantes.');
 NVBegin(Mode,Target,W,H,Fmt,25,1);
 FillChar(NVPalR,256,0); FillChar(NVPalG,256,0); FillChar(NVPalB,256,0);
 If (Depth>8) And (MapLen<>0) Then Begin { palette inutile, ignoree }
 End Else If MapLen<>0 Then Begin
  If MapLen Mod 3<>0 Then Fail('sunrast: longueur de palette invalide.');
  LenP:=MapLen Div 3;
  For X:=0 To LenP-1 Do Begin
   NVPalR[X]:=GB(Pos+X); NVPalG[X]:=GB(Pos+LenP+X); NVPalB[X]:=GB(Pos+LenP+LenP+
    X);
  End;
  NVPalAOn:=True; FillChar(NVPalA,256,0); FillChar(NVPalA,LenP,255);
 End;
 Inc(Pos,MapLen);
 Stride:=Len;
 GetMem(Raw,Int64(Stride)*H+64); FillChar(Raw^,Int64(Stride)*H+64,0);
 If Typ=2 Then Begin
  Dst:=0; EndP:=Int64(H)*Stride; X:=0; Y:=0;
  While (Dst<>EndP) And (Pos<Size) Do Begin
   Run:=1; Value:=GB(Pos); Inc(Pos);
   If Value=$80 Then Begin
    Run:=GB(Pos)+1; Inc(Pos);
    If Run<>1 Then Begin Value:=GB(Pos); Inc(Pos); End;
   End;
   While Run>0 Do Begin
    Dec(Run);
    If X<Len Then Raw^[Dst+X]:=Value;
    Inc(X);
    If X>=ALen Then Begin
     X:=0; Inc(Dst,Stride);
     If Dst=EndP Then Break;
    End;
   End;
  End;
 End Else Begin
  For Y:=0 To H-1 Do Begin
   If Size-Pos<ALen Then Break;
   Move(F^[Pos],Raw^[Y*Stride],Len); Inc(Pos,ALen);
  End;
 End;
 If Fmt=3 Then GetMem(Img,Int64(W)*H*4+64) Else If Fmt=10 Then GetMem(Img,Int64(
  W)*H+64) Else GetMem(Img,Int64(W)*H*NVBpp(Fmt)+64);
 Case Depth Of
  1: For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
      Q:=(Raw^[Y*Stride+(X Shr 3)] Shr (7-(X And 7))) And 1;
      If Fmt=0 Then Img^[Y*W+X]:=Q Else If Q<>0 Then Img^[Y*W+X]:=0 Else Img^[Y*
       W+X]:=255;
     End;
  4: For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
      Q:=Raw^[Y*Stride+(X Shr 1)];
      If (X And 1)=0 Then Img^[Y*W+X]:=Q Shr 4 Else Img^[Y*W+X]:=Q And 15;
     End;
  8: For Y:=0 To H-1 Do Move(Raw^[Y*Stride],Img^[Y*W],W);
  24: For Y:=0 To H-1 Do Move(Raw^[Y*Stride],Img^[Y*W*3],W*3);
  32: For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
      I:=Y*Stride+X*4; Q:=(Y*W+X)*4;
      If Typ=3 Then Begin Img^[Q]:=Raw^[I+3]; Img^[Q+1]:=Raw^[I+2]; Img^[Q+2]:=
       Raw^[I+1]; End
      Else Begin Img^[Q]:=Raw^[I+1]; Img^[Q+1]:=Raw^[I+2]; Img^[Q+2]:=Raw^[I+3];
       End;
      Img^[Q+3]:=255;
     End;
 End;
 If (Fmt=10) And (Mode=1) Then Begin
  { monob PNG : bits de bourrage a 1 en fin de ligne (swscale monow vers monob)
   }
  RowOut:=(W+7) Shr 3; GetMem(Mono,RowOut*H+16); FillChar(Mono^,RowOut*H+16,0);
  For Y:=0 To H-1 Do For X:=0 To RowOut*8-1 Do
   If (X>=W) Or (Img^[Y*W+X]>=128) Then Mono^[Y*RowOut+(X Shr 3)]:=Mono^[Y*
    RowOut+(X Shr 3)] Or ($80 Shr (X And 7));
  PNGDepth:=1; NVWritePNGEx(Mono,1,0); PNGDepth:=0; NVDone:=True; Inc(NVFrames);
   FreeMem(Mono);
 End Else
 NVEmit(Img);
 FreeMem(Img); FreeMem(Raw); FreeMem(F);
 NVFinish('sunrast');
End;

{ ---- Targa (libavcodec/targa.c) : decodeur ---- }
Procedure DecodeTarga(Const Source,Target: String; Mode: LongInt);
Var
 F,Img: PEABuffer; Size,Gp,IdLen,Pal,Compr,FirstClr,Colors,CSize,W,H,Bpp,Flags,
  Fmt,Depth,ImgSize,Interleave: LongInt;
 PalSz,PalSample,T,V,Y,X,Q,Stride,I: LongInt; TopDown: Boolean;
 { etat de balayage }
 CurL,CurY,CurX: LongInt; Null: Boolean;
Function GB(At: LongInt): LongInt;
Begin GB:=EAByte(F,Size,At); End;
Function Left: LongInt;
Begin Left:=Size-Gp; End;
{ adresse de debut de la ligne L (ordre de stockage) }
Function RowOfs(L: LongInt): LongInt;
Begin
 If TopDown Then RowOfs:=L*Stride Else RowOfs:=(H-1-L)*Stride;
End;
Procedure AdvanceLine;
Begin
 Inc(CurY,Interleave);
 If CurY<H Then Begin Inc(CurL,Interleave); End
 Else Begin
  CurY:=(CurY+1) And (Interleave-1);
  If (CurY<>0) And (CurY<H) Then CurL:=CurY Else Null:=True;
 End;
End;
Procedure PutB(Ofs,Val: LongInt);
Begin Img^[Ofs]:=Val; End;
Procedure DecodeRle;
Var Typ,Count,N,Cn,D: LongInt; Tmp: Array[0..3] Of Byte; Dst: LongInt;
Begin
 CurL:=0; CurY:=0; CurX:=0; Count:=0; Null:=False;
 While Not Null Do Begin
  If Left<=0 Then Fail('targa: fin des donnees avant la fin de l''image.');
  Typ:=GB(Gp); Inc(Gp);
  Count:=(Typ And $7F)+1; Typ:=Typ And $80;
  If Typ=0 Then Begin
   Repeat
    N:=W-CurX; If Count<N Then N:=Count;
    Dst:=RowOfs(CurL)+CurX*Depth;
    Cn:=N*Depth; If Cn>Left Then Cn:=Left; If Cn<0 Then Cn:=0;
    If Cn>0 Then Move(F^[Gp],Img^[Dst],Cn);
    Inc(Gp,Cn);
    Dec(Count,N); Inc(CurX,N);
    If CurX=W Then Begin CurX:=0; AdvanceLine; End;
   Until Null Or (Count<=0);
  End Else Begin
   FillChar(Tmp,4,0);
   For D:=0 To Depth-1 Do Begin If Gp<Size Then Tmp[D]:=F^[Gp]; Inc(Gp); End;
   Repeat
    N:=W-CurX; If Count<N Then N:=Count;
    Dec(Count,N);
    Dst:=RowOfs(CurL)+CurX*Depth;
    Inc(CurX,N);
    Repeat
     Move(Tmp,Img^[Dst],Depth); Inc(Dst,Depth); Dec(N);
    Until N=0;
    If CurX=W Then Begin CurX:=0; AdvanceLine; End;
   Until Null Or (Count<=0);
  End;
 End;
 If Count<>0 Then Fail('targa: paquet hors limites.');
End;
Begin
 NVLoad(Source,F,Size);
 If Size<18 Then Fail('targa: fichier trop court.');
 Gp:=0;
 IdLen:=GB(0); Pal:=GB(1); Compr:=GB(2);
 FirstClr:=GB(3)+GB(4)*256; Colors:=GB(5)+GB(6)*256; CSize:=GB(7);
 W:=GB(12)+GB(13)*256; H:=GB(14)+GB(15)*256; Bpp:=GB(16); Flags:=GB(17);
 Gp:=18;
 If (Pal=0) And ((FirstClr<>0) Or (Colors<>0) Or (CSize<>0)) Then Begin
  FirstClr:=0; Colors:=0; CSize:=0; End;
 If Left<IdLen+2*Colors Then Fail('targa: en-tete incomplet.');
 Inc(Gp,IdLen);
 Case Bpp Of
  8: If (Compr And Not 8)=3 Then Fmt:=4 Else Fmt:=0;
  15,16: Fmt:=2;
  24: Fmt:=1;
  32: Fmt:=3;
  Else Begin Fail('targa: profondeur non prise en charge.'); Fmt:=0; End;
 End;
 If (Colors<>0) And (Colors+FirstClr>256) Then Fail(
  'targa: palette incorrecte.');
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail(
  'targa: dimensions invalides.');
 If (Compr And Not 8)=0 Then Fail('targa: image sans donnees.');
 Depth:=(Bpp+1) Shr 3;
 ImgSize:=W*Depth;
 If (Compr And 8)=0 Then
  If Int64(Left)<Int64(ImgSize)*H Then Fail(
   'targa: donnees d''image insuffisantes.');
 TopDown:=(Flags And $20)<>0;
 Stride:=W*Depth;
 If (Flags And $40)<>0 Then Interleave:=2 Else If (Flags And $80)<>0 Then
  Interleave:=4 Else Interleave:=1;
 { l'ordre d'entrelacement de FFmpeg teste TGA_INTERLEAVE2 = 0x40 puis
  INTERLEAVE4 = 0x80 }
 NVBegin(Mode,Target,W,H,Fmt,25,1);
 FillChar(NVPalR,256,0); FillChar(NVPalG,256,0); FillChar(NVPalB,256,0);
 If Fmt=3 Then NVHasAlpha:=True;
 If Fmt=0 Then Begin NVPalAOn:=True; FillChar(NVPalA,256,0); End;
 If Colors<>0 Then Begin
  Case CSize Of
   32: PalSample:=4;
   24: PalSample:=3;
   16,15: PalSample:=2;
   Else Begin Fail('targa: taille d''entree de palette non prise en charge.');
    PalSample:=0; End;
  End;
  PalSz:=Colors*PalSample;
  If Fmt<>0 Then Inc(Gp,PalSz)
  Else Begin
   If Left<PalSz Then Fail('targa: palette incomplete.');
   For T:=0 To Colors-1 Do Begin
    Q:=FirstClr+T;
    Case PalSample Of
     4: Begin NVPalB[Q]:=GB(Gp); NVPalG[Q]:=GB(Gp+1); NVPalR[Q]:=GB(Gp+2);
      NVPalA[Q]:=GB(Gp+3); End;
     3: Begin NVPalB[Q]:=GB(Gp); NVPalG[Q]:=GB(Gp+1); NVPalR[Q]:=GB(Gp+2);
      NVPalA[Q]:=255; End;
     2: Begin
      V:=GB(Gp)+GB(Gp+1)*256;
      NVPalR[Q]:=((V And $7C00) Shr 7) Or ((V And $7C00) Shr 12);
      NVPalG[Q]:=((V And $3E0) Shr 2) Or ((V And $3E0) Shr 7);
      NVPalB[Q]:=((V And $1F) Shl 3) Or ((V And $1F) Shr 2); NVPalA[Q]:=255;
     End;
    End;
    Inc(Gp,PalSample);
   End;
  End;
 End;
 GetMem(Img,Int64(Stride)*H+64); FillChar(Img^,Int64(Stride)*H+64,0);
 If (Compr And 8)<>0 Then DecodeRle
 Else Begin
  If Int64(Left)<Int64(ImgSize)*H Then Fail(
   'targa: donnees d''image insuffisantes.');
  CurL:=0; CurY:=0; Null:=False;
  Repeat
   Move(F^[Gp],Img^[RowOfs(CurL)],ImgSize); Inc(Gp,ImgSize);
   AdvanceLine;
  Until Null;
 End;
 If (Flags And $10)<>0 Then
  For Y:=0 To H-1 Do
   For X:=0 To (W Shr 1)-1 Do
    Case Bpp Of
     32,24,16,8: For I:=0 To Depth-1 Do Begin
       V:=Img^[Y*Stride+X*Depth+I]; Img^[Y*Stride+X*Depth+I]:=Img^[Y*Stride+(W-
        1-X)*Depth+I]; Img^[Y*Stride+(W-1-X)*Depth+I]:=V;
      End;
    End;
 NVEmit(Img);
 FreeMem(Img); FreeMem(F);
 NVFinish('targa');
End;

{ ---- Renderware TXD (libavformat/txd.c, libavcodec/txd.c, texturedsp.c) ---- }
Procedure DecodeTXD(Const Source,Target: String; Mode: LongInt);
Var
 F,Img,PadBuf: PEABuffer; Size,Pos,Id,CSz,Marker,PkLen,Version,W,H,Depth,Flags,
  Gp,I,J,X,Y,Fmt,Cur,Need,Bw,Bh,PkEnd: LongInt;
 D3d: Int64; Began,Ok,Eof: Boolean; BegW,BegH,BegFmt: LongInt;
 Cols: Array[0..3] Of LongInt; ColA: Array[0..3] Of LongInt;
Function L32(At: LongInt): Int64;
Begin L32:=Int64(EAByte(F,Size,At))+EAByte(F,Size,At+1)*256+EAByte(F,Size,At+2)*
 65536+Int64(EAByte(F,Size,At+3))*16777216; End;
Function GB(At: LongInt): LongInt;
Begin If (At>=0) And (At<PkEnd) Then GB:=F^[At] Else GB:=0; End;
Function G16(At: LongInt): LongInt;
Begin G16:=GB(At)+GB(At+1)*256; End;
{ extract_color de texturedsp.c ; Cols[k] = R + G*256 + B*65536 (alpha a part) }
Procedure ExtractColor(C0,C1: LongInt; Dxtn: Boolean; Alpha: LongInt);
Var Tmp,R0,G0,B0,R1,G1,B1,A: LongInt;
Begin
 If Dxtn Then A:=0 Else A:=255;
 Tmp:=(C0 Shr 11)*255+16; R0:=((Tmp Div 32+Tmp) Div 32) And 255;
 Tmp:=((C0 And $7E0) Shr 5)*255+32; G0:=((Tmp Div 64+Tmp) Div 64) And 255;
 Tmp:=(C0 And $1F)*255+16; B0:=((Tmp Div 32+Tmp) Div 32) And 255;
 Tmp:=(C1 Shr 11)*255+16; R1:=((Tmp Div 32+Tmp) Div 32) And 255;
 Tmp:=((C1 And $7E0) Shr 5)*255+32; G1:=((Tmp Div 64+Tmp) Div 64) And 255;
 Tmp:=(C1 And $1F)*255+16; B1:=((Tmp Div 32+Tmp) Div 32) And 255;
 If Dxtn Or (C0>C1) Then Begin
  Cols[0]:=R0+G0*256+B0*65536; ColA[0]:=A;
  Cols[1]:=R1+G1*256+B1*65536; ColA[1]:=A;
  Cols[2]:=((2*R0+R1) Div 3)+((2*G0+G1) Div 3)*256+((2*B0+B1) Div 3)*65536;
   ColA[2]:=A;
  Cols[3]:=((2*R1+R0) Div 3)+((2*G1+G0) Div 3)*256+((2*B1+B0) Div 3)*65536;
   ColA[3]:=A;
 End Else Begin
  Cols[0]:=R0+G0*256+B0*65536; ColA[0]:=A;
  Cols[1]:=R1+G1*256+B1*65536; ColA[1]:=A;
  Cols[2]:=((R0+R1) Div 2)+((G0+G1) Div 2)*256+((B0+B1) Div 2)*65536; ColA[2]:=
   A;
  Cols[3]:=0; ColA[3]:=Alpha;
 End;
End;
{ ecrit un pixel RGBA (couleur c, alpha a) en BGRA natif }
Procedure PutPx(PxX,PxY,C,A: LongInt);
Var Q: LongInt;
Begin
 If PxY>=H Then Exit;
 If PxX=W Then Begin
  Q:=PxY*4; PadBuf^[Q]:=C And 255; PadBuf^[Q+1]:=(C Shr 8) And 255; PadBuf^[Q+
   2]:=(C Shr 16) And 255; PadBuf^[Q+3]:=A;
  PadBuf^[Q]:=(C Shr 16) And 255; PadBuf^[Q+2]:=C And 255; Exit;
 End;
 If PxX>W Then Exit;
 Q:=(PxY*W+PxX)*4;
 Img^[Q]:=(C Shr 16) And 255; Img^[Q+1]:=(C Shr 8) And 255; Img^[Q+2]:=C And
  255; Img^[Q+3]:=A;
End;
Procedure Dxt1Block(Bx,By,At: LongInt);
Var C0,C1,Code,Xx,Yy: LongInt; CodeL: Int64;
Begin
 C0:=G16(At); C1:=G16(At+2); CodeL:=G16(At+4)+Int64(G16(At+6))*65536;
 ExtractColor(C0,C1,False,255);
 For Yy:=0 To 3 Do For Xx:=0 To 3 Do Begin
  Code:=CodeL And 3; CodeL:=CodeL Shr 2;
  PutPx(Bx+Xx,By+Yy,Cols[Code],ColA[Code]);
 End;
End;
Procedure Dxt3Block(Bx,By,At: LongInt);
Var C0,C1,Code,Xx,Yy,Ac,Av: LongInt; CodeL: Int64;
Begin
 C0:=G16(At+8); C1:=G16(At+10); CodeL:=G16(At+12)+Int64(G16(At+14))*65536;
 ExtractColor(C0,C1,True,0);
 For Yy:=0 To 3 Do Begin
  Ac:=G16(At+2*Yy);
  For Xx:=0 To 3 Do Begin
   Av:=((Ac Shr (4*Xx)) And 15)*17;
   Code:=CodeL And 3; CodeL:=CodeL Shr 2;
   PutPx(Bx+Xx,By+Yy,Cols[Code],Av);
  End;
 End;
End;
Begin
 NVLoad(Source,F,Size);
 Pos:=0; Began:=False; Img:=Nil; Eof:=False; BegW:=0; BegH:=0; BegFmt:=0;
 While Not Eof Do Begin
  { txd_read_packet }
  PkLen:=-1;
  While PkLen<0 Do Begin
   If Size-Pos<12 Then Begin Eof:=True; Break; End;
   Id:=L32(Pos); CSz:=L32(Pos+4); Marker:=L32(Pos+8); Inc(Pos,12);
   If (Marker<>$1803FFFF) And (Marker<>$1003FFFF) Then Begin Eof:=True; Break;
    End;
   Case Id Of
    1: If CSz>100 Then PkLen:=CSz Else Begin If CSz>Size-Pos Then Pos:=Size Else
     Inc(Pos,CSz); End;
    3: Begin If CSz>Size-Pos Then Pos:=Size Else Inc(Pos,CSz); End;
    $16,$15: ;
    Else Begin Eof:=True; Break; End;
   End;
  End;
  If Eof Then Break;
  If Pos>=Size Then Break;
  If PkLen>Size-Pos Then PkLen:=Size-Pos;
  { txd_decode_frame sur [Pos, Pos+PkLen) }
  PkEnd:=Pos+PkLen; Gp:=Pos; Ok:=False;
  Repeat
   If PkLen<88 Then Break;
   Version:=L32(Pos) And $7FFFFFFF;
   D3d:=L32(Pos+76);
   W:=G16(Pos+80); H:=G16(Pos+82); Depth:=GB(Pos+84); Flags:=GB(Pos+87);
   Gp:=Pos+88;
   If (Version<8) Or (Version>9) Then Break;
   If Depth=8 Then Begin
    Fmt:=0;
    If PkEnd-Gp<W*H+1024 Then Break;
   End Else If Depth=16 Then Begin
    Fmt:=3;
    Case D3d Of
     0: Begin
      If (Flags And 1)=0 Then Break;
      If Int64(PkEnd-Gp)<Int64((W+3) Shr 2)*((H+3) Shr 2)*8+4 Then Break;
     End;
     $31545844: If Int64(PkEnd-Gp)<Int64((W+3) Shr 2)*((H+3) Shr 2)*8+4 Then
      Break;
     $33545844: If Int64(PkEnd-Gp)<Int64((W+3) Shr 2)*((H+3) Shr 2)*16+4 Then
      Break;
    End;
   End Else If Depth=32 Then Begin
    Fmt:=3;
    If Int64(PkEnd-Gp)<Int64(H)*W*4 Then Break;
   End Else Break;
   If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Break;
   { formats pris en charge }
   If Depth=16 Then If (D3d<>0) And (D3d<>$31545844) And (D3d<>$33545844) Then
    Break;
   If Depth=32 Then If (D3d<>$15) And (D3d<>$16) Then Break;
   If Not Began Then Begin
    NVBegin(Mode,Target,W,H,Fmt,5,1); Began:=True; BegW:=W; BegH:=H; BegFmt:=
     Fmt;
    If Fmt=3 Then NVHasAlpha:=True;
    NVPalAOn:=(Fmt=0);
   End Else If (W<>BegW) Or (H<>BegH) Or (Fmt<>BegFmt) Then Fail(
    'txd: changement de format ou de taille entre textures non pris en charge'+
    '.');
   GetMem(Img,Int64(W)*H*NVBpp(Fmt)+64); FillChar(Img^,Int64(W)*H*NVBpp(Fmt),0);
   GetMem(PadBuf,Int64(H)*4+64); FillChar(PadBuf^,Int64(H)*4+64,0);
   If Depth=8 Then Begin
    For I:=0 To 255 Do Begin
     NVPalR[I]:=GB(Gp+I*4); NVPalG[I]:=GB(Gp+I*4+1); NVPalB[I]:=GB(Gp+I*4+2);
      NVPalA[I]:=GB(Gp+I*4+3);
    End;
    Inc(Gp,1024+4);
    For Y:=0 To H-1 Do For X:=0 To W-1 Do Img^[Y*W+X]:=GB(Gp+Y*W+X);
   End Else If Depth=16 Then Begin
    Inc(Gp,4);
    J:=0;
    While J<H Do Begin
     I:=0;
     While I<W Do Begin
      If D3d=$33545844 Then Begin Dxt3Block(I,J,Gp); Inc(Gp,16); End
      Else Begin Dxt1Block(I,J,Gp); Inc(Gp,8); End;
      Inc(I,4);
     End;
     Inc(J,4);
    End;
   End Else Begin
    For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
     I:=Gp+(Y*W+X)*4;
     Img^[(Y*W+X)*4]:=GB(I+2); Img^[(Y*W+X)*4+1]:=GB(I+1); Img^[(Y*W+X)*4+2]:=
      GB(I); Img^[(Y*W+X)*4+3]:=GB(I+3);
    End;
   End;
   Ok:=True;
  Until True;
  If Ok Then Begin
   NVPad:=PadBuf; NVPadOn:=Odd(W) And (Depth=16);
   NVEmit(Img); FreeMem(Img); Img:=Nil; FreeMem(PadBuf); NVPadOn:=False;
  End
  Else Begin If Began Then NVRepeat; End;
  If NVDone Then Break;
  Inc(Pos,PkLen);
 End;
 FreeMem(F);
 If Not Began Then Fail('txd: aucune texture decodee.');
 NVFinish('txd');
End;

{ ---- TIFF (libavcodec/tiff.c, tiff_common.c, lzw.c) : decodeur ---- }
Const
 TFRev: Array[0..15] Of Byte=(0,8,4,12,2,10,6,14,1,9,5,13,3,11,7,15);
Var
 TFF: PEABuffer; TFSize,TFGp: LongInt;
 TFLe: Boolean;
 { etat persistant de l'image (tiff_init) }
 TFW,TFH,TFRps,TFStrips,TFSot,TFSstype,TFStripsizesoff,TFStripsize,TFStripoff,
  TFStrippos,TFPlanarF,TFPred,TFSub0,TFSub1: LongInt;
 TFBpp,TFBppCount,TFCompr,TFPhoto,TFFill: LongInt;
 TFSubIfd: Int64; TFIsThumb,TFIsTiled,TFDng,TFPalSet,TFTileBits: Boolean;
 TFLastTag: Int64; TFSarN,TFSarD: LongInt; TFRes: Array[0..3] Of Int64;
 TFPalR,TFPalG,TFPalB: Array[0..255] Of Byte;
 TFErr: String;
 { LZW }
 TFLzBuf: PEABuffer; TFLzSize,TFLzPos: LongInt;
 TFLzBits,TFLzMode,TFLzCur,TFLzMask,TFLzCode,TFLzClear,TFLzEnd,TFLzNew,TFLzTop,
  TFLzSlot,TFLzFc,TFLzOc,TFLzSp: LongInt;
 TFLzBbuf: LongWord;
 TFLzStack,TFLzSuffix: Array[0..4095] Of Byte; TFLzPrefix: Array[0..4095] Of
  Word;

Function TFGet8: LongInt;
Begin
 If TFGp<TFSize Then Begin TFGet8:=TFF^[TFGp]; Inc(TFGp); End Else Begin TFGp:=
  TFSize; TFGet8:=0; End;
End;
Function TFGet16: Int64;
Var A,B: LongInt;
Begin
 If TFSize-TFGp<2 Then Begin TFGp:=TFSize; TFGet16:=0; Exit; End;
 A:=TFF^[TFGp]; B:=TFF^[TFGp+1]; Inc(TFGp,2);
 If TFLe Then TFGet16:=A+B*256 Else TFGet16:=A*256+B;
End;
Function TFGet32: Int64;
Var A,B,C,D: Int64;
Begin
 If TFSize-TFGp<4 Then Begin TFGp:=TFSize; TFGet32:=0; Exit; End;
 A:=TFF^[TFGp]; B:=TFF^[TFGp+1]; C:=TFF^[TFGp+2]; D:=TFF^[TFGp+3]; Inc(TFGp,4);
 If TFLe Then TFGet32:=A+B*256+C*65536+D*16777216 Else TFGet32:=A*16777216+B*
  65536+C*256+D;
End;
Procedure TFSeek(Ofs: Int64);
Begin
 If Ofs<0 Then Ofs:=0;
 If Ofs>TFSize Then Ofs:=TFSize;
 TFGp:=Ofs;
End;
{ ff_tget : type BYTE=1 SHORT=3 LONG=4, autre = UINT_MAX }
Function TFGetT(Typ: LongInt): Int64;
Begin
 Case Typ Of
  1: TFGetT:=TFGet8;
  3: TFGetT:=TFGet16;
  4: TFGetT:=TFGet32;
  Else TFGetT:=4294967295;
 End;
End;
Function TFTypeSize(Typ: LongInt): LongInt;
Begin
 Case Typ Of
  1,6,7: TFTypeSize:=1;
  2: TFTypeSize:=100;
  3,8: TFTypeSize:=2;
  4,9,11,13: TFTypeSize:=4;
  5,10,12: TFTypeSize:=8;
  Else TFTypeSize:=0;
 End;
End;
{ lecture a position independante (flux de decalages / tailles de bandes) }
Function TFGetAt(Var Cur: LongInt; Typ: LongInt): Int64;
Var Sv: LongInt;
Begin
 Sv:=TFGp; TFGp:=Cur; TFGetAt:=TFGetT(Typ); Cur:=TFGp; TFGp:=Sv;
End;

{ ---- decodeur LZW TIFF (lzw.c) ---- }
Function TFLzMk(N: LongInt): LongInt;
Begin TFLzMk:=(1 Shl N)-1; End;
Procedure TFLzInit(Buf: PEABuffer; Sz: LongInt);
Begin
 TFLzBuf:=Buf; TFLzSize:=Sz; TFLzPos:=0; TFLzBbuf:=0; TFLzBits:=0;
 TFLzCode:=8; TFLzCur:=9; TFLzMask:=TFLzMk(9); TFLzTop:=1 Shl 9; TFLzClear:=1
  Shl 8; TFLzEnd:=TFLzClear+1;
 TFLzSlot:=TFLzClear+2; TFLzNew:=TFLzSlot; TFLzOc:=-1; TFLzFc:=-1; TFLzSp:=0;
End;
Function TFLzGetCode: LongInt;
Var C: Int64;
Begin
 If (TFLzBits<TFLzCur) And (TFLzPos>=TFLzSize) Then Begin TFLzGetCode:=TFLzEnd;
  Exit; End;
 While TFLzBits<TFLzCur Do Begin
  If TFLzPos<TFLzSize Then TFLzBbuf:=((TFLzBbuf Shl 8) Or TFLzBuf^[TFLzPos]) And
   $FFFFFFFF
  Else TFLzBbuf:=(TFLzBbuf Shl 8) And $FFFFFFFF;
  Inc(TFLzPos); Inc(TFLzBits,8);
 End;
 C:=TFLzBbuf Shr (TFLzBits-TFLzCur);
 Dec(TFLzBits,TFLzCur);
 TFLzGetCode:=C And TFLzMask;
End;
{ ff_lzw_decode : retourne le nombre d'octets decodes }
Function TFLzDecode(Buf: PEABuffer; Len: LongInt): LongInt;
Var L,C,Code,Oc,Fc,Sp,Bp: LongInt;
Label TheEnd;
Begin
 If TFLzEnd<0 Then Begin TFLzDecode:=0; Exit; End;
 L:=Len; Sp:=TFLzSp; Oc:=TFLzOc; Fc:=TFLzFc; Bp:=0;
 While True Do Begin
  While Sp>0 Do Begin
   Dec(Sp); Buf^[Bp]:=TFLzStack[Sp]; Inc(Bp);
   Dec(L);
   If L=0 Then Goto TheEnd;
  End;
  C:=TFLzGetCode;
  If C=TFLzEnd Then Break
  Else If C=TFLzClear Then Begin
   TFLzCur:=TFLzCode+1; TFLzMask:=TFLzMk(TFLzCur); TFLzSlot:=TFLzNew; TFLzTop:=1
    Shl TFLzCur; Fc:=-1; Oc:=-1;
  End Else Begin
   Code:=C;
   If (Code=TFLzSlot) And (Fc>=0) Then Begin
    TFLzStack[Sp]:=Fc; Inc(Sp); Code:=Oc;
   End Else If Code>=TFLzSlot Then Break;
   While Code>=TFLzNew Do Begin
    TFLzStack[Sp]:=TFLzSuffix[Code]; Inc(Sp); Code:=TFLzPrefix[Code];
   End;
   TFLzStack[Sp]:=Code; Inc(Sp);
   If (TFLzSlot<TFLzTop) And (Oc>=0) Then Begin
    TFLzSuffix[TFLzSlot]:=Code; TFLzPrefix[TFLzSlot]:=Oc; Inc(TFLzSlot);
   End;
   Fc:=Code; Oc:=C;
   If TFLzSlot>=TFLzTop-1 Then Begin
    If TFLzCur<12 Then Begin TFLzTop:=TFLzTop Shl 1; Inc(TFLzCur); TFLzMask:=
     TFLzMk(TFLzCur); End;
   End;
  End;
 End;
 TFLzEnd:=-1;
TheEnd:
 TFLzSp:=Sp; TFLzOc:=Oc; TFLzFc:=Fc;
 TFLzDecode:=Len-L;
End;

{ ---- horizontal_fill ---- }
Procedure TFHFill(BppA: LongInt; Dst: PEABuffer; UsePtr: Boolean; Src:
 PEABuffer; C: LongInt; Width,Offset: LongInt);
Var V,W: LongInt;
Begin
 Case BppA Of
  1: Begin
   W:=Width-1;
   While W>=0 Do Begin
    If UsePtr Then V:=Src^[W] Else V:=C;
    Dst^[(W+Offset)*8+7]:=V And 1; Dst^[(W+Offset)*8+6]:=(V Shr 1) And 1; Dst^[(
     W+Offset)*8+5]:=(V Shr 2) And 1; Dst^[(W+Offset)*8+4]:=(V Shr 3) And 1;
    Dst^[(W+Offset)*8+3]:=(V Shr 4) And 1; Dst^[(W+Offset)*8+2]:=(V Shr 5) And
     1; Dst^[(W+Offset)*8+1]:=(V Shr 6) And 1; Dst^[(W+Offset)*8]:=(V Shr 7) And
     1;
    Dec(W);
   End;
  End;
  2: Begin
   W:=Width-1;
   While W>=0 Do Begin
    If UsePtr Then V:=Src^[W] Else V:=C;
    Dst^[(W+Offset)*4+3]:=V And 3; Dst^[(W+Offset)*4+2]:=(V Shr 2) And 3; Dst^[(
     W+Offset)*4+1]:=(V Shr 4) And 3; Dst^[(W+Offset)*4]:=(V Shr 6) And 3;
    Dec(W);
   End;
  End;
  4: Begin
   W:=Width-1;
   While W>=0 Do Begin
    If UsePtr Then V:=Src^[W] Else V:=C;
    Dst^[(W+Offset)*2+1]:=V And 15; Dst^[(W+Offset)*2]:=(V Shr 4) And 15;
    Dec(W);
   End;
  End;
  Else Begin
   If UsePtr Then Move(Src^[0],Dst^[Offset],Width) Else FillChar(Dst^[Offset],
    Width,C);
  End;
 End;
End;

Function TFI32(V: Int64): LongInt;
Begin
 If V>2147483647 Then TFI32:=LongInt(V-4294967296) Else TFI32:=V;
End;

{ av_reduce avec max = INT32_MAX }
Procedure TFReduce(Num,Den: QWord; Var Rn,Rd: LongInt);
Var
 A0n,A0d,A1n,A1d,X,A2n,A2d,T2,Mx,NextDen: Int64; N,D,G1,G2,Tmp: QWord;
Begin
 Mx:=2147483647; A0n:=0; A0d:=1; A1n:=1; A1d:=0;
 N:=Num; D:=Den;
 G1:=N; G2:=D;
 While G2<>0 Do Begin Tmp:=G1 Mod G2; G1:=G2; G2:=Tmp; End;
 If G1<>0 Then Begin N:=N Div G1; D:=D Div G1; End;
 If (N<=QWord(Mx)) And (D<=QWord(Mx)) Then Begin A1n:=N; A1d:=D; D:=0; End;
 While D<>0 Do Begin
  X:=Int64(N Div D); NextDen:=Int64(N-D*QWord(X));
  A2n:=X*A1n+A0n; A2d:=X*A1d+A0d;
  If (A2n>Mx) Or (A2d>Mx) Then Begin
   If A1n<>0 Then X:=(Mx-A0n) Div A1n;
   If A1d<>0 Then Begin T2:=(Mx-A0d) Div A1d; If T2<X Then X:=T2; End;
   If Int64(D)*(2*X*A1d+A0d)>Int64(N)*A1d Then Begin A1n:=X*A1n+A0n; A1d:=X*A1d+
    A0d; End;
   Break;
  End;
  A0n:=A1n; A0d:=A1d; A1n:=A2n; A1d:=A2d;
  N:=D; D:=QWord(NextDen);
 End;
 Rn:=A1n; Rd:=A1d;
End;

Procedure TFSetSar(Tag,Num,Den: Int64);
Var Off: LongInt; N,D: QWord;
Begin
 If Tag=$11B Then Off:=2 Else Off:=0;
 TFRes[Off]:=Num; TFRes[Off+1]:=Den;
 If (TFRes[0]<>0) And (TFRes[1]<>0) And (TFRes[2]<>0) And (TFRes[3]<>0) Then
  Begin
  N:=QWord(TFRes[2])*QWord(TFRes[1]); D:=QWord(TFRes[0])*QWord(TFRes[3]);
  If (N>QWord(9223372036854775807)) Or (D>QWord(9223372036854775807)) Then Begin
   N:=N Shr 1; D:=D Shr 1; End;
  TFReduce(N,D,TFSarN,TFSarD);
  If TFSarD=0 Then Begin TFSarN:=0; TFSarD:=1; End;
 End;
End;

{ ---- analyse d'une entree d'IFD (tiff_decode_tag) ---- }
Var TFPalA: Array[0..255] Of Byte; TFBayer: Boolean; TFGeoCount,TFFaxOpts:
 LongInt;

Procedure TFDecodeTag;
Var
 Tag,Typ,Cnt,Start,Off,Value,Value2,V,Rr,Gg,Bb,P: Int64; I,N,Sz,Sh,P0,P1,P2,Gc:
  LongInt;
Begin
 Tag:=TFGet16; Typ:=TFGet16; Cnt:=TFGet32;
 Start:=TFGp+4;
 If (Typ=0) Or (Typ>=14) Then Begin TFSeek(Start); Exit; End;
 If (Tag=$8769) Or (Tag=$8825) Or (Tag=$A005) Or (Cnt>4) Or Not ((Int64(
  TFTypeSize(Typ))*Cnt<=4) Or (Typ=2)) Then TFSeek(TFGet32);
 If Tag<=TFLastTag Then Begin TFErr:=
  'tiff: etiquettes d''IFD dans le desordre.'; Exit; End;
 If Tag<>$117 Then TFLastTag:=Tag;
 Off:=TFGp; Value:=0; Value2:=1;
 If Cnt=1 Then Begin
  Case Typ Of
   1,3,4: Value:=TFGetT(Typ);
   5: Begin
    Value:=TFGet32; Value2:=TFGet32;
    If Value2=0 Then Value2:=1;
   End;
   2: ;
   Else Value:=4294967295;
  End;
 End;
 Case Tag Of
  $FE: TFIsThumb:=Value<>0;
  $100: TFW:=TFI32(Value);
  $101: TFH:=TFI32(Value);
  $102: Begin
   If (Cnt>5) Or (Cnt=0) Then Begin TFErr:=
    'tiff: format de pixels non pris en charge.'; Exit; End;
   TFBppCount:=Cnt;
   If Cnt=1 Then TFBpp:=TFI32(Value)
   Else Begin
    Case Typ Of
     1,3,4: Begin
      TFBpp:=0;
      If Int64(TFSize-TFGp)<Int64(TFTypeSize(Typ))*Cnt Then Begin TFErr:=
       'tiff: donnees invalides.'; Exit; End;
      For I:=1 To Cnt Do TFBpp:=TFBpp+TFI32(TFGetT(Typ));
     End;
     Else TFBpp:=-1;
    End;
   End;
  End;
  $115: Begin
   If Cnt<>1 Then Begin TFErr:='tiff: echantillons par pixel invalides.'; Exit;
    End;
   If (Value>5) Or (Value=0) Then Begin TFErr:=
    'tiff: echantillons par pixel invalides.'; Exit; End;
   If TFBppCount=1 Then TFBpp:=TFBpp*Value;
   TFBppCount:=Value;
  End;
  $103: Begin
   TFCompr:=TFI32(Value); TFPred:=0; If (TFCompr=3) Or (TFCompr=4) Then
    TFFaxOpts:=0;
   Case TFCompr Of
    1,2,3,4,5,6,7,8,$8005,$80B2,$886D: ;
    Else Begin TFErr:='tiff: methode de compression inconnue.'; Exit; End;
   End;
  End;
  $116: Begin
   If (Value=0) Or ((Typ=4) And (Value=4294967295)) Then Value:=TFH;
   If Value<TFH Then TFRps:=TFI32(Value) Else TFRps:=TFH;
  End;
  $111: Begin
   If Cnt=1 Then Begin
    If Value>2147483647 Then Begin TFErr:=
     'tiff: position de bande trop grande.'; Exit; End;
    TFStrippos:=0; TFStripoff:=Value;
   End Else TFStrippos:=Off;
   TFStrips:=TFI32(Cnt);
   If TFStrips=TFBppCount Then TFRps:=TFH;
   TFSot:=Typ;
  End;
  $117: Begin
   If Cnt=1 Then Begin
    If Value>2147483647 Then Begin TFErr:='tiff: taille de bande trop grande.';
     Exit; End;
    TFStripsizesoff:=0; TFStripsize:=Value; TFStrips:=1;
   End Else TFStripsizesoff:=Off;
   TFStrips:=TFI32(Cnt); TFSstype:=Typ;
  End;
  $11A,$11B: TFSetSar(Tag,Value,Value2);
  $144: Begin TFIsTiled:=True; TFTileBits:=True; End;
  $142,$143,$145: TFTileBits:=True;
  $13D: TFPred:=TFI32(Value);
  $124: If TFCompr=3 Then TFFaxOpts:=TFI32(Value);
  $125: If TFCompr=4 Then TFFaxOpts:=TFI32(Value);
  $14A: Begin
   If Cnt=1 Then TFSubIfd:=Value Else If Cnt>1 Then TFSubIfd:=TFGetT(4);
  End;
  $123: If (Cnt<1) Or (Cnt>65536) Then Begin TFErr:=
   'tiff: courbe de reponse invalide.'; Exit; End;
  $828D: Begin
   If Cnt<>2 Then Begin TFErr:='tiff: dimensions CFA non 2x2.'; Exit; End;
   If (TFGetT(Typ)<>2) And (TFGetT(Typ)<>2) Then Begin TFErr:=
    'tiff: dimensions CFA non 2x2.'; Exit; End;
  End;
  $828E: TFBayer:=True;
  $C612,$C613,$C618,$C61A,$C61D,$C621,$C622,$C623,$C624,$C627,$C628,$C629:
   TFDng:=True;
  $106: Begin
   Case Value Of
    0,1,2,3,5,6,32803,34892: TFPhoto:=Value;
    4,8,9,10,32844,32845: Begin TFErr:=
     'tiff: PhotometricInterpretation non pris en charge.'; Exit; End;
    Else Begin TFErr:='tiff: PhotometricInterpretation inconnue.'; Exit; End;
   End;
  End;
  $10A: Begin
   If (Value<1) Or (Value>2) Then Value:=1;
   TFFill:=Value-1;
  End;
  $140: Begin
   Sz:=TFTypeSize(Typ); N:=Cnt Div 3;
   If (N>256) Or (Int64(TFSize-TFGp)<N*Sz*3) Then Begin TFErr:=
    'tiff: palette invalide.'; Exit; End;
   Sh:=(Sz-1)*8;
   If Sh>31 Then Begin TFErr:='tiff: decalage de palette hors limites.'; Exit;
    End;
   P0:=TFGp; P1:=P0+N*Sz; P2:=P0+2*N*Sz;
   For I:=0 To N-1 Do Begin
    Rr:=TFGetAt(P0,Typ) Shr Sh; Gg:=TFGetAt(P1,Typ) Shr Sh; Bb:=TFGetAt(P2,Typ)
     Shr Sh;
    P:=(Rr Shl 16) Or (Gg Shl 8) Or Bb;
    TFPalR[I]:=(P Shr 16) And 255; TFPalG[I]:=(P Shr 8) And 255; TFPalB[I]:=P
     And 255; TFPalA[I]:=255;
   End;
   TFPalSet:=True;
  End;
  $11C: TFPlanarF:=Ord(Value=2);
  $212: Begin
   If Cnt<>2 Then Begin TFErr:='tiff: sous-echantillonnage invalide.'; Exit;
    End;
   For I:=0 To 1 Do Begin
    V:=TFGetT(Typ);
    If I=0 Then TFSub0:=TFI32(V) Else TFSub1:=TFI32(V);
    If TFI32(V)<=0 Then Begin
     If I=0 Then TFSub0:=1 Else TFSub1:=1;
     TFErr:='tiff: sous-echantillonnage invalide.'; Exit;
    End;
   End;
  End;
  $8773: If Int64(TFSize)-Off<Cnt Then Begin TFErr:=
   'tiff: profil ICC invalide.'; Exit; End;
  $87AF: Begin
   If Typ=3 Then Begin
    { GeoTIFF_Version (1 court), GeoTIFF_Key_Revision (2 courts) }
    If TFSize-TFGp>=2 Then Begin TFGet16; End;
    If TFSize-TFGp>=4 Then Begin TFGet16; TFGet16; End;
    Gc:=TFGet16;
    If Gc>(Cnt Div 4)-1 Then Gc:=(Cnt Div 4)-1;
    If (Int64(TFSize-TFGp)<Int64(Gc)*8) Or (Gc=0) Then Begin TFErr:=
     'tiff: repertoire GeoTIFF invalide.'; Exit; End;
    TFGeoCount:=Gc;
   End;
  End;
  $87B0: Begin
   If (Cnt>=268435455) Or (Int64(TFSize-TFGp)<Cnt*8) Then Begin TFErr:=
    'tiff: parametres GeoTIFF invalides.'; Exit; End;
  End;
 End;
 If (TFBpp>128) Or (TFBpp<0) Then Begin
  TFBpp:=0; TFErr:='tiff: format de pixels non pris en charge.'; Exit;
 End;
 TFSeek(Start);
End;

Const
 TFPixMono=0; TFPixPal=1; TFPixGray8=2; TFPixRgb24=3; TFPixYuv=4; TFPixGray16=5;
  TFPixYa8=6; TFPixYa16=7; TFPixRgba=8; TFPixRgb0=9;
 TFPixGray12=17; TFPixRgb48=10; TFPixRgba64=11; TFPixGbrp=12; TFPixGbrap=13;
  TFPixGbrp16=14; TFPixGbrap16=15; TFPixOther=16;
Var
 TFPix,TFWidth,TFStride: LongInt;
 TFPl: Array[0..3] Of PEABuffer; TFPlStr: Array[0..3] Of LongInt; TFPlSize:
  Array[0..3] Of LongInt;
 TFYuvLine: PEABuffer; TFYuvLen: LongInt; TFUrev: Boolean;

Function TFRevB(B: LongInt): LongInt;
Begin TFRevB:=(TFRev[B And 15] Shl 4) Or TFRev[B Shr 4]; End;

{ unpack_yuv : une ligne MCU du tampon yuv_line vers les plans }
Procedure TFUnpackYuv(Src: PEABuffer; Lnum: LongInt);
Var I,J,K,W2,Pu,Pv,Sp,Yy,Xx: LongInt;
Begin
 W2:=(TFW-1) Div TFSub0+1;
 Pu:=(Lnum Div TFSub1)*TFPlStr[1]; Pv:=(Lnum Div TFSub1)*TFPlStr[2]; Sp:=0;
 If ((TFW Mod TFSub0)<>0) Or ((TFH Mod TFSub1)<>0) Then Begin
  For I:=0 To W2-1 Do Begin
   For J:=0 To TFSub1-1 Do For K:=0 To TFSub0-1 Do Begin
    Yy:=Lnum+J; If Yy>TFH-1 Then Yy:=TFH-1;
    Xx:=I*TFSub0+K; If Xx>TFW-1 Then Xx:=TFW-1;
    TFPl[0]^[Yy*TFPlStr[0]+Xx]:=Src^[Sp]; Inc(Sp);
   End;
   TFPl[1]^[Pu]:=Src^[Sp]; Inc(Sp); Inc(Pu);
   TFPl[2]^[Pv]:=Src^[Sp]; Inc(Sp); Inc(Pv);
  End;
 End Else Begin
  For I:=0 To W2-1 Do Begin
   For J:=0 To TFSub1-1 Do For K:=0 To TFSub0-1 Do Begin
    TFPl[0]^[(Lnum+J)*TFPlStr[0]+I*TFSub0+K]:=Src^[Sp]; Inc(Sp);
   End;
   TFPl[1]^[Pu]:=Src^[Sp]; Inc(Sp); Inc(Pu);
   TFPl[2]^[Pv]:=Src^[Sp]; Inc(Sp); Inc(Pv);
  End;
 End;
End;

{ ---- decodeur XZ / LZMA2 (equivalent de lzma_stream_decoder pour TIFF
 compression 34925) ---- }
Type TXzProb=Array[0..16383] Of Word; PXzProb=^TXzProb;
Var
 XzIn: PEABuffer; XzInEnd,XzInPos: LongInt; XzOut: PEABuffer; XzCap,XzOutPos,
  XzDictStart: LongInt; XzDictSize: Int64; XzErr: Boolean;
 XzRange,XzCode: Int64; XzLc,XzLp,XzPb,XzState,XzRep0,XzRep1,XzRep2,XzRep3:
  LongInt;
 XzP: PXzProb; XzLit: PXzProb; XzChunkEnd: LongInt;

Const
 XzIsMatch=0; XzIsRep=192; XzIsRepG0=204; XzIsRepG1=216; XzIsRepG2=228;
  XzIsRep0Long=240; XzPosSlot=432; XzSpecPos=688; XzAlign=806;
 XzLenCoder=824; XzRepLenCoder=1340; XzTotal=1860;

Function XzByte: LongInt;
Begin
 If XzInPos>=XzChunkEnd Then Begin XzErr:=True; XzByte:=0; Exit; End;
 XzByte:=XzIn^[XzInPos]; Inc(XzInPos);
End;
Procedure XzNorm;
Begin
 If XzRange<16777216 Then Begin XzRange:=(XzRange Shl 8) And $FFFFFFFF; XzCode:=
  ((XzCode Shl 8) Or XzByte) And $FFFFFFFF; End;
End;
Function XzBit(Var Pr: Word): LongInt;
Var Bound: Int64;
Begin
 XzNorm;
 Bound:=(XzRange Shr 11)*Pr;
 If XzCode<Bound Then Begin
  XzRange:=Bound; Pr:=Pr+((2048-Pr) Shr 5); XzBit:=0;
 End Else Begin
  XzRange:=XzRange-Bound; XzCode:=XzCode-Bound; Pr:=Pr-(Pr Shr 5); XzBit:=1;
 End;
End;
Function XzDirect(N: LongInt): LongInt;
Var R: Int64;
Begin
 R:=0;
 While N>0 Do Begin
  XzNorm;
  XzRange:=XzRange Shr 1;
  If XzCode>=XzRange Then Begin XzCode:=XzCode-XzRange; R:=(R Shl 1) Or 1; End
   Else R:=R Shl 1;
  Dec(N);
 End;
 XzDirect:=R And $FFFFFFFF;
End;
Function XzTree(Base,Bits: LongInt): LongInt;
Var M,I: LongInt;
Begin
 M:=1;
 For I:=1 To Bits Do M:=(M Shl 1) Or XzBit(XzP^[Base+M]);
 XzTree:=M-(1 Shl Bits);
End;
Function XzTreeRev(Base,Bits: LongInt): LongInt;
Var M,I,Sym: LongInt;
Begin
 M:=1; Sym:=0;
 For I:=0 To Bits-1 Do Begin
  If XzBit(XzP^[Base+M])<>0 Then Begin M:=(M Shl 1) Or 1; Sym:=Sym Or (1 Shl I);
   End Else M:=M Shl 1;
 End;
 XzTreeRev:=Sym;
End;
Function XzLen(Base,PosState: LongInt): LongInt;
Begin
 { choice = Base, choice2 = Base+1, low = Base+2 + PosState*8, mid = Base+130 +
  PosState*8, high = Base+258 }
 If XzBit(XzP^[Base])=0 Then XzLen:=XzTree(Base+2+PosState*8,3)
 Else If XzBit(XzP^[Base+1])=0 Then XzLen:=8+XzTree(Base+130+PosState*8,3)
 Else XzLen:=16+XzTree(Base+258,8);
End;
Procedure XzResetState;
Var I: LongInt;
Begin
 For I:=0 To XzTotal-1 Do XzP^[I]:=1024;
 For I:=0 To (768 Shl (XzLc+XzLp))-1 Do XzLit^[I]:=1024;
 XzState:=0; XzRep0:=0; XzRep1:=0; XzRep2:=0; XzRep3:=0;
End;
Procedure XzPut(B: LongInt);
Begin
 If XzOutPos<XzCap Then XzOut^[XzOutPos]:=B;
 Inc(XzOutPos);
End;
{ decode un bloc LZMA de UnpSize octets depuis XzIn[XzInPos..XzChunkEnd[ ;
 retourne False si erreur }
Function XzLzmaChunk(UnpSize: LongInt): Boolean;
Var
 Target,PosState,Sym,Len,Slot,Nb,Pb2,Prev,LitState,MatchByte,Offs,Bit,Pos1,I,Lm:
  LongInt; PrevByte: LongInt; Dist: Int64;
 PosMask,LpMask: LongInt;
Begin
 XzLzmaChunk:=False;
 XzRange:=$FFFFFFFF; XzCode:=0;
 If XzByte<>0 Then Exit;
 For I:=1 To 4 Do XzCode:=((XzCode Shl 8) Or XzByte) And $FFFFFFFF;
 If XzErr Then Exit;
 Target:=XzOutPos+UnpSize;
 PosMask:=(1 Shl XzPb)-1; LpMask:=(1 Shl XzLp)-1;
 While XzOutPos<Target Do Begin
  If XzOutPos>=XzCap Then Begin XzLzmaChunk:=True; Exit; End;
  Pos1:=XzOutPos-XzDictStart;
  PosState:=Pos1 And PosMask;
  If XzBit(XzP^[XzIsMatch+(XzState Shl 4)+PosState])=0 Then Begin
   { litteral }
   If Pos1>0 Then PrevByte:=XzOut^[XzOutPos-1] Else PrevByte:=0;
   LitState:=((Pos1 And LpMask) Shl XzLc)+(PrevByte Shr (8-XzLc));
   Offs:=LitState*768;
   Sym:=1;
   If XzState>=7 Then Begin
    MatchByte:=XzOut^[XzOutPos-XzRep0-1];
    Offs:=Offs; Lm:=256;
    Repeat
     MatchByte:=MatchByte Shl 1;
     Bit:=MatchByte And Lm;
     Prev:=XzBit(XzLit^[Offs+Lm+Bit+Sym]);
     Sym:=(Sym Shl 1) Or Prev;
     If Prev=0 Then Lm:=Lm And Not Bit Else Lm:=Lm And Bit;
    Until Sym>=256;
   End Else
    Repeat Sym:=(Sym Shl 1) Or XzBit(XzLit^[Offs+Sym]); Until Sym>=256;
   XzPut(Sym And 255);
   If XzState<4 Then XzState:=0 Else If XzState<10 Then Dec(XzState,3) Else Dec(
    XzState,6);
  End Else Begin
   If XzBit(XzP^[XzIsRep+XzState])<>0 Then Begin
    If Pos1=0 Then Begin XzErr:=True; Exit; End;
    If XzBit(XzP^[XzIsRepG0+XzState])=0 Then Begin
     If XzBit(XzP^[XzIsRep0Long+(XzState Shl 4)+PosState])=0 Then Begin
      { short rep }
      If XzRep0>=Pos1 Then Begin XzErr:=True; Exit; End;
      If XzState<7 Then XzState:=9 Else XzState:=11;
      XzPut(XzOut^[XzOutPos-XzRep0-1]);
      Continue;
     End;
    End Else Begin
     If XzBit(XzP^[XzIsRepG1+XzState])=0 Then Begin Dist:=XzRep1; End
     Else Begin
      If XzBit(XzP^[XzIsRepG2+XzState])=0 Then Dist:=XzRep2 Else Begin Dist:=
       XzRep3; XzRep3:=XzRep2; End;
      XzRep2:=XzRep1;
     End;
     XzRep1:=XzRep0; XzRep0:=Dist;
    End;
    Len:=XzLen(XzRepLenCoder,PosState);
    If XzState<7 Then XzState:=8 Else XzState:=11;
   End Else Begin
    XzRep3:=XzRep2; XzRep2:=XzRep1; XzRep1:=XzRep0;
    Len:=XzLen(XzLenCoder,PosState);
    If XzState<7 Then XzState:=7 Else XzState:=10;
    If Len<4 Then Lm:=Len Else Lm:=3;
    Slot:=XzTree(XzPosSlot+Lm*64,6);
    If Slot<4 Then XzRep0:=Slot
    Else Begin
     Nb:=(Slot Shr 1)-1;
     Dist:=(2 Or (Slot And 1)) Shl Nb;
     If Slot<14 Then Dist:=Dist+XzTreeRev(XzSpecPos+Dist-Slot-1,Nb)
     Else Begin
      Dist:=Dist+(XzDirect(Nb-4) Shl 4);
      Dist:=Dist+XzTreeRev(XzAlign,4);
     End;
     If Dist>2000000000 Then Begin XzErr:=True; Exit; End;
     XzRep0:=Dist;
    End;
   End;
   Inc(Len,2);
   { copie }
   If (XzRep0>=Pos1) Or (Int64(XzRep0)>=XzDictSize) Then Begin XzErr:=True;
    Exit; End;
   While (Len>0) And (XzOutPos<XzCap) And (XzOutPos<Target) Do Begin
    XzPut(XzOut^[XzOutPos-XzRep0-1]); Dec(Len);
   End;
   If Len>0 Then Begin
    If XzOutPos>=XzCap Then Begin XzLzmaChunk:=True; Exit; End;
    XzErr:=True; Exit; { la longueur depasse la taille du bloc }
   End;
  End;
  If XzErr Then Exit;
 End;
 XzLzmaChunk:=Not XzErr;
End;

Var XzCrcT: Array[0..255] Of LongWord; XzCrcOk: Boolean;
Function XzCrc32(B: PEABuffer; Start,Len: LongInt): LongWord;
Var N,K,I: LongInt; C: LongWord;
Begin
 If Not XzCrcOk Then Begin
  For N:=0 To 255 Do Begin C:=N; For K:=0 To 7 Do If (C And 1)<>0 Then C:=(C Shr
   1) Xor $EDB88320 Else C:=C Shr 1; XzCrcT[N]:=C; End;
  XzCrcOk:=True;
 End;
 C:=$FFFFFFFF;
 For I:=Start To Start+Len-1 Do C:=XzCrcT[(C Xor B^[I]) And 255] Xor (C Shr 8);
 XzCrc32:=C Xor $FFFFFFFF;
End;
Function XzVarint(Var Pos: LongInt; Var V: Int64): Boolean;
Var Sh,B: LongInt;
Begin
 V:=0; Sh:=0; XzVarint:=False;
 Repeat
  If (Pos>=XzInEnd) Or (Sh>56) Then Exit;
  B:=XzIn^[Pos]; Inc(Pos);
  V:=V Or (Int64(B And 127) Shl Sh); Inc(Sh,7);
 Until (B And 128)=0;
 XzVarint:=True;
End;

{ retourne True si le flux est valide jusqu'a remplir Cap octets (ou la fin du
 flux) ; OutLen = octets produits }
Function XzDecode(Src: PEABuffer; SrcLen: LongInt; Dst: PEABuffer; Cap: LongInt;
 Var OutLen: LongInt): Boolean;
Var
 Pos,HdrSize,Nf,Flg,I,Ctl,Usz,Psz,Props,ChkSz,BlkStart,Check: LongInt; V,FId:
  Int64; HdrEnd: LongInt; Ok: Boolean; Reset: LongInt; HavePr,HaveDict: Boolean;
  DDist,BlkOut,K2: LongInt;
Procedure ApplyDelta;
Var Q,E: LongInt;
Begin
 If DDist=0 Then Exit;
 E:=XzOutPos; If E>XzCap Then E:=XzCap;
 For Q:=BlkOut+DDist To E-1 Do XzOut^[Q]:=(XzOut^[Q]+XzOut^[Q-DDist]) And 255;
End;
Begin
 XzDecode:=False; OutLen:=0;
 If SrcLen<12 Then Exit;
 XzIn:=Src; XzInEnd:=SrcLen; XzOut:=Dst; XzCap:=Cap; XzOutPos:=0; XzErr:=False;
 If (Src^[0]<>$FD) Or (Src^[1]<>$37) Or (Src^[2]<>$7A) Or (Src^[3]<>$58) Or (
  Src^[4]<>$5A) Or (Src^[5]<>0) Then Exit;
 If (Src^[6]<>0) Or ((Src^[7] And $F0)<>0) Then Exit;
 If XzCrc32(Src,6,2)<>LongWord(Src^[8]+Src^[9]*256+Src^[10]*65536+Int64(Src^[
  11])*16777216) Then Exit;
 Check:=Src^[7] And 15;
 Case Check Of 0: ChkSz:=0; 1: ChkSz:=4; 4: ChkSz:=8; 10: ChkSz:=32; Else Exit;
  End;
 Pos:=12;
 GetMem(XzP,SizeOf(TXzProb)); GetMem(XzLit,(768 Shl 4)*2+64);
 HavePr:=False;
 While True Do Begin
  If Pos>=SrcLen Then Break;
  If Src^[Pos]=0 Then Break; { index }
  BlkStart:=Pos;
  HdrSize:=(Src^[Pos]+1)*4;
  If Pos+HdrSize>SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  If XzCrc32(Src,Pos,HdrSize-4)<>LongWord(Src^[Pos+HdrSize-4]+Src^[Pos+HdrSize-
   3]*256+Src^[Pos+HdrSize-2]*65536+Int64(Src^[Pos+HdrSize-1])*16777216) Then
   Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  Flg:=Src^[Pos+1]; Nf:=(Flg And 3)+1; I:=Pos+2; HdrEnd:=Pos+HdrSize-4;
  If (Flg And $3C)<>0 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  If (Flg And $40)<>0 Then Begin If Not XzVarint(I,V) Then Begin FreeMem(XzP);
   FreeMem(XzLit); Exit; End; End;
  If (Flg And $80)<>0 Then Begin If Not XzVarint(I,V) Then Begin FreeMem(XzP);
   FreeMem(XzLit); Exit; End; End;
  DDist:=0;
  For K2:=1 To Nf-1 Do Begin
   If Not XzVarint(I,FId) Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   If FId<>3 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   If Not XzVarint(I,V) Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   If (V<>1) Or (I>=HdrEnd) Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   If DDist<>0 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   DDist:=Src^[I]+1; Inc(I);
  End;
  If Not XzVarint(I,FId) Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  If FId<>$21 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  If Not XzVarint(I,V) Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  If (V<>1) Or (I>=HdrEnd) Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  Props:=Src^[I]; Inc(I);
  If Props>40 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
  If Props=40 Then XzDictSize:=4294967295 Else XzDictSize:=Int64(2 Or (Props And
   1)) Shl ((Props Shr 1)+11);
  If XzDictSize<4096 Then XzDictSize:=4096;
  While I<HdrEnd Do Begin If Src^[I]<>0 Then Begin FreeMem(XzP); FreeMem(XzLit);
   Exit; End; Inc(I); End;
  Pos:=Pos+HdrSize;
  { donnees LZMA2 }
  HaveDict:=False; XzDictStart:=XzOutPos; BlkOut:=XzOutPos;
  While True Do Begin
   If Pos>=SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   Ctl:=Src^[Pos]; Inc(Pos);
   If Ctl=0 Then Break;
   If (Ctl=1) Or (Ctl=2) Then Begin
    If Pos+2>SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    Usz:=Src^[Pos]*256+Src^[Pos+1]+1; Inc(Pos,2);
    If Ctl=1 Then Begin XzDictStart:=XzOutPos; HaveDict:=True; End Else If Not
     HaveDict Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    If Pos+Usz>SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    For I:=0 To Usz-1 Do Begin
     If XzOutPos>=XzCap Then Begin ApplyDelta; OutLen:=XzCap; XzDecode:=True;
      FreeMem(XzP); FreeMem(XzLit); Exit; End;
     XzPut(Src^[Pos+I]);
    End;
    Inc(Pos,Usz);
   End Else If Ctl>=$80 Then Begin
    If Pos+4>SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    Usz:=((Ctl And $1F) Shl 16)+Src^[Pos]*256+Src^[Pos+1]+1; Psz:=Src^[Pos+2]*
     256+Src^[Pos+3]+1; Inc(Pos,4);
    Reset:=(Ctl Shr 5) And 3;
    If Reset=3 Then Begin XzDictStart:=XzOutPos; HaveDict:=True; End;
    If Not HaveDict Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    If Reset>=2 Then Begin
     If Pos>=SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
     Props:=Src^[Pos]; Inc(Pos);
     If Props>=225 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
     XzLc:=Props Mod 9; Props:=Props Div 9; XzLp:=Props Mod 5; XzPb:=Props Div
      5;
     If XzLc+XzLp>4 Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
     HavePr:=True;
    End Else If Not HavePr Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    If Reset>=1 Then XzResetState;
    If Pos+Psz>SrcLen Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    XzInPos:=Pos; XzChunkEnd:=Pos+Psz;
    Ok:=XzLzmaChunk(Usz);
    If XzErr Or Not Ok Then Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
    If XzOutPos>=XzCap Then Begin ApplyDelta; OutLen:=XzCap; XzDecode:=True;
     FreeMem(XzP); FreeMem(XzLit); Exit; End;
    Pos:=XzChunkEnd;
   End Else Begin FreeMem(XzP); FreeMem(XzLit); Exit; End;
   If XzOutPos>=XzCap Then Begin
    { sortie pleine : liblzma continue d'analyser la fin du bloc ; flux valide
     suppose }
    ApplyDelta; OutLen:=XzCap; XzDecode:=True; FreeMem(XzP); FreeMem(XzLit);
     Exit;
   End;
  End;
  ApplyDelta;
  { remplissage du bloc a 4 octets (depuis le debut de l'en-tete), puis controle
   }
  Pos:=Pos+((4-((Pos-BlkStart) And 3)) And 3)+ChkSz;
 End;
 FreeMem(XzP); FreeMem(XzLit);
 OutLen:=XzOutPos; If OutLen>XzCap Then OutLen:=XzCap;
 XzDecode:=True;
End;

{ ---- CCITT RLE / Group 3 / Group 4 (libavcodec/faxcompr.c) ---- }
