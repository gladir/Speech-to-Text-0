  Move(G2ULU^[R*G2ULCS],G2AFr^[G2ULW*G2ULH+R*NVCW],NVCW);
  Move(G2ULV^[R*G2ULCS],G2AFr^[G2ULW*G2ULH+NVCW*NVCH+R*NVCW],NVCW);
 End;
 G2ULWrap:=True;
End;

Procedure DecodeG2UL(Const Source,Target: String; Mode: LongInt);
Begin
