Function R34Sar(V,N: LongInt): LongInt;
Begin If V>=0 Then R34Sar:=V Shr N Else R34Sar:=-1-((-1-V) Shr N); End;
Function R34S16(V: LongInt): LongInt;
Begin R34S16:=((V And $FFFF) Xor $8000)-$8000; End;
Function R34Clip(V: LongInt): LongInt;
Begin If V<0 Then R34Clip:=0 Else If V>255 Then R34Clip:=255 Else R34Clip:=V;
 End;
Function R34Mid(A,B,C: LongInt): LongInt;
Begin
 If A>B Then Begin If B>C Then R34Mid:=B Else If A>C Then R34Mid:=C Else
  R34Mid:=A; End
 Else Begin If A>C Then R34Mid:=A Else If B>C Then R34Mid:=C Else R34Mid:=B;
  End;
End;
Function R34Abs(V: LongInt): LongInt;
Begin If V<0 Then R34Abs:=-V Else R34Abs:=V; End;
Function R34W32(V: Int64): LongInt;
Begin V:=V And $FFFFFFFF; If V>=$80000000 Then V:=V-$100000000; R34W32:=V; End;

{ ---- lecteur de bits (get_bits.h, lecteur "verifie") ---- }
Function R34ByteAt(I: LongInt): LongInt;
Begin If (I>=0) And (I<R34DataLen) Then R34ByteAt:=R34Data^[I] Else R34ByteAt:=
 0; End;

Procedure R34InitGb(Base,SizeBytes: LongInt);
Begin R34GbBase:=Base; R34GbSize:=SizeBytes*8; R34GbPos:=0; End;

{ 32 bits suivants (octets hors paquet = 0) }
Function R34Peek32: LongWord;
Var Idx: LongInt; V: Int64;
Begin
 Idx:=R34GbBase+(R34GbPos Shr 3);
 V:=(Int64(R34ByteAt(Idx)) Shl 32) Or (Int64(R34ByteAt(Idx+1)) Shl 24) Or (
  Int64(R34ByteAt(Idx+2)) Shl 16)
    Or (Int64(R34ByteAt(Idx+3)) Shl 8) Or Int64(R34ByteAt(Idx+4));
 V:=(V Shl (R34GbPos And 7)) And $FFFFFFFFFF;
 R34Peek32:=LongWord((V Shr 8) And $FFFFFFFF);
End;
Function R34Peek(N: LongInt): LongInt;
Begin If N<=0 Then R34Peek:=0 Else R34Peek:=LongInt(R34Peek32 Shr (32-N)); End;
Procedure R34Skip(N: LongInt);
Begin
 Inc(R34GbPos,N);
 If R34GbPos>R34GbSize+8 Then R34GbPos:=R34GbSize+8;
End;
Function R34GetBits(N: LongInt): LongInt;
Begin R34GetBits:=R34Peek(N); R34Skip(N); End;
Function R34Get1: LongInt;
Begin R34Get1:=R34Peek(1); R34Skip(1); End;
Function R34BitsLeft: LongInt;
Begin R34BitsLeft:=R34GbSize-R34GbPos; End;

{ ---- Exp-Golomb entrelace (golomb.h) ---- }
{ (len, valeur ue, valeur "dirac") pour les 8 bits de tete }
Procedure R34IlvTab(B8: LongInt; Var Len,Ue,Dirac: LongInt);
Var P,Ret,Stop: LongInt;
Begin
 Ret:=1; Stop:=-1;
 For P:=0 To 3 Do Begin
  If ((B8 Shr (7-2*P)) And 1)=1 Then Begin Stop:=P; Break; End;
  Ret:=Ret*2+((B8 Shr (6-2*P)) And 1);
 End;
 If Stop<0 Then Begin Len:=9; Dirac:=Ret And 15; End
 Else Begin Len:=2*Stop+1; Dirac:=Ret And ((1 Shl Stop)-1); End;
 Ue:=Ret-1;
End;

Function R34GetIUE: LongWord;
Var Buf: LongWord; B8,Len,Ue,Dr: LongInt; Ret: LongWord;
Begin
 Buf:=R34Peek32;
 If (Buf And $AA800000)<>0 Then Begin
  B8:=LongInt(Buf Shr 24);
  R34IlvTab(B8,Len,Ue,Dr);
  R34Skip(Len);
  R34GetIUE:=LongWord(Ue); Exit;
 End;
 Ret:=1;
 Repeat
  B8:=LongInt(Buf Shr 24);
  R34IlvTab(B8,Len,Ue,Dr);
  If Len<8 Then R34Skip(Len) Else R34Skip(8);
  If Len<>9 Then Begin
   Ret:=(Ret Shl ((Len-1) Shr 1)) Or LongWord(Dr);
   Break;
  End;
  Ret:=(Ret Shl 4) Or LongWord(Dr);
  Buf:=R34Peek32;
 Until Not ((Ret<$8000000) And (R34GbPos<R34GbSize+8));
 R34GetIUE:=Ret-1;
End;

Function R34GetISE: LongInt;
Var Buf: LongWord; N,Ret,M,K: LongInt; B8,Len,Ue,Dr: LongInt; Found: Boolean;
 Rt: Int64;
Begin
 Buf:=R34Peek32;
 If (Buf And $AA800000)<>0 Then Begin
  B8:=LongInt(Buf Shr 24);
  R34IlvTab(B8,Len,Ue,Dr);
  R34Skip(Len);
  Rt:=Ue+1;
  M:=LongInt(Rt Shr 1);
  If (Rt And 1)<>0 Then R34GetISE:=-M Else R34GetISE:=M;
  Exit;
 End;
 Buf:=Buf Or 1;
 If (Buf And $AAAAAAAA)=0 Then Begin R34GetISE:=R34_INVALID; Exit; End;
 { cherche le premier drapeau a 1 (positions 31,29,...) }
 N:=0; Rt:=1; Found:=False;
 For K:=0 To 15 Do Begin
  If ((Buf Shr (31-2*K)) And 1)=1 Then Begin N:=K; Found:=True; Break; End;
  Rt:=Rt*2+((Buf Shr (30-2*K)) And 1);
 End;
 R34Skip(2*N+1);
 M:=LongInt(Rt Shr 1);
 If (Rt And 1)<>0 Then R34GetISE:=-M Else R34GetISE:=M;
End;

{ ---- VLC ---- }
Function R34NewVlc: LongInt;
Begin
 R34VOff[R34NVlc]:=R34VUsed; R34VN[R34NVlc]:=0;
 R34NewVlc:=R34NVlc; Inc(R34NVlc);
End;

Procedure R34AddEnt(Id,Code16,Len,Sym: LongInt);
Begin
 If R34VUsed>=R34_VPOOL Then Exit;
 R34VCode^[R34VUsed]:=Code16; R34VLen^[R34VUsed]:=Len; R34VSym^[R34VUsed]:=Sym;
 Inc(R34VUsed); Inc(R34VN[Id]);
End;

{ code canonique a partir des longueurs (rv34_gen_vlc) }
Function R34BuildCanon(Off,N: LongInt; UseCbp: Boolean): LongInt;
Var Cnt,First: Array[0..17] Of LongInt; L,I,Code,Sym,Id: LongInt;
Begin
 Id:=R34NewVlc;
 FillChar(Cnt,SizeOf(Cnt),0); FillChar(First,SizeOf(First),0);
 For I:=0 To N-1 Do Inc(Cnt[R34Tab^[Off+I]]);
 Cnt[0]:=0; First[0]:=0;
 For L:=0 To 15 Do First[L+1]:=(First[L]+Cnt[L]) Shl 1;
 For L:=1 To 16 Do Begin
  Code:=First[L];
  For I:=0 To N-1 Do If R34Tab^[Off+I]=L Then Begin
   Sym:=I; If UseCbp Then Sym:=R34CbpCode[I];
   R34AddEnt(Id,Code Shl (16-L),L,Sym); Inc(Code);
  End;
 End;
 R34BuildCanon:=Id;
End;

Var R34TSym,R34TLen: Array[0..127] Of LongInt;
{ codes affectes dans l'ordre des entrees (ff_vlc_init_from_lengths) }
Function R34BuildSeq(N: LongInt): LongInt;
Var I,Id,Ln: LongInt; Code: Int64;
Begin
 Id:=R34NewVlc; Code:=0;
 For I:=0 To N-1 Do Begin
  Ln:=R34TLen[I];
  If Ln>0 Then Begin
   R34AddEnt(Id,LongInt((Code Shr 16) And $FFFF),Ln,R34TSym[I]);
   Code:=Code+(Int64(1) Shl (32-Ln));
  End;
 End;
 R34BuildSeq:=Id;
End;

Procedure R34InitTables;
Var I,J,K,N,Hx,P,V: LongInt; S: String;
Function HexV(C: Char): LongInt;
Begin If (C>='0') And (C<='9') Then HexV:=Ord(C)-48 Else HexV:=Ord(C)-55; End;
Begin
 If R34TabsReady Then Exit;
 GetMem(R34Tab,R34TabN+64);
 P:=0;
 For I:=0 To R34HexN-1 Do Begin
  S:=R34Hex[I];
  For J:=0 To (Length(S) Div 2)-1 Do Begin
   R34Tab^[P]:=HexV(S[J*2+1])*16+HexV(S[J*2+2]); Inc(P);
  End;
 End;
 GetMem(R34VCode,R34_VPOOL*2+64); GetMem(R34VLen,R34_VPOOL+64); GetMem(R34VSym,
  R34_VPOOL*2+64);
 R34NVlc:=0; R34VUsed:=0;
 FillChar(R34Sets,SizeOf(R34Sets),0);
 For I:=0 To 4 Do With R34Sets[I] Do Begin
  For J:=0 To 1 Do Begin
   CbpPat[J]:=R34BuildCanon(R34O_ICBPPAT+(I*2+J)*1296,1296,False);
   Second[J]:=R34BuildCanon(R34O_ISECOND+(I*2+J)*108,108,False);
   Third[J]:=R34BuildCanon(R34O_ITHIRD+(I*2+J)*108,108,False);
   For K:=0 To 3 Do Cbp[J,K]:=R34BuildCanon(R34O_ICBP+(I*8+J+K*2)*16,16,True);
  End;
  For J:=0 To 3 Do First[J]:=R34BuildCanon(R34O_IFIRST+(I*4+J)*864,864,False);
  Coef:=R34BuildCanon(R34O_ICOEF+I*32,32,False);
 End;
 For I:=0 To 6 Do With R34Sets[5+I] Do Begin
  CbpPat[0]:=R34BuildCanon(R34O_PCBPPAT+I*1296,1296,False);
  For J:=0 To 3 Do Cbp[0,J]:=R34BuildCanon(R34O_PCBP+(I*4+J)*16,16,True);
  For J:=0 To 1 Do Begin
   First[J]:=R34BuildCanon(R34O_PFIRST+(I*2+J)*864,864,False);
   Second[J]:=R34BuildCanon(R34O_PSECOND+(I*2+J)*108,108,False);
   Third[J]:=R34BuildCanon(R34O_PTHIRD+(I*2+J)*108,108,False);
  End;
  Coef:=R34BuildCanon(R34O_PCOEF+I*32,32,False);
 End;
 { RV40 }
 For K:=0 To 15 Do Begin R34TSym[K]:=R34Tab^[R34O_AICTOP+K]; R34TLen[K]:=
  R34Tab^[R34O_AICTOP+16+K]; End;
 R34AicTop:=R34BuildSeq(16);
 For I:=0 To 89 Do Begin
  R34AicMode1[I]:=-1;
  If (I Mod 10)=9 Then Continue;
  For K:=0 To 8 Do Begin
   R34TSym[K]:=R34Tab^[R34O_MODE1+I*18+K*2]; R34TLen[K]:=R34Tab^[R34O_MODE1+I*
    18+K*2+1];
  End;
  R34AicMode1[I]:=R34BuildSeq(9);
 End;
 For I:=0 To 19 Do Begin
  For K:=0 To 80 Do Begin
   V:=R34Tab^[R34O_MODE2SYM+I*81+K];
   R34TSym[K]:=(V Shr 4) Or ((V And 15) Shl 8);
   R34TLen[K]:=R34Tab^[R34O_MODE2BITS+I*81+K];
  End;
  R34AicMode2[I]:=R34BuildSeq(81);
 End;
 For I:=0 To 6 Do Begin
  For K:=0 To 7 Do Begin R34TSym[K]:=R34Tab^[R34O_PTYPE+I*16+K*2]; R34TLen[K]:=
   R34Tab^[R34O_PTYPE+I*16+K*2+1]; End;
  R34PtypeV[I]:=R34BuildSeq(8);
 End;
 For I:=0 To 5 Do Begin
  For K:=0 To 6 Do Begin R34TSym[K]:=R34Tab^[R34O_BTYPE+I*14+K*2]; R34TLen[K]:=
   R34Tab^[R34O_BTYPE+I*14+K*2+1]; End;
  R34BtypeV[I]:=R34BuildSeq(7);
 End;
 R34TabsReady:=True;
End;

Function R34GetVlc(Id: LongInt): LongInt;
Var P: LongInt; Lo,Hi,Mid,Base: LongInt;
Begin
 P:=R34Peek(16);
 Base:=R34VOff[Id]; Lo:=0; Hi:=R34VN[Id]-1;
 While Lo<Hi Do Begin
  Mid:=(Lo+Hi+1) Shr 1;
  If R34VCode^[Base+Mid]<=P Then Lo:=Mid Else Hi:=Mid-1;
 End;
 R34GetVlc:=R34VSym^[Base+Lo]; R34Skip(R34VLen^[Base+Lo]);
End;

{ ---- transformees inverses (rv34dsp.c) ---- }
Var R34T: Array[0..15] Of LongInt;

Procedure R34RowTransform(B: PR34I16);
Var I,Z0,Z1,Z2,Z3: LongInt;
Begin
 For I:=0 To 3 Do Begin
  Z0:=13*(B^[I]+B^[I+8]);
  Z1:=13*(B^[I]-B^[I+8]);
  Z2:=7*B^[I+4]-17*B^[I+12];
  Z3:=17*B^[I+4]+7*B^[I+12];
  R34T[4*I+0]:=Z0+Z3; R34T[4*I+1]:=Z1+Z2; R34T[4*I+2]:=Z1-Z2; R34T[4*I+3]:=Z0-
   Z3;
 End;
End;

Procedure R34IdctAdd(P: PEABuffer; O,S: LongInt);
Var I,Z0,Z1,Z2,Z3: LongInt;
Begin
 R34RowTransform(PR34I16(@R34Blk));
 FillChar(R34Blk,SizeOf(R34Blk),0);
 For I:=0 To 3 Do Begin
  Z0:=13*(R34T[I]+R34T[8+I])+$200;
  Z1:=13*(R34T[I]-R34T[8+I])+$200;
  Z2:=7*R34T[4+I]-17*R34T[12+I];
  Z3:=17*R34T[4+I]+7*R34T[12+I];
  P^[O]:=R34Clip(P^[O]+R34Sar(Z0+Z3,10));
  P^[O+1]:=R34Clip(P^[O+1]+R34Sar(Z1+Z2,10));
  P^[O+2]:=R34Clip(P^[O+2]+R34Sar(Z1-Z2,10));
  P^[O+3]:=R34Clip(P^[O+3]+R34Sar(Z0-Z3,10));
  Inc(O,S);
 End;
End;

Procedure R34IdctDcAdd(P: PEABuffer; O,S,Dc: LongInt);
Var I,J: LongInt;
Begin
 Dc:=R34Sar(13*13*Dc+$200,10);
 For I:=0 To 3 Do Begin
  For J:=0 To 3 Do P^[O+J]:=R34Clip(P^[O+J]+Dc);
  Inc(O,S);
 End;
End;

{ transformee du bloc des DC (sans arrondi) }
Procedure R34InvTransform(B: PR34I16);
Var I,Z0,Z1,Z2,Z3: LongInt;
Begin
 R34RowTransform(B);
 For I:=0 To 3 Do Begin
  Z0:=39*(R34T[I]+R34T[8+I]);
  Z1:=39*(R34T[I]-R34T[8+I]);
  Z2:=21*R34T[4+I]-51*R34T[12+I];
  Z3:=51*R34T[4+I]+21*R34T[12+I];
  B^[I*4+0]:=R34S16(R34Sar(Z0+Z3,11));
  B^[I*4+1]:=R34S16(R34Sar(Z1+Z2,11));
  B^[I*4+2]:=R34S16(R34Sar(Z1-Z2,11));
  B^[I*4+3]:=R34S16(R34Sar(Z0-Z3,11));
 End;
End;

Procedure R34InvTransformDc(B: PR34I16);
Var Dc,I: LongInt;
Begin
 Dc:=R34S16(R34Sar(13*13*3*B^[0],11));
 For I:=0 To 15 Do B^[I]:=Dc;
End;

{ ---- prediction intra (h264pred) ---- }
{ 4x4 : P/O/S = plan, offset, pas ; haut-droite dans R34TR }
Procedure R34Pred4(Mode: LongInt; P: PEABuffer; O,S: LongInt);
Var T0,T1,T2,T3,T4,T5,T6,T7,L0,L1,L2,L3,L4,L5,L6,L7,Lt,Dc,Y,X: LongInt;
Procedure W(X,Y,V: LongInt);
Begin P^[O+X+Y*S]:=V; End;
Begin
 T0:=P^[O-S]; T1:=P^[O-S+1]; T2:=P^[O-S+2]; T3:=P^[O-S+3];
 T4:=R34TR[0]; T5:=R34TR[1]; T6:=R34TR[2]; T7:=R34TR[3];
 L0:=P^[O-1]; L1:=P^[O-1+S]; L2:=P^[O-1+2*S]; L3:=P^[O-1+3*S];
 Lt:=P^[O-1-S];
 Case Mode Of
  0: For Y:=0 To 3 Do For X:=0 To 3 Do W(X,Y,P^[O-S+X]);
  1: Begin
      For X:=0 To 3 Do W(X,0,L0);
      For X:=0 To 3 Do W(X,1,L1);
      For X:=0 To 3 Do W(X,2,L2);
      For X:=0 To 3 Do W(X,3,L3);
     End;
  2: Begin
      Dc:=(T0+T1+T2+T3+L0+L1+L2+L3+4) Shr 3;
      For Y:=0 To 3 Do For X:=0 To 3 Do W(X,Y,Dc);
     End;
  9: Begin
      Dc:=(L0+L1+L2+L3+2) Shr 2;
      For Y:=0 To 3 Do For X:=0 To 3 Do W(X,Y,Dc);
     End;
  10: Begin
       Dc:=(T0+T1+T2+T3+2) Shr 2;
       For Y:=0 To 3 Do For X:=0 To 3 Do W(X,Y,Dc);
      End;
  11: For Y:=0 To 3 Do For X:=0 To 3 Do W(X,Y,128);
  3: Begin { down_left rv40 (avec bas-gauche) }
      L4:=P^[O-1+4*S]; L5:=P^[O-1+5*S]; L6:=P^[O-1+6*S]; L7:=P^[O-1+7*S];
      W(0,0,(T0+T2+2*T1+2+L0+L2+2*L1+2) Shr 3);
      Dc:=(T1+T3+2*T2+2+L1+L3+2*L2+2) Shr 3; W(1,0,Dc); W(0,1,Dc);
      Dc:=(T2+T4+2*T3+2+L2+L4+2*L3+2) Shr 3; W(2,0,Dc); W(1,1,Dc); W(0,2,Dc);
      Dc:=(T3+T5+2*T4+2+L3+L5+2*L4+2) Shr 3; W(3,0,Dc); W(2,1,Dc); W(1,2,Dc); W(
       0,3,Dc);
      Dc:=(T4+T6+2*T5+2+L4+L6+2*L5+2) Shr 3; W(3,1,Dc); W(2,2,Dc); W(1,3,Dc);
      Dc:=(T5+T7+2*T6+2+L5+L7+2*L6+2) Shr 3; W(3,2,Dc); W(2,3,Dc);
      W(3,3,(T6+T7+1+L6+L7+1) Shr 2);
     End;
  12: Begin { down_left rv40 nodown }
       W(0,0,(T0+T2+2*T1+2+L0+L2+2*L1+2) Shr 3);
       Dc:=(T1+T3+2*T2+2+L1+L3+2*L2+2) Shr 3; W(1,0,Dc); W(0,1,Dc);
       Dc:=(T2+T4+2*T3+2+L2+3*L3+2) Shr 3; W(2,0,Dc); W(1,1,Dc); W(0,2,Dc);
       Dc:=(T3+T5+2*T4+2+L3*4+2) Shr 3; W(3,0,Dc); W(2,1,Dc); W(1,2,Dc); W(0,3,
        Dc);
       Dc:=(T4+T6+2*T5+2+L3*4+2) Shr 3; W(3,1,Dc); W(2,2,Dc); W(1,3,Dc);
       Dc:=(T5+T7+2*T6+2+L3*4+2) Shr 3; W(3,2,Dc); W(2,3,Dc);
       W(3,3,(T6+T7+1+2*L3+1) Shr 2);
      End;
  4: Begin { down_right }
      W(0,3,(L3+2*L2+L1+2) Shr 2);
      Dc:=(L2+2*L1+L0+2) Shr 2; W(0,2,Dc); W(1,3,Dc);
      Dc:=(L1+2*L0+Lt+2) Shr 2; W(0,1,Dc); W(1,2,Dc); W(2,3,Dc);
      Dc:=(L0+2*Lt+T0+2) Shr 2; W(0,0,Dc); W(1,1,Dc); W(2,2,Dc); W(3,3,Dc);
      Dc:=(Lt+2*T0+T1+2) Shr 2; W(1,0,Dc); W(2,1,Dc); W(3,2,Dc);
      Dc:=(T0+2*T1+T2+2) Shr 2; W(2,0,Dc); W(3,1,Dc);
      W(3,0,(T1+2*T2+T3+2) Shr 2);
     End;
  5: Begin { vertical_right }
      Dc:=(Lt+T0+1) Shr 1; W(0,0,Dc); W(1,2,Dc);
      Dc:=(T0+T1+1) Shr 1; W(1,0,Dc); W(2,2,Dc);
      Dc:=(T1+T2+1) Shr 1; W(2,0,Dc); W(3,2,Dc);
      W(3,0,(T2+T3+1) Shr 1);
      Dc:=(L0+2*Lt+T0+2) Shr 2; W(0,1,Dc); W(1,3,Dc);
      Dc:=(Lt+2*T0+T1+2) Shr 2; W(1,1,Dc); W(2,3,Dc);
      Dc:=(T0+2*T1+T2+2) Shr 2; W(2,1,Dc); W(3,3,Dc);
      W(3,1,(T1+2*T2+T3+2) Shr 2);
      W(0,2,(Lt+2*L0+L1+2) Shr 2);
      W(0,3,(L0+2*L1+L2+2) Shr 2);
     End;
  6: Begin { horizontal_down }
      Dc:=(Lt+L0+1) Shr 1; W(0,0,Dc); W(2,1,Dc);
      Dc:=(L0+2*Lt+T0+2) Shr 2; W(1,0,Dc); W(3,1,Dc);
      W(2,0,(Lt+2*T0+T1+2) Shr 2);
      W(3,0,(T0+2*T1+T2+2) Shr 2);
      Dc:=(L0+L1+1) Shr 1; W(0,1,Dc); W(2,2,Dc);
      Dc:=(Lt+2*L0+L1+2) Shr 2; W(1,1,Dc); W(3,2,Dc);
      Dc:=(L1+L2+1) Shr 1; W(0,2,Dc); W(2,3,Dc);
      Dc:=(L0+2*L1+L2+2) Shr 2; W(1,2,Dc); W(3,3,Dc);
      W(0,3,(L2+L3+1) Shr 1);
      W(1,3,(L1+2*L2+L3+2) Shr 2);
     End;
  7,14: Begin { vertical_left rv40 ; 14 = sans bas-gauche }
      If Mode=7 Then L4:=P^[O-1+4*S] Else L4:=L3;
      W(0,0,(2*T0+2*T1+L1+2*L2+L3+4) Shr 3);
      Dc:=(T1+T2+1) Shr 1; W(1,0,Dc); W(0,2,Dc);
      Dc:=(T2+T3+1) Shr 1; W(2,0,Dc); W(1,2,Dc);
      Dc:=(T3+T4+1) Shr 1; W(3,0,Dc); W(2,2,Dc);
      W(3,2,(T4+T5+1) Shr 1);
      W(0,1,(T0+2*T1+T2+L2+2*L3+L4+4) Shr 3);
      Dc:=(T1+2*T2+T3+2) Shr 2; W(1,1,Dc); W(0,3,Dc);
      Dc:=(T2+2*T3+T4+2) Shr 2; W(2,1,Dc); W(1,3,Dc);
      Dc:=(T3+2*T4+T5+2) Shr 2; W(3,1,Dc); W(2,3,Dc);
      W(3,3,(T4+2*T5+T6+2) Shr 2);
     End;
  8,13: Begin { horizontal_up rv40 ; 13 = sans bas-gauche }
      If Mode=8 Then Begin
       L4:=P^[O-1+4*S]; L5:=P^[O-1+5*S]; L6:=P^[O-1+6*S];
      End Else Begin L4:=0; L5:=0; L6:=0; End;
      W(0,0,(T1+2*T2+T3+2*L0+2*L1+4) Shr 3);
      W(1,0,(T2+2*T3+T4+L0+2*L1+L2+4) Shr 3);
      Dc:=(T3+2*T4+T5+2*L1+2*L2+4) Shr 3; W(2,0,Dc); W(0,1,Dc);
      Dc:=(T4+2*T5+T6+L1+2*L2+L3+4) Shr 3; W(3,0,Dc); W(1,1,Dc);
      Dc:=(T5+2*T6+T7+2*L2+2*L3+4) Shr 3; W(2,1,Dc); W(0,2,Dc);
      Dc:=(T6+3*T7+L2+3*L3+4) Shr 3; W(3,1,Dc); W(1,2,Dc);
      If Mode=8 Then Begin
       Dc:=(L3+2*L4+L5+2) Shr 2; W(3,2,Dc); W(1,3,Dc);
       Dc:=(T6+T7+L3+L4+2) Shr 2; W(0,3,Dc); W(2,2,Dc);
       W(2,3,(L4+L5+1) Shr 1);
       W(3,3,(L4+2*L5+L6+2) Shr 2);
      End Else Begin
       W(3,2,L3); W(1,3,L3);
       Dc:=(T6+T7+2*L3+2) Shr 2; W(0,3,Dc); W(2,2,Dc);
       W(2,3,L3); W(3,3,L3);
      End;
     End;
 End;
End;

Procedure R34Fill(P: PEABuffer; O,S,W,H,V: LongInt);
Var X,Y: LongInt;
Begin
 For Y:=0 To H-1 Do For X:=0 To W-1 Do P^[O+Y*S+X]:=V;
End;

{ 16x16 : 0 DC, 1 HOR, 2 VERT, 3 PLANE(rv40), 4 LEFT_DC, 5 TOP_DC, 6 DC128 }
Procedure R34Pred16(Mode: LongInt; P: PEABuffer; O,S: LongInt);
Var X,Y,I,Dc,K,H,V,A,B,Src1,Src2,Src0: LongInt;
Begin
 Case Mode Of
  0: Begin
      Dc:=0;
      For I:=0 To 15 Do Dc:=Dc+P^[O-1+I*S];
      For I:=0 To 15 Do Dc:=Dc+P^[O+I-S];
      R34Fill(P,O,S,16,16,(Dc+16) Shr 5);
     End;
  1: For Y:=0 To 15 Do For X:=0 To 15 Do P^[O+Y*S+X]:=P^[O-1+Y*S];
  2: For Y:=0 To 15 Do For X:=0 To 15 Do P^[O+Y*S+X]:=P^[O-S+X];
  4: Begin
      Dc:=0;
      For I:=0 To 15 Do Dc:=Dc+P^[O-1+I*S];
      R34Fill(P,O,S,16,16,(Dc+8) Shr 4);
     End;
  5: Begin
      Dc:=0;
      For I:=0 To 15 Do Dc:=Dc+P^[O+I-S];
      R34Fill(P,O,S,16,16,(Dc+8) Shr 4);
     End;
  6: R34Fill(P,O,S,16,16,128);
  3: Begin
      Src0:=O+7-S;            { P^[Src0+k] = haut }
      Src1:=O+8*S-1;
      Src2:=Src1-2*S;
      H:=P^[Src0+1]-P^[Src0-1];
      V:=P^[Src1]-P^[Src2];
      For K:=2 To 8 Do Begin
       Inc(Src1,S); Dec(Src2,S);
       H:=H+K*(P^[Src0+K]-P^[Src0-K]);
       V:=V+K*(P^[Src1]-P^[Src2]);
      End;
      H:=R34Sar(H+R34Sar(H,2),4);
      V:=R34Sar(V+R34Sar(V,2),4);
      A:=16*(P^[Src1]+P^[Src2+16]+1)-7*(V+H);
      For Y:=0 To 15 Do Begin
       B:=A; Inc(A,V);
       For X:=0 To 15 Do Begin
        P^[O+Y*S+X]:=R34Clip(R34Sar(B,5));
        Inc(B,H);
       End;
      End;
     End;
 End;
End;

{ chroma 8x8 : 0 DC(rv40), 1 HOR, 2 VERT, 4 LEFT_DC, 5 TOP_DC, 6 DC128 }
Procedure R34Pred8(Mode: LongInt; P: PEABuffer; O,S: LongInt);
Var X,Y,I,Dc: LongInt;
Begin
 Case Mode Of
  0: Begin
      Dc:=0;
      For I:=0 To 3 Do Dc:=Dc+P^[O-1+I*S]+P^[O+I-S]+P^[O+4+I-S]+P^[O-1+(I+4)*S];
      R34Fill(P,O,S,8,8,(Dc+8) Shr 4);
     End;
  1: For Y:=0 To 7 Do For X:=0 To 7 Do P^[O+Y*S+X]:=P^[O-1+Y*S];
  2: For Y:=0 To 7 Do For X:=0 To 7 Do P^[O+Y*S+X]:=P^[O-S+X];
  4: Begin
      Dc:=0;
      For I:=0 To 7 Do Dc:=Dc+P^[O-1+I*S];
      R34Fill(P,O,S,8,8,(Dc+4) Shr 3);
     End;
  5: Begin
      Dc:=0;
      For I:=0 To 7 Do Dc:=Dc+P^[O+I-S];
      R34Fill(P,O,S,8,8,(Dc+4) Shr 3);
     End;
  6: R34Fill(P,O,S,8,8,128);
 End;
End;

{ ---- compensation de mouvement ---- }
{ ecriture d'un echantillon : Avg=False copie, True moyenne arrondie avec la
 destination }
Procedure R34Store(D: PEABuffer; Pos,V: LongInt; Avg: Boolean);
Begin
 If Avg Then D^[Pos]:=(D^[Pos]+V+1) Shr 1 Else D^[Pos]:=V;
End;

{ copie / moyenne de bloc (mc00) }
Procedure R34McCopy(D: PEABuffer; DO_,DS: LongInt; Sp: PEABuffer; SO,SS,Sz:
 LongInt; Avg: Boolean);
Var X,Y: LongInt;
Begin
 For Y:=0 To Sz-1 Do For X:=0 To Sz-1 Do R34Store(D,DO_+Y*DS+X,Sp^[SO+Y*SS+X],
  Avg);
End;

{ demi-pixel H.264 horizontal (mc20) et vertical (mc02) }
Procedure R34McH264(Vert: Boolean; D: PEABuffer; DO_,DS: LongInt; Sp: PEABuffer;
 SO,SS,Sz: LongInt; Avg: Boolean);
Var X,Y,P,St,V: LongInt;
Begin
 If Vert Then St:=SS Else St:=1;
 For Y:=0 To Sz-1 Do For X:=0 To Sz-1 Do Begin
  P:=SO+Y*SS+X;
  V:=(Sp^[P]+Sp^[P+St])*20-(Sp^[P-St]+Sp^[P+2*St])*5+(Sp^[P-2*St]+Sp^[P+3*St]);
  V:=R34Clip(R34Sar(V+16,5));
  R34Store(D,DO_+Y*DS+X,V,Avg);
 End;
End;

{ filtre RV40 : horizontal (Vert=False) ou vertical, W colonnes, H lignes }
Procedure R34Rv40Low(Vert: Boolean; D: PEABuffer; DO_,DS: LongInt; Sp:
 PEABuffer; SO,SS,W,H,C1,C2,Sh: LongInt; Avg: Boolean);
Var X,Y,P,St,V: LongInt;
Begin
 If Vert Then St:=SS Else St:=1;
 For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
  P:=SO+Y*SS+X;
  V:=Sp^[P-2*St]+Sp^[P+3*St]-5*(Sp^[P-St]+Sp^[P+2*St])+Sp^[P]*C1+Sp^[P+St]*C2+(1
   Shl (Sh-1));
  V:=R34Clip(R34Sar(V,Sh));
  R34Store(D,DO_+Y*DS+X,V,Avg);
 End;
End;

Var R34Full: Array[0..16*21+31] Of Byte;
{ qpel RV40 : Sz 8 ou 16, Dxy = ly*4+lx }
Procedure R34McRv40(Sz,Dxy: LongInt; Avg: Boolean; D: PEABuffer; DO_,DS:
 LongInt; Sp: PEABuffer; SO,SS: LongInt);
Var Lx,Ly,X,Y,V: LongInt; Fp: PEABuffer;
Begin
 Lx:=Dxy And 3; Ly:=Dxy Shr 2;
 If (Lx=0) And (Ly=0) Then Begin R34McCopy(D,DO_,DS,Sp,SO,SS,Sz,Avg); Exit; End;
 If Ly=0 Then Begin
  If Lx=2 Then R34McH264(False,D,DO_,DS,Sp,SO,SS,Sz,Avg)
  Else R34Rv40Low(False,D,DO_,DS,Sp,SO,SS,Sz,Sz,R34Rv40HC1[Lx],R34Rv40HC2[Lx],
   R34Rv40HSh[Lx],Avg);
  Exit;
 End;
 If Lx=0 Then Begin
  If Ly=2 Then R34McH264(True,D,DO_,DS,Sp,SO,SS,Sz,Avg)
  Else R34Rv40Low(True,D,DO_,DS,Sp,SO,SS,Sz,Sz,R34Rv40VC1[Ly],R34Rv40VC2[Ly],
   R34Rv40VSh[Ly],Avg);
  Exit;
 End;
 If (Lx=3) And (Ly=3) Then Begin
  For Y:=0 To Sz-1 Do For X:=0 To Sz-1 Do Begin
   V:=(Sp^[SO+Y*SS+X]+Sp^[SO+Y*SS+X+1]+Sp^[SO+(Y+1)*SS+X]+Sp^[SO+(Y+1)*SS+X+1]+
    2) Shr 2;
   R34Store(D,DO_+Y*DS+X,V,Avg);
  End;
  Exit;
 End;
 { passe horizontale (Sz+5 lignes) dans un tampon 8 bits puis passe verticale }
 Fp:=PEABuffer(@R34Full[0]);
 R34Rv40Low(False,Fp,0,Sz,Sp,SO-2*SS,SS,Sz,Sz+5,R34Rv40HC1[Lx],R34Rv40HC2[Lx],
  R34Rv40HSh[Lx],False);
 R34Rv40Low(True,D,DO_,DS,Fp,2*Sz,Sz,Sz,Sz,R34Rv40VC1[Ly],R34Rv40VC2[Ly],
  R34Rv40VSh[Ly],Avg);
End;

{ ---- RV30 : tiers de pixel ---- }
Procedure R34Rv30H(Vert: Boolean; D: PEABuffer; DO_,DS: LongInt; Sp: PEABuffer;
 SO,SS,Sz,C1,C2: LongInt; Avg: Boolean);
Var X,Y,P,St,V: LongInt;
Begin
 If Vert Then St:=SS Else St:=1;
 For Y:=0 To Sz-1 Do For X:=0 To Sz-1 Do Begin
  P:=SO+Y*SS+X;
  V:=-(Sp^[P-St]+Sp^[P+2*St])+Sp^[P]*C1+Sp^[P+St]*C2+8;
  V:=R34Clip(R34Sar(V,4));
  R34Store(D,DO_+Y*DS+X,V,Avg);
 End;
End;

Procedure R34McRv30(Sz,Dxy: LongInt; Avg: Boolean; D: PEABuffer; DO_,DS:
 LongInt; Sp: PEABuffer; SO,SS: LongInt);
Var X,Y,P,V,Kind: LongInt;
Function S(R,C: LongInt): LongInt;
Begin S:=Sp^[P+R*SS+C]; End;
Begin
 Case Dxy Of
  0: R34McCopy(D,DO_,DS,Sp,SO,SS,Sz,Avg);
  1: R34Rv30H(False,D,DO_,DS,Sp,SO,SS,Sz,12,6,Avg);
  2: R34Rv30H(False,D,DO_,DS,Sp,SO,SS,Sz,6,12,Avg);
  4: R34Rv30H(True,D,DO_,DS,Sp,SO,SS,Sz,12,6,Avg);
  8: R34Rv30H(True,D,DO_,DS,Sp,SO,SS,Sz,6,12,Avg);
  5,6,9,10: Begin
   For Y:=0 To Sz-1 Do For X:=0 To Sz-1 Do Begin
    P:=SO+Y*SS+X;
    Case Dxy Of
     5: V:=S(-1,-1)-12*S(-1,0)-6*S(-1,1)+S(-1,2)
           -12*S(0,-1)+144*S(0,0)+72*S(0,1)-12*S(0,2)
           -6*S(1,-1)+72*S(1,0)+36*S(1,1)-6*S(1,2)
           +S(2,-1)-12*S(2,0)-6*S(2,1)+S(2,2)+128;
     6: V:=S(-1,-1)-12*S(-1,1)-6*S(-1,0)+S(-1,2)
           -12*S(0,-1)+144*S(0,1)+72*S(0,0)-12*S(0,2)
           -6*S(1,-1)+72*S(1,1)+36*S(1,0)-6*S(1,2)
           +S(2,-1)-12*S(2,1)-6*S(2,0)+S(2,2)+128;
     9: V:=S(-1,-1)-12*S(-1,0)-6*S(-1,1)+S(-1,2)
           -6*S(0,-1)+72*S(0,0)+36*S(0,1)-6*S(0,2)
           -12*S(1,-1)+144*S(1,0)+72*S(1,1)-12*S(1,2)
           +S(2,-1)-12*S(2,0)-6*S(2,1)+S(2,2)+128;
    Else
          V:=36*S(0,0)+54*S(0,1)+6*S(0,2)
           +54*S(1,0)+81*S(1,1)+9*S(1,2)
           +6*S(2,0)+9*S(2,1)+S(2,2)+128;
    End;
    V:=R34Clip(R34Sar(V,8));
    R34Store(D,DO_+Y*DS+X,V,Avg);
   End;
  End;
 End;
End;

{ ---- chrominance ---- }
{ Sz = 8 ou 4 (largeur), H lignes ; Rv40 = variante RV40 avec biais }
Procedure R34McChroma(Rv40: Boolean; Sz,H,X0,Y0: LongInt; Avg: Boolean; D:
 PEABuffer; DO_,DS: LongInt; Sp: PEABuffer; SO,SS: LongInt);
Var A,B,C,Dd,Bias,X,Y,P,V: LongInt;
Begin
 A:=(8-X0)*(8-Y0); B:=X0*(8-Y0); C:=(8-X0)*Y0; Dd:=X0*Y0;
 If Rv40 Then Bias:=R34Bias[Y0 Shr 1,X0 Shr 1] Else Bias:=32;
 For Y:=0 To H-1 Do For X:=0 To Sz-1 Do Begin
  P:=SO+Y*SS+X;
  V:=A*Sp^[P]+B*Sp^[P+1]+C*Sp^[P+SS]+Dd*Sp^[P+SS+1]+Bias;
  V:=V Shr 6;
  R34Store(D,DO_+Y*DS+X,V,Avg);
 End;
End;

{ poids B-frame RV40 (rv40_weight_func) : Sz 16 ou 8 }
Procedure R34Rv40Weight(Sz: LongInt; D: PEABuffer; DO_,DS: LongInt; S1,S2:
 PEABuffer; SO,SS,W1,W2: LongInt; Scaled: Boolean);
Var X,Y: LongInt; A,B,V: Int64;
Begin
 For Y:=0 To Sz-1 Do For X:=0 To Sz-1 Do Begin
  A:=(Int64(W2 And $FFFFFFFF)*S1^[SO+Y*SS+X]) And $FFFFFFFF;
  B:=(Int64(W1 And $FFFFFFFF)*S2^[SO+Y*SS+X]) And $FFFFFFFF;
  If Not Scaled Then V:=((A Shr 9)+(B Shr 9)+$10) And $FFFFFFFF
  Else V:=(A+B+$10) And $FFFFFFFF;
  D^[DO_+Y*DS+X]:=(V Shr 5) And 255;
 End;
End;

{ ---- decodage des blocs 4x4 (rv34.c) ---- }
Function R34DecodeCbp(Sv,Table: LongInt): LongInt;
Var Pattern,Code,Cbp,Ones,Mask,Shift,I,T: LongInt;
Begin
 Cbp:=0;
 Code:=R34GetVlc(R34Sets[Sv].CbpPat[Table]);
 Pattern:=Code And $F; Code:=Code Shr 4;
 Ones:=R34CountOnes[Pattern];
 Mask:=8; I:=0;
 While Mask<>0 Do Begin
  Case I Of 0: Shift:=0; 1: Shift:=2; 2: Shift:=8; Else Shift:=10; End;
  If (Pattern And Mask)<>0 Then Cbp:=Cbp Or (R34GetVlc(R34Sets[Sv].Cbp[Table,
   Ones]) Shl Shift);
  Mask:=Mask Shr 1; Inc(I);
 End;
 For I:=0 To 3 Do Begin
  T:=(R34Mod3[Code] Shr (6-2*I)) And 3;
  If T=1 Then Begin
   If R34Get1=0 Then Cbp:=Cbp Or ($100000 Shl I) Else Cbp:=Cbp Or ($10000 Shl
    I);
  End;
  If T=2 Then Cbp:=Cbp Or ($110000 Shl I);
 End;
 R34DecodeCbp:=Cbp;
End;

Procedure R34DecCoeff(B: PR34I16; Dst,Coef,Esc,Q,Cv: LongInt);
Begin
 If Coef<>0 Then Begin
  If Coef=Esc Then Begin
   Coef:=R34GetVlc(Cv);
   If Coef>23 Then Begin
    Dec(Coef,23);
    Coef:=22+((1 Shl Coef) Or R34GetBits(Coef));
   End;
   Inc(Coef,Esc);
  End;
  If R34Get1<>0 Then Coef:=-Coef;
  B^[Dst]:=R34S16(R34Sar(Coef*Q+8,4));
 End;
End;

Procedure R34DecSubblock(B: PR34I16; Base,Code: LongInt; IsBlock2: Boolean; Cv,
 Q: LongInt);
Var Flags: LongInt;
Begin
 Flags:=R34Mod3[Code];
 R34DecCoeff(B,Base,Flags Shr 6,3,Q,Cv);
 If IsBlock2 Then Begin
  R34DecCoeff(B,Base+4,(Flags Shr 4) And 3,2,Q,Cv);
  R34DecCoeff(B,Base+1,(Flags Shr 2) And 3,2,Q,Cv);
 End Else Begin
  R34DecCoeff(B,Base+1,(Flags Shr 4) And 3,2,Q,Cv);
  R34DecCoeff(B,Base+4,(Flags Shr 2) And 3,2,Q,Cv);
 End;
 R34DecCoeff(B,Base+5,Flags And 3,2,Q,Cv);
End;

Function R34DecodeBlock(B: PR34I16; Sv,Fc,Sc,QDc,QAc1,QAc2: LongInt): LongInt;
Var Code,Pattern,HasAc,Flags,Cv: LongInt;
Begin
 HasAc:=1; Cv:=R34Sets[Sv].Coef;
 Code:=R34GetVlc(R34Sets[Sv].First[Fc]);
 Pattern:=Code And 7; Code:=Code Shr 3;
 If (R34Mod3[Code] And $3F)<>0 Then Begin
  Flags:=R34Mod3[Code];
  R34DecCoeff(B,0,Flags Shr 6,3,QDc,Cv);
  R34DecCoeff(B,1,(Flags Shr 4) And 3,2,QAc1,Cv);
  R34DecCoeff(B,4,(Flags Shr 2) And 3,2,QAc1,Cv);
  R34DecCoeff(B,5,Flags And 3,2,QAc2,Cv);
 End Else Begin
  R34DecCoeff(B,0,R34Mod3[Code] Shr 6,3,QDc,Cv);
  If Pattern=0 Then Begin R34DecodeBlock:=0; Exit; End;
  HasAc:=0;
 End;
 If (Pattern And 4)<>0 Then Begin
  Code:=R34GetVlc(R34Sets[Sv].Second[Sc]);
  R34DecSubblock(B,2,Code,False,Cv,QAc2);
 End;
 If (Pattern And 2)<>0 Then Begin
  Code:=R34GetVlc(R34Sets[Sv].Second[Sc]);
  R34DecSubblock(B,8,Code,True,Cv,QAc2);
 End;
 If (Pattern And 1)<>0 Then Begin
  Code:=R34GetVlc(R34Sets[Sv].Third[Sc]);
  R34DecSubblock(B,10,Code,False,Cv,QAc2);
 End;
 R34DecodeBlock:=HasAc Or Pattern;
End;

Function R34StartOffsetBits(MbSize: LongInt): LongInt;
Var I: LongInt;
Begin
 I:=0;
 While I<5 Do Begin
  If R34MbMaxSizes[I]>=MbSize-1 Then Break;
  Inc(I);
 End;
 R34StartOffsetBits:=R34MbBitsSizes[I];
End;

Function R34ChooseSet(Quant,Md,Typ: LongInt): LongInt;
Begin
 If (Md=2) And (Quant<19) Then Inc(Quant,10)
 Else If (Md<>0) And (Quant<26) Then Inc(Quant,5);
 If Typ<>0 Then R34ChooseSet:=5+R34QuantToVlcSet[1,Quant] Else R34ChooseSet:=
  R34QuantToVlcSet[0,Quant];
End;

{ ---- en-tetes de tranche ---- }
{ lit un en-tete de tranche (le lecteur de bits doit etre positionne) ; retourne
 <0 en cas d'erreur }
Function R34ParseSliceHeader(Var Si: TR34SI): LongInt;
Var Mb,W,H,MbSize,Rpr,T,Val,I: LongInt;
Function GetDim(Wh: LongInt): LongInt;
Var T2,V2,Tt: LongInt;
Begin
 T2:=R34GetBits(3);
 If Wh=0 Then V2:=R34StdWidths[T2] Else V2:=R34StdHeights[T2];
 If V2<0 Then Begin
  If Wh=0 Then V2:=R34StdWidths[R34Get1-V2] Else V2:=R34StdHeights[R34Get1-V2];
 End;
 If V2=0 Then Begin
  Repeat
   If R34BitsLeft<8 Then Begin GetDim:=-1; Exit; End;
   Tt:=R34GetBits(8);
   Inc(V2,Tt Shl 2);
  Until Tt<>255;
 End;
 GetDim:=V2;
End;
Begin
 FillChar(Si,SizeOf(Si),0);
 W:=R34W; H:=R34H;
 If R34Rv30 Then Begin
  If R34GetBits(3)<>0 Then Begin R34ParseSliceHeader:=-1; Exit; End;
  Si.Typ:=R34GetBits(2);
  If Si.Typ=1 Then Si.Typ:=0;
  If R34Get1<>0 Then Begin R34ParseSliceHeader:=-1; Exit; End;
  Si.Quant:=R34GetBits(5);
  R34Skip(1);
  Si.Pts:=R34GetBits(13);
  { av_log2(max_rpr)+1 }
  T:=0; I:=R34MaxRpr; While I>1 Do Begin I:=I Shr 1; Inc(T); End;
  Rpr:=R34GetBits(T+1);
  If Rpr<>0 Then Begin
   If Rpr>R34MaxRpr Then Begin R34ParseSliceHeader:=-1; Exit; End;
   If R34ExtLen<Rpr*2+8 Then Begin R34ParseSliceHeader:=-1; Exit; End;
   W:=R34Ext[6+Rpr*2] Shl 2;
   H:=R34Ext[7+Rpr*2] Shl 2;
  End Else Begin W:=R34OrigW; H:=R34OrigH; End;
  Si.Width:=W; Si.Height:=H;
  MbSize:=((W+15) Shr 4)*((H+15) Shr 4);
  Mb:=R34StartOffsetBits(MbSize);
  Si.Start:=R34GetBits(Mb);
  R34Skip(1);
  R34ParseSliceHeader:=0;
 End Else Begin
  If R34Get1<>0 Then Begin R34ParseSliceHeader:=-1; Exit; End;
  Si.Typ:=R34GetBits(2);
  If Si.Typ=1 Then Si.Typ:=0;
  Si.Quant:=R34GetBits(5);
  If R34GetBits(2)<>0 Then Begin R34ParseSliceHeader:=-1; Exit; End;
  Si.VlcSet:=R34GetBits(2);
  R34Skip(1);
  Si.Pts:=R34GetBits(13);
  If (Si.Typ=0) Or (R34Get1=0) Then Begin
   W:=GetDim(0);
   H:=GetDim(1);
  End;
  { av_image_check_size : dimensions strictement positives et raisonnables }
  If (W<=0) Or (H<=0) Or (W>16384) Or (H>16384) Then Begin R34ParseSliceHeader:=
   -1; Exit; End;
  Si.Width:=W; Si.Height:=H;
  MbSize:=((W+15) Shr 4)*((H+15) Shr 4);
  Mb:=R34StartOffsetBits(MbSize);
  Si.Start:=R34GetBits(Mb);
  R34ParseSliceHeader:=0;
 End;
End;

{ ---- types intra 4x4 ---- }
{ Dst = index dans le tableau des types ; retourne <0 en cas d'erreur }
Function R34Rv30DecodeIntraTypes(Dst: LongInt): LongInt;
Var I,J,K,A,B: LongInt; Code: Int64;
Begin
 For I:=0 To 3 Do Begin
  J:=0;
  While J<4 Do Begin
   Code:=(Int64(R34GetIUE) Shl 1) And $FFFFFFFF;
   If Code>160 Then Begin R34Rv30DecodeIntraTypes:=-1; Exit; End;
   For K:=0 To 1 Do Begin
    A:=R34IntraHist^[Dst-R34IntraStride]+1;
    B:=R34IntraHist^[Dst-1]+1;
    R34IntraHist^[Dst]:=R34Rv30ItypeFromContext[A*90+B*9+R34Rv30ItypeCode[Code+
     K]];
    Inc(Dst);
    If R34IntraHist^[Dst-1]=9 Then Begin R34Rv30DecodeIntraTypes:=-1; Exit; End;
   End;
   Inc(J,2);
  End;
  Inc(Dst,R34IntraStride-4);
 End;
 R34Rv30DecodeIntraTypes:=0;
End;

Function R34Rv40DecodeIntraTypes(Dst: LongInt): LongInt;
Var I,J,K,V,A,B,C,Pattern,Ptr,Pat: LongInt;
Begin
 For I:=0 To 3 Do Begin
  If (I=0) And (R34FirstSliceLine<>0) Then Begin
   Pattern:=R34GetVlc(R34AicTop);
   R34IntraHist^[Dst]:=(Pattern Shr 2) And 2;
   R34IntraHist^[Dst+1]:=(Pattern Shr 1) And 2;
   R34IntraHist^[Dst+2]:=Pattern And 2;
   R34IntraHist^[Dst+3]:=(Pattern Shl 1) And 2;
   Inc(Dst,R34IntraStride);
   Continue;
  End;
  Ptr:=Dst; J:=0;
  While J<4 Do Begin
   A:=R34IntraHist^[Ptr-R34IntraStride+1];
   B:=R34IntraHist^[Ptr-R34IntraStride];
   C:=R34IntraHist^[Ptr-1];
   Pat:=A+B*16+C*256;
   K:=0;
   While K<20 Do Begin
    If Pat=R34AicTableIndex[K] Then Break;
    Inc(K);
   End;
   If (J<3) And (K<20) Then Begin
    V:=R34GetVlc(R34AicMode2[K]);
    R34IntraHist^[Ptr]:=V And 255;
    R34IntraHist^[Ptr+1]:=(V Shr 8) And 255;
    Inc(Ptr,2); Inc(J);
   End Else Begin
    If (B<>-1) And (C<>-1) Then Begin
     If (B+C*10>=0) And (B+C*10<90) And (R34AicMode1[B+C*10]>=0) Then V:=
      R34GetVlc(R34AicMode1[B+C*10]) Else V:=0;
    End Else Begin
     V:=0;
     Case C Of
      -1: If B<2 Then V:=R34Get1 Xor 1;
      0,2: V:=(R34Get1 Xor 1) Shl 1;
     End;
    End;
    R34IntraHist^[Ptr]:=V; Inc(Ptr);
   End;
   Inc(J);
  End;
  Inc(Dst,R34IntraStride);
 End;
 R34Rv40DecodeIntraTypes:=0;
End;

Function R34DecodeIntraTypes(Dst: LongInt): LongInt;
Begin
 If R34Rv30 Then R34DecodeIntraTypes:=R34Rv30DecodeIntraTypes(Dst) Else
  R34DecodeIntraTypes:=R34Rv40DecodeIntraTypes(Dst);
End;

Procedure R34FillIntraTypes(Dst,V: LongInt);
Var I,J: LongInt;
Begin
 For J:=0 To 3 Do For I:=0 To 3 Do R34IntraHist^[Dst+J*R34IntraStride+I]:=V;
End;

{ ---- information de macrobloc ---- }
Function R34Rv30DecodeMbInfo: LongInt;
Var Code: LongWord;
Begin
 Code:=R34GetIUE;
 If Code>11 Then Begin R34Rv30DecodeMbInfo:=-1; Exit; End;
 If Code>5 Then Dec(Code,6);
 If R34PictType<>R34_PIC_B Then Begin
  Case Code Of
   0: R34Rv30DecodeMbInfo:=R34_MB_SKIP;
   1: R34Rv30DecodeMbInfo:=R34_MB_P16;
   2: R34Rv30DecodeMbInfo:=R34_MB_P8;
   3: R34Rv30DecodeMbInfo:=-1;
   4: R34Rv30DecodeMbInfo:=R34_MB_INTRA;
   Else R34Rv30DecodeMbInfo:=R34_MB_INTRA16;
  End;
 End Else Begin
  Case Code Of
   0: R34Rv30DecodeMbInfo:=R34_MB_SKIP;
   1: R34Rv30DecodeMbInfo:=R34_MB_BDIRECT;
   2: R34Rv30DecodeMbInfo:=R34_MB_BFWD;
   3: R34Rv30DecodeMbInfo:=R34_MB_BBWD;
   4: R34Rv30DecodeMbInfo:=R34_MB_INTRA;
   Else R34Rv30DecodeMbInfo:=R34_MB_INTRA16;
  End;
 End;
End;

Function R34Rv40DecodeMbInfo: LongInt;
Var Q,I,Count,PrevType,MbPos: LongInt; Blocks: Array[0..11] Of LongInt; Sk:
 LongWord;
Begin
 MbPos:=R34MbX+R34MbY*R34MbStride;
 PrevType:=0;
 If R34SkipRun=0 Then Begin
  Sk:=R34GetIUE;
  R34SkipRun:=R34W32(Int64(Sk)+1);
  If LongWord(R34SkipRun)>LongWord(R34MbNum) Then Begin R34Rv40DecodeMbInfo:=-1;
   Exit; End;
 End;
 Dec(R34SkipRun);
 If R34SkipRun<>0 Then Begin R34Rv40DecodeMbInfo:=R34_MB_SKIP; Exit; End;
 If R34Avail[6-4]<>0 Then Begin
  FillChar(Blocks,SizeOf(Blocks),0);
  Count:=0;
  If R34Avail[6-1]<>0 Then Inc(Blocks[R34MbTypeR^[R34MbOrg+MbPos-1]]);
  Inc(Blocks[R34MbTypeR^[R34MbOrg+MbPos-R34MbStride]]);
  If R34Avail[6-2]<>0 Then Inc(Blocks[R34MbTypeR^[R34MbOrg+MbPos-R34MbStride+
   1]]);
  If R34Avail[6-5]<>0 Then Inc(Blocks[R34MbTypeR^[R34MbOrg+MbPos-R34MbStride-
   1]]);
  For I:=0 To 11 Do Begin
   If Blocks[I]>Count Then Begin
    Count:=Blocks[I]; PrevType:=I;
    If Count>1 Then Break;
   End;
  End;
 End Else If R34Avail[6-1]<>0 Then PrevType:=R34MbTypeR^[R34MbOrg+MbPos-1];
 If R34PictType=R34_PIC_P Then Begin
  PrevType:=R34PtypeVlcNum[PrevType];
  Q:=R34GetVlc(R34PtypeV[PrevType]);
  If Q<255 Then Begin R34Rv40DecodeMbInfo:=Q; Exit; End;
  Q:=R34GetVlc(R34PtypeV[PrevType]);
 End Else Begin
  PrevType:=R34BtypeVlcNum[PrevType];
  Q:=R34GetVlc(R34BtypeV[PrevType]);
  If Q<255 Then Begin R34Rv40DecodeMbInfo:=Q; Exit; End;
  Q:=R34GetVlc(R34BtypeV[PrevType]);
 End;
 R34Rv40DecodeMbInfo:=0;
End;

{ ---- vecteurs de mouvement ---- }
Function R34GetMv(Pic,Dir,Pos,K: LongInt): LongInt;
Begin R34GetMv:=R34Pics[Pic].Mv[Dir]^[(R34MvOrg+Pos)*2+K]; End;
Procedure R34SetMv(Pic,Dir,Pos,K,V: LongInt);
Begin R34Pics[Pic].Mv[Dir]^[(R34MvOrg+Pos)*2+K]:=R34S16(V); End;
Procedure R34Zero8x2(Pic,Dir,Pos: LongInt);
Var I: LongInt;
Begin
 For I:=0 To 1 Do Begin
  R34SetMv(Pic,Dir,Pos+I*R34B8Stride,0,0); R34SetMv(Pic,Dir,Pos+I*R34B8Stride,1,
   0);
  R34SetMv(Pic,Dir,Pos+1+I*R34B8Stride,0,0); R34SetMv(Pic,Dir,Pos+1+I*
   R34B8Stride,1,0);
 End;
End;

Procedure R34PredMv(BlockType,SubblockNo,DmvNo: LongInt);
Var MvPos,AI,COff,Mx,My,I,J: LongInt; A,B,C: TR34V2;
Begin
 MvPos:=R34MbX*2+R34MbY*2*R34B8Stride;
 AI:=R34AvailIdx[SubblockNo];
 COff:=R34PartW[BlockType];
 Inc(MvPos,(SubblockNo And 1)+(SubblockNo Shr 1)*R34B8Stride);
 If SubblockNo=3 Then COff:=-1;
 A[0]:=0; A[1]:=0;
 If R34Avail[AI-1]<>0 Then Begin A[0]:=R34GetMv(R34Cur,0,MvPos-1,0); A[1]:=
  R34GetMv(R34Cur,0,MvPos-1,1); End;
 If R34Avail[AI-4]<>0 Then Begin B[0]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride,0);
  B[1]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride,1); End
 Else Begin B[0]:=A[0]; B[1]:=A[1]; End;
 If R34Avail[AI+COff-4]=0 Then Begin
  If (R34Avail[AI-4]<>0) And ((R34Avail[AI-1]<>0) Or R34Rv30) Then Begin
   C[0]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride-1,0); C[1]:=R34GetMv(R34Cur,0,
    MvPos-R34B8Stride-1,1);
  End Else Begin C[0]:=A[0]; C[1]:=A[1]; End;
 End Else Begin
  C[0]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride+COff,0); C[1]:=R34GetMv(R34Cur,0,
   MvPos-R34B8Stride+COff,1);
 End;
 Mx:=R34Mid(A[0],B[0],C[0])+R34Dmv[DmvNo,0];
 My:=R34Mid(A[1],B[1],C[1])+R34Dmv[DmvNo,1];
 For J:=0 To R34PartH[BlockType]-1 Do For I:=0 To R34PartW[BlockType]-1 Do Begin
  R34SetMv(R34Cur,0,MvPos+I+J*R34B8Stride,0,Mx);
  R34SetMv(R34Cur,0,MvPos+I+J*R34B8Stride,1,My);
 End;
End;

Function R34CalcAddMv(Dir,Val: LongInt): LongInt;
Var Mul: LongInt;
Begin
 If Dir<>0 Then Mul:=-R34MvWeight2 Else Mul:=R34MvWeight1;
 R34CalcAddMv:=R34Sar(R34W32(Int64(Val)*Mul+$2000),14);
End;

Procedure R34PredBVector(Var A,B,C: TR34V2; AA,BA,CA: LongInt; Var Mx,My:
 LongInt);
Begin
 If AA+BA+CA<>3 Then Begin
  Mx:=A[0]+B[0]+C[0]; My:=A[1]+B[1]+C[1];
  If AA+BA+CA=2 Then Begin Mx:=Mx Div 2; My:=My Div 2; End;
 End Else Begin
  Mx:=R34Mid(A[0],B[0],C[0]); My:=R34Mid(A[1],B[1],C[1]);
 End;
End;

Procedure R34PredMvB(BlockType,Dir: LongInt);
Var MbPos,MvPos,Mx,My,I,J,Msk,Typ: LongInt; A,B,C: TR34V2; HA,HB,HC: LongInt;
Begin
 MbPos:=R34MbX+R34MbY*R34MbStride;
 MvPos:=R34MbX*2+R34MbY*2*R34B8Stride;
 A[0]:=0; A[1]:=0; B[0]:=0; B[1]:=0; C[0]:=0; C[1]:=0; HA:=0; HB:=0; HC:=0;
 If Dir<>0 Then Msk:=R34_MT_L1 Else Msk:=R34_MT_L0;
 Typ:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos];
 If ((R34Avail[6-1] And Typ) And Msk)<>0 Then Begin
  A[0]:=R34GetMv(R34Cur,Dir,MvPos-1,0); A[1]:=R34GetMv(R34Cur,Dir,MvPos-1,1);
   HA:=1;
 End;
 If ((R34Avail[6-4] And Typ) And Msk)<>0 Then Begin
  B[0]:=R34GetMv(R34Cur,Dir,MvPos-R34B8Stride,0); B[1]:=R34GetMv(R34Cur,Dir,
   MvPos-R34B8Stride,1); HB:=1;
 End;
 If (R34Avail[6-4]<>0) And (((R34Avail[6-2] And Typ) And Msk)<>0) Then Begin
  C[0]:=R34GetMv(R34Cur,Dir,MvPos-R34B8Stride+2,0); C[1]:=R34GetMv(R34Cur,Dir,
   MvPos-R34B8Stride+2,1); HC:=1;
 End Else If ((R34MbX+1)=R34MbW) And (((R34Avail[6-5] And Typ) And Msk)<>0) Then
  Begin
  C[0]:=R34GetMv(R34Cur,Dir,MvPos-R34B8Stride-1,0); C[1]:=R34GetMv(R34Cur,Dir,
   MvPos-R34B8Stride-1,1); HC:=1;
 End;
 R34PredBVector(A,B,C,HA,HB,HC,Mx,My);
 Inc(Mx,R34Dmv[Dir,0]); Inc(My,R34Dmv[Dir,1]);
 For J:=0 To 1 Do For I:=0 To 1 Do Begin
  R34SetMv(R34Cur,Dir,MvPos+I+J*R34B8Stride,0,Mx);
  R34SetMv(R34Cur,Dir,MvPos+I+J*R34B8Stride,1,My);
 End;
 If (BlockType=R34_MB_BBWD) Or (BlockType=R34_MB_BFWD) Then R34Zero8x2(R34Cur,1-
  Dir,MvPos);
End;

Procedure R34PredMvRv3(BlockType,Dir: LongInt);
Var MvPos,Mx,My,I,J,K,AI: LongInt; A,B,C: TR34V2;
Begin
 MvPos:=R34MbX*2+R34MbY*2*R34B8Stride;
 AI:=R34AvailIdx[0];
 A[0]:=0; A[1]:=0;
 If R34Avail[AI-1]<>0 Then Begin A[0]:=R34GetMv(R34Cur,0,MvPos-1,0); A[1]:=
  R34GetMv(R34Cur,0,MvPos-1,1); End;
 If R34Avail[AI-4]<>0 Then Begin B[0]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride,0);
  B[1]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride,1); End
 Else Begin B[0]:=A[0]; B[1]:=A[1]; End;
 If R34Avail[AI-4+2]=0 Then Begin
  If (R34Avail[AI-4]<>0) And (R34Avail[AI-1]<>0) Then Begin
   C[0]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride-1,0); C[1]:=R34GetMv(R34Cur,0,
    MvPos-R34B8Stride-1,1);
  End Else Begin C[0]:=A[0]; C[1]:=A[1]; End;
 End Else Begin
  C[0]:=R34GetMv(R34Cur,0,MvPos-R34B8Stride+2,0); C[1]:=R34GetMv(R34Cur,0,MvPos-
   R34B8Stride+2,1);
 End;
 Mx:=R34Mid(A[0],B[0],C[0])+R34Dmv[0,0];
 My:=R34Mid(A[1],B[1],C[1])+R34Dmv[0,1];
 For J:=0 To 1 Do For I:=0 To 1 Do For K:=0 To 1 Do Begin
  R34SetMv(R34Cur,K,MvPos+I+J*R34B8Stride,0,Mx);
  R34SetMv(R34Cur,K,MvPos+I+J*R34B8Stride,1,My);
 End;
End;

{ ---- compensation de mouvement d'un macrobloc (rv34_mc) ---- }
Procedure R34FetchEmu(Dst: PEABuffer; DS: LongInt; Src: PEABuffer; SOrg,SS,BW,
 BH,X0,Y0,EW,EH: LongInt);
Var X,Y,Sx,Sy: LongInt;
Begin
 For Y:=0 To BH-1 Do Begin
  Sy:=Y0+Y; If Sy<0 Then Sy:=0; If Sy>EH-1 Then Sy:=EH-1;
  For X:=0 To BW-1 Do Begin
   Sx:=X0+X; If Sx<0 Then Sx:=0; If Sx>EW-1 Then Sx:=EW-1;
   Dst^[Y*DS+X]:=Src^[SOrg+Sy*SS+Sx];
  End;
 End;
End;

Procedure R34Mc(BlockType,XOff,YOff,MvOff,Width,Height,Dir: LongInt; Thirdpel,
 Weighted,Avg: Boolean);
Var MvPos,Mvx,Mvy,Mx,My,Lx,Ly,Umx,Umy,Uvmx,Uvmy,Cx,Cy,Dxy,SrcX,SrcY,UvX,UvY,SP,
 Sz: LongInt;
 SrcP,SrcU,SrcV: PEABuffer; SO,SS,UO,UVS,YDO,UDO,VDO: LongInt; DstP,DstU,DstV:
  PEABuffer; Emu,Is16: Boolean;
 CHx,CHy,Lxx,Lyy,Ex,Ey,Rows: LongInt;
Begin
 MvPos:=R34MbX*2+R34MbY*2*R34B8Stride+MvOff;
 Mvx:=R34GetMv(R34Cur,Dir,MvPos,0); Mvy:=R34GetMv(R34Cur,Dir,MvPos,1);
 If Thirdpel Then Begin
  Mx:=(Mvx+(3 Shl 24)) Div 3-(1 Shl 24);
  My:=(Mvy+(3 Shl 24)) Div 3-(1 Shl 24);
  Lx:=(Mvx+(3 Shl 24)) Mod 3;
  Ly:=(Mvy+(3 Shl 24)) Mod 3;
  CHx:=Mvx Div 2; CHy:=Mvy Div 2;
  Umx:=(CHx+(3 Shl 24)) Div 3-(1 Shl 24);
  Umy:=(CHy+(3 Shl 24)) Div 3-(1 Shl 24);
  Uvmx:=R34ChromaCoeffs[(CHx+(3 Shl 24)) Mod 3];
  Uvmy:=R34ChromaCoeffs[(CHy+(3 Shl 24)) Mod 3];
 End Else Begin
  Mx:=R34Sar(Mvx,2); My:=R34Sar(Mvy,2);
  Lx:=Mvx And 3; Ly:=Mvy And 3;
  Cx:=Mvx Div 2; Cy:=Mvy Div 2;
  Umx:=R34Sar(Cx,2); Umy:=R34Sar(Cy,2);
  Uvmx:=(Cx And 3) Shl 1; Uvmy:=(Cy And 3) Shl 1;
  If (Uvmx=6) And (Uvmy=6) Then Begin Uvmx:=4; Uvmy:=4; End;
 End;
 Dxy:=Ly*4+Lx;
 If Dir<>0 Then SP:=R34Next Else SP:=R34Last;
 SrcX:=R34MbX*16+XOff+Mx; SrcY:=R34MbY*16+YOff+My;
 UvX:=R34MbX*8+(XOff Shr 1)+Umx; UvY:=R34MbY*8+(YOff Shr 1)+Umy;
 SrcP:=R34Pics[SP].Pl[0]; SO:=R34OrgY+SrcY*R34LS+SrcX; SS:=R34LS;
 Lxx:=0; If Lx<>0 Then Lxx:=2;
 Lyy:=0; If Ly<>0 Then Lyy:=2;
 Emu:=False;
 If (R34HEdge-(Width Shl 3)<6) Or (R34VEdge-(Height Shl 3)<6) Then Emu:=True
 Else If (LongWord(SrcX-Lxx)>LongWord(R34HEdge-Lxx-(Width Shl 3)-4)) Or
         (LongWord(SrcY-Lyy)>LongWord(R34VEdge-Lyy-(Height Shl 3)-4)) Then Emu:=
          True;
 If Emu Then Begin
  R34FetchEmu(R34EmuY,32,SrcP,R34OrgY,R34LS,(Width Shl 3)+6,(Height Shl 3)+6,
   SrcX-2,SrcY-2,R34HEdge,R34VEdge);
  SrcP:=R34EmuY; SO:=2+2*32; SS:=32;
 End;
 If Not Weighted Then Begin
  DstP:=R34Pics[R34Cur].Pl[0]; YDO:=R34OrgY+R34MbY*16*R34LS+R34MbX*16+XOff+YOff*
   R34LS;
  DstU:=R34Pics[R34Cur].Pl[1]; UDO:=R34OrgC+R34MbY*8*R34CS+R34MbX*8+(XOff Shr
   1)+(YOff Shr 1)*R34CS;
  DstV:=R34Pics[R34Cur].Pl[2]; VDO:=UDO;
 End Else Begin
  DstP:=R34TmpY[Dir]; YDO:=XOff+YOff*R34LS;
  DstU:=R34TmpU[Dir]; UDO:=(XOff Shr 1)+(YOff Shr 1)*R34CS;
  DstV:=R34TmpV[Dir]; VDO:=UDO;
 End;
 If BlockType=R34_MB_P16x8 Then Begin
  If R34Rv30 Then R34McRv30(8,Dxy,Avg,DstP,YDO,R34LS,SrcP,SO,SS) Else R34McRv40(
   8,Dxy,Avg,DstP,YDO,R34LS,SrcP,SO,SS);
  Inc(YDO,8); Inc(SO,8);
 End Else If BlockType=R34_MB_P8x16 Then Begin
  If R34Rv30 Then R34McRv30(8,Dxy,Avg,DstP,YDO,R34LS,SrcP,SO,SS) Else R34McRv40(
   8,Dxy,Avg,DstP,YDO,R34LS,SrcP,SO,SS);
  Inc(YDO,8*R34LS); Inc(SO,8*SS);
 End;
 Is16:=(BlockType<>R34_MB_P8) And (BlockType<>R34_MB_P16x8) And (
  BlockType<>R34_MB_P8x16);
 If Is16 Then Sz:=16 Else Sz:=8;
 If R34Rv30 Then R34McRv30(Sz,Dxy,Avg,DstP,YDO,R34LS,SrcP,SO,SS) Else R34McRv40(
  Sz,Dxy,Avg,DstP,YDO,R34LS,SrcP,SO,SS);
 { chrominance }
 SrcU:=R34Pics[SP].Pl[1]; SrcV:=R34Pics[SP].Pl[2]; UO:=R34OrgC+UvY*R34CS+UvX;
  UVS:=R34CS;
 If Emu Then Begin
  Ex:=R34HEdge Shr 1; Ey:=R34VEdge Shr 1;
  R34FetchEmu(R34EmuU,32,SrcU,R34OrgC,R34CS,(Width Shl 2)+1,(Height Shl 2)+1,
   UvX,UvY,Ex,Ey);
  R34FetchEmu(R34EmuV,32,SrcV,R34OrgC,R34CS,(Width Shl 2)+1,(Height Shl 2)+1,
   UvX,UvY,Ex,Ey);
  SrcU:=R34EmuU; SrcV:=R34EmuV; UO:=0; UVS:=32;
 End;
 If Width=2 Then Sz:=8 Else Sz:=4;
 Rows:=Height*4;
 R34McChroma(Not R34Rv30,Sz,Rows,Uvmx,Uvmy,Avg,DstU,UDO,R34CS,SrcU,UO,UVS);
 R34McChroma(Not R34Rv30,Sz,Rows,Uvmx,Uvmy,Avg,DstV,VDO,R34CS,SrcV,UO,UVS);
End;

Procedure R34Mc1Mv(BlockType,XOff,YOff,MvOff,Width,Height,Dir: LongInt);
Begin R34Mc(BlockType,XOff,YOff,MvOff,Width,Height,Dir,R34Rv30,False,False);
 End;

Procedure R34Rv4Weight;
Var Sc: Boolean;
Begin
 Sc:=R34ScaledWeight<>0;
 R34Rv40Weight(16,R34Pics[R34Cur].Pl[0],R34OrgY+R34MbY*16*R34LS+R34MbX*16,R34LS,
  R34TmpY[0],R34TmpY[1],0,R34LS,R34Weight1,R34Weight2,Sc);
 R34Rv40Weight(8,R34Pics[R34Cur].Pl[1],R34OrgC+R34MbY*8*R34CS+R34MbX*8,R34CS,
  R34TmpU[0],R34TmpU[1],0,R34CS,R34Weight1,R34Weight2,Sc);
 R34Rv40Weight(8,R34Pics[R34Cur].Pl[2],R34OrgC+R34MbY*8*R34CS+R34MbX*8,R34CS,
  R34TmpV[0],R34TmpV[1],0,R34CS,R34Weight1,R34Weight2,Sc);
End;

Procedure R34Mc2Mv(BlockType: LongInt);
Var Weighted: Boolean;
Begin
 Weighted:=(Not R34Rv30) And (BlockType<>R34_MB_BBIDIR) And (R34Weight1<>8192);
 R34Mc(BlockType,0,0,0,2,2,0,R34Rv30,Weighted,False);
 If Not Weighted Then R34Mc(BlockType,0,0,0,2,2,1,R34Rv30,False,True)
 Else Begin
  R34Mc(BlockType,0,0,0,2,2,1,R34Rv30,True,False);
  R34Rv4Weight;
 End;
End;

Procedure R34Mc2MvSkip;
Var I,J: LongInt; Weighted: Boolean;
Begin
 Weighted:=(Not R34Rv30) And (R34Weight1<>8192);
 For J:=0 To 1 Do For I:=0 To 1 Do Begin
  R34Mc(R34_MB_P8,I*8,J*8,I+J*R34B8Stride,1,1,0,R34Rv30,Weighted,False);
  R34Mc(R34_MB_P8,I*8,J*8,I+J*R34B8Stride,1,1,1,R34Rv30,Weighted,Not Weighted);
 End;
 If Weighted Then R34Rv4Weight;
End;

{ ---- vecteurs de mouvement d'un macrobloc ---- }
Function R34DecodeMv(BlockType: LongInt): LongInt;
Var I,J,K,L,MvPos,NextBt: LongInt;
Begin
 MvPos:=R34MbX*2+R34MbY*2*R34B8Stride;
 FillChar(R34Dmv,SizeOf(R34Dmv),0);
 For I:=0 To R34NumMvs[BlockType]-1 Do Begin
  R34Dmv[I,0]:=R34GetISE;
  R34Dmv[I,1]:=R34GetISE;
  If (R34Dmv[I,0]=R34_INVALID) Or (R34Dmv[I,1]=R34_INVALID) Then Begin
   R34Dmv[I,0]:=0; R34Dmv[I,1]:=0; R34DecodeMv:=-1; Exit;
  End;
 End;
 R34DecodeMv:=0;
 Case BlockType Of
  R34_MB_INTRA,R34_MB_INTRA16: R34Zero8x2(R34Cur,0,MvPos);
  R34_MB_SKIP,R34_MB_BDIRECT: Begin
   If (BlockType=R34_MB_SKIP) And (R34PictType=R34_PIC_P) Then Begin
    R34Zero8x2(R34Cur,0,MvPos);
    R34Mc1Mv(BlockType,0,0,0,2,2,0);
   End Else Begin
    NextBt:=R34Pics[R34Next].MbT^[R34MbOrg+R34MbX+R34MbY*R34MbStride];
    If ((NextBt And 7)<>0) Or ((NextBt And R34_MT_SKIP)<>0) Then Begin
     R34Zero8x2(R34Cur,0,MvPos); R34Zero8x2(R34Cur,1,MvPos);
    End Else
     For J:=0 To 1 Do For I:=0 To 1 Do For K:=0 To 1 Do For L:=0 To 1 Do
      R34SetMv(R34Cur,L,MvPos+I+J*R34B8Stride,K,R34CalcAddMv(L,R34GetMv(R34Next,
       0,MvPos+I+J*R34B8Stride,K)));
    If ((NextBt And (R34_MT_16x8 Or R34_MT_8x16 Or R34_MT_8x8))=0) Then
     R34Mc2Mv(BlockType)
    Else R34Mc2MvSkip;
    R34Zero8x2(R34Cur,0,MvPos);
   End;
  End;
  R34_MB_P16,R34_MB_PMIX16: Begin
   R34PredMv(BlockType,0,0);
   R34Mc1Mv(BlockType,0,0,0,2,2,0);
  End;
  R34_MB_BFWD,R34_MB_BBWD: Begin
   R34Dmv[1,0]:=R34Dmv[0,0]; R34Dmv[1,1]:=R34Dmv[0,1];
   If R34Rv30 Then R34PredMvRv3(BlockType,Ord(BlockType=R34_MB_BBWD))
   Else R34PredMvB(BlockType,Ord(BlockType=R34_MB_BBWD));
   R34Mc1Mv(BlockType,0,0,0,2,2,Ord(BlockType=R34_MB_BBWD));
  End;
  R34_MB_P16x8,R34_MB_P8x16: Begin
   R34PredMv(BlockType,0,0);
   R34PredMv(BlockType,1+Ord(BlockType=R34_MB_P16x8),1);
   If BlockType=R34_MB_P16x8 Then Begin
    R34Mc1Mv(BlockType,0,0,0,2,1,0);
    R34Mc1Mv(BlockType,0,8,R34B8Stride,2,1,0);
   End;
   If BlockType=R34_MB_P8x16 Then Begin
    R34Mc1Mv(BlockType,0,0,0,1,2,0);
    R34Mc1Mv(BlockType,8,0,1,1,2,0);
   End;
  End;
  R34_MB_BBIDIR: Begin
   R34PredMvB(BlockType,0);
   R34PredMvB(BlockType,1);
   R34Mc2Mv(BlockType);
  End;
  R34_MB_P8: Begin
   For I:=0 To 3 Do Begin
    R34PredMv(BlockType,I,I);
    R34Mc1Mv(BlockType,(I And 1) Shl 3,(I And 2) Shl 2,(I And 1)+(I Shr 1)*
     R34B8Stride,1,1,0);
   End;
  End;
 End;
End;

{ ---- reconstruction ---- }
Var R34Blk16: Array[0..15] Of SmallInt;

Procedure R34Pred4Block(P: PEABuffer; Dst,Stride,IType,Up,Left,Down,Right:
 LongInt);
Var K: LongInt;
Begin
 If (Up=0) And (Left=0) Then IType:=11
 Else If Up=0 Then Begin
  If IType=0 Then IType:=1;
  If IType=2 Then IType:=9;
 End Else If Left=0 Then Begin
  If IType=1 Then IType:=0;
  If IType=2 Then IType:=10;
  If IType=3 Then IType:=12;
 End;
 If Down=0 Then Begin
  If IType=3 Then IType:=12;
  If IType=8 Then IType:=13;
  If IType=7 Then IType:=14;
 End;
 If (Right=0) And (Up<>0) Then Begin
  For K:=0 To 3 Do R34TR[K]:=P^[Dst-Stride+3];
 End Else Begin
  For K:=0 To 3 Do R34TR[K]:=P^[Dst-Stride+4+K];
 End;
 R34Pred4(IType,P,Dst,Stride);
End;

Function R34AdjustPred16(IType,Up,Left: LongInt): LongInt;
Begin
 If (Up=0) And (Left=0) Then IType:=6
 Else If Up=0 Then Begin
  If IType=3 Then IType:=1;
  If IType=2 Then IType:=1;
  If IType=0 Then IType:=4;
 End Else If Left=0 Then Begin
  If IType=3 Then IType:=2;
  If IType=1 Then IType:=2;
  If IType=0 Then IType:=5;
 End;
 R34AdjustPred16:=IType;
End;

Procedure R34ProcessBlock(P: PEABuffer; O,S,Fc,Sc,QDc,QAc: LongInt);
Var HasAc: LongInt;
Begin
 HasAc:=R34DecodeBlock(PR34I16(@R34Blk),R34CurSet,Fc,Sc,QDc,QAc,QAc);
 If HasAc<>0 Then R34IdctAdd(P,O,S)
 Else Begin
  R34IdctDcAdd(P,O,S,R34Blk[0]);
  R34Blk[0]:=0;
 End;
End;

Function R34DestY: LongInt;
Begin R34DestY:=R34OrgY+R34MbY*16*R34LS+R34MbX*16; End;
Function R34DestC: LongInt;
Begin R34DestC:=R34OrgC+R34MbY*8*R34CS+R34MbX*8; End;

{ It = index dans R34IntraHist du coin haut-gauche du macrobloc }
Procedure R34OutputI16(It,Cbp: LongInt);
Var QDc,QAc,I,J,IType,HasAc,Dc,Dst,PDst,K: LongInt; PY,PU: PEABuffer;
Begin
 PY:=R34Pics[R34Cur].Pl[0];
 If R34Rv30 Then QDc:=R34QscaleTab[R34Rv30LumaDcQuant[R34Qscale]] Else QDc:=
  R34QscaleTab[R34Rv40LumaDcQuant[0,R34Qscale]];
 QAc:=R34QscaleTab[R34Qscale];
 Dst:=R34DestY;
 FillChar(R34Blk16,SizeOf(R34Blk16),0);
 HasAc:=R34DecodeBlock(PR34I16(@R34Blk16),R34CurSet,3,0,QDc,QDc,QAc);
 If HasAc<>0 Then R34InvTransform(PR34I16(@R34Blk16)) Else R34InvTransformDc(
  PR34I16(@R34Blk16));
 IType:=R34Ittrans16[R34IntraHist^[It]];
 IType:=R34AdjustPred16(IType,R34Avail[6-4],R34Avail[6-1]);
 R34Pred16(IType,PY,Dst,R34LS);
 For J:=0 To 3 Do Begin
  For I:=0 To 3 Do Begin
   Dc:=R34Blk16[I+J*4];
   If (Cbp And 1)<>0 Then HasAc:=R34DecodeBlock(PR34I16(@R34Blk),R34CurSet,
    R34LumaVlc,0,QAc,QAc,QAc) Else HasAc:=0;
   If HasAc<>0 Then Begin
    R34Blk[0]:=Dc;
    R34IdctAdd(PY,Dst+4*I,R34LS);
   End Else R34IdctDcAdd(PY,Dst+4*I,R34LS,Dc);
   Cbp:=Cbp Shr 1;
  End;
  Inc(Dst,4*R34LS);
 End;
 IType:=R34Ittrans16[R34IntraHist^[It]];
 If IType=3 Then IType:=0;
 IType:=R34AdjustPred16(IType,R34Avail[6-4],R34Avail[6-1]);
 QDc:=R34QscaleTab[R34ChromaQuant[1,R34Qscale]];
 QAc:=R34QscaleTab[R34ChromaQuant[0,R34Qscale]];
 For J:=1 To 2 Do Begin
  PU:=R34Pics[R34Cur].Pl[J];
  Dst:=R34DestC;
  R34Pred8(IType,PU,Dst,R34CS);
  For I:=0 To 3 Do Begin
   If (Cbp And 1)<>0 Then Begin
    PDst:=Dst+(I And 1)*4+(I And 2)*2*R34CS;
    R34ProcessBlock(PU,PDst,R34CS,R34ChromaVlc,1,QDc,QAc);
   End;
   Cbp:=Cbp Shr 1;
  End;
 End;
End;

Procedure R34OutputIntra(It,Cbp: LongInt);
Var Avail: Array[0..47] Of LongInt; I,J,K,Idx,QAc,QDc,Dst,AC,Itype: LongInt; PY,
 PU: PEABuffer;
Begin
 PY:=R34Pics[R34Cur].Pl[0];
 FillChar(Avail,SizeOf(Avail),0);
 If R34Avail[1]<>0 Then Avail[0]:=1;
 If R34Avail[2]<>0 Then Begin Avail[1]:=1; Avail[2]:=1; End;
 If R34Avail[3]<>0 Then Begin Avail[3]:=1; Avail[4]:=1; End;
 If R34Avail[4]<>0 Then Avail[5]:=1;
 If R34Avail[5]<>0 Then Begin Avail[8]:=1; Avail[16]:=1; End;
 If R34Avail[9]<>0 Then Begin Avail[24]:=1; Avail[32]:=1; End;
 QAc:=R34QscaleTab[R34Qscale];
 Dst:=R34DestY;
 For J:=0 To 3 Do Begin
  Idx:=9+J*8;
  For I:=0 To 3 Do Begin
   R34Pred4Block(PY,Dst,R34LS,R34Ittrans[R34IntraHist^[It+I]],Avail[Idx-8],
    Avail[Idx-1],Avail[Idx+7],Avail[Idx-7]);
   Avail[Idx]:=1;
   If (Cbp And 1)<>0 Then R34ProcessBlock(PY,Dst,R34LS,R34LumaVlc,0,QAc,QAc);
   Cbp:=Cbp Shr 1; Inc(Dst,4); Inc(Idx);
  End;
  Inc(Dst,R34LS*4-4*4);
  Inc(It,R34IntraStride);
 End;
 Dec(It,R34IntraStride*4);
 QDc:=R34QscaleTab[R34ChromaQuant[1,R34Qscale]];
 QAc:=R34QscaleTab[R34ChromaQuant[0,R34Qscale]];
 For K:=0 To 1 Do Begin
  PU:=R34Pics[R34Cur].Pl[1+K];
  Dst:=R34DestC;
  R34Avail[6]:=0; R34Avail[7]:=0; R34Avail[10]:=0; R34Avail[11]:=0;
  For J:=0 To 1 Do Begin
   AC:=6+J*4;
   For I:=0 To 1 Do Begin
    Itype:=R34Ittrans[R34IntraHist^[It+I*2+J*2*R34IntraStride]];
    R34Pred4Block(PU,Dst+4*I,R34CS,Itype,R34Avail[AC-4],R34Avail[AC-1],Ord((I=0)
     And (J=0)),R34Avail[AC-3]);
    R34Avail[AC]:=1;
    If (Cbp And 1)<>0 Then R34ProcessBlock(PU,Dst+4*I,R34CS,R34ChromaVlc,1,QDc,
     QAc);
    Cbp:=Cbp Shr 1; Inc(AC);
   End;
   Inc(Dst,4*R34CS);
  End;
 End;
End;

Function R34MvDiffGt3(Pos,Step: LongInt): Boolean;
Var D: LongInt;
Begin
 R34MvDiffGt3:=True;
 D:=R34GetMv(R34Cur,0,Pos,0)-R34GetMv(R34Cur,0,Pos-Step,0);
 If (D<-3) Or (D>3) Then Exit;
 D:=R34GetMv(R34Cur,0,Pos,1)-R34GetMv(R34Cur,0,Pos-Step,1);
 If (D<-3) Or (D>3) Then Exit;
 R34MvDiffGt3:=False;
End;

Function R34SetDeblockCoef: LongInt;
Var HM,VM,I,J,Midx,Pos: LongInt;
Begin
 HM:=0; VM:=0;
 Midx:=R34MbX*2+R34MbY*2*R34B8Stride;
 Pos:=Midx;
 J:=0;
 While J<16 Do Begin
  For I:=0 To 1 Do Begin
   If R34MvDiffGt3(Pos+I,1) Then VM:=VM Or ($11 Shl (J+I*2));
   If ((J<>0) Or (R34MbY<>0)) And R34MvDiffGt3(Pos+I,R34B8Stride) Then HM:=HM Or
    ($03 Shl (J+I*2));
  End;
  Inc(Pos,R34B8Stride);
  Inc(J,8);
 End;
 If R34FirstSliceLine<>0 Then HM:=HM And Not $000F;
 If R34MbX=0 Then VM:=VM And Not $1111;
 If R34Rv30 Then Begin
  VM:=VM Or ((VM And $4444) Shr 1);
  HM:=HM Or ((HM And $0F00) Shr 4);
  If R34MbX<>0 Then
   R34Deblock^[R34MbOrg+R34MbX-1+R34MbY*R34MbStride]:=(R34Deblock^[R34MbOrg+
    R34MbX-1+R34MbY*R34MbStride] Or ((VM And $1111) Shl 3)) And $FFFF;
  If R34FirstSliceLine=0 Then
   R34Deblock^[R34MbOrg+R34MbX+(R34MbY-1)*R34MbStride]:=(R34Deblock^[R34MbOrg+
    R34MbX+(R34MbY-1)*R34MbStride] Or ((HM And $F) Shl 12)) And $FFFF;
 End;
 R34SetDeblockCoef:=HM Or VM;
End;

Procedure R34CalcAvail;
Var Dist,MbPos: LongInt;
Begin
 FillChar(R34Avail,SizeOf(R34Avail),0);
 R34Avail[6]:=1; R34Avail[7]:=1; R34Avail[10]:=1; R34Avail[11]:=1;
 MbPos:=R34MbX+R34MbY*R34MbStride;
 Dist:=(R34MbX-R34ResyncX)+(R34MbY-R34ResyncY)*R34MbW;
 If (R34MbX<>0) And (Dist<>0) Then Begin
  R34Avail[5]:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos-1]; R34Avail[9]:=R34Avail[5];
 End;
 If Dist>=R34MbW Then Begin
  R34Avail[2]:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos-R34MbStride]; R34Avail[3]:=
   R34Avail[2];
 End;
 If ((R34MbX+1)<R34MbW) And (Dist>=R34MbW-1) Then
  R34Avail[4]:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos-R34MbStride+1];
 If (R34MbX<>0) And (Dist>R34MbW) Then
  R34Avail[1]:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos-R34MbStride-1];
End;

{ en-tete macrobloc intra : retourne cbp ou -1 }
Function R34IntraMbHeader(It: LongInt): LongInt;
Var MbPos,T: LongInt;
Begin
 MbPos:=R34MbX+R34MbY*R34MbStride;
 R34Is16:=R34Get1;
 If R34Is16<>0 Then Begin
  R34Pics[R34Cur].MbT^[R34MbOrg+MbPos]:=2;
  R34BlockType:=R34_MB_INTRA16;
  T:=R34GetBits(2);
  R34FillIntraTypes(It,T);
  R34LumaVlc:=2;
 End Else Begin
  If Not R34Rv30 Then T:=R34Get1;
  R34Pics[R34Cur].MbT^[R34MbOrg+MbPos]:=R34_MT_INTRA;
  R34BlockType:=R34_MB_INTRA;
  If R34DecodeIntraTypes(It)<0 Then Begin R34IntraMbHeader:=-1; Exit; End;
  R34LumaVlc:=1;
 End;
 R34ChromaVlc:=0;
 R34CurSet:=R34ChooseSet(R34Si.Quant,R34Si.VlcSet,0);
 R34IntraMbHeader:=R34DecodeCbp(R34CurSet,R34Is16);
End;

Function R34InterMbHeader(It: LongInt): LongInt;
Var MbPos,I,T,Mt: LongInt;
Begin
 MbPos:=R34MbX+R34MbY*R34MbStride;
 If R34Rv30 Then R34BlockType:=R34Rv30DecodeMbInfo Else R34BlockType:=
  R34Rv40DecodeMbInfo;
 If R34BlockType=-1 Then Begin R34Why:=1; R34InterMbHeader:=-1; Exit; End;
 Mt:=R34MbTypeToLavc[R34BlockType];
 R34Pics[R34Cur].MbT^[R34MbOrg+MbPos]:=Mt;
 R34MbTypeR^[R34MbOrg+MbPos]:=R34BlockType;
 If R34BlockType=R34_MB_SKIP Then Begin
  If R34PictType=R34_PIC_P Then R34MbTypeR^[R34MbOrg+MbPos]:=R34_MB_P16;
  If R34PictType=R34_PIC_B Then R34MbTypeR^[R34MbOrg+MbPos]:=R34_MB_BDIRECT;
 End;
 R34Is16:=Ord((Mt And 2)<>0);
 If R34DecodeMv(R34BlockType)<0 Then Begin R34Why:=2; R34InterMbHeader:=-1;
  Exit; End;
 If R34BlockType=R34_MB_SKIP Then Begin
  R34FillIntraTypes(It,0);
  R34InterMbHeader:=0; Exit;
 End;
 R34ChromaVlc:=1; R34LumaVlc:=0;
 If (Mt And 7)<>0 Then Begin
  If R34Is16<>0 Then Begin
   T:=R34GetBits(2);
   R34FillIntraTypes(It,T);
   R34LumaVlc:=2;
  End Else Begin
   If R34DecodeIntraTypes(It)<0 Then Begin R34Why:=3; R34InterMbHeader:=-1;
    Exit; End;
   R34LumaVlc:=1;
  End;
  R34ChromaVlc:=0;
  R34CurSet:=R34ChooseSet(R34Si.Quant,R34Si.VlcSet,0);
 End Else Begin
  R34FillIntraTypes(It,0);
  R34CurSet:=R34ChooseSet(R34Si.Quant,R34Si.VlcSet,1);
  If R34MbTypeR^[R34MbOrg+MbPos]=R34_MB_PMIX16 Then Begin
   R34Is16:=1; R34ChromaVlc:=1; R34LumaVlc:=2;
   R34CurSet:=R34ChooseSet(R34Si.Quant,R34Si.VlcSet,0);
  End;
 End;
 R34InterMbHeader:=R34DecodeCbp(R34CurSet,R34Is16);
End;

Function R34DecodeInterMacroblock(It: LongInt): LongInt;
Var MbPos,Cbp,QDc,QAc,HasAc,I,J,Dc,Dst,PDst,K: LongInt; PY,PU: PEABuffer;
Begin
 MbPos:=R34MbX+R34MbY*R34MbStride;
 R34CalcAvail;
 R34Qscale:=R34Si.Quant;
 Cbp:=R34InterMbHeader(It);
 R34CbpLuma^[R34MbOrg+MbPos]:=Cbp And $FFFF;
 R34CbpChroma^[R34MbOrg+MbPos]:=(Cbp Shr 16) And $FF;
 R34Deblock^[R34MbOrg+MbPos]:=(R34SetDeblockCoef Or R34CbpLuma^[R34MbOrg+MbPos])
  And $FFFF;
 R34Pics[R34Cur].Qs^[R34MbOrg+MbPos]:=R34Qscale;
 If Cbp=-1 Then Begin R34DecodeInterMacroblock:=-1; Exit; End;
 R34DecodeInterMacroblock:=0;
 If (R34Pics[R34Cur].MbT^[R34MbOrg+MbPos] And 7)<>0 Then Begin
  If R34Is16<>0 Then R34OutputI16(It,Cbp) Else R34OutputIntra(It,Cbp);
  Exit;
 End;
 PY:=R34Pics[R34Cur].Pl[0];
 Dst:=R34DestY;
 If R34Is16<>0 Then Begin
  FillChar(R34Blk16,SizeOf(R34Blk16),0);
  If R34Rv30 Then QDc:=R34QscaleTab[R34Rv30LumaDcQuant[R34Qscale]] Else QDc:=
   R34QscaleTab[R34Rv40LumaDcQuant[1,R34Qscale]];
  QAc:=R34QscaleTab[R34Qscale];
  If R34DecodeBlock(PR34I16(@R34Blk16),R34CurSet,3,0,QDc,QDc,QAc)<>0 Then
   R34InvTransform(PR34I16(@R34Blk16))
  Else R34InvTransformDc(PR34I16(@R34Blk16));
  QAc:=R34QscaleTab[R34Qscale];
  For J:=0 To 3 Do Begin
   For I:=0 To 3 Do Begin
    Dc:=R34Blk16[I+J*4];
    If (Cbp And 1)<>0 Then HasAc:=R34DecodeBlock(PR34I16(@R34Blk),R34CurSet,
     R34LumaVlc,0,QAc,QAc,QAc) Else HasAc:=0;
    If HasAc<>0 Then Begin
     R34Blk[0]:=Dc;
     R34IdctAdd(PY,Dst+4*I,R34LS);
    End Else R34IdctDcAdd(PY,Dst+4*I,R34LS,Dc);
    Cbp:=Cbp Shr 1;
   End;
   Inc(Dst,4*R34LS);
  End;
  R34CurSet:=R34ChooseSet(R34Si.Quant,R34Si.VlcSet,1);
 End Else Begin
  QAc:=R34QscaleTab[R34Qscale];
  For J:=0 To 3 Do Begin
   For I:=0 To 3 Do Begin
    If (Cbp And 1)<>0 Then R34ProcessBlock(PY,Dst+4*I,R34LS,R34LumaVlc,0,QAc,
     QAc);
    Cbp:=Cbp Shr 1;
   End;
   Inc(Dst,4*R34LS);
  End;
 End;
 QDc:=R34QscaleTab[R34ChromaQuant[1,R34Qscale]];
 QAc:=R34QscaleTab[R34ChromaQuant[0,R34Qscale]];
 For J:=1 To 2 Do Begin
  PU:=R34Pics[R34Cur].Pl[J];
  Dst:=R34DestC;
  For I:=0 To 3 Do Begin
   If (Cbp And 1)<>0 Then Begin
    PDst:=Dst+(I And 1)*4+(I And 2)*2*R34CS;
    R34ProcessBlock(PU,PDst,R34CS,R34ChromaVlc,1,QDc,QAc);
   End;
   Cbp:=Cbp Shr 1;
  End;
 End;
End;

Function R34DecodeIntraMacroblock(It: LongInt): LongInt;
Var MbPos,Cbp: LongInt;
Begin
 MbPos:=R34MbX+R34MbY*R34MbStride;
 R34CalcAvail;
 R34Qscale:=R34Si.Quant;
 Cbp:=R34IntraMbHeader(It);
 R34CbpLuma^[R34MbOrg+MbPos]:=Cbp And $FFFF;
 R34CbpChroma^[R34MbOrg+MbPos]:=(Cbp Shr 16) And $FF;
 R34Deblock^[R34MbOrg+MbPos]:=$FFFF;
 R34Pics[R34Cur].Qs^[R34MbOrg+MbPos]:=R34Qscale;
 If Cbp=-1 Then Begin R34DecodeIntraMacroblock:=-1; Exit; End;
 R34DecodeIntraMacroblock:=0;
 If R34Is16<>0 Then R34OutputI16(It,Cbp) Else R34OutputIntra(It,Cbp);
End;

{ ---- filtres de boucle ---- }
Procedure R34Rv30Weak(P: PEABuffer; O,Step,Stride,Lim: LongInt);
Var I,Diff: LongInt;
Begin
 For I:=0 To 3 Do Begin
  Diff:=R34Sar((P^[O-2*Step]-P^[O+Step])-(P^[O-Step]-P^[O])*4,3);
  If Diff<-Lim Then Diff:=-Lim;
  If Diff>Lim Then Diff:=Lim;
  P^[O-Step]:=R34Clip(P^[O-Step]+Diff);
  P^[O]:=R34Clip(P^[O]-Diff);
  Inc(O,Stride);
 End;
End;

Procedure R34Rv30LoopFilter(Row: LongInt);
Var MbPos,MbX,I,J,K,Ij,LocLim,CurLim,LeftLim,TopLim,Mt,CurCbp,LeftCbp,TopCbp,O:
 LongInt; PY,PC: PEABuffer; Q: PEABuffer;
Begin
 PY:=R34Pics[R34Cur].Pl[0]; Q:=R34Pics[R34Cur].Qs;
 LeftLim:=0; TopLim:=0;
 MbPos:=Row*R34MbStride;
 For MbX:=0 To R34MbW-1 Do Begin
  Mt:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos];
  If ((Mt And 7)<>0) Or ((Mt And R34_MT_SEPDC)<>0) Then R34Deblock^[R34MbOrg+
   MbPos]:=$FFFF;
  If (Mt And 7)<>0 Then R34CbpChroma^[R34MbOrg+MbPos]:=$FF;
  Inc(MbPos);
 End;
 MbPos:=Row*R34MbStride;
 For MbX:=0 To R34MbW-1 Do Begin
  CurLim:=R34Rv30LoopFiltLim[Q^[R34MbOrg+MbPos]];
  If MbX<>0 Then LeftLim:=R34Rv30LoopFiltLim[Q^[R34MbOrg+MbPos-1]];
  J:=0;
  While J<16 Do Begin
   O:=R34OrgY+MbX*16+(Row*16+J)*R34LS+4*Ord(MbX=0);
   For I:=Ord(MbX=0) To 3 Do Begin
    Ij:=I+J; LocLim:=0;
    If (R34Deblock^[R34MbOrg+MbPos] And (1 Shl Ij))<>0 Then LocLim:=CurLim
    Else If (I=0) And ((R34Deblock^[R34MbOrg+MbPos-1] And (1 Shl (Ij+3)))<>0)
     Then LocLim:=LeftLim
    Else If (I<>0) And ((R34Deblock^[R34MbOrg+MbPos] And (1 Shl (Ij-1)))<>0)
     Then LocLim:=CurLim;
    If LocLim<>0 Then R34Rv30Weak(PY,O,1,R34LS,LocLim);
    Inc(O,4);
   End;
   Inc(J,4);
  End;
  For K:=0 To 1 Do Begin
   PC:=R34Pics[R34Cur].Pl[K+1];
   CurCbp:=(R34CbpChroma^[R34MbOrg+MbPos] Shr (K*4)) And $F;
   LeftCbp:=0;
   If MbX<>0 Then LeftCbp:=(R34CbpChroma^[R34MbOrg+MbPos-1] Shr (K*4)) And $F;
   J:=0;
   While J<8 Do Begin
    O:=R34OrgC+MbX*8+(Row*8+J)*R34CS+4*Ord(MbX=0);
    For I:=Ord(MbX=0) To 1 Do Begin
     Ij:=I+(J Shr 1); LocLim:=0;
     If (CurCbp And (1 Shl Ij))<>0 Then LocLim:=CurLim
     Else If (I=0) And ((LeftCbp And (1 Shl (Ij+1)))<>0) Then LocLim:=LeftLim
     Else If (I<>0) And ((CurCbp And (1 Shl (Ij-1)))<>0) Then LocLim:=CurLim;
     If LocLim<>0 Then R34Rv30Weak(PC,O,1,R34CS,LocLim);
     Inc(O,4);
    End;
    Inc(J,4);
   End;
  End;
  Inc(MbPos);
 End;
 MbPos:=Row*R34MbStride;
 For MbX:=0 To R34MbW-1 Do Begin
  CurLim:=R34Rv30LoopFiltLim[Q^[R34MbOrg+MbPos]];
  If Row<>0 Then TopLim:=R34Rv30LoopFiltLim[Q^[R34MbOrg+MbPos-R34MbStride]];
  J:=4*Ord(Row=0);
  While J<16 Do Begin
   O:=R34OrgY+MbX*16+(Row*16+J)*R34LS;
   For I:=0 To 3 Do Begin
    Ij:=I+J; LocLim:=0;
    If (R34Deblock^[R34MbOrg+MbPos] And (1 Shl Ij))<>0 Then LocLim:=CurLim
    Else If (J=0) And ((R34Deblock^[R34MbOrg+MbPos-R34MbStride] And (1 Shl (Ij+
     12)))<>0) Then LocLim:=TopLim
    Else If (J<>0) And ((R34Deblock^[R34MbOrg+MbPos] And (1 Shl (Ij-4)))<>0)
     Then LocLim:=CurLim;
    If LocLim<>0 Then R34Rv30Weak(PY,O,R34LS,1,LocLim);
    Inc(O,4);
   End;
   Inc(J,4);
  End;
  For K:=0 To 1 Do Begin
   PC:=R34Pics[R34Cur].Pl[K+1];
   CurCbp:=(R34CbpChroma^[R34MbOrg+MbPos] Shr (K*4)) And $F;
   TopCbp:=0;
   If Row<>0 Then TopCbp:=(R34CbpChroma^[R34MbOrg+MbPos-R34MbStride] Shr (K*4))
    And $F;
   J:=4*Ord(Row=0);
   While J<8 Do Begin
    O:=R34OrgC+MbX*8+(Row*8+J)*R34CS;
    For I:=0 To 1 Do Begin
     Ij:=I+(J Shr 1); LocLim:=0;
     If (R34CbpChroma^[R34MbOrg+MbPos] And (1 Shl Ij))<>0 Then LocLim:=CurLim
     Else If (J=0) And ((TopCbp And (1 Shl (Ij+2)))<>0) Then LocLim:=TopLim
     Else If (J<>0) And ((CurCbp And (1 Shl (Ij-2)))<>0) Then LocLim:=CurLim;
     If LocLim<>0 Then R34Rv30Weak(PC,O,R34CS,1,LocLim);
     Inc(O,4);
    End;
    Inc(J,4);
   End;
  End;
  Inc(MbPos);
 End;
End;

{ ---- RV40 ---- }
Var R34FP1,R34FQ1: LongInt;

Function R34Rv40Strength(P: PEABuffer; O,Step,Stride,Beta,Beta2,Edge: LongInt):
 LongInt;
Var SumP1P0,SumQ1Q0,SumP1P2,SumQ1Q2,I,Q: LongInt; Strong0,Strong1: Boolean;
Begin
 SumP1P0:=0; SumQ1Q0:=0; SumP1P2:=0; SumQ1Q2:=0;
 Q:=O;
 For I:=0 To 3 Do Begin
  Inc(SumP1P0,P^[Q-2*Step]-P^[Q-Step]);
  Inc(SumQ1Q0,P^[Q+Step]-P^[Q]);
  Inc(Q,Stride);
 End;
 R34FP1:=Ord(R34Abs(SumP1P0)<(Beta Shl 2));
 R34FQ1:=Ord(R34Abs(SumQ1Q0)<(Beta Shl 2));
 R34Rv40Strength:=0;
 If (R34FP1=0) And (R34FQ1=0) Then Exit;
 If Edge=0 Then Exit;
 Q:=O;
 For I:=0 To 3 Do Begin
  Inc(SumP1P2,P^[Q-2*Step]-P^[Q-3*Step]);
  Inc(SumQ1Q2,P^[Q+Step]-P^[Q+2*Step]);
  Inc(Q,Stride);
 End;
 Strong0:=(R34FP1<>0) And (R34Abs(SumP1P2)<Beta2);
 Strong1:=(R34FQ1<>0) And (R34Abs(SumQ1Q2)<Beta2);
 R34Rv40Strength:=Ord(Strong0 And Strong1);
End;

Procedure R34Rv40WeakF(P: PEABuffer; O,Step,Stride,FP1,FQ1,Alpha,Beta,LimP0Q0,
 LimQ1,LimP1: LongInt);
Var I,T,U,Diff,DP1P0,DQ1Q0,DP1P2,DQ1Q2,Tv: LongInt;
Begin
 For I:=0 To 3 Do Begin
  DP1P0:=P^[O-2*Step]-P^[O-Step];
  DQ1Q0:=P^[O+Step]-P^[O];
  DP1P2:=P^[O-2*Step]-P^[O-3*Step];
  DQ1Q2:=P^[O+Step]-P^[O+2*Step];
  T:=P^[O]-P^[O-Step];
  If T<>0 Then Begin
   U:=R34Sar(Alpha*R34Abs(T),7);
   If U<=3-Ord((FP1<>0) And (FQ1<>0)) Then Begin
    T:=T*4;
    If (FP1<>0) And (FQ1<>0) Then Inc(T,P^[O-2*Step]-P^[O+Step]);
    Diff:=R34Sar(T+4,3);
    If Diff<-LimP0Q0 Then Diff:=-LimP0Q0;
    If Diff>LimP0Q0 Then Diff:=LimP0Q0;
    P^[O-Step]:=R34Clip(P^[O-Step]+Diff);
    P^[O]:=R34Clip(P^[O]-Diff);
    If (FP1<>0) And (R34Abs(DP1P2)<=Beta) Then Begin
     Tv:=R34Sar(DP1P0+DP1P2-Diff,1);
     If Tv<-LimP1 Then Tv:=-LimP1;
     If Tv>LimP1 Then Tv:=LimP1;
     P^[O-2*Step]:=R34Clip(P^[O-2*Step]-Tv);
    End;
    If (FQ1<>0) And (R34Abs(DQ1Q2)<=Beta) Then Begin
     Tv:=R34Sar(DQ1Q0+DQ1Q2+Diff,1);
     If Tv<-LimQ1 Then Tv:=-LimQ1;
     If Tv>LimQ1 Then Tv:=LimQ1;
     P^[O+Step]:=R34Clip(P^[O+Step]-Tv);
    End;
   End;
  End;
  Inc(O,Stride);
 End;
End;

Procedure R34Rv40StrongF(P: PEABuffer; O,Step,Stride,Alpha,Lims,DMode,Chroma:
 LongInt);
Var I,Sflag,P0,Q0,P1,Q1,T,A,B: LongInt;
Begin
 For I:=0 To 3 Do Begin
  T:=P^[O]-P^[O-Step];
  If T<>0 Then Begin
   Sflag:=R34Sar(Alpha*R34Abs(T),7);
   If Sflag<=1 Then Begin
    P0:=R34Sar(25*P^[O-3*Step]+26*P^[O-2*Step]+26*P^[O-Step]+26*P^[O]+25*P^[O+
     Step]+R34DitherL[DMode+I],7);
    Q0:=R34Sar(25*P^[O-2*Step]+26*P^[O-Step]+26*P^[O]+26*P^[O+Step]+25*P^[O+2*
     Step]+R34DitherR[DMode+I],7);
    If Sflag<>0 Then Begin
     A:=P^[O-Step]-Lims; B:=P^[O-Step]+Lims; If P0<A Then P0:=A; If P0>B Then
      P0:=B;
     A:=P^[O]-Lims; B:=P^[O]+Lims; If Q0<A Then Q0:=A; If Q0>B Then Q0:=B;
    End;
    P1:=R34Sar(25*P^[O-4*Step]+26*P^[O-3*Step]+26*P^[O-2*Step]+26*P0+25*P^[O]+
     R34DitherL[DMode+I],7);
    Q1:=R34Sar(25*P^[O-Step]+26*Q0+26*P^[O+Step]+26*P^[O+2*Step]+25*P^[O+3*
     Step]+R34DitherR[DMode+I],7);
    If Sflag<>0 Then Begin
     A:=P^[O-2*Step]-Lims; B:=P^[O-2*Step]+Lims; If P1<A Then P1:=A; If P1>B
      Then P1:=B;
     A:=P^[O+Step]-Lims; B:=P^[O+Step]+Lims; If Q1<A Then Q1:=A; If Q1>B Then
      Q1:=B;
    End;
    P^[O-2*Step]:=P1; P^[O-Step]:=P0; P^[O]:=Q0; P^[O+Step]:=Q1;
    If Chroma=0 Then Begin
     P^[O-3*Step]:=R34Sar(25*P^[O-Step]+26*P^[O-2*Step]+51*P^[O-3*Step]+26*P^[O-
      4*Step]+64,7);
     P^[O+2*Step]:=R34Sar(25*P^[O]+26*P^[O+Step]+51*P^[O+2*Step]+26*P^[O+3*
      Step]+64,7);
    End;
   End;
  End;
  Inc(O,Stride);
 End;
End;

{ Dir : 0 = bord horizontal (pas = ligne), 1 = bord vertical (pas = 1) }
Procedure R34Rv40Adaptive(P: PEABuffer; O,Stride,DMode,LimQ1,LimP1,Alpha,Beta,
 Beta2,Chroma,Edge,Dir: LongInt);
Var Strong,Lims,Step,Along: LongInt;
Begin
 If Dir=0 Then Begin Step:=Stride; Along:=1; End Else Begin Step:=1; Along:=
  Stride; End;
 Strong:=R34Rv40Strength(P,O,Step,Along,Beta,Beta2,Edge);
 Lims:=R34FP1+R34FQ1+((LimQ1+LimP1) Shr 1)+1;
 If Strong<>0 Then R34Rv40StrongF(P,O,Step,Along,Alpha,Lims,DMode,Chroma)
 Else If (R34FP1<>0) And (R34FQ1<>0) Then R34Rv40WeakF(P,O,Step,Along,1,1,Alpha,
  Beta,Lims,LimQ1,LimP1)
 Else If (R34FP1<>0) Or (R34FQ1<>0) Then R34Rv40WeakF(P,O,Step,Along,R34FP1,
  R34FQ1,Alpha,Beta,Lims Shr 1,LimQ1 Shr 1,LimP1 Shr 1);
End;

Procedure R34Rv40LoopFilter(Row: LongInt);
Var MbPos,MbX,I,J,K,Pos,Q,Alpha,Beta,BetaY,BetaC,Mt,Ij,Dither,ClipCur,ClipLeft,
 ClipBot,ClipTop: LongInt;
 MbType,MbStrong,Clip,Cbp,MvMasks,Avail: Array[0..3] Of LongInt; UvCbp: Array[
  0..3,0..1] Of LongInt;
 YHDeb,YVDeb,YToDeb,CVDeb,CHDeb,CToDeb: LongInt; CvD,ChD,CtD: Array[0..1] Of
  LongInt;
 PY,PC: PEABuffer; O: LongInt;
Begin
 PY:=R34Pics[R34Cur].Pl[0];
 MbPos:=Row*R34MbStride;
 For MbX:=0 To R34MbW-1 Do Begin
  Mt:=R34Pics[R34Cur].MbT^[R34MbOrg+MbPos];
  If ((Mt And 7)<>0) Or ((Mt And R34_MT_SEPDC)<>0) Then Begin
   R34CbpLuma^[R34MbOrg+MbPos]:=$FFFF; R34Deblock^[R34MbOrg+MbPos]:=$FFFF;
  End;
  If (Mt And 7)<>0 Then R34CbpChroma^[R34MbOrg+MbPos]:=$FF;
  Inc(MbPos);
 End;
 MbPos:=Row*R34MbStride;
 For MbX:=0 To R34MbW-1 Do Begin
  Q:=R34Pics[R34Cur].Qs^[R34MbOrg+MbPos];
  Alpha:=R34AlphaTab[Q]; Beta:=R34BetaTab[Q];
  BetaY:=Beta*3; BetaC:=Beta*3;
  If R34W*R34H<=176*144 Then Inc(BetaY,Beta);
  Avail[0]:=1; Avail[1]:=Row; Avail[2]:=MbX; Avail[3]:=Ord(Row<R34MbH-1);
  For I:=0 To 3 Do Begin
   If Avail[I]<>0 Then Begin
    Pos:=MbPos+R34NeighX[I]+R34NeighY[I]*R34MbStride;
    MvMasks[I]:=R34Deblock^[R34MbOrg+Pos];
    MbType[I]:=R34Pics[R34Cur].MbT^[R34MbOrg+Pos];
    Cbp[I]:=R34CbpLuma^[R34MbOrg+Pos];
    UvCbp[I,0]:=R34CbpChroma^[R34MbOrg+Pos] And $F;
    UvCbp[I,1]:=R34CbpChroma^[R34MbOrg+Pos] Shr 4;
   End Else Begin
    MvMasks[I]:=0; MbType[I]:=MbType[0]; Cbp[I]:=0; UvCbp[I,0]:=0; UvCbp[I,1]:=
     0;
   End;
   MbStrong[I]:=Ord(((MbType[I] And 7)<>0) Or ((MbType[I] And
    R34_MT_SEPDC)<>0));
   Clip[I]:=R34FilterClipTbl[MbStrong[I]+1,Q];
  End;
  YToDeb:=MvMasks[0] Or (MvMasks[3] Shl 16);
  YHDeb:=YToDeb Or ((Cbp[0] Shl 4) And Not $000F) Or ((Cbp[1] And $F000) Shr
   12);
  YVDeb:=YToDeb Or ((Cbp[0] Shl 1) And Not $1111) Or ((Cbp[2] And $8888) Shr 3);
  If MbX=0 Then YVDeb:=YVDeb And Not $1111;
  If Row=0 Then YHDeb:=YHDeb And Not $000F;
  If (Row=R34MbH-1) Or ((MbStrong[0] Or MbStrong[3])<>0) Then YHDeb:=YHDeb And
   Not ($000F Shl 16);
  For I:=0 To 1 Do Begin
   CtD[I]:=(UvCbp[3,I] Shl 4) Or UvCbp[0,I];
   CvD[I]:=CtD[I] Or ((UvCbp[0,I] Shl 1) And Not $0005) Or ((UvCbp[2,I] And
    $000A) Shr 1);
   ChD[I]:=CtD[I] Or ((UvCbp[1,I] And $000C) Shr 2) Or (UvCbp[0,I] Shl 2);
   If MbX=0 Then CvD[I]:=CvD[I] And Not $0005;
   If Row=0 Then ChD[I]:=ChD[I] And Not $0003;
   If (Row=R34MbH-1) Or ((MbStrong[0] Or MbStrong[3])<>0) Then ChD[I]:=ChD[I]
    And Not ($0003 Shl 4);
  End;
  J:=0;
  While J<16 Do Begin
   O:=R34OrgY+MbX*16+(Row*16+J)*R34LS;
   For I:=0 To 3 Do Begin
    Ij:=I+J;
    If (YToDeb And (1 Shl Ij))<>0 Then ClipCur:=Clip[0] Else ClipCur:=0;
    If J<>0 Then Dither:=Ij Else Dither:=I*4;
    If (YHDeb And ($10 Shl Ij))<>0 Then Begin
     If (YToDeb And ($10 Shl Ij))<>0 Then ClipBot:=Clip[0] Else ClipBot:=0;
     R34Rv40Adaptive(PY,O+4*R34LS,R34LS,Dither,ClipBot,ClipCur,Alpha,Beta,BetaY,
      0,0,0);
    End;
    If ((YVDeb And (1 Shl Ij))<>0) And ((I<>0) Or ((MbStrong[0] Or MbStrong[
     2])=0)) Then Begin
     If I=0 Then Begin
      If (MvMasks[2] And ($8 Shl J))<>0 Then ClipLeft:=Clip[2] Else ClipLeft:=0;
     End Else Begin
      If (YToDeb And (1 Shl (Ij-1)))<>0 Then ClipLeft:=Clip[0] Else ClipLeft:=0;
     End;
     R34Rv40Adaptive(PY,O,R34LS,Dither,ClipCur,ClipLeft,Alpha,Beta,BetaY,0,0,1);
    End;
    If (J=0) And ((YHDeb And (1 Shl I))<>0) And ((MbStrong[0] Or MbStrong[
     1])<>0) Then Begin
     If (MvMasks[1] And ($1000 Shl I))<>0 Then ClipTop:=Clip[1] Else ClipTop:=0;
     R34Rv40Adaptive(PY,O,R34LS,Dither,ClipCur,ClipTop,Alpha,Beta,BetaY,0,1,0);
    End;
    If ((YVDeb And (1 Shl Ij))<>0) And (I=0) And ((MbStrong[0] Or MbStrong[
     2])<>0) Then Begin
     If (MvMasks[2] And ($8 Shl J))<>0 Then ClipLeft:=Clip[2] Else ClipLeft:=0;
     R34Rv40Adaptive(PY,O,R34LS,Dither,ClipCur,ClipLeft,Alpha,Beta,BetaY,0,1,1);
    End;
    Inc(O,4);
   End;
   Inc(J,4);
  End;
  For K:=0 To 1 Do Begin
   PC:=R34Pics[R34Cur].Pl[K+1];
   For J:=0 To 1 Do Begin
    O:=R34OrgC+MbX*8+(Row*8+J*4)*R34CS;
    For I:=0 To 1 Do Begin
     Ij:=I+J*2;
     If (CtD[K] And (1 Shl Ij))<>0 Then ClipCur:=Clip[0] Else ClipCur:=0;
     If (ChD[K] And (1 Shl (Ij+2)))<>0 Then Begin
      If (CtD[K] And (1 Shl (Ij+2)))<>0 Then ClipBot:=Clip[0] Else ClipBot:=0;
      R34Rv40Adaptive(PC,O+4*R34CS,R34CS,I*8,ClipBot,ClipCur,Alpha,Beta,BetaC,1,
       0,0);
     End;
     If ((CvD[K] And (1 Shl Ij))<>0) And ((I<>0) Or ((MbStrong[0] Or MbStrong[
      2])=0)) Then Begin
      If I=0 Then Begin
       If (UvCbp[2,K] And (1 Shl (2*J+1)))<>0 Then ClipLeft:=Clip[2] Else
        ClipLeft:=0;
      End Else Begin
       If (CtD[K] And (1 Shl (Ij-1)))<>0 Then ClipLeft:=Clip[0] Else ClipLeft:=
        0;
      End;
      R34Rv40Adaptive(PC,O,R34CS,J*8,ClipCur,ClipLeft,Alpha,Beta,BetaC,1,0,1);
     End;
     If (J=0) And ((ChD[K] And (1 Shl Ij))<>0) And ((MbStrong[0] Or MbStrong[
      1])<>0) Then Begin
      If (UvCbp[1,K] And (1 Shl (Ij+2)))<>0 Then ClipTop:=Clip[1] Else ClipTop:=
       0;
      R34Rv40Adaptive(PC,O,R34CS,I*8,ClipCur,ClipTop,Alpha,Beta,BetaC,1,1,0);
     End;
     If ((CvD[K] And (1 Shl Ij))<>0) And (I=0) And ((MbStrong[0] Or MbStrong[
      2])<>0) Then Begin
      If (UvCbp[2,K] And (1 Shl (2*J+1)))<>0 Then ClipLeft:=Clip[2] Else
       ClipLeft:=0;
      R34Rv40Adaptive(PC,O,R34CS,J*8,ClipCur,ClipLeft,Alpha,Beta,BetaC,1,1,1);
     End;
     Inc(O,4);
    End;
   End;
  End;
  Inc(MbPos);
 End;
End;

{ ---- contexte, images et tranches ---- }
Procedure R34FreePic(I: LongInt);
Begin
 With R34Pics[I] Do Begin
  If Used Then Begin
   FreeMem(Pl[0],1); FreeMem(Pl[1],1); FreeMem(Pl[2],1);
   FreeMem(Mv[0],1); FreeMem(Mv[1],1); FreeMem(MbT,1); FreeMem(Qs,1);
  End;
  Used:=False;
 End;
End;

Procedure R34FreeCtx;
Var I: LongInt;
Begin
 For I:=0 To R34_NPIC-1 Do R34FreePic(I);
 If R34IntraHist<>Nil Then Begin
  FreeMem(R34IntraHist,1); FreeMem(R34MbTypeR,1); FreeMem(R34CbpLuma,1);
   FreeMem(R34CbpChroma,1); FreeMem(R34Deblock,1);
  FreeMem(R34TmpY[0],1); FreeMem(R34TmpY[1],1); FreeMem(R34TmpU[0],1); FreeMem(
   R34TmpU[1],1);
  FreeMem(R34TmpV[0],1); FreeMem(R34TmpV[1],1); FreeMem(R34EmuY,1); FreeMem(
   R34EmuU,1); FreeMem(R34EmuV,1);
  R34IntraHist:=Nil;
 End;
 R34Cur:=-1; R34Last:=-1; R34Next:=-1;
End;

Function R34Calloc(N: LongInt): PEABuffer;
Var P: PEABuffer;
Begin
 GetMem(P,N+64); FillChar(P^,N+64,0); R34Calloc:=P;
End;

Procedure R34AllocCtx(W,H: LongInt);
Var N: LongInt;
Begin
 R34FreeCtx;
 R34W:=W; R34H:=H;
 R34MbW:=(W+15) Div 16; R34MbH:=(H+15) Div 16; R34MbStride:=R34MbW+1;
  R34B8Stride:=R34MbW*2+1;
 R34MbNum:=R34MbW*R34MbH;
 R34LS:=R34MbW*16+64; R34CS:=R34MbW*8+64;
 R34OrgY:=16*R34LS+32; R34OrgC:=16*R34CS+32;
 R34HEdge:=R34MbW*16; R34VEdge:=R34MbH*16;
 R34MvOrg:=R34B8Stride+4; R34MbOrg:=R34MbStride+2;
 R34IntraStride:=R34MbW*4+4;
 N:=R34MbOrg+R34MbStride*(R34MbH+1)+4;
 R34IntraHist:=PR34SB(R34Calloc(R34IntraStride*8));
 R34MbTypeR:=PALLong(R34Calloc(N*4)); R34CbpLuma:=PALLong(R34Calloc(N*4));
 R34CbpChroma:=PALLong(R34Calloc(N*4)); R34Deblock:=PALLong(R34Calloc(N*4));
 R34TmpY[0]:=R34Calloc(16*R34LS+64); R34TmpY[1]:=R34Calloc(16*R34LS+64);
 R34TmpU[0]:=R34Calloc(8*R34CS+64); R34TmpU[1]:=R34Calloc(8*R34CS+64);
 R34TmpV[0]:=R34Calloc(8*R34CS+64); R34TmpV[1]:=R34Calloc(8*R34CS+64);
 R34EmuY:=R34Calloc(32*32); R34EmuU:=R34Calloc(32*32); R34EmuV:=R34Calloc(32*
  32);
End;

Function R34AllocPic: LongInt;
Var I,N,MvN: LongInt;
Begin
 R34AllocPic:=-1;
 For I:=0 To R34_NPIC-1 Do If Not R34Pics[I].Used Then Begin
  With R34Pics[I] Do Begin
   Used:=True;
   Pl[0]:=R34Calloc((R34MbH*16+32)*R34LS+64);
   Pl[1]:=R34Calloc((R34MbH*8+32)*R34CS+64);
   Pl[2]:=R34Calloc((R34MbH*8+32)*R34CS+64);
   MvN:=R34MvOrg+R34B8Stride*(R34MbH*2+2)+8;
   Mv[0]:=PR34I16(R34Calloc(MvN*4)); Mv[1]:=PR34I16(R34Calloc(MvN*4));
   N:=R34MbOrg+R34MbStride*(R34MbH+1)+4;
   MbT:=PALLong(R34Calloc(N*4)); Qs:=R34Calloc(N);
  End;
  R34AllocPic:=I; Exit;
 End;
End;

Procedure R34InitDecoder(IsRv30: Boolean; W,H: LongInt; Ext: PEABuffer; ExtLen:
 LongInt);
Var I: LongInt;
Begin
 FillChar(R34Pics,SizeOf(R34Pics),0);
 R34IntraHist:=Nil;
 R34Rv30:=IsRv30;
 R34ExtLen:=ExtLen; If R34ExtLen>256 Then R34ExtLen:=256;
 For I:=0 To R34ExtLen-1 Do R34Ext[I]:=Ext^[I];
 If IsRv30 Then Begin
  If R34ExtLen<2 Then Fail('rv30: extradata trop petit.');
  R34MaxRpr:=R34Ext[1] And 7;
 End Else R34MaxRpr:=0;
 R34OrigW:=W; R34OrigH:=H;
 If (W<=0) Or (H<=0) Or (W>16384) Or (H>16384) Then Fail(
  'realvideo: dimensions invalides.');
 R34InitTables;
 R34AllocCtx(W,H);
 R34CurPts:=0; R34LastPts:=0; R34NextPts:=0; R34MbNumLeft:=0; R34MbX:=0;
  R34MbY:=0;
 FillChar(R34Si,SizeOf(R34Si),0);
 R34Inited:=True;
End;

Procedure R34CloseDecoder;
Begin
 If R34Inited Then R34FreeCtx;
 R34Inited:=False;
End;

{ ff_mpv_frame_start }
Procedure R34FrameStart;
Var I,D: LongInt;
Begin
 If (R34PictType<>R34_PIC_B) And (R34Last>=0) And (R34Last<>R34Next) Then
  R34FreePic(R34Last);
 For I:=0 To R34_NPIC-1 Do
  If R34Pics[I].Used And (I<>R34Last) And (I<>R34Next) Then R34FreePic(I);
 R34Cur:=R34AllocPic;
 If R34Cur<0 Then Fail('rv34: plus de tampon image.');
 If R34PictType<>R34_PIC_B Then Begin R34Last:=R34Next; R34Next:=R34Cur; End;
 If ((R34Last<0) Or Not R34Pics[R34Last].Used) And (R34PictType<>R34_PIC_I) Then
  Begin
  R34Last:=R34AllocPic;
  If R34Last<0 Then Fail('rv34: plus de tampon image.');
  { image fictive grise }
  For I:=0 To R34H-1 Do FillChar(R34Pics[R34Last].Pl[0]^[R34OrgY+I*R34LS],R34W,
   128);
  For D:=1 To 2 Do
   For I:=0 To ((R34H+1) Div 2)-1 Do FillChar(R34Pics[R34Last].Pl[D]^[R34OrgC+I*
    R34CS],(R34W+1) Div 2,128);
 End;
 If ((R34Next<0) Or Not R34Pics[R34Next].Used) And (R34PictType=R34_PIC_B) Then
  Begin
  R34Next:=R34AllocPic;
  If R34Next<0 Then Fail('rv34: plus de tampon image.');
 End;
End;

Function R34CheckSliceEnd: Boolean;
Var Bits: LongInt;
Begin
 R34CheckSliceEnd:=True;
 If R34MbY>=R34MbH Then Exit;
 If R34MbNumLeft=0 Then Exit;
 If R34SkipRun>1 Then Begin R34CheckSliceEnd:=False; Exit; End;
 Bits:=R34BitsLeft;
 If (Bits<=0) Or ((Bits<8) And (R34Peek(Bits)=0)) Then Exit;
 R34CheckSliceEnd:=False;
End;

Function R34DecodeSlice(EndMb,Offset,Size: LongInt): LongInt;
Var Res,MbPos,SliceType,It: LongInt;
Begin
 R34InitGb(Offset,Size);
 Res:=R34ParseSliceHeader(R34Si);
 If Res<0 Then Begin Inc(R34Errors); R34DecodeSlice:=-1; Exit; End;
 If R34Si.Typ<>0 Then SliceType:=R34Si.Typ Else SliceType:=R34_PIC_I;
 If SliceType<>R34PictType Then Begin Inc(R34Errors); R34DecodeSlice:=-1; Exit;
  End;
 If (R34W<>R34Si.Width) Or (R34H<>R34Si.Height) Then Begin Inc(R34Errors);
  R34DecodeSlice:=-1; Exit; End;
 R34Si.EndMb:=EndMb;
 R34Qscale:=R34Si.Quant;
 R34MbNumLeft:=R34Si.EndMb-R34Si.Start;
 R34SkipRun:=0;
 MbPos:=R34MbX+R34MbY*R34MbW;
 If R34Si.Start<>MbPos Then Begin
  R34MbX:=R34Si.Start Mod R34MbW; R34MbY:=R34Si.Start Div R34MbW;
 End;
 FillChar(R34IntraHist^,R34IntraStride*8,$FF);
 R34FirstSliceLine:=1; R34ResyncX:=R34MbX; R34ResyncY:=R34MbY;
 While Not R34CheckSliceEnd Do Begin
  It:=R34IntraStride*4+R34MbX*4+4;
  If R34Si.Typ<>0 Then Res:=R34DecodeInterMacroblock(It) Else Res:=
   R34DecodeIntraMacroblock(It);
  If Res<0 Then Begin Inc(R34Errors); R34DecodeSlice:=-1; Exit; End;
  Inc(R34MbX);
  If R34MbX=R34MbW Then Begin
   R34MbX:=0; Inc(R34MbY);
   Move(R34IntraHist^[R34IntraStride*4],R34IntraHist^[0],R34IntraStride*4);
   FillChar(R34IntraHist^[R34IntraStride*4],R34IntraStride*4,$FF);
   If R34MbY>=2 Then Begin
    If R34Rv30 Then R34Rv30LoopFilter(R34MbY-2) Else R34Rv40LoopFilter(R34MbY-
     2);
   End;
  End;
  If R34MbX=R34ResyncX Then R34FirstSliceLine:=0;
  Dec(R34MbNumLeft);
 End;
 R34DecodeSlice:=Ord(R34MbY=R34MbH);
End;

Function R34SliceOffset(Pk: PEABuffer; N,Count,BufSize: LongInt): LongInt;
Var P: LongInt; Le,Be: Int64;
Begin
 If N<Count Then Begin
  P:=1+8*N;
  Le:=Int64(Pk^[P])+Int64(Pk^[P+1]) Shl 8+Int64(Pk^[P+2]) Shl 16+Int64(Pk^[P+3])
   Shl 24;
  P:=P+4;
  If Le=1 Then R34SliceOffset:=R34W32(Int64(Pk^[P])+Int64(Pk^[P+1]) Shl 8+Int64(
   Pk^[P+2]) Shl 16+Int64(Pk^[P+3]) Shl 24)
  Else R34SliceOffset:=R34W32(Int64(Pk^[P+3])+Int64(Pk^[P+2]) Shl 8+Int64(Pk^[P+
   1]) Shl 16+Int64(Pk^[P]) Shl 24);
 End Else R34SliceOffset:=BufSize;
End;

Function R34GetPtsDiff(A,B: LongInt): LongInt;
Begin R34GetPtsDiff:=(A-B+8192) And $1FFF; End;

{ decode un paquet ; retourne 1 si une image est sortie (R34OutPic), 0 sinon, -1
 en cas d'erreur de paquet }
Function R34DecodeFrame(Pk: PEABuffer; Len: LongInt): LongInt;
Var SliceCount,BufSize,Offset,Offset1,Offset2,Size,I,Last,RefDist,Dist0,Dist1:
 LongInt;
 Si: TR34SI; FaultyB: Boolean;
Begin
 R34DecodeFrame:=0;
 If Len<1 Then Begin R34DecodeFrame:=-1; Exit; End;
 SliceCount:=Pk^[0]+1;
 BufSize:=Len-1-8*SliceCount;
 If BufSize<0 Then Begin R34DecodeFrame:=-1; Exit; End;
 R34Data:=PEABuffer(@Pk^[1+8*SliceCount]); R34DataLen:=BufSize;
 Offset:=R34SliceOffset(Pk,0,SliceCount,BufSize);
 If (Offset<0) Or (Offset>BufSize) Then Begin R34DecodeFrame:=-1; Exit; End;
 R34InitGb(Offset,BufSize-Offset);
 If (R34ParseSliceHeader(Si)<0) Or (Si.Start<>0) Then Begin R34DecodeFrame:=-1;
  Exit; End;
 FaultyB:=False;
 If ((R34Last<0) Or Not R34Pics[R34Last].Used) And (Si.Typ=R34_PIC_B) Then
  FaultyB:=True;
 If (R34W<>Si.Width) Or (R34H<>Si.Height) Then Begin
  R34AllocCtx(Si.Width,Si.Height);
 End;
 If FaultyB Then Begin R34DecodeFrame:=-1; Exit; End;
 If Si.Typ<>0 Then R34PictType:=Si.Typ Else R34PictType:=R34_PIC_I;
 R34FrameStart;
 R34CurPts:=Si.Pts;
 If R34PictType<>R34_PIC_B Then Begin R34LastPts:=R34NextPts; R34NextPts:=
  R34CurPts; End
 Else Begin
  RefDist:=R34GetPtsDiff(R34NextPts,R34LastPts);
  Dist0:=R34GetPtsDiff(R34CurPts,R34LastPts);
  Dist1:=R34GetPtsDiff(R34NextPts,R34CurPts);
  If RefDist=0 Then Begin
   R34MvWeight1:=8192; R34MvWeight2:=8192; R34Weight1:=8192; R34Weight2:=8192;
    R34ScaledWeight:=0;
  End Else Begin
   R34MvWeight1:=(Dist0 Shl 14) Div RefDist;
   R34MvWeight2:=(Dist1 Shl 14) Div RefDist;
   If ((R34MvWeight1 Or R34MvWeight2) And 511)<>0 Then Begin
    R34Weight1:=R34MvWeight1; R34Weight2:=R34MvWeight2; R34ScaledWeight:=0;
   End Else Begin
    R34Weight1:=R34MvWeight1 Shr 9; R34Weight2:=R34MvWeight2 Shr 9;
     R34ScaledWeight:=1;
   End;
  End;
 End;
 R34MbX:=0; R34MbY:=0;
 Last:=0;
 For I:=0 To SliceCount-1 Do Begin
  Offset:=R34SliceOffset(Pk,I,SliceCount,BufSize);
  Offset1:=R34SliceOffset(Pk,I+1,SliceCount,BufSize);
  If (Offset<0) Or (Offset>Offset1) Or (Offset1>BufSize) Then Break;
  Size:=Offset1-Offset;
  R34Si.EndMb:=R34MbW*R34MbH;
  R34MbNumLeft:=R34MbX+R34MbY*R34MbW-R34Si.Start;
  If I+1<SliceCount Then Begin
   Offset2:=R34SliceOffset(Pk,I+2,SliceCount,BufSize);
   If (Offset2<Offset1) Or (Offset2>BufSize) Then Break;
   R34InitGb(Offset1,BufSize-Offset1);
   If R34ParseSliceHeader(Si)<0 Then Size:=Offset2-Offset
   Else R34Si.EndMb:=Si.Start;
  End;
  Last:=R34DecodeSlice(R34Si.EndMb,Offset,Size);
  If Last<>0 Then Break;
 End;
 If (R34Cur>=0) And (Last<>0) Then Begin
  If R34Rv30 Then R34Rv30LoopFilter(R34MbH-1) Else R34Rv40LoopFilter(R34MbH-1);
  R34MbNumLeft:=0;
  If R34PictType=R34_PIC_B Then Begin R34OutPic:=R34Cur; R34DecodeFrame:=1; End
  Else If R34Last>=0 Then Begin R34OutPic:=R34Last; R34DecodeFrame:=1; End;
 End;
End;

{ fin de flux : sort la derniere image de reference }
Function R34Flush: LongInt;
Begin
 R34Flush:=0;
 If (R34Next>=0) And R34Pics[R34Next].Used Then Begin
  R34OutPic:=R34Next; R34Next:=-1; R34Flush:=1;
 End;
End;

{ ecrit l'image de sortie en I420 compact (W*H + 2*CW*CH) }
Procedure R34Pack(Dst: PEABuffer);
Var Y,CW,CH,P: LongInt;
Begin
 CW:=(R34W+1) Div 2; CH:=(R34H+1) Div 2;
 For Y:=0 To R34H-1 Do Move(R34Pics[R34OutPic].Pl[0]^[R34OrgY+Y*R34LS],Dst^[Y*
  R34W],R34W);
 P:=R34W*R34H;
 For Y:=0 To CH-1 Do Move(R34Pics[R34OutPic].Pl[1]^[R34OrgC+Y*R34CS],Dst^[P+Y*
  CW],CW);
 P:=P+CW*CH;
 For Y:=0 To CH-1 Do Move(R34Pics[R34OutPic].Pl[2]^[R34OrgC+Y*R34CS],Dst^[P+Y*
  CW],CW);
End;

{ 1 rv10, 2 rv20, 3 rv30, 4 rv40, 0 sinon }
Function RMVideoKind(Const Name: String): LongInt;
Var I: LongInt;
Begin
 RMVideoKind:=0;
 RMParse(Name);
 For I:=0 To RMNS-1 Do If RMSt[I].Kind=2 Then Begin
  If RMSt[I].Tag=$30315652 Then RMVideoKind:=1
  Else If RMSt[I].Tag=$30325652 Then RMVideoKind:=2
  Else If RMSt[I].Tag=$30335652 Then RMVideoKind:=3
  Else If RMSt[I].Tag=$30345652 Then RMVideoKind:=4;
  Break;
 End;
 RMFree;
End;

Procedure RVSetup(Kind,W,H: LongInt);
Begin
 H3Reset;
 H3RvMode:=Kind; H3Codec:=3+Kind;
 RVSub:=RVExt[4]*16777216+RVExt[5]*65536+RVExt[6]*256+RVExt[7];
 RVMajor:=RVSub Shr 28; RVMinor:=(RVSub Shr 20) And $FF; RVMicro:=(RVSub Shr 12)
  And $FF;
 RVRprMax:=RVExt[1] And 7;
 H3Wd:=W; H3Ht:=H;
 If (H3Wd<=0) Or (H3Ht<=0) Or (H3Wd>16384) Or (H3Ht>16384) Then Fail(
  'realvideo: dimensions invalides.');
 RVOrigW:=H3Wd; RVOrigH:=H3Ht;
 H3MbW:=(H3Wd+15) Div 16; H3MbH:=(H3Ht+15) Div 16; H3MbNum:=H3MbW*H3MbH;
 H3LongVec:=RVExt[3] And 1;
 RVLow:=True; H3Rv10Ver:=0; H3Obmc:=0;
 Case RVMajor Of
  1: Begin
      If RVMicro<>0 Then H3Rv10Ver:=3 Else H3Rv10Ver:=1;
      If RVMicro=2 Then H3Obmc:=1;
     End;
  2: If RVMinor>=2 Then RVLow:=False;
 Else Fail('realvideo: version non prise en charge.');
 End;
 H3AllocCtx;
 H3CurI:=-1; H3RefI:=-1; RVLastI:=-1; RVNextI:=-1; H3BwdI:=-1; H3MvList:=0;
  H3MvDir:=0; RVPend:=False; H3MbX:=0; H3MbY:=0; H3FirstLine:=0; H3ResyncX:=0;
  H3ResyncY:=0;
 RVFrameBuf:=Nil; RVFrameCap:=0;
End;

{ rv30 / rv40 : decodage des paquets RealMedia par le decodeur R34 }
Procedure DecodeRV34(Found: LongInt; Const Target: String; Mode: LongInt);
Var
 I,K,N,D,Fps,W,H,OW,OH,CW,CH,ExtN: LongInt; Begun: Boolean; Ext,Pic: PEABuffer;
  Got: LongInt;
Procedure Emit;
Begin
 If Not Begun Then Begin
  OW:=R34W; OH:=R34H; CW:=(OW+1) Div 2; CH:=(OH+1) Div 2;
  NVBegin(Mode,Target,OW,OH,7,N,D);
  NVSubX:=1; NVSubY:=1; NVCW:=CW; NVCH:=CH; NVYTag:='C420jpeg XYSCSS=420JPEG';
  GetMem(Pic,OW*OH+2*CW*CH+64);
  Begun:=True;
 End;
 { une image de dimensions differentes ne peut pas etre ecrite dans le meme flux
  : elle est ignoree }
 If (R34W<>OW) Or (R34H<>OH) Then Exit;
 R34Pack(Pic);
 NVEmit(Pic);
End;
Begin
 W:=RMSt[Found].W; H:=RMSt[Found].H;
 ExtN:=RMSt[Found].ExtLen; If ExtN>256 Then ExtN:=256; If ExtN<0 Then ExtN:=0;
 GetMem(Ext,ExtN+16); FillChar(Ext^,ExtN+16,0);
 For I:=0 To ExtN-1 Do Ext^[I]:=RMB(RMSt[Found].ExtPos+I);
 R34InitDecoder(RMSt[Found].Tag=$30335652,W,H,Ext,ExtN);
 Fps:=RMSt[Found].Fps;
 N:=Fps; D:=65536; If N<=0 Then Begin N:=25; D:=1; End; NVGcd(N,D);
 Begun:=False; NVVN:=0; NVVD:=0; Pic:=Nil; OW:=0; OH:=0;
 For K:=0 To RMNPk-1 Do If RMPkS^[K]=Found Then Begin
  Got:=R34DecodeFrame(PEABuffer(@RMArena^[RMPkOff^[K]]),RMPkLen^[K]);
  If Got=1 Then Begin
   Emit;
   If NVDone Then Break;
  End;
 End;
 If Not NVDone Then Begin
  If R34Flush=1 Then Emit;
 End;
 If NVLast<>Nil Then Begin FreeMem(NVLast,NVLastSize); NVLast:=Nil; End;
 If Not Begun Then Fail('realvideo: aucune image decodee.');
 CloseRead; If NVOpened Then CloseWrite;
 R34CloseDecoder;
 RMFree;
End;

Procedure DecodeRV(Const Source,Target: String; Mode: LongInt);
Var
 I,K,Found,N,D,Fps: LongInt; Begun: Boolean; Kind: LongInt; Pk: PEABuffer;
Begin
 RMParse(Source);
 Found:=-1;
 For I:=0 To RMNS-1 Do If RMSt[I].Kind=2 Then Begin Found:=I; Break; End;
 If Found<0 Then Fail('realvideo: aucun flux video.');
 If RMSt[Found].Tag=$30315652 Then Kind:=1 Else If RMSt[Found].Tag=$30325652
  Then Kind:=2
 Else If (RMSt[Found].Tag=$30335652) Or (RMSt[Found].Tag=$30345652) Then Begin
  DecodeRV34(Found,Target,Mode); Exit;
 End
 Else Fail('realvideo: seuls rv10, rv20, rv30 et rv40 sont pris en charge.');
 RVExtLen:=RMSt[Found].ExtLen; If RVExtLen>256 Then RVExtLen:=256;
 If RVExtLen<8 Then Fail('realvideo: extradata trop petit.');
 For I:=0 To RVExtLen-1 Do RVExt[I]:=RMB(RMSt[Found].ExtPos+I);
 RVSetup(Kind,RMSt[Found].W,RMSt[Found].H);
 Fps:=RMSt[Found].Fps;
 N:=Fps; D:=65536; If N<=0 Then Begin N:=25; D:=1; End; NVGcd(N,D);
 Begun:=False; NVVN:=0; NVVD:=0;
 For K:=0 To RMNPk-1 Do If RMPkS^[K]=Found Then Begin
  If RVFrame(PEABuffer(@RMArena^[RMPkOff^[K]]),RMPkLen^[K])=1 Then Begin
   If H3Pack Then Begin
    If Not Begun Then Begin H3BeginNV(Mode,Target,N,D); Begun:=True; End;
    NVEmit(H3OutBuf);
    If NVDone Then Break;
   End;
  End;
 End;
 If NVLast<>Nil Then Begin FreeMem(NVLast,NVLastSize); NVLast:=Nil; End;
 If Not Begun Then Fail('realvideo: aucune image decodee.');
 CloseRead; If NVOpened Then CloseWrite;
 RMFree;
End;

{ ---- Shorten (libavcodec/shorten.c) : fichiers .shn ---- }
Procedure DecodeShorten(Const Source,Target: String);
Const FnDiff0=0; FnDiff1=1; FnDiff2=2; FnDiff3=3; FnQuit=4; FnBlocksize=5;
 FnBitshift=6; FnQlpc=7; FnZero=8; FnVerbatim=9;
Var
 F: PEABuffer; Size: LongInt; Bp,BitsTot: Int64; Version,IType,Chans,Blocksize,
  Nmean,Nwrap,LpcqOff,Bitshift,CurChan,Rate,Bps,HeaderSize,I,J,Ch,Cmd,Len,Skip:
  LongInt;
 Swap,GotQuit: Boolean; Dc: Array[0..7] Of PALLong; Off: Array[0..7] Of PALLong;
  Coeffs: PALLong; Hdr: PEABuffer;
 ResSize,Coffset,PredOrder,Qshift,InitSum,Z: LongInt; Sum: Int64; Used: Boolean;
  Fixed: Array[0..3,0..2] Of LongInt;
 Bad: Boolean;
Function W32(X: Int64): LongInt;
Begin X:=X And $FFFFFFFF; If X>=$80000000 Then X:=X-$100000000; W32:=X; End;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-(((-V)+(Int64(1) Shl N)-1) Shr N);
 End;
Function GBit: LongInt;
Begin
 If Bp>=BitsTot Then Begin GBit:=0; Inc(Bp); Exit; End;
 GBit:=(F^[Bp Shr 3] Shr (7-(Bp And 7))) And 1; Inc(Bp);
End;
Function GBits(N: LongInt): Int64;
Var R: Int64; K: LongInt;
Begin R:=0; For K:=1 To N Do R:=R*2+GBit; GBits:=R; End;
{ get_ur_golomb_jpegls(k, INT_MAX, 0) ; retourne -1 si flux epuise }
Function UrGolomb(K: LongInt): Int64;
Var Cnt: Int64;
Begin
 Cnt:=0;
 While GBit=0 Do Begin
  If Bp>BitsTot Then Begin UrGolomb:=$FFFFFFFF; Exit; End;
  Inc(Cnt);
 End;
 UrGolomb:=(Cnt Shl K)+GBits(K);
End;
Function SrGolomb(K: LongInt): LongInt;
Var U: Int64;
Begin
 U:=UrGolomb(K+1) And $FFFFFFFF;
 If (U And 1)<>0 Then SrGolomb:=W32(Not (U Shr 1)) Else SrGolomb:=W32(U Shr 1);
End;
Function GetUint(K: LongInt): Int64;
Begin
 If Version<>0 Then Begin K:=UrGolomb(2) And $FFFFFFFF; If K>31 Then Begin
  GetUint:=-1; Exit; End; End;
 GetUint:=UrGolomb(K);
End;
Function Log2I(V: LongInt): LongInt;
Var R: LongInt;
Begin R:=0; While V>1 Do Begin V:=V Shr 1; Inc(R); End; Log2I:=R; End;
Begin
 NVLoad(Source,F,Size); BitsTot:=Size*8; Bp:=0;
 If (F^[0]<>$61) Or (F^[1]<>$6A) Or (F^[2]<>$6B) Or (F^[3]<>$67) Then Fail(
  'shorten: signature ajkg requise.');
 Bp:=32;
 Version:=GBits(8);
 LpcqOff:=0; Blocksize:=256; Nmean:=-1;
 IType:=GetUint(4);
 Chans:=GetUint(0);
 If (Chans<1) Or (Chans>8) Then Fail('shorten: nombre de canaux invalide.');
 I:=0;
 If Version>0 Then Begin
  Blocksize:=GetUint(Log2I(256));
  If (Blocksize<1) Or (Blocksize>65535) Then Fail(
   'shorten: taille de bloc invalide.');
  I:=GetUint(2); If (I<0) Or (I>1024) Then Fail('shorten: maxnlpc invalide.');
  Nmean:=GetUint(0); If (Nmean<0) Or (Nmean>32768) Then Fail(
   'shorten: nmean invalide.');
  Skip:=GetUint(1);
  If (Skip<0) Or (Skip>(BitsTot-Bp) Div 8) Then Fail(
   'shorten: skip_bytes invalide.');
  For J:=1 To Skip Do GBits(8);
 End;
 If I>3 Then Nwrap:=I Else Nwrap:=3;
 If Version>1 Then LpcqOff:=32;
 If UrGolomb(2)<>FnVerbatim Then Fail(
  'shorten: section verbatim initiale absente.');
 HeaderSize:=UrGolomb(5);
 If (HeaderSize>=16384) Or (HeaderSize<44) Then Fail(
  'shorten: taille d''en-tete invalide.');
 GetMem(Hdr,HeaderSize+16);
 For J:=0 To HeaderSize-1 Do Hdr^[J]:=UrGolomb(8) And 255;
 Swap:=False; Rate:=0; Bps:=0;
 If (Hdr^[0]=$52) And (Hdr^[1]=$49) And (Hdr^[2]=$46) And (Hdr^[3]=$46) Then
  Begin
  { RIFF/WAVE : recherche du bloc fmt }
  J:=12; Rate:=0;
  While J+8<=HeaderSize Do Begin
   Len:=Hdr^[J+4]+Hdr^[J+5]*256+Hdr^[J+6]*65536+Hdr^[J+7]*16777216;
   If (Hdr^[J]=$66) And (Hdr^[J+1]=$6D) And (Hdr^[J+2]=$74) And (Hdr^[J+3]=$20)
    Then Begin
    If Hdr^[J+8]+Hdr^[J+9]*256<>1 Then Fail('shorten: format WAVE non PCM.');
    Rate:=Hdr^[J+12]+Hdr^[J+13]*256+Hdr^[J+14]*65536+Hdr^[J+15]*16777216;
    Bps:=Hdr^[J+22]+Hdr^[J+23]*256;
    Break;
   End;
   Inc(J,8+Len);
  End;
  If Rate=0 Then Fail('shorten: bloc fmt absent.');
 End Else If (Hdr^[0]=$46) And (Hdr^[1]=$4F) And (Hdr^[2]=$52) And (Hdr^[3]=$4D)
  Then Begin
  Fail('shorten: en-tete AIFF non pris en charge.');
 End Else Fail('shorten: bit packing non pris en charge.');
 If (Bps<>8) And (Bps<>16) Then Fail(
  'shorten: profondeur non prise en charge.');
 If (IType<>2) And (IType<>3) And (IType<>5) Then Fail(
  'shorten: type audio inconnu.');
 FreeMem(Hdr);
 For Ch:=0 To Chans-1 Do Begin
  GetMem(Dc[Ch],(Blocksize+Nwrap+16)*4); FillChar(Dc[Ch]^,(Blocksize+Nwrap+16)*
   4,0);
  If Nmean>1 Then I:=Nmean Else I:=1;
  GetMem(Off[Ch],I*4);
  For J:=0 To I-1 Do If IType=2 Then Off[Ch]^[J]:=128 Else Off[Ch]^[J]:=0;
 End;
 GetMem(Coeffs,(Nwrap+4)*4);
 Fixed[0,0]:=0; Fixed[0,1]:=0; Fixed[0,2]:=0; Fixed[1,0]:=1; Fixed[1,1]:=0;
  Fixed[1,2]:=0;
 Fixed[2,0]:=2; Fixed[2,1]:=-1; Fixed[2,2]:=0; Fixed[3,0]:=3; Fixed[3,1]:=-3;
  Fixed[3,2]:=1;
 Bitshift:=0; CurChan:=0; GotQuit:=False;
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,Chans,0);
 Bad:=False;
 While Not GotQuit And (Not Bad) Do Begin
  If BitsTot-Bp<5 Then Break;
  Cmd:=UrGolomb(2);
  If Cmd>FnVerbatim Then Break;
  If Cmd In [FnQuit,FnBlocksize,FnBitshift,FnVerbatim] Then Begin
   Case Cmd Of
    FnVerbatim: Begin
     Len:=UrGolomb(5);
     If (Len<0) Or (Len>BitsTot-Bp) Then Begin Bad:=True; Break; End;
     For J:=1 To Len Do UrGolomb(8);
    End;
    FnBitshift: Begin
     J:=UrGolomb(2); If J>32 Then Begin Bad:=True; Break; End; Bitshift:=J;
    End;
    FnBlocksize: Begin
     J:=GetUint(Log2I(Blocksize));
     If (J>Blocksize) Or (J<1) Or (J>65535) Then Begin Bad:=True; Break; End;
     Blocksize:=J;
    End;
    FnQuit: GotQuit:=True;
   End;
   Continue;
  End;
  { commande audio }
  ResSize:=0;
  If Cmd<>FnZero Then Begin
   ResSize:=UrGolomb(3);
   If Version=0 Then Dec(ResSize);
   If (ResSize<0) Or (ResSize>30) Then Begin Bad:=True; Break; End;
  End;
  Ch:=CurChan;
  If Nmean=0 Then Coffset:=Off[Ch]^[0]
  Else Begin
   If Version<2 Then Sum:=0 Else Sum:=Nmean Div 2;
   For J:=0 To Nmean-1 Do Sum:=Sum+Off[Ch]^[J];
   Coffset:=W32(Sum);
   Coffset:=Coffset Div Nmean;
   If Version>=2 Then
    If Bitshift<>0 Then Coffset:=Sar(Sar(Coffset,Bitshift-1),1);
  End;
  If Cmd=FnZero Then Begin
   For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=0;
  End Else Begin
   If Cmd=FnQlpc Then Begin
    PredOrder:=UrGolomb(2);
    If (PredOrder<0) Or (PredOrder>Nwrap) Then Begin Bad:=True; Break; End;
    For J:=0 To PredOrder-1 Do Coeffs^[J]:=SrGolomb(5);
    Qshift:=5;
   End Else Begin
    PredOrder:=Cmd; Qshift:=0;
    For J:=0 To 2 Do Coeffs^[J]:=Fixed[PredOrder,J];
   End;
   If (Cmd=FnQlpc) And (Coffset<>0) Then
    For I:=-PredOrder To -1 Do Dc[Ch]^[Nwrap+I]:=W32(Int64(Dc[Ch]^[Nwrap+I])-(
     Int64(Coffset) And $FFFFFFFF));
   If PredOrder<>0 Then Begin If Cmd=FnQlpc Then InitSum:=LpcqOff Else InitSum:=
    0; End Else InitSum:=Coffset;
   For I:=0 To Blocksize-1 Do Begin
    Sum:=InitSum;
    For J:=0 To PredOrder-1 Do Sum:=W32(Sum+(Int64(Coeffs^[J])*(Int64(Dc[Ch]^[
     Nwrap+I-J-1]) And $FFFFFFFF)));
    Dc[Ch]^[Nwrap+I]:=W32(Int64(SrGolomb(ResSize))+(Sar(W32(Sum),Qshift) And
     $FFFFFFFF));
   End;
   If (Cmd=FnQlpc) And (Coffset<>0) Then
    For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=W32(Int64(Dc[Ch]^[Nwrap+I])+(
     Int64(Coffset) And $FFFFFFFF));
  End;
  { mise a jour des moyennes }
  If Nmean>0 Then Begin
   If Version<2 Then Sum:=0 Else Sum:=Blocksize Div 2;
   For I:=0 To Blocksize-1 Do Sum:=Sum+Dc[Ch]^[Nwrap+I];
   For I:=1 To Nmean-1 Do Off[Ch]^[I-1]:=Off[Ch]^[I];
   If Version<2 Then Off[Ch]^[Nmean-1]:=W32(Sum Div Blocksize)
   Else If Bitshift=32 Then Off[Ch]^[Nmean-1]:=0
   Else Off[Ch]^[Nmean-1]:=W32((Sum Div Blocksize)*(Int64(1) Shl Bitshift));
  End;
  For I:=-Nwrap To -1 Do Dc[Ch]^[Nwrap+I]:=Dc[Ch]^[Nwrap+I+Blocksize];
  { fix_bitshift }
  If Bitshift=32 Then Begin For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=0; End
  Else If Bitshift<>0 Then For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=W32(
   Int64(Dc[Ch]^[Nwrap+I])*(Int64(1) Shl Bitshift));
  Inc(CurChan);
  If CurChan=Chans Then Begin
   CurChan:=0;
   For I:=0 To Blocksize-1 Do
    For Ch:=0 To Chans-1 Do Begin
     Z:=Dc[Ch]^[Nwrap+I];
     If IType=2 Then Begin
      If Z<0 Then Z:=0 Else If Z>255 Then Z:=255;
      EAPut((Z-128)*256);
     End Else Begin
      If Z<-32768 Then Z:=-32768 Else If Z>32767 Then Z:=32767;
      EAPut(Z);
     End;
    End;
  End;
 End;
 EAFlush;
 If EAWritten=0 Then Fail('shorten: aucune donnee audio decodee.');
 ADPCMPatchHeader(Rate,Chans,EAWritten); CloseRead; CloseWrite;
End;

