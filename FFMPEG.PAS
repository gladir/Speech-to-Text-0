Var
 DCNBmp: Array[0..2] Of PEABuffer; DCNSize: LongInt; DCNPal: Array[0..255] Of
  LongInt;

Procedure DCNApplyDelta(Src,Dst: PEABuffer; Size: LongInt);
Var I: LongInt;
Begin
 For I:=0 To Size-1 Do Dst^[I]:=(Dst^[I]+Src^[I]) And 255;
End;

Function DCNHuffman(Src: PEABuffer; SrcSize: LongInt; Dst: PEABuffer; DstSize:
 LongInt): LongInt;
Var Tab: Array[0..14] Of Byte; Sp,Dp,H,B,I: LongInt;
Begin
 For I:=0 To 14 Do Tab[I]:=EAByte(Src,SrcSize,I);
 Sp:=15; Dp:=0;
 While Sp<SrcSize Do Begin
  H:=Src^[Sp]; Inc(Sp);
  If (H Shr 4)=15 Then Begin
   B:=H Shl 4; H:=EAByte(Src,SrcSize,Sp); Inc(Sp);
   Dst^[Dp]:=(B Or (H Shr 4)) And 255; Inc(Dp);
  End Else Begin Dst^[Dp]:=Tab[H Shr 4]; Inc(Dp); End;
  If Dp>=DstSize Then Break;
  H:=H And 15;
  If H=15 Then Begin Dst^[Dp]:=EAByte(Src,SrcSize,Sp); Inc(Sp); Inc(Dp); End
  Else Begin Dst^[Dp]:=Tab[H]; Inc(Dp); End;
  If Dp>=DstSize Then Break;
 End;
 DCNHuffman:=Dp;
End;

Function DCNLzss(Src: PEABuffer; SrcSize: LongInt; Dst: PEABuffer; DstSize:
 LongInt): LongInt;
Var Sp,Dp,Code,I,Cmd,Off,Sz: LongInt;
Begin
 Sp:=0; Dp:=0; DCNLzss:=0;
 While (Sp<SrcSize) And (Dp<DstSize) Do Begin
  Code:=Src^[Sp]; Inc(Sp);
  I:=0;
  While (I<8) And (Sp<SrcSize) And (Dp<DstSize) Do Begin
   If (Code And (1 Shl I))<>0 Then Begin Dst^[Dp]:=Src^[Sp]; Inc(Dp); Inc(Sp);
    End
   Else Begin
    Cmd:=EAByte(Src,SrcSize,Sp)+EAByte(Src,SrcSize,Sp+1)*256; Inc(Sp,2);
    Off:=Cmd Shr 4;
    If Dp<Off+1 Then Begin DCNLzss:=-1; Exit; End;
    Sz:=(Cmd And 15)+2;
    If Sz>DstSize-Dp Then Sz:=DstSize-Dp;
    While Sz>0 Do Begin Dst^[Dp]:=Dst^[Dp-Off-1]; Inc(Dp); Dec(Sz); End;
   End;
   Inc(I);
  End;
 End;
 If DstSize-Dp>DstSize-DstSize Div 10 Then DCNLzss:=-1;
End;

Function DCNRle(Src: PEABuffer; SrcSize: LongInt; Dst: PEABuffer; DstSize:
 LongInt): LongInt;
Var Sp,Dp,Code,Len,N,I: LongInt;
Begin
 Sp:=0; Dp:=0; DCNRle:=0;
 While (Sp+1<SrcSize) And (Dp<DstSize) Do Begin
  Code:=Src^[Sp]; Inc(Sp);
  If (Code And $80)<>0 Then Begin
   Len:=Code-$7F; N:=Len; If N>DstSize-Dp Then N:=DstSize-Dp;
   For I:=0 To N-1 Do Dst^[Dp+I]:=Src^[Sp];
   Inc(Sp);
  End Else Begin
   Len:=Code+1;
   If Len>SrcSize-Sp Then Begin DCNRle:=-1; Exit; End;
   N:=Len; If N>DstSize-Dp Then N:=DstSize-Dp; If N>SrcSize-Sp Then N:=SrcSize-
    Sp;
   For I:=0 To N-1 Do Dst^[Dp+I]:=Src^[Sp+I];
   Inc(Sp,Len);
  End;
  Inc(Dp,Len);
 End;
 If DstSize-Dp>DstSize-DstSize Div 10 Then DCNRle:=-1;
End;

{ decode un paquet video (palette_type, nb couleurs, type, donnees); Frame =
 image haut->bas; False si invalide }
Function DCNVideoPacket(Pk: PEABuffer; Size,W,H: LongInt; Frame: PEABuffer):
 Boolean;
Var PalType,PalCount,BmpType,BmpSize,I,Y,Res,Sp: LongInt; T: PEABuffer;
Begin
 DCNVideoPacket:=False;
 PalType:=EAByte(Pk,Size,0); PalCount:=EAByte(Pk,Size,1)+EAByte(Pk,Size,2)*256;
  BmpType:=EAByte(Pk,Size,3);
 Sp:=4; BmpSize:=Size-4;
 If PalType<>0 Then I:=4 Else I:=3;
 If BmpSize<PalCount*I Then Exit;
 If PalType=0 Then Begin
  If PalCount>256 Then Exit;
  For I:=0 To PalCount-1 Do Begin
   DCNPal[I]:=EAByte(Pk,Size,Sp)+EAByte(Pk,Size,Sp+1)*256+EAByte(Pk,Size,Sp+2)*
    65536; Inc(Sp,3); Dec(BmpSize,3);
  End;
 End Else Begin
  For I:=0 To PalCount-1 Do Begin
   DCNPal[EAByte(Pk,Size,Sp)]:=EAByte(Pk,Size,Sp+1)+EAByte(Pk,Size,Sp+2)*256+
    EAByte(Pk,Size,Sp+3)*65536; Inc(Sp,4); Dec(BmpSize,4);
  End;
 End;
 Res:=0;
 Case BmpType Of
  9: Begin Res:=DCNRle(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[0],DCNSize); If Res<0
   Then Exit; End;
  34: Begin Res:=DCNRle(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[0],DCNSize); If Res<0
   Then Exit; DCNApplyDelta(DCNBmp[1],DCNBmp[0],DCNSize); End;
  35: Begin
   BmpSize:=DCNHuffman(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[2],DCNSize);
   Res:=DCNRle(DCNBmp[2],BmpSize,DCNBmp[0],DCNSize); If Res<0 Then Exit;
  End;
  36: Begin
   BmpSize:=DCNHuffman(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[2],DCNSize);
   Res:=DCNRle(DCNBmp[2],BmpSize,DCNBmp[0],DCNSize); If Res<0 Then Exit;
   DCNApplyDelta(DCNBmp[1],DCNBmp[0],DCNSize);
  End;
  37: Begin
   Res:=DCNHuffman(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[0],DCNSize);
   If DCNSize-(95*DCNSize) Div 100>Res Then Exit;
  End;
  38: Begin Res:=DCNLzss(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[0],DCNSize); If
   Res<0 Then Exit; End;
  39: Begin Res:=DCNLzss(PEABuffer(@Pk^[Sp]),BmpSize,DCNBmp[0],DCNSize); If
   Res<0 Then Exit; DCNApplyDelta(DCNBmp[1],DCNBmp[0],DCNSize); End;
 End;
 For Y:=0 To H-1 Do Move(DCNBmp[0]^[Y*W],Frame^[(H-1-Y)*W],W);
 For I:=0 To 255 Do Begin NVPalB[I]:=DCNPal[I] And 255; NVPalG[I]:=(DCNPal[I]
  Shr 8) And 255; NVPalR[I]:=(DCNPal[I] Shr 16) And 255; End;
 T:=DCNBmp[0]; DCNBmp[0]:=DCNBmp[1]; DCNBmp[1]:=T;
 DCNVideoPacket:=True;
End;

{ Mode 3: audio vers WAV mono 22050 Hz; sinon video (PAL8) vers Y4M/PNG/BMP }
Procedure DecodeDSICin(Const Source,Target: String; Mode: LongInt);
Var
 F,Pk,Fr: PEABuffer; Size,W,H,Pos,VSz,ASz,PalCnt,PalType,PkSize,I,Delta,N:
  LongInt; First: Boolean;
Begin
 NVLoad(Source,F,Size);
 If (NVRL32(F,Size,0)<>$55AA0000) Or (NVRL32(F,Size,12)<>22050) Or (F^[16]<>16)
  Or (F^[17]<>0) Then Fail(
  'dsicin: en-tete CIN (22050 Hz, 16 bits, mono) requis.');
 W:=NVRL16(F,Size,8); H:=NVRL16(F,Size,10);
 If (Mode<>3) And ((W<1) Or (H<1) Or (W*H>16000000)) Then Fail(
  'dsicin: dimensions incorrectes.');
 Pos:=20; First:=True; Delta:=0; Fr:=Nil;
 If Mode=3 Then Begin EAReset; OpenWrite(Target); ADPCMWaveHeader(22050,1,0);
  End
 Else Begin
  DCNSize:=W*H; For I:=0 To 2 Do Begin GetMem(DCNBmp[I],DCNSize+64); FillChar(
   DCNBmp[I]^,DCNSize+64,0); End;
  FillChar(DCNPal,SizeOf(DCNPal),0); GetMem(Fr,DCNSize+64);
  NVBegin(Mode,Target,W,H,0,12,1); NVInitDup:=True;
 End;
 While Pos+16<=Size Do Begin
  If NVRL32(F,Size,Pos+12)<>LongInt($AA55AA55) Then Break;
  VSz:=NVRL32(F,Size,Pos+4); ASz:=NVRL32(F,Size,Pos+8);
  If (VSz<0) Or (ASz<0) Then Break;
  PalCnt:=NVRL16(F,Size,Pos+2); PalType:=0;
  If PalCnt>=32768 Then Begin PalCnt:=65536-PalCnt; PalType:=1; End;
  PkSize:=(PalType+3)*PalCnt+VSz;
  Inc(Pos,16);
  If PkSize>Size-Pos Then PkSize:=Size-Pos;
  If Mode<>3 Then Begin
   GetMem(Pk,PkSize+68); FillChar(Pk^,PkSize+68,0);
   Pk^[0]:=PalType; Pk^[1]:=PalCnt And 255; Pk^[2]:=PalCnt Shr 8; Pk^[3]:=F^[
    Pos-16];
   Move(F^[Pos],Pk^[4],PkSize);
   If DCNVideoPacket(Pk,4+PkSize,W,H,Fr) Then NVEmit(Fr) Else NVRepeat;
   FreeMem(Pk,PkSize+68);
   If NVDone Then Break;
  End;
  Inc(Pos,PkSize);
  If ASz>0 Then Begin
   N:=ASz; If N>Size-Pos Then N:=Size-Pos;
   If N<=0 Then Break;
   If Mode=3 Then Begin
    I:=0;
    If First Then Begin
     First:=False;
     If N>=2 Then Begin
      Delta:=F^[Pos]+F^[Pos+1]*256; If Delta>=32768 Then Dec(Delta,65536);
      EAPut(Delta); I:=2;
     End Else I:=N;
    End;
    While I<N Do Begin
     Delta:=Delta+DCINDelta[F^[Pos+I]];
     If Delta>32767 Then Delta:=32767 Else If Delta<-32768 Then Delta:=-32768;
     EAPut(Delta); Inc(I);
    End;
   End;
   Inc(Pos,N);
  End;
 End;
 If Mode=3 Then Begin
  EAFlush; FreeMem(F,Size+64);
  If EAWritten=0 Then Fail('dsicin: aucune donnee audio.');
  ADPCMPatchHeader(22050,1,EAWritten); CloseRead; CloseWrite;
 End Else Begin
  FreeMem(F,Size+64); FreeMem(Fr,DCNSize+64);
  NVFinish('dsicin');
 End;
End;


{ ---- Sous-titres bitmap: evenements, PNG, manifeste .psub ---- }
Type
 TXSRect=Record X,Y,W,H,NCol: LongInt; Pal: Array[0..255] Of LongInt; Bmp:
  PEABuffer; End;
 PXSRect=^TXSRect;
 TXSEv=Record
  T0,T1: Int64; NR: LongInt; Forced: Boolean; Rc: Array[0..15] Of PXSRect;
 End;
 PXSEv=^TXSEv;
Var
 XSEvs: Array[0..19999] Of PXSEv; XSN: LongInt; XSW,XSH: LongInt; XSFromPng:
  Boolean;

Function XSPos(Const Sub,S: String): LongInt;
Begin XSPos:=Pos(Sub,S); End;

Function XSTrim(S: String): String;
Begin
 While (S<>'') And ((S[1]=' ') Or (S[1]=#9)) Do Delete(S,1,1);
 While (S<>'') And ((S[Length(S)]=' ') Or (S[Length(S)]=#9)) Do Delete(S,Length(
  S),1);
 XSTrim:=S;
End;

Procedure XSFreeRect(R: PXSRect);
Begin
 If R=Nil Then Exit;
 If R^.Bmp<>Nil Then FreeMem(R^.Bmp,R^.W*R^.H+64);
 Dispose(R);
End;

Procedure XSFreeEvent(E: PXSEv);
Var I: LongInt;
Begin
 If E=Nil Then Exit;
 For I:=0 To E^.NR-1 Do XSFreeRect(E^.Rc[I]);
 Dispose(E);
End;

Procedure XSReset;
Var I: LongInt;
Begin
 For I:=0 To XSN-1 Do Begin XSFreeEvent(XSEvs[I]); XSEvs[I]:=Nil; End;
 XSN:=0;
End;

Function XSNew: PXSEv;
Var E: PXSEv;
Begin
 If XSN>=20000 Then Fail('sous-titres: trop d''evenements (20000 maximum).');
 New(E); FillChar(E^,SizeOf(E^),0); XSEvs[XSN]:=E; Inc(XSN); XSNew:=E;
End;

{ retire le dernier evenement cree (rejet) }
Procedure XSDropLast;
Begin
 If XSN>0 Then Begin XSFreeEvent(XSEvs[XSN-1]); XSEvs[XSN-1]:=Nil; Dec(XSN);
  End;
End;

Function XSAddRect(E: PXSEv; X,Y,W,H: LongInt): PXSRect;
Var R: PXSRect;
Begin
 If E^.NR>=16 Then Fail('sous-titres: trop de rectangles.');
 New(R); FillChar(R^,SizeOf(R^),0); R^.X:=X; R^.Y:=Y; R^.W:=W; R^.H:=H;
 GetMem(R^.Bmp,W*H+64); FillChar(R^.Bmp^,W*H+64,0);
 E^.Rc[E^.NR]:=R; Inc(E^.NR); XSAddRect:=R;
End;

Function XSTimeStr(T: Int64): String;
Var H,M,S,Ms: LongInt; A,B,C,D: String;
Begin
 If T<0 Then T:=0;
 Ms:=T Mod 1000; T:=T Div 1000; S:=T Mod 60; T:=T Div 60; M:=T Mod 60; H:=T Div
  60;
 Str(H:2,A); Str(M:2,B); Str(S:2,C); Str(Ms:3,D);
 While Pos(' ',A)>0 Do A[Pos(' ',A)]:='0';
 While Pos(' ',B)>0 Do B[Pos(' ',B)]:='0';
 While Pos(' ',C)>0 Do C[Pos(' ',C)]:='0';
 While Pos(' ',D)>0 Do D[Pos(' ',D)]:='0';
 XSTimeStr:=A+':'+B+':'+C+'.'+D;
End;

{ lit hh:mm:ss.mmm }
Function XSParseTime(Const S: String; Var T: Int64): Boolean;
Var P: LongInt; V: Array[0..3] Of LongInt; I,K,Code: LongInt; Part: String;
Begin
 XSParseTime:=False; Part:=''; K:=0;
 For I:=1 To Length(S)+1 Do Begin
  If (I>Length(S)) Or (S[I]=':') Or (S[I]='.') Then Begin
   If K>3 Then Exit;
   Val(Part,V[K],Code); If (Code<>0) Or (V[K]<0) Then Exit;
   Inc(K); Part:='';
  End Else Part:=Part+S[I];
 End;
 If K<>4 Then Exit;
 T:=((Int64(V[0])*60+V[1])*60+V[2])*1000+V[3]; P:=0;
 XSParseTime:=True;
End;

{ ecrit une image PNG RGBA pleine toile pour l'evenement E (comme sub2video de
 ffmpeg 6.1: un rectangle qui deborde est ignore) }
Procedure XSWriteEventPNG(E: PXSEv; Const Name: String);
Var Cv: PEABuffer; X,Y,W,H,Sx,Sy,K: LongInt; P: LongInt; R: PXSRect;
Begin
 W:=XSW; H:=XSH;
 GetMem(Cv,W*H*4+64); FillChar(Cv^,W*H*4+64,0);
 For K:=0 To E^.NR-1 Do Begin
  R:=E^.Rc[K];
  If (R^.X<0) Or (R^.X+R^.W>W) Or (R^.Y<0) Or (R^.Y+R^.H>H) Then Continue;
  For Sy:=0 To R^.H-1 Do For Sx:=0 To R^.W-1 Do Begin
   P:=R^.Pal[R^.Bmp^[Sy*R^.W+Sx]];
   X:=((R^.Y+Sy)*W+R^.X+Sx)*4;
   Cv^[X]:=(P Shr 16) And 255; Cv^[X+1]:=(P Shr 8) And 255; Cv^[X+2]:=P And 255;
    Cv^[X+3]:=(P Shr 24) And 255;
  End;
 End;
 NVW:=W; NVH:=H; NVTarget:=Name; NVFmt:=3;
 NVWritePNG(Cv,4);
 FreeMem(Cv,W*H*4+64);
End;

{ ---- lecture PNG: 8 bits gris/RGB/RGBA/palette, 1..8 bits palette; retourne
 RGBA W*H*4 ---- }
Procedure XSReadPNG(Const Name: String; Var W,H: LongInt; Var Rgba: PEABuffer);
Var
 F,Idat,Raw: PEABuffer; Size,Pos,Len,Cl,IdLen,Bd,Ct,Il,Bpp,RowB,I,X,Y,Res,
  OutLen,Fl,A,B,C,Pa,Pb,Pc,Pp,Q: LongInt;
 Pal: Array[0..255] Of LongInt; Tr: Array[0..255] Of Byte; Tag: String[4];
  HasTr: Boolean; V: LongInt;
 Cur,Prv: PEABuffer;
Begin
 NVLoad(Name,F,Size); CloseRead;
 If (F^[0]<>137) Or (F^[1]<>80) Or (F^[2]<>78) Or (F^[3]<>71) Then Fail(
  'PNG: signature requise: '+Name);
 Pos:=8; IdLen:=0; W:=0; H:=0; Bd:=0; Ct:=0; Il:=0; FillChar(Pal,SizeOf(Pal),0);
  FillChar(Tr,SizeOf(Tr),255); HasTr:=False;
 GetMem(Idat,Size+64);
 While Pos+12<=Size Do Begin
  Len:=NVRL32(F,Size,Pos); Len:=((Len And $FF) Shl 24) Or ((Len And $FF00) Shl
   8) Or ((Len Shr 8) And $FF00) Or ((Len Shr 24) And $FF);
  Tag:=Chr(F^[Pos+4])+Chr(F^[Pos+5])+Chr(F^[Pos+6])+Chr(F^[Pos+7]);
  If (Len<0) Or (Pos+12+Len>Size) Then Break;
  If Tag='IHDR' Then Begin
   W:=F^[Pos+8]*16777216+F^[Pos+9]*65536+F^[Pos+10]*256+F^[Pos+11];
   H:=F^[Pos+12]*16777216+F^[Pos+13]*65536+F^[Pos+14]*256+F^[Pos+15];
   Bd:=F^[Pos+16]; Ct:=F^[Pos+17]; Il:=F^[Pos+20];
  End Else If Tag='PLTE' Then Begin
   For I:=0 To (Len Div 3)-1 Do If I<256 Then Pal[I]:=(F^[Pos+8+I*3] Shl 16) Or
    (F^[Pos+9+I*3] Shl 8) Or F^[Pos+10+I*3];
  End Else If Tag='tRNS' Then Begin
   HasTr:=True; For I:=0 To Len-1 Do If I<256 Then Tr[I]:=F^[Pos+8+I];
  End Else If Tag='IDAT' Then Begin
   Move(F^[Pos+8],Idat^[IdLen],Len); Inc(IdLen,Len);
  End Else If Tag='IEND' Then Break;
  Inc(Pos,12+Len);
 End;
 If (W<1) Or (H<1) Or (W>8192) Or (H>8192) Then Fail(
  'PNG: dimensions incorrectes: '+Name);
 If Il<>0 Then Fail('PNG entrelace non pris en charge: '+Name);
 Case Ct Of
  0: Begin Q:=1; If Bd<>8 Then Fail('PNG: gris 8 bits requis: '+Name); End;
  2: Begin Q:=3; If Bd<>8 Then Fail('PNG: RGB 8 bits requis: '+Name); End;
  3: Begin Q:=1; If (Bd<>1) And (Bd<>2) And (Bd<>4) And (Bd<>8) Then Fail(
   'PNG: profondeur de palette incorrecte: '+Name); End;
  4: Begin Q:=2; If Bd<>8 Then Fail('PNG: gris+alpha 8 bits requis: '+Name);
   End;
  6: Begin Q:=4; If Bd<>8 Then Fail('PNG: RGBA 8 bits requis: '+Name); End;
  Else Fail('PNG: type de couleur non pris en charge: '+Name);
 End;
 If Ct=3 Then RowB:=(W*Bd+7) Div 8 Else RowB:=W*Q;
 Bpp:=Q; If Ct=3 Then Bpp:=1;
 GetMem(Raw,H*(RowB+1)+64);
 Res:=NVInflate(Idat,IdLen,Raw,H*(RowB+1),OutLen);
 If (Res<>0) Or (OutLen<H*(RowB+1)) Then Fail(
  'PNG: donnees compressees incorrectes: '+Name);
 FreeMem(Idat,Size+64);
 { defiltrage }
 GetMem(Prv,RowB+64); FillChar(Prv^,RowB+64,0);
 For Y:=0 To H-1 Do Begin
  Cur:=PEABuffer(@Raw^[Y*(RowB+1)+1]); Fl:=Raw^[Y*(RowB+1)];
  For X:=0 To RowB-1 Do Begin
   If X>=Bpp Then A:=Cur^[X-Bpp] Else A:=0;
   B:=Prv^[X]; If X>=Bpp Then C:=Prv^[X-Bpp] Else C:=0;
   Case Fl Of
    0: V:=Cur^[X];
    1: V:=Cur^[X]+A;
    2: V:=Cur^[X]+B;
    3: V:=Cur^[X]+(A+B) Div 2;
    4: Begin
     Pp:=A+B-C; Pa:=Abs(Pp-A); Pb:=Abs(Pp-B); Pc:=Abs(Pp-C);
     If (Pa<=Pb) And (Pa<=Pc) Then V:=Cur^[X]+A Else If Pb<=Pc Then V:=Cur^[X]+B
      Else V:=Cur^[X]+C;
    End;
    Else Fail('PNG: filtre incorrect: '+Name);
   End;
   Cur^[X]:=V And 255;
  End;
  Move(Cur^,Prv^,RowB);
 End;
 FreeMem(Prv,RowB+64);
 GetMem(Rgba,W*H*4+64);
 For Y:=0 To H-1 Do Begin
  Cur:=PEABuffer(@Raw^[Y*(RowB+1)+1]);
  For X:=0 To W-1 Do Begin
   I:=(Y*W+X)*4;
   Case Ct Of
    0: Begin Rgba^[I]:=Cur^[X]; Rgba^[I+1]:=Cur^[X]; Rgba^[I+2]:=Cur^[X]; Rgba^[
     I+3]:=255; End;
    2: Begin Rgba^[I]:=Cur^[X*3]; Rgba^[I+1]:=Cur^[X*3+1]; Rgba^[I+2]:=Cur^[X*3+
     2]; Rgba^[I+3]:=255; End;
    3: Begin
     Case Bd Of
      8: V:=Cur^[X];
      4: V:=(Cur^[X Shr 1] Shr (4-4*(X And 1))) And 15;
      2: V:=(Cur^[X Shr 2] Shr (6-2*(X And 3))) And 3;
      Else V:=(Cur^[X Shr 3] Shr (7-(X And 7))) And 1;
     End;
     Rgba^[I]:=(Pal[V] Shr 16) And 255; Rgba^[I+1]:=(Pal[V] Shr 8) And 255;
      Rgba^[I+2]:=Pal[V] And 255;
     If HasTr Then Rgba^[I+3]:=Tr[V] Else Rgba^[I+3]:=255;
    End;
    4: Begin Rgba^[I]:=Cur^[X*2]; Rgba^[I+1]:=Cur^[X*2]; Rgba^[I+2]:=Cur^[X*2];
     Rgba^[I+3]:=Cur^[X*2+1]; End;
    Else Move(Cur^[X*4],Rgba^[I],4);
   End;
  End;
 End;
 FreeMem(Raw,H*(RowB+1)+64); FreeMem(F,Size+64);
End;

{ image RGBA -> evenement bitmap (rectangle englobant des pixels non
 transparents, palette <= 256 couleurs) }
Function XSEventFromRGBA(Rgba: PEABuffer; W,H: LongInt; T0,T1: Int64): PXSEv;
Var
 X0,Y0,X1,Y1,X,Y,I,J,Sh,N: LongInt; E: PXSEv; R: PXSRect; Keys: Array[0..255] Of
  LongInt; Found: Boolean;
 Px: LongInt;
Begin
 X0:=W; Y0:=H; X1:=-1; Y1:=-1;
 For Y:=0 To H-1 Do For X:=0 To W-1 Do
  If Rgba^[(Y*W+X)*4+3]<>0 Then Begin
   If X<X0 Then X0:=X; If X>X1 Then X1:=X; If Y<Y0 Then Y0:=Y; If Y>Y1 Then Y1:=
    Y;
  End;
 If X1<0 Then Begin XSEventFromRGBA:=Nil; Exit; End;
 E:=XSNew; E^.T0:=T0; E^.T1:=T1;
 R:=XSAddRect(E,X0,Y0,X1-X0+1,Y1-Y0+1);
 { quantification: premiere profondeur de bits qui donne <= 256 couleurs
  distinctes }
 N:=0; Found:=False;
 For Sh:=0 To 7 Do Begin
  N:=0; Found:=True;
  For Y:=0 To R^.H-1 Do Begin
   For X:=0 To R^.W-1 Do Begin
    I:=((Y0+Y)*W+X0+X)*4;
    Px:=((Rgba^[I+3] Shr Sh) Shl 24) Or ((Rgba^[I] Shr Sh) Shl 16) Or ((Rgba^[I+
     1] Shr Sh) Shl 8) Or (Rgba^[I+2] Shr Sh);
    If Rgba^[I+3]=0 Then Px:=0;
    J:=0; While (J<N) And (Keys[J]<>Px) Do Inc(J);
    If J=N Then Begin
     If N>=256 Then Begin Found:=False; Break; End;
     Keys[N]:=Px; Inc(N);
    End;
   End;
   If Not Found Then Break;
  End;
  If Found Then Break;
 End;
 If Not Found Then Fail('sous-titre: image trop riche en couleurs.');
 { l'indice 0 est la couleur transparente quand il y en a une (fond des regions
  DVB) }
 For J:=1 To N-1 Do If Keys[J]=0 Then Begin Keys[J]:=Keys[0]; Keys[0]:=0; Break;
  End;
 R^.NCol:=N;
 For J:=0 To N-1 Do R^.Pal[J]:=0;
 For Y:=0 To R^.H-1 Do For X:=0 To R^.W-1 Do Begin
  I:=((Y0+Y)*W+X0+X)*4;
  Px:=((Rgba^[I+3] Shr Sh) Shl 24) Or ((Rgba^[I] Shr Sh) Shl 16) Or ((Rgba^[I+1]
   Shr Sh) Shl 8) Or (Rgba^[I+2] Shr Sh);
  If Rgba^[I+3]=0 Then Px:=0;
  J:=0; While Keys[J]<>Px Do Inc(J);
  R^.Bmp^[Y*R^.W+X]:=J;
  If R^.Pal[J]=0 Then Begin
   If Rgba^[I+3]=0 Then R^.Pal[J]:=0
   Else R^.Pal[J]:=(Rgba^[I+3] Shl 24) Or (Rgba^[I] Shl 16) Or (Rgba^[I+1] Shl
    8) Or Rgba^[I+2];
  End;
 End;
 XSEventFromRGBA:=E;
End;

{ ---- DVD subtitles: decodeur (libavcodec/dvdsubdec.c) ---- }
Var
 DSUPal: Array[0..15] Of LongInt; DSUHasPal: Boolean; DSUColormap: Array[0..3]
  Of Byte; DSUAlpha: Array[0..255] Of Byte;
 DSUUsed: Array[0..255] Of Byte; DSUBuf: Array[0..65535] Of Byte; DSUBufSize:
  LongInt;

Function DSUClip(V: LongInt): LongInt;
Begin If V<0 Then DSUClip:=0 Else If V>255 Then DSUClip:=255 Else DSUClip:=V;
 End;

{ YUV (BT.601 limite) -> RGB comme libavcodec/colorspace.h }
Function DSUYuvToRgb(Y1,Cb1,Cr1: LongInt): LongInt;
Var Cb,Cr,Radd,Gadd,Badd,Y,R,G,B: LongInt;
Begin
 Cb:=Cb1-128; Cr:=Cr1-128;
 Radd:=1634*Cr+512;
 Gadd:=-401*Cb-832*Cr+512;
 Badd:=2066*Cb+512;
 Y:=(Y1-16)*1192;
 R:=DSUClip(AVSar(Y+Radd,10)); G:=DSUClip(AVSar(Y+Gadd,10)); B:=DSUClip(AVSar(Y+
  Badd,10));
 DSUYuvToRgb:=(R Shl 16) Or (G Shl 8) Or B;
End;

Procedure DSUParseExtra(Const Txt: String);
Var P,K,Code,W,H: LongInt; Line,Tok: String; I: LongInt; V: Int64;
Begin
 P:=1;
 While P<=Length(Txt) Do Begin
  K:=P; While (K<=Length(Txt)) And (Txt[K]<>#10) And (Txt[K]<>#13) Do Inc(K);
  Line:=Copy(Txt,P,K-P); P:=K+1;
  If Copy(Line,1,8)='palette:' Then Begin
   DSUHasPal:=True; Line:=Copy(Line,9,255);
   For I:=0 To 15 Do Begin
    While (Line<>'') And ((Line[1]=' ') Or (Line[1]=',') Or (Line[1]=#9)) Do
     Delete(Line,1,1);
    Tok:=''; While (Line<>'') And (Line[1] In ['0'..'9','a'..'f','A'..'F']) Do
     Begin Tok:=Tok+Line[1]; Delete(Line,1,1); End;
    If Tok='' Then V:=0 Else Val('$'+Tok,V,Code);
    DSUPal[I]:=V And $FFFFFFFF;
   End;
  End Else If Copy(Line,1,5)='size:' Then Begin
   Line:=Copy(Line,6,255); While (Line<>'') And (Line[1]=' ') Do Delete(Line,1,
    1);
   K:=Pos('x',Line);
   If K>0 Then Begin
    Val(Copy(Line,1,K-1),W,Code);
    If Code=0 Then Begin
     Tok:=Copy(Line,K+1,20); I:=1; While (I<=Length(Tok)) And (Tok[I] In [
      '0'..'9']) Do Inc(I);
     Val(Copy(Tok,1,I-1),H,Code);
     If (Code=0) And (W>0) And (H>0) Then Begin XSW:=W; XSH:=H; End;
    End;
   End;
  End;
 End;
End;

Function DSURl16(B: PEABuffer; Size,At: LongInt): LongInt;
Begin DSURl16:=EAByte(B,Size,At)*256+EAByte(B,Size,At+1); End;
Function DSURl32(B: PEABuffer; Size,At: LongInt): Int64;
Begin DSURl32:=Int64(DSURl16(B,Size,At))*65536+DSURl16(B,Size,At+2); End;

Var DSUBitPos,DSUBitLen: LongInt; DSUBits: PEABuffer; DSUBitsSize: LongInt;
Function DSUGetBits(N: LongInt): LongInt;
Var V,I,P: LongInt;
Begin
 V:=0;
 For I:=1 To N Do Begin
  P:=DSUBitPos Shr 3;
  V:=(V Shl 1) Or ((EAByte(DSUBits,DSUBitsSize,P) Shr (7-(DSUBitPos And 7))) And
   1);
  Inc(DSUBitPos);
 End;
 DSUGetBits:=V;
End;

Function DSUDecodeRle(Bitmap: PEABuffer; Linesize,W,H: LongInt; Buf: PEABuffer;
 BufSize,Start: LongInt; Is8: Boolean): Boolean;
Var X,Y,Len,Color,V,T,HasRun: LongInt; D: LongInt;
Begin
 DSUDecodeRle:=False;
 If Start>=BufSize Then Exit;
 If (W<=0) Or (H<=0) Then Exit;
 DSUBits:=PEABuffer(@Buf^[Start]); DSUBitsSize:=BufSize-Start; DSUBitLen:=(
  BufSize-Start)*8; DSUBitPos:=0;
 X:=0; Y:=0; D:=0;
 While True Do Begin
  If DSUBitPos>DSUBitLen Then Exit;
  If Is8 Then Begin
   HasRun:=DSUGetBits(1);
   If DSUGetBits(1)<>0 Then Color:=DSUGetBits(8) Else Color:=DSUGetBits(2);
   If HasRun<>0 Then Begin
    If DSUGetBits(1)<>0 Then Begin
     Len:=DSUGetBits(7);
     If Len=0 Then Len:=MaxLongInt Else Inc(Len,9);
    End Else Len:=DSUGetBits(3)+2;
   End Else Len:=1;
  End Else Begin
   V:=0; T:=1;
   While (V<T) And (T<=$40) Do Begin V:=(V Shl 4) Or DSUGetBits(4); T:=T Shl 2;
    End;
   Color:=V And 3;
   If V<4 Then Len:=MaxLongInt Else Len:=V Shr 2;
  End;
  If (Len<>MaxLongInt) And (Len>W-X) Then Exit;
  If Len>W-X Then Len:=W-X;
  FillChar(Bitmap^[D+X],Len,Color);
  DSUUsed[Color]:=1;
  Inc(X,Len);
  If X>=W Then Begin
   Inc(Y);
   If Y>=H Then Break;
   Inc(D,Linesize); X:=0;
   DSUBitPos:=(DSUBitPos+7) And Not 7;
  End;
 End;
 DSUDecodeRle:=True;
End;

Procedure DSUGuessPalette(Var Rgba: Array Of LongInt);
Const LevelMap: Array[0..3,0..3] Of Byte=((255,0,0,0),(0,255,0,0),(0,128,255,0),
 (0,85,170,255));
Var ColorUsed: Array[0..15] Of Byte; Nb,I,J,Level,R,G,B: LongInt;
Begin
 If DSUHasPal Then Begin
  For I:=0 To 3 Do Rgba[I]:=(DSUPal[DSUColormap[I]] And $FFFFFF) Or (DSUAlpha[
   I]*17 Shl 24);
  Exit;
 End;
 For I:=0 To 3 Do Rgba[I]:=0;
 FillChar(ColorUsed,SizeOf(ColorUsed),0); Nb:=0;
 For I:=0 To 3 Do If (DSUAlpha[I]<>0) And (ColorUsed[DSUColormap[I]]=0) Then
  Begin ColorUsed[DSUColormap[I]]:=1; Inc(Nb); End;
 If Nb=0 Then Exit;
 J:=0; FillChar(ColorUsed,SizeOf(ColorUsed),0);
 For I:=0 To 3 Do If DSUAlpha[I]<>0 Then Begin
  If ColorUsed[DSUColormap[I]]=0 Then Begin
   Level:=LevelMap[Nb-1,J];
   R:=(255*Level) Shr 8; G:=R; B:=R;
   Rgba[I]:=B Or (G Shl 8) Or (R Shl 16) Or (DSUAlpha[I]*17 Shl 24);
   ColorUsed[DSUColormap[I]]:=I+1; Inc(J);
  End Else Rgba[I]:=(Rgba[ColorUsed[DSUColormap[I]]-1] And $FFFFFF) Or (
   DSUAlpha[I]*17 Shl 24);
 End;
End;

{ retourne: -1 invalide, -2 (EAGAIN), 0/1 = is_menu avec un evenement dans E }
Function DSUDecodeCmds(Buf: PEABuffer; BufSize: LongInt; E: PXSEv): LongInt;
Var
 CmdPos,Pos,Cmd,X1,Y1,X2,Y2,NextCmd,OffSz,I,Date: LongInt; Big,Is8,Menu:
  Boolean; Offset1,Offset2,Size: Int64;
 YuvPal: LongInt; W,H,Y: LongInt; Bm: PEABuffer; HaveRect: Boolean; Fail1:
  Boolean; R: PXSRect;
 Pal4: Array[0..3] Of LongInt; Ok: Boolean;
Begin
 DSUDecodeCmds:=-1;
 If BufSize<10 Then Exit;
 Is8:=False; Menu:=False; YuvPal:=-1; HaveRect:=False; Fail1:=False;
 If DSURl16(Buf,BufSize,0)=0 Then Begin Big:=True; OffSz:=4; CmdPos:=6; End Else
  Begin Big:=False; OffSz:=2; CmdPos:=2; End;
 If Big Then Size:=DSURl32(Buf,BufSize,2) Else Size:=DSURl16(Buf,BufSize,0);
 If Big Then CmdPos:=DSURl32(Buf,BufSize,6) Else CmdPos:=DSURl16(Buf,BufSize,2);
 If (CmdPos<0) Or (CmdPos>BufSize-2-OffSz) Then Begin
  If CmdPos>Size Then DSUDecodeCmds:=-3 Else DSUDecodeCmds:=-2;
  Exit;
 End;
 E^.T0:=0; E^.T1:=0;
 While (CmdPos>0) And (CmdPos<BufSize-2-OffSz) Do Begin
  Date:=DSURl16(Buf,BufSize,CmdPos);
  If Big Then NextCmd:=DSURl32(Buf,BufSize,CmdPos+2) Else NextCmd:=DSURl16(Buf,
   BufSize,CmdPos+2);
  Pos:=CmdPos+2+OffSz; Offset1:=-1; Offset2:=-1; X1:=0; Y1:=0; X2:=0; Y2:=0;
  While Pos<BufSize Do Begin
   Cmd:=Buf^[Pos]; Inc(Pos);
   Case Cmd Of
    $00: Menu:=True;
    $01: E^.T0:=(Int64(Date) Shl 10) Div 90;
    $02: E^.T1:=(Int64(Date) Shl 10) Div 90;
    $03: Begin
     If BufSize-Pos<2 Then Begin Fail1:=True; Break; End;
     DSUColormap[3]:=Buf^[Pos] Shr 4; DSUColormap[2]:=Buf^[Pos] And 15;
      DSUColormap[1]:=Buf^[Pos+1] Shr 4; DSUColormap[0]:=Buf^[Pos+1] And 15;
     Inc(Pos,2);
    End;
    $04: Begin
     If BufSize-Pos<2 Then Begin Fail1:=True; Break; End;
     DSUAlpha[3]:=Buf^[Pos] Shr 4; DSUAlpha[2]:=Buf^[Pos] And 15; DSUAlpha[1]:=
      Buf^[Pos+1] Shr 4; DSUAlpha[0]:=Buf^[Pos+1] And 15;
     Inc(Pos,2);
    End;
    $05,$85: Begin
     If BufSize-Pos<6 Then Begin Fail1:=True; Break; End;
     X1:=(Buf^[Pos] Shl 4) Or (Buf^[Pos+1] Shr 4); X2:=((Buf^[Pos+1] And 15) Shl
      8) Or Buf^[Pos+2];
     Y1:=(Buf^[Pos+3] Shl 4) Or (Buf^[Pos+4] Shr 4); Y2:=((Buf^[Pos+4] And 15)
      Shl 8) Or Buf^[Pos+5];
     If (Cmd And $80)<>0 Then Is8:=True;
     Inc(Pos,6);
    End;
    $06: Begin
     If BufSize-Pos<4 Then Begin Fail1:=True; Break; End;
     Offset1:=DSURl16(Buf,BufSize,Pos); Offset2:=DSURl16(Buf,BufSize,Pos+2);
      Inc(Pos,4);
    End;
    $86: Begin
     If BufSize-Pos<8 Then Begin Fail1:=True; Break; End;
     Offset1:=DSURl32(Buf,BufSize,Pos); Offset2:=DSURl32(Buf,BufSize,Pos+4);
      Inc(Pos,8);
    End;
    $83: Begin
     If BufSize-Pos<768 Then Begin Fail1:=True; Break; End;
     YuvPal:=Pos; Inc(Pos,768);
    End;
    $84: Begin
     If BufSize-Pos<256 Then Begin Fail1:=True; Break; End;
     For I:=0 To 255 Do DSUAlpha[I]:=255-Buf^[Pos+I];
     Inc(Pos,256);
    End;
    $FF: Break;
    Else Break;
   End;
  End;
  If Fail1 Then Exit;
  If (Offset1>=BufSize) Or (Offset2>=BufSize) Then Exit;
  If (Offset1>=0) And (Offset2>=0) Then Begin
   W:=X2-X1+1; If W<0 Then W:=0;
   H:=Y2-Y1+1; If H<0 Then H:=0;
   If (W>0) And (H>1) Then Begin
    If E^.NR>0 Then Begin XSFreeRect(E^.Rc[0]); E^.Rc[0]:=Nil; E^.NR:=0; End;
    FillChar(DSUUsed,SizeOf(DSUUsed),0);
    R:=XSAddRect(E,X1,Y1,W,H); HaveRect:=True;
    Bm:=R^.Bmp;
    If Not DSUDecodeRle(Bm,W*2,W,(H+1) Div 2,Buf,BufSize,Offset1,Is8) Then Begin
     Exit; End;
    If Not DSUDecodeRle(PEABuffer(@Bm^[W]),W*2,W,H Div 2,Buf,BufSize,Offset2,
     Is8) Then Begin Exit; End;
    If Is8 Then Begin
     If YuvPal<0 Then Exit;
     R^.NCol:=256;
     For I:=0 To 255 Do R^.Pal[I]:=DSUYuvToRgb(Buf^[YuvPal+I*3],Buf^[YuvPal+I*3+
      2],Buf^[YuvPal+I*3+1]) Or (DSUAlpha[I] Shl 24);
    End Else Begin
     R^.NCol:=4;
     DSUGuessPalette(Pal4);
     For I:=0 To 3 Do R^.Pal[I]:=Pal4[I];
    End;
    E^.Forced:=Menu;
   End;
  End;
  If NextCmd<CmdPos Then Break;
  If NextCmd=CmdPos Then Break;
  CmdPos:=NextCmd;
 End;
 If HaveRect Then Begin If Menu Then DSUDecodeCmds:=1 Else DSUDecodeCmds:=0;
  End;
End;

Function DSUIsTransp(B: PEABuffer; Pitch,N: LongInt; Const Tr: Array Of Byte):
 Boolean;
Var I: LongInt;
Begin
 DSUIsTransp:=False;
 For I:=0 To N-1 Do If Tr[B^[I*Pitch]]=0 Then Exit;
 DSUIsTransp:=True;
End;

{ recadre l'evenement sur le plus petit rectangle non transparent; False si vide
 }
Function DSUShrink(E: PXSEv): Boolean;
Var Tr: Array[0..255] Of Byte; Y1,Y2,X1,X2,Y,I,W,H: LongInt; Transparent:
 Boolean; Nb: PEABuffer; R: PXSRect;
Begin
 DSUShrink:=False;
 If E^.NR=0 Then Exit;
 R:=E^.Rc[0];
 If (R^.Bmp=Nil) Or (R^.W<=0) Or (R^.H<=0) Then Exit;
 FillChar(Tr,SizeOf(Tr),0); Transparent:=True;
 For I:=0 To R^.NCol-1 Do Begin
  If ((R^.Pal[I] Shr 24) And 255)=0 Then Tr[I]:=1 Else If DSUUsed[I]<>0 Then
   Transparent:=False;
 End;
 If Transparent Then Exit;
 Y1:=0; While (Y1<R^.H) And DSUIsTransp(PEABuffer(@R^.Bmp^[Y1*R^.W]),1,R^.W,Tr)
  Do Inc(Y1);
 If Y1=R^.H Then Exit;
 Y2:=R^.H-1; While (Y2>0) And DSUIsTransp(PEABuffer(@R^.Bmp^[Y2*R^.W]),1,R^.W,
  Tr) Do Dec(Y2);
 X1:=0; While (X1<R^.W-1) And DSUIsTransp(PEABuffer(@R^.Bmp^[X1]),R^.W,R^.H,Tr)
  Do Inc(X1);
 X2:=R^.W-1; While (X2>0) And DSUIsTransp(PEABuffer(@R^.Bmp^[X2]),R^.W,R^.H,Tr)
  Do Dec(X2);
 W:=X2-X1+1; H:=Y2-Y1+1;
 GetMem(Nb,W*H+64);
 For Y:=0 To H-1 Do Move(R^.Bmp^[X1+(Y1+Y)*R^.W],Nb^[W*Y],W);
 FreeMem(R^.Bmp,R^.W*R^.H+64);
 R^.Bmp:=Nb; R^.X:=R^.X+X1; R^.Y:=R^.Y+Y1; R^.W:=W; R^.H:=H;
 DSUShrink:=True;
End;

{ un paquet SPU complet (ou a completer) -> evenement (retourne True si un
 evenement est ajoute) }
Function DSUDecodePacket(Buf: PEABuffer; Size: LongInt; Pts: Int64): Boolean;
Var E: PXSEv; R: LongInt; Appended: Boolean;
Begin
 DSUDecodePacket:=False; Appended:=False;
 If DSUBufSize>0 Then Begin
  If Size>=SizeOf(DSUBuf)-DSUBufSize Then Begin DSUBufSize:=0; Exit; End;
  Move(Buf^,DSUBuf[DSUBufSize],Size); Inc(DSUBufSize,Size);
  Buf:=PEABuffer(@DSUBuf); Size:=DSUBufSize; Appended:=True;
 End;
 E:=XSNew;
 R:=DSUDecodeCmds(Buf,Size,E);
 If R=-2 Then Begin
  XSDropLast;
  If Not Appended Then Begin
   If Size>=SizeOf(DSUBuf) Then Begin DSUBufSize:=0; Exit; End;
   Move(Buf^,DSUBuf,Size); DSUBufSize:=Size;
  End;
  Exit;
 End;
 If R=-3 Then Begin XSDropLast; Exit; End;
 If R<0 Then Begin XSDropLast; DSUBufSize:=0; Exit; End;
 If (R=0) And Not DSUShrink(E) Then Begin XSDropLast; DSUBufSize:=0; Exit; End;
 DSUBufSize:=0;
 E^.T1:=Pts+E^.T1; E^.T0:=Pts+E^.T0;
 DSUDecodePacket:=True;
End;

{ ---- VobSub (.idx + .sub): lecture (libavformat/mpeg.c) et ecriture ---- }
Const DSUDefPal: Array[0..15] Of LongInt=(
  $000000,$0000FF,$00FF00,$FF0000,$FFFF00,$FF00FF,$00FFFF,$FFFFFF,$808000,
   $8080FF,$800080,$80FF80,$008080,$FF8080,$555555,$AAAAAA);

{ prochain code de debut 00 00 01 xx a partir de P; retourne 0x100+xx ou -1 }
Function VobFindStart(F: PEABuffer; Size: LongInt; Var P: LongInt): LongInt;
Var Lim: LongInt;
Begin
 VobFindStart:=-1; Lim:=100000;
 While (P+3<Size) And (Lim>0) Do Begin
  If (F^[P]=0) And (F^[P+1]=0) And (F^[P+2]=1) Then Begin VobFindStart:=$100+F^[
   P+3]; Inc(P,4); Exit; End;
  Inc(P); Dec(Lim);
 End;
End;

{ mpegps_read_pes_header: Code recoit l'identifiant de sous-flux (0x20..) pour
 private_stream_1 }
Function VobReadPes(F: PEABuffer; Size: LongInt; Var P: LongInt; Var Code,Len:
 LongInt): Boolean;
Var LastSync,Sc,C,Flags,Hl,PesExt,Skip,Ext2,IdExt,K: LongInt; ErrRedo: Boolean;
Function R8: LongInt;Begin R8:=EAByte(F,Size,P); Inc(P); End;
Function R16: LongInt;Begin R16:=EAByte(F,Size,P)*256+EAByte(F,Size,P+1); Inc(P,
 2); End;
Begin
 VobReadPes:=False; LastSync:=P; ErrRedo:=False;
 While True Do Begin
  If ErrRedo Then P:=LastSync;
  ErrRedo:=False;
  Sc:=VobFindStart(F,Size,P);
  LastSync:=P;
  If Sc<0 Then Exit;
  If (Sc=$1BA) Or (Sc=$1BB) Then Continue;
  If (Sc=$1BE) Or (Sc=$1BF) Or (Sc=$1BC) Then Begin K:=R16; Inc(P,K); Continue;
   End;
  If Not (((Sc>=$1C0) And (Sc<=$1DF)) Or ((Sc>=$1E0) And (Sc<=$1EF)) Or (
   Sc=$1BD) Or (Sc=$1FD)) Then Continue;
  Len:=R16;
  { bourrage MPEG-1 }
  C:=0;
  While True Do Begin
   If Len<1 Then Begin ErrRedo:=True; Break; End;
   C:=R8; Dec(Len);
   If C<>$FF Then Break;
  End;
  If ErrRedo Then Continue;
  If (C And $C0)=$40 Then Begin R8; C:=R8; Dec(Len,2); End;
  If (C And $E0)=$20 Then Begin
   Inc(P,4); Dec(Len,4);
   If (C And $10)<>0 Then Begin Inc(P,5); Dec(Len,5); End;
  End Else If (C And $C0)=$80 Then Begin
   Flags:=R8; Hl:=R8; Dec(Len,2);
   If Hl>Len Then Begin ErrRedo:=True; Continue; End;
   Dec(Len,Hl);
   If (Flags And $80)<>0 Then Begin Inc(P,5); Dec(Hl,5); If (Flags And $40)<>0
    Then Begin Inc(P,5); Dec(Hl,5); End; End;
   If ((Flags And $3F)<>0) And (Hl=0) Then Flags:=Flags And $C0;
   If (Flags And 1)<>0 Then Begin
    PesExt:=R8; Dec(Hl);
    Skip:=(PesExt Shr 4) And $B; Skip:=Skip+(Skip And 9);
    If ((PesExt And $40)<>0) Or (Skip>Hl) Then Begin PesExt:=0; Skip:=0; End;
    Inc(P,Skip); Dec(Hl,Skip);
    If (PesExt And 1)<>0 Then Begin
     Ext2:=R8; Dec(Hl);
     If (Ext2 And $7F)>0 Then Begin IdExt:=R8; If (IdExt And $80)=0 Then Sc:=((
      Sc And $FF) Shl 8) Or IdExt; Dec(Hl); End;
    End;
   End;
   If Hl<0 Then Begin ErrRedo:=True; Continue; End;
   Inc(P,Hl);
  End Else If C<>$F Then Continue;
  If Sc=$1BD Then Begin
   Sc:=R8; Dec(Len);
  End;
  If Len<0 Then Begin ErrRedo:=True; Continue; End;
  Code:=Sc; VobReadPes:=True; Exit;
 End;
End;

{ assemble le paquet SPU commencant en Pos; PSize = octets alloues jusqu'au
 prochain paquet }
Function VobReadPacket(F: PEABuffer; Size: LongInt; Pos,PSize,StreamId: LongInt;
 Buf: PEABuffer; Var Len: LongInt): Boolean;
Var P,OldPos,NewPos,Total,Ret,Code,N,Pk: LongInt;
Begin
 P:=Pos; Total:=0; Len:=0; VobReadPacket:=False;
 Repeat
  OldPos:=P;
  If Not VobReadPes(F,Size,P,Code,Ret) Then Begin
   If Len>0 Then Break;
   Exit;
  End;
  NewPos:=P; Pk:=Ret+(NewPos-OldPos);
  If Total+Pk>PSize Then Break;
  Inc(Total,Pk);
  If (Code And $1F)<>StreamId Then Break;
  N:=Ret And $FFFF;
  If N>Size-P Then N:=Size-P;
  If N>0 Then Begin Move(F^[P],Buf^[Len],N); Inc(Len,N); End;
  Inc(P,Ret And $FFFF);
 Until Total>=PSize;
 VobReadPacket:=True;
End;

Type TVobEnt=Record Ts: Int64; Pos: LongInt; End;
Var VobEnts: Array[0..19999] Of TVobEnt; VobN,VobSid: LongInt;

Procedure VobParseIdx(F: PEABuffer; Size: LongInt);
Var P,K,Stream,Cur,FirstStream,Hh,Mm,Ss,Ms,Code,I: LongInt; Line,Hdr,T: String;
 Delay,Ts: Int64; Pos: Int64; HeaderParsed: Boolean; Sign: LongInt;
Begin
 P:=0; Stream:=-1; Cur:=-1; FirstStream:=-1; Delay:=0; Hdr:=''; HeaderParsed:=
  False; VobN:=0;
 While P<Size Do Begin
  K:=P; While (K<Size) And (F^[K]<>10) And (F^[K]<>13) Do Inc(K);
  Line:=''; For I:=P To K-1 Do If Length(Line)<250 Then Line:=Line+Chr(F^[I]);
  While (K<Size) And ((F^[K]=10) Or (F^[K]=13)) Do Inc(K);
  P:=K;
  If Copy(Line,1,3)='id:' Then Begin
   T:=Copy(Line,XSPos(', index:',Line)+8,20); Val(XSTrim(T),Stream,Code);
   If (XSPos(', index:',Line)=0) Or (Code<>0) Then Stream:=0;
   HeaderParsed:=True;
  End Else If Copy(Line,1,10)='timestamp:' Then Begin
   If Stream<0 Then Fail('vobsub: timestamp avant tout flux.');
   T:=XSTrim(Copy(Line,11,200));
   { hh:mm:ss:mmm, filepos: hhhhhhhhh }
   Val(Copy(T,1,2),Hh,Code); If Code<>0 Then Fail(
    'vobsub: ligne timestamp incorrecte.');
   Val(Copy(T,4,2),Mm,Code); If Code<>0 Then Fail(
    'vobsub: ligne timestamp incorrecte.');
   Val(Copy(T,7,2),Ss,Code); If Code<>0 Then Fail(
    'vobsub: ligne timestamp incorrecte.');
   Val(Copy(T,10,3),Ms,Code); If Code<>0 Then Fail(
    'vobsub: ligne timestamp incorrecte.');
   I:=XSPos('filepos:',T); If I=0 Then Fail(
    'vobsub: ligne timestamp incorrecte.');
   T:=XSTrim(Copy(T,I+8,40)); Val('$'+T,Pos,Code); If Code<>0 Then Fail(
    'vobsub: filepos incorrect.');
   Ts:=(Int64(Hh)*3600+Mm*60+Ss)*1000+Ms+Delay;
   If FirstStream<0 Then Begin FirstStream:=Stream; VobSid:=Stream; End;
   If Stream=FirstStream Then Begin
    If VobN>=20000 Then Fail('vobsub: trop de sous-titres.');
    VobEnts[VobN].Ts:=Ts; VobEnts[VobN].Pos:=Pos; Inc(VobN);
   End;
  End Else If Copy(Line,1,4)='alt:' Then HeaderParsed:=True
  Else If Copy(Line,1,6)='delay:' Then Begin
   T:=XSTrim(Copy(Line,7,100)); Sign:=1;
   If (T<>'') And ((T[1]='-') Or (T[1]='+')) Then Begin If T[1]='-' Then Sign:=-
    1; Delete(T,1,1); End;
   Hh:=0; Mm:=0; Ss:=0; Ms:=0;
   I:=XSPos(':',T); If I>0 Then Begin Val(Copy(T,1,I-1),Hh,Code); Delete(T,1,I);
    End Else Begin Val(T,Hh,Code); T:=''; End;
   I:=XSPos(':',T); If I>0 Then Begin Val(Copy(T,1,I-1),Mm,Code); Delete(T,1,I);
    End Else If T<>'' Then Begin Val(T,Mm,Code); T:=''; End;
   I:=XSPos(':',T); If I>0 Then Begin Val(Copy(T,1,I-1),Ss,Code); Delete(T,1,I);
    End Else If T<>'' Then Begin Val(T,Ss,Code); T:=''; End;
   If T<>'' Then Val(T,Ms,Code);
   Delay:=((Int64(Hh)*3600+Mm*60+Ss)*1000+Ms)*Sign;
  End Else If Copy(Line,1,8)='langidx:' Then
  Else If Not HeaderParsed Then Begin
   If (Line<>'') And (Line[1]<>'#') Then DSUParseExtra(Line+#10);
  End;
 End;
End;

{ ---- DVD subtitles: encodeur (libavcodec/dvdsubenc.c) ---- }
Function DSUColorDist(A,B: Int64): Int64;
Var R,D,Aa,Ab: Int64; Sh: LongInt;
Begin
 R:=0; Aa:=8; Ab:=8;
 For Sh:=3 DownTo 0 Do Begin
  D:=Aa*((A Shr (Sh*8)) And $FF)-Ab*((B Shr (Sh*8)) And $FF);
  R:=R+D*D; Aa:=A Shr 28; Ab:=B Shr 28;
 End;
 DSUColorDist:=R;
End;

Var DSUQ: LongInt; DSUNc: LongInt; DSUBb: LongInt; DSUOut: PEABuffer;

Procedure DSUPutNibble(V: LongInt);
Begin
 If (DSUNc And 1)<>0 Then Begin DSUOut^[DSUQ]:=(DSUBb Or (V And 15)) And 255;
  Inc(DSUQ); End
 Else DSUBb:=(V And 15) Shl 4;
 Inc(DSUNc);
End;

Procedure DSUEncodeRle(Bitmap: PEABuffer; Linesize,W,H: LongInt; Const Cmap:
 Array Of LongInt);
Var X,Y,Len,Color,Base: LongInt;
Begin
 For Y:=0 To H-1 Do Begin
  DSUNc:=0; Base:=Y*Linesize; X:=0;
  While X<W Do Begin
   Color:=Bitmap^[Base+X]; Len:=1;
   While (X+Len<W) And (Bitmap^[Base+X+Len]=Color) Do Inc(Len);
   Color:=Cmap[Color];
   If Len<4 Then DSUPutNibble((Len Shl 2) Or Color)
   Else If Len<16 Then Begin DSUPutNibble(Len Shr 2); DSUPutNibble((Len Shl 2)
    Or Color); End
   Else If Len<64 Then Begin DSUPutNibble(0); DSUPutNibble(Len Shr 2);
    DSUPutNibble((Len Shl 2) Or Color); End
   Else If X+Len=W Then Begin DSUPutNibble(0); DSUPutNibble(0); DSUPutNibble(0);
    DSUPutNibble(Color); End
   Else Begin
    If Len>255 Then Len:=255;
    DSUPutNibble(0); DSUPutNibble(Len Shr 6); DSUPutNibble(Len Shr 2);
     DSUPutNibble((Len Shl 2) Or Color);
   End;
   Inc(X,Len);
  End;
  If (DSUNc And 1)<>0 Then DSUPutNibble(0);
 End;
End;

{ encode l'evenement E en paquet SPU; retourne la taille, ou 0 si impossible }
Function DSUEncode(E: PXSEv; Out: PEABuffer; StartDisp,EndDisp: Int64): LongInt;
Var
 Hits: Array[0..32] Of Int64; Count: Array[0..255] Of Int64; Selected: Array[
  0..3] Of LongInt; Pseudo: Array[0..32] Of Int64;
 OutPal,OutAlpha: Array[0..3] Of LongInt; Cmap: Array[0..255] Of LongInt; Pp4:
  Array[0..3] Of Int64;
 I,J,K,Match,BestJ,Bright,Mult,X2,Y2,T,Vx,Vy,Vw,Vh,Xmin,Ymin,Xmax,Ymax,Px,Py:
  LongInt; Color,BestD,D: Int64;
 Ref: Array[0..2] Of Int64; Off1,Off2: LongInt; R: PXSRect; Vdata: PEABuffer;
  Single: PEABuffer;
Procedure P16(V: LongInt);Begin Out^[DSUQ]:=(V Shr 8) And 255; Out^[DSUQ+1]:=V
 And 255; Inc(DSUQ,2); End;
Procedure P8(V: LongInt);Begin Out^[DSUQ]:=V And 255; Inc(DSUQ); End;
Procedure BuildMap(Rc: PXSRect);
Var A,B: LongInt;
Begin
 For A:=0 To 3 Do Pp4[A]:=(Int64(OutAlpha[A]) Shl 24) Or DSUDefPal[OutPal[A]];
 For A:=0 To 255 Do Begin
  BestD:=High(Int64); Cmap[A]:=0;
  For B:=0 To 3 Do Begin
   D:=DSUColorDist(Pp4[B],Rc^.Pal[A] And $FFFFFFFF);
   If D<BestD Then Begin Cmap[A]:=B; BestD:=D; End;
  End;
 End;
End;
Begin
 DSUEncode:=0;
 If E^.NR=0 Then Exit;
 FillChar(Hits,SizeOf(Hits),0);
 R:=E^.Rc[0]; Vx:=R^.X; Vy:=R^.Y; Vw:=R^.W; Vh:=R^.H;
 If E^.NR>1 Then Begin
  Xmin:=R^.X; Xmax:=Xmin+R^.W; Ymin:=R^.Y; Ymax:=Ymin+R^.H;
  For I:=1 To E^.NR-1 Do Begin
   If E^.Rc[I]^.X<Xmin Then Xmin:=E^.Rc[I]^.X; If E^.Rc[I]^.Y<Ymin Then Ymin:=
    E^.Rc[I]^.Y;
   If E^.Rc[I]^.X+E^.Rc[I]^.W>Xmax Then Xmax:=E^.Rc[I]^.X+E^.Rc[I]^.W;
   If E^.Rc[I]^.Y+E^.Rc[I]^.H>Ymax Then Ymax:=E^.Rc[I]^.Y+E^.Rc[I]^.H;
  End;
  Vx:=Xmin; Vy:=Ymin; Vw:=Xmax-Xmin; Vh:=Ymax-Ymin;
  Hits[0]:=Int64(Vw)*Vh;
  For I:=0 To E^.NR-1 Do Hits[0]:=Hits[0]-Int64(E^.Rc[I]^.W)*E^.Rc[I]^.H;
 End;
 For K:=0 To E^.NR-1 Do Begin
  R:=E^.Rc[K];
  FillChar(Count,SizeOf(Count),0);
  For I:=0 To R^.W*R^.H-1 Do Inc(Count[R^.Bmp^[I]]);
  For I:=0 To 255 Do Begin
   If Count[I]=0 Then Continue;
   Color:=R^.Pal[I] And $FFFFFFFF;
   If Color<$33000000 Then Match:=0 Else If Color<$CC000000 Then Match:=1 Else
    Match:=17;
   If Match<>0 Then Begin
    BestD:=High(Int64); BestJ:=0;
    For J:=0 To 15 Do Begin
     D:=DSUColorDist($FF000000 Or Color,$FF000000 Or DSUDefPal[J]);
     If D<BestD Then Begin BestD:=D; BestJ:=J; End;
    End;
    Inc(Match,BestJ);
   End;
   Inc(Hits[Match],Count[I]);
  End;
 End;
 { select_palette }
 FillChar(Selected,SizeOf(Selected),0);
 Hits[0]:=Hits[0]*16;
 For I:=0 To 15 Do Begin
  If (Hits[1+I]+Hits[17+I])=0 Then Continue;
  Color:=DSUDefPal[I]; Bright:=0;
  For J:=0 To 2 Do Begin
   If ((Color And $FF)<$40) Or ((Color And $FF)>=$C0) Then Inc(Bright);
   Color:=Color Shr 8;
  End;
  If Bright>2 Then Mult:=4 Else Mult:=2+Bright;
  Hits[1+I]:=Hits[1+I]*Mult; Hits[17+I]:=Hits[17+I]*Mult;
 End;
 For I:=0 To 3 Do Begin
  For J:=0 To 32 Do If Hits[J]>Hits[Selected[I]] Then Selected[I]:=J;
  Hits[Selected[I]]:=0;
 End;
 FillChar(Pseudo,SizeOf(Pseudo),0);
 For I:=0 To 15 Do Begin
  Pseudo[1+I]:=$80000000 Or DSUDefPal[I]; Pseudo[17+I]:=Int64($FF000000) Or
   DSUDefPal[I];
 End;
 Ref[0]:=0; Ref[1]:=$FFFFFFFF; Ref[2]:=$FF000000;
 For I:=0 To 2 Do Begin
  BestD:=DSUColorDist(Ref[I],Pseudo[Selected[I]]);
  For J:=I+1 To 3 Do Begin
   D:=DSUColorDist(Ref[I],Pseudo[Selected[J]]);
   If D<BestD Then Begin T:=Selected[I]; Selected[I]:=Selected[J]; Selected[J]:=
    T; BestD:=D; End;
  End;
 End;
 For I:=0 To 3 Do Begin
  If Selected[I]<>0 Then OutPal[I]:=(Selected[I]-1) And 15 Else OutPal[I]:=0;
  If Selected[I]=0 Then OutAlpha[I]:=0 Else If Selected[I]<17 Then OutAlpha[I]:=
   $80 Else OutAlpha[I]:=$FF;
 End;
 Vdata:=Nil; Single:=Nil;
 If E^.NR>1 Then Begin
  If (Vw<1) Or (Vh<1) Or (Int64(Vw)*Vh>16000000) Then Exit;
  GetMem(Vdata,Vw*Vh+64); FillChar(Vdata^,Vw*Vh+64,0);
  For K:=0 To E^.NR-1 Do Begin
   R:=E^.Rc[K]; BuildMap(R);
   For Py:=0 To R^.H-1 Do For Px:=0 To R^.W-1 Do
    Vdata^[(R^.X-Vx+Px)+(R^.Y-Vy+Py)*Vw]:=Cmap[R^.Bmp^[Py*R^.W+Px]];
  End;
  For I:=0 To 3 Do Cmap[I]:=I;
  Single:=Vdata;
 End Else Begin
  BuildMap(E^.Rc[0]); Single:=E^.Rc[0]^.Bmp;
 End;
 DSUOut:=Out; DSUQ:=4; Off1:=DSUQ;
 If Vw*Vh Div 2+17+21+4>65000 Then Begin If Vdata<>Nil Then FreeMem(Vdata,Vw*Vh+
  64); Exit; End;
 DSUEncodeRle(Single,Vw*2,Vw,(Vh+1) Shr 1,Cmap);
 Off2:=DSUQ;
 DSUEncodeRle(PEABuffer(@Single^[Vw]),Vw*2,Vw,Vh Shr 1,Cmap);
 If Vdata<>Nil Then FreeMem(Vdata,Vw*Vh+64);
 Out^[2]:=(DSUQ Shr 8) And 255; Out^[3]:=DSUQ And 255;
 P16((StartDisp*90) Shr 10);
 P16(DSUQ+8+12+2);
 P8($03); P8((OutPal[3] Shl 4) Or OutPal[2]); P8((OutPal[1] Shl 4) Or OutPal[
  0]);
 P8($04); P8((OutAlpha[3] And $F0) Or (OutAlpha[2] Shr 4)); P8((OutAlpha[1] And
  $F0) Or (OutAlpha[0] Shr 4));
 X2:=Vx+Vw-1; Y2:=Vy+Vh-1;
 If ((XSW>0) And (X2>XSW)) Or ((XSH>0) And (Y2>XSH)) Then Exit;
 P8($05);
 P8(Vx Shr 4); P8((Vx Shl 4) Or ((X2 Shr 8) And $F)); P8(X2);
 P8(Vy Shr 4); P8((Vy Shl 4) Or ((Y2 Shr 8) And $F)); P8(Y2);
 P8($06); P16(Off1); P16(Off2);
 If E^.Forced Then P8($00) Else P8($01);
 P8($FF);
 P16((EndDisp*90) Shr 10);
 P16(DSUQ-2);
 P8($02); P8($FF);
 Out^[0]:=(DSUQ Shr 8) And 255; Out^[1]:=DSUQ And 255;
 DSUEncode:=DSUQ;
End;

{ ---- ecriture VobSub ---- }
Procedure XSPutPts(B: PEABuffer; At: LongInt; Pts: Int64; Marker: LongInt);
Begin
 B^[At]:=(Marker Shl 4) Or (((Pts Shr 30) And 7) Shl 1) Or 1;
 B^[At+1]:=(Pts Shr 22) And $FF;
 B^[At+2]:=(((Pts Shr 15) And $7F) Shl 1) Or 1;
 B^[At+3]:=(Pts Shr 7) And $FF;
 B^[At+4]:=((Pts And $7F) Shl 1) Or 1;
End;

Procedure XSHex(V: Int64; N: LongInt; Var S: String);
Const Hx: String[16]='0123456789abcdef';
Var I: LongInt;
Begin
 S:=''; For I:=N-1 DownTo 0 Do S:=S+Hx[((V Shr (I*4)) And 15)+1];
End;

Function XS2(V: LongInt): String;
Var S: String;
Begin Str(V,S); While Length(S)<2 Do S:='0'+S; XS2:=S; End;

Procedure XSWriteStr(Const S: String);
Var B: Array[0..255] Of Byte; I: LongInt;
Begin
 For I:=1 To Length(S) Do B[I-1]:=Ord(S[I]);
 WriteBytes(B,Length(S));
End;

Procedure XSWriteVobSub(Const IdxName: String);
Var
 SubName,Hdr,Line,Ts: String; Spu: PEABuffer; Sec: PEABuffer; I,J,Len,N,Cap,Pos,
  Fill,Sp,Spare,Stuff,Hl,PesLen,K: LongInt; Pts: Int64; Filepos: Int64;
 Fp: Array[0..19999] Of LongInt; T0: Int64; Ok: Boolean; Ext: String; Code:
  Integer; F: File;
 Hh,Mm,Ss,Ms: LongInt; S1: String; Pack: Array[0..13] Of Byte;
Const PackH: Array[0..13] Of Byte=(0,0,1,$BA,$44,0,4,0,4,1,1,$89,$C3,$F8);
Begin
 If Length(IdxName)<5 Then Fail('vobsub: nom de fichier .idx requis.');
 Ext:=Copy(IdxName,Length(IdxName)-2,3);
 If Ext='IDX' Then SubName:=Copy(IdxName,1,Length(IdxName)-3)+'SUB' Else
  SubName:=Copy(IdxName,1,Length(IdxName)-3)+'sub';
 If Copy(IdxName,Length(IdxName)-3,1)<>'.' Then Fail(
  'vobsub: le nom de sortie doit etre de la forme nom.idx.');
 If Exists(SubName) And Not Overwrite Then Fail(
  'Sortie existante (utiliser -y): '+SubName);
 GetMem(Spu,70000); GetMem(Sec,2048+64);
 OpenWrite(SubName);
 Pos:=0;
 For I:=0 To XSN-1 Do Begin
  Len:=DSUEncode(XSEvs[I],Spu,0,XSEvs[I]^.T1-XSEvs[I]^.T0);
  If Len=0 Then Fail(
   'sous-titre DVD: evenement trop grand ou hors de la toile.');
  Fp[I]:=Pos; Pts:=XSEvs[I]^.T0*90; Sp:=0;
  While Sp<Len Do Begin
   FillChar(Sec^,2048,0);
   Move(PackH,Sec^,14);
   If Sp=0 Then Cap:=2019 Else Cap:=2024;
   N:=Len-Sp; If N>Cap Then N:=Cap;
   Spare:=Cap-N; Stuff:=0;
   If (Spare>=1) And (Spare<=5) Then Stuff:=Spare;
   If Sp=0 Then Hl:=5+Stuff Else Hl:=Stuff;
   PesLen:=3+Hl+1+N;
   Sec^[14]:=0; Sec^[15]:=0; Sec^[16]:=1; Sec^[17]:=$BD;
   Sec^[18]:=PesLen Shr 8; Sec^[19]:=PesLen And 255;
   Sec^[20]:=$81; If Sp=0 Then Sec^[21]:=$80 Else Sec^[21]:=0;
   Sec^[22]:=Hl;
   K:=23;
   If Sp=0 Then Begin XSPutPts(Sec,K,Pts,2); Inc(K,5); End;
   For J:=1 To Stuff Do Begin Sec^[K]:=$FF; Inc(K); End;
   Sec^[K]:=$20; Inc(K);
   Move(Spu^[Sp],Sec^[K],N); Inc(K,N); Inc(Sp,N);
   Fill:=2048-K;
   If Fill>=6 Then Begin
    Sec^[K]:=0; Sec^[K+1]:=0; Sec^[K+2]:=1; Sec^[K+3]:=$BE; Sec^[K+4]:=(Fill-6)
     Shr 8; Sec^[K+5]:=(Fill-6) And 255;
    FillChar(Sec^[K+6],Fill-6,$FF);
   End;
   WriteBytes(Sec^,2048); Inc(Pos,2048);
  End;
 End;
 FreeMem(Spu,70000); FreeMem(Sec,2048+64);
 CloseWrite;
 OpenWrite(IdxName);
 XSWriteStr('# VobSub index file, v7 (do not modify this line!)'+#10+'#'+#10);
 Str(XSW,S1); Line:='size: '+S1+'x'; Str(XSH,S1); Line:=Line+S1+#10;
 XSWriteStr(Line);
 XSWriteStr('org: 0, 0'+#10+'scale: 100%, 100%'+#10+'alpha: 100%'+#10+
  'smooth: OFF'+#10+'fadein/out: 0, 0'+#10+'align: OFF at LEFT TOP'+#10+
  'time offset: 0'+#10+'forced subs: OFF'+#10);
 Line:='palette: ';
 For I:=0 To 15 Do Begin XSHex(DSUDefPal[I],6,S1); Line:=Line+S1; If I<15 Then
  Line:=Line+', '; End;
 XSWriteStr(Line+#10);
 XSWriteStr(
  'custom colors: OFF, tridx: 0000, colors: 000000, 000000, 000000, 000000'+#10+
  'langidx: 0'+#10+'id: en, index: 0'+#10);
 XSWriteStr(
  '# Decomment next line to activate alternative name in DirectVobSub / Window'+
  's Media Player 6.x'+#10+'# alt: English'+#10);
 For I:=0 To XSN-1 Do Begin
  T0:=XSEvs[I]^.T0; Ms:=T0 Mod 1000; T0:=T0 Div 1000; Ss:=T0 Mod 60; T0:=T0 Div
   60; Mm:=T0 Mod 60; Hh:=T0 Div 60;
  Line:='timestamp: '+XS2(Hh)+':'+XS2(Mm)+':'+XS2(Ss)+':';
  Str(Ms,S1); While Length(S1)<3 Do S1:='0'+S1; Line:=Line+S1+', filepos: ';
  XSHex(Fp[I],9,S1); Line:=Line+S1+#10;
  XSWriteStr(Line);
 End;
 CloseWrite;
End;

{ ---- manifeste .psub et fonctions de haut niveau ---- }
Function XSDirOf(Const Name: String): String;
Var I: LongInt;
Begin
 I:=Length(Name); While (I>0) And (Name[I]<>'/') And (Name[I]<>'\') Do Dec(I);
 XSDirOf:=Copy(Name,1,I);
End;

Function XSBaseNoExt(Const Name: String): String;
Var I,J: LongInt;
Begin
 I:=Length(Name); J:=I;
 While (J>0) And (Name[J]<>'.') And (Name[J]<>'/') And (Name[J]<>'\') Do Dec(J);
 If (J>0) And (Name[J]='.') Then XSBaseNoExt:=Copy(Name,1,J-1) Else
  XSBaseNoExt:=Name;
End;

Function XSFileOf(Const Name: String): String;
Var I: LongInt;
Begin
 I:=Length(Name); While (I>0) And (Name[I]<>'/') And (Name[I]<>'\') Do Dec(I);
 XSFileOf:=Copy(Name,I+1,255);
End;

{ ecrit manifeste + PNG (nom_0001.png ...) }
Procedure XSWritePsub(Const Target: String);
Var I: LongInt; Base,Fn,Line,S1: String;
Begin
 If XSN=0 Then Fail('sous-titres: aucun evenement decode.');
 Base:=XSBaseNoExt(Target);
 For I:=0 To XSN-1 Do Begin
  Str(I+1,S1); While Length(S1)<4 Do S1:='0'+S1;
  Fn:=Base+'_'+S1+'.png';
  If Exists(Fn) And Not Overwrite Then Fail('Sortie existante (utiliser -y): '+
   Fn);
  XSWriteEventPNG(XSEvs[I],Fn);
 End;
 OpenWrite(Target);
 Str(XSW,S1); Line:='PNGSUB 1'+#10+'size '+S1+' '; Str(XSH,S1); Line:=Line+S1+
  #10;
 XSWriteStr(Line);
 For I:=0 To XSN-1 Do Begin
  Str(I+1,S1); While Length(S1)<4 Do S1:='0'+S1;
  Fn:=XSFileOf(Base)+'_'+S1+'.png';
  XSWriteStr('sub '+XSTimeStr(XSEvs[I]^.T0)+' '+XSTimeStr(XSEvs[I]^.T1)+' '+Fn+
   #10);
 End;
 CloseWrite;
 For I:=0 To XSN-1 Do Begin
  WriteLn('Sous-titre ',I+1,': ',XSTimeStr(XSEvs[I]^.T0),' -> ',XSTimeStr(XSEvs[
   I]^.T1),'  rectangles: ',XSEvs[I]^.NR);
 End;
End;

Procedure XSLoadPsub(Const Source: String);
Var F: PEABuffer; Size,P,K,I,W,H,Code,Q: LongInt; Line,Dir,Tok,Fn: String; T0,
 T1: Int64; Rgba: PEABuffer; E: PXSEv; Parts: Array[0..3] Of String;
Begin
 NVLoad(Source,F,Size); CloseRead; Dir:=XSDirOf(Source); P:=0; XSN:=0; XSW:=0;
  XSH:=0; XSFromPng:=True;
 While P<Size Do Begin
  K:=P; While (K<Size) And (F^[K]<>10) And (F^[K]<>13) Do Inc(K);
  Line:=''; For I:=P To K-1 Do If Length(Line)<250 Then Line:=Line+Chr(F^[I]);
  While (K<Size) And ((F^[K]=10) Or (F^[K]=13)) Do Inc(K);
  P:=K;
  Line:=XSTrim(Line);
  If (Line='') Or (Line[1]='#') Then Continue;
  If Copy(Line,1,6)='PNGSUB' Then Continue;
  If Copy(Line,1,5)='size ' Then Begin
   Q:=XSPos(' ',Copy(Line,6,100)); Tok:=XSTrim(Copy(Line,6,100));
   Q:=XSPos(' ',Tok);
   If Q=0 Then Fail('psub: ligne size incorrecte.');
   Val(Copy(Tok,1,Q-1),XSW,Code); If Code<>0 Then Fail(
    'psub: ligne size incorrecte.');
   Val(XSTrim(Copy(Tok,Q+1,20)),XSH,Code); If Code<>0 Then Fail(
    'psub: ligne size incorrecte.');
   Continue;
  End;
  If Copy(Line,1,4)='sub ' Then Begin
   Line:=XSTrim(Copy(Line,5,250));
   For I:=0 To 2 Do Begin
    Q:=XSPos(' ',Line);
    If Q=0 Then Begin Parts[I]:=Line; Line:=''; End Else Begin Parts[I]:=Copy(
     Line,1,Q-1); Line:=XSTrim(Copy(Line,Q+1,250)); End;
   End;
   If Not XSParseTime(Parts[0],T0) Or Not XSParseTime(Parts[1],T1) Or (Parts[
    2]='') Then Fail(
    'psub: ligne sub incorrecte (sub hh:mm:ss.mmm hh:mm:ss.mmm fichier.png).');
   If T1<T0 Then Fail('psub: fin avant debut.');
   Fn:=Parts[2];
   XSReadPNG(Dir+Fn,W,H,Rgba);
   If XSW=0 Then Begin XSW:=W; XSH:=H; End;
   If (W<>XSW) Or (H<>XSH) Then Fail(
    'psub: toutes les images doivent avoir la taille size ('+Fn+').');
   E:=XSEventFromRGBA(Rgba,W,H,T0,T1);
   FreeMem(Rgba,W*H*4+64);
   If E=Nil Then WriteLn('Image entierement transparente ignoree: ',Fn);
   Continue;
  End;
  Fail('psub: ligne inconnue: '+Line);
 End;
 FreeMem(F,Size+64);
 If XSN=0 Then Fail('psub: aucun sous-titre.');
End;

Procedure XSLoadVobSub(Const Source: String);
Var
 Idx,Sb: PEABuffer; IdxSize,SubSize,I,J,Len,Ps,NameLen: LongInt; SubName,Ext:
  String; Pk: PEABuffer; Order: Array[0..19999] Of LongInt; T: LongInt;
Begin
 NameLen:=Length(Source);
 If (NameLen<5) Or (Source[NameLen-3]<>'.') Then Fail(
  'vobsub: nom .idx requis pour deviner le fichier .sub.');
 Ext:=Copy(Source,NameLen-2,3);
 If Ext='IDX' Then SubName:=Copy(Source,1,NameLen-3)+'SUB' Else SubName:=Copy(
  Source,1,NameLen-3)+'sub';
 If Not Exists(SubName) Then Fail('vobsub: fichier .sub introuvable: '+SubName);
 NVLoad(Source,Idx,IdxSize); CloseRead;
 XSW:=720; XSH:=480; DSUHasPal:=False; FillChar(DSUPal,SizeOf(DSUPal),0);
  FillChar(DSUColormap,SizeOf(DSUColormap),0); FillChar(DSUAlpha,SizeOf(
  DSUAlpha),0); DSUBufSize:=0;
 VobParseIdx(Idx,IdxSize);
 FreeMem(Idx,IdxSize+64);
 If VobN=0 Then Fail('vobsub: aucun horodatage dans le fichier .idx.');
 NVLoad(SubName,Sb,SubSize); CloseRead;
 { tri par position puis horodatage (SUB_SORT_POS_TS) }
 For I:=0 To VobN-1 Do Order[I]:=I;
 For I:=1 To VobN-1 Do Begin
  T:=Order[I]; J:=I-1;
  While (J>=0) And ((VobEnts[Order[J]].Pos>VobEnts[T].Pos) Or ((VobEnts[Order[
   J]].Pos=VobEnts[T].Pos) And (VobEnts[Order[J]].Ts>VobEnts[T].Ts))) Do Begin
   Order[J+1]:=Order[J]; Dec(J); End;
  Order[J+1]:=T;
 End;
 GetMem(Pk,70000);
 For I:=0 To VobN-1 Do Begin
  If I<VobN-1 Then Ps:=VobEnts[Order[I+1]].Pos-VobEnts[Order[I]].Pos Else Ps:=
   SubSize-VobEnts[Order[I]].Pos;
  If (VobEnts[Order[I]].Pos<0) Or (VobEnts[Order[I]].Pos>=SubSize) Then
   Continue;
  Len:=0;
  If VobReadPacket(Sb,SubSize,VobEnts[Order[I]].Pos,Ps,VobSid,Pk,Len) And (
   Len>0) Then DSUDecodePacket(Pk,Len,VobEnts[Order[I]].Ts);
 End;
 FreeMem(Pk,70000); FreeMem(Sb,SubSize+64);
End;

{ ---- DVB subtitles: decodeur (libavcodec/dvbsubdec.c) ---- }
Type
 PDBClut=^TDBClut;
 TDBClut=Record Id,Version: LongInt; C4: Array[0..3] Of LongInt; C16: Array[
  0..15] Of LongInt; C256: Array[0..255] Of LongInt; Next: PDBClut; End;
 PDBObjDisp=^TDBObjDisp;
 TDBObjDisp=Record ObjectId,RegionId,XPos,YPos,Fg,Bg: LongInt; RegionNext,
  ObjectNext: PDBObjDisp; End;
 PDBObject=^TDBObject;
 TDBObject=Record Id,Version,Typ: LongInt; DisplayList: PDBObjDisp; Next:
  PDBObject; End;
 PDBRegDisp=^TDBRegDisp;
 TDBRegDisp=Record RegionId,XPos,YPos: LongInt; Next: PDBRegDisp; End;
 PDBRegion=^TDBRegion;
 TDBRegion=Record
  Id,Version,Width,Height,Depth,Clut,Bgcolor: LongInt;
  Computed: Array[0..1023] Of Byte; HasComputed: Boolean; Pbuf: PEABuffer;
   BufSize: LongInt; Dirty: Boolean;
  DisplayList: PDBObjDisp; Next: PDBRegion;
 End;
Var
 DBDefClut: TDBClut; DBDefInit: Boolean;
 DBVersion,DBTimeOut: LongInt; DBRegions: PDBRegion; DBCluts: PDBClut;
  DBObjects: PDBObject; DBDisplays: PDBRegDisp;
 DBDefDef: Boolean; DBDefVersion,DBDefX,DBDefY,DBDefW,DBDefH: LongInt;
 DBCount2: Array[0..256,0..255] Of LongInt;
 DBEvPts: Int64; DBHaveSub: Boolean; DBSubEv: PXSEv;

Function DBRgba(R,G,B,A: LongInt): LongInt;
Begin DBRgba:=LongInt((Int64(A) Shl 24) Or (Int64(R) Shl 16) Or (Int64(G) Shl 8)
 Or B); End;

Procedure DBInitDefaults;
Var I,R,G,B,A: LongInt;
Begin
 If DBDefInit Then Exit;
 DBDefInit:=True; A:=0;
 FillChar(DBDefClut,SizeOf(DBDefClut),0); DBDefClut.Id:=-1;
 DBDefClut.C4[0]:=DBRgba(0,0,0,0); DBDefClut.C4[1]:=DBRgba(255,255,255,255);
  DBDefClut.C4[2]:=DBRgba(0,0,0,255); DBDefClut.C4[3]:=DBRgba(127,127,127,255);
 DBDefClut.C16[0]:=DBRgba(0,0,0,0);
 For I:=1 To 15 Do Begin
  If I<8 Then Begin
   If (I And 1)<>0 Then R:=255 Else R:=0; If (I And 2)<>0 Then G:=255 Else G:=0;
    If (I And 4)<>0 Then B:=255 Else B:=0;
  End Else Begin
   If (I And 1)<>0 Then R:=127 Else R:=0; If (I And 2)<>0 Then G:=127 Else G:=0;
    If (I And 4)<>0 Then B:=127 Else B:=0;
  End;
  DBDefClut.C16[I]:=DBRgba(R,G,B,255);
 End;
 DBDefClut.C256[0]:=DBRgba(0,0,0,0);
 For I:=1 To 255 Do Begin
  R:=0; G:=0; B:=0;
  If I<8 Then Begin
   If (I And 1)<>0 Then R:=255 Else R:=0; If (I And 2)<>0 Then G:=255 Else G:=0;
    If (I And 4)<>0 Then B:=255 Else B:=0;
   A:=63;
  End Else Begin
   Case I And $88 Of
    $00: Begin
     R:=0; If (I And 1)<>0 Then R:=85; If (I And $10)<>0 Then R:=R+170;
     G:=0; If (I And 2)<>0 Then G:=85; If (I And $20)<>0 Then G:=G+170;
     B:=0; If (I And 4)<>0 Then B:=85; If (I And $40)<>0 Then B:=B+170;
     A:=255;
    End;
    $08: Begin
     R:=0; If (I And 1)<>0 Then R:=85; If (I And $10)<>0 Then R:=R+170;
     G:=0; If (I And 2)<>0 Then G:=85; If (I And $20)<>0 Then G:=G+170;
     B:=0; If (I And 4)<>0 Then B:=85; If (I And $40)<>0 Then B:=B+170;
     A:=127;
    End;
    $80: Begin
     R:=127; If (I And 1)<>0 Then R:=R+43; If (I And $10)<>0 Then R:=R+85;
     G:=127; If (I And 2)<>0 Then G:=G+43; If (I And $20)<>0 Then G:=G+85;
     B:=127; If (I And 4)<>0 Then B:=B+43; If (I And $40)<>0 Then B:=B+85;
     A:=255;
    End;
    Else Begin
     R:=0; If (I And 1)<>0 Then R:=43; If (I And $10)<>0 Then R:=R+85;
     G:=0; If (I And 2)<>0 Then G:=43; If (I And $20)<>0 Then G:=G+85;
     B:=0; If (I And 4)<>0 Then B:=43; If (I And $40)<>0 Then B:=B+85;
     A:=255;
    End;
   End;
  End;
  DBDefClut.C256[I]:=DBRgba(R,G,B,A);
 End;
End;

Function DBGetObject(Id: LongInt): PDBObject;
Var P: PDBObject;
Begin P:=DBObjects; While (P<>Nil) And (P^.Id<>Id) Do P:=P^.Next; DBGetObject:=
 P; End;
Function DBGetClut(Id: LongInt): PDBClut;
Var P: PDBClut;
Begin P:=DBCluts; While (P<>Nil) And (P^.Id<>Id) Do P:=P^.Next; DBGetClut:=P;
 End;
Function DBGetRegion(Id: LongInt): PDBRegion;
Var P: PDBRegion;
Begin P:=DBRegions; While (P<>Nil) And (P^.Id<>Id) Do P:=P^.Next; DBGetRegion:=
 P; End;

Procedure DBDeleteRegionDisplayList(Rg: PDBRegion);
Var Obj,Obj2: PDBObject; Disp,ObjDisp: PDBObjDisp; Pp: ^PDBObjDisp; Pp2:
 ^PDBObject;
Begin
 While Rg^.DisplayList<>Nil Do Begin
  Disp:=Rg^.DisplayList;
  Obj:=DBGetObject(Disp^.ObjectId);
  If Obj<>Nil Then Begin
   Pp:=@Obj^.DisplayList; ObjDisp:=Pp^;
   While (ObjDisp<>Nil) And (ObjDisp<>Disp) Do Begin Pp:=@ObjDisp^.ObjectNext;
    ObjDisp:=Pp^; End;
   If ObjDisp<>Nil Then Begin
    Pp^:=ObjDisp^.ObjectNext;
    If Obj^.DisplayList=Nil Then Begin
     Pp2:=@DBObjects; Obj2:=Pp2^;
     While Obj2<>Obj Do Begin Pp2:=@Obj2^.Next; Obj2:=Pp2^; End;
     Pp2^:=Obj2^.Next;
     Dispose(Obj2);
    End;
   End;
  End;
  Rg^.DisplayList:=Disp^.RegionNext;
  Dispose(Disp);
 End;
End;

Procedure DBDeleteCluts;
Var C: PDBClut;
Begin While DBCluts<>Nil Do Begin C:=DBCluts; DBCluts:=C^.Next; Dispose(C); End;
 End;
Procedure DBDeleteObjects;
Var O: PDBObject;
Begin While DBObjects<>Nil Do Begin O:=DBObjects; DBObjects:=O^.Next; Dispose(
 O); End; End;
Procedure DBDeleteRegions;
Var R: PDBRegion;
Begin
 While DBRegions<>Nil Do Begin
  R:=DBRegions; DBRegions:=R^.Next;
  DBDeleteRegionDisplayList(R);
  If R^.Pbuf<>Nil Then FreeMem(R^.Pbuf,R^.BufSize+64);
  Dispose(R);
 End;
End;

Procedure DBReset;
Var D: PDBRegDisp;
Begin
 DBDeleteRegions; DBDeleteObjects; DBDeleteCluts;
 While DBDisplays<>Nil Do Begin D:=DBDisplays; DBDisplays:=D^.Next; Dispose(D);
  End;
 DBVersion:=-1; DBTimeOut:=0; DBDefDef:=False; DBHaveSub:=False; DBSubEv:=Nil;
End;

{ lecteur de bits MSB d'une chaine de pixels }
Var DBBitBuf: PEABuffer; DBBitSize,DBBitPos,DBPktLen: LongInt;
Function DBBits(N: LongInt): LongInt;
Var V,I: LongInt;
Begin
 V:=0;
 For I:=1 To N Do Begin
  V:=(V Shl 1) Or ((EAByte(DBBitBuf,DBBitSize,DBBitPos Shr 3) Shr (7-(DBBitPos
   And 7))) And 1);
  Inc(DBBitPos);
 End;
 DBBits:=V;
End;

Type TDBMap=Array[0..15] Of Byte; PDBMap=^TDBMap;

{ Src/Pos: tampon et position (avancee); retourne pixels_read }
Function DBRead2Bit(Dest: PEABuffer; DLen: LongInt; Src: PEABuffer; Var Pos:
 LongInt; BufSize: LongInt; NonMod: LongInt; Map: PDBMap; XPos: LongInt):
 LongInt;
Var Bits,Run,Px,Dp: LongInt;
Procedure Put(V: LongInt);
Begin If Map<>Nil Then V:=Map^[V]; Dest^[Dp]:=V; Inc(Dp); End;
Begin
 DBBitBuf:=PEABuffer(@Src^[Pos]); DBBitSize:=DBPktLen-Pos; DBBitPos:=0;
 Px:=XPos; Dp:=XPos;
 While (DBBitPos<BufSize*8) And (Px<DLen) Do Begin
  Bits:=DBBits(2);
  If Bits<>0 Then Begin
   If (NonMod<>1) Or (Bits<>1) Then Begin Put(Bits); End;
   Inc(Px);
  End Else Begin
   Bits:=DBBits(1);
   If Bits=1 Then Begin
    Run:=DBBits(3)+3; Bits:=DBBits(2);
    If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
    Else Begin
     If Map<>Nil Then Bits:=Map^[Bits];
     While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
      Dec(Run); End;
    End;
   End Else Begin
    Bits:=DBBits(1);
    If Bits=0 Then Begin
     Bits:=DBBits(2);
     If Bits=2 Then Begin
      Run:=DBBits(4)+12; Bits:=DBBits(2);
      If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
      Else Begin
       If Map<>Nil Then Bits:=Map^[Bits];
       While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
        Dec(Run); End;
      End;
     End Else If Bits=3 Then Begin
      Run:=DBBits(8)+29; Bits:=DBBits(2);
      If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
      Else Begin
       If Map<>Nil Then Bits:=Map^[Bits];
       While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
        Dec(Run); End;
      End;
     End Else If Bits=1 Then Begin
      If Map<>Nil Then Bits:=Map^[0] Else Bits:=0;
      Run:=2;
      While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
       Dec(Run); End;
     End Else Begin
      Inc(Pos,(DBBitPos+7) Shr 3); DBRead2Bit:=Px; Exit;
     End;
    End Else Begin
     If Map<>Nil Then Bits:=Map^[0] Else Bits:=0;
     Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
    End;
   End;
  End;
 End;
 DBBits(6);
 Inc(Pos,(DBBitPos+7) Shr 3);
 DBRead2Bit:=Px;
End;

Function DBRead4Bit(Dest: PEABuffer; DLen: LongInt; Src: PEABuffer; Var Pos:
 LongInt; BufSize: LongInt; NonMod: LongInt; Map: PDBMap; XPos: LongInt):
 LongInt;
Var Bits,Run,Px,Dp: LongInt;
Procedure Put(V: LongInt);
Begin If Map<>Nil Then V:=Map^[V]; Dest^[Dp]:=V; Inc(Dp); End;
Begin
 DBBitBuf:=PEABuffer(@Src^[Pos]); DBBitSize:=DBPktLen-Pos; DBBitPos:=0;
 Px:=XPos; Dp:=XPos;
 While (DBBitPos<BufSize*8) And (Px<DLen) Do Begin
  Bits:=DBBits(4);
  If Bits<>0 Then Begin
   If (NonMod<>1) Or (Bits<>1) Then Put(Bits);
   Inc(Px);
  End Else Begin
   Bits:=DBBits(1);
   If Bits=0 Then Begin
    Run:=DBBits(3);
    If Run=0 Then Begin Inc(Pos,(DBBitPos+7) Shr 3); DBRead4Bit:=Px; Exit; End;
    Inc(Run,2);
    If Map<>Nil Then Bits:=Map^[0] Else Bits:=0;
    While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px); Dec(
     Run); End;
   End Else Begin
    Bits:=DBBits(1);
    If Bits=0 Then Begin
     Run:=DBBits(2)+4; Bits:=DBBits(4);
     If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
     Else Begin
      If Map<>Nil Then Bits:=Map^[Bits];
      While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
       Dec(Run); End;
     End;
    End Else Begin
     Bits:=DBBits(2);
     If Bits=2 Then Begin
      Run:=DBBits(4)+9; Bits:=DBBits(4);
      If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
      Else Begin
       If Map<>Nil Then Bits:=Map^[Bits];
       While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
        Dec(Run); End;
      End;
     End Else If Bits=3 Then Begin
      Run:=DBBits(8)+25; Bits:=DBBits(4);
      If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
      Else Begin
       If Map<>Nil Then Bits:=Map^[Bits];
       While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
        Dec(Run); End;
      End;
     End Else If Bits=1 Then Begin
      If Map<>Nil Then Bits:=Map^[0] Else Bits:=0;
      Run:=2;
      While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
       Dec(Run); End;
     End Else Begin
      If Map<>Nil Then Bits:=Map^[0] Else Bits:=0;
      Dest^[Dp]:=Bits; Inc(Dp); Inc(Px);
     End;
    End;
   End;
  End;
 End;
 DBBits(8);
 Inc(Pos,(DBBitPos+7) Shr 3);
 DBRead4Bit:=Px;
End;

Function DBRead8Bit(Dest: PEABuffer; DLen: LongInt; Src: PEABuffer; Var Pos:
 LongInt; BufSize: LongInt; NonMod: LongInt; XPos: LongInt): LongInt;
Var Bits,Run,Px,Dp,SEnd: LongInt;
Begin
 SEnd:=Pos+BufSize; Px:=XPos; Dp:=XPos;
 While (Pos<SEnd) And (Px<DLen) Do Begin
  Bits:=Src^[Pos]; Inc(Pos);
  If Bits<>0 Then Begin
   If (NonMod<>1) Or (Bits<>1) Then Begin Dest^[Dp]:=Bits; Inc(Dp); End;
   Inc(Px);
  End Else Begin
   Bits:=EAByte(Src,DBPktLen,Pos); Inc(Pos);
   Run:=Bits And $7F;
   If (Bits And $80)=0 Then Begin
    If Run=0 Then Begin DBRead8Bit:=Px; Exit; End;
    Bits:=0;
   End Else Begin Bits:=EAByte(Src,DBPktLen,Pos); Inc(Pos); End;
   If (NonMod=1) And (Bits=1) Then Inc(Px,Run)
   Else Begin
    While (Run>0) And (Px<DLen) Do Begin Dest^[Dp]:=Bits; Inc(Dp); Inc(Px); Dec(
     Run); End;
   End;
  End;
 End;
 Inc(Pos);
 DBRead8Bit:=Px;
End;

Procedure DBComputeDefaultClut(Clut: PEABuffer; Pix: PEABuffer; W,H: LongInt);
Var
 List: Array[0..255] Of Byte; ListInv: Array[0..255] Of Byte; CountTab: Array[
  0..255] Of LongInt;
 Count,I,X,Y,V,Vl,Vr,Vt,Vb,Best,BestV,ScoreV,Score: LongInt; Cv: LongInt;
Function Px(Xx,Yy: LongInt): LongInt;
Begin Px:=Pix^[Xx+Yy*W]; End;
Begin
 FillChar(List,SizeOf(List),0); FillChar(CountTab,SizeOf(CountTab),0); FillChar(
  DBCount2,SizeOf(DBCount2),0);
 For Y:=0 To H-1 Do For X:=0 To W-1 Do Begin
  V:=Px(X,Y)+1;
  If X<>0 Then Vl:=Px(X-1,Y)+1 Else Vl:=0;
  If X+1<W Then Vr:=Px(X+1,Y)+1 Else Vr:=0;
  If Y<>0 Then Vt:=Px(X,Y-1)+1 Else Vt:=0;
  If Y+1<H Then Vb:=Px(X,Y+1)+1 Else Vb:=0;
  If (V<>Vl) Or (V<>Vr) Or (V<>Vt) Or (V<>Vb) Then Inc(CountTab[V-1]);
  Inc(DBCount2[Vl,V-1]); Inc(DBCount2[Vr,V-1]); Inc(DBCount2[Vt,V-1]); Inc(
   DBCount2[Vb,V-1]);
 End;
 For I:=0 To 255 Do DBCount2[I+1,I]:=0;
 I:=0;
 While I<256 Do Begin
  Best:=0; BestV:=0;
  For X:=0 To 255 Do Begin
   ScoreV:=0;
   If List[X]<>0 Then Continue;
   Inc(ScoreV,DBCount2[0,X]);
   For Y:=0 To 255 Do Inc(ScoreV,List[Y]*DBCount2[Y+1,X]);
   If ScoreV<>0 Then Begin
    Score:=(Int64(1024)*ScoreV) Div CountTab[X];
    If Score>Best Then Begin Best:=Score; BestV:=X; End;
   End;
  End;
  If Best=0 Then Break;
  List[BestV]:=1; ListInv[I]:=BestV;
  Inc(I);
 End;
 Count:=I-1; If Count<1 Then Count:=1;
 Dec(I);
 While I>=0 Do Begin
  V:=I*255 Div Count;
  Cv:=DBRgba(V Div 2,V,V Div 2,V);
  PLongInt(@Clut^[4*ListInv[I]])^:=Cv;
  Dec(I);
 End;
End;

Type PDBLong=^LongInt;

Procedure DBSaveSubtitleSet(Pts: Int64);
Var
 D: PDBRegDisp; Rg: PDBRegion; E: PXSEv; R: PXSRect; OffX,OffY,I,N: LongInt; Cl:
  PDBClut; UseDef: Boolean; Tab: PDBClut;
Begin
 OffX:=0; OffY:=0;
 If DBHaveSub Then Begin If DBSubEv^.NR>0 Then Exit; XSDropLast; End;
 If DBDefDef Then Begin OffX:=DBDefX; OffY:=DBDefY; End;
 E:=XSNew; E^.T0:=Pts; E^.T1:=Pts+Int64(DBTimeOut)*1000;
 D:=DBDisplays;
 While D<>Nil Do Begin
  Rg:=DBGetRegion(D^.RegionId);
  If (Rg<>Nil) And Rg^.Dirty Then Begin
   R:=XSAddRect(E,D^.XPos+OffX,D^.YPos+OffY,Rg^.Width,Rg^.Height);
   R^.NCol:=1 Shl Rg^.Depth;
   Cl:=DBGetClut(Rg^.Clut); UseDef:=(Cl=Nil);
   If Cl=Nil Then Cl:=@DBDefClut;
   Case Rg^.Depth Of
    2: For I:=0 To 3 Do R^.Pal[I]:=Cl^.C4[I];
    8: For I:=0 To 255 Do R^.Pal[I]:=Cl^.C256[I];
    Else For I:=0 To 15 Do R^.Pal[I]:=Cl^.C16[I];
   End;
   If Rg^.BufSize>0 Then Move(Rg^.Pbuf^,R^.Bmp^,Rg^.BufSize);
   If UseDef Then Begin
    If Not Rg^.HasComputed Then Begin
     FillChar(Rg^.Computed,SizeOf(Rg^.Computed),0);
     DBComputeDefaultClut(PEABuffer(@Rg^.Computed),R^.Bmp,R^.W,R^.H);
     Rg^.HasComputed:=True;
    End;
    For I:=0 To 255 Do R^.Pal[I]:=PDBLong(@Rg^.Computed[4*I])^;
   End;
  End;
  D:=D^.Next;
 End;
 DBSubEv:=E; DBHaveSub:=True;
End;

Procedure DBParsePixelBlock(Disp: PDBObjDisp; Buf: PEABuffer; Pos0,BufSize,
 TopBottom,NonMod: LongInt);
Var
 Rg: PDBRegion; Pos,BufEnd,XPos,YPos,I: LongInt; Pbuf: PEABuffer;
 Map2To4: TDBMap; Map2To8: TDBMap; Map4To8: TDBMap; Map: PDBMap; Op: LongInt;
Begin
 Rg:=DBGetRegion(Disp^.RegionId);
 FillChar(Map2To4,SizeOf(Map2To4),0); Map2To4[0]:=0; Map2To4[1]:=7; Map2To4[2]:=
  8; Map2To4[3]:=15;
 FillChar(Map2To8,SizeOf(Map2To8),0); Map2To8[0]:=0; Map2To8[1]:=$77; Map2To8[
  2]:=$88; Map2To8[3]:=$FF;
 For I:=0 To 15 Do Map4To8[I]:=I*17;
 If Rg=Nil Then Exit;
 Pbuf:=Rg^.Pbuf; Rg^.Dirty:=True;
 XPos:=Disp^.XPos; YPos:=Disp^.YPos+TopBottom;
 Pos:=Pos0; BufEnd:=Pos0+BufSize;
 While Pos<BufEnd Do Begin
  If ((Buf^[Pos]<>$F0) And (XPos>=Rg^.Width)) Or (YPos>=Rg^.Height) Then Exit;
  Op:=Buf^[Pos]; Inc(Pos);
  Case Op Of
   $10: Begin
    If Rg^.Depth=8 Then Map:=@Map2To8 Else If Rg^.Depth=4 Then Map:=@Map2To4
     Else Map:=Nil;
    XPos:=DBRead2Bit(PEABuffer(@Pbuf^[YPos*Rg^.Width]),Rg^.Width,Buf,Pos,BufEnd-
     Pos,NonMod,Map,XPos);
   End;
   $11: Begin
    If Rg^.Depth<4 Then Exit;
    If Rg^.Depth=8 Then Map:=@Map4To8 Else Map:=Nil;
    XPos:=DBRead4Bit(PEABuffer(@Pbuf^[YPos*Rg^.Width]),Rg^.Width,Buf,Pos,BufEnd-
     Pos,NonMod,Map,XPos);
   End;
   $12: Begin
    If Rg^.Depth<8 Then Exit;
    XPos:=DBRead8Bit(PEABuffer(@Pbuf^[YPos*Rg^.Width]),Rg^.Width,Buf,Pos,BufEnd-
     Pos,NonMod,XPos);
   End;
   $20: Begin
    Map2To4[0]:=Buf^[Pos] Shr 4; Map2To4[1]:=Buf^[Pos] And 15; Inc(Pos);
    Map2To4[2]:=Buf^[Pos] Shr 4; Map2To4[3]:=Buf^[Pos] And 15; Inc(Pos);
   End;
   $21: For I:=0 To 3 Do Begin Map2To8[I]:=EAByte(Buf,DBPktLen,Pos); Inc(Pos);
    End;
   $22: For I:=0 To 15 Do Begin Map4To8[I]:=EAByte(Buf,DBPktLen,Pos); Inc(Pos);
    End;
   $F0: Begin XPos:=Disp^.XPos; Inc(YPos,2); End;
   Else ;
  End;
 End;
 { has_computed_clut est remis a zero sauf compute_clut == -2 }
 Rg^.HasComputed:=False;
End;

Function DBParseObjectSegment(Buf: PEABuffer; Pos,Size: LongInt): LongInt;
Var
 BufEnd,ObjectId,Coding,NonMod,TopLen,BotLen,Bfl,Block: LongInt; Obj: PDBObject;
  Disp: PDBObjDisp; B: LongInt;
Begin
 DBParseObjectSegment:=0; BufEnd:=Pos+Size;
 ObjectId:=EAByte(Buf,DBPktLen,Pos)*256+EAByte(Buf,DBPktLen,Pos+1); Inc(Pos,2);
 Obj:=DBGetObject(ObjectId);
 If Obj=Nil Then Begin DBParseObjectSegment:=-1; Exit; End;
 B:=EAByte(Buf,DBPktLen,Pos); Inc(Pos);
 Coding:=(B Shr 2) And 3; NonMod:=(B Shr 1) And 1;
 If Coding=0 Then Begin
  TopLen:=EAByte(Buf,DBPktLen,Pos)*256+EAByte(Buf,DBPktLen,Pos+1); Inc(Pos,2);
  BotLen:=EAByte(Buf,DBPktLen,Pos)*256+EAByte(Buf,DBPktLen,Pos+1); Inc(Pos,2);
  If Pos+TopLen+BotLen>BufEnd Then Begin DBParseObjectSegment:=-1; Exit; End;
  Disp:=Obj^.DisplayList;
  While Disp<>Nil Do Begin
   Block:=Pos; Bfl:=BotLen;
   DBParsePixelBlock(Disp,Buf,Block,TopLen,0,NonMod);
   If BotLen>0 Then Block:=Pos+TopLen Else Bfl:=TopLen;
   DBParsePixelBlock(Disp,Buf,Block,Bfl,1,NonMod);
   Disp:=Disp^.ObjectNext;
  End;
 End Else If (Coding=1) Or (Coding=2) Then DBParseObjectSegment:=-2
 Else DBParseObjectSegment:=-1;
End;

Function DBParseClutSegment(Buf: PEABuffer; Pos,Size: LongInt): LongInt;
Var
 BufEnd,ClutId,Version,EntryId,Depth,FullRange,Y,Cr,Cb,Alpha,Rgb: LongInt; Cl:
  PDBClut; B0,B1: LongInt;
Begin
 DBParseClutSegment:=0; BufEnd:=Pos+Size;
 ClutId:=Buf^[Pos]; Inc(Pos);
 Version:=(Buf^[Pos] Shr 4) And 15; Inc(Pos);
 Cl:=DBGetClut(ClutId);
 If Cl=Nil Then Begin
  New(Cl); Cl^:=DBDefClut; Cl^.Id:=ClutId; Cl^.Version:=-1; Cl^.Next:=DBCluts;
   DBCluts:=Cl;
 End;
 If Cl^.Version<>Version Then Begin
  Cl^.Version:=Version;
  While Pos+4<BufEnd Do Begin
   EntryId:=Buf^[Pos]; Inc(Pos);
   Depth:=Buf^[Pos] And $E0; FullRange:=Buf^[Pos] And 1; Inc(Pos);
   If FullRange<>0 Then Begin
    Y:=Buf^[Pos]; Cr:=Buf^[Pos+1]; Cb:=Buf^[Pos+2]; Alpha:=Buf^[Pos+3]; Inc(Pos,
     4);
   End Else Begin
    B0:=Buf^[Pos]; B1:=Buf^[Pos+1];
    Y:=B0 And $FC;
    Cr:=(((B0 And 3) Shl 2) Or ((B1 Shr 6) And 3)) Shl 4;
    Cb:=(B1 Shl 2) And $F0;
    Alpha:=(B1 Shl 6) And $C0;
    Inc(Pos,2);
   End;
   If Y=0 Then Alpha:=$FF;
   Rgb:=DSUYuvToRgb(Y,Cb,Cr);
   If ((Depth And $80)<>0) And (EntryId<4) Then Cl^.C4[EntryId]:=Rgb Or (Int64(
    255-Alpha) Shl 24)
   Else If ((Depth And $40)<>0) And (EntryId<16) Then Cl^.C16[EntryId]:=Rgb Or (
    Int64(255-Alpha) Shl 24)
   Else If (Depth And $20)<>0 Then Cl^.C256[EntryId]:=Rgb Or (Int64(255-Alpha)
    Shl 24);
  End;
 End;
End;

Function DBParseRegionSegment(Buf: PEABuffer; Pos,Size: LongInt): LongInt;
Var
 BufEnd,RegionId,ObjectId,Fill,B: LongInt; Rg: PDBRegion; Obj: PDBObject; Disp:
  PDBObjDisp; Ok: Boolean;
Begin
 DBParseRegionSegment:=0; BufEnd:=Pos+Size;
 If Size<10 Then Begin DBParseRegionSegment:=-1; Exit; End;
 RegionId:=Buf^[Pos]; Inc(Pos);
 Rg:=DBGetRegion(RegionId);
 If Rg=Nil Then Begin
  New(Rg); FillChar(Rg^,SizeOf(Rg^),0); Rg^.Id:=RegionId; Rg^.Version:=-1;
   Rg^.Next:=DBRegions; DBRegions:=Rg;
 End;
 Fill:=(Buf^[Pos] Shr 3) And 1; Inc(Pos);
 Rg^.Width:=Buf^[Pos]*256+Buf^[Pos+1]; Inc(Pos,2);
 Rg^.Height:=Buf^[Pos]*256+Buf^[Pos+1]; Inc(Pos,2);
 Ok:=(Rg^.Width>0) And (Rg^.Height>0) And ((Int64(Rg^.Width)+128)*(Int64(
  Rg^.Height)+128)<268435455) And (Int64(Rg^.Width)*Rg^.Height*2<=320*1024*8);
 If Not Ok Then Begin
  { av_image_check_size2 refuse aussi 0xN: region->width=height=0 }
  Rg^.Width:=0; Rg^.Height:=0; DBParseRegionSegment:=-1; Exit;
 End;
 If Rg^.Width*Rg^.Height<>Rg^.BufSize Then Begin
  If Rg^.Pbuf<>Nil Then FreeMem(Rg^.Pbuf,Rg^.BufSize+64);
  Rg^.BufSize:=Rg^.Width*Rg^.Height;
  GetMem(Rg^.Pbuf,Rg^.BufSize+64); FillChar(Rg^.Pbuf^,Rg^.BufSize+64,0);
  Fill:=1; Rg^.Dirty:=False;
 End;
 B:=(Buf^[Pos] Shr 2) And 7; Inc(Pos);
 Rg^.Depth:=1 Shl B;
 If (Rg^.Depth<2) Or (Rg^.Depth>8) Then Rg^.Depth:=4;
 Rg^.Clut:=Buf^[Pos]; Inc(Pos);
 If Rg^.Depth=8 Then Begin Rg^.Bgcolor:=Buf^[Pos]; Inc(Pos,2); End
 Else Begin
  Inc(Pos);
  If Rg^.Depth=4 Then Rg^.Bgcolor:=(Buf^[Pos] Shr 4) And 15 Else Rg^.Bgcolor:=(
   Buf^[Pos] Shr 2) And 3;
  Inc(Pos);
 End;
 If Fill<>0 Then FillChar(Rg^.Pbuf^,Rg^.BufSize,Rg^.Bgcolor);
 DBDeleteRegionDisplayList(Rg);
 While Pos+5<BufEnd Do Begin
  ObjectId:=Buf^[Pos]*256+Buf^[Pos+1]; Inc(Pos,2);
  Obj:=DBGetObject(ObjectId);
  If Obj=Nil Then Begin
   New(Obj); FillChar(Obj^,SizeOf(Obj^),0); Obj^.Id:=ObjectId; Obj^.Next:=
    DBObjects; DBObjects:=Obj;
  End;
  Obj^.Typ:=Buf^[Pos] Shr 6;
  New(Disp); FillChar(Disp^,SizeOf(Disp^),0);
  Disp^.ObjectId:=ObjectId; Disp^.RegionId:=RegionId;
  Disp^.XPos:=(Buf^[Pos]*256+Buf^[Pos+1]) And $FFF; Inc(Pos,2);
  Disp^.YPos:=(Buf^[Pos]*256+Buf^[Pos+1]) And $FFF; Inc(Pos,2);
  If (Disp^.XPos>=Rg^.Width) Or (Disp^.YPos>=Rg^.Height) Then Begin Dispose(
   Disp); DBParseRegionSegment:=-1; Exit; End;
  If ((Obj^.Typ=1) Or (Obj^.Typ=2)) And (Pos+1<BufEnd) Then Begin Disp^.Fg:=
   Buf^[Pos]; Disp^.Bg:=Buf^[Pos+1]; Inc(Pos,2); End;
  Disp^.RegionNext:=Rg^.DisplayList; Rg^.DisplayList:=Disp;
  Disp^.ObjectNext:=Obj^.DisplayList; Obj^.DisplayList:=Disp;
 End;
End;

Function DBParsePageSegment(Buf: PEABuffer; Pos,Size: LongInt; Pts: Int64):
 LongInt;
Var
 BufEnd,Timeout,Version,PageState,RegionId: LongInt; D,Tmp,Cur: PDBRegDisp; Pp:
  ^PDBRegDisp; Dup: Boolean;
Begin
 DBParsePageSegment:=0; BufEnd:=Pos+Size;
 If Size<1 Then Begin DBParsePageSegment:=-1; Exit; End;
 Timeout:=Buf^[Pos]; Inc(Pos);
 Version:=(Buf^[Pos] Shr 4) And 15; PageState:=(Buf^[Pos] Shr 2) And 3; Inc(
  Pos);
 If DBVersion=Version Then Exit;
 DBTimeOut:=Timeout; DBVersion:=Version;
 If (PageState=1) Or (PageState=2) Then Begin DBDeleteRegions; DBDeleteObjects;
  DBDeleteCluts; End;
 Tmp:=DBDisplays; DBDisplays:=Nil;
 While Pos+5<BufEnd Do Begin
  RegionId:=Buf^[Pos]; Inc(Pos,2);
  D:=DBDisplays; While (D<>Nil) And (D^.RegionId<>RegionId) Do D:=D^.Next;
  If D<>Nil Then Break;
  D:=Tmp; Pp:=@Tmp;
  While (D<>Nil) And (D^.RegionId<>RegionId) Do Begin Pp:=@D^.Next; D:=D^.Next;
   End;
  If D=Nil Then Begin New(D); FillChar(D^,SizeOf(D^),0); End;
  D^.RegionId:=RegionId;
  D^.XPos:=Buf^[Pos]*256+Buf^[Pos+1]; Inc(Pos,2);
  D^.YPos:=Buf^[Pos]*256+Buf^[Pos+1]; Inc(Pos,2);
  Pp^:=D^.Next;
  D^.Next:=DBDisplays; DBDisplays:=D;
 End;
 While Tmp<>Nil Do Begin D:=Tmp; Tmp:=D^.Next; Dispose(D); End;
End;

Function DBParseDisplayDefinition(Buf: PEABuffer; Pos,Size: LongInt): LongInt;
Var Info,Ver: LongInt;
Begin
 DBParseDisplayDefinition:=0;
 If Size<5 Then Begin DBParseDisplayDefinition:=-1; Exit; End;
 Info:=Buf^[Pos]; Inc(Pos); Ver:=Info Shr 4;
 If DBDefDef And (DBDefVersion=Ver) Then Exit;
 DBDefDef:=True; DBDefVersion:=Ver; DBDefX:=0; DBDefY:=0;
 DBDefW:=Buf^[Pos]*256+Buf^[Pos+1]+1; DBDefH:=Buf^[Pos+2]*256+Buf^[Pos+3]+1;
  Inc(Pos,4);
 If (XSW=0) Or (XSH=0) Then Begin XSW:=DBDefW; XSH:=DBDefH; End;
 If (Info And 8)<>0 Then Begin
  If Size<13 Then Begin DBParseDisplayDefinition:=-1; Exit; End;
  DBDefX:=Buf^[Pos]*256+Buf^[Pos+1]; DBDefW:=Buf^[Pos+2]*256+Buf^[Pos+3]-DBDefX+
   1;
  DBDefY:=Buf^[Pos+4]*256+Buf^[Pos+5]; DBDefH:=Buf^[Pos+6]*256+Buf^[Pos+7]-
   DBDefY+1;
 End;
End;

{ un paquet = segments 0x0F...; retourne True si un ensemble d'affichage est
 produit (dans DBSubEv) }
Function DBDecodePacket(Buf: PEABuffer; Size: LongInt; Pts: Int64): Boolean;
Var P,PEnd,SegType,SegLen,Got,GotDds: LongInt; Ret: LongInt;
Begin
 DBDecodePacket:=False; DBHaveSub:=False; DBSubEv:=Nil; DBPktLen:=Size;
 DBInitDefaults;
 If (Size<=6) Or (Buf^[0]<>$0F) Then Exit;
 P:=0; PEnd:=Size; Got:=0; GotDds:=0;
 While (PEnd-P>=6) And (Buf^[P]=$0F) Do Begin
  SegType:=Buf^[P+1]; SegLen:=Buf^[P+4]*256+Buf^[P+5]; Inc(P,6);
  If PEnd-P<SegLen Then Break;
  Ret:=0;
  Case SegType Of
   $10: Begin Ret:=DBParsePageSegment(Buf,P,SegLen,Pts); Got:=Got Or 1; End;
   $11: Begin Ret:=DBParseRegionSegment(Buf,P,SegLen); Got:=Got Or 2; End;
   $12: Begin Ret:=DBParseClutSegment(Buf,P,SegLen); Got:=Got Or 4; End;
   $13: Begin Ret:=DBParseObjectSegment(Buf,P,SegLen); Got:=Got Or 8; End;
   $14: Begin Ret:=DBParseDisplayDefinition(Buf,P,SegLen); GotDds:=1; End;
   $80: Begin
    If Not DBHaveSub Then DBSaveSubtitleSet(Pts);
    If (Got=15) And (GotDds=0) And ((XSW=0) Or (XSH=0)) Then Begin XSW:=720;
     XSH:=576; End;
    Got:=Got Or 16;
   End;
   Else ;
  End;
  If Ret<0 Then Begin
   If DBHaveSub Then Begin XSDropLast; DBHaveSub:=False; DBSubEv:=Nil; End;
   Exit;
  End;
  Inc(P,SegLen);
 End;
 If Got=15 Then Begin If Not DBHaveSub Then DBSaveSubtitleSet(Pts); End;
 DBDecodePacket:=DBHaveSub;
End;

{ ---- DVB subtitles: encodeur (libavcodec/dvbsubenc.c), MPEG-TS et flux brut
 ---- }
Var DBeOut: PEABuffer; DBeQ,DBeBb,DBeBc: LongInt; DBeObjVer: LongInt;

Function DBeHeight(R: PXSRect): LongInt;
Begin DBeHeight:=R^.H; End;

Procedure DBeP8(V: LongInt);Begin DBeOut^[DBeQ]:=V And 255; Inc(DBeQ); End;
Procedure DBeP16(V: LongInt);Begin DBeP8(V Shr 8); DBeP8(V); End;
Procedure DBePatch16(At,V: LongInt);Begin DBeOut^[At]:=(V Shr 8) And 255;
 DBeOut^[At+1]:=V And 255; End;

Procedure DBePut2(V: LongInt);
Begin
 DBeBb:=DBeBb Or (V Shl DBeBc); Dec(DBeBc,2);
 If DBeBc<0 Then Begin DBeBc:=6; DBeP8(DBeBb); DBeBb:=0; End;
End;
Procedure DBePut4(V: LongInt);
Begin
 DBeBb:=DBeBb Or (V Shl DBeBc); Dec(DBeBc,4);
 If DBeBc<0 Then Begin DBeBc:=4; DBeP8(DBeBb); DBeBb:=0; End;
End;

{ retourne la taille ou -1 si le tampon est trop petit }
Function DBeRle2(Bmp: PEABuffer; Linesize,W,H,BufSize: LongInt): LongInt;
Var Y,X,X1,Len,V,Color,Q0,LineBegin: LongInt; Base: LongInt;
Begin
 Q0:=DBeQ; Base:=0;
 For Y:=0 To H-1 Do Begin
  If BufSize*8<W*3+32 Then Begin DBeRle2:=-1; Exit; End;
  LineBegin:=DBeQ;
  DBeP8($10); DBeBb:=0; DBeBc:=6;
  X:=0;
  While X<W Do Begin
   X1:=X; Color:=Bmp^[Base+X1]; Inc(X1);
   While (X1<W) And (Bmp^[Base+X1]=Color) Do Inc(X1);
   Len:=X1-X;
   If (Color=0) And (Len=2) Then Begin DBePut2(0); DBePut2(0); DBePut2(1); End
   Else If (Len>=3) And (Len<=10) Then Begin
    V:=Len-3; DBePut2(0); DBePut2((V Shr 2) Or 2); DBePut2(V And 3); DBePut2(
     Color);
   End Else If (Len>=12) And (Len<=27) Then Begin
    V:=Len-12; DBePut2(0); DBePut2(0); DBePut2(2); DBePut2(V Shr 2); DBePut2(V
     And 3); DBePut2(Color);
   End Else If Len>=29 Then Begin
    If Len>284 Then Len:=284;
    V:=Len-29; DBePut2(0); DBePut2(0); DBePut2(3); DBePut2(V Shr 6); DBePut2((V
     Shr 4) And 3); DBePut2((V Shr 2) And 3); DBePut2(V And 3); DBePut2(Color);
   End Else Begin
    DBePut2(Color);
    If Color=0 Then DBePut2(1);
    Len:=1;
   End;
   Inc(X,Len);
  End;
  DBePut2(0); DBePut2(0); DBePut2(0);
  If DBeBc<>6 Then DBeP8(DBeBb);
  DBeP8($F0);
  Inc(Base,Linesize);
  Dec(BufSize,DBeQ-LineBegin);
 End;
 DBeRle2:=DBeQ-Q0;
End;

Function DBeRle4(Bmp: PEABuffer; Linesize,W,H,BufSize: LongInt): LongInt;
Var Y,X,X1,Len,V,Color,Q0,LineBegin: LongInt; Base: LongInt;
Begin
 Q0:=DBeQ; Base:=0;
 For Y:=0 To H-1 Do Begin
  If BufSize*8<W*6+32 Then Begin DBeRle4:=-1; Exit; End;
  LineBegin:=DBeQ;
  DBeP8($11); DBeBb:=0; DBeBc:=4;
  X:=0;
  While X<W Do Begin
   X1:=X; Color:=Bmp^[Base+X1]; Inc(X1);
   While (X1<W) And (Bmp^[Base+X1]=Color) Do Inc(X1);
   Len:=X1-X;
   If (Color=0) And (Len=2) Then Begin DBePut4(0); DBePut4($D); End
   Else If (Color=0) And (Len>=3) And (Len<=9) Then Begin DBePut4(0); DBePut4(
    Len-2); End
   Else If (Len>=4) And (Len<=7) Then Begin DBePut4(0); DBePut4(8+Len-4);
    DBePut4(Color); End
   Else If (Len>=9) And (Len<=24) Then Begin DBePut4(0); DBePut4($E); DBePut4(
    Len-9); DBePut4(Color); End
   Else If Len>=25 Then Begin
    If Len>280 Then Len:=280;
    V:=Len-25; DBePut4(0); DBePut4($F); DBePut4(V Shr 4); DBePut4(V And $F);
     DBePut4(Color);
   End Else Begin
    DBePut4(Color);
    If Color=0 Then DBePut4($C);
    Len:=1;
   End;
   Inc(X,Len);
  End;
  DBePut4(0); DBePut4(0);
  If DBeBc<>4 Then DBeP8(DBeBb);
  DBeP8($F0);
  Inc(Base,Linesize);
  Dec(BufSize,DBeQ-LineBegin);
 End;
 DBeRle4:=DBeQ-Q0;
End;

Function DBeRle8(Bmp: PEABuffer; Linesize,W,H,BufSize: LongInt): LongInt;
Var Y,X,X1,Len,Color,Q0,LineBegin: LongInt; Base: LongInt;
Begin
 Q0:=DBeQ; Base:=0;
 For Y:=0 To H-1 Do Begin
  If BufSize*8<W*12+24 Then Begin DBeRle8:=-1; Exit; End;
  LineBegin:=DBeQ;
  DBeP8($12);
  X:=0;
  While X<W Do Begin
   X1:=X; Color:=Bmp^[Base+X1]; Inc(X1);
   While (X1<W) And (Bmp^[Base+X1]=Color) Do Inc(X1);
   Len:=X1-X;
   If (Len=1) And (Color<>0) Then DBeP8(Color)
   Else Begin
    If Color=0 Then Begin
     If Len>127 Then Len:=127;
     DBeP8(0); DBeP8(Len);
    End Else If Len>2 Then Begin
     If Len>127 Then Len:=127;
     DBeP8(0); DBeP8($80+Len); DBeP8(Color);
    End Else If Len=2 Then Begin DBeP8(Color); DBeP8(Color); End
    Else Begin DBeP8(Color); Len:=1; End;
   End;
   Inc(X,Len);
  End;
  DBeP8(0); DBeP8($F0);
  Inc(Base,Linesize);
  Dec(BufSize,DBeQ-LineBegin);
 End;
 DBeRle8:=DBeQ-Q0;
End;

Function DBeRgbY(R,G,B: LongInt): LongInt;
Begin DBeRgbY:=AVSar(263*R+516*G+100*B+512+(16 Shl 10),10); End;
Function DBeRgbU(R,G,B: LongInt): LongInt;
Begin DBeRgbU:=AVSar(-152*R-298*G+450*B+512-1,10)+128; End;
Function DBeRgbV(R,G,B: LongInt): LongInt;
Begin DBeRgbV:=AVSar(450*R-377*G-73*B+512-1,10)+128; End;

{ ffmpeg n'encode que h>>1 lignes par trame: une hauteur impaire perdrait la
 derniere ligne; on ajoute une ligne transparente }
Procedure DBePadEven(E: PXSEv);
Var I,J,T: LongInt; R: PXSRect; Nb: PEABuffer;
Begin
 For I:=0 To E^.NR-1 Do Begin
  R:=E^.Rc[I];
  If (R^.H And 1)=0 Then Continue;
  T:=-1;
  For J:=0 To R^.NCol-1 Do If ((R^.Pal[J] Shr 24) And 255)=0 Then Begin T:=J;
   Break; End;
  If T<0 Then Begin
   If R^.NCol>=256 Then Continue;
   T:=R^.NCol; R^.Pal[T]:=0; Inc(R^.NCol);
  End;
  GetMem(Nb,R^.W*(R^.H+1)+64);
  Move(R^.Bmp^,Nb^,R^.W*R^.H);
  FillChar(Nb^[R^.W*R^.H],R^.W,T);
  FreeMem(R^.Bmp,R^.W*R^.H+64);
  R^.Bmp:=Nb; Inc(R^.H);
 End;
End;

{ ensemble d'affichage DVB pour E (Nil = page vide); retourne la taille ou -1 }
Function DBeEncode(E: PXSEv; Out: PEABuffer; BufSize: LongInt): LongInt;
Var
 PageId,I,J,Bpp,NR,SegStart,Cnt,Ret,TopLen,BotLen,TopPtr,BotPtr,Ptop,Pbot,Hh:
  LongInt; Rc: PXSRect; Pb: PEABuffer; X: LongInt; A,R,G,B: LongInt;
Begin
 DBeOut:=Out; DBeQ:=0; PageId:=1; DBeEncode:=-1;
 If E=Nil Then NR:=0 Else NR:=E^.NR;
 If (E<>Nil) And XSFromPng Then DBePadEven(E);
 If (XSW>0) And (XSH>0) Then Begin
  If BufSize<11 Then Exit;
  DBeP8($0F); DBeP8($14); DBeP16(PageId); SegStart:=DBeQ; DBeQ:=DBeQ+2;
  DBeP8(0); DBeP16(XSW-1); DBeP16(XSH-1);
  DBePatch16(SegStart,DBeQ-SegStart-2);
  Dec(BufSize,11);
 End;
 If BufSize<8+NR*6 Then Exit;
 DBeP8($0F); DBeP8($10); DBeP16(PageId); SegStart:=DBeQ; DBeQ:=DBeQ+2;
 DBeP8(30);
 DBeP8((DBeObjVer Shl 4) Or (2 Shl 2) Or 3);
 For I:=0 To NR-1 Do Begin
  DBeP8(I); DBeP8($FF); DBeP16(E^.Rc[I]^.X); DBeP16(E^.Rc[I]^.Y);
 End;
 DBePatch16(SegStart,DBeQ-SegStart-2);
 Dec(BufSize,8+NR*6);
 If NR>0 Then Begin
  For I:=0 To NR-1 Do Begin
   Rc:=E^.Rc[I];
   If BufSize<6+Rc^.NCol*6 Then Exit;
   If Rc^.NCol<=4 Then Bpp:=0 Else If Rc^.NCol<=16 Then Bpp:=1 Else If
    Rc^.NCol<=256 Then Bpp:=2 Else Exit;
   DBeP8($0F); DBeP8($12); DBeP16(PageId); SegStart:=DBeQ; DBeQ:=DBeQ+2;
   DBeP8(I); DBeP8($0F);
   For J:=0 To Rc^.NCol-1 Do Begin
    DBeP8(J);
    DBeP8((1 Shl (7-Bpp)) Or (15 Shl 1) Or 1);
    X:=Rc^.Pal[J] And $FFFFFFFF;
    A:=(X Shr 24) And 255; R:=(X Shr 16) And 255; G:=(X Shr 8) And 255; B:=X And
     255;
    DBeP8(DBeRgbY(R,G,B)); DBeP8(DBeRgbV(R,G,B)); DBeP8(DBeRgbU(R,G,B)); DBeP8(
     255-A);
   End;
   DBePatch16(SegStart,DBeQ-SegStart-2);
   Dec(BufSize,6+Rc^.NCol*6);
  End;
  If BufSize<NR*22 Then Exit;
  For I:=0 To NR-1 Do Begin
   Rc:=E^.Rc[I];
   If Rc^.NCol<=4 Then Bpp:=0 Else If Rc^.NCol<=16 Then Bpp:=1 Else If
    Rc^.NCol<=256 Then Bpp:=2 Else Exit;
   DBeP8($0F); DBeP8($11); DBeP16(PageId); SegStart:=DBeQ; DBeQ:=DBeQ+2;
   DBeP8(I); DBeP8((DBeObjVer Shl 4) Or 7);
   DBeP16(Rc^.W); DBeP16(Rc^.H);
   DBeP8(((1+Bpp) Shl 5) Or ((1+Bpp) Shl 2) Or 3);
   DBeP8(I); DBeP8(0); DBeP8(3);
   DBeP16(I); DBeP8(0); DBeP8(0); DBeP8($F0); DBeP8(0);
   DBePatch16(SegStart,DBeQ-SegStart-2);
  End;
  Dec(BufSize,NR*22);
  For I:=0 To NR-1 Do Begin
   Rc:=E^.Rc[I]; Hh:=DBeHeight(Rc);
   If BufSize<13 Then Exit;
   DBeP8($0F); DBeP8($13); DBeP16(PageId); SegStart:=DBeQ; DBeQ:=DBeQ+2;
   DBeP16(I);
   DBeP8((DBeObjVer Shl 4) Or 1);
   Ptop:=DBeQ; DBeQ:=DBeQ+2; Pbot:=DBeQ; DBeQ:=DBeQ+2;
   Dec(BufSize,13);
   TopPtr:=DBeQ;
   Pb:=Rc^.Bmp;
   If Rc^.NCol<=4 Then Ret:=DBeRle2(Pb,Rc^.W*2,Rc^.W,Hh Shr 1,BufSize)
   Else If Rc^.NCol<=16 Then Ret:=DBeRle4(Pb,Rc^.W*2,Rc^.W,Hh Shr 1,BufSize)
   Else Ret:=DBeRle8(Pb,Rc^.W*2,Rc^.W,Hh Shr 1,BufSize);
   If Ret<0 Then Exit;
   Dec(BufSize,Ret);
   BotPtr:=DBeQ;
   If Rc^.NCol<=4 Then Ret:=DBeRle2(PEABuffer(@Pb^[Rc^.W]),Rc^.W*2,Rc^.W,Hh Shr
    1,BufSize)
   Else If Rc^.NCol<=16 Then Ret:=DBeRle4(PEABuffer(@Pb^[Rc^.W]),Rc^.W*2,Rc^.W,
    Hh Shr 1,BufSize)
   Else Ret:=DBeRle8(PEABuffer(@Pb^[Rc^.W]),Rc^.W*2,Rc^.W,Hh Shr 1,BufSize);
   If Ret<0 Then Exit;
   Dec(BufSize,Ret);
   DBePatch16(Ptop,BotPtr-TopPtr); DBePatch16(Pbot,DBeQ-BotPtr);
   DBePatch16(SegStart,DBeQ-SegStart-2);
  End;
 End;
 If BufSize<6 Then Exit;
 DBeP8($0F); DBeP8($80); DBeP16(PageId); SegStart:=DBeQ; DBeQ:=DBeQ+2;
 DBePatch16(SegStart,DBeQ-SegStart-2);
 DBeObjVer:=(DBeObjVer+1) And 15;
 DBeEncode:=DBeQ;
End;

{ ---- MPEG-TS: ecriture PAT/PMT et PES de sous-titres DVB ---- }
Var XSCrcTab: Array[0..255] Of Int64; XSCrcReady: Boolean; XSTsCc: Array[
 0..8191] Of Byte;

Procedure XSCrcInit;
Var I,K: LongInt; C: Int64;
Begin
 For I:=0 To 255 Do Begin
  C:=Int64(I) Shl 24;
  For K:=1 To 8 Do If (C And $80000000)<>0 Then C:=((C Shl 1) Xor $04C11DB7) And
   $FFFFFFFF Else C:=(C Shl 1) And $FFFFFFFF;
  XSCrcTab[I]:=C;
 End;
 XSCrcReady:=True;
End;

Function XSMpegCrc(B: PEABuffer; Len: LongInt): Int64;
Var I: LongInt; C: Int64;
Begin
 If Not XSCrcReady Then XSCrcInit;
 C:=$FFFFFFFF;
 For I:=0 To Len-1 Do C:=((C Shl 8) And $FFFFFFFF) Xor XSCrcTab[((C Shr 24) Xor
  B^[I]) And 255];
 XSMpegCrc:=C;
End;

{ ecrit un paquet TS sur la sortie ouverte }
Procedure XSTsPacket(Pid: LongInt; Pusi: Boolean; Data: PEABuffer; Len:
 LongInt);
Var Pk: Array[0..187] Of Byte; Af,I: LongInt;
Begin
 FillChar(Pk,SizeOf(Pk),$FF);
 Pk[0]:=$47; Pk[1]:=(Pid Shr 8) And $1F; If Pusi Then Pk[1]:=Pk[1] Or $40; Pk[
  2]:=Pid And 255;
 If Len>=184 Then Begin
  Pk[3]:=$10 Or (XSTsCc[Pid] And 15); Move(Data^,Pk[4],184);
 End Else Begin
  Pk[3]:=$30 Or (XSTsCc[Pid] And 15);
  Af:=183-Len; Pk[4]:=Af;
  If Af>0 Then Begin Pk[5]:=0; End;
  Move(Data^,Pk[4+1+Af],Len);
 End;
 XSTsCc[Pid]:=(XSTsCc[Pid]+1) And 15;
 WriteBytes(Pk,188);
End;

Procedure XSTsPsi(Pid: LongInt; Sec: PEABuffer; Len: LongInt);
Var Buf: Array[0..183] Of Byte; Crc: Int64;
Begin
 FillChar(Buf,SizeOf(Buf),$FF);
 Buf[0]:=0; Move(Sec^,Buf[1],Len);
 XSTsPacket(Pid,True,PEABuffer(@Buf),184);
End;

Procedure XSTsWritePatPmt(SubPid: LongInt);
Var Sec: Array[0..255] Of Byte; N: LongInt; Crc: Int64;
Begin
 { PAT }
 FillChar(Sec,SizeOf(Sec),0);
 Sec[0]:=$00; Sec[1]:=$B0; Sec[2]:=13; Sec[3]:=0; Sec[4]:=1; Sec[5]:=$C1; Sec[
  6]:=0; Sec[7]:=0;
 Sec[8]:=0; Sec[9]:=1; Sec[10]:=$E0 Or ($1000 Shr 8); Sec[11]:=$1000 And 255;
 Crc:=XSMpegCrc(PEABuffer(@Sec),12);
 Sec[12]:=(Crc Shr 24) And 255; Sec[13]:=(Crc Shr 16) And 255; Sec[14]:=(Crc Shr
  8) And 255; Sec[15]:=Crc And 255;
 XSTsPsi(0,PEABuffer(@Sec),16);
 { PMT: un flux sous-titres 0x06 avec descripteur subtitling 0x59 }
 FillChar(Sec,SizeOf(Sec),0);
 Sec[0]:=2; Sec[1]:=$B0; Sec[2]:=0; Sec[3]:=0; Sec[4]:=1; Sec[5]:=$C1; Sec[6]:=
  0; Sec[7]:=0;
 Sec[8]:=$E0 Or (SubPid Shr 8); Sec[9]:=SubPid And 255; Sec[10]:=$F0; Sec[11]:=
  0;
 Sec[12]:=6; Sec[13]:=$E0 Or (SubPid Shr 8); Sec[14]:=SubPid And 255; Sec[15]:=
  $F0; Sec[16]:=10;
 Sec[17]:=$59; Sec[18]:=8; Sec[19]:=Ord('e'); Sec[20]:=Ord('n'); Sec[21]:=Ord(
  'g'); Sec[22]:=$10; Sec[23]:=0; Sec[24]:=1; Sec[25]:=0; Sec[26]:=1;
 N:=27; Sec[2]:=N+4-3;
 Crc:=XSMpegCrc(PEABuffer(@Sec),N);
 Sec[N]:=(Crc Shr 24) And 255; Sec[N+1]:=(Crc Shr 16) And 255; Sec[N+2]:=(Crc
  Shr 8) And 255; Sec[N+3]:=Crc And 255;
 XSTsPsi($1000,PEABuffer(@Sec),N+4);
End;

Procedure XSTsPes(Pid: LongInt; Pts: Int64; Seg: PEABuffer; SegLen: LongInt);
Var Pes: PEABuffer; Total,Pl,Off,N: LongInt;
Begin
 GetMem(Pes,SegLen+64);
 Pl:=3+5+2+SegLen+1;
 Pes^[0]:=0; Pes^[1]:=0; Pes^[2]:=1; Pes^[3]:=$BD; Pes^[4]:=Pl Shr 8; Pes^[5]:=
  Pl And 255;
 Pes^[6]:=$84; Pes^[7]:=$80; Pes^[8]:=5;
 XSPutPts(Pes,9,Pts,2);
 Pes^[14]:=$20; Pes^[15]:=0;
 Move(Seg^,Pes^[16],SegLen);
 Pes^[16+SegLen]:=$FF;
 Total:=6+Pl; Off:=0;
 While Off<Total Do Begin
  N:=Total-Off; If N>184 Then N:=184;
  XSTsPacket(Pid,Off=0,PEABuffer(@Pes^[Off]),N);
  Inc(Off,N);
 End;
 FreeMem(Pes,SegLen+64);
End;

Procedure XSWriteTS(Const Target: String);
Var I,Len: LongInt; Seg: PEABuffer; Base: Int64; SubPid: LongInt;
Begin
 If XSN=0 Then Fail('sous-titres: aucun evenement.');
 FillChar(XSTsCc,SizeOf(XSTsCc),0); GetMem(Seg,70000); DBeObjVer:=0; SubPid:=
  $100; Base:=90000;
 OpenWrite(Target);
 For I:=0 To XSN-1 Do Begin
  XSTsWritePatPmt(SubPid);
  Len:=DBeEncode(XSEvs[I],Seg,65000);
  If Len<0 Then Fail(
   'sous-titre DVB: evenement incompatible (plus de 256 couleurs ou trop grand'+
   ').');
  XSTsPes(SubPid,Base+XSEvs[I]^.T0*90,Seg,Len);
  Len:=DBeEncode(Nil,Seg,65000);
  If Len<0 Then Fail('sous-titre DVB: encodage de la page vide impossible.');
  XSTsPes(SubPid,Base+XSEvs[I]^.T1*90,Seg,Len);
 End;
 CloseWrite; FreeMem(Seg,70000);
End;

Procedure XSWriteDvbRaw(Const Target: String);
Var I,Len: LongInt; Seg: PEABuffer;
Begin
 If XSN=0 Then Fail('sous-titres: aucun evenement.');
 GetMem(Seg,70000); DBeObjVer:=0;
 OpenWrite(Target);
 For I:=0 To XSN-1 Do Begin
  Len:=DBeEncode(XSEvs[I],Seg,65000);
  If Len<0 Then Fail(
   'sous-titre DVB: evenement incompatible (plus de 256 couleurs ou trop grand'+
   ').');
  WriteBytes(Seg^,Len);
  Len:=DBeEncode(Nil,Seg,65000);
  If Len<0 Then Fail('sous-titre DVB: encodage de la page vide impossible.');
  WriteBytes(Seg^,Len);
 End;
 CloseWrite; FreeMem(Seg,70000);
End;

{ ---- MPEG-TS: lecture du flux de sous-titres DVB ---- }
Var XSMinPts: Int64; XSBasePts: Int64; XSPktEv: LongInt;

{ passe un paquet DVB (segments) au decodeur; ajuste les fins d'affichage }
Procedure XSFeedDvb(Buf: PEABuffer; Size: LongInt; PtsMs: Int64);
Var E,Pv: PXSEv;
Begin
 If Not DBDecodePacket(Buf,Size,PtsMs) Then Exit;
 E:=DBSubEv;
 If XSN>=2 Then Begin
  Pv:=XSEvs[XSN-2];
  If Pv^.T1>E^.T0 Then Pv^.T1:=E^.T0;
 End;
 If E^.NR=0 Then XSDropLast;
End;

Function XSPesPts(P: PEABuffer; Len: LongInt; Var Pts: Int64): Boolean;
Begin
 XSPesPts:=False;
 If Len<14 Then Exit;
 If (P^[0]<>0) Or (P^[1]<>0) Or (P^[2]<>1) Then Exit;
 If (P^[7] And $80)=0 Then Exit;
 Pts:=(Int64((P^[9] Shr 1) And 7) Shl 30) Or (Int64(P^[10]) Shl 22) Or (Int64(
  P^[11] Shr 1) Shl 15) Or (Int64(P^[12]) Shl 7) Or (P^[13] Shr 1);
 XSPesPts:=True;
End;

Procedure XSLoadTS(Const Source: String);
Var
 F,Pes: PEABuffer; Size,Off,Sync,P,Pid,Pusi,Afc,Hdr,K,Tb,SecLen,ProgPid,PmtPid,
  SubPid,I,J,Es,EsLen,DescEnd,PesLen,PesCap,HdrLen,Pl: LongInt;
 Pts: Int64; Have: Boolean; PmtPids: Array[0..15] Of LongInt; NPmt: LongInt;
  SubFound: Boolean; Typ: LongInt;
 Cont: LongInt;
Procedure Flush;
Var Payload: LongInt; Pp: Int64; Ms: Int64;
Begin
 If PesLen<14 Then Begin PesLen:=0; Exit; End;
 If ((Pes^[4]*256+Pes^[5])>0) And (6+Pes^[4]*256+Pes^[5]<PesLen) Then PesLen:=6+
  Pes^[4]*256+Pes^[5];
 HdrLen:=9+Pes^[8];
 If (PesLen>HdrLen+2) And (Pes^[HdrLen]=$20) And (Pes^[HdrLen+1]=0) And
  XSPesPts(Pes,PesLen,Pp) Then Begin
  Payload:=PesLen-HdrLen-2;
  { retire le marqueur de fin 0xFF }
  While (Payload>0) And (Pes^[HdrLen+2+Payload-1]=$FF) Do Dec(Payload);
  Ms:=((Pp-XSMinPts)*1000) Div 90000;
  If Pp<XSMinPts Then Ms:=0;
  XSFeedDvb(PEABuffer(@Pes^[HdrLen+2]),Payload,Ms);
 End;
 PesLen:=0;
End;
Begin
 NVLoad(Source,F,Size); CloseRead;
 Sync:=-1;
 For Off:=0 To 187 Do If (F^[Off]=$47) And (Off+188*3<Size) And (F^[Off+
  188]=$47) And (F^[Off+376]=$47) Then Begin Sync:=Off; Break; End;
 If Sync<0 Then Fail('mpegts: synchronisation 0x47 introuvable.');
 { passe 1: PAT, PMT, PTS minimal }
 XSMinPts:=-1; NPmt:=0; SubPid:=-1; SubFound:=False; P:=Sync;
 While P+188<=Size Do Begin
  If F^[P]<>$47 Then Begin Inc(P,188); Continue; End;
  Pid:=((F^[P+1] And $1F) Shl 8) Or F^[P+2]; Pusi:=(F^[P+1] Shr 6) And 1; Afc:=(
   F^[P+3] Shr 4) And 3;
  Hdr:=4;
  If (Afc And 2)<>0 Then Hdr:=5+F^[P+4];
  If ((Afc And 1)<>0) And (Hdr<188) Then Begin
   If Pid=0 Then Begin
    If Pusi=1 Then Begin
     Tb:=P+Hdr+1+F^[P+Hdr];
     If F^[Tb]=0 Then Begin
      SecLen:=((F^[Tb+1] And $F) Shl 8) Or F^[Tb+2];
      K:=Tb+8;
      While K+4<=Tb+3+SecLen-4 Do Begin
       If ((F^[K]*256+F^[K+1])<>0) And (NPmt<16) Then Begin PmtPids[NPmt]:=((F^[
        K+2] And $1F) Shl 8) Or F^[K+3]; Inc(NPmt); End;
       Inc(K,4);
      End;
     End;
    End;
   End Else Begin
    Have:=False; For I:=0 To NPmt-1 Do If PmtPids[I]=Pid Then Have:=True;
    If Have And (Pusi=1) And Not SubFound Then Begin
     Tb:=P+Hdr+1+F^[P+Hdr];
     If F^[Tb]=2 Then Begin
      SecLen:=((F^[Tb+1] And $F) Shl 8) Or F^[Tb+2];
      EsLen:=((F^[Tb+10] And $F) Shl 8) Or F^[Tb+11];
      K:=Tb+12+EsLen;
      While K+5<=Tb+3+SecLen-4 Do Begin
       Typ:=F^[K]; I:=((F^[K+1] And $1F) Shl 8) Or F^[K+2]; EsLen:=((F^[K+3] And
        $F) Shl 8) Or F^[K+4];
       DescEnd:=K+5+EsLen; J:=K+5;
       While J+2<=DescEnd Do Begin
        If (Typ=6) And (F^[J]=$59) And Not SubFound Then Begin SubPid:=I;
         SubFound:=True; End;
        Inc(J,2+F^[J+1]);
       End;
       K:=DescEnd;
      End;
     End;
    End;
    If (Pusi=1) And (P+Hdr+14<=P+188) And (F^[P+Hdr]=0) And (F^[P+Hdr+1]=0) And
     (F^[P+Hdr+2]=1) And ((F^[P+Hdr+7] And $80)<>0) Then Begin
     Pts:=(Int64((F^[P+Hdr+9] Shr 1) And 7) Shl 30) Or (Int64(F^[P+Hdr+10]) Shl
      22) Or (Int64(F^[P+Hdr+11] Shr 1) Shl 15) Or (Int64(F^[P+Hdr+12]) Shl 7)
      Or (F^[P+Hdr+13] Shr 1);
     If (XSMinPts<0) Or (Pts<XSMinPts) Then XSMinPts:=Pts;
    End;
   End;
  End;
  Inc(P,188);
 End;
 If SubPid<0 Then Fail(
  'mpegts: aucun flux de sous-titres DVB (type 0x06 + descripteur subtitling 0'+
  'x59).');
 If XSMinPts<0 Then XSMinPts:=0;
 { passe 2: reassemblage PES du flux de sous-titres }
 GetMem(Pes,1048576); PesLen:=0; DBReset; XSW:=0; XSH:=0; P:=Sync;
 While P+188<=Size Do Begin
  If F^[P]<>$47 Then Begin Inc(P,188); Continue; End;
  Pid:=((F^[P+1] And $1F) Shl 8) Or F^[P+2];
  If Pid=SubPid Then Begin
   Pusi:=(F^[P+1] Shr 6) And 1; Afc:=(F^[P+3] Shr 4) And 3; Hdr:=4;
   If (Afc And 2)<>0 Then Hdr:=5+F^[P+4];
   If ((Afc And 1)<>0) And (Hdr<188) Then Begin
    If Pusi=1 Then Flush;
    If (Pusi=1) Or (PesLen>0) Then Begin
     If PesLen+188-Hdr<=1048576 Then Begin Move(F^[P+Hdr],Pes^[PesLen],188-Hdr);
      Inc(PesLen,188-Hdr); End;
    End;
   End;
  End;
  Inc(P,188);
 End;
 Flush;
 FreeMem(Pes,1048576); FreeMem(F,Size+64);
 If XSN=0 Then Fail('mpegts: aucun sous-titre DVB decode.');
 If (XSW=0) Or (XSH=0) Then Begin XSW:=720; XSH:=576; End;
End;

{ flux brut dvbsub: segments 0x0F... consecutifs; ensembles d'affichage sans
 horodatage (debuts successifs) }
Procedure XSLoadDvbRaw(Const Source: String);
Var F: PEABuffer; Size,P,Q,SegLen,SegType,Start: LongInt; T: Int64; Pk:
 PEABuffer; Before: LongInt;
Begin
 NVLoad(Source,F,Size); CloseRead; DBReset; XSW:=0; XSH:=0; T:=0;
 P:=0;
 While P<Size Do Begin
  While (P<Size) And (F^[P]<>$0F) Do Inc(P);
  If P>=Size Then Break;
  Start:=P; Q:=P;
  { un paquet = segments jusqu'au segment de fin d'affichage inclus }
  While (Q+6<=Size) And (F^[Q]=$0F) Do Begin
   SegType:=F^[Q+1]; SegLen:=F^[Q+4]*256+F^[Q+5];
   If Q+6+SegLen>Size Then Begin Q:=Size; Break; End;
   Inc(Q,6+SegLen);
   If SegType=$80 Then Break;
  End;
  Before:=XSN;
  XSFeedDvb(PEABuffer(@F^[Start]),Q-Start,T);
  If XSN>Before Then T:=T+Int64(DBTimeOut)*1000;
  P:=Q;
 End;
 FreeMem(F,Size+64);
 If XSN=0 Then Fail('dvbsub: aucun sous-titre decode.');
 If (XSW=0) Or (XSH=0) Then Begin XSW:=720; XSH:=576; End;
End;

{ conversion de sous-titres bitmap: vobsub | psub | dvbsub -> psub | vobsub |
 dvbsub }
Procedure XSLoadXsubAvi(Const Source: String); Forward;
Procedure XSConvert(Const Source,Target,InFmt,OutFmt: String);
Begin
 XSN:=0;
 If InFmt='avi' Then XSLoadXsubAvi(Source) Else
 If InFmt='vobsub' Then XSLoadVobSub(Source)
 Else If InFmt='psub' Then XSLoadPsub(Source)
 Else If InFmt='mpegts' Then XSLoadTS(Source)
 Else If InFmt='dvbsub' Then XSLoadDvbRaw(Source)
 Else Fail('sous-titres: format d''entree non pris en charge: '+InFmt);
 If OutFmt='psub' Then XSWritePsub(Target)
 Else If OutFmt='vobsub' Then XSWriteVobSub(Target)
 Else If OutFmt='mpegts' Then XSWriteTS(Target)
 Else If OutFmt='dvbsub' Then XSWriteDvbRaw(Target)
 Else Fail('sous-titres: format de sortie non pris en charge: '+OutFmt);
 XSReset;
End;


{ ---- DXA (Feeble Files / ScummVM): conteneur et decodeur (libavformat/dxa.c,
 libavcodec/dxa.c) ---- }
Var DXAPal: Array[0..255] Of LongInt; DXABuf: PEABuffer; DXABufSize: LongInt;
 DXAPrev,DXACur: PEABuffer; DXAHavePrev: Boolean;

Function DXADecode13(Dst: PEABuffer; Stride,W,H: LongInt; Src: PEABuffer;
 SrcSize: LongInt; Ref: PEABuffer): Boolean;
Const Shift1: Array[0..5] Of Byte=(0,8,8,8,4,4); Shift2: Array[0..5] Of Byte=(0,
 0,8,4,0,4);
Var
 Code,Data,Mv,Msk,I,J,K,Typ,X,Y,D,D2,Tp,T2p,Mask,Sz1,Sz2,Rb: LongInt; Mval:
  LongInt;
 Dp,Rp: LongInt; { offsets de ligne dst/ref }
Function B(At: LongInt): LongInt;
Begin B:=EAByte(Src,SrcSize+256,At); End;
Function RB32(At: LongInt): LongInt; Begin RB32:=(B(At) Shl 24) Or (B(At+1) Shl
 16) Or (B(At+2) Shl 8) Or B(At+3); End;
Begin
 DXADecode13:=False;
 Sz1:=RB32(0); Sz2:=RB32(4);
 If Int64(12)+((W*H) Shr 4)+Sz1+Sz2>SrcSize Then Exit;
 Code:=12; Data:=Code+((W*H) Shr 4); Mv:=Data+Sz1; Msk:=Mv+Sz2;
 Dp:=0; Rp:=0; J:=0;
 While J<H Do Begin
  I:=0;
  While I<W Do Begin
   If (Data>SrcSize) Or (Mv>SrcSize) Or (Msk>SrcSize) Then Exit;
   Tp:=Dp+I; T2p:=Rp+I;
   Typ:=B(Code); Inc(Code);
   Case Typ Of
    4,0,5: Begin
     If Typ=4 Then Begin
      Mval:=B(Mv); X:=Mval Shr 4; If (X And 8)<>0 Then X:=8-X;
      Y:=Mval And 15; Inc(Mv); If (Y And 8)<>0 Then Y:=8-Y;
      If (I<-X) Or (W-I-4<X) Or (J<-Y) Or (H-J-4<Y) Then Exit;
      Inc(T2p,X+Y*Stride);
     End;
     For Y:=0 To 3 Do Begin
      Move(Ref^[T2p],Dst^[Tp],4); Inc(Tp,Stride); Inc(T2p,Stride);
     End;
    End;
    1,10,11,12,13,14,15: Begin
     If Typ=1 Then Begin Mask:=(B(Msk) Shl 8) Or B(Msk+1); Inc(Msk,2); End
     Else Begin
      Dec(Typ,10);
      Mask:=((B(Msk) And $F0) Shl Shift1[Typ]) Or ((B(Msk) And $F) Shl Shift2[
       Typ]);
      Inc(Msk);
     End;
     For Y:=0 To 3 Do Begin
      For X:=0 To 3 Do Begin
       If (Mask And $8000)<>0 Then Begin Dst^[Tp+X]:=B(Data); Inc(Data); End
        Else Dst^[Tp+X]:=Ref^[T2p+X];
       Mask:=(Mask Shl 1) And $FFFFFFFF;
      End;
      Inc(Tp,Stride); Inc(T2p,Stride);
     End;
    End;
    2: Begin
     For Y:=0 To 3 Do Begin FillChar(Dst^[Tp],4,B(Data)); Inc(Tp,Stride); End;
     Inc(Data);
    End;
    3: Begin
     For Y:=0 To 3 Do Begin
      For X:=0 To 3 Do Dst^[Tp+X]:=B(Data+X);
      Inc(Data,4); Inc(Tp,Stride);
     End;
    End;
    8: Begin
     Mask:=B(Msk); Inc(Msk);
     For K:=0 To 3 Do Begin
      D:=((K And 1) Shl 1)+((K And 2)*Stride);
      D2:=D;
      T2p:=Rp+I+D2;
      Case Mask And $C0 Of
       $80: Begin
        Mval:=B(Mv); X:=Mval Shr 4; If (X And 8)<>0 Then X:=8-X;
        Y:=Mval And 15; Inc(Mv); If (Y And 8)<>0 Then Y:=8-Y;
        If (I+2*(K And 1)<-X) Or (W-I-2*(K And 1)-2<X) Or (J+(K And 2)<-Y) Or (
         H-J-(K And 2)-2<Y) Then Exit;
        Inc(T2p,X+Y*Stride);
        Dst^[Tp+D]:=Ref^[T2p]; Dst^[Tp+D+1]:=Ref^[T2p+1]; Dst^[Tp+D+Stride]:=
         Ref^[T2p+Stride]; Dst^[Tp+D+1+Stride]:=Ref^[T2p+1+Stride];
       End;
       $00: Begin
        Dst^[Tp+D]:=Ref^[T2p]; Dst^[Tp+D+1]:=Ref^[T2p+1]; Dst^[Tp+D+Stride]:=
         Ref^[T2p+Stride]; Dst^[Tp+D+1+Stride]:=Ref^[T2p+1+Stride];
       End;
       $40: Begin
        Rb:=B(Data);
        Dst^[Tp+D]:=Rb; Dst^[Tp+D+1]:=Rb; Dst^[Tp+D+Stride]:=Rb; Dst^[Tp+D+1+
         Stride]:=Rb;
        Inc(Data);
       End;
       $C0: Begin
        Dst^[Tp+D]:=B(Data); Dst^[Tp+D+1]:=B(Data+1); Dst^[Tp+D+Stride]:=B(Data+
         2); Dst^[Tp+D+1+Stride]:=B(Data+3);
        Inc(Data,4);
       End;
      End;
      Mask:=(Mask Shl 2) And $FFFFFFFF;
     End;
    End;
    32: Begin
     Mask:=(B(Msk) Shl 8) Or B(Msk+1); Inc(Msk,2);
     For Y:=0 To 3 Do Begin
      For X:=0 To 3 Do Begin Dst^[Tp+X]:=B(Data+(Mask And 1)); Mask:=Mask Shr 1;
       End;
      Inc(Tp,Stride);
     End;
     Inc(Data,2);
    End;
    33,34: Begin
     Mask:=RB32(Msk); Inc(Msk,4);
     For Y:=0 To 3 Do Begin
      For X:=0 To 3 Do Begin Dst^[Tp+X]:=B(Data+(Mask And 3)); Mask:=Mask Shr 2;
       End;
      Inc(Tp,Stride);
     End;
     Inc(Data,Typ-30);
    End;
    Else Exit;
   End;
   Inc(I,4);
  End;
  Inc(Dp,Stride*4); Inc(Rp,Stride*4);
  Inc(J,4);
 End;
 DXADecode13:=True;
End;

Procedure DecodeDXA(Const Source,Target: String; Mode: LongInt);
Var
 F: PEABuffer; Size,Pos,Frames,W,H,Flags,Fps,Wave,VidPos,Sz,I,Compr,N: LongInt;
  Tag: String[4]; Started,Ok,Pc: Boolean;
 Pk: PEABuffer; PkLen,PalSize,Dsize,Z,Res,PalAt,Hdr,X: LongInt; Dur: Double; RN,
  RD: LongInt; Frm: PEABuffer;
Function T4(At: LongInt): String;
Var S4: String[4]; K: Integer;
Begin S4:=''; For K:=0 To 3 Do S4:=S4+Chr(EAByte(F,Size,At+K)); T4:=S4; End;
Function RB32(At: LongInt): LongInt;
Begin RB32:=(EAByte(F,Size,At) Shl 24) Or (EAByte(F,Size,At+1) Shl 16) Or (
 EAByte(F,Size,At+2) Shl 8) Or EAByte(F,Size,At+3); End;
Function RB16(At: LongInt): LongInt;
Begin RB16:=(EAByte(F,Size,At) Shl 8) Or EAByte(F,Size,At+1); End;
{ decode un paquet; Pk de longueur PkLen; retourne False si erreur }
Function Decode: Boolean;
Var P,Cmp,J: LongInt; HaveNull: Boolean; Src,Tmp: PEABuffer; Stride: LongInt;
Begin
 Decode:=False; P:=0; Stride:=W;
 If (PkLen>=4) And (Pk^[0]=Ord('C')) And (Pk^[1]=Ord('M')) And (Pk^[2]=Ord('A'))
  And (Pk^[3]=Ord('P')) Then Begin
  For J:=0 To 255 Do DXAPal[J]:=(EAByte(Pk,PkLen,4+J*3) Shl 16) Or (EAByte(Pk,
   PkLen,5+J*3) Shl 8) Or EAByte(Pk,PkLen,6+J*3);
  P:=772;
 End;
 HaveNull:=(EAByte(Pk,PkLen,P)=Ord('N')) And (EAByte(Pk,PkLen,P+1)=Ord('U')) And
  (EAByte(Pk,PkLen,P+2)=Ord('L')) And (EAByte(Pk,PkLen,P+3)=Ord('L'));
 Inc(P,4);
 If HaveNull Then Cmp:=-1 Else Begin Cmp:=EAByte(Pk,PkLen,P); Inc(P); End;
 Dsize:=W*H*2;
 If (Cmp<>4) And (Cmp<>-1) Then Begin
  Inc(P,4);
  Res:=NVInflate(PEABuffer(@Pk^[P]),PkLen-P,DXABuf,Dsize,N);
  If Res<>0 Then Exit;
  Dsize:=N;
  FillChar(DXABuf^[Dsize],16,0);
 End;
 Src:=DXABuf;
 Case Cmp Of
  -1: Begin
   If DXAHavePrev Then Move(DXAPrev^,DXACur^,W*H) Else FillChar(DXACur^,W*H,0);
  End;
  2,4: Move(Src^,DXACur^,W*H);
  3,5: Begin
   If Not DXAHavePrev Then Exit;
   For J:=0 To W*H-1 Do DXACur^[J]:=Src^[J] Xor DXAPrev^[J];
  End;
  12,13: Begin
   If Not DXAHavePrev Then Exit;
   FillChar(DXACur^,W*H,0);
   DXADecode13(DXACur,Stride,W,H,Src,Dsize,DXAPrev);
  End;
  Else Exit;
 End;
 Move(DXACur^,DXAPrev^,W*H); DXAHavePrev:=True;
 Decode:=True;
End;
Begin
 NVLoad(Source,F,Size);
 If T4(0)<>'DEXA' Then Fail('dxa: signature DEXA requise.');
 Flags:=F^[4]; Frames:=RB16(5); Fps:=RB32(7); If Fps>=2147483648 Then Fps:=Fps-
  4294967296;
 W:=RB16(11); H:=RB16(13);
 If Frames=0 Then Fail('dxa: aucune image.');
 If (W=0) Or (H=0) Or (W>2048) Or (H>2048) Then Fail(
  'dxa: dimensions incorrectes.');
 If T4(15)='WAVE' Then VidPos:=23+RB32(19) Else VidPos:=19;
 If (Flags And $C0)<>0 Then H:=H Shr 1;
 If ((W Mod 4)<>0) Or ((H Mod 4)<>0) Then Fail(
  'dxa: dimensions non multiples de 4.');
 If Fps>0 Then Dur:=Fps/1000.0 Else If Fps<0 Then Dur:=-Fps/100000.0 Else Dur:=
  0.1;
 If Fps>0 Then Begin RN:=1000; RD:=Fps; End Else If Fps<0 Then Begin RN:=100000;
  RD:=-Fps; End Else Begin RN:=10; RD:=1; End;
 NVGcd(RN,RD);
 DXABufSize:=W*H*2+16+512; GetMem(DXABuf,DXABufSize); FillChar(DXABuf^,
  DXABufSize,0);
 GetMem(DXAPrev,W*H+64); GetMem(DXACur,W*H+64); DXAHavePrev:=False; FillChar(
  DXAPal,SizeOf(DXAPal),0);
 NVBegin(Mode,Target,W,H,0,RN,RD);
 Pos:=VidPos; PalSize:=0; PalAt:=0; Started:=True;
 GetMem(Pk,16777216+1024);
 While (Pos+4<=Size) And (Frames>0) Do Begin
  Tag:=T4(Pos); Inc(Pos,4);
  If Tag='CMAP' Then Begin
   Move(F^[Pos-4],Pk^[0],4);
   If Pos+768>Size Then Break;
   Move(F^[Pos],Pk^[4],768); Inc(Pos,768); PalSize:=772;
  End Else If Tag='NULL' Then Begin
   Move(F^[Pos-4],Pk^[PalSize],4); PkLen:=PalSize+4;
   Dec(Frames); PalSize:=0;
   If Decode Then Begin
    For I:=0 To 255 Do Begin NVPalR[I]:=(DXAPal[I] Shr 16) And 255; NVPalG[I]:=(
     DXAPal[I] Shr 8) And 255; NVPalB[I]:=DXAPal[I] And 255; End;
    NVEmit(DXACur);
   End Else NVRepeat;
   If NVDone Then Break;
  End Else If Tag='FRAM' Then Begin
   If Pos+5>Size Then Break;
   Sz:=RB32(Pos+1);
   If (Sz<0) Or (Sz>$FFFFFF) Then Break;
   If Pos+5+Sz>Size Then Break;
   Move(F^[Pos-4],Pk^[PalSize],9); Move(F^[Pos+5],Pk^[PalSize+9],Sz);
   PkLen:=PalSize+9+Sz; Inc(Pos,5+Sz);
   Dec(Frames);
     PalSize:=0;
   If Decode Then Begin
    For I:=0 To 255 Do Begin NVPalR[I]:=(DXAPal[I] Shr 16) And 255; NVPalG[I]:=(
     DXAPal[I] Shr 8) And 255; NVPalB[I]:=DXAPal[I] And 255; End;
    NVEmit(DXACur);
   End Else NVRepeat;
   If NVDone Then Break;
  End Else Break;
 End;
 FreeMem(Pk,16777216+1024); FreeMem(DXABuf,DXABufSize); FreeMem(DXAPrev,W*H+64);
  FreeMem(DXACur,W*H+64); FreeMem(F,Size+64);
 NVFinish('dxa');
End;

