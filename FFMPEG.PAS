  If WMAbsTop12(Y)<WMAbsTop12(WMI2F($39800000)) Then Begin WMSinf:=Y; Exit; End;
  X2:=X*X;
 End Else If WMAbsTop12(Y)<WMAbsTop12(WMI2F($42F00000)) Then Begin
  R:=X*K[0];
  N:=WMSar(Trunc(R)+$800000,24);
  X:=X-N*K[1];
  Sg:=1.0; If ((N And 3)=1) Or ((N And 3)=2) Then Sg:=-1.0;
  If (N And 2)<>0 Then Neg:=True;
  X2:=X*X; X:=X*Sg;
 End Else Begin
  WMSinf:=Sin(X); Exit;
 End;
 If (N And 1)=0 Then Begin
  X3:=X*X2; S1:=K[7]+X2*K[8]; X7:=X3*X2; S:=X+X3*K[6];
  R:=S+X7*S1;
 End Else Begin
  C0:=1.0; Cc1:=K[2]; Cc2:=K[3]; Cc3:=K[4]; Cc4:=K[5];
  If Neg Then Begin C0:=-C0; Cc1:=-Cc1; Cc2:=-Cc2; Cc3:=-Cc3; Cc4:=-Cc4; End;
  X4:=X2*X2; C2:=Cc3+X2*Cc4; C1:=C0+X2*Cc1; X6:=X4*X2; C:=C1+X4*Cc2;
  R:=C+X6*C2;
 End;
 WMSinf:=R;
End;

{ ================= MDCT / FFT ================= }
Function WMTSplitPerm(I,Len,Inv: LongInt): LongInt;
Begin
 Len:=Len Shr 1;
 If Len<=1 Then Begin WMTSplitPerm:=I And 1; Exit; End;
 If (I And Len)=0 Then Begin WMTSplitPerm:=WMTSplitPerm(I,Len,Inv)*2; Exit; End;
 Len:=Len Shr 1;
 If (I And Len)=0 Then WMTSplitPerm:=WMTSplitPerm(I,Len,Inv)*4+1-2*(1 Xor Inv)
 Else WMTSplitPerm:=WMTSplitPerm(I,Len,Inv)*4+1-2*(0 Xor Inv);
End;

Procedure WMTInitTabs;
Var L,K,I: LongInt; Freq,Dv: Double;
Begin
 If WMTReady Then Exit;
 SetMXCSR(GetMXCSR Or $1F80);
 For L:=3 To 11 Do Begin
  K:=1 Shl L; Freq:=2*3.14159265358979323846/K;
  For I:=0 To K Div 4-1 Do Begin Dv:=Cos(I*Freq); WMTTab[L,I]:=Dv; End;
  WMTTab[L,K Div 4]:=0;
 End;
 WMTReady:=True;
End;

Procedure WMTButterflies(A0,A1,A2,A3: LongInt; T1,T2,T5,T6: Single);
Var R0,I0,R1,I1,T3,T4: Single;
Begin
 R0:=WMTZr[A0]; I0:=WMTZi[A0]; R1:=WMTZr[A1]; I1:=WMTZi[A1];
 T3:=T5-T1; T5:=T5+T1;
 WMTZr[A2]:=R0-T5; WMTZr[A0]:=R0+T5;
 WMTZi[A3]:=I1-T3; WMTZi[A1]:=I1+T3;
 T4:=T2-T6; T6:=T2+T6;
 WMTZr[A3]:=R1-T4; WMTZr[A1]:=R1+T4;
 WMTZi[A2]:=I0-T6; WMTZi[A0]:=I0+T6;
End;

Procedure WMTTransform(A0,A1,A2,A3: LongInt; Wre,Wim: Single);
Var T1,T2,T5,T6,Nw: Single;
Begin
 Nw:=-Wim;
 T1:=WMTZr[A2]*Wre-WMTZi[A2]*Nw;
 T2:=WMTZr[A2]*Nw+WMTZi[A2]*Wre;
 T5:=WMTZr[A3]*Wre-WMTZi[A3]*Wim;
 T6:=WMTZr[A3]*Wim+WMTZi[A3]*Wre;
 WMTButterflies(A0,A1,A2,A3,T1,T2,T5,T6);
End;

Procedure WMTFft2(B: LongInt);
Var Tr,Ti: Single;
Begin
 Tr:=WMTZr[B]-WMTZr[B+1]; WMTZr[B]:=WMTZr[B]+WMTZr[B+1];
 Ti:=WMTZi[B]-WMTZi[B+1]; WMTZi[B]:=WMTZi[B]+WMTZi[B+1];
 WMTZr[B+1]:=Tr; WMTZi[B+1]:=Ti;
End;

Procedure WMTFft4(B: LongInt);
Var T1,T2,T3,T4,T5,T6,T7,T8: Single;
Begin
 T3:=WMTZr[B]-WMTZr[B+1]; T1:=WMTZr[B]+WMTZr[B+1];
 T8:=WMTZr[B+3]-WMTZr[B+2]; T6:=WMTZr[B+3]+WMTZr[B+2];
 WMTZr[B+2]:=T1-T6; WMTZr[B]:=T1+T6;
 T4:=WMTZi[B]-WMTZi[B+1]; T2:=WMTZi[B]+WMTZi[B+1];
 T7:=WMTZi[B+2]-WMTZi[B+3]; T5:=WMTZi[B+2]+WMTZi[B+3];
 WMTZi[B+3]:=T4-T8; WMTZi[B+1]:=T4+T8;
 WMTZr[B+3]:=T3-T7; WMTZr[B+1]:=T3+T7;
 WMTZi[B+2]:=T2-T5; WMTZi[B]:=T2+T5;
End;

Procedure WMTFft8(B: LongInt);
Var T1,T2,T5,T6,Nr,Ni: Single;
Begin
 WMTFft4(B);
 Nr:=-WMTZr[B+5]; T1:=WMTZr[B+4]-Nr; WMTZr[B+5]:=WMTZr[B+4]+Nr;
 Ni:=-WMTZi[B+5]; T2:=WMTZi[B+4]-Ni; WMTZi[B+5]:=WMTZi[B+4]+Ni;
 Nr:=-WMTZr[B+7]; T5:=WMTZr[B+6]-Nr; WMTZr[B+7]:=WMTZr[B+6]+Nr;
 Ni:=-WMTZi[B+7]; T6:=WMTZi[B+6]-Ni; WMTZi[B+7]:=WMTZi[B+6]+Ni;
 WMTButterflies(B+0,B+2,B+4,B+6,T1,T2,T5,T6);
 WMTTransform(B+1,B+3,B+5,B+7,WMTTab[3,1],WMTTab[3,1]);
End;

Procedure WMTFft16(B: LongInt);
Var T1,T2,T5,T6,C1,C2,C3: Single;
Begin
 C1:=WMTTab[4,1]; C2:=WMTTab[4,2]; C3:=WMTTab[4,3];
 WMTFft8(B); WMTFft4(B+8); WMTFft4(B+12);
 T1:=WMTZr[B+8]; T2:=WMTZi[B+8]; T5:=WMTZr[B+12]; T6:=WMTZi[B+12];
 WMTButterflies(B+0,B+4,B+8,B+12,T1,T2,T5,T6);
 WMTTransform(B+2,B+6,B+10,B+14,C2,C2);
 WMTTransform(B+1,B+5,B+9,B+13,C1,C3);
 WMTTransform(B+3,B+7,B+11,B+15,C3,C1);
End;

Procedure WMTCombine(B,L,Len: LongInt);
Var O1,O2,O3,I,C,W: LongInt;
Begin
 O1:=2*Len; O2:=4*Len; O3:=6*Len;
 C:=0; W:=O1-7; I:=0;
 While I<Len Do Begin
  WMTTransform(B+0,B+O1+0,B+O2+0,B+O3+0,WMTTab[L,C+0],WMTTab[L,W+7]);
  WMTTransform(B+2,B+O1+2,B+O2+2,B+O3+2,WMTTab[L,C+2],WMTTab[L,W+5]);
  WMTTransform(B+4,B+O1+4,B+O2+4,B+O3+4,WMTTab[L,C+4],WMTTab[L,W+3]);
  WMTTransform(B+6,B+O1+6,B+O2+6,B+O3+6,WMTTab[L,C+6],WMTTab[L,W+1]);
  WMTTransform(B+1,B+O1+1,B+O2+1,B+O3+1,WMTTab[L,C+1],WMTTab[L,W+6]);
  WMTTransform(B+3,B+O1+3,B+O2+3,B+O3+3,WMTTab[L,C+3],WMTTab[L,W+4]);
  WMTTransform(B+5,B+O1+5,B+O2+5,B+O3+5,WMTTab[L,C+5],WMTTab[L,W+2]);
  WMTTransform(B+7,B+O1+7,B+O2+7,B+O3+7,WMTTab[L,C+7],WMTTab[L,W+0]);
  Inc(I,4); Inc(B,8); Inc(C,8); Dec(W,8);
 End;
End;

Procedure WMTFft(N,B,L: LongInt);
Begin
 Case N Of
  2: WMTFft2(B);
  4: WMTFft4(B);
  8: WMTFft8(B);
  16: WMTFft16(B);
 Else Begin
  WMTFft(N Div 2,B,L-1);
  WMTFft(N Div 4,B+N Div 2,L-2);
  WMTFft(N Div 4,B+(N Div 4)*3,L-2);
  WMTCombine(B,L,(N Div 4) Shr 1);
 End;
 End;
End;

{ Contexte MDCT de N coefficients (FFT N/2); Scale = echelle av_tx. }
Procedure WMTCtxInit(Var C: TWMTCtx; N: LongInt; Inv: Boolean; Scale: Double);
Var I,Len2,Off,InvI: LongInt; Alpha,Theta,Sc,Dv: Double;
Begin
 WMTInitTabs;
 C.N:=N; Len2:=N Shr 1; C.L2:=Len2; C.Inv:=Inv; InvI:=0; If Inv Then InvI:=1;
 If Inv Then
  For I:=0 To Len2-1 Do C.Map[I]:=(-WMTSplitPerm(I,Len2,InvI)) And (Len2-1)
 Else
  For I:=0 To Len2-1 Do C.Map[(-WMTSplitPerm(I,Len2,InvI)) And (Len2-1)]:=I;
 Theta:=1.0/8.0; Sc:=Sqrt(Abs(Scale)); Off:=0; If Inv Then Off:=Len2;
 For I:=0 To Len2-1 Do Begin
  Alpha:=(3.14159265358979323846/2)*(I+Theta)/Len2;
  Dv:=Cos(Alpha)*Sc; C.ExRe[Off+I]:=Dv;
  Dv:=Sin(Alpha)*Sc; C.ExIm[Off+I]:=Dv;
 End;
 If Inv Then Begin
  For I:=0 To Len2-1 Do Begin
   C.ExRe[I]:=C.ExRe[Len2+C.Map[I]]; C.ExIm[I]:=C.ExIm[Len2+C.Map[I]];
  End;
  For I:=0 To Len2-1 Do C.Map[I]:=C.Map[I] Shl 1;
 End;
End;

{ IMDCT complet (AV_TX_FULL_IMDCT) : N coefficients -> 2N echantillons. }
Procedure WMTImdct(Var C: TWMTCtx; Var Src: TWMS2048; Var Dst: TWMS4096);
Var I,K,Len2,Len4,I0,I1,L,N: LongInt; Tr,Ti,S1r,S1i,S0r,S0i: Single;
Begin
 N:=C.N; Len2:=N Shr 1; Len4:=N Shr 2; L:=WMLog2(Len2);
 For I:=0 To Len2-1 Do Begin
  K:=C.Map[I];
  Tr:=Src[N-1-K]; Ti:=Src[K];
  WMTZr[I]:=Tr*C.ExRe[I]-Ti*C.ExIm[I];
  WMTZi[I]:=Tr*C.ExIm[I]+Ti*C.ExRe[I];
 End;
 WMTFft(Len2,0,L);
 For I:=0 To Len4-1 Do Begin
  I0:=Len4+I; I1:=Len4-I-1;
  S1r:=WMTZi[I1]; S1i:=WMTZr[I1];
  S0r:=WMTZi[I0]; S0i:=WMTZr[I0];
  WMTZr[I1]:=S1r*C.ExIm[Len2+I1]-S1i*C.ExRe[Len2+I1];
  WMTZi[I0]:=S1r*C.ExRe[Len2+I1]+S1i*C.ExIm[Len2+I1];
  WMTZr[I0]:=S0r*C.ExIm[Len2+I0]-S0i*C.ExRe[Len2+I0];
  WMTZi[I1]:=S0r*C.ExRe[Len2+I0]+S0i*C.ExIm[Len2+I0];
 End;
 For I:=0 To Len2-1 Do Begin Dst[Len2+2*I]:=WMTZr[I]; Dst[Len2+2*I+1]:=WMTZi[I];
  End;
 For I:=0 To Len2-1 Do Begin
  Dst[I]:=-Dst[N-1-I];
  Dst[2*N-I-1]:=Dst[N+I];
 End;
End;

{ MDCT direct : 2N echantillons -> N coefficients (echelle deja integree). }
Procedure WMTMdct(Var C: TWMTCtx; Var Src: TWMS4096; Var Dst: TWMS2048);
Var I,K,Idx,Len2,Len3,Len4,I0,I1,L: LongInt; Tr,Ti,S0r,S0i,S1r,S1i,A,B: Single;
Begin
 Len2:=C.N Shr 1; Len4:=C.N Shr 2; Len3:=Len2*3; L:=WMLog2(Len2);
 For I:=0 To Len2-1 Do Begin
  K:=2*I; Idx:=C.Map[I];
  If K<Len2 Then Begin
   A:=-Src[Len2+K]; B:=Src[Len2-1-K]; Tr:=A+B;
   A:=-Src[Len3+K]; B:=-Src[Len3-1-K]; Ti:=A+B;
  End Else Begin
   A:=-Src[Len2+K]; B:=-Src[5*Len2-1-K]; Tr:=A+B;
   A:=Src[K-Len2]; B:=-Src[Len3-1-K]; Ti:=A+B;
  End;
  WMTZi[Idx]:=Tr*C.ExRe[I]-Ti*C.ExIm[I];
  WMTZr[Idx]:=Tr*C.ExIm[I]+Ti*C.ExRe[I];
 End;
 WMTFft(Len2,0,L);
 For I:=0 To Len4-1 Do Begin
  I0:=Len4+I; I1:=Len4-I-1;
  S1r:=WMTZr[I1]; S1i:=WMTZi[I1]; S0r:=WMTZr[I0]; S0i:=WMTZi[I0];
  Dst[2*I1+1]:=S0r*C.ExIm[I0]-S0i*C.ExRe[I0];
  Dst[2*I0]:=S0r*C.ExRe[I0]+S0i*C.ExIm[I0];
  Dst[2*I0+1]:=S1r*C.ExIm[I1]-S1i*C.ExRe[I1];
  Dst[2*I1]:=S1r*C.ExRe[I1]+S1i*C.ExIm[I1];
 End;
End;

{ ================= VLC ================= }
Procedure WMDTreeAdd(T: PWMTree; Code: Int64; Len,Sym: LongInt);
Var Node,J,Bit,Nx: LongInt;
Begin
 If Len<=0 Then Exit;
 Node:=0;
 For J:=Len-1 Downto 0 Do Begin
  Bit:=(Code Shr J) And 1;
  If J=0 Then T^.Node[Node,Bit]:=-Sym-1
  Else Begin
   If T^.Node[Node,Bit]<=0 Then Begin
    If T^.Count>=2047 Then Exit;
    Inc(T^.Count); Nx:=T^.Count; T^.Node[Node,Bit]:=Nx;
   End;
   Node:=T^.Node[Node,Bit];
  End;
 End;
End;

Function WMDTreeNew: PWMTree;
Var T: PWMTree;
Begin
 New(T); FillChar(T^,SizeOf(TWMTree),0); T^.Count:=0; WMDTreeNew:=T;
End;

{ ================= lecteur de bits ================= }
Function WMDByte(P: LongInt): LongWord;
Begin
 If (P<0) Or (P>=WMDPhys) Then WMDByte:=0 Else WMDByte:=WMDBuf^[P];
End;

Procedure WMDSkipBits(N: LongInt);
Var M: LongInt;
Begin
 M:=WMDEnd+8-WMDPos;
 If N<M Then M:=N;
 Inc(WMDPos,M);
End;

Function WMDGet(N: LongInt): LongInt;
Var P: LongInt; V: LongWord;
Begin
 If N<=0 Then Begin WMDGet:=0; Exit; End;
 P:=WMDPos Shr 3;
 V:=(WMDByte(P) Shl 24) Or (WMDByte(P+1) Shl 16) Or (WMDByte(P+2) Shl 8) Or
  WMDByte(P+3);
 V:=V Shl (WMDPos And 7);
 WMDGet:=LongInt(V Shr (32-N)); WMDSkipBits(N);
End;

Function WMDGet1: LongInt;
Var B: LongWord;
Begin
 B:=WMDByte(WMDPos Shr 3);
 WMDGet1:=(B Shr (7-(WMDPos And 7))) And 1;
 If WMDPos<WMDEnd+8 Then Inc(WMDPos);
End;

Function WMDPeek1(Off: LongInt): LongInt;
Var P: LongInt; B: LongWord;
Begin
 P:=WMDPos+Off; B:=WMDByte(P Shr 3);
 WMDPeek1:=(B Shr (7-(P And 7))) And 1;
End;

Function WMDLeft: LongInt;
Begin WMDLeft:=WMDEnd-WMDPos; End;

Procedure WMDInitBits(P: Pointer; Phys,Bits: LongInt);
Begin WMDBuf:=P; WMDPhys:=Phys; WMDPos:=0; WMDEnd:=Bits; End;

{ Decodage VLC (get_vlc2) : les bits sont lus sans avancer, puis saute la
 longueur du code ;
  -1 si code invalide (aucun bit consomme). }
Function WMDVlc(T: PWMTree): LongInt;
Var Node,Nx,Len: LongInt;
Begin
 Node:=0; Len:=0;
 Repeat
  Nx:=T^.Node[Node,WMDPeek1(Len)]; Inc(Len);
  If Nx=0 Then Begin WMDVlc:=-1; Exit; End;
  If Nx<0 Then Begin WMDSkipBits(Len); WMDVlc:=-Nx-1; Exit; End;
  Node:=Nx;
  If Len>40 Then Begin WMDVlc:=-1; Exit; End;
 Until False;
End;

{ ================= tables et initialisation ================= }
Procedure WMDCoefTables(Idx,Sel: LongInt);
Var N,I,K,L,J,Level: LongInt; T: PWMTree;
Begin
 T:=WMDTreeNew; WMDTreeCoef[Idx]:=T;
 Case Sel Of
  0: N:=666; 1: N:=555; 2: N:=1336; 3: N:=1072; 4: N:=476; Else N:=435;
 End;
 WMDCoefN[Idx]:=N; WMDSelOf[Idx]:=Sel;
 For I:=0 To N-1 Do Case Sel Of
  0: WMDTreeAdd(T,WMDCode0[I],WMDBits0[I],I);
  1: WMDTreeAdd(T,WMDCode1[I],WMDBits1[I],I);
  2: WMDTreeAdd(T,WMDCode2[I],WMDBits2[I],I);
  3: WMDTreeAdd(T,WMDCode3[I],WMDBits3[I],I);
  4: WMDTreeAdd(T,WMDCode4[I],WMDBits4[I],I);
  Else WMDTreeAdd(T,WMDCode5[I],WMDBits5[I],I);
 End;
 I:=2; Level:=1; K:=0;
 While I<N Do Begin
  Case Sel Of
   0: L:=WMDLev0[K]; 1: L:=WMDLev1[K]; 2: L:=WMDLev2[K]; 3: L:=WMDLev3[K]; 4:
    L:=WMDLev4[K];
   Else L:=WMDLev5[K];
  End;
  Inc(K);
  For J:=0 To L-1 Do Begin
   If I<1336 Then Begin WMDRun[Idx][I]:=J; WMDLevel[Idx][I]:=Level; End;
   Inc(I);
  End;
  Inc(Level);
 End;
End;

Function WMDInit(Ver,Rate,Chans,BitRate,Align,Flags2: LongInt): Boolean;
Const
 D061: Double=0.61; D116: Double=1.16; D072: Double=0.72; D05: Double=0.5; D625:
  Double=0.625;
 D075: Double=0.75; D08: Double=0.8; D06: Double=0.6; D04: Double=0.4; D07:
  Double=0.7;
 D03: Double=0.3; D065: Double=0.65; D16: Double=1.6;
Var
 I,J,K,A,B,Pos,LPos,BlockLen,N,Rate1,CoefSel,Nb,NbMax,Bits: LongInt;
 Bps,Bps1,HighFreq,T,Norm,Wdel: Single;
 Seed: LongWord; Dv,Arg: Double; Tab: Pointer;
 TabB: Byte;
 Hs,Ln2: LongInt;
 Code: Int64;
Begin
 WMDInit:=False;
 SetMXCSR(GetMXCSR Or $1F80);
 If (Rate<=0) Or (Rate>50000) Or (Chans<=0) Or (Chans>2) Or (BitRate<=0) Then
  Exit;
 WMDVer:=Ver; WMDCh:=Chans; WMDRate:=Rate; WMDBitRate:=BitRate; WMDAlign:=Align;
  WMDFlags2:=Flags2;
 WMDExpVlc:=(Flags2 And 1)<>0; WMDReservoir:=(Flags2 And 2)<>0; WMDVarBlock:=(
  Flags2 And 4)<>0;
 If (Ver=2) And (Flags2=$D) And WMDVarBlock Then WMDVarBlock:=False;
 { ff_wma_get_frame_len_bits }
 If Rate<=16000 Then WMDFrameBits:=9
 Else If (Rate<=22050) Or ((Rate<=32000) And (Ver=1)) Then WMDFrameBits:=10
 Else WMDFrameBits:=11;
 WMDNextBits:=WMDFrameBits; WMDPrevBits:=WMDFrameBits; WMDBlockBits:=
  WMDFrameBits;
 WMDFrameLen:=1 Shl WMDFrameBits;
 If WMDVarBlock Then Begin
  Nb:=((Flags2 Shr 3) And 3)+1;
  If (BitRate Div Chans)>=32000 Then Inc(Nb,2);
  NbMax:=WMDFrameBits-7; If Nb>NbMax Then Nb:=NbMax;
  WMDNbSizes:=Nb+1;
 End Else WMDNbSizes:=1;
 WMDNoise:=True; HighFreq:=Rate*0.5;
 Rate1:=Rate;
 If Ver=2 Then Begin
  If Rate1>=44100 Then Rate1:=44100 Else If Rate1>=22050 Then Rate1:=22050
  Else If Rate1>=16000 Then Rate1:=16000 Else If Rate1>=11025 Then Rate1:=11025
  Else If Rate1>=8000 Then Rate1:=8000;
 End;
 Bps:=WMFi(BitRate)/WMFi(Chans*Rate);
 T:=Bps*WMFi(WMDFrameLen);
 Dv:=Double(T)/8.0+0.5;
 WMDByteOffBits:=WMLog2(Trunc(Dv))+2;
 If WMDByteOffBits+3>25 Then Exit;
 Bps1:=Bps;
 If Chans=2 Then Bps1:=Double(Bps)*D16;
 If Rate1=44100 Then Begin
  If Double(Bps1)>=D061 Then WMDNoise:=False Else HighFreq:=Double(HighFreq)*
   D04;
 End Else If Rate1=22050 Then Begin
  If Double(Bps1)>=D116 Then WMDNoise:=False
  Else If Double(Bps1)>=D072 Then HighFreq:=Double(HighFreq)*D07
  Else HighFreq:=Double(HighFreq)*D06;
 End Else If Rate1=16000 Then Begin
  If Double(Bps)>D05 Then HighFreq:=Double(HighFreq)*D05 Else HighFreq:=Double(
   HighFreq)*D03;
 End Else If Rate1=11025 Then HighFreq:=Double(HighFreq)*D07
 Else If Rate1=8000 Then Begin
  If Double(Bps)<=D625 Then HighFreq:=Double(HighFreq)*D05
  Else If Double(Bps)>D075 Then WMDNoise:=False
  Else HighFreq:=Double(HighFreq)*D065;
 End Else Begin
  If Double(Bps)>=D08 Then HighFreq:=Double(HighFreq)*D075
  Else If Double(Bps)>=D06 Then HighFreq:=Double(HighFreq)*D06
  Else HighFreq:=Double(HighFreq)*D05;
 End;
 { bandes d'exposants }
 If Ver=1 Then WMDCoefsStart:=3 Else WMDCoefsStart:=0;
 FillChar(WMDExpBands,SizeOf(WMDExpBands),0);
 For K:=0 To WMDNbSizes-1 Do Begin
  BlockLen:=WMDFrameLen Shr K;
  If Ver=1 Then Begin
   LPos:=0; I:=0;
   While I<25 Do Begin
    A:=WMDCrit[I]; B:=Rate;
    Pos:=((BlockLen*2*A)+(B Shr 1)) Div B;
    If Pos>BlockLen Then Pos:=BlockLen;
    WMDExpBands[0,I]:=Pos-LPos;
    If Pos>=BlockLen Then Begin Inc(I); Break; End;
    LPos:=Pos; Inc(I);
   End;
   WMDExpSizes[0]:=I;
  End Else Begin
   Hs:=-1; A:=WMDFrameBits-7-K;
   If A<3 Then Begin
    If Rate>=44100 Then Hs:=44100 Else If Rate>=32000 Then Hs:=32000
    Else If Rate>=22050 Then Hs:=22050;
   End;
   If Hs>0 Then Begin
    For I:=0 To 24 Do Begin
     Case Hs Of
      44100: TabB:=WMDBand44100[A*25+I];
      32000: TabB:=WMDBand32000[A*25+I];
      Else TabB:=WMDBand22050[A*25+I];
     End;
     If I=0 Then Begin N:=TabB; WMDExpSizes[K]:=N; End
     Else If I<=N Then WMDExpBands[K,I-1]:=TabB;
    End;
   End Else Begin
    J:=0; LPos:=0;
    For I:=0 To 24 Do Begin
     A:=WMDCrit[I]; B:=Rate;
     Pos:=((BlockLen*2*A)+(B Shl 1)) Div (4*B);
     Pos:=Pos Shl 2;
     If Pos>BlockLen Then Pos:=BlockLen;
     If Pos>LPos Then Begin WMDExpBands[K,J]:=Pos-LPos; Inc(J); End;
     If Pos>=BlockLen Then Break;
     LPos:=Pos;
    End;
    WMDExpSizes[K]:=J;
   End;
  End;
  WMDCoefsEnd[K]:=(WMDFrameLen-((WMDFrameLen*9) Div 100)) Shr K;
  T:=WMFi(BlockLen*2); T:=T*HighFreq; T:=T/WMFi(Rate);
  WMDHighStart[K]:=Trunc(Double(T)+0.5);
  N:=WMDExpSizes[K]; J:=0; Pos:=0;
  For I:=0 To N-1 Do Begin
   A:=Pos; Inc(Pos,WMDExpBands[K,I]); B:=Pos;
   If A<WMDHighStart[K] Then A:=WMDHighStart[K];
   If B>WMDCoefsEnd[K] Then B:=WMDCoefsEnd[K];
   If B>A Then Begin If J<16 Then WMDHighBands[K,J]:=B-A; Inc(J); End;
  End;
  WMDHighSizes[K]:=J;
 End;
 { fenetres sinus }
 For I:=0 To WMDNbSizes-1 Do Begin
  N:=1 Shl (WMDFrameBits-I);
  For J:=0 To N-1 Do Begin
   Arg:=(J+0.5)*(3.14159265358979323846/(2.0*N));
   WMDWin[I][J]:=WMSinf(WMFd(Arg));
  End;
 End;
 WMDResetBlocks:=True;
 If WMDNoise Then Begin
  If WMDExpVlc Then WMDNoiseMult:=0.02 Else WMDNoiseMult:=0.04;
  Seed:=1;
  Dv:=(1.0/2147483648.0)*Sqrt(3.0); Dv:=Dv*Double(WMDNoiseMult); Norm:=Dv;
  For I:=0 To 8191 Do Begin
   Seed:=Seed*314159+1;
   WMDNoiseTab[I]:=WMFi(LongInt(Seed))*Norm;
  End;
 End;
 { tables VLC des coefficients }
 CoefSel:=2;
 If Rate>=32000 Then Begin
  If Double(Bps1)<D072 Then CoefSel:=0 Else If Double(Bps1)<D116 Then CoefSel:=
   1;
 End;
 WMDCoefTables(0,CoefSel*2); WMDCoefTables(1,CoefSel*2+1);
 { MDCT inverses }
 For I:=0 To WMDNbSizes-1 Do WMTCtxInit(WMDCtx[I],1 Shl (WMDFrameBits-I),True,
  1.0/32768.0);
 If WMDNoise Then Begin
  WMDTreeHg:=WMDTreeNew; Code:=0;
  For I:=0 To 36 Do Begin
   WMDTreeAdd(WMDTreeHg,Code Shr (32-WMDHgLen[I]),WMDHgLen[I],WMDHgSym[I]);
   Code:=Code+(Int64(1) Shl (32-WMDHgLen[I]));
  End;
 End;
 If WMDExpVlc Then Begin
  WMDTreeExp:=WMDTreeNew;
  For I:=0 To 120 Do WMDTreeAdd(WMDTreeExp,WMDExpCode[I],WMDExpBits[I],I);
 End Else Begin
  Wdel:=3.14159265358979323846/WMDFrameLen;
  For I:=0 To WMDFrameLen-1 Do Begin
   T:=Wdel*WMFi(I); Dv:=Cos(Double(T)); Dv:=2.0*Dv; WMDLspCos[I]:=Dv;
  End;
  For I:=0 To 255 Do Begin
   Ln2:=I-126; Arg:=Ln2*(-0.25); T:=Arg;
   WMDLspPowE[I]:=Exp(Double(T)*0.693147180559945309417232121458);
  End;
  Bps1:=1.0; { b }
  T:=1.0;
  For I:=127 Downto 0 Do Begin
   K:=128+I;
   Bps:=K; Bps:=Bps*(0.5/128);
   Dv:=1.0/Sqrt(Sqrt(Double(Bps))); Bps:=Dv;
   WMDLspPowM1[I]:=2*Bps-T;
   WMDLspPowM2[I]:=T-Bps;
   T:=Bps;
  End;
  Move(WMDLsp,WMDLspBook,SizeOf(WMDLspBook));
 End;
 Move(WMDPow,WMDPowTab,SizeOf(WMDPowTab));
 FillChar(WMDExps,SizeOf(WMDExps),0); FillChar(WMDCoefs1,SizeOf(WMDCoefs1),0);
 FillChar(WMDCoefs,SizeOf(WMDCoefs),0); FillChar(WMDOutput,SizeOf(WMDOutput),0);
 FillChar(WMDFrameOut,SizeOf(WMDFrameOut),0); FillChar(WMDLast,SizeOf(WMDLast),
  0);
 WMDMaxExp[0]:=1.0; WMDMaxExp[1]:=1.0;
 WMDExpInit[0]:=0; WMDExpInit[1]:=0; WMDExpBSize[0]:=0; WMDExpBSize[1]:=0;
 WMDLastBitOff:=0; WMDLastLen:=0; WMDNoiseIdx:=0; WMDEofDone:=False;
 WMDSkip:=WMDFrameLen*2; WMDMs:=False; WMDCoded[0]:=False; WMDCoded[1]:=False;
 WMDBlockLen:=0; WMDBlockNum:=0; WMDBlockPos:=0;
 FillChar(WMDHighCoded,SizeOf(WMDHighCoded),0); FillChar(WMDHighVals,SizeOf(
  WMDHighVals),0);
 WMDReady:=True;
 WMDInit:=True;
End;

{ ================= decodage ================= }
Var WMDErr: LongInt; WMDTrace: Boolean; WMDBlkNo: LongInt;
Const
 WMDNone=-2147483647-1;
 WMLog210: Double=3.32192809488736234787;
 WMLn2: Extended=0.693147180559945309417232121458;
 WMS2: Single=2.0;
 WMSHalf: Single=0.5;

Function WMExp10(X: Double): Double;
Var A: Double;
Begin
 A:=WMLog210*X;
 WMExp10:=Exp(A*WMLn2);
End;

Function WMDPow14(X: Single): Single;
Var U,E,M,TV: LongWord; A,B,T: Single;
Begin
 U:=WMF2I(X);
 E:=U Shr 23; M:=(U Shr 16) And 127;
 TV:=((U Shl 7) And $7FFFFF) Or (127 Shl 23);
 A:=WMDLspPowM1[M]; B:=WMDLspPowM2[M]; T:=WMI2F(TV);
 If E>255 Then E:=255;
 WMDPow14:=WMDLspPowE[E]*(A+B*T);
End;

Procedure WMDExpLsp(Ch: LongInt);
Var Lsp: Array[0..9] Of Single; Val,I,J: LongInt; P,Q,W,V,VMax: Single;
Begin
 For I:=0 To 9 Do Begin
  If (I=0) Or (I>=8) Then Val:=WMDGet(3) Else Val:=WMDGet(4);
  Lsp[I]:=WMDLspBook[I*16+Val];
 End;
 VMax:=0;
 For I:=0 To WMDBlockLen-1 Do Begin
  P:=WMSHalf; Q:=WMSHalf; W:=WMDLspCos[I];
  J:=1;
  While J<10 Do Begin
   Q:=Q*(W-Lsp[J-1]);
   P:=P*(W-Lsp[J]);
   Inc(J,2);
  End;
  P:=P*(P*(WMS2-W));
  Q:=Q*(Q*(WMS2+W));
  V:=P+Q;
  V:=WMDPow14(V);
  If V>VMax Then VMax:=V;
  WMDExps[Ch][I]:=V;
 End;
 WMDMaxExp[Ch]:=VMax;
End;

Function WMDExpVlcDec(Ch: LongInt): Boolean;
Var LastExp,N,Code,Q,QEnd,Band,Rep: LongInt; V,MaxScale: Single;
Begin
 WMDExpVlcDec:=False;
 Band:=WMDFrameBits-WMDBlockBits;
 Q:=0; QEnd:=WMDBlockLen; MaxScale:=0; Rep:=0;
 If WMDVer=1 Then Begin
  LastExp:=WMDGet(5)+10;
  V:=WMDPowTab[LastExp+60]; MaxScale:=V;
  N:=WMDExpBands[Band,Rep]; Inc(Rep);
  If N=0 Then N:=4;
  While N>0 Do Begin If Q<2048 Then WMDExps[Ch][Q]:=V; Inc(Q); Dec(N); End;
 End Else LastExp:=36;
 While Q<QEnd Do Begin
  Code:=WMDVlc(WMDTreeExp);
  Inc(LastExp,Code-60);
  If (LastExp+60<0) Or (LastExp+60>=156) Then Exit;
  V:=WMDPowTab[LastExp+60];
  If V>MaxScale Then MaxScale:=V;
  If Rep>24 Then Exit;
  N:=WMDExpBands[Band,Rep]; Inc(Rep);
  If N=0 Then N:=4;
  While N>0 Do Begin If Q<2048 Then WMDExps[Ch][Q]:=V; Inc(Q); Dec(N); End;
 End;
 WMDMaxExp[Ch]:=MaxScale;
 WMDExpVlcDec:=True;
End;

{ ff_wma_run_level_decode (version 0) }
Function WMDRunLevel(T: LongInt; Ch,NumCoefs,CoefBits: LongInt): Boolean;
Var Offset,Code,Level,Sign,Mask: LongInt; F: Single;
Begin
 Mask:=WMDBlockLen-1; Offset:=0;
 While Offset<NumCoefs Do Begin
  Code:=WMDVlc(WMDTreeCoef[T]);
  If Code>1 Then Begin
   Inc(Offset,WMDRun[T][Code]);
   Sign:=WMDGet1-1;
   F:=WMDLevel[T][Code]; If Sign<>0 Then F:=-F;
   WMDCoefs1[Ch][Offset And Mask]:=F;
  End Else If Code=1 Then Break
  Else Begin
   Level:=WMDGet(CoefBits);
   Inc(Offset,WMDGet(WMDFrameBits));
   Sign:=WMDGet1-1;
   Level:=(Level Xor Sign)-Sign;
   WMDCoefs1[Ch][Offset And Mask]:=Level;
  End;
  Inc(Offset);
 End;
 WMDRunLevel:=Offset<=NumCoefs;
End;

Procedure WMDWindow(Ch: LongInt; OutOff: LongInt);
Var BlockLen,Bsize,N,I,InOff: LongInt; Win: ^TWMS2048;
Begin
 InOff:=0;
 If WMDBlockBits<=WMDPrevBits Then Begin
  BlockLen:=WMDBlockLen; Bsize:=WMDFrameBits-WMDBlockBits;
  For I:=0 To BlockLen-1 Do
   WMDFrameOut[Ch][OutOff+I]:=WMDOutput[I]*WMDWin[Bsize][I]+WMDFrameOut[Ch][
    OutOff+I];
 End Else Begin
  BlockLen:=1 Shl WMDPrevBits; N:=(WMDBlockLen-BlockLen) Div 2;
  Bsize:=WMDFrameBits-WMDPrevBits;
  For I:=0 To BlockLen-1 Do
   WMDFrameOut[Ch][OutOff+N+I]:=WMDOutput[N+I]*WMDWin[Bsize][I]+WMDFrameOut[Ch][
    OutOff+N+I];
  For I:=0 To N-1 Do WMDFrameOut[Ch][OutOff+N+BlockLen+I]:=WMDOutput[N+BlockLen+
   I];
 End;
 OutOff:=OutOff+WMDBlockLen; InOff:=WMDBlockLen;
 If WMDBlockBits<=WMDNextBits Then Begin
  BlockLen:=WMDBlockLen; Bsize:=WMDFrameBits-WMDBlockBits;
  For I:=0 To BlockLen-1 Do
   WMDFrameOut[Ch][OutOff+I]:=WMDOutput[InOff+I]*WMDWin[Bsize][BlockLen-1-I];
 End Else Begin
  BlockLen:=1 Shl WMDNextBits; N:=(WMDBlockLen-BlockLen) Div 2;
  Bsize:=WMDFrameBits-WMDNextBits;
  For I:=0 To N-1 Do WMDFrameOut[Ch][OutOff+I]:=WMDOutput[InOff+I];
  For I:=0 To BlockLen-1 Do
   WMDFrameOut[Ch][OutOff+N+I]:=WMDOutput[InOff+N+I]*WMDWin[Bsize][BlockLen-1-
    I];
  For I:=0 To N-1 Do WMDFrameOut[Ch][OutOff+N+BlockLen+I]:=0;
 End;
End;

{ 0 : bloc suivant, 1 : dernier bloc de la trame, -1 : erreur }
Function WMDBlock: LongInt;
Label Next;
Var
 N,V,A,Ch,Bsize,CoefBits,TotalGain,I,J,N1,LastHigh,Esize,Tindex,N4,Index,ExpOff,
  CoefOff,C1Off: LongInt;
 NbCoefs: Array[0..1] Of LongInt;
 MdctNorm,Mult,Mult1,Noise,E2,Vv,Mn: Single;
 ExpPower: Array[0..15] Of Single;
 Dv: Double;
 Cd: Boolean;
Begin
 WMDBlock:=-1;
 If WMDVarBlock Then Begin
  N:=WMLog2(WMDNbSizes-1)+1;
  If WMDResetBlocks Then Begin
   WMDResetBlocks:=False;
   V:=WMDGet(N); If V>=WMDNbSizes Then Begin WMDErr:=1; Exit; End;
   WMDPrevBits:=WMDFrameBits-V;
   V:=WMDGet(N); If V>=WMDNbSizes Then Begin WMDErr:=2; Exit; End;
   WMDBlockBits:=WMDFrameBits-V;
  End Else Begin
   WMDPrevBits:=WMDBlockBits; WMDBlockBits:=WMDNextBits;
  End;
  V:=WMDGet(N); If V>=WMDNbSizes Then Begin WMDErr:=3; Exit; End;
  WMDNextBits:=WMDFrameBits-V;
 End Else Begin
  WMDNextBits:=WMDFrameBits; WMDPrevBits:=WMDFrameBits; WMDBlockBits:=
   WMDFrameBits;
 End;
 If WMDFrameBits-WMDBlockBits>=WMDNbSizes Then Begin WMDErr:=4; Exit; End;
 WMDBlockLen:=1 Shl WMDBlockBits;
 If WMDBlockPos+WMDBlockLen>WMDFrameLen Then Begin WMDErr:=5; Exit; End;
 If WMDCh=2 Then WMDMs:=WMDGet1<>0;
 V:=0;
 For Ch:=0 To WMDCh-1 Do Begin
  A:=WMDGet1; WMDCoded[Ch]:=A<>0; V:=V Or A;
 End;
 Bsize:=WMDFrameBits-WMDBlockBits;
 If WMDTrace Then WriteLn('blk#',WMDBlkNo,' ms=',Ord(WMDMs),' c0=',Ord(WMDCoded[
  0]),' c1=',Ord(WMDCoded[1]),' bs=',Bsize);
 If V=0 Then Goto Next;
 TotalGain:=1;
 Repeat
  If WMDLeft<7 Then Begin WMDErr:=6; Exit; End;
  A:=WMDGet(7); Inc(TotalGain,A);
 Until A<>127;
 If TotalGain<15 Then CoefBits:=13 Else If TotalGain<32 Then CoefBits:=12
 Else If TotalGain<40 Then CoefBits:=11 Else If TotalGain<45 Then CoefBits:=10
  Else CoefBits:=9;
 N:=WMDCoefsEnd[Bsize]-WMDCoefsStart;
 For Ch:=0 To WMDCh-1 Do NbCoefs[Ch]:=N;
 If WMDNoise Then Begin
  For Ch:=0 To WMDCh-1 Do If WMDCoded[Ch] Then Begin
   N:=WMDHighSizes[Bsize];
   For I:=0 To N-1 Do Begin
    A:=WMDGet1;
    If I<16 Then WMDHighCoded[Ch][I]:=A;
    If A<>0 Then If I<16 Then Dec(NbCoefs[Ch],WMDHighBands[Bsize][I]);
   End;
  End;
  For Ch:=0 To WMDCh-1 Do If WMDCoded[Ch] Then Begin
   N:=WMDHighSizes[Bsize]; V:=WMDNone;
   For I:=0 To N-1 Do If (I<16) And (WMDHighCoded[Ch][I]<>0) Then Begin
    If V=WMDNone Then V:=WMDGet(7)-19
    Else Begin
     A:=WMDVlc(WMDTreeHg); If A>=0 Then Dec(A,18);
     V:=V+A;
    End;
    WMDHighVals[Ch][I]:=V;
   End;
  End;
 End;
 If (WMDBlockBits=WMDFrameBits) Or (WMDGet1<>0) Then Begin
  For Ch:=0 To WMDCh-1 Do If WMDCoded[Ch] Then Begin
   If WMDExpVlc Then Begin
    If Not WMDExpVlcDec(Ch) Then Begin WMDErr:=7; Exit; End;
   End Else WMDExpLsp(Ch);
   WMDExpBSize[Ch]:=Bsize; WMDExpInit[Ch]:=1;
  End;
 End;
 For Ch:=0 To WMDCh-1 Do If WMDCoded[Ch] And (WMDExpInit[Ch]=0) Then Begin
  WMDErr:=8; Exit; End;
 If WMDTrace Then WriteLn('  after exps pos=',WMDPos);
 For Ch:=0 To WMDCh-1 Do Begin
  If WMDCoded[Ch] Then Begin
   Tindex:=0; If (Ch=1) And WMDMs Then Tindex:=1;
   FillChar(WMDCoefs1[Ch],WMDBlockLen*4,0);
   If Not WMDRunLevel(Tindex,Ch,NbCoefs[Ch],CoefBits) Then Begin WMDErr:=9;
    Exit; End;
   If WMDTrace Then WriteLn('  after coefs ch',Ch,' pos=',WMDPos);
  End;
  If (WMDVer=1) And (WMDCh>=2) Then Begin
   N:=(-WMDPos) And 7; If N<>0 Then WMDSkipBits(N);
  End;
 End;
 If WMDTrace Then WriteLn('  gain=',TotalGain,' cbits=',CoefBits,' nb0=',
  NbCoefs[0],' nb1=',NbCoefs[1],' maxexp=',WMDMaxExp[0]:0:5,' ',WMDMaxExp[
  1]:0:5);
 N4:=WMDBlockLen Div 2;
 MdctNorm:=1.0/WMFi(N4);
 If WMDVer=1 Then Begin Dv:=N4; Dv:=Sqrt(Dv); Dv:=Dv*MdctNorm; MdctNorm:=Dv;
  End;
 For Ch:=0 To WMDCh-1 Do If WMDCoded[Ch] Then Begin
  Esize:=WMDExpBSize[Ch];
  Dv:=WMExp10(TotalGain*0.05);
  Dv:=Dv/WMDMaxExp[Ch]; Mult:=Dv;
  Mult:=Mult*MdctNorm;
  CoefOff:=0; C1Off:=0;
  If WMDNoise Then Begin
   Mult1:=Mult;
   For I:=0 To WMDCoefsStart-1 Do Begin
    WMDCoefs[Ch][CoefOff]:=WMDNoiseTab[WMDNoiseIdx]*WMDExps[Ch][WMSar(I Shl
     Bsize,Esize)]*Mult1;
    Inc(CoefOff);
    WMDNoiseIdx:=(WMDNoiseIdx+1) And 8191;
   End;
   N1:=WMDHighSizes[Bsize];
   ExpOff:=WMSar(WMDHighStart[Bsize] Shl Bsize,Esize);
   LastHigh:=0;
   For J:=0 To N1-1 Do Begin
    N:=WMDHighBands[WMDFrameBits-WMDBlockBits][J];
    If WMDHighCoded[Ch][J]<>0 Then Begin
     E2:=0;
     For I:=0 To N-1 Do Begin
      Vv:=WMDExps[Ch][ExpOff+WMSar(I Shl Bsize,Esize)];
      E2:=E2+Vv*Vv;
     End;
     ExpPower[J]:=E2/WMFi(N);
     LastHigh:=J;
    End;
    Inc(ExpOff,WMSar(N Shl Bsize,Esize));
   End;
   ExpOff:=WMSar(WMDCoefsStart Shl Bsize,Esize);
   For J:=-1 To N1-1 Do Begin
    If J<0 Then N:=WMDHighStart[Bsize]-WMDCoefsStart Else N:=WMDHighBands[
     WMDFrameBits-WMDBlockBits][J];
    If (J>=0) And (WMDHighCoded[Ch][J]<>0) Then Begin
     Mn:=ExpPower[J]/ExpPower[LastHigh];
     Dv:=Sqrt(Double(Mn)); Mult1:=Dv;
     Dv:=Mult1*WMExp10(WMDHighVals[Ch][J]*0.05);
     Mult1:=Dv;
     Mn:=WMDMaxExp[Ch]*WMDNoiseMult;
     Mult1:=Mult1/Mn;
     Mult1:=Mult1*MdctNorm;
     For I:=0 To N-1 Do Begin
      Noise:=WMDNoiseTab[WMDNoiseIdx];
      WMDNoiseIdx:=(WMDNoiseIdx+1) And 8191;
      WMDCoefs[Ch][CoefOff]:=Noise*WMDExps[Ch][ExpOff+WMSar(I Shl Bsize,Esize)]*
       Mult1;
      Inc(CoefOff);
     End;
     Inc(ExpOff,WMSar(N Shl Bsize,Esize));
    End Else Begin
     For I:=0 To N-1 Do Begin
      Noise:=WMDNoiseTab[WMDNoiseIdx];
      WMDNoiseIdx:=(WMDNoiseIdx+1) And 8191;
      Mn:=WMDCoefs1[Ch][C1Off]+Noise; Inc(C1Off);
      WMDCoefs[Ch][CoefOff]:=Mn*WMDExps[Ch][ExpOff+WMSar(I Shl Bsize,Esize)]*
       Mult;
      Inc(CoefOff);
     End;
     Inc(ExpOff,WMSar(N Shl Bsize,Esize));
    End;
   End;
   N:=WMDBlockLen-WMDCoefsEnd[Bsize];
   Mult1:=Mult*WMDExps[Ch][ExpOff+WMSar(-(1 Shl Bsize),Esize)];
   For I:=0 To N-1 Do Begin
    WMDCoefs[Ch][CoefOff]:=WMDNoiseTab[WMDNoiseIdx]*Mult1;
    Inc(CoefOff);
    WMDNoiseIdx:=(WMDNoiseIdx+1) And 8191;
   End;
  End Else Begin
   For I:=0 To WMDCoefsStart-1 Do Begin WMDCoefs[Ch][CoefOff]:=0.0; Inc(
    CoefOff); End;
   N:=NbCoefs[Ch];
   For I:=0 To N-1 Do Begin
    WMDCoefs[Ch][CoefOff]:=WMDCoefs1[Ch][I]*WMDExps[Ch][WMSar(I Shl Bsize,
     Esize)]*Mult;
    Inc(CoefOff);
   End;
   N:=WMDBlockLen-WMDCoefsEnd[Bsize];
   For I:=0 To N-1 Do Begin WMDCoefs[Ch][CoefOff]:=0.0; Inc(CoefOff); End;
  End;
 End;
 If WMDMs And WMDCoded[1] Then Begin
  If Not WMDCoded[0] Then Begin
   FillChar(WMDCoefs[0],WMDBlockLen*4,0); WMDCoded[0]:=True;
  End;
  For I:=0 To WMDBlockLen-1 Do Begin
   Mn:=WMDCoefs[1][I];
   WMDCoefs[1][I]:=WMDCoefs[0][I]-Mn;
   WMDCoefs[0][I]:=WMDCoefs[0][I]+Mn;
  End;
 End;
Next:
 For Ch:=0 To WMDCh-1 Do Begin
  N4:=WMDBlockLen Div 2;
  If WMDCoded[Ch] Then WMTImdct(WMDCtx[Bsize],WMDCoefs[Ch],WMDOutput)
  Else If Not (WMDMs And (Ch=1)) Then FillChar(WMDOutput,SizeOf(WMDOutput),0);
  Index:=(WMDFrameLen Div 2)+WMDBlockPos-N4;
  WMDWindow(Ch,Index);
 End;
 Inc(WMDBlockNum); Inc(WMDBlockPos,WMDBlockLen); Inc(WMDBlkNo);
 If WMDBlockPos>=WMDFrameLen Then WMDBlock:=1 Else WMDBlock:=0;
End;

Function WMDFrame(Off: LongInt): Boolean;
Var R,Ch,I: LongInt;
Begin
 WMDFrame:=False;
 WMDBlockNum:=0; WMDBlockPos:=0;
 Repeat
  R:=WMDBlock;
  If R<0 Then Begin If WMDTrace Then WriteLn('WMA: erreur bloc ',WMDErr,' pos ',
   WMDPos); Exit; End;
 Until R<>0;
 If WMDTrace Then WriteLn('frame end pos=',WMDPos,' end=',WMDEnd);
 For Ch:=0 To WMDCh-1 Do Begin
  Move(WMDFrameOut[Ch][0],WMDSamples[Ch][Off],WMDFrameLen*4);
  Move(WMDFrameOut[Ch][WMDFrameLen],WMDFrameOut[Ch][0],WMDFrameLen*4);
 End;
 WMDFrame:=True;
End;

{ Sortie : echantillons entrelaces s16 apres suppression de l'amorcage
 (skip_samples). }
Const WMS32768: Single=32768.0;
Var WMDDbg: File; WMDDbgOn: Boolean;
Procedure WMDEmit(Count,Off: LongInt);
Var J,Ch,Skip: LongInt; F: Single; V: LongInt; Q: Int64;
Begin
 J:=0;
 If WMDDbgOn Then Begin
  For J:=Off To Off+Count-1 Do For Ch:=0 To WMDCh-1 Do BlockWrite(WMDDbg,
   WMDSamples[Ch][J],4);
  J:=0;
 End;
 If WMDSkip>0 Then Begin
  Skip:=WMDSkip; If Skip>Count Then Skip:=Count;
  Dec(WMDSkip,Skip); J:=Skip;
 End;
 While J<Count Do Begin
  For Ch:=0 To WMDCh-1 Do Begin
   F:=WMDSamples[Ch][Off+J]*WMS32768;
   { av_clip_int16(lrintf(x)) : lrintf renvoie un long, tronque en int par
    av_clip_int16 }
   If (F<>F) Or (F>=9.2233720368547758E18) Or (F<=-9.2233720368547758E18) Then
    V:=0
   Else Begin
    Q:=Round(F); V:=LongInt(Q And $FFFFFFFF);
    If V>32767 Then V:=32767 Else If V<-32768 Then V:=-32768;
   End;
   EAPut(V);
  End;
  Inc(WMDOutCount); Inc(J);
 End;
End;

{ wma_decode_superframe. Retourne -1 en cas d'erreur de decodage ; Got = nombre
 de trames produites. }
Function WMDSuper(Buf: PEABuffer; PhysSize,BufSize: LongInt): LongInt;
Label Fail;
Var NbFrames,BitOffset,Pos,Len,I,Off,Q: LongInt; IsErr: Boolean;
Begin
 WMDSuper:=0;
 If BufSize<WMDAlign Then Begin WMDSuper:=-2; Exit; End;
 BufSize:=WMDAlign;
 WMDInitBits(Buf,PhysSize,BufSize*8);
 If WMDReservoir Then Begin
  WMDGet(4);
  NbFrames:=WMDGet(4);
  If WMDLastLen<=0 Then Dec(NbFrames);
  If NbFrames<=0 Then Begin
   IsErr:=(NbFrames<0) Or (WMDLeft<=8);
   If IsErr Then Begin WMDSuper:=-2; Exit; End;
   If (WMDLastLen+BufSize-1)>32768 Then Goto Fail;
   Q:=WMDLastLen; Len:=BufSize-1;
   While Len>0 Do Begin WMDLast[Q]:=WMDGet(8); Inc(Q); Dec(Len); End;
   FillChar(WMDLast[Q],64,0);
   Inc(WMDLastLen,8*BufSize-8);
   WMDSuper:=0; Exit;
  End;
 End Else NbFrames:=1;
 Off:=0;
 If WMDReservoir Then Begin
  BitOffset:=WMDGet(WMDByteOffBits+3);
  If WMDTrace Then WriteLn('SF nb=',NbFrames,' bitoff=',BitOffset,' lastlen=',
   WMDLastLen,' lastbitoff=',WMDLastBitOff);
  If BitOffset>WMDLeft Then Goto Fail;
  If WMDLastLen>0 Then Begin
   If (WMDLastLen+((BitOffset+7) Shr 3))>32768 Then Goto Fail;
   Q:=WMDLastLen; Len:=BitOffset;
   While Len>7 Do Begin WMDLast[Q]:=WMDGet(8); Inc(Q); Dec(Len,8); End;
   If Len>0 Then Begin WMDLast[Q]:=(WMDGet(Len) Shl (8-Len)) And 255; Inc(Q);
    End;
   FillChar(WMDLast[Q],64,0);
   WMDInitBits(@WMDLast,SizeOf(WMDLast),WMDLastLen*8+BitOffset);
   If WMDLastBitOff>0 Then WMDSkipBits(WMDLastBitOff);
   If Not WMDFrame(Off) Then Goto Fail;
   Inc(Off,WMDFrameLen); Dec(NbFrames);
  End;
  Pos:=BitOffset+4+4+WMDByteOffBits+3;
  If (Pos>=32768*8) Or (Pos>BufSize*8) Then Begin WMDSuper:=-2; Exit; End;
  WMDInitBits(@Buf^[Pos Shr 3],PhysSize-(Pos Shr 3),(BufSize-(Pos Shr 3))*8);
  Len:=Pos And 7; If Len>0 Then WMDSkipBits(Len);
  WMDResetBlocks:=True;
  For I:=0 To NbFrames-1 Do Begin
   If Not WMDFrame(Off) Then Goto Fail;
   Inc(Off,WMDFrameLen);
  End;
  Pos:=WMDPos+((BitOffset+4+4+WMDByteOffBits+3) And (Not 7));
  WMDLastBitOff:=Pos And 7;
  Pos:=Pos Shr 3;
  Len:=BufSize-Pos;
  If (Len>32768) Or (Len<0) Then Goto Fail;
  WMDLastLen:=Len;
  If Len>0 Then Move(Buf^[Pos],WMDLast[0],Len);
 End Else Begin
  If Not WMDFrame(Off) Then Goto Fail;
  Inc(Off,WMDFrameLen);
 End;
 WMDEmit(Off,0);
 WMDSuper:=Off;
 Exit;
Fail:
 WMDLastLen:=0;
 WMDSuper:=-1;
End;

Procedure WMDFlush;
Var Ch: LongInt;
Begin
 If WMDEofDone Then Exit;
 For Ch:=0 To WMDCh-1 Do Move(WMDFrameOut[Ch][0],WMDSamples[Ch][0],WMDFrameLen*
  4);
 WMDLastLen:=0; WMDEofDone:=True;
 WMDEmit(WMDFrameLen,0);
End;


Procedure WMDDumpTabs(Const Fn: String);
Var T: Text; I,J,L,K: LongInt; D: Double; Q: Int64;
 Function HexQ(V: Int64): String;
 Var S: String; K: Integer;
 Begin S:=''; For K:=15 Downto 0 Do S:=S+'0123456789abcdef'[((V Shr (K*4)) And
  15)+1]; HexQ:=S; End;
 Function H(F: Single): String;
 Var U: LongWord; S: String; K: Integer;
 Begin
  U:=WMF2I(F); S:='';
  For K:=7 Downto 0 Do S:=S+'0123456789abcdef'[((U Shr (K*4)) And 15)+1];
  H:=S;
 End;
Begin
 Assign(T,Fn); Rewrite(T);
 For I:=0 To WMDNbSizes-1 Do Begin
  J:=WMDFrameBits-I;
  For K:=0 To (1 Shl J)-1 Do WriteLn(T,'W ',J,' ',K,' ',H(WMDWin[I][K]));
  For K:=0 To WMDCtx[I].L2-1 Do WriteLn(T,'E ',WMDCtx[I].N,' ',K,' ',H(WMDCtx[
   I].ExRe[WMDCtx[I].L2+K]),' ',H(WMDCtx[I].ExIm[WMDCtx[I].L2+K]));
 End;
 For L:=3 To 11 Do For K:=0 To (1 Shl L) Div 4-1 Do WriteLn(T,'T ',L,' ',K,' ',
  H(WMTTab[L,K]));
 For K:=0 To 399 Do Begin D:=WMExp10(K*0.05); Move(D,Q,8); WriteLn(T,'X ',K,' ',
  HexQ(Q));
 End;
 If Not WMDExpVlc Then Begin
  For K:=0 To WMDFrameLen-1 Do WriteLn(T,'C ',K,' ',H(WMDLspCos[K]));
  For K:=0 To 255 Do WriteLn(T,'P ',K,' ',H(WMDLspPowE[K]));
  For K:=0 To 127 Do WriteLn(T,'M ',K,' 0 ',H(WMDLspPowM1[K]),' ',H(WMDLspPowM2[
   K]));
 End;
 Close(T);
End;

{ Cadre commun : ouverture sortie WAV, alimentation par paquets lus dans
 ActiveInput, fermeture. }
Var WMDPkt: PEABuffer; WMDOutRate,WMDOutCh: LongInt;

Procedure WMDStart(Const Target: String; Ver,Rate,Chans,BitRate,Align,Flags2:
 LongInt);
Begin
 If Align<=0 Then Fail('WMA: block_align absent.');
 If Align>8192 Then Fail('WMA: block_align trop grand.');
 If Not WMDInit(Ver,Rate,Chans,BitRate,Align,Flags2) Then Fail(
  'WMA: parametres audio invalides.');
 WMDTrace:=GetEnv('WMATRACE')<>'';
 WMDDbgOn:=GetEnv('WMADBG')<>'';
 If WMDDbgOn Then Begin Assign(WMDDbg,GetEnv('WMADBG')); Rewrite(WMDDbg,1); End;
 GetMem(WMDPkt,70000);
 If GetEnv('WMATABS')<>'' Then WMDDumpTabs(GetEnv('WMATABS'));
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,Chans,0);
 WMDOutRate:=Rate; WMDOutCh:=Chans; WMDOutCount:=0;
End;

{ Un paquet de Size octets a la position P de ActiveInput. }
Procedure WMDFeed(P,Size: LongInt);
Var PacketEnd,Total,J: LongInt;
Begin
 PacketEnd:=P+Size;
 While P<PacketEnd Do Begin
  Total:=PacketEnd-P; If Total>65000 Then Total:=65000;
  FillChar(WMDPkt^,70000,0);
  ReadAt(P,WMDPkt^,Total);
  J:=WMDSuper(WMDPkt,Total,Total);
  If J<0 Then Break;
  Inc(P,WMDAlign);
 End;
End;

Procedure WMDFinish;
Begin
 WMDFlush;
 If WMDDbgOn Then Close(WMDDbg);
 FreeMem(WMDPkt);
 EAFlush; ADPCMPatchHeader(WMDOutRate,WMDOutCh,EAWritten); CloseRead;
  CloseWrite;
End;

{ Decodeur WMA1/WMA2 : Source = spool ASFP0001 issu de DemuxASF, Target = WAV. }
Procedure DecodeWMASpool(Const Source,Target: String);
Var
 B: Array[0..3] Of Byte; Pos,FileLimit,Count,I,J,Track,PacketSize,PacketEnd:
  LongInt;
 Meta: Array[0..9] Of LongInt; Extra: Array[0..2047] Of Byte;
 Codec,AudioID,Rate,Chans,Align,BitRate,Flags2,Ver,ExtraSize: LongInt;
 GotTrack: Boolean;
 Function Rd32: LongInt;
 Begin
  If (Pos<0) Or (Pos>FileLimit-4) Then Fail('WMA: flux de paquets tronque.');
  ReadAt(Pos,B,4); Inc(Pos,4);
  Rd32:=LongInt(B[0])+LongInt(B[1])*256+LongInt(B[2])*65536+(LongInt(B[3]) Shl
   24);
 End;
Begin
 GotTrack:=False; AudioID:=-1; Ver:=0; Flags2:=0;
 OpenRead(Source); FileLimit:=InputSize; Pos:=0;
 If (Rd32<>$50465341) Or (Rd32<>$31303030) Then Fail('WMA: spool ASF attendu.');
 Count:=Rd32; If (Count<1) Or (Count>4) Then Fail(
  'WMA: nombre de pistes invalide.');
 For I:=1 To Count Do Begin
  For J:=0 To 9 Do Meta[J]:=Rd32;
  If (Meta[9]<0) Or (Meta[9]>2048) Or (Meta[9]>FileLimit-Pos) Then Fail(
   'WMA: configuration tronquee.');
  ReadAt(Pos,Extra,Meta[9]); Inc(Pos,Meta[9]);
  If (Meta[1]=2) And Not GotTrack And ((Meta[2]=$160) Or (Meta[2]=$161)) Then
   Begin
   GotTrack:=True; AudioID:=Meta[0]; Codec:=Meta[2]; Rate:=Meta[5]; Chans:=Meta[
    6]; Align:=Meta[7];
   BitRate:=Meta[8]; ExtraSize:=Meta[9];
   If Codec=$160 Then Begin
    Ver:=1; If ExtraSize>=4 Then Flags2:=Extra[2]+Extra[3]*256;
   End Else Begin
    Ver:=2; If ExtraSize>=6 Then Flags2:=Extra[4]+Extra[5]*256;
   End;
  End;
 End;
 If Not GotTrack Then Fail('WMA: piste WMA1/WMA2 absente.');
 WMDStart(Target,Ver,Rate,Chans,BitRate,Align,Flags2);
 Repeat
  Track:=Rd32; If Track=0 Then Break;
  Meta[0]:=Rd32; Meta[1]:=Rd32; PacketSize:=Rd32;
  If (PacketSize<=0) Or (PacketSize>FileLimit-Pos) Then Fail(
   'WMA: paquet tronque.');
  PacketEnd:=Pos+PacketSize;
  If Track=AudioID Then WMDFeed(Pos,PacketSize);
  Pos:=PacketEnd;
 Until False;
 WMDFinish;
End;

{ WAV avec format 0x160 / 0x161 (WMA1/WMA2) : paquets multiples de block_align
 (max_size 4096). }
Procedure DecodeWMAWav(Const Source,Target: String);
Var
 H: Array[0..39] Of Byte; Size,Pos,N,FmtPos,DataPos,DataLen,Ver,Rate,Chans,
  Align,BitRate,Flags2,Cb: LongInt;
 Extra: Array[0..39] Of Byte; Tag: LongInt; HaveFmt: Boolean;
 Function U16(At: LongInt): LongInt; Begin U16:=H[At]+H[At+1]*256; End;
 Function U32(At: LongInt): LongInt; Begin U32:=LongInt(H[At])+LongInt(H[At+1])*
  256+LongInt(H[At+2])*65536+(LongInt(H[At+3]) Shl 24); End;
Begin
 OpenRead(Source); Size:=InputSize; Pos:=12; HaveFmt:=False; DataPos:=-1;
  DataLen:=0; Flags2:=0; Cb:=0;
 Ver:=0; Rate:=0; Chans:=0; Align:=0; BitRate:=0;
 FillChar(Extra,SizeOf(Extra),0);
 While Pos+8<=Size Do Begin
  ReadAt(Pos,H,8); N:=U32(4);
  If (H[0]=102) And (H[1]=109) And (H[2]=116) And (H[3]=32) Then Begin
   If (N<16) Or (Pos+8+N>Size) Then Fail('WMA: bloc fmt invalide.');
   FillChar(H,SizeOf(H),0);
   ReadAt(Pos+8,H,16);
   Tag:=U16(0); Chans:=U16(2); Rate:=U32(4); BitRate:=U32(8)*8; Align:=U16(12);
   If N>=18 Then Begin
    ReadAt(Pos+8+16,H,2); Cb:=U16(0);
    If Cb>N-18 Then Cb:=N-18;
    If Cb>40 Then Cb:=40;
    If Cb>0 Then ReadAt(Pos+8+18,Extra,Cb);
   End;
   If Tag=$160 Then Begin
    Ver:=1; If Cb>=4 Then Flags2:=Extra[2]+Extra[3]*256;
   End Else Begin
    Ver:=2; If Cb>=6 Then Flags2:=Extra[4]+Extra[5]*256;
   End;
   HaveFmt:=True;
  End Else If (H[0]=100) And (H[1]=97) And (H[2]=116) And (H[3]=97) Then Begin
   DataPos:=Pos+8; DataLen:=N;
   If (DataLen<0) Or (DataPos+DataLen>Size) Then DataLen:=Size-DataPos;
   Break;
  End;
  If N<0 Then Break;
  Pos:=Pos+8+N+(N And 1);
 End;
 If Not HaveFmt Or (DataPos<0) Then Fail('WMA: WAV invalide.');
 WMDStart(Target,Ver,Rate,Chans,BitRate,Align,Flags2);
 { le demultiplexeur WAV de ffmpeg lit des paquets multiples de block_align (>=
  4096 octets) }
 Pos:=DataPos;
 N:=4096; If N<Align Then N:=Align; N:=(N Div Align)*Align;
 While Pos<DataPos+DataLen Do Begin
  If DataPos+DataLen-Pos<N Then Begin WMDFeed(Pos,DataPos+DataLen-Pos); Pos:=
   DataPos+DataLen; End
  Else Begin WMDFeed(Pos,N); Inc(Pos,N); End;
 End;
 WMDFinish;
End;

{ AVI avec un flux audio WMA1/WMA2 : paquets = blocs 'NNwb'. }
Function WMDAviHasWMA(Const Source: String): Boolean;
Var H: Array[0..39] Of Byte; Size,Pos,N,P2,E2,N2,Q,E3,N3: LongInt; Res: Boolean;
Begin
 Res:=False; OpenRead(Source); Size:=InputSize;
 If Size>=32 Then Begin
  ReadAt(0,H,12);
  If (H[0]=82) And (H[1]=73) And (H[2]=70) And (H[3]=70) And (H[8]=65) And (H[
   9]=86) And (H[10]=73) And (H[11]=32) Then Begin
   Pos:=12;
   While (Pos+12<=Size) And Not Res Do Begin
    ReadAt(Pos,H,12); N:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+(
     LongInt(H[7]) Shl 24);
    If (H[0]=76) And (H[1]=73) And (H[2]=83) And (H[3]=84) And (H[8]=104) And (
     H[9]=100) And (H[10]=114) And (H[11]=108) Then Begin
     P2:=Pos+12; E2:=Pos+8+N; If E2>Size Then E2:=Size;
     While (P2+12<=E2) And Not Res Do Begin
      ReadAt(P2,H,12); N2:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+(
       LongInt(H[7]) Shl 24);
      If (H[0]=76) And (H[1]=73) And (H[2]=83) And (H[3]=84) And (H[8]=115) And
       (H[9]=116) And (H[10]=114) And (H[11]=108) Then Begin
       Q:=P2+12; E3:=P2+8+N2; If E3>Size Then E3:=Size;
       While Q+8<=E3 Do Begin
        ReadAt(Q,H,8); N3:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+(
         LongInt(H[7]) Shl 24);
        If (H[0]=115) And (H[1]=116) And (H[2]=114) And (H[3]=102) And (N3>=16)
         And (Q+8+N3<=Size) Then Begin
         ReadAt(Q+8,H,2);
         If ((H[0]=$60) Or (H[0]=$61)) And (H[1]=1) Then Res:=True;
        End;
        If N3<0 Then Break;
        Inc(Q,8+N3+(N3 And 1));
       End;
      End;
      If N2<0 Then Break;
      Inc(P2,8+N2+(N2 And 1));
     End;
    End;
    If N<0 Then Break;
    Inc(Pos,8+N+(N And 1));
   End;
  End;
 End;
 CloseRead;
 WMDAviHasWMA:=Res;
End;

Procedure DecodeWMAAvi(Const Source,Target: String);
Var
 H: Array[0..39] Of Byte; Size,Pos,N,P2,E2,N2,Q,E3,N3,StreamNo,Found,MoviPos,
  MoviEnd,Cb,Tag: LongInt;
 Ver,Rate,Chans,Align,BitRate,Flags2: LongInt; Extra: Array[0..39] Of Byte;
  IsAud: Boolean; Id0,Id1: Byte;
 Function U16(At: LongInt): LongInt; Begin U16:=H[At]+H[At+1]*256; End;
 Function U32(At: LongInt): LongInt; Begin U32:=LongInt(H[At])+LongInt(H[At+1])*
  256+LongInt(H[At+2])*65536+(LongInt(H[At+3]) Shl 24); End;
 Procedure Chunks(P,E: LongInt);
 Var Sz: LongInt;
 Begin
  While P+8<=E Do Begin
   ReadAt(P,H,12); Sz:=U32(4);
   If Sz<0 Then Break;
   If (H[0]=76) And (H[1]=73) And (H[2]=83) And (H[3]=84) Then Chunks(P+12,P+8+
    Sz)
   Else If (H[0]=Id0) And (H[1]=Id1) And (H[2]=119) And (H[3]=98) And (Sz>0)
    Then Begin
    If P+8+Sz>Size Then Sz:=Size-P-8;
    WMDFeed(P+8,Sz);
   End;
   Inc(P,8+Sz+(Sz And 1));
  End;
 End;
Begin
 OpenRead(Source); Size:=InputSize; Pos:=12; StreamNo:=-1; Found:=-1; MoviPos:=-
  1; MoviEnd:=0;
 Ver:=0; Rate:=0; Chans:=0; Align:=0; BitRate:=0; Flags2:=0; FillChar(Extra,
  SizeOf(Extra),0);
 While Pos+12<=Size Do Begin
  ReadAt(Pos,H,12); N:=U32(4);
  If (H[0]=76) And (H[1]=73) And (H[2]=83) And (H[3]=84) And (H[8]=104) And (H[
   9]=100) And (H[10]=114) And (H[11]=108) Then Begin
   P2:=Pos+12; E2:=Pos+8+N; If E2>Size Then E2:=Size;
   While P2+12<=E2 Do Begin
    ReadAt(P2,H,12); N2:=U32(4);
    If (H[0]=76) And (H[1]=73) And (H[2]=83) And (H[3]=84) And (H[8]=115) And (
     H[9]=116) And (H[10]=114) And (H[11]=108) Then Begin
     Inc(StreamNo); Q:=P2+12; E3:=P2+8+N2; If E3>Size Then E3:=Size; IsAud:=
      False;
     While Q+8<=E3 Do Begin
      ReadAt(Q,H,12); N3:=U32(4);
      If (H[0]=115) And (H[1]=116) And (H[2]=114) And (H[3]=104) Then IsAud:=(H[
       8]=97) And (H[9]=117) And (H[10]=100) And (H[11]=115);
      If (H[0]=115) And (H[1]=116) And (H[2]=114) And (H[3]=102) And IsAud And (
       Found<0) And (N3>=16) And (Q+8+N3<=Size) Then Begin
       FillChar(H,SizeOf(H),0); ReadAt(Q+8,H,16);
       Tag:=U16(0);
       If (Tag=$160) Or (Tag=$161) Then Begin
        Found:=StreamNo; Chans:=U16(2); Rate:=U32(4); BitRate:=U32(8)*8; Align:=
         U16(12); Cb:=0;
        If N3>=18 Then Begin
         ReadAt(Q+8+16,H,2); Cb:=U16(0); If Cb>N3-18 Then Cb:=N3-18; If Cb>40
          Then Cb:=40;
         If Cb>0 Then ReadAt(Q+8+18,Extra,Cb);
        End;
        If Tag=$160 Then Begin Ver:=1; If Cb>=4 Then Flags2:=Extra[2]+Extra[3]*
         256; End
        Else Begin Ver:=2; If Cb>=6 Then Flags2:=Extra[4]+Extra[5]*256; End;
       End;
      End;
      If N3<0 Then Break;
      Inc(Q,8+N3+(N3 And 1));
     End;
    End;
    If N2<0 Then Break;
    Inc(P2,8+N2+(N2 And 1));
   End;
  End Else If (H[0]=76) And (H[1]=73) And (H[2]=83) And (H[3]=84) And (H[8]=109)
   And (H[9]=111) And (H[10]=118) And (H[11]=105) Then Begin
   MoviPos:=Pos+12; MoviEnd:=Pos+8+N; If MoviEnd>Size Then MoviEnd:=Size;
   Break;
  End;
  If N<0 Then Break;
  Inc(Pos,8+N+(N And 1));
 End;
 If (Found<0) Or (MoviPos<0) Then Fail('WMA: AVI sans flux audio WMA.');
 WMDStart(Target,Ver,Rate,Chans,BitRate,Align,Flags2);
 Id0:=48+(Found Div 10); Id1:=48+(Found Mod 10);
 Chunks(MoviPos,MoviEnd);
 WMDFinish;
End;
{ WMA-DEC-END }

{ ================= encodeur WMA1/WMA2 (wmaenc.c) et muxeur ASF (asfenc.c)
 ================= }
Const
 WMXGHeader: Array[0..15] Of Byte=($30,$26,$B2,$75,$8E,$66,$CF,$11,$A6,$D9,$00,
  $AA,$00,$62,$CE,$6C);
 WMXGFile: Array[0..15] Of Byte=($A1,$DC,$AB,$8C,$47,$A9,$CF,$11,$8E,$E4,$00,
  $C0,$0C,$20,$53,$65);
 WMXGHead1: Array[0..15] Of Byte=($B5,$03,$BF,$5F,$2E,$A9,$CF,$11,$8E,$E3,$00,
  $C0,$0C,$20,$53,$65);
 WMXGHead2: Array[0..15] Of Byte=($11,$D2,$D3,$AB,$BA,$A9,$CF,$11,$8E,$E6,$00,
  $C0,$0C,$20,$53,$65);
 WMXGExt: Array[0..15] Of Byte=($40,$A4,$D0,$D2,$07,$E3,$D2,$11,$97,$F0,$00,$A0,
  $C9,$5E,$A8,$50);
 WMXGStream: Array[0..15] Of Byte=($91,$07,$DC,$B7,$B7,$A9,$CF,$11,$8E,$E6,$00,
  $C0,$0C,$20,$53,$65);
 WMXGAudio: Array[0..15] Of Byte=($40,$9E,$69,$F8,$4D,$5B,$CF,$11,$A8,$FD,$00,
  $80,$5F,$5C,$44,$2B);
 WMXGSpread: Array[0..15] Of Byte=($50,$CD,$C3,$BF,$8F,$61,$CF,$11,$8B,$B2,$00,
  $AA,$00,$B4,$E2,$20);
 WMXGCodec: Array[0..15] Of Byte=($40,$52,$D1,$86,$1D,$31,$D0,$11,$A3,$A4,$00,
  $A0,$C9,$03,$48,$F6);
 WMXGCodec1: Array[0..15] Of Byte=($41,$52,$D1,$86,$1D,$31,$D0,$11,$A3,$A4,$00,
  $A0,$C9,$03,$48,$F6);
 WMXGData: Array[0..15] Of Byte=($36,$26,$B2,$75,$8E,$66,$CF,$11,$A6,$D9,$00,
  $AA,$00,$62,$CE,$6C);
 WMXPreroll=3100;
 WMXPktHdrMin=11;
 WMXPlHdrMulti=17;
 WMXPlHdrSingle=15;
Const WMFl32: Single=1.0/32768.0;
Type
 TWMXBuf=Array[0..65535] Of Byte;
Var
 { donnees du flux }
 WMXVer,WMXCh,WMXRate,WMXBitRate,WMXAlign,WMXPktSize: LongInt;
 { en-tete }
 WMXHdr: Array[0..8191] Of Byte; WMXHdrLen: LongInt;
 { paquets }
 WMXBuf: TWMXBuf; WMXFill: LongInt;
 WMXLeft,WMXNb,WMXMulti,WMXNbPackets: LongInt;
 WMXTsStart,WMXTsEnd,WMXDuration: Int64;
 WMXSeq: LongInt;
 { encodeur }
 WMEPb: Array[0..70000] Of Byte; WMEBits: LongInt;
 WMEQ: Array[0..1,0..2047] Of LongInt;
 WMECoefs: Array[0..1] Of TWMS2048;
 WMECtx: TWMTCtx;
 WMEAud: Array[0..1] Of TWMS2048;
 WMEFrameOut: Array[0..1] Of TWMS2048;
 WMEOutput: TWMS4096;
 WMEExpV: Single;
 WMEIntTab: Array[0..1,0..399] Of LongInt;
 WMEMaxLevel: Array[0..1] Of LongInt;
 WMESel: Array[0..1] Of LongInt;

{ ---- ecriture de l'en-tete ASF ---- }
Procedure WMXB(V: LongInt);
Begin WMXHdr[WMXHdrLen]:=V And 255; Inc(WMXHdrLen); End;
Procedure WMX16(V: LongInt);
Begin WMXB(V); WMXB(V Shr 8); End;
Procedure WMX32(V: Int64);
Begin WMXB(V And 255); WMXB((V Shr 8) And 255); WMXB((V Shr 16) And 255); WMXB((
 V Shr 24) And 255); End;
Procedure WMX64(V: Int64);
Var I: LongInt;
Begin For I:=0 To 7 Do Begin WMXB(V And 255); V:=V Shr 8; End; End;
Procedure WMXGuid(Const G: Array Of Byte);
Var I: LongInt;
Begin For I:=0 To 15 Do WMXB(G[I]); End;
Procedure WMXStr16(Const S: String);
Var I: LongInt;
Begin For I:=1 To Length(S) Do Begin WMXB(Ord(S[I])); WMXB(0); End; WMXB(0);
 WMXB(0); End;
Procedure WMXObjEnd(Start: LongInt);
Var Sz: LongInt; I: LongInt;
Begin
 Sz:=WMXHdrLen-Start;
 For I:=0 To 7 Do Begin If I<4 Then WMXHdr[Start+16+I]:=(Sz Shr (8*I)) And 255
  Else WMXHdr[Start+16+I]:=0; End;
End;

Var MdTmp16: Array[0..1023] Of Byte;
Const WMXGComment: Array[0..15] Of Byte=($33,$26,$B2,$75,$8E,$66,$CF,$11,$A6,
 $D9,$00,$AA,$00,$62,$CE,$6C);
{ UTF-8 -> octets UTF-16LE avec terminateur nul ; retourne la longueur }
Function MdPut16(Const S: String; Out_: PEABuffer): LongInt;
Var I,U,L,N: LongInt;
Procedure W(C: LongInt); Begin Out_^[N]:=C And 255; Out_^[N+1]:=(C Shr 8) And
 255; Inc(N,2); End;
Begin
 N:=0; I:=1;
 While I<=Length(S) Do Begin
  U:=Ord(S[I]); L:=0;
  If U>=$F0 Then Begin U:=U And 7; L:=3; End
  Else If U>=$E0 Then Begin U:=U And 15; L:=2; End
  Else If U>=$C0 Then Begin U:=U And 31; L:=1; End;
  Inc(I);
  While (L>0) And (I<=Length(S)) Do Begin U:=(U Shl 6) Or (Ord(S[I]) And 63);
   Inc(I); Dec(L); End;
  If U>=$10000 Then Begin Dec(U,$10000); W($D800+(U Shr 10)); W($DC00+(U And
   1023)); End Else W(U);
 End;
 W(0);
 MdPut16:=N;
End;

Procedure MdAsfPrepare; Forward;
Var MdInfo: Array[0..4095] Of Byte; MdInfoLen,MdInfoCnt: LongInt;
Procedure MdRiffBuild; Forward;
Function MdAsfFind(Const Key: String): LongInt;
Var I: LongInt; A,B: String;
Begin
 MdAsfFind:=-1;
 For I:=0 To MdAN-1 Do Begin
  A:=MdAK[I]; B:=Key;
  If Length(A)=Length(B) Then Begin
   While (Length(A)>0) And (UpCase(A[Length(A)])=UpCase(B[Length(B)])) Do Begin
    Delete(A,Length(A),1); Delete(B,Length(B),1); End;
   If Length(A)=0 Then Begin MdAsfFind:=I; Exit; End;
  End;
 End;
End;
Procedure WMX16Len(Const S: String);
Var T: Array[0..1023] Of Byte; N,I: LongInt;
Begin
 N:=MdPut16(S,@T);
 For I:=0 To N-1 Do WMXB(T[I]);
End;

Procedure WMXBuildHeader(FileSize,DataSize,NbPackets,Duration: Int64);
Var Start,HdrStart,I,WavSize,ExtraN,Cnt,Tg: LongInt; Desc: String; TagIdx:
 Array[0..4] Of LongInt;
Begin
 MdAsfPrepare;
 TagIdx[0]:=MdAsfFind('title'); TagIdx[1]:=MdAsfFind('author'); TagIdx[2]:=
  MdAsfFind('copyright');
 TagIdx[3]:=MdAsfFind('comment'); TagIdx[4]:=MdAsfFind('rating');
 Tg:=0; For I:=0 To 4 Do If TagIdx[I]>=0 Then Tg:=1;
 Cnt:=3+Tg+Ord(MdAN>0)+1;
 WMXHdrLen:=0;
 WMXGuid(WMXGHeader); WMX64(-1); WMX32(Cnt); WMXB(1); WMXB(2);
 HdrStart:=0;
 { proprietes du fichier }
 Start:=WMXHdrLen; WMXGuid(WMXGFile); WMX64(24);
 For I:=0 To 15 Do WMXB(0);
 WMX64(FileSize); WMX64(MdCreation*10+Int64(116444736000000000)); WMX64(
  NbPackets);
 WMX64(Duration+WMXPreroll*10000); WMX64(Duration); WMX64(WMXPreroll);
 WMX32(2); WMX32(WMXPktSize); WMX32(WMXPktSize); WMX32(WMXBitRate);
 WMXObjEnd(Start);
 { extension d'en-tete }
 Start:=WMXHdrLen; WMXGuid(WMXGHead1); WMX64(24); WMXGuid(WMXGHead2); WMX16(6);
  WMX32(0);
 WMXObjEnd(Start);
 { description du contenu }
 If Tg<>0 Then Begin
  Start:=WMXHdrLen; WMXGuid(WMXGComment); WMX64(24);
  For I:=0 To 4 Do Begin
   If TagIdx[I]>=0 Then Begin
    Desc:=MdAV[TagIdx[I]];
    WMX16(MdPut16(Desc,@MdTmp16));
   End Else WMX16(0);
  End;
  For I:=0 To 4 Do If TagIdx[I]>=0 Then WMX16Len(MdAV[TagIdx[I]]);
  WMXObjEnd(Start);
 End;
 { contenu etendu }
 If MdAN>0 Then Begin
  Start:=WMXHdrLen; WMXGuid(WMXGExt); WMX64(24); WMX16(MdAN);
  For I:=0 To MdAN-1 Do Begin
   WMX16(MdPut16(MdAK[I],@MdTmp16)); WMX16Len(MdAK[I]);
   WMX16(0);
   WMX16(MdPut16(MdAV[I],@MdTmp16)); WMX16Len(MdAV[I]);
  End;
  WMXObjEnd(Start);
 End;
 { proprietes du flux audio }
 Start:=WMXHdrLen; WMXGuid(WMXGStream); WMX64(24); WMXGuid(WMXGAudio); WMXGuid(
  WMXGSpread);
 WMX64(0);
 If WMXVer=1 Then ExtraN:=4 Else ExtraN:=10;
 WavSize:=18+ExtraN;
 WMX32(WavSize); WMX32(8); WMX16(1); WMX32(0);
 If WMXVer=1 Then WMX16($160) Else WMX16($161);
 WMX16(WMXCh); WMX32(WMXRate); WMX32(WMXBitRate Div 8); WMX16(WMXAlign); WMX16(
  16); WMX16(ExtraN);
 For I:=1 To ExtraN Do If (WMXVer=1) And (I=3) Then WMXB(1) Else If (WMXVer=2)
  And (I=5) Then WMXB(1) Else WMXB(0);
 WMXB(1); WMX16(WMXAlign); WMX16(WMXAlign); WMX16(1); WMXB(0);
 WMXObjEnd(Start);
 { liste des codecs }
 Start:=WMXHdrLen; WMXGuid(WMXGCodec); WMX64(24); WMXGuid(WMXGCodec1); WMX32(1);
  WMX16(2);
 If WMXVer=2 Then Desc:='Windows Media Audio V8' Else Desc:='wmav1';
 WMX16(Length(Desc)+1); WMXStr16(Desc); WMX16(0); WMX16(2);
 If WMXVer=1 Then WMX16($160) Else WMX16($161);
 WMXObjEnd(Start);
 { taille de l'objet en-tete }
 For I:=0 To 7 Do If I<4 Then WMXHdr[16+I]:=(WMXHdrLen Shr (8*I)) And 255 Else
  WMXHdr[16+I]:=0;
 { objet de donnees }
 WMXGuid(WMXGData); WMX64(DataSize); For I:=0 To 15 Do WMXB(0); WMX64(
  NbPackets); WMXB(1); WMXB(1);
End;


{ ---- en-tete AVI audio seul (avienc.c) ---- }
Procedure WMXTagStart(Const T: String; Var Start: LongInt);
Var I: LongInt;
Begin
 For I:=1 To 4 Do WMXB(Ord(T[I]));
 WMX32(0); Start:=WMXHdrLen;
End;
Procedure WMXTagEnd(Start: LongInt);
Var Sz,I: LongInt;
Begin
 Sz:=WMXHdrLen-Start;
 For I:=0 To 3 Do WMXHdr[Start-4+I]:=(Sz Shr (8*I)) And 255;
 If Odd(WMXHdrLen) Then WMXB(0);
End;
Procedure WMXFcc(Const T: String);
Var I: LongInt;
Begin For I:=1 To 4 Do WMXB(Ord(T[I])); End;
Function WMXGcd(A,B: LongInt): LongInt;
Var T: LongInt;
Begin While B<>0 Do Begin T:=A Mod B; A:=B; B:=T; End; WMXGcd:=A; End;

Procedure WMXAviHeader(RiffSize,NbPackets,MaxSize,MoviSize: LongInt);
Var L1,L2,Sh,Sf,Jk,I,ExtraN,Scale,Rate,G,Mv: LongInt; Id: String;
Begin
 WMXHdrLen:=0;
 WMXFcc('RIFF'); WMX32(RiffSize); WMXFcc('AVI ');
 WMXTagStart('LIST',L1); WMXFcc('hdrl');
 WMXFcc('avih'); WMX32(56);
 WMX32(0); WMX32(WMXBitRate Div 8); WMX32(0); WMX32($910); WMX32(0); WMX32(0);
  WMX32(1); WMX32(1048576);
 WMX32(0); WMX32(0); For I:=1 To 16 Do WMXB(0);
 WMXTagStart('LIST',L2); WMXFcc('strl');
 WMXTagStart('strh',Sh);
 WMXFcc('auds'); WMX32(1); WMX32(0); WMX16(0); WMX16(0); WMX32(0);
 G:=WMXGcd(WMDFrameLen,WMXRate); Scale:=WMDFrameLen Div G; Rate:=WMXRate Div G;
 WMX32(Scale); WMX32(Rate); WMX32(0);
 WMX32(NbPackets); WMX32(MaxSize); WMX32(-1); WMX32(WMXAlign); WMX32(0); WMX16(
  0); WMX16(0);
 WMXTagEnd(Sh);
 WMXTagStart('strf',Sf);
 If WMXVer=1 Then ExtraN:=4 Else ExtraN:=10;
 If WMXVer=1 Then WMX16($160) Else WMX16($161);
 WMX16(WMXCh); WMX32(WMXRate); WMX32(WMXBitRate Div 8); WMX16(WMXAlign); WMX16(
  16); WMX16(ExtraN);
 For I:=1 To ExtraN Do If (WMXVer=1) And (I=3) Then WMXB(1) Else If (WMXVer=2)
  And (I=5) Then WMXB(1) Else WMXB(0);
 WMXTagEnd(Sf);
 WMXTagStart('JUNK',Jk);
 WMX16(4); WMXB(0); WMXB(0); WMX32(0); WMXFcc('00wb'); For I:=1 To 12+16*256 Do
  WMXB(0);
 WMXTagEnd(Jk);
 WMXTagEnd(L2);
 WMXTagStart('JUNK',Jk); WMXFcc('odml'); WMXFcc('dmlh'); WMX32(248); For I:=1 To
  248 Do WMXB(0); WMXTagEnd(Jk);
 WMXTagEnd(L1);
 MdRiffBuild;
 If MdInfoCnt>0 Then For I:=0 To MdInfoLen-1 Do WMXB(MdInfo[I]);
 WMXTagStart('JUNK',Jk); For I:=1 To 1016 Do WMXB(0); WMXTagEnd(Jk);
 WMXFcc('LIST'); WMX32(MoviSize); WMXFcc('movi');
End;

{ ---- paquets ASF ---- }
Procedure WMXPb(V: LongInt);
Begin WMXBuf[WMXFill]:=V And 255; Inc(WMXFill); End;
Procedure WMXPb32(V: Int64);
Begin WMXPb(V And 255); WMXPb((V Shr 8) And 255); WMXPb((V Shr 16) And 255);
 WMXPb((V Shr 24) And 255); End;

Procedure WMXFlushPacket;
Var Hdr: Array[0..31] Of Byte; HL,PadSize,Ltf,I,N: LongInt; Send: Int64; Dur:
 LongInt;
 Procedure H(V: LongInt); Begin Hdr[HL]:=V And 255; Inc(HL); End;
Begin
 PadSize:=WMXLeft-WMXPktHdrMin;
 If WMXMulti<>0 Then Dec(PadSize);
 HL:=0; H($82); H(0); H(0);
 Ltf:=0;
 If WMXMulti<>0 Then Ltf:=Ltf Or 1;
 If PadSize>0 Then Begin If PadSize<256 Then Ltf:=Ltf Or 8 Else Ltf:=Ltf Or $10;
  End;
 H(Ltf); H($5D);
 If (Ltf And $10)<>0 Then Begin H(PadSize-2); H((PadSize-2) Shr 8); End;
 If (Ltf And 8)<>0 Then H(PadSize-1);
 Send:=WMXTsStart And $FFFFFFFF;
 H(Send And 255); H((Send Shr 8) And 255); H((Send Shr 16) And 255); H((Send Shr
  24) And 255);
 Dur:=(WMXTsEnd-WMXTsStart) And $FFFF;
 H(Dur And 255); H(Dur Shr 8);
 If WMXMulti<>0 Then H(WMXNb Or $80);
 FillChar(WMXBuf[WMXFill],WMXPktSize-WMXFill+1,0);
 WriteBytes(Hdr,HL);
 N:=WMXPktSize-HL;
 I:=0;
 While I<N Do Begin
  If N-I>32768 Then WriteBytes(WMXBuf[I],32768) Else WriteBytes(WMXBuf[I],N-I);
  Inc(I,32768);
 End;
 Inc(WMXNbPackets);
 WMXNb:=0; WMXTsStart:=-1; WMXTsEnd:=-1; WMXFill:=0;
End;

Procedure WMXPutFrame(Timestamp: Int64; Buf: Pointer; Size: LongInt);
Var ObjOff,PayLen,Frag1,MultiConst: LongInt; P: PEABuffer; Stop: Boolean;
Begin
 P:=Buf; ObjOff:=0;
 While ObjOff<Size Do Begin
  PayLen:=Size-ObjOff;
  If WMXTsStart=-1 Then Begin
   MultiConst:=WMXPktSize-(WMXPktHdrMin+1+2*WMXPlHdrMulti);
   If PayLen<MultiConst Then WMXMulti:=1 Else WMXMulti:=0;
   WMXLeft:=WMXPktSize;
   If WMXMulti<>0 Then Frag1:=MultiConst-1 Else Frag1:=WMXPktSize-(WMXPktHdrMin+
    WMXPlHdrSingle);
   WMXTsStart:=Timestamp;
  End Else Begin
   Frag1:=WMXLeft-WMXPlHdrMulti-WMXPktHdrMin-1;
   If Frag1<PayLen Then Begin WMXFlushPacket; Continue; End;
   If (WMXTsStart>High(LongInt)-65535) Or (Timestamp>WMXTsStart+65535) Then
    Begin WMXFlushPacket; Continue; End;
  End;
  If Frag1>0 Then Begin
   If PayLen>Frag1 Then PayLen:=Frag1
   Else If PayLen=Frag1-1 Then PayLen:=Frag1-2;
   { en-tete de charge utile }
   WMXPb(1);
   WMXPb(WMXSeq And 255);
   WMXPb32(ObjOff);
   WMXPb(8);
   WMXPb32(Size);
   WMXPb32(Timestamp+WMXPreroll);
   If WMXMulti<>0 Then Begin WMXPb(PayLen); WMXPb(PayLen Shr 8); End;
   Move(P^[ObjOff],WMXBuf[WMXFill],PayLen); Inc(WMXFill,PayLen);
   If WMXMulti<>0 Then Dec(WMXLeft,PayLen+WMXPlHdrMulti) Else Dec(WMXLeft,
    PayLen+WMXPlHdrSingle);
   WMXTsEnd:=Timestamp;
   Inc(WMXNb);
  End Else PayLen:=0;
  Inc(ObjOff,PayLen);
  If WMXMulti=0 Then WMXFlushPacket
  Else If WMXLeft<=(WMXPlHdrMulti+WMXPktHdrMin+1) Then WMXFlushPacket
  Else If WMXNb=63 Then WMXFlushPacket;
 End;
 Inc(WMXSeq);
End;

{ av_rescale_q arrondi au plus proche (demi vers l'infini) : A * Num / Den }
Function WMXRescale(A,Num,Den: Int64): Int64;
Begin
 If A<0 Then WMXRescale:=-((-A*Num+Den Div 2) Div Den)
 Else WMXRescale:=(A*Num+Den Div 2) Div Den;
End;

{ ================= encodeur ================= }
Procedure WMEPut(N,V: LongInt);
Var I: LongInt;
Begin
 For I:=N-1 Downto 0 Do Begin
  If ((V Shr I) And 1)<>0 Then WMEPb[WMEBits Shr 3]:=WMEPb[WMEBits Shr 3] Or (
   128 Shr (WMEBits And 7));
  Inc(WMEBits);
 End;
End;

Function WMECodeOf(Sel,I: LongInt): LongInt;
Begin
 Case Sel Of
  0: WMECodeOf:=WMDCode0[I]; 1: WMECodeOf:=WMDCode1[I]; 2: WMECodeOf:=WMDCode2[
   I];
  3: WMECodeOf:=WMDCode3[I]; 4: WMECodeOf:=WMDCode4[I]; Else WMECodeOf:=
   WMDCode5[I];
 End;
End;
Function WMEBitsOf(Sel,I: LongInt): LongInt;
Begin
 Case Sel Of
  0: WMEBitsOf:=WMDBits0[I]; 1: WMEBitsOf:=WMDBits1[I]; 2: WMEBitsOf:=WMDBits2[
   I];
  3: WMEBitsOf:=WMDBits3[I]; 4: WMEBitsOf:=WMDBits4[I]; Else WMEBitsOf:=
   WMDBits5[I];
 End;
End;
Function WMELevOf(Sel,I: LongInt): LongInt;
Begin
 Case Sel Of
  0: WMELevOf:=WMDLev0[I]; 1: WMELevOf:=WMDLev1[I]; 2: WMELevOf:=WMDLev2[I];
  3: WMELevOf:=WMDLev3[I]; 4: WMELevOf:=WMDLev4[I]; Else WMELevOf:=WMDLev5[I];
 End;
End;
Function WMELevCount(Sel: LongInt): LongInt;
Begin
 Case Sel Of 0: WMELevCount:=60; 1: WMELevCount:=40; 2: WMELevCount:=340; 3:
  WMELevCount:=180; 4: WMELevCount:=70; Else WMELevCount:=40; End;
End;
Function WMESize(Sel: LongInt): LongInt;
Begin
 Case Sel Of 0: WMESize:=666; 1: WMESize:=555; 2: WMESize:=1336; 3: WMESize:=
  1072; 4: WMESize:=476; Else WMESize:=435; End;
End;

Procedure WMEInitTables;
Var T,K,I,N: LongInt;
Begin
 For T:=0 To 1 Do Begin
  WMESel[T]:=WMDSelOf[T]; N:=WMESize(WMESel[T]);
  WMEMaxLevel[T]:=WMELevCount(WMESel[T]);
  I:=2; K:=0;
  While I<N Do Begin
   If K<400 Then WMEIntTab[T][K]:=I;
   Inc(I,WMELevOf(WMESel[T],K)); Inc(K);
  End;
 End;
End;

{ encode_block : 0 = ok, -1 = niveau trop grand }
Function WMEBlock(TotalGain: LongInt): LongInt;
Var
 Ch,I,N,CoefBits,Run,Level,AbsL,Code,T,N4,NBands,Sel,Bi,Last,C: LongInt;
 MdctNorm,Mult,Den,Q: Single; Dv,Tt: Double; Pos: LongInt;
Begin
 WMEBlock:=-1;
 N:=WMDCoefsEnd[0]-WMDCoefsStart;
 N4:=WMDFrameLen Div 2;
 MdctNorm:=1.0/WMFi(N4);
 If WMDVer=1 Then Begin Dv:=N4; Dv:=Sqrt(Dv); Dv:=Dv*MdctNorm; MdctNorm:=Dv;
  End;
 If WMDCh=2 Then WMEPut(1,1);
 For Ch:=0 To WMDCh-1 Do Begin
  Dv:=WMExp10(TotalGain*0.05); Dv:=Dv/WMEExpV; Mult:=Dv; Mult:=Mult*MdctNorm;
  Den:=WMEExpV*Mult;
  For I:=0 To N-1 Do Begin
   Q:=WMECoefs[Ch][WMDCoefsStart+I]/Den; Tt:=Q;
   If (Tt< -32768) Or (Tt>32767) Then Exit;
   WMEQ[Ch][I]:=Round(Tt);
  End;
 End;
 For Ch:=0 To WMDCh-1 Do WMEPut(1,1);
 C:=TotalGain-1;
 While C>=127 Do Begin WMEPut(7,127); Dec(C,127); End;
 WMEPut(7,C);
 If TotalGain<15 Then CoefBits:=13 Else If TotalGain<32 Then CoefBits:=12
 Else If TotalGain<40 Then CoefBits:=11 Else If TotalGain<45 Then CoefBits:=10
  Else CoefBits:=9;
 If WMDNoise Then
  For Ch:=0 To WMDCh-1 Do For I:=0 To WMDHighSizes[0]-1 Do WMEPut(1,0);
 { exposants (valeur fixe 20) }
 For Ch:=0 To WMDCh-1 Do Begin
  NBands:=WMDExpSizes[0];
  If WMDVer=1 Then Begin
   WMEPut(5,10); Last:=20;
   For Bi:=1 To NBands-1 Do WMEPut(WMDExpBits[60],WMDExpCode[60]);
  End Else Begin
   Last:=36;
   For Bi:=0 To NBands-1 Do Begin
    Code:=20-Last+60;
    WMEPut(WMDExpBits[Code],WMDExpCode[Code]); Last:=20;
   End;
  End;
 End;
 { coefficients }
 For Ch:=0 To WMDCh-1 Do Begin
  T:=0; If (Ch=1) And (WMDCh=2) Then T:=1;
  Sel:=WMESel[T];
  Run:=0;
  For I:=0 To N-1 Do Begin
   Level:=WMEQ[Ch][I];
   If Level<>0 Then Begin
    AbsL:=Abs(Level); Code:=0;
    If AbsL<=WMEMaxLevel[T] Then
     If Run<WMELevOf(Sel,AbsL-1) Then Code:=Run+WMEIntTab[T][AbsL-1];
    WMEPut(WMEBitsOf(Sel,Code),WMECodeOf(Sel,Code));
    If Code=0 Then Begin
     If (1 Shl CoefBits)<=AbsL Then Exit;
     WMEPut(CoefBits,AbsL);
     WMEPut(WMDFrameBits,Run);
    End;
    If Level<0 Then WMEPut(1,1) Else WMEPut(1,0);
    Run:=0;
   End Else Inc(Run);
  End;
  If Run<>0 Then WMEPut(WMEBitsOf(Sel,1),WMECodeOf(Sel,1));
  If (WMDVer=1) And (WMDCh>=2) Then
   While (WMEBits And 7)<>0 Do WMEPut(1,0);
 End;
 WMEBlock:=0;
End;

{ encode_frame : renvoie octets - block_align ou MaxInt }
Function WMEFrame(TotalGain: LongInt): LongInt;
Begin
 FillChar(WMEPb,SizeOf(WMEPb),0); WMEBits:=0;
 If WMEBlock(TotalGain)<0 Then Begin WMEFrame:=2147483647; Exit; End;
 While (WMEBits And 7)<>0 Do WMEPut(1,0);
 WMEFrame:=(WMEBits Div 8)-WMDAlign;
End;

{ WAV 16 bits -> ASF (WMA1/WMA2) }
Procedure EncodeWMAFile(Const Source,Target: String; Ver,BitRate,Cont: LongInt);
Var
 H: Array[0..39] Of Byte; Size,Pos,N,DataPos,DataLen,Rate,Chans,Bits,
  TotalSamples,Frames,K,Ch,I,J,Gain,Err,Stp,FrameN: LongInt;
 HaveFmt,IsFl: Boolean; NScale: Single; Buf: PEABuffer; Pcm: Array[0..8191] Of
  SmallInt; PcmF: Array[0..4095] Of Single;
 Dv: Double; Pts,Dts,Off,Dur: Int64; Done,Cnt,Take: LongInt; Pkt: Array[
  0..32767] Of Byte; Dummy: LongInt;
 FileSz: Int64;
 Function U16(At: LongInt): LongInt; Begin U16:=H[At]+H[At+1]*256; End;
 Function U32(At: LongInt): LongInt; Begin U32:=LongInt(H[At])+LongInt(H[At+1])*
  256+LongInt(H[At+2])*65536+(LongInt(H[At+3]) Shl 24); End;
Begin
 OpenRead(Source); Size:=InputSize; Pos:=12; HaveFmt:=False; DataPos:=-1;
  DataLen:=0; Rate:=0; Chans:=0; Bits:=0; IsFl:=False;
 While Pos+8<=Size Do Begin
  ReadAt(Pos,H,8); N:=U32(4);
  If (H[0]=102) And (H[1]=109) And (H[2]=116) And (H[3]=32) Then Begin
   If (N<16) Or (Pos+8+N>Size) Then Fail('WMA: bloc fmt invalide.');
   ReadAt(Pos+8,H,16); Chans:=U16(2); Rate:=U32(4); Bits:=U16(14);
   If Not (((U16(0)=1) And (Bits=16)) Or ((U16(0)=3) And (Bits=32))) Then Fail(
    'WMA: entree PCM 16 bits requise.');
   IsFl:=U16(0)=3;
   HaveFmt:=True;
  End Else If (H[0]=100) And (H[1]=97) And (H[2]=116) And (H[3]=97) Then Begin
   DataPos:=Pos+8; DataLen:=N;
   If (DataLen<0) Or (DataPos+DataLen>Size) Then DataLen:=Size-DataPos;
   Break;
  End;
  If N<0 Then Break;
  Pos:=Pos+8+N+(N And 1);
 End;
 If Not HaveFmt Or (DataPos<0) Then Fail('WMA: WAV invalide.');
 If Chans>2 Then Fail('WMA: too many channels.');
 If Rate>48000 Then Fail('WMA: sample rate is too high (> 48kHz).');
 If BitRate<24000 Then Fail('WMA: bitrate too low (24000 minimum).');
 If IsFl Then TotalSamples:=DataLen Div (4*Chans) Else TotalSamples:=DataLen Div
  (2*Chans);
 If TotalSamples<=0 Then Fail('WMA: aucun echantillon.');
 If Not WMDInit(Ver,Rate,Chans,BitRate,0,1) Then Fail(
  'WMA: parametres audio invalides.');
 WMDAlign:=(Int64(BitRate)*WMDFrameLen) Div (Int64(Rate)*8);
 If WMDAlign>32768 Then WMDAlign:=32768;
 WMEInitTables;
 WMTCtxInit(WMECtx,WMDFrameLen,False,1.0);
 WMEExpV:=WMExp10(20*(1.0/16.0));
 Dv:=2.0*32768.0/WMDFrameLen; NScale:=Dv;
 WMXVer:=Ver; WMXCh:=Chans; WMXRate:=Rate; WMXBitRate:=BitRate; WMXAlign:=
  WMDAlign; WMXPktSize:=3200;
 WMXFill:=0; WMXNb:=0; WMXTsStart:=-1; WMXTsEnd:=-1; WMXNbPackets:=0; WMXSeq:=1;
  WMXDuration:=0;
 FillChar(WMEFrameOut,SizeOf(WMEFrameOut),0);
 OpenWrite(Target);
 If Cont=1 Then WMXAviHeader(0,0,0,0) Else WMXBuildHeader(0,50,0,0);
 WriteBytes(WMXHdr,WMXHdrLen);
 Dummy:=0;
 FileSz:=WMXHdrLen;
 Frames:=(TotalSamples+WMDFrameLen-1) Div WMDFrameLen;
 { decalage de initial_padding (avoid_negative_ts) }
 Off:=-WMXRescale(-WMDFrameLen,1000,Rate);
 For FrameN:=0 To Frames-1 Do Begin
  { lecture des echantillons du bloc }
  Take:=TotalSamples-FrameN*WMDFrameLen; If Take>WMDFrameLen Then Take:=
   WMDFrameLen;
  For Ch:=0 To Chans-1 Do FillChar(WMEAud[Ch],SizeOf(WMEAud[Ch]),0);
  I:=0;
  While I<Take Do Begin
   Cnt:=Take-I; If Cnt>4096 Div Chans Then Cnt:=4096 Div Chans;
   If IsFl Then Begin
    ReadAt(DataPos+(FrameN*WMDFrameLen+I)*4*Chans,PcmF,Cnt*4*Chans);
    For J:=0 To Cnt-1 Do For Ch:=0 To Chans-1 Do WMEAud[Ch][I+J]:=PcmF[J*Chans+
     Ch];
   End Else Begin
   ReadAt(DataPos+(FrameN*WMDFrameLen+I)*2*Chans,Pcm,Cnt*2*Chans);
   For J:=0 To Cnt-1 Do For Ch:=0 To Chans-1 Do WMEAud[Ch][I+J]:=Pcm[J*Chans+
    Ch]*WMFl32;
   End;
   Inc(I,Cnt);
  End;
  { fenetrage + MDCT }
  For Ch:=0 To Chans-1 Do Begin
   For I:=0 To WMDFrameLen-1 Do WMEOutput[I]:=WMEFrameOut[Ch][I];
   For I:=0 To WMDFrameLen-1 Do WMEFrameOut[Ch][I]:=WMEAud[Ch][I]*NScale;
   For I:=0 To WMDFrameLen-1 Do WMEOutput[WMDFrameLen+I]:=WMEFrameOut[Ch][I]*
    WMDWin[0][WMDFrameLen-1-I];
   For I:=0 To WMDFrameLen-1 Do WMEFrameOut[Ch][I]:=WMEFrameOut[Ch][I]*WMDWin[
    0][I];
   WMTMdct(WMECtx,WMEOutput,WMECoefs[Ch]);
  End;
  If Chans=2 Then
   For I:=0 To WMDFrameLen-1 Do Begin
    Dv:=WMECoefs[0][I]*0.5;
    WMEAud[0][I]:=Dv;
    Dv:=WMECoefs[1][I]*0.5;
    WMEAud[1][I]:=Dv;
    WMECoefs[0][I]:=WMEAud[0][I]+WMEAud[1][I];
    WMECoefs[1][I]:=WMEAud[0][I]-WMEAud[1][I];
   End;
  { recherche du gain total }
  Gain:=128; Err:=0; Stp:=64;
  While Stp<>0 Do Begin
   Err:=WMEFrame(Gain-Stp);
   If Err<=0 Then Dec(Gain,Stp);
   Stp:=Stp Shr 1;
  End;
  While (Gain<=128) And (Err>0) Do Begin Err:=WMEFrame(Gain); Inc(Gain); End;
  If Err>0 Then Fail(
   'WMA: donnees invalides ou debit trop bas, encodage impossible.');
  { remplissage 'N' jusqu'a block_align }
  I:=(WMEBits+7) Div 8;
  While I<WMDAlign Do Begin WMEPb[I]:=78; Inc(I); End;
  { horodatage }
  Pts:=WMXRescale(Int64(FrameN-1)*WMDFrameLen,1000,Rate)+Off;
  Dur:=WMXRescale(Take,1000,Rate);
  If (Pts+Dur)*10000>WMXDuration Then WMXDuration:=(Pts+Dur)*10000;
  If Cont=1 Then Begin
   Pkt[0]:=48; Pkt[1]:=48; Pkt[2]:=119; Pkt[3]:=98;
   Pkt[4]:=WMDAlign And 255; Pkt[5]:=(WMDAlign Shr 8) And 255; Pkt[6]:=0; Pkt[
    7]:=0;
   WriteBytes(Pkt,8); WriteBytes(WMEPb,WMDAlign);
   If Odd(WMDAlign) Then Begin Pkt[0]:=0; WriteBytes(Pkt,1); End;
   Inc(WMXNbPackets);
  End Else WMXPutFrame(Pts,@WMEPb,WMDAlign);
 End;
 If Cont=1 Then Begin
  { idx1 puis mise a jour de l'en-tete }
  K:=8+WMDAlign+(WMDAlign And 1);
  Pkt[0]:=105; Pkt[1]:=100; Pkt[2]:=120; Pkt[3]:=49;
  I:=WMXNbPackets*16; Pkt[4]:=I And 255; Pkt[5]:=(I Shr 8) And 255; Pkt[6]:=(I
   Shr 16) And 255; Pkt[7]:=(I Shr 24) And 255;
  WriteBytes(Pkt,8);
  For I:=0 To WMXNbPackets-1 Do Begin
   Pkt[0]:=48; Pkt[1]:=48; Pkt[2]:=119; Pkt[3]:=98;
   Pkt[4]:=16; Pkt[5]:=0; Pkt[6]:=0; Pkt[7]:=0;
   J:=4+I*K;
   Pkt[8]:=J And 255; Pkt[9]:=(J Shr 8) And 255; Pkt[10]:=(J Shr 16) And 255;
    Pkt[11]:=(J Shr 24) And 255;
   Pkt[12]:=WMDAlign And 255; Pkt[13]:=(WMDAlign Shr 8) And 255; Pkt[14]:=0;
    Pkt[15]:=0;
   WriteBytes(Pkt,16);
  End;
  FileSz:=WMXHdrLen+Int64(WMXNbPackets)*K+8+Int64(WMXNbPackets)*16;
  WMXAviHeader(FileSz-8,WMXNbPackets,WMDAlign,4+WMXNbPackets*K);
 End Else Begin
 If WMXFill>0 Then WMXFlushPacket;
 FileSz:=WMXHdrLen+Int64(WMXNbPackets)*WMXPktSize;
 WMXBuildHeader(FileSz,50+Int64(WMXNbPackets)*WMXPktSize,WMXNbPackets,
  WMXDuration);
 End;
 {$I-}Seek(ActiveOutput,0); Dummy:=IOResult;{$I+}
 If Dummy<>0 Then Fail('WMA: repositionnement de l''en-tete impossible.');
 WriteBytes(WMXHdr,WMXHdrLen);
 CloseRead; CloseWrite;
End;
{ WMA-ENC-END }
{ WMA-END }

