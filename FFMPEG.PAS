{ ==== F5 BEGIN : formats null, crc, framecrc, rawvideo, yuv4mpegpipe, image2,
 image2pipe, gif, mpjpeg, dv, mxf, gxf ==== }
Const F5MaxFm=95;
Type
 F5TFm=Record Nm: String[12]; Pl: Byte; Hs,Vs,Bps,Bpp: Byte; Alpha,Full:
  Boolean; Y4: String[28]; End;
 F5TSrc=Record
  Path: String; IsY4M: Boolean; Fm: Integer; W,H,FN,FD,SarN,SarD: LongInt; Il:
   Char; Rng,Loc: Integer;
  FBytes,N,DataOff: LongInt; Pos: PALLong; HasPos: Boolean;
 End;
Var
 F5Fm: Array[0..F5MaxFm] Of F5TFm; F5NFm: Integer; F5FmInit: Boolean;
 F5S: F5TSrc; F5SF: File; F5SOpen: Boolean;
 F5OF: File; F5OOpen: Boolean; F5OStd: Boolean;
 F5Tmp: Array[1..6000] Of String[200]; F5NTmp: Integer; F5PrevExit: Pointer;
 F5InPix: String[20]; F5InW,F5InH: LongInt; F5InFN,F5InFD: LongInt; F5StartNum:
  LongInt; F5Update: LongInt; F5Loop: LongInt;
 F5PatType: String[12]; F5FinalDelay: LongInt; F5HasFD: Boolean; F5Quiet:
  Boolean; F5FrameRateSet: Boolean;
 F5Self: String; F5OutFmt: String[20]; F5NoBanner: Boolean; F5Boundary: String[
  60]; F5Strftime: Boolean;
 F5Sink: String[20]; F5InForced: String[20]; F5Hooked: Boolean;

Procedure F5AddFm(Const aNm: String; aPl,aHs,aVs,aBps,aBpp: Integer; aAlpha,
 aFull: Boolean; Const aY4: String);
Begin
 If F5NFm>F5MaxFm Then Exit;
 F5Fm[F5NFm].Nm:=aNm; F5Fm[F5NFm].Pl:=aPl; F5Fm[F5NFm].Hs:=aHs; F5Fm[F5NFm].Vs:=
  aVs; F5Fm[F5NFm].Bps:=aBps; F5Fm[F5NFm].Bpp:=aBpp;
 F5Fm[F5NFm].Alpha:=aAlpha; F5Fm[F5NFm].Full:=aFull; F5Fm[F5NFm].Y4:=aY4;
 Inc(F5NFm);
End;

Procedure F5InitFm;
Var D,S: Integer; Dn,Sn,Tg: String; Dp: Array[0..5] Of Integer;
Begin
 If F5FmInit Then Exit;
 F5FmInit:=True; F5NFm:=0;
 Dp[0]:=8; Dp[1]:=9; Dp[2]:=10; Dp[3]:=12; Dp[4]:=14; Dp[5]:=16;
 For D:=0 To 5 Do For S:=0 To 2 Do Begin
  If S=0 Then Sn:='420' Else If S=1 Then Sn:='422' Else Sn:='444';
  If Dp[D]=8 Then Begin
   Str(Dp[D],Dn); Dn:='';
   If S=0 Then Tg:='C420jpeg XYSCSS=420JPEG' Else Tg:='C'+Sn+' XYSCSS='+Sn;
   F5AddFm('yuv'+Sn+'p',1,Ord(S<2),Ord(S=0),1,0,False,False,Tg);
  End Else Begin
   Str(Dp[D],Dn);
   F5AddFm('yuv'+Sn+'p'+Dn+'le',1,Ord(S<2),Ord(S=0),2,0,False,False,'C'+Sn+'p'+
    Dn+' XYSCSS='+Sn+'P'+Dn);
  End;
 End;
 F5AddFm('yuv411p',1,2,0,1,0,False,False,'C411 XYSCSS=411');
 F5AddFm('yuv410p',1,2,2,1,0,False,False,'');
 F5AddFm('yuva444p',1,0,0,1,0,True,False,'C444alpha XYSCSS=444');
 F5AddFm('yuvj420p',1,1,1,1,0,False,True,'C420jpeg XYSCSS=420JPEG');
 F5AddFm('yuvj422p',1,1,0,1,0,False,True,'C422 XYSCSS=422');
 F5AddFm('yuvj444p',1,0,0,1,0,False,True,'C444 XYSCSS=444');
 F5AddFm('yuvj411p',1,2,0,1,0,False,True,'');
 F5AddFm('gray',2,0,0,1,0,False,False,'Cmono');
 F5AddFm('gray9le',2,0,0,2,0,False,False,'Cmono9');
 F5AddFm('gray10le',2,0,0,2,0,False,False,'Cmono10');
 F5AddFm('gray12le',2,0,0,2,0,False,False,'Cmono12');
 F5AddFm('gray16le',2,0,0,2,0,False,False,'Cmono16');
 F5AddFm('rgb24',0,0,0,1,3,False,False,'');
 F5AddFm('bgr24',0,0,0,1,3,False,False,'');
 F5AddFm('rgba',0,0,0,1,4,True,False,'');
 F5AddFm('bgra',0,0,0,1,4,True,False,'');
 F5AddFm('argb',0,0,0,1,4,True,False,'');
 F5AddFm('abgr',0,0,0,1,4,True,False,'');
 F5AddFm('rgb0',0,0,0,1,4,False,False,'');
 F5AddFm('bgr0',0,0,0,1,4,False,False,'');
 F5AddFm('0rgb',0,0,0,1,4,False,False,'');
 F5AddFm('0bgr',0,0,0,1,4,False,False,'');
 F5AddFm('rgb565le',0,0,0,1,2,False,False,'');
 F5AddFm('bgr565le',0,0,0,1,2,False,False,'');
 F5AddFm('rgb555le',0,0,0,1,2,False,False,'');
 F5AddFm('bgr555le',0,0,0,1,2,False,False,'');
 F5AddFm('yuyv422',0,0,0,1,2,False,False,'');
 F5AddFm('uyvy422',0,0,0,1,2,False,False,'');
 F5AddFm('rgb48le',0,0,0,2,6,False,False,'');
 F5AddFm('bgr48le',0,0,0,2,6,False,False,'');
 F5AddFm('rgba64le',0,0,0,2,8,True,False,'');
 F5AddFm('nv12',3,1,1,1,0,False,False,'');
 F5AddFm('nv21',3,1,1,1,0,False,False,'');
 F5AddFm('gbrp',1,0,0,1,0,False,False,'');
End;

Function F5FindFm(S: String): Integer;
Var I: Integer; T: String;
Begin
 F5InitFm; S:=Lower(S);
 If S='y8' Then S:='gray' Else If S='gray8' Then S:='gray' Else If S='gray16'
  Then S:='gray16le' Else If S='gray10' Then S:='gray10le'
 Else If S='gray12' Then S:='gray12le' Else If S='gray9' Then S:='gray9le';
 If (Length(S)>=8) And (Copy(S,1,3)='yuv') And (Pos('p',S)>0) And (S[Length(
  S)]<>'e') Then Begin
  { yuv420p10 -> yuv420p10le }
  T:=Copy(S,Length(S),1);
  If T[1] In ['0'..'9'] Then If Length(S)>=9 Then S:=S+'le';
 End;
 For I:=0 To F5NFm-1 Do If F5Fm[I].Nm=S Then Begin F5FindFm:=I; Exit; End;
 F5FindFm:=-1;
End;

Function F5CeilSh(V: LongInt; Sh: Integer): LongInt;Begin F5CeilSh:=(V+(1 Shl
 Sh)-1) Shr Sh; End;

Function F5FrameBytes(Fm: Integer; W,H: LongInt): LongInt;
Var CW,CH: LongInt; B: LongInt;
Begin
 With F5Fm[Fm] Do Begin
  Case Pl Of
   1: Begin CW:=F5CeilSh(W,Hs); CH:=F5CeilSh(H,Vs); B:=W*H+2*CW*CH; If Alpha
    Then B:=B+W*H; F5FrameBytes:=B*Bps; End;
   2: F5FrameBytes:=W*H*Bps;
   3: Begin CW:=F5CeilSh(W,1); CH:=F5CeilSh(H,1); F5FrameBytes:=W*H+2*CW*CH;
    End;
   Else F5FrameBytes:=W*H*Bpp;
  End;
 End;
End;

{ ---------- sortie standard / fichier ---------- }
Function F5Num(V: Int64; Wd: Integer): String;
Var S: String;
Begin
 Str(V,S); While Length(S)<Wd Do S:=' '+S; F5Num:=S;
End;

Function F5Hex8(V: Int64): String;
Const Dg: String[16]='0123456789abcdef';
Var S: String; I: Integer;
Begin
 S:='';
 For I:=7 Downto 0 Do S:=S+Dg[((V Shr (I*4)) And 15)+1];
 F5Hex8:=S;
End;

Procedure F5Exit;
Var I: Integer; F: File; Code: Integer;
Begin
 ExitProc:=F5PrevExit;
 If F5SOpen Then Begin {$I-}Close(F5SF);{$I+} Code:=IOResult; F5SOpen:=False;
  End;
 If F5OOpen Then Begin {$I-}Close(F5OF);{$I+} Code:=IOResult; F5OOpen:=False;
  End;
 For I:=1 To F5NTmp Do If F5Tmp[I]<>'' Then Begin
  Assign(F,F5Tmp[I]); {$I-}Erase(F);{$I+} Code:=IOResult; F5Tmp[I]:='';
 End;
End;

Procedure F5HookExit;
Begin
 If F5Hooked Then Exit;
 F5Hooked:=True; F5PrevExit:=ExitProc; ExitProc:=@F5Exit;
End;

Function F5NewTmp(Const Ext: String): String;
Var Folder,D: String; J,K: Integer; N: String;
Begin
 J:=Length(OutputPath);
 While (J>0) And Not (OutputPath[J] In ['/','\',':']) Do Dec(J);
 Folder:=Copy(OutputPath,1,J);
 If Length(Folder)>150 Then Folder:='';
 For K:=1 To 200 Do Begin
  Str(Random(900000),D); N:=Folder+'F5T'+D+Ext;
  If Not Exists(N) Then Begin
   For J:=1 To F5NTmp Do If F5Tmp[J]='' Then Begin F5Tmp[J]:=N; F5NewTmp:=N;
    Exit; End;
   If F5NTmp>=6000 Then Fail('F5: trop de fichiers temporaires.');
   Inc(F5NTmp); F5Tmp[F5NTmp]:=N; F5NewTmp:=N; Exit;
  End;
 End;
 Fail('F5: nom temporaire indisponible.'); F5NewTmp:='';
End;

Procedure F5DelTmp(Const Nm: String);
Var I: Integer; F: File; Code: Integer;
Begin
 For I:=1 To F5NTmp Do If F5Tmp[I]=Nm Then Begin
  Assign(F,Nm); {$I-}Erase(F);{$I+} Code:=IOResult; F5Tmp[I]:=''; Exit;
 End;
End;

Procedure F5OpenOut(Const Nm: String);
Var Code: Integer;
Begin
 If Nm='-' Then Begin
  Assign(F5OF,''); {$I-}Rewrite(F5OF,1);{$I+} Code:=IOResult; F5OStd:=True;
 End Else Begin
  If Exists(Nm) And Not Overwrite Then Fail('Sortie existante (utiliser -y): '+
   Nm);
  Assign(F5OF,Nm); {$I-}Rewrite(F5OF,1);{$I+} Code:=IOResult; F5OStd:=False;
 End;
 If Code<>0 Then Fail('Creation impossible: '+Nm);
 F5OOpen:=True;
End;

Procedure F5Wr(Var Buf; Cnt: LongInt);
Var P: PEABuffer; At,Q: LongInt; Code: Integer; Actual: LongInt;
Begin
 P:=@Buf; At:=0;
 While At<Cnt Do Begin
  Q:=Cnt-At; If Q>32768 Then Q:=32768;
  {$I-}BlockWrite(F5OF,P^[At],Q,Actual);{$I+} Code:=IOResult;
  If (Code<>0) Or (Actual<>Q) Then Fail('Ecriture incomplete.');
  Inc(At,Q);
 End;
End;

Procedure F5WrS(Const S: String);
Var T: String;
Begin
 T:=S; If Length(T)>0 Then F5Wr(T[1],Length(T));
End;

Procedure F5CloseOut;
Var Code: Integer;
Begin
 If F5OOpen Then Begin {$I-}Close(F5OF);{$I+} Code:=IOResult; F5OOpen:=False;
  End;
End;

{ ---------- lecture ---------- }
Procedure F5SrcOpen(Const Nm: String);
Var Code: Integer; OldMode: Byte;
Begin
 Assign(F5SF,Nm); OldMode:=FileMode; FileMode:=0;
 {$I-}Reset(F5SF,1);{$I+} Code:=IOResult; FileMode:=OldMode;
 If Code<>0 Then Fail('Lecture impossible: '+Nm);
 F5SOpen:=True;
End;

Procedure F5SrcClose;
Var Code: Integer;
Begin
 If F5SOpen Then Begin {$I-}Close(F5SF);{$I+} Code:=IOResult; F5SOpen:=False;
  End;
End;

Function F5Rd(Pos: LongInt; Var Buf; Cnt: LongInt): Boolean;
Var P: PEABuffer; At,Q,Actual: LongInt; Code: Integer;
Begin
 F5Rd:=False; P:=@Buf; At:=0;
 {$I-}Seek(F5SF,Pos);{$I+} Code:=IOResult;
 If Code<>0 Then Exit;
 While At<Cnt Do Begin
  Q:=Cnt-At; If Q>32768 Then Q:=32768;
  {$I-}BlockRead(F5SF,P^[At],Q,Actual);{$I+} Code:=IOResult;
  If (Code<>0) Or (Actual<>Q) Then Exit;
  Inc(At,Q);
 End;
 F5Rd:=True;
End;

Function F5SrcSize: LongInt;
Begin
 F5SrcSize:=FileSize(F5SF);
End;

{ lit une ligne (max Lim octets) a partir de Pos ; renvoie la longueur lue y
 compris le LF, 0 si echec }
Function F5RdLine(Pos: LongInt; Var Line: String; Lim: Integer): LongInt;
Var B: Array[0..0] Of Byte; Sz,N: LongInt;
Begin
 Line:=''; N:=0; Sz:=F5SrcSize; F5RdLine:=0;
 While (Pos+N<Sz) And (N<Lim) Do Begin
  If Not F5Rd(Pos+N,B,1) Then Exit;
  Inc(N);
  If B[0]=10 Then Begin F5RdLine:=N; Exit; End;
  If Length(Line)<250 Then Line:=Line+Chr(B[0]);
 End;
End;

Function F5Gcd(A,B: Int64): Int64;
Var T: Int64;
Begin
 If A<0 Then A:=-A; If B<0 Then B:=-B;
 While B<>0 Do Begin T:=A Mod B; A:=B; B:=T; End;
 F5Gcd:=A;
End;

Function F5ValL(Const S: String; Var P: LongInt): LongInt;
Var V: Int64; Neg: Boolean;
Begin
 V:=0; Neg:=False;
 If (P<=Length(S)) And (S[P]='-') Then Begin Neg:=True; Inc(P); End;
 While (P<=Length(S)) And (S[P] In ['0'..'9']) Do Begin If V<2000000000 Then V:=
  V*10+Ord(S[P])-48; Inc(P); End;
 If Neg Then V:=-V;
 F5ValL:=V;
End;

{ ouvre une source Y4M ; Fail si invalide }
Procedure F5OpenY4M(Const Nm: String);
Var Line,Tok,Tmp: String; Hl,Cur,Sz,Fl,K,P,Code: LongInt; I: Integer; Fh:
 String; Cn: String; Alt: String; Idx: Integer;
Begin
 F5InitFm; FillChar(F5S,SizeOf(F5S),0); F5S.Path:=Nm; F5S.IsY4M:=True;
  F5S.HasPos:=False; F5S.Pos:=Nil;
 F5SrcOpen(Nm); Sz:=F5SrcSize;
 Hl:=F5RdLine(0,Line,129);
 If (Hl=0) Or (Copy(Line,1,9)<>'YUV4MPEG2') Then Fail(
  'Y4M: signature YUV4MPEG2 invalide.');
 F5S.W:=-1; F5S.H:=-1; F5S.FN:=0; F5S.FD:=0; F5S.SarN:=0; F5S.SarD:=0; F5S.Il:=
  '?'; F5S.Rng:=0; F5S.Loc:=0;
 Cn:=''; Alt:='';
 Tmp:=Copy(Line,11,255)+' ';
 K:=1;
 While K<=Length(Tmp) Do Begin
  If Tmp[K]=' ' Then Begin Inc(K); Continue; End;
  Code:=K; Inc(K);
  Case Tmp[Code] Of
   'W': Begin F5S.W:=F5ValL(Tmp,K); End;
   'H': Begin F5S.H:=F5ValL(Tmp,K); End;
   'C': Begin
     Cn:=''; While (K<=Length(Tmp)) And (Tmp[K]<>' ') Do Begin Cn:=Cn+Tmp[K];
      Inc(K); End;
    End;
   'I': Begin
     If K<=Length(Tmp) Then Begin
      Case Tmp[K] Of
       '?': F5S.Il:='?'; 'p': F5S.Il:='p'; 't': F5S.Il:='t'; 'b': F5S.Il:='b';
       Else Fail('Y4M: en-tete invalide.');
      End;
      Inc(K);
     End;
    End;
   'F': Begin F5S.FN:=F5ValL(Tmp,K); If (K<=Length(Tmp)) And (Tmp[K]=':') Then
    Begin Inc(K); F5S.FD:=F5ValL(Tmp,K); End Else F5S.FD:=0; While (K<=Length(
    Tmp)) And (Tmp[K]<>' ') Do Inc(K); End;
   'A': Begin F5S.SarN:=F5ValL(Tmp,K); If (K<=Length(Tmp)) And (Tmp[K]=':') Then
    Begin Inc(K); F5S.SarD:=F5ValL(Tmp,K); End Else F5S.SarD:=0; While (
    K<=Length(Tmp)) And (Tmp[K]<>' ') Do Inc(K); End;
   'X': Begin
     Fh:=''; While (K<=Length(Tmp)) And (Tmp[K]<>' ') Do Begin Fh:=Fh+Tmp[K];
      Inc(K); End;
     If Copy(Fh,1,6)='YSCSS=' Then Alt:=Copy(Fh,7,40)
     Else If Copy(Fh,1,11)='COLORRANGE=' Then Begin
      If Copy(Fh,12,4)='FULL' Then F5S.Rng:=2 Else If Copy(Fh,12,7)='LIMITED'
       Then F5S.Rng:=1;
     End;
    End;
   Else Begin
     While (K<=Length(Tmp)) And (Tmp[K]<>' ') Do Inc(K);
    End;
  End;
 End;
 If (F5S.W<0) Or (F5S.H<0) Then Fail('Y4M: en-tete invalide.');
 Idx:=-1;
 If Cn<>'' Then Begin
  Tok:=Cn;
  If Copy(Tok,1,7)='420jpeg' Then Begin Idx:=F5FindFm('yuv420p'); F5S.Loc:=0;
   End
  Else If Copy(Tok,1,8)='420mpeg2' Then Begin Idx:=F5FindFm('yuv420p');
   F5S.Loc:=1; End
  Else If Copy(Tok,1,8)='420paldv' Then Begin Idx:=F5FindFm('yuv420p');
   F5S.Loc:=2; End
  Else If Copy(Tok,1,6)='420p16' Then Idx:=F5FindFm('yuv420p16le') Else If Copy(
   Tok,1,6)='422p16' Then Idx:=F5FindFm('yuv422p16le')
  Else If Copy(Tok,1,6)='444p16' Then Idx:=F5FindFm('yuv444p16le') Else If Copy(
   Tok,1,6)='420p14' Then Idx:=F5FindFm('yuv420p14le')
  Else If Copy(Tok,1,6)='422p14' Then Idx:=F5FindFm('yuv422p14le') Else If Copy(
   Tok,1,6)='444p14' Then Idx:=F5FindFm('yuv444p14le')
  Else If Copy(Tok,1,6)='420p12' Then Idx:=F5FindFm('yuv420p12le') Else If Copy(
   Tok,1,6)='422p12' Then Idx:=F5FindFm('yuv422p12le')
  Else If Copy(Tok,1,6)='444p12' Then Idx:=F5FindFm('yuv444p12le') Else If Copy(
   Tok,1,6)='420p10' Then Idx:=F5FindFm('yuv420p10le')
  Else If Copy(Tok,1,6)='422p10' Then Idx:=F5FindFm('yuv422p10le') Else If Copy(
   Tok,1,6)='444p10' Then Idx:=F5FindFm('yuv444p10le')
  Else If Copy(Tok,1,5)='420p9' Then Idx:=F5FindFm('yuv420p9le') Else If Copy(
   Tok,1,5)='422p9' Then Idx:=F5FindFm('yuv422p9le')
  Else If Copy(Tok,1,5)='444p9' Then Idx:=F5FindFm('yuv444p9le')
  Else If Copy(Tok,1,3)='420' Then Begin Idx:=F5FindFm('yuv420p'); F5S.Loc:=0;
   End
  Else If Copy(Tok,1,3)='411' Then Idx:=F5FindFm('yuv411p') Else If Copy(Tok,1,
   3)='422' Then Idx:=F5FindFm('yuv422p')
  Else If Copy(Tok,1,8)='444alpha' Then Idx:=F5FindFm('yuva444p') Else If Copy(
   Tok,1,3)='444' Then Idx:=F5FindFm('yuv444p')
  Else If Copy(Tok,1,6)='mono16' Then Idx:=F5FindFm('gray16le') Else If Copy(
   Tok,1,6)='mono12' Then Idx:=F5FindFm('gray12le')
  Else If Copy(Tok,1,6)='mono10' Then Idx:=F5FindFm('gray10le') Else If Copy(
   Tok,1,5)='mono9' Then Idx:=F5FindFm('gray9le')
  Else If Copy(Tok,1,4)='mono' Then Idx:=F5FindFm('gray')
  Else Fail('YUV4MPEG stream contains an unknown pixel format.');
 End;
 If Idx<0 Then Begin
  If Alt='' Then Idx:=F5FindFm('yuv420p')
  Else If Copy(Alt,1,4)='420J' Then Idx:=F5FindFm('yuv420p') Else If Copy(Alt,1,
   4)='420M' Then Idx:=F5FindFm('yuv420p') Else If Copy(Alt,1,4)='420P' Then
   Begin
   If Length(Alt)>4 Then Idx:=F5FindFm('yuv420p'+Copy(Alt,6,5)) Else Idx:=
    F5FindFm('yuv420p');
  End
  Else If Copy(Alt,1,3)='422' Then Idx:=F5FindFm('yuv422p'+Copy(Alt,5,5))
  Else If Copy(Alt,1,3)='444' Then Idx:=F5FindFm('yuv444p'+Copy(Alt,5,5))
  Else If Copy(Alt,1,3)='411' Then Idx:=F5FindFm('yuv411p')
  Else Idx:=F5FindFm('yuv420p');
  If Idx<0 Then Idx:=F5FindFm('yuv420p');
 End;
 F5S.Fm:=Idx;
 If (F5S.FN<=0) Or (F5S.FD<=0) Then Begin F5S.FN:=25; F5S.FD:=1; End;
 K:=F5Gcd(F5S.FN,F5S.FD); F5S.FN:=F5S.FN Div K; F5S.FD:=F5S.FD Div K;
 If (F5S.SarN=0) And (F5S.SarD=0) Then F5S.SarD:=1;
 If (F5S.W<1) Or (F5S.H<1) Or (F5S.W>16384) Or (F5S.H>16384) Then Fail(
  'Y4M: dimensions incorrectes.');
 F5S.FBytes:=F5FrameBytes(Idx,F5S.W,F5S.H);
 F5S.DataOff:=Hl;
 { balayage des en-tetes de trame }
 F5S.N:=0; Cur:=Hl;
 If Sz>Hl Then Begin
  GetMem(F5S.Pos,(Int64(Sz-Hl) Div (F5S.FBytes+6)+2)*4); F5S.HasPos:=True;
  While Cur<Sz Do Begin
   Fl:=F5RdLine(Cur,Fh,81);
   If (Fl=0) Or (Copy(Fh,1,5)<>'FRAME') Then Break;
   If Int64(Cur)+Fl+F5S.FBytes>Sz Then Break;
   F5S.Pos^[F5S.N]:=Cur+Fl; Inc(F5S.N); Cur:=Cur+Fl+F5S.FBytes;
  End;
 End;
End;

Function F5ReadFrame(I: LongInt; Buf: PEABuffer): Boolean;
Begin
 F5ReadFrame:=False;
 If (I<0) Or (I>=F5S.N) Then Exit;
 If F5S.IsY4M Then F5ReadFrame:=F5Rd(F5S.Pos^[I],Buf^,F5S.FBytes)
 Else F5ReadFrame:=F5Rd(F5S.DataOff+Int64(I)*F5S.FBytes,Buf^,F5S.FBytes);
End;

Procedure F5CloseSrc;
Begin
 F5SrcClose;
 If F5S.HasPos And (F5S.Pos<>Nil) Then Begin FreeMem(F5S.Pos); F5S.Pos:=Nil;
  F5S.HasPos:=False; End;
End;

{ ---------- sommes de controle ---------- }
Function F5Adler(Adler: LongInt; P: PEABuffer; Cnt: LongInt): LongInt;
Var A,B: Int64; I: LongInt;
Begin
 A:=Adler And $FFFF; B:=(Adler Shr 16) And $FFFF;
 For I:=0 To Cnt-1 Do Begin
  A:=A+P^[I]; If A>=65521 Then A:=A-65521;
  B:=B+A; If B>=65521 Then B:=B-65521;
 End;
 F5Adler:=LongInt((B Shl 16) Or A);
End;

Function F5Adler64(Adler: Int64; P: PEABuffer; Cnt: LongInt): Int64;
Var A,B: Int64; I: LongInt;
Begin
 A:=Adler And $FFFF; B:=(Adler Shr 16) And $FFFF;
 For I:=0 To Cnt-1 Do Begin
  A:=A+P^[I]; If A>=65521 Then A:=A-65521;
  B:=B+A; If B>=65521 Then B:=B-65521;
 End;
 F5Adler64:=(B Shl 16) Or A;
End;

{ ---------- conversions de format de pixels (sous-ensemble exact) ---------- }
Function F5Sat(V: Int64; Hi: Int64): Int64;Begin If V>Hi Then F5Sat:=Hi Else
 F5Sat:=V; End;
Function F5Sar(V: Int64; N: Integer): Int64;
Begin
 If V>=0 Then F5Sar:=V Shr N Else F5Sar:=-((-V+(Int64(1) Shl N)-1) Shr N);
End;
Function F5Cl8(V: Int64): Integer;Begin If V<0 Then F5Cl8:=0 Else If V>255 Then
 F5Cl8:=255 Else F5Cl8:=V; End;

{ gris/luma limite -> plein (lumRangeToJpeg_c) puis arrondi 15 -> 8 bits }
Function F5LumToJpeg(Y: Integer): Integer;
Var V: Int64;
Begin
 V:=F5Sat(Int64(Y) Shl 7,30189); V:=F5Sar(V*19077-39057361,14);
 F5LumToJpeg:=F5Cl8(F5Sar(V+64,7));
End;
Function F5LumFromJpeg(Y: Integer): Integer;
Var V: Int64;
Begin
 V:=F5Sar(Int64(Y Shl 7)*14071+33561947,14);
 F5LumFromJpeg:=F5Cl8(F5Sar(V+64,7));
End;
Function F5ChrToJpeg(C: Integer): Integer;
Var V: Int64;
Begin
 V:=F5Sat(Int64(C) Shl 7,30775); V:=F5Sar(V*4663-9289992,12);
 F5ChrToJpeg:=F5Cl8(F5Sar(V+64,7));
End;
Function F5ChrFromJpeg(C: Integer): Integer;
Var V: Int64;
Begin
 V:=F5Sar(Int64(C Shl 7)*1799+4081085,11);
 F5ChrFromJpeg:=F5Cl8(F5Sar(V+64,7));
End;

Function F5IsFullFm(Fm: Integer): Boolean;
Begin
 F5IsFullFm:=F5Fm[Fm].Full Or (F5Fm[Fm].Pl=2);
End;

Function F5Conv(Sf,Df: Integer; SrcFull: Boolean; W,H: LongInt; Src,Dst:
 PEABuffer): Boolean;
Var Sn,Dn: String; I,CW,CH,N,CN: LongInt; Rgb: PEABuffer; DstFull: Boolean;
Begin
 F5Conv:=True;
 Sn:=F5Fm[Sf].Nm; Dn:=F5Fm[Df].Nm;
 If Sf=Df Then Begin Move(Src^,Dst^,F5FrameBytes(Sf,W,H)); Exit; End;
 N:=W*H; CW:=(W+1) Div 2; CH:=(H+1) Div 2; CN:=CW*CH;
 DstFull:=F5IsFullFm(Df);
 If ((Sn='yuv420p') Or (Sn='yuvj420p') Or (Sn='gray')) And ((Dn='yuv420p') Or (
  Dn='yuvj420p') Or (Dn='gray')) Then Begin
  For I:=0 To N-1 Do
   If SrcFull=DstFull Then Dst^[I]:=Src^[I] Else If DstFull Then Dst^[I]:=
    F5LumToJpeg(Src^[I]) Else Dst^[I]:=F5LumFromJpeg(Src^[I]);
  If Dn<>'gray' Then Begin
   If Sn='gray' Then FillChar(Dst^[N],2*CN,128)
   Else For I:=N To N+2*CN-1 Do
    If SrcFull=DstFull Then Dst^[I]:=Src^[I] Else If DstFull Then Dst^[I]:=
     F5ChrToJpeg(Src^[I]) Else Dst^[I]:=F5ChrFromJpeg(Src^[I]);
  End;
  Exit;
 End;
 If (Sn='gray') And ((Dn='rgb24') Or (Dn='bgr24')) Then Begin
  For I:=0 To N-1 Do Begin Dst^[I*3]:=Src^[I]; Dst^[I*3+1]:=Src^[I]; Dst^[I*3+
   2]:=Src^[I]; End;
  Exit;
 End;
 If ((Sn='yuv420p') Or (Sn='yuvj420p')) And ((Dn='rgb24') Or (Dn='bgr24')) Then
  Begin
  NVW:=W; NVH:=H; NVFmt:=7; NVSubX:=1; NVSubY:=1; NVCW:=CW; NVCH:=CH;
   NVFullRng:=SrcFull; NVBT709:=False; H5Dst16:=False;
  GetMem(Rgb,N*3+16);
  H5YuvRgb(Src,Rgb,3,Nil);
  If Dn='rgb24' Then Move(Rgb^,Dst^,N*3) Else
   For I:=0 To N-1 Do Begin Dst^[I*3]:=Rgb^[I*3+2]; Dst^[I*3+1]:=Rgb^[I*3+1];
    Dst^[I*3+2]:=Rgb^[I*3]; End;
  FreeMem(Rgb);
  Exit;
 End;
 F5Conv:=False;
End;

Function F5CanConv(Sf,Df: Integer): Boolean;
Var Sn,Dn: String;
Begin
 Sn:=F5Fm[Sf].Nm; Dn:=F5Fm[Df].Nm;
 F5CanConv:=(Sf=Df) Or (((Sn='yuv420p') Or (Sn='yuvj420p')) And ((Dn='rgb24') Or
  (Dn='bgr24'))) Or
  (((Sn='yuv420p') Or (Sn='yuvj420p') Or (Sn='gray')) And ((Dn='yuv420p') Or (
   Dn='yuvj420p') Or (Dn='gray'))) Or ((Sn='gray') And ((Dn='rgb24') Or (
   Dn='bgr24')));
End;

{ ---------- en-tete Y4M (yuv4mpegenc.c) ---------- }
Function F5Y4MHeader(Fm: Integer; W,H,FN,FD,SarN,SarD: LongInt; Il: Char; Rng,
 Loc: Integer): String;
Var S,T,Cs,Cr: String; An,Ad: LongInt; Ic: Char; Nm: String;
Begin
 Nm:=F5Fm[Fm].Nm;
 An:=SarN; Ad:=SarD; If (An=0) And (Ad=1) Then Ad:=0;
 Cr:='';
 If Rng=1 Then Cr:=' XCOLORRANGE=LIMITED' Else If Rng=2 Then Cr:=
  ' XCOLORRANGE=FULL';
 If Il='t' Then Ic:='t' Else If Il='b' Then Ic:='b' Else Ic:='p';
 Cs:=F5Fm[Fm].Y4;
 If Nm='yuv420p' Then Begin
  If Loc=2 Then Cs:='C420paldv XYSCSS=420PALDV' Else If Loc=1 Then Cs:=
   'C420mpeg2 XYSCSS=420MPEG2' Else Cs:='C420jpeg XYSCSS=420JPEG';
 End;
 If F5Fm[Fm].Full
And Not V1NoRng
 Then Cr:=' XCOLORRANGE=FULL';
 If Cs<>'' Then Cs:=' '+Cs;
 S:='YUV4MPEG2 W'; Str(W,T); S:=S+T+' H'; Str(H,T); S:=S+T+' F'; Str(FN,T); S:=
  S+T+':'; Str(FD,T); S:=S+T+' I'+Ic+' A';
 Str(An,T); S:=S+T+':'; Str(Ad,T); S:=S+T+Cs+Cr+#10;
 F5Y4MHeader:=S;
End;

Function F5Y4MOk(Fm: Integer; Strict: Boolean): Boolean;
Var Nm: String;
Begin
 Nm:=F5Fm[Fm].Nm;
 F5Y4MOk:=False;
 If F5Fm[Fm].Y4='' Then Exit;
 If (Nm='yuv444p') Or (Nm='yuv422p') Or (Nm='yuv420p') Or (Nm='yuv411p') Or (
  Nm='gray') Or (Nm='yuvj420p') Or (Nm='yuvj422p') Or (Nm='yuvj444p') Then Begin
  F5Y4MOk:=True; Exit; End;
 F5Y4MOk:=Strict;
End;

{ ---------- WAV ---------- }
Var
 F5WCh,F5WRate,F5WBits,F5WTag,F5WAlign: LongInt; F5WData,F5WLen: LongInt;
  F5WMask: LongInt; F5WHaveMask: Boolean;

Function F5L32(Var B: Array Of Byte; At: Integer): LongInt;
Begin
 F5L32:=B[At]+B[At+1]*256+B[At+2]*65536+Int64(B[At+3])*16777216;
End;
Function F5L16(Var B: Array Of Byte; At: Integer): LongInt;
Begin F5L16:=B[At]+B[At+1]*256; End;

Function F5OpenWav(Const Nm: String): Boolean;
Var H: Array[0..63] Of Byte; Sz,Cur,CL: LongInt; Id: String[4]; Got: Boolean; I:
 Integer; HaveFmt: Boolean;
Begin
 F5OpenWav:=False; F5SrcOpen(Nm); Sz:=F5SrcSize; HaveFmt:=False; F5WHaveMask:=
  False; F5WMask:=0;
 If Sz<12 Then Exit;
 If Not F5Rd(0,H,12) Then Exit;
 If (Chr(H[0])+Chr(H[1])+Chr(H[2])+Chr(H[3])<>'RIFF') Or (Chr(H[8])+Chr(H[9])+
  Chr(H[10])+Chr(H[11])<>'WAVE') Then Exit;
 Cur:=12; Got:=False;
 While Cur+8<=Sz Do Begin
  If Not F5Rd(Cur,H,8) Then Break;
  Id:=Chr(H[0])+Chr(H[1])+Chr(H[2])+Chr(H[3]); CL:=F5L32(H,4);
  Inc(Cur,8);
  If Id='fmt ' Then Begin
   If CL<16 Then Exit;
   If Not F5Rd(Cur,H,16) Then Exit;
   F5WTag:=F5L16(H,0); F5WCh:=F5L16(H,2); F5WRate:=F5L32(H,4); F5WAlign:=F5L16(
    H,12); F5WBits:=F5L16(H,14);
   If (F5WTag=$FFFE) And (CL>=40) Then Begin
    If F5Rd(Cur+16,H,24) Then Begin
     F5WMask:=F5L32(H,4); F5WHaveMask:=True; F5WTag:=F5L16(H,8);
    End;
   End;
   HaveFmt:=True;
  End Else If Id='data' Then Begin
   F5WData:=Cur; F5WLen:=CL;
   If (CL<0) Or (Int64(Cur)+CL>Sz) Then F5WLen:=Sz-Cur;
   Got:=True; Break;
  End;
  If CL<0 Then Break;
  Cur:=Cur+CL+(CL And 1);
 End;
 F5OpenWav:=Got And HaveFmt;
End;

Function F5ChName(Ch: Integer; Mask: LongInt; HaveMask: Boolean): String;
Var S: String;
Begin
 If HaveMask And (Mask<>0) Then Begin
  Case Mask Of
   $4: Begin F5ChName:='mono'; Exit; End;
   $3: Begin F5ChName:='stereo'; Exit; End;
   $7: Begin F5ChName:='3.0'; Exit; End;
   $B: Begin F5ChName:='2.1'; Exit; End;
   $107: Begin F5ChName:='3.0(back)'; Exit; End;
   $33: Begin F5ChName:='quad'; Exit; End;
   $603: Begin F5ChName:='quad(side)'; Exit; End;
   $37: Begin F5ChName:='5.0'; Exit; End;
   $607: Begin F5ChName:='5.0(side)'; Exit; End;
   $3F: Begin F5ChName:='5.1'; Exit; End;
   $60F: Begin F5ChName:='5.1(side)'; Exit; End;
   $13F: Begin F5ChName:='6.1'; Exit; End;
   $63F: Begin F5ChName:='7.1'; Exit; End;
  End;
 End;
 Case Ch Of
  1: S:='mono'; 2: S:='stereo'; 3: S:='2.1'; 4: S:='4.0'; 5: S:='5.0'; 6: S:=
   '5.1'; 7: S:='6.1'; 8: S:='7.1';
  Else Begin Str(Ch,S); S:=S+' channels'; End;
 End;
 F5ChName:=S;
End;

{ ---------- options globales ---------- }
Function F5BitExact: Boolean;
Var I: Integer;
Begin
 F5BitExact:=VGBitExact;
End;

Function F5Software: String;
Begin
 If F5BitExact Then F5Software:='' Else F5Software:=
  '#software: Lavf60.16.100'#10;
End;

Function F5TbStr(N,D: LongInt): String;
Var A,B: String;
Begin
 Str(N,A); Str(D,B); F5TbStr:=A+'/'+B;
End;

{ nombre d'images a sortir : -frames:v, -t }
Function F5OutCount(N: LongInt): LongInt;
Var K,Lim: LongInt; T: Int64;
Begin
 Lim:=N;
 If (H4SVfr>0) And (H4SVfr<Lim) Then Lim:=H4SVfr;
 If H4STSet Then Begin
  { fin = t arrondi au plus proche en base de temps du flux ; image k acceptee
   si k < fin }
  K:=(H4STus*F5S.FN*2+Int64(F5S.FD)*1000000) Div (2*Int64(F5S.FD)*1000000);
  If K<1 Then K:=1;
  If K>Lim Then K:=Lim;
  Lim:=K;
 End;
 F5OutCount:=Lim;
End;

{ ---------- puits video : null, crc, framecrc, rawvideo, yuv4mpegpipe
 ---------- }
Procedure F5VideoSink(Const Sink: String);
Var Df,Sf,I,Cnt: LongInt; Fb,Db: LongInt; Sb,Db2,Pb: PEABuffer; Crc: Int64; L:
 String; A: Int64; Tmp: String; Strict: Boolean;
Begin
 Sf:=F5S.Fm; Df:=Sf;
 If OptPixFmt<>'' Then Begin
  Df:=F5FindFm(OptPixFmt);
  If Df<0 Then Fail('Unknown pixel format requested: '+OptPixFmt);
 End;
 If (Df<>Sf) And Not F5CanConv(Sf,Df) Then Fail(
  'Conversion de format de pixels non prise en charge: '+F5Fm[Sf].Nm+' -> '+
  F5Fm[Df].Nm);
 Fb:=F5S.FBytes; Db:=F5FrameBytes(Df,F5S.W,F5S.H);
 If (Sink='yuv4mpegpipe') Then Begin
  Strict:=LJUnofficial;
  If Not F5Y4MOk(Df,Strict) Then
   Fail(
    'yuv4mpeg can only handle yuv444p, yuv422p, yuv420p, yuv411p and gray8 pix'+
    'el formats. Use -pix_fmt to select one.');
 End;
 GetMem(Sb,Fb+64); GetMem(Db2,Db+64);
 Cnt:=F5OutCount(F5S.N);
 Crc:=1;
 If Sink<>'null' Then Begin
  If Sink='crc' Then F5OpenOut(OutputPath) Else F5OpenOut(OutputPath);
 End;
 If Sink='framecrc' Then Begin
  L:=F5Software+'#tb 0: '+F5TbStr(F5S.FD,F5S.FN)+#10+'#media_type 0: video'#10+
   '#codec_id 0: rawvideo'#10;
  Str(F5S.W,Tmp); L:=L+'#dimensions 0: '+Tmp+'x'; Str(F5S.H,Tmp); L:=L+Tmp+#10;
  Str(F5S.SarN,Tmp); L:=L+'#sar 0: '+Tmp+'/'; Str(F5S.SarD,Tmp); L:=L+Tmp+#10;
  F5WrS(L);
 End;
 If Sink='yuv4mpegpipe' Then Begin
  A:=0;
  { plage de couleur : une conversion de format fixe la plage }
  If Df<>Sf Then Begin
   If F5Fm[Df].Pl=2 Then A:=2 Else If F5Fm[Df].Full Then A:=2 Else A:=1;
   F5WrS(F5Y4MHeader(Df,F5S.W,F5S.H,F5S.FN,F5S.FD,F5S.SarN,F5S.SarD,F5S.Il,A,
    F5S.Loc));
  End Else
   F5WrS(F5Y4MHeader(Df,F5S.W,F5S.H,F5S.FN,F5S.FD,F5S.SarN,F5S.SarD,F5S.Il,
    F5S.Rng,F5S.Loc));
 End;
 For I:=0 To Cnt-1 Do Begin
  If Not F5ReadFrame(I,Sb) Then Break;
  If Df<>Sf Then Begin
   If Not F5Conv(Sf,Df,(F5S.Rng=2) Or F5IsFullFm(Sf),F5S.W,F5S.H,Sb,Db2) Then
    Fail('Conversion de format de pixels non prise en charge: '+F5Fm[Sf].Nm+
    ' -> '+F5Fm[Df].Nm);
   Pb:=Db2;
  End Else Pb:=Sb;
  If Sink='crc' Then Crc:=F5Adler64(Crc,Pb,Db)
  Else If Sink='framecrc' Then Begin
   A:=F5Adler64(0,Pb,Db);
   Str(I,Tmp); L:='0, '+F5Num(I,10)+', '+F5Num(I,10)+', '+F5Num(1,8)+', '+F5Num(
    Db,8)+', 0x'+F5Hex8(A)+#10;
   F5WrS(L);
  End
  Else If Sink='rawvideo' Then F5Wr(Pb^,Db)
  Else If Sink='yuv4mpegpipe' Then Begin F5WrS('FRAME'#10); F5Wr(Pb^,Db); End;
 End;
 If Sink='crc' Then F5WrS('CRC=0x'+F5Hex8(Crc)+#10);
 F5CloseOut;
 FreeMem(Sb); FreeMem(Db2);
End;

{ ---------- puits audio : null, crc, framecrc (PCM 16 bits) ---------- }
Procedure F5AudioSink(Const Sink: String);
Var Buf: PEABuffer; Left,At,Sz,Pts,Ns: LongInt; L,Tmp: String; Crc,A: Int64; Al:
 LongInt;
Begin
 If (F5WTag<>1) Or (F5WBits<>16) Then Fail(
  'Audio: seul PCM 16 bits (pcm_s16le) est pris en charge pour ce format de so'+
  'rtie.');
 If OptPixFmt<>'' Then Fail('Option -pix_fmt inapplicable a l''audio.');
 Al:=F5WAlign; If Al<1 Then Al:=F5WCh*2;
 If Sink<>'null' Then F5OpenOut(OutputPath);
 If Sink='framecrc' Then Begin
  Str(F5WRate,Tmp);
  L:=F5Software+'#tb 0: 1/'+Tmp+#10+'#media_type 0: audio'#10+
   '#codec_id 0: pcm_s16le'#10+'#sample_rate 0: '+Tmp+#10+
   '#channel_layout_name 0: '+F5ChName(F5WCh,F5WMask,F5WHaveMask)+#10;
  F5WrS(L);
 End;
 GetMem(Buf,8192+64);
 Crc:=1; Left:=F5WLen; At:=F5WData; Pts:=0;
 While Left>=Al Do Begin
  Sz:=4096; If Al>1 Then Begin If Sz<Al Then Sz:=Al; Sz:=(Sz Div Al)*Al; End;
  If Sz>Left Then Sz:=Left;
  Sz:=(Sz Div Al)*Al;
  If Sz=0 Then Break;
  If Not F5Rd(At,Buf^,Sz) Then Break;
  Ns:=Sz Div Al;
  If Sink='crc' Then Crc:=F5Adler64(Crc,Buf,Sz)
  Else If Sink='framecrc' Then Begin
   A:=F5Adler64(0,Buf,Sz);
   L:='0, '+F5Num(Pts,10)+', '+F5Num(Pts,10)+', '+F5Num(Ns,8)+', '+F5Num(Sz,8)+
    ', 0x'+F5Hex8(A)+#10;
   F5WrS(L);
  End;
  Inc(Pts,Ns); Inc(At,Sz); Dec(Left,Sz);
 End;
 If Sink='crc' Then F5WrS('CRC=0x'+F5Hex8(Crc)+#10);
 F5CloseOut;
 FreeMem(Buf);
End;

{ ---------- processus enfant (le programme lui-meme) ---------- }
Function F5Q(Const S: String): String;
Begin
 If Pos(' ',S)>0 Then F5Q:='"'+S+'"' Else F5Q:=S;
End;

Function F5Child(Const Args: String; Const Log: String): Boolean;
Var Ln: String;
Begin
 Ln:='-f5q '+F5Q(Log)+' '+Args;
 If Length(Ln)>250 Then Fail('F5: ligne de commande interne trop longue.');
 Exec(ParamStr(0),Ln);
 F5Child:=(DosError=0) And (DosExitCode=0);
End;

{ options a transmettre aux processus enfants (hors entree, sortie, -f, nombre
 d'images, etc.) }
Function F5Passthrough: String;
Var I,J: Integer; A,R: String; SeenI: Boolean;
Begin
 R:=''; SeenI:=False; I:=1;
 While I<ParamCount Do Begin
  A:=ParamStr(I);
  If Not SeenI Then Begin
   If A='-i' Then Begin SeenI:=True; Inc(I); End;
   Inc(I); Continue;
  End;
  If (A='-y') Or (A='-n') Or (A='-hide_banner') Or (A='-an') Or (A='-vn') Then
   Begin Inc(I); Continue; End;
  If (A='-f') Or (A='-frames:v') Or (A='-vframes') Or (A='-t') Or (
   A='-start_number') Or (A='-update') Or (A='-r') Or (A='-c:v') Or (
   A='-vcodec') Or
     (A='-codec:v') Or (A='-loop') Or (A='-final_delay') Or (A='-pattern_type')
      Or (A='-framerate') Or (A='-strftime') Or (A='-boundary_tag') Or (A='-c')
      Or (A='-codec') Or (A='-aspect') Then Begin Inc(I,2); Continue; End;
  R:=R+' '+F5Q(A); Inc(I);
  If (I<ParamCount) And (Copy(ParamStr(I),1,1)<>'-') Then Begin R:=R+' '+F5Q(
   ParamStr(I)); Inc(I); End;
 End;
 F5Passthrough:=R;
End;

{ ---------- ecriture d'une image seule (Y4M d'une trame) ---------- }
Procedure F5FrameY4M(I: LongInt; Const Nm: String);
Var Buf: PEABuffer; Code: Integer; Hd: String; Fh: File;
Begin
 GetMem(Buf,F5S.FBytes+64);
 If Not F5ReadFrame(I,Buf) Then Fail('F5: lecture de l''image impossible.');
 Assign(Fh,Nm); {$I-}Rewrite(Fh,1);{$I+} Code:=IOResult;
 If Code<>0 Then Fail('Creation impossible: '+Nm);
 Hd:=F5Y4MHeader(F5S.Fm,F5S.W,F5S.H,F5S.FN,F5S.FD,F5S.SarN,F5S.SarD,F5S.Il,
  F5S.Rng,F5S.Loc);
 BlockWrite(Fh,Hd[1],Length(Hd)); Hd:='FRAME'#10; BlockWrite(Fh,Hd[1],6);
 BlockWrite(Fh,Buf^,F5S.FBytes);
 Close(Fh);
 FreeMem(Buf);
End;

Procedure F5EraseFile(Const Nm: String);
Var F: File; Code: Integer;
Begin
 If Exists(Nm) Then Begin Assign(F,Nm); {$I-}Erase(F);{$I+} Code:=IOResult; End;
End;

{ codec d'image selon l'extension / -c:v }
Function F5ImgCodec(Const Path: String): String;
Var E: String;
Begin
 If (VideoCodec<>'') And (VideoCodec<>'copy') Then Begin F5ImgCodec:=VideoCodec;
  Exit; End;
 E:=Extension(Path);
 If E='png' Then F5ImgCodec:='png' Else If E='bmp' Then F5ImgCodec:='bmp'
 Else If (E='jpg') Or (E='jpeg') Or (E='mjpg') Then F5ImgCodec:='mjpeg'
 Else If E='ppm' Then F5ImgCodec:='ppm' Else If E='pgm' Then F5ImgCodec:='pgm'
  Else If E='pbm' Then F5ImgCodec:='pbm'
 Else If E='pam' Then F5ImgCodec:='pam' Else If E='pgmyuv' Then F5ImgCodec:=
  'pgmyuv'
 Else If (E='tga') Then F5ImgCodec:='targa' Else If (E='tif') Or (E='tiff') Then
  F5ImgCodec:='tiff'
 Else If E='sgi' Then F5ImgCodec:='sgi' Else If E='jls' Then F5ImgCodec:=
  'jpegls' Else If E='ljpg' Then F5ImgCodec:='ljpeg'
 Else If E='gif' Then F5ImgCodec:='gif'
 Else F5ImgCodec:='mjpeg';
End;

{ encode l'image I de la source dans le fichier Target avec le codec Codec }
Procedure F5EncodeImage(I: LongInt; Const Codec,Target: String);
Var Buf: PEABuffer; Fy: String; Args: String; Df: Integer; Sf: Integer;
Begin
 If Exists(Target) Then Begin
  If Not Overwrite Then Fail('Sortie existante (utiliser -y): '+Target);
  F5EraseFile(Target);
 End;
 Sf:=F5S.Fm;
 If ((Codec='png') Or (Codec='bmp')) And ((OptPixFmt='') Or (OptPixFmt=F5Fm[
  Sf].Nm)) And (F5Fm[Sf].Pl In [1,2]) And (F5Fm[Sf].Bps=1) And Not F5Fm[
  Sf].Alpha And (F5Fm[Sf].Nm<>'gbrp') Then Begin
  GetMem(Buf,F5S.FBytes+64);
  If Not F5ReadFrame(I,Buf) Then Fail('F5: lecture de l''image impossible.');
  If Codec='png' Then NVBegin(1,Target,F5S.W,F5S.H,7,F5S.FN,F5S.FD) Else
   NVBegin(2,Target,F5S.W,F5S.H,7,F5S.FN,F5S.FD);
  NVSarN:=F5S.SarN; NVSarD:=F5S.SarD;
  If F5Fm[Sf].Pl=2 Then Begin NVSubX:=0; NVSubY:=0; NVCW:=0; NVCH:=0; End
  Else Begin NVSubX:=F5Fm[Sf].Hs; NVSubY:=F5Fm[Sf].Vs; NVCW:=F5CeilSh(F5S.W,
   F5Fm[Sf].Hs); NVCH:=F5CeilSh(F5S.H,F5Fm[Sf].Vs); End;
  NVYTag:=F5Fm[Sf].Y4;
  NVFullRng:=(F5S.Rng=2) Or F5Fm[Sf].Full;
  NVBT709:=False;
  NVEmit(Buf);
  FreeMem(Buf);
  Exit;
 End;
 If (Codec='png') Or (Codec='bmp') Or (Codec='gif') Then Fail('F5: sortie '+
  Codec+' non prise en charge pour ce format de pixels: '+F5Fm[Sf].Nm);
 Fy:=F5NewTmp('.y4m');
 F5FrameY4M(I,Fy);
 Args:='-y -i '+F5Q(Fy)+' -frames:v 1 -c:v '+Codec+F5Passthrough+' '+F5Q(
  Target);
 Fy:=Fy;
 If Not F5Child(Args,F5NewTmp('.log')) Then Fail('F5: encodage '+Codec+
  ' impossible pour cette image (voir options -q:v, -pix_fmt).');
 F5DelTmp(Fy);
End;

Function F5PatternOk(Const P: String): Boolean;
Var I,J: Integer;
Begin
 F5PatternOk:=False; I:=1;
 While I<=Length(P) Do Begin
  If P[I]='%' Then Begin
   Inc(I);
   If (I<=Length(P)) And (P[I]='%') Then Begin Inc(I); Continue; End;
   While (I<=Length(P)) And (P[I] In ['0'..'9']) Do Inc(I);
   If (I<=Length(P)) And (P[I]='d') Then F5PatternOk:=True Else Exit;
  End;
  Inc(I);
 End;
End;

{ av_get_frame_filename2 }
Function F5PatName(Const P: String; Num: LongInt): String;
Var I,Wd: Integer; R,T: String; Zero: Boolean;
Begin
 R:=''; I:=1;
 While I<=Length(P) Do Begin
  If P[I]='%' Then Begin
   Inc(I);
   If (I<=Length(P)) And (P[I]='%') Then Begin R:=R+'%'; Inc(I); Continue; End;
   Wd:=0; Zero:=False;
   If (I<=Length(P)) And (P[I]='0') Then Zero:=True;
   While (I<=Length(P)) And (P[I] In ['0'..'9']) Do Begin Wd:=Wd*10+Ord(P[I])-
    48; Inc(I); End;
   Str(Num,T);
   While Length(T)<Wd Do T:='0'+T;
   R:=R+T; Inc(I);
  End Else Begin R:=R+P[I]; Inc(I); End;
 End;
 F5PatName:=R;
End;

{ ---------- puits image2 / image2pipe / mpjpeg ---------- }
Procedure F5ImageSink(Const Sink: String);
Var Cnt,I,Num: LongInt; Codec,Nm,Tf: String; Pat: Boolean; Upd: Boolean; Buf:
 PEABuffer; Sz,At,Q: LongInt; Fh: File; Code: Integer; Actual: LongInt; Hd:
 String; Lt: String;
Begin
 Codec:=F5ImgCodec(OutputPath);
 If Sink='mpjpeg' Then Begin
  If (VideoCodec<>'') And (VideoCodec<>'mjpeg') Then Fail(
   'mpjpeg: seul le codec mjpeg est pris en charge.');
  Codec:='mjpeg';
 End;
 If Sink='image2pipe' Then Begin
  If (VideoCodec='') Then Codec:='mjpeg';
 End;
 Cnt:=F5OutCount(F5S.N);
 If Cnt<=0 Then Fail(
  'Nothing was written into output file, because at least one of its streams r'+
  'eceived no packets.');
 If Sink='image2' Then Begin
  Pat:=F5PatternOk(OutputPath); Upd:=F5Update<>0;
  If F5StartNum>=0 Then Num:=F5StartNum Else Num:=1;
  I:=0;
  If Upd Then I:=Cnt-1;
  While I<Cnt Do Begin
   If Upd Then Nm:=OutputPath
   Else If Pat Then Nm:=F5PatName(OutputPath,Num+I)
   Else If I=0 Then Nm:=OutputPath
   Else Begin
    Fail(
     'Cannot write more than one file with the same name. Are you missing the '+
     '-update option or a sequence pattern?');
   End;
   F5EncodeImage(I,Codec,Nm);
   Inc(I);
  End;
  Exit;
 End;
 { image2pipe, mpjpeg : fichier ou flux }
 F5OpenOut(OutputPath);
 If Sink='mpjpeg' Then Begin
  If F5Boundary='' Then F5Boundary:='ffmpeg';
  F5WrS('--'+F5Boundary+#13#10);
 End;
 Tf:=F5NewTmp('.img');
 For I:=0 To Cnt-1 Do Begin
  F5EncodeImage(I,Codec,Tf);
  Assign(Fh,Tf); FileMode:=0; {$I-}Reset(Fh,1);{$I+} Code:=IOResult; FileMode:=
   2;
  If Code<>0 Then Fail('F5: image intermediaire illisible.');
  Sz:=FileSize(Fh);
  GetMem(Buf,Sz+16);
  BlockRead(Fh,Buf^,Sz,Actual); Close(Fh);
  If Sink='mpjpeg' Then Begin
   Str(Sz,Lt);
   F5WrS('Content-type: image/jpeg'#13#10'Content-length: '+Lt+#13#10#13#10);
   F5Wr(Buf^,Sz);
   F5WrS(#13#10'--'+F5Boundary+#13#10);
  End Else F5Wr(Buf^,Sz);
  FreeMem(Buf);
  F5EraseFile(Tf);
 End;
 F5CloseOut;
End;

{ ---------- sources : rawvideo, sequences d'images, flux decodes par le
 programme ---------- }
Procedure F5SetupRaw(Const Nm: String);
Var Fm: Integer; Sz: LongInt; Pn: String;
Begin
 F5InitFm;
 Pn:=F5InPix; If Pn='' Then Pn:='yuv420p';
 Fm:=F5FindFm(Pn);
 If Fm<0 Then Fail('Unknown pixel format requested: '+Pn);
 If (F5InW<=0) Or (F5InH<=0) Then Fail(
  'Unable to parse option value "(null)" as image size');
 FillChar(F5S,SizeOf(F5S),0);
 F5S.Path:=Nm; F5S.IsY4M:=False; F5S.Fm:=Fm; F5S.W:=F5InW; F5S.H:=F5InH;
 If F5InFN>0 Then Begin F5S.FN:=F5InFN; F5S.FD:=F5InFD; End Else Begin F5S.FN:=
  25; F5S.FD:=1; End;
 F5S.SarN:=0; F5S.SarD:=1; F5S.Il:='p'; F5S.Rng:=0; F5S.Loc:=0;
 F5S.FBytes:=F5FrameBytes(Fm,F5S.W,F5S.H); F5S.DataOff:=0;
 F5SrcOpen(Nm); Sz:=F5SrcSize;
 F5S.N:=Sz Div F5S.FBytes;
 If F5S.N<=0 Then Fail(Nm+': Invalid data found when processing input');
End;

Procedure F5ShowLog(Const Log: String);
Var T: Text; L: String; Code: Integer;
Begin
 Assign(T,Log); {$I-}Reset(T);{$I+} Code:=IOResult;
 If Code<>0 Then Exit;
 While Not Eof(T) Do Begin ReadLn(T,L); WriteLn(L); End;
 Close(T);
End;

{ decode l'entree par le programme lui-meme vers un Y4M (video) ; renvoie le
 chemin, ou '' si aucun flux video }
Function F5ChildVideo(Const Inp: String; Const Forced: String; Const Log:
 String): String;
Var Tmp,Args: String;
Begin
 Tmp:=F5NewTmp('.y4m');
 Args:='-y ';
 If Forced<>'' Then Args:=Args+'-f '+Forced+' ';
 Args:=Args+'-i '+F5Q(Inp)+' ';
 If OptPixFmt='yuv420p' Then Args:=Args+'-pix_fmt yuv420p ';
 Args:=Args+'-f yuv4mpegpipe '+F5Q(Tmp);
 If F5Child(Args,Log) Then F5ChildVideo:=Tmp Else Begin F5DelTmp(Tmp);
  F5ChildVideo:=''; End;
End;

Function F5ChildAudio(Const Inp: String; Const Forced: String; Const Log:
 String): String;
Var Tmp,Args: String;
Begin
 Tmp:=F5NewTmp('.wav');
 Args:='-y ';
 If Forced<>'' Then Args:=Args+'-f '+Forced+' ';
 Args:=Args+'-i '+F5Q(Inp)+' -f wav '+F5Q(Tmp);
 If F5Child(Args,Log) Then F5ChildAudio:=Tmp Else Begin F5DelTmp(Tmp);
  F5ChildAudio:=''; End;
End;

{ liste des fichiers d'une sequence }
Const F5MaxImg=5000;
Var F5ImgN: LongInt; F5ImgNames: Array[0..F5MaxImg] Of String[200];

Procedure F5Glob(Const Pat: String);
Var Sr: SearchRec; Dir,Mask: String; J,K: Integer; T: String[200]; Swapped:
 Boolean;
Function Match(Const M,S: String; I,J: Integer): Boolean;
Begin
 While I<=Length(M) Do Begin
  If M[I]='*' Then Begin
   Match:=True;
   While J<=Length(S)+1 Do Begin If Match(M,S,I+1,J) Then Exit; Inc(J); End;
   Match:=False; Exit;
  End;
  If J>Length(S) Then Begin Match:=False; Exit; End;
  If (M[I]<>'?') And (M[I]<>S[J]) Then Begin Match:=False; Exit; End;
  Inc(I); Inc(J);
 End;
 Match:=J>Length(S);
End;
Begin
 F5ImgN:=0;
 J:=Length(Pat);
 While (J>0) And (Pat[J]<>'/') Do Dec(J);
 Dir:=Copy(Pat,1,J); Mask:=Copy(Pat,J+1,255);
 If Dir='' Then FindFirst('*',AnyFile,Sr) Else FindFirst(Dir+'*',AnyFile,Sr);
 While DosError=0 Do Begin
  If ((Sr.Attr And Directory)=0) And Match(Mask,Sr.Name,1,1) And (
   F5ImgN<F5MaxImg) Then Begin
   F5ImgNames[F5ImgN]:=Dir+Sr.Name; Inc(F5ImgN);
  End;
  FindNext(Sr);
 End;
 FindClose(Sr);
 Repeat
  Swapped:=False;
  For K:=0 To F5ImgN-2 Do If F5ImgNames[K]>F5ImgNames[K+1] Then Begin
   T:=F5ImgNames[K]; F5ImgNames[K]:=F5ImgNames[K+1]; F5ImgNames[K+1]:=T;
    Swapped:=True;
  End;
 Until Not Swapped;
End;

{ image2 demuxer : construit un Y4M a partir d'une suite d'images (chaque image
 decodee par le programme) }
Function F5ImageSeqToY4M(Const Pat: String; Pre: Boolean): String;
Var Start,First,K,I,N,Sz,Tot,Lim: LongInt; Nm: String; Names: Array[0..0] Of
 String; Glob,Seq: Boolean;
 Uniq: LongInt; Tmps: Array[0..F5MaxImg] Of String[200]; Fh: File; Code:
  Integer; Hd,Log: String;
 Sv: F5TSrc; Buf: PEABuffer; Order: LongInt; Actual: LongInt; Outp: String; Fo:
  File; Total: LongInt;
 W0,H0,Fm0: LongInt; Rng0,Loc0: Integer; SarN0,SarD0: LongInt; Il0: Char;
  Written: LongInt;
Begin
 Glob:=Not Pre And ((F5PatType='glob') Or ((F5PatType='') And ((Pos('*',Pat)>0)
  Or (Pos('?',Pat)>0) Or (Pos('[',Pat)>0))));
 Seq:=False; If Not Pre Then F5ImgN:=0;
 If Pre Then Begin
 End Else If F5PatType='none' Then Begin
  F5ImgNames[0]:=Pat; F5ImgN:=1;
 End Else If Glob Then Begin
  F5Glob(Pat);
 End Else If F5PatternOk(Pat) Then Begin
  Seq:=True;
  If F5StartNum>=0 Then Start:=F5StartNum Else Start:=0;
  First:=-1;
  For K:=Start To Start+4 Do If Exists(F5PatName(Pat,K)) Then Begin First:=K;
   Break; End;
  If First<0 Then Fail(Pat+': No such file or directory');
  K:=First;
  While Exists(F5PatName(Pat,K)) And (F5ImgN<F5MaxImg) Do Begin F5ImgNames[
   F5ImgN]:=F5PatName(Pat,K); Inc(F5ImgN); Inc(K); End;
 End Else Begin
  F5ImgNames[0]:=Pat; F5ImgN:=1;
 End;
 If F5ImgN=0 Then Fail(Pat+': No such file or directory');
 Log:=F5NewTmp('.log');
 { nombre total d'images a produire }
 Lim:=F5ImgN;
 If F5Loop=1 Then Begin
  Lim:=-1;
  If H4SVfr>0 Then Lim:=H4SVfr;
  If H4STSet Then Begin
   Total:=0;
   If F5InFN>0 Then Begin I:=F5InFN; K:=F5InFD; End Else Begin I:=25; K:=1; End;
   While (Total<100000) And (Int64(Total)*K*1000000<H4STus*I) Do Inc(Total);
   If (Lim<0) Or (Total<Lim) Then Lim:=Total;
  End;
  If Lim<0 Then Fail(
   'image2: -loop 1 sans limite (-frames:v ou -t) non pris en charge.');
 End;
 Outp:=F5NewTmp('.y4m');
 Written:=0;
 For I:=0 To F5ImgN-1 Do Tmps[I]:='';
 Assign(Fo,Outp); {$I-}Rewrite(Fo,1);{$I+} Code:=IOResult;
 If Code<>0 Then Fail('Creation impossible: '+Outp);
 Order:=0;
 While Order<Lim Do Begin
  I:=Order Mod F5ImgN;
  If Tmps[I]='' Then Begin
   Tmps[I]:=F5ChildVideo(F5ImgNames[I],'',Log);
   If Tmps[I]='' Then Begin
    WriteLn(F5ImgNames[I],': image non decodable par le programme');
    F5ShowLog(Log); Halt(1);
   End;
  End;
  Sv:=F5S;
  F5OpenY4M(Tmps[I]);
  If F5S.N<1 Then Fail(F5ImgNames[I]+': aucune image decodee');
  If Order=0 Then Begin
   W0:=F5S.W; H0:=F5S.H; Fm0:=F5S.Fm; Rng0:=F5S.Rng; Loc0:=F5S.Loc; SarN0:=
    F5S.SarN; SarD0:=F5S.SarD; Il0:=F5S.Il;
   If F5InFN>0 Then Hd:=F5Y4MHeader(Fm0,W0,H0,F5InFN,F5InFD,SarN0,SarD0,Il0,
    Rng0,Loc0)
   Else Hd:=F5Y4MHeader(Fm0,W0,H0,25,1,SarN0,SarD0,Il0,Rng0,Loc0);
   BlockWrite(Fo,Hd[1],Length(Hd));
  End Else If (F5S.W<>W0) Or (F5S.H<>H0) Or (F5S.Fm<>Fm0) Then Fail(
   'image2: les images doivent avoir les memes dimensions et format de pixels'+
   '.');
  GetMem(Buf,F5S.FBytes+64);
  If Not F5ReadFrame(0,Buf) Then Fail('F5: lecture image impossible.');
  Hd:='FRAME'#10; BlockWrite(Fo,Hd[1],6); BlockWrite(Fo,Buf^,F5S.FBytes);
  FreeMem(Buf);
  F5CloseSrc; F5S:=Sv;
  Inc(Order); Inc(Written);
 End;
 Close(Fo);
 For I:=0 To F5ImgN-1 Do If Tmps[I]<>'' Then F5DelTmp(Tmps[I]);
 F5DelTmp(Log);
 F5ImageSeqToY4M:=Outp;
End;

{ rawvideo -> Y4M (formats compatibles Y4M) }
Function F5RawToY4M: String;
Var Outp,Hd: String; Fo: File; Code: Integer; I: LongInt; Buf: PEABuffer;
Begin
 Outp:=F5NewTmp('.y4m');
 Assign(Fo,Outp); {$I-}Rewrite(Fo,1);{$I+} Code:=IOResult;
 If Code<>0 Then Fail('Creation impossible: '+Outp);
 Hd:=F5Y4MHeader(F5S.Fm,F5S.W,F5S.H,F5S.FN,F5S.FD,F5S.SarN,F5S.SarD,'p',0,0);
 BlockWrite(Fo,Hd[1],Length(Hd));
 GetMem(Buf,F5S.FBytes+64);
 For I:=0 To F5S.N-1 Do Begin
  If Not F5ReadFrame(I,Buf) Then Break;
  Hd:='FRAME'#10; BlockWrite(Fo,Hd[1],6); BlockWrite(Fo,Buf^,F5S.FBytes);
 End;
 FreeMem(Buf); Close(Fo);
 F5RawToY4M:=Outp;
End;

{ ---------- options ---------- }
Function F5IsOpt(Const A: String): Boolean;
Begin
 F5IsOpt:=(A='-framerate') Or (A='-video_size') Or (A='-pixel_format') Or (
  A='-start_number') Or (A='-update') Or (A='-pattern_type') Or
  (A='-final_delay') Or (A='-boundary_tag') Or (A='-loop') Or (A='-f5q') Or (
   A='-strftime') Or (A='-frame_pts') Or (A='-atomic_writing') Or
  (A='-start_number_range') Or (A='-ts_from_file') Or
  ((InputPath='') And ((A='-s') Or (A='-pix_fmt') Or (A='-r') Or (A='-c:v') Or (
   A='-vcodec') Or (A='-codec:v')));
End;

Procedure F5SetOpt(Const A,V0: String);
Var V: String; K: Integer; Code,N,D: LongInt; Num: LongInt;
Begin
 V:=V0;
 If (A='-c:v') Or (A='-vcodec') Or (A='-codec:v') Then Exit;
 If A='-f5q' Then Begin
  F5Quiet:=True; Assign(Output,V); {$I-}Rewrite(Output);{$I+} Code:=IOResult;
   Exit;
 End;
 If (A='-framerate') Or ((A='-r') And (InputPath='')) Then Begin
  H4SParseRate(V,N,D); F5InFN:=N; F5InFD:=D; Exit;
 End;
 If (A='-video_size') Or (A='-s') Then Begin
  K:=Pos('x',Lower(V));
  If K<2 Then Fail('Unable to parse option value "'+V+'" as image size');
  Val(Copy(V,1,K-1),F5InW,Code); If Code<>0 Then Fail(
   'Unable to parse option value "'+V+'" as image size');
  Val(Copy(V,K+1,20),F5InH,Code); If Code<>0 Then Fail(
   'Unable to parse option value "'+V+'" as image size');
  Exit;
 End;
 If (A='-pixel_format') Or (A='-pix_fmt') Then Begin
  F5InPix:=Lower(V);
  If A='-pixel_format' Then OptPixFmt:=OptPixFmt;
  Exit;
 End;
 If A='-start_number' Then Begin Val(V,Num,Code); If Code<>0 Then Fail(
  '-start_number: entier requis.'); F5StartNum:=Num; Exit; End;
 If A='-update' Then Begin Val(V,Num,Code); If Code<>0 Then Fail(
  '-update: 0 ou 1 requis.'); F5Update:=Num; Exit; End;
 If A='-loop' Then Begin Val(V,Num,Code); If Code<>0 Then Fail(
  '-loop: entier requis.'); F5Loop:=Num; Exit; End;
 If A='-pattern_type' Then Begin F5PatType:=Lower(V); If (F5PatType<>'glob') And
  (F5PatType<>'sequence') And (F5PatType<>'none') And (
  F5PatType<>'glob_sequence') Then Fail('-pattern_type invalide.'); If
  F5PatType='sequence' Then F5PatType:=''; Exit; End;
 If A='-final_delay' Then Begin Val(V,Num,Code); If Code<>0 Then Fail(
  '-final_delay: entier requis.'); F5FinalDelay:=Num; F5HasFD:=True; Exit; End;
 If A='-boundary_tag' Then Begin F5Boundary:=V; Exit; End;
End;

{ ---------- decision et execution ---------- }
Function F5IsImgName(Const S: String): Boolean;
Begin
 F5IsImgName:=(S='bmp') Or (S='jpg') Or (S='jpeg') Or (S='png') Or (S='ppm') Or
  (S='pgm') Or (S='pbm') Or (S='pam') Or (S='targa') Or (S='tiff') Or
  (S='sgi') Or (S='jls') Or (S='ljpg') Or (S='pgmyuv') Or (S='tga') Or (S='tif')
   Or (S='sunrast') Or (S='xwd');
End;

Function F5OutName: String;
Var S: String;
Begin
 S:=OutputFormat;
 If S='' Then S:=FormatName(Extension(OutputPath));
 If S='mjpg' Then S:='mpjpeg';
 If S='y4m' Then S:='yuv4mpegpipe';
 F5OutName:=S;
End;

{ nom du puits pris en charge par le module F5, ou '' }
Function F5Take: String;
Var S: String; Own,Single: Boolean;
Begin
 F5Take:='';
 S:=F5OutName;
 If (S='null') Or (S='crc') Or (S='framecrc') Or (S='image2pipe') Or (
  S='mpjpeg') Or (S='mxf') Or (S='mxf_d10') Or (S='gxf') Or (S='rtp') Then Begin
  F5Take:=S; Exit; End;
 Own:=(InputFormat='yuv4mpegpipe');
 If F5IsImgName(S) Then S:='image2img';
 If (S='image2') Or (S='image2img') Then Begin
  Single:=((VideoFrames=1) Or (H4SVfr=1)) And Not F5PatternOk(OutputPath) And (
   F5Update=0) And (F5StartNum<0) And (S='image2img') And (F5OutName<>'png') And
   (F5OutName<>'bmp');
  If Single And ((OutputPath<>'') And (Extension(OutputPath)<>'')) Then Begin
   { chemin historique : une image depuis Y4M ou depuis un decodeur natif }
   Exit;
  End;
  If Own Or (S='image2') Or F5PatternOk(OutputPath) Or (H4SVfr>1) Or (
   F5Update<>0) Or (F5StartNum>=0) Then Begin F5Take:='image2'; Exit; End;
  Exit;
 End;
 If Own Then Begin
  If (S='yuv4mpegpipe') Or (S='rawvideo') Or (S='gif') Or ((S='dv') And ((
   H4SVfr>0) Or H4STSet Or (AspectNum>0))) Then Begin If Not HasCrop And (
   ImageWidth=0) Then F5Take:=S; End;
  Exit;
 End;
 If (S='gif') And (InputFormat<>'flv') Then F5Take:='gif';
End;

{ ---------- image2pipe / mpjpeg en entree : decoupage en images, ecrites en
 fichiers temporaires ---------- }
Function F5BE32(P: PEABuffer; At: LongInt): LongInt;Begin F5BE32:=(P^[At] Shl
 24) Or (P^[At+1] Shl 16) Or (P^[At+2] Shl 8) Or P^[At+3]; End;

Procedure F5PutImg(P: PEABuffer; At,Len: LongInt);
Var Nm: String; Fo: File; Code: Integer;
Begin
 If F5ImgN>=F5MaxImg Then Fail('image2pipe: trop d''images.');
 Nm:=F5NewTmp('.img');
 Assign(Fo,Nm); {$I-}Rewrite(Fo,1);{$I+} Code:=IOResult;
 If Code<>0 Then Fail('Creation impossible: '+Nm);
 BlockWrite(Fo,P^[At],Len); Close(Fo);
 F5ImgNames[F5ImgN]:=Nm; Inc(F5ImgN);
End;

Function F5FindStr(P: PEABuffer; N,From: LongInt; Const S: String): LongInt;
Var I,J: LongInt; Ok: Boolean;
Begin
 F5FindStr:=-1;
 For I:=From To N-Length(S) Do Begin
  Ok:=True;
  For J:=1 To Length(S) Do If P^[I+J-1]<>Ord(S[J]) Then Begin Ok:=False; Break;
   End;
  If Ok Then Begin F5FindStr:=I; Exit; End;
 End;
End;

Procedure F5PipeSplit(Const Nm: String; Mpj: Boolean);
Var P: PEABuffer; N,At,E,Len,M,K,Q,Hs,Cl,B2: LongInt; Ty: String; Wd,Ht,Mx,Pn:
 LongInt; Tok: Integer; Line: String; Code: LongInt; Bo: String;
Function Num(Var Pp: LongInt): LongInt;
Var V: LongInt;
Begin
 V:=0;
 While (Pp<N) And (P^[Pp] In [32,9,10,13]) Do Inc(Pp);
 While (Pp<N) And (P^[Pp]=35) Do Begin While (Pp<N) And (P^[Pp]<>10) Do Inc(Pp);
  While (Pp<N) And (P^[Pp] In [32,9,10,13]) Do Inc(Pp); End;
 While (Pp<N) And (P^[Pp] In [48..57]) Do Begin V:=V*10+P^[Pp]-48; Inc(Pp); End;
 Num:=V;
End;
Begin
 F5SrcOpen(Nm); N:=F5SrcSize;
 If N<4 Then Fail(Nm+': Invalid data found when processing input');
 GetMem(P,N+16);
 If Not F5Rd(0,P^,N) Then Fail('Lecture impossible: '+Nm);
 F5SrcClose;
 F5ImgN:=0; At:=0;
 If Mpj Then Begin
  While At<N Do Begin
   K:=F5FindStr(P,N,At,'--'); If K<0 Then Break;
   { fin de la ligne de delimitation }
   E:=F5FindStr(P,N,K,#13#10); If E<0 Then Break;
   At:=E+2; Cl:=-1;
   { en-tetes }
   While At<N Do Begin
    If (P^[At]=13) And (At+1<N) And (P^[At+1]=10) Then Begin Inc(At,2); Break;
     End;
    E:=F5FindStr(P,N,At,#13#10); If E<0 Then Begin At:=N; Break; End;
    Line:=''; For Q:=At To E-1 Do If Length(Line)<250 Then Line:=Line+Chr(P^[
     Q]);
    Line:=Lower(Line);
    If Copy(Line,1,15)='content-length:' Then Begin Line:=Copy(Line,16,40);
     While (Line<>'') And (Line[1]=' ') Do Delete(Line,1,1); Val(Line,Cl,Code);
     If Code<>0 Then Cl:=-1; End;
    At:=E+2;
   End;
   If Cl<0 Then Begin
    E:=F5FindStr(P,N,At,#13#10'--'); If E<0 Then E:=N;
    Cl:=E-At;
   End;
   If At+Cl>N Then Break;
   If Cl>0 Then F5PutImg(P,At,Cl);
   At:=At+Cl;
  End;
 End Else Begin
  While At+8<N Do Begin
   If (P^[At]=$89) And (P^[At+1]=$50) Then Begin
    E:=At+8;
    While E+12<=N Do Begin
     Len:=F5BE32(P,E); M:=F5BE32(P,E+4); E:=E+12+Len;
     If M=$49454E44 Then Break;
    End;
    If E>N Then Break;
    F5PutImg(P,At,E-At); At:=E;
   End Else If (P^[At]=$FF) And (P^[At+1]=$D8) Then Begin
    E:=At+2; Q:=0;
    While E+1<N Do Begin
     If P^[E]<>$FF Then Begin Inc(E); Continue; End;
     M:=P^[E+1];
     If (M=$FF) Then Begin Inc(E); Continue; End;
     If M=$D9 Then Begin E:=E+2; Q:=1; Break; End;
     If (M=0) Or (M=1) Or ((M>=$D0) And (M<=$D8)) Then Begin E:=E+2; Continue;
      End;
     Len:=(P^[E+2] Shl 8) Or P^[E+3]; E:=E+2+Len;
     If M=$DA Then Begin
      While E+1<N Do Begin
       If (P^[E]=$FF) And (P^[E+1]<>0) And Not ((P^[E+1]>=$D0) And (P^[E+
        1]<=$D7)) Then Break;
       Inc(E);
      End;
     End;
    End;
    If Q=0 Then Break;
    F5PutImg(P,At,E-At); At:=E;
   End Else If (P^[At]=$42) And (P^[At+1]=$4D) Then Begin
    Len:=P^[At+2]+(P^[At+3] Shl 8)+(P^[At+4] Shl 16)+(P^[At+5] Shl 24);
    If (Len<=0) Or (At+Len>N) Then Break;
    F5PutImg(P,At,Len); At:=At+Len;
   End Else If (P^[At]=80) And (P^[At+1] In [52,53,54]) Then Begin
    E:=At+2; Wd:=Num(E); Ht:=Num(E); Mx:=1;
    If P^[At+1]<>52 Then Mx:=Num(E);
    Inc(E);
    If P^[At+1]=52 Then Len:=((Wd+7) Div 8)*Ht Else If P^[At+1]=53 Then Len:=Wd*
     Ht Else Len:=Wd*Ht*3;
    If (P^[At+1]<>52) And (Mx>255) Then Len:=Len*2;
    If E+Len>N Then Break;
    F5PutImg(P,At,E+Len-At); At:=E+Len;
   End Else Break;
  End;
 End;
 FreeMem(P);
 If F5ImgN=0 Then Fail(Nm+': Invalid data found when processing input');
End;

Function F5MineOut: Boolean;
Var S: String;
Begin
 S:=F5OutName;
 F5MineOut:=F5IsImgName(S) Or (S='image2') Or (S='null') Or (S='crc') Or (
  S='framecrc') Or (S='image2pipe') Or (S='mpjpeg') Or (S='mxf') Or
  (S='mxf_d10') Or (S='gxf') Or (S='rtp') Or (S='gif') Or (S='dv') Or (
   S='yuv4mpegpipe') Or (S='rawvideo');
End;

{ ---------- GIF : encodeur (libavcodec/gif.c, lzwenc.c) et muxeur
 (libavformat/gif.c) ---------- }
Const
 F5D32: Array[0..8,0..7] Of Byte=((17,9,23,15,16,8,22,14),(5,29,3,27,4,28,2,26),
  (21,13,19,11,20,12,18,10),(0,24,6,30,1,25,7,31),
  (16,8,22,14,17,9,23,15),(4,28,2,26,5,29,3,27),(20,12,18,10,21,13,19,11),(1,25,
   7,31,0,24,6,30),(17,9,23,15,16,8,22,14));
 F5D73: Array[0..8,0..7] Of Byte=((0,55,14,68,3,58,17,72),(37,18,50,32,40,22,54,
  35),(9,64,5,59,13,67,8,63),(46,27,41,23,49,31,44,26),
  (2,57,16,71,1,56,15,70),(39,21,52,34,38,19,51,33),(11,66,7,62,10,65,6,60),(48,
   30,43,25,47,29,42,24),(0,55,14,68,3,58,17,72));

{ yuv420p (4:2:0 8 bits, largeur et hauteur paires) -> rgb8 :
 yuv2rgb_c_8_ordered_dither de libswscale }
Procedure F5Yuv420ToRgb8(Src: PEABuffer; W,H: LongInt; Full: Boolean; Dst:
 PEABuffer);
Var
 P0,P1,P2: Array[0..2047] Of Byte; Crv,Cbu,Cgu,Cgv,Cy,Oy,Yb: Int64; Yoffs,I,X,Y,
  CW,Yv,U,V,Ir,Ig,Ib,Yval: LongInt; Cn: LongInt;
 Pu,Pv: PEABuffer;
Begin
 Crv:=104597; Cbu:=132201; Cgu:=-25675; Cgv:=-53279; Cy:=65536; Oy:=0;
 If Not Full Then Begin Cy:=(Cy*255) Div 219; Oy:=Int64(16) Shl 16; End
 Else Begin Crv:=(Crv*224) Div 255; Cbu:=(Cbu*224) Div 255; Cgu:=(Cgu*224) Div
  255; Cgv:=(Cgv*224) Div 255; End;
 Crv:=((Crv Shl 16)+$8000) Div Cy; Cbu:=((Cbu Shl 16)+$8000) Div Cy;
 Cgu:=((Cgu*65536)+$8000) Div Cy; Cgv:=((Cgv*65536)+$8000) Div Cy;
 If Full Then Yoffs:=384+512 Else Yoffs:=326+512;
 FillChar(P0,SizeOf(P0),0); FillChar(P1,SizeOf(P1),0); FillChar(P2,SizeOf(P2),
  0);
 Yb:=-(Int64(384) Shl 16)-512*Cy-Oy;
 For I:=0 To 2048-39 Do Begin
  Yval:=F5Cl8(F5Sar(Yb+$8000,16));
  P0[I+16]:=((Yval+18) Div 36); P1[I+16]:=((Yval+18) Div 36) Shl 3; P2[I+37]:=((
   Yval+43) Div 85) Shl 6;
  Yb:=Yb+Cy;
 End;
 CW:=W Div 2; Cn:=CW*(H Div 2);
 For Y:=0 To H-1 Do Begin
  Pu:=@Src^[W*H+(Y Shr 1)*CW]; Pv:=@Src^[W*H+Cn+(Y Shr 1)*CW];
  For X:=0 To W-1 Do Begin
   Yv:=Src^[Y*W+X]; U:=Pu^[X Shr 1]; V:=Pv^[X Shr 1];
   Ir:=Yoffs-F5Sar(Crv,9)+F5Sar(V*Crv,16)+Yv+F5D32[Y And 7,X And 7];
   Ig:=Yoffs-F5Sar(Cgu,9)+F5Sar(U*Cgu,16)-F5Sar(Cgv,9)+F5Sar(V*Cgv,16)+Yv+F5D32[
    Y And 7,X And 7];
   Ib:=Yoffs-F5Sar(Cbu,9)+F5Sar(U*Cbu,16)+Yv+F5D73[Y And 7,X And 7];
   Dst^[Y*W+X]:=(P0[Ir]+P1[Ig]+P2[Ib]) And 255;
  End;
 End;
End;

Type F5TLzw=Record
  Pref: Array[0..16410] Of LongInt; Code: Array[0..16410] Of LongInt; Suf:
   Array[0..16410] Of Byte;
  TabSize,Bits,LastCode: LongInt; Acc: Int64; NAcc: Integer; Out: PEABuffer;
   OutN,OutCap: LongInt;
 End;
 PF5Lzw=^F5TLzw;

Procedure F5LzwPut(S: PF5Lzw; V,N: LongInt);
Begin
 S^.Acc:=S^.Acc Or (Int64(V) Shl S^.NAcc); Inc(S^.NAcc,N);
 While S^.NAcc>=8 Do Begin
  If S^.OutN<S^.OutCap Then S^.Out^[S^.OutN]:=S^.Acc And 255;
  Inc(S^.OutN); S^.Acc:=S^.Acc Shr 8; Dec(S^.NAcc,8);
 End;
End;

Function F5LzwHash(Head,Add: LongInt): LongInt;
Begin
 Head:=Head Xor (Add Shl 6);
 If Head>=16411 Then Head:=Head-16411;
 F5LzwHash:=Head;
End;

Procedure F5LzwClear(S: PF5Lzw);
Var I,H: LongInt;
Begin
 F5LzwPut(S,256,S^.Bits);
 S^.Bits:=9;
 For I:=0 To 16410 Do S^.Pref[I]:=-2;
 For I:=0 To 255 Do Begin
  H:=F5LzwHash(0,I); S^.Code[H]:=I; S^.Suf[H]:=I; S^.Pref[H]:=-1;
 End;
 S^.TabSize:=258;
End;

Procedure F5LzwInit(S: PF5Lzw; Buf: PEABuffer; Cap: LongInt);
Begin
 S^.Out:=Buf; S^.OutN:=0; S^.OutCap:=Cap; S^.LastCode:=-1; S^.Bits:=9; S^.Acc:=
  0; S^.NAcc:=0;
End;

Procedure F5LzwEncode(S: PF5Lzw; P: PEABuffer; N: LongInt);
Var I,C,H,Off,Hp,Cd: LongInt;
Begin
 If S^.LastCode=-1 Then F5LzwClear(S);
 For I:=0 To N-1 Do Begin
  C:=P^[I];
  If S^.LastCode<0 Then Hp:=0 Else Hp:=S^.LastCode;
  H:=F5LzwHash(Hp,C);
  If H<>0 Then Off:=16411-H Else Off:=1;
  While S^.Pref[H]<>-2 Do Begin
   If (S^.Suf[H]=C) And (S^.Pref[H]=S^.LastCode) Then Break;
   H:=H-Off; If H<0 Then H:=H+16411;
  End;
  Cd:=H;
  If S^.Pref[Cd]=-2 Then Begin
   F5LzwPut(S,S^.LastCode,S^.Bits);
   S^.Code[Cd]:=S^.TabSize; S^.Suf[Cd]:=C; S^.Pref[Cd]:=S^.LastCode; Inc(
    S^.TabSize);
   If S^.TabSize>=(1 Shl S^.Bits)+1 Then Inc(S^.Bits);
   Cd:=F5LzwHash(0,C);
  End;
  S^.LastCode:=S^.Code[Cd];
  If S^.TabSize>=4096-1 Then F5LzwClear(S);
 End;
End;

Procedure F5LzwFlush(S: PF5Lzw);
Begin
 If S^.LastCode<>-1 Then F5LzwPut(S,S^.LastCode,S^.Bits);
 F5LzwPut(S,257,S^.Bits);
 F5LzwPut(S,0,1);
 If S^.NAcc>0 Then F5LzwPut(S,0,8-S^.NAcc);
 S^.LastCode:=-1;
End;

Var F5GifPk: Array[0..8191] Of PEABuffer; F5GifPkN: Array[0..8191] Of LongInt;

Procedure F5GifSink;
Var
 Sf,W,H,Cnt,I,K,X,Y,Off,Xs,Ys,Wd,Ht,Trans: LongInt; Full,Honor: Boolean; Src,
  Cur,Last: PEABuffer; HaveLast: Boolean;
 Lz: PF5Lzw; Lbuf,Tm: PEABuffer; Hist: Array[0..255] Of LongInt;
 Xe,Ye: LongInt; Same: Boolean; Sz,Rem,At: LongInt; Nm: String;
 Delay: LongInt; Sar: Int64; Gray: Boolean; Pb: Array[0..2047] Of Byte; Pn:
  LongInt; Nets: String;
Procedure PB1(V: LongInt);Begin Pb[Pn]:=V And 255; Inc(Pn); End;
Procedure PW(V: LongInt);Begin PB1(V); PB1(V Shr 8); End;
Function Cs(Ii: LongInt): Int64;
Var Nn,Dd: Int64;
Begin
 Nn:=Int64(Ii)*100*F5S.FD; Dd:=F5S.FN;
 Cs:=(Nn*2+Dd) Div (2*Dd);
End;
Begin
 Sf:=F5S.Fm; W:=F5S.W; H:=F5S.H; Nm:=F5Fm[Sf].Nm;
 Gray:=Nm='gray';
 If Not (Gray Or (Nm='yuv420p') Or (Nm='yuvj420p')) Then Fail(
  'gif: format de pixels '+Nm+' non pris en charge (yuv420p ou gray requis).');
 If (OptPixFmt<>'') And (OptPixFmt<>'rgb8') And Not (Gray And (
  OptPixFmt='gray')) Then Fail('gif: -pix_fmt non pris en charge.');
 If Not Gray And (Odd(W) Or Odd(H)) Then Fail(
  'gif: dimensions paires requises pour la conversion yuv420p -> rgb8.');
 Full:=(F5S.Rng=2) Or F5Fm[Sf].Full;
 Cnt:=F5OutCount(F5S.N);
 If Cnt<=0 Then Fail(
  'Nothing was written into output file, because at least one of its streams r'+
  'eceived no packets.');
 If Cnt>8192 Then Fail('gif: trop d''images (8192 max).');
 GetMem(Src,F5S.FBytes+64); GetMem(Cur,W*H+64); GetMem(Last,W*H+64); GetMem(Tm,
  W*H+64);
 GetMem(Lz,SizeOf(F5TLzw)); GetMem(Lbuf,W*H*2+1000);
 HaveLast:=False;
 If (F5S.SarN>0) And (F5S.SarD>0) Then Begin Sar:=Int64(F5S.SarN)*64 Div
  F5S.SarD-15; If (Sar<0) Or (Sar>255) Then Sar:=0; End Else Sar:=0;
 For I:=0 To Cnt-1 Do Begin
  If Not F5ReadFrame(I,Src) Then Fail('gif: lecture image impossible.');
  If Gray Then Move(Src^,Cur^,W*H) Else F5Yuv420ToRgb8(Src,W,H,Full,Cur);
  Xs:=0; Ys:=0; Wd:=W; Ht:=H; Trans:=-1;
  If HaveLast Then Begin
   Xe:=W-1; Ye:=H-1;
   While Ys<Ye Do Begin
    Same:=True; For X:=0 To Wd-1 Do If Last^[Ys*W+X]<>Cur^[Ys*W+X] Then Begin
     Same:=False; Break; End;
    If Not Same Then Break; Inc(Ys);
   End;
   While Ye>Ys Do Begin
    Same:=True; For X:=0 To Wd-1 Do If Last^[Ye*W+X]<>Cur^[Ye*W+X] Then Begin
     Same:=False; Break; End;
    If Not Same Then Break; Dec(Ye);
   End;
   Ht:=Ye+1-Ys;
   While Xs<Xe Do Begin
    Same:=True; For Y:=Ys To Ye Do If Last^[Y*W+Xs]<>Cur^[Y*W+Xs] Then Begin
     Same:=False; Break; End;
    If Not Same Then Break; Inc(Xs);
   End;
   While Xe>Xs Do Begin
    Same:=True; For Y:=Ys To Ye Do If Last^[Y*W+Xe]<>Cur^[Y*W+Xe] Then Begin
     Same:=False; Break; End;
    If Not Same Then Break; Dec(Xe);
   End;
   Wd:=Xe+1-Xs;
  End;
  Honor:=HaveLast;
  Pn:=0;
  If I=0 Then Begin
   PB1(71); PB1(73); PB1(70); PB1(56); PB1(57); PB1(97);
   PW(W); PW(H); PB1($F7); PB1($1F); PB1(Sar);
   For K:=0 To 255 Do Begin
    If Gray Then Begin PB1(K); PB1(K); PB1(K); End
    Else Begin PB1((K And 7)*36); PB1(((K Shr 3) And 7)*36); PB1((K Shr 6)*85);
     End;
   End;
  End;
  If Honor Then Begin
   FillChar(Hist,SizeOf(Hist),0);
   For Y:=0 To Ht-1 Do For X:=0 To Wd-1 Do Inc(Hist[Cur^[(Ys+Y)*W+Xs+X]]);
   Trans:=-1; For K:=0 To 255 Do If Hist[K]=0 Then Begin Trans:=K; Break; End;
   If Trans<0 Then Honor:=False;
  End;
  PB1($21); PB1($F9); PB1(4);
  PB1((1 Shl 2) Or Ord(Honor)); PW(5);
  If Honor Then PB1(Trans) Else PB1($1F);
  PB1(0);
  PB1($2C); PW(Xs); PW(Ys); PW(Wd); PW(Ht); PB1(0); PB1(8);
  F5LzwInit(Lz,Lbuf,W*H*2+1000);
  For Y:=0 To Ht-1 Do Begin
   Move(Cur^[(Ys+Y)*W+Xs],Tm^,Wd);
   If Honor Then For X:=0 To Wd-1 Do If Last^[(Ys+Y)*W+Xs+X]=Tm^[X] Then Tm^[
    X]:=Trans;
   F5LzwEncode(Lz,Tm,Wd);
  End;
  F5LzwFlush(Lz);
  Sz:=Lz^.OutN; At:=0;
  GetMem(F5GifPk[I],Pn+Sz+Sz Div 255+16);
  Move(Pb,F5GifPk[I]^,Pn); K:=Pn;
  Rem:=Sz;
  While Rem>0 Do Begin
   X:=Rem; If X>255 Then X:=255;
   F5GifPk[I]^[K]:=X; Inc(K); Move(Lbuf^[At],F5GifPk[I]^[K],X); Inc(K,X); Inc(
    At,X); Dec(Rem,X);
  End;
  F5GifPk[I]^[K]:=0; Inc(K);
  F5GifPkN[I]:=K;
  Move(Cur^,Last^,W*H); HaveLast:=True;
 End;
 F5OpenOut(OutputPath);
 Nets:='NETSCAPE2.0';
 For I:=0 To Cnt-1 Do Begin
  Off:=0;
  If I=0 Then Begin
   Off:=13+768;
   F5Wr(F5GifPk[I]^,Off);
   If F5Loop>=0 Then Begin
    Pn:=0; PB1($21); PB1($FF); PB1($0B);
    For K:=1 To 11 Do PB1(Ord(Nets[K]));
    PB1(3); PB1(1); PW(F5Loop); PB1(0);
    F5Wr(Pb,Pn);
   End;
  End;
  If I<Cnt-1 Then Delay:=Cs(I+1)-Cs(I)
  Else If F5HasFD And (F5FinalDelay>=0) Then Delay:=F5FinalDelay Else Delay:=Cs(
   1);
  If Delay<0 Then Delay:=0;
  If Delay>65535 Then Delay:=65535;
  F5Wr(F5GifPk[I]^[Off],4);
