  C[U,X]:=Cos((2*X+1)*U*3.14159265358979323846/16)/2;
  If U=0 Then C[U,X]:=C[U,X]/Sqrt(2);
 End;
 For MBY:=0 To (Tracks^[T].Height+15) Div 16-1 Do
