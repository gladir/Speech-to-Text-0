  FC_ASV1: MOWBmpTag:=FMXMKTag('ASV1');
  FC_ASV2: MOWBmpTag:=FMXMKTag('ASV2');
  FC_ZLIB: MOWBmpTag:=FMXMKTag('ZLIB');
