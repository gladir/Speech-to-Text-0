Function S3S32(V: Int64): Int64;
Begin V:=V And $FFFFFFFF; If V>=$80000000 Then V:=V-$100000000; S3S32:=V; End;
Function S3Clip8(V: LongInt): LongInt;
Begin If V<0 Then S3Clip8:=0 Else If V>255 Then S3Clip8:=255 Else S3Clip8:=V;
 End;
Function S3ClipI(V,Lo,Hi: LongInt): LongInt;
Begin If V<Lo Then S3ClipI:=Lo Else If V>Hi Then S3ClipI:=Hi Else S3ClipI:=V;
 End;
Function S3Mid(A,B,C: LongInt): LongInt;
Begin
 If A>B Then Begin If B>C Then S3Mid:=B Else If A>C Then S3Mid:=C Else S3Mid:=A;
  End
 Else Begin If A>C Then S3Mid:=A Else If B>C Then S3Mid:=C Else S3Mid:=B; End;
End;
{ division entiere vers le bas par n>0 }
Function S3FloorDiv(A,N: LongInt): LongInt;
Begin If A>=0 Then S3FloorDiv:=A Div N Else S3FloorDiv:=-((-A+N-1) Div N); End;

{ ---- lecture de bits ---- }
Function S3Bits(Var G: TS3Gb; N: LongInt): LongInt;
Var V: Int64; I,At: LongInt;
Begin
 If N=0 Then Begin S3Bits:=0; Exit; End;
 At:=G.Pos Shr 3; V:=0;
 For I:=0 To 4 Do Begin
  V:=V Shl 8;
  If (At+I>=0) And (At+I<(G.Size+7) Shr 3+8) Then V:=V Or G.Buf^[At+I];
 End;
 V:=V Shr (40-(G.Pos And 7)-N);
 S3Bits:=V And ((Int64(1) Shl N)-1);
 Inc(G.Pos,N); If G.Pos>G.Size+8 Then G.Pos:=G.Size+8; { SKIP_COUNTER : index
  borne a size_in_bits_plus8 }
End;
Function S3Show(Var G: TS3Gb; N: LongInt): LongInt;
Var P: LongInt;
Begin P:=G.Pos; S3Show:=S3Bits(G,N); G.Pos:=P; End;
Function S3Left(Var G: TS3Gb): LongInt;
Begin S3Left:=G.Size-G.Pos; End;
{ cache de 32 bits comme UPDATE_CACHE (AV_RB32(buf+(index>>3)) << (index&7)) }
Function S3Cache(Var G: TS3Gb): Int64;
Var At,I: LongInt; V: Int64;
Begin
 At:=G.Pos Shr 3; V:=0;
 For I:=0 To 3 Do Begin
  V:=V Shl 8;
  If (At+I>=0) And (At+I<(G.Size+7) Shr 3+8) Then V:=V Or G.Buf^[At+I];
 End;
 S3Cache:=(V Shl (G.Pos And 7)) And $FFFFFFFF;
End;
Procedure S3SkipC(Var G: TS3Gb; N: LongInt);
Begin Inc(G.Pos,N); If G.Pos>G.Size+8 Then G.Pos:=G.Size+8; End;
