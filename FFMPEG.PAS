  2: VGFft2(B);
  4: VGFft4(B);
  8: VGFft8(B);
  16: VGFft16(B);
 Else Begin
  VGFft(N Div 2,B,L-1);
  VGFft(N Div 4,B+N Div 2,L-2);
  VGFft(N Div 4,B+(N Div 4)*3,L-2);
  VGComb(B,L,N Div 8);
 End;
 End;
End;

Function VGLog2(V: LongInt): LongInt;
Var R: LongInt;
