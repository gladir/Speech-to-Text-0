 }

Procedure WriteAudioAlbum(Const Source,Target: String);
Var
 B: Array[0..4095] Of Byte;
 H: Array[0..9] Of Byte;
 Size,At,N,Limit,EndAt,TagEnd,Kept,OutSize,InfoSize,Part,PartSize: LongInt;
 Version,J,Code: Integer;
 Name,Kind: String[4];

Function TagAt(P: LongInt): String;
Var
 T: String[4];
Begin
 T:='    '; ReadAt(P,T[1],4); TagAt:=T;
End;

Function GetSize(P: LongInt; Little,Sync: Boolean): LongInt;
Var
 V: Array[0..3] Of Byte;
 K: Integer;
 R: Double;
Begin
 ReadAt(P,V,4); R:=0;
 If Little Then
 For K:=3 Downto 0 Do R:=R*256+V[K]
  Else
 For K:=0 To 3 Do Begin
  If Sync Then Begin
   If V[K]>127 Then Fail('Taille ID3 incorrecte.'); R:=R*128+V[K];
  End
  Else R:=R*256+V[K];
 End;
 If R>2147483647.0 Then Fail('Metadonnees trop volumineuses.'); GetSize:=Trunc(
  R);
End;

Procedure PutSize(V: LongInt; Little,Sync: Boolean);
Var
 A: Array[0..3] Of Byte;
 K,Base: Integer;
Begin
 Base:=256; If Sync Then Base:=128;
 If Little Then
 For K:=0 To 3 Do Begin
  A[K]:=V Mod Base; V:=V Div Base;
 End
  Else
 For K:=3 Downto 0 Do Begin
  A[K]:=V Mod Base; V:=V Div Base;
 End;
 WriteBytes(A,4);
End;

Procedure PutTag(T: String);Begin
 WriteBytes(T[1],Length(T));
End;

Procedure PutByte(V: Byte);Begin
 WriteBytes(V,1);
End;

Procedure CopyRange(P,Count: LongInt);
Var
 Take: Word;
Begin
 While Count>0 Do Begin
  Take:=4096; If Count<Take Then Take:=Count;
  ReadAt(P,B,Take); WriteBytes(B,Take); Inc(P,Take); Dec(Count,Take);
 End;
End;
Begin
 OpenRead(Source); Size:=InputSize; OpenWrite(Target);
 If OutputFormat='mp3' Then Begin
  Version:=4; TagEnd:=0; Kept:=0;
  If Size>=10 Then Begin
   ReadAt(0,H,10);
   If (H[0]=73) And (H[1]=68) And (H[2]=51) Then Begin
    Version:=H[3];
    If ((Version<>3) And (Version<>4)) Or (H[4]<>0) Or (H[5]<>0) Then     Fail(
    '-album: copie ID3v2.3/v2.4 sans flags requise.');
    N:=GetSize(6,False,True); If N>Size-10 Then Fail('ID3 tronque.'); TagEnd:=
     10+N;
   End;
  End;
  At:=10;
  While At<TagEnd Do Begin
   ReadAt(At,H,1); If H[0]=0 Then Break;
   If TagEnd-At<10 Then Fail('Trame ID3 tronquee.');
   Name:=TagAt(At); N:=GetSize(At+4,False,Version=4);
   If N>TagEnd-At-10 Then Fail('Trame ID3 hors etiquette.');
   If Not ((HasAlbum And (Name='TALB')) Or (HasComment And (Name='COMM'))) Then
    Inc(Kept,
   10+N); Inc(At,10+N);
  End;
  N:=0;
  If HasAlbum Then Inc(N,13+LongInt(AlbumWideSize)*2);
  If HasComment Then Inc(N,20+LongInt(CommentWideSize)*2);
  If Kept>268435455-N Then Fail('ID3 trop volumineux.');
  PutTag('ID3'); PutByte(Version); PutByte(0); PutByte(0); PutSize(Kept+N,False,
   True);
  If HasAlbum Then Begin
   N:=3+LongInt(AlbumWideSize)*2;
   PutTag('TALB'); PutSize(N,False,Version=4); PutByte(0); PutByte(0);
   PutByte(1); PutByte(255); PutByte(254);
   For J:=0 To AlbumWideSize-1 Do Begin
    PutByte(AlbumWide[J] And 255); PutByte(AlbumWide[J] Shr 8);
   End;
  End;
  If HasComment Then Begin
   N:=10+LongInt(CommentWideSize)*2;
   PutTag('COMM'); PutSize(N,False,Version=4); PutByte(0); PutByte(0);
   PutByte(1); PutTag('und'); PutByte(255); PutByte(254); PutByte(0); PutByte(
    0);
   PutByte(255); PutByte(254);
   For J:=0 To CommentWideSize-1 Do Begin
    PutByte(CommentWide[J] And 255); PutByte(CommentWide[J] Shr 8);
   End;
  End;
  At:=10;
  While At<TagEnd Do Begin
   ReadAt(At,H,1); If H[0]=0 Then Break;
   Name:=TagAt(At); N:=GetSize(At+4,False,Version=4);
   If Not ((HasAlbum And (Name='TALB')) Or (HasComment And (Name='COMM'))) Then
    CopyRange(
   At,N+10); Inc(At,N+10);
  End;
  CopyRange(TagEnd,Size-TagEnd);
 End Else
 Begin
  If (Size<12) Or (TagAt(0)<>'RIFF') Or (TagAt(8)<>'WAVE') Then Fail(
   'WAV RIFF requis.');
  Limit:=GetSize(4,True,False);
  If Limit<>Size-8 Then Fail('Taille RIFF WAV incoherente.');
  CopyRange(0,12); At:=12;
  While At<Size Do Begin
   If Size-At<8 Then Fail('Bloc WAV tronque.');
   Name:=TagAt(At); N:=GetSize(At+4,True,False);
   If N>Size-At-8 Then Fail('Bloc WAV hors fichier.');
   EndAt:=At+8+N; If Odd(N) Then Inc(EndAt);
   If EndAt>Size Then Fail('Bourrage WAV absent.');
   Kind:=''; If (Name='LIST') And (N>=4) Then Kind:=TagAt(At+8);
   If Kind='INFO' Then Begin
    Part:=At+12; InfoSize:=4;
    While Part<At+8+N Do Begin
     If At+8+N-Part<8 Then Fail('INFO WAV tronque.');
     PartSize:=GetSize(Part+4,True,False);
     If PartSize>At+N-Part Then Fail('INFO WAV hors bloc.');
     If Odd(PartSize) Then Inc(PartSize);
     If PartSize>At+N-Part Then Fail('INFO WAV sans bourrage.');
     If Not ((HasAlbum And (TagAt(Part)='IPRD')) Or (HasComment And (TagAt(
