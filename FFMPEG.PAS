Function O1Gcd(A,B: Int64): Int64;
Var T: Int64;
Begin
 If A<0 Then A:=-A; If B<0 Then B:=-B;
 While B<>0 Do Begin T:=A Mod B; A:=B; B:=T; End;
 O1Gcd:=A;
End;

{ av_reduce (libavutil/rational.c) }
Procedure O1Reduce(Var ON,OD: Int64; Num,Den,Max: Int64);
Var A0n,A0d,A1n,A1d,Sign,G,X,NextDen,A2n,A2d: Int64;
Begin
 A0n:=0; A0d:=1; A1n:=1; A1d:=0; Sign:=0;
 If (Num<0) Xor (Den<0) Then Sign:=1;
 If Num<0 Then Num:=-Num; If Den<0 Then Den:=-Den;
 G:=O1Gcd(Num,Den);
 If G<>0 Then Begin Num:=Num Div G; Den:=Den Div G; End;
 If (Num<=Max) And (Den<=Max) Then Begin A1n:=Num; A1d:=Den; Den:=0; End;
 While Den<>0 Do Begin
  X:=Num Div Den; NextDen:=Num-Den*X;
  A2n:=X*A1n+A0n; A2d:=X*A1d+A0d;
  If (A2n>Max) Or (A2d>Max) Then Begin
   If A1n<>0 Then X:=(Max-A0n) Div A1n;
   If A1d<>0 Then Begin If (Max-A0d) Div A1d<X Then X:=(Max-A0d) Div A1d; End;
   If Den*(2*X*A1d+A0d)>Num*A1d Then Begin
    A2n:=X*A1n+A0n; A2d:=X*A1d+A0d; A1n:=A2n; A1d:=A2d;
   End;
   Break;
  End;
  A0n:=A1n; A0d:=A1d; A1n:=A2n; A1d:=A2d;
  Num:=Den; Den:=NextDen;
 End;
 If Sign<>0 Then ON:=-A1n Else ON:=A1n;
 OD:=A1d;
End;

{ lit le jeton A de l'en-tete Y4M du fichier d'entree ; sinon 1:1 (comportement
 historique) }
Procedure O1AviSar(Var N,D: LongInt);
Var F: File; B: Array[0..255] Of Byte; Cnt,I,P: LongInt; S: String; V: Int64;
Begin
 N:=1; D:=1;
 Assign(F,InputPath); {$I-}Reset(F,1);{$I+}
 If IOResult<>0 Then Exit;
 Cnt:=0; {$I-}BlockRead(F,B,256,Cnt);{$I+}
 Close(F);
 If Cnt<10 Then Exit;
 If Not ((B[0]=89) And (B[1]=85) And (B[2]=86) And (B[3]=52)) Then Exit;
 S:=''; I:=0;
 While (I<Cnt) And (B[I]<>10) And (Length(S)<250) Do Begin S:=S+Chr(B[I]); Inc(
  I); End;
 N:=0; D:=1;
 P:=Pos(' A',S);
 If P>0 Then Begin
  P:=P+2; V:=0;
  While (P<=Length(S)) And (S[P] In ['0'..'9']) Do Begin V:=V*10+Ord(S[P])-48;
   Inc(P); End;
  N:=V; V:=0;
  If (P<=Length(S)) And (S[P]=':') Then Begin
   Inc(P);
   While (P<=Length(S)) And (S[P] In ['0'..'9']) Do Begin V:=V*10+Ord(S[P])-48;
    Inc(P); End;
   D:=V;
  End Else D:=0;
  If (N=0) And (D=0) Then D:=1;
 End;
End;

{ DAR = SAR * W/H reduite a 16 bits (avienc.c vprp) }
Procedure O1AviDar(W,H,SN,SD: LongInt; Var Num,Den: LongInt);
Var A,B,X,Y: Int64;
Begin
 O1Reduce(A,B,Int64(SN)*W,Int64(SD)*H,2147483647);
 O1Reduce(X,Y,A,B,65535);
 Num:=X; Den:=Y;
End;

{ sortie existante sans -y (fftools assert_file_overwrite) : question sur stdin
 ou arret }
Procedure O1OverwriteGate(Const Path: String);
Var Ch: Char; NoIn: Boolean; I: Integer; Yes: Boolean;
Begin
 NoIn:=False;
 For I:=1 To ParamCount Do Begin
  If ParamStr(I)='-nostdin' Then NoIn:=True;
  If ParamStr(I)='-stdin' Then NoIn:=False;
  If ParamStr(I)='-hide_banner' Then O1HideBanner:=True;
  If ParamStr(I)='-n' Then NoOverwrite:=True;
  If ParamStr(I)='-y' Then Overwrite:=True;
 End;
 If Overwrite Then Exit;
 O1Banner;
 If NoOverwrite Or NoIn Then Begin
  If O1LogLevel>=8 Then WriteLn(StdErr,'File ''',Path,
   ''' already exists. Exiting.');
 End Else Begin
  Write(StdErr,'File ''',Path,''' already exists. Overwrite? [y/N] '); Flush(
   StdErr);
  Yes:=False; Ch:=#0;
  {$I-}
  If Not Eof(Input) Then Begin Read(Input,Ch); Yes:=(Ch='y') Or (Ch='Y'); End;
  {$I+}
  If IOResult<>0 Then Yes:=False;
  If Yes Then Begin
   While Not Eof(Input) And (Ch<>#10) Do Read(Input,Ch);
   Overwrite:=True;
   Exit;
  End;
  While Not Eof(Input) And (Ch<>#10) Do Read(Input,Ch);
  If O1LogLevel>=8 Then WriteLn(StdErr,'Not overwriting - exiting');
 End;
 If O1LogLevel>=16 Then WriteLn(StdErr,'Error opening output file ',Path,'.');
 Flush(StdErr); Halt(0);
End;


Function Lower(S: String): String;
Var
 J: Integer;
Begin
 For J:=1 To Length(S) Do If S[J] In ['A'..'Z'] Then S[J]:=Chr(Ord(S[J])+32);
  Lower:=S;
End;

Function Extension(Const Name: String): String;
Var
 J: Integer;
Begin
 J:=Length(Name);
 While (J>0) And Not (Name[J] In ['.','/','\',':']) Do Dec(J);
 If (J>0) And (Name[J]='.') Then Extension:=Lower(Copy(Name,J+1,255)) Else
  Extension:='';
End;

Function FormatName(S: String): String;Begin
 S:=Lower(S); If (S='aif') Or (S='aifc') Then S:='aiff';
 If (S=
'mkv') Or (S='mka') Then S:='matroska'; { F4 }
 If (S=
'8svx') Or (S='svx') Then S:='iff';
 If S='adts' Then S:='aac';
 If S='mod' Then S:='libopenmpt';
 If (S='mov') Or (S='qt') Or (S='m4a') Then S:='mp4';
 If S='m3u8' Then S:='hls';
 If (S='mpg') Or (S='mpe') Then S:='mpeg';
 If S='y4m' Then S:='yuv4mpegpipe';
 If
(S='tga') Or (S='icb') Or (S='vda') Or (S='vst') Then S:='targa';
 If S='tif' Then S:='tiff';
 If S='ras' Then S:='sunrast';
 If
 S='m1v' Then S:='mpeg1video';
 If S='m2v' Then S:='mpeg2video';
 If (S='wmv') Or (S='wma') Then S:='asf';
 If S='dnx' Then S:='dnxhd';
 If S=
'dif' Then S:='dv';
 If S='idx' Then S:='vobsub';
 If (S='ts') Or (S='m2ts') Then S:='mpegts';
 If S=
'rmvb' Then S:='rm';
 If S='cavs' Then S:='cavsvideo';
 If (S='oga') Or (S='ogv') Or (S='spx') Then S:='ogg';
 If S='ec3' Then S:='eac3'; If S='ssa' Then S:='ass'; If S='aud' Then S:=
  'wsaud';
 If S='thd' Then S:='truehd';
 If S='sw' Then S:='s16le' Else If S='sb' Then S:='s8' Else If S='uw' Then S:=
  'u16le' Else If S='ub' Then S:='u8'
 Else If S='al' Then S:='alaw' Else If S='ul' Then S:='mulaw' Else If S='302'
  Then S:='daud';

 FormatName:=S;
End;

Function NewTemporary: String;
Var
 Folder,Digits,Name: String;
 J,K,Attempt: Integer;
 Used: Boolean;
Begin
 J:=Length(OutputPath);
 While (J>0) And Not (OutputPath[J] In ['/','\',':']) Do Dec(J);
 Folder:=Copy(OutputPath,1,J);
 If Length(Folder)>240 Then Fail('Chemin de sortie trop long.');
 For Attempt:=1 To 100 Do Begin
  Str(Random(30000),Digits); Name:=Folder+'FFP'+Digits+'.TMP';
  Used:=Exists(Name);
  For K:=0 To 6 Do If Lower(Temps[K])=Lower(Name) Then Used:=True;
  If Not Used Then Begin
   NewTemporary:=Name; Exit;
  End;
 End;
 Fail('Nom temporaire indisponible.'); NewTemporary:='';
End;

