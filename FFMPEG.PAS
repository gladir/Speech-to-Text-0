Function Exists(Const Name: String): Boolean;
Var
 F: File;
 A: Word;
Begin
 Assign(F,Name); GetFAttr(F,A); Exists := DosError=0;
End;

Function IsDirectory(Const Name: String): Boolean;
Var
 F: File;
 A: Word;
Begin
 Assign(F,Name); GetFAttr(F,A); IsDirectory:=(DosError=0) And ((A And Directory)<>0);
End;

Procedure Cleanup;
Var
 J,Code: Integer;
 F: File;
Begin
 {$IFDEF MSWINDOWS}
  If NetRequest<>Nil Then Begin
   InternetCloseHandle(NetRequest); NetRequest:=Nil;
  End;
  If NetSession<>Nil Then Begin
   InternetCloseHandle(NetSession); NetSession:=Nil;
  End;
 {$ENDIF}
 If HLSListOpen Then Begin
 {$I-}Close(HLSList); Code:=IOResult;{$I+} HLSListOpen:=False;
 End;
 If InputActive Then Begin
 {$I-}Close(ActiveInput); Code := IOResult;{$I+} InputActive := False;
 End;
 If OutputActive Then Begin
 {$I-}Close(ActiveOutput); Code := IOResult;{$I+} OutputActive := False;
 End;
 For J := 0 To 6 Do If Temps[J]<>'' Then If Exists(Temps[J]) Then Begin
  Assign(F,Temps[J]); {$I-}Erase(F); Code := IOResult;{$I+}
  If Code<>0 Then WriteLn('Temporaire a supprimer: ',Temps[J]);
 End;
End;
Procedure ExitCleanup;
{$IFNDEF FPC}
 Far;
{$ENDIF}
Begin
 ExitProc := SavedExit; Cleanup;
End;

Procedure Fail(Const MessageText: String);Begin
 WriteLn('FFMPEG Pascal: ',MessageText); Halt(1);
End;

Function Lower(S: String): String;
Var
 J: Integer;
Begin
 For J:=1 To Length(S) Do If S[J] In ['A'..'Z'] Then S[J]:=Chr(Ord(S[J])+32); Lower:=S;
End;

Function Extension(Const Name: String): String;
Var
 J: Integer;
Begin
 J:=Length(Name);
 While (J>0) And Not (Name[J] In ['.','/','\',':']) Do Dec(J);
 If (J>0) And (Name[J]='.') Then Extension:=Lower(Copy(Name,J+1,255)) Else Extension:='';
End;

Function FormatName(S: String): String;Begin
 S:=Lower(S); If (S='aif') Or (S='aifc') Then S:='aiff';
 If (S='8svx') Or (S='svx') Then S:='iff';
 If S='adts' Then S:='aac';
 If S='mod' Then S:='libopenmpt';
 If (S='mov') Or (S='qt') Or (S='m4a') Then S:='mp4';
 If S='m3u8' Then S:='hls';
 If (S='mpg') Or (S='mpe') Then S:='mpeg';
 If S='y4m' Then S:='yuv4mpegpipe';
 If S='m1v' Then S:='mpeg1video';
 If S='m2v' Then S:='mpeg2video';
 If (S='wmv') Or (S='wma') Then S:='asf';
 FormatName:=S;
End;

Function NewTemporary: String;
Var
 Folder,Digits,Name: String;
 J,K,Attempt: Integer;
 Used: Boolean;
Begin
 J:=Length(OutputPath);
 While (J>0) And Not (OutputPath[J] In ['/','\',':']) Do Dec(J);
 Folder:=Copy(OutputPath,1,J);
 If Length(Folder)>240 Then Fail('Chemin de sortie trop long.');
 For Attempt:=1 To 100 Do Begin
  Str(Random(30000),Digits); Name:=Folder+'FFP'+Digits+'.TMP';
  Used:=Exists(Name);
  For K:=0 To 6 Do If Lower(Temps[K])=Lower(Name) Then Used:=True;
  If Not Used Then Begin
   NewTemporary:=Name; Exit;
  End;
 End;
 Fail('Nom temporaire indisponible.'); NewTemporary:='';
End;

Procedure OpenRead(Const Name: String);
Var
 Code: Integer;
 OldMode: Byte;
Begin
 Assign(ActiveInput,Name); OldMode:=FileMode; FileMode:=0;
 {$I-}Reset(ActiveInput,1); Code:=IOResult;{$I+} FileMode:=OldMode;
 If Code<>0 Then Fail('Lecture impossible: '+Name); InputActive:=True;
End;

Procedure CloseRead;
Var
 Code: Integer;
Begin
 {$I-}Close(ActiveInput); Code:=IOResult;{$I+} InputActive:=False;
 If Code<>0 Then Fail('Fermeture entree impossible.');
End;

Procedure OpenWrite(Const Name: String);
Var
 Code: Integer;
Begin
 If Exists(Name) Then Fail('Sortie intermediaire deja existante.');
 Assign(ActiveOutput,Name); {$I-}Rewrite(ActiveOutput,1); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Creation impossible: '+Name); OutputActive:=True;
End;

Procedure CloseWrite;
Var
 Code: Integer;
Begin
 {$I-}Close(ActiveOutput); Code:=IOResult;{$I+} OutputActive:=False;
 If Code<>0 Then Fail('Fermeture sortie impossible.');
End;

Procedure ReadAt(Position: LongInt; Var Buffer; Count: Word);
Var
 Code: Integer;
 Actual: Word;
Begin
 {$I-}Seek(ActiveInput,Position); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Position entree incorrecte.');
 {$I-}BlockRead(ActiveInput,Buffer,Count,Actual); Code:=IOResult;{$I+}
 If (Code<>0) Or (Actual<>Count) Then Fail('Entree tronquee.');
End;

Procedure WriteBytes(Var Buffer; Count: Word);
Var
 Code: Integer;
 Actual: Word;
Begin
 {$I-}BlockWrite(ActiveOutput,Buffer,Count,Actual); Code:=IOResult;{$I+}
 If (Code<>0) Or (Actual<>Count) Then Fail('Ecriture incomplete.');
End;

Function InputSize: LongInt;
Var
 Code: Integer;
 N: LongInt;
Begin
 {$I-}N:=FileSize(ActiveInput); Code:=IOResult;{$I+}
 If (Code<>0) Or (N<0) Then Fail('Taille entree invalide ou superieure a 2 Go.');
 InputSize:=N;
End;

{ B pictures are displayed before the future reference, but coded after it.
  Keep offsets only; the raw pictures remain in the seekable Y4M input. }
Function NextVideoFrame(Var S:TVideoSchedule; Var At:LongInt; Limit,Size:LongInt;
 Var Position,Number:LongInt; Var IsB:Boolean):Boolean;
Var N,I:Integer; Marker:String[6];
Begin
 NextVideoFrame:=False;
 If S.Next>=S.Count Then Begin
  S.Count:=0; S.Next:=0; N:=BFrames+1; If S.Total=0 Then N:=1;
  While (S.Count<N) And (At<Limit) Do Begin
   If Limit-At<6 Then Fail('Y4M: marqueur FRAME tronque.');
   Marker:='      '; ReadAt(At,Marker[1],6);
   If Marker<>'FRAME'+#10 Then Fail('Y4M: marqueur FRAME simple requis.'); Inc(At,6);
   If Size>Limit-At Then Fail('Y4M: image tronquee.');
   S.Positions[S.Count]:=At; S.Numbers[S.Count]:=S.Total;
   Inc(S.Total); Inc(S.Count); Inc(At,Size);
  End;
  If S.Count=0 Then Exit;
 End;
 I:=S.Next-1; If S.Next=0 Then I:=S.Count-1;
 Position:=S.Positions[I]; Number:=S.Numbers[I]; IsB:=S.Next<>0;
 Inc(S.Next); NextVideoFrame:=True;
End;

{ Native video rate control: search QP 4..31 to fit each frame budget. }
Function VideoOutPosition: LongInt;
Var Code: Integer; P: LongInt;
Begin
 {$I-}P:=FilePos(ActiveOutput); Code:=IOResult;{$I+}
 If (Code<>0) Or (P<0) Then Fail('Position de sortie video incorrecte.'); VideoOutPosition:=P;
End;
Procedure VideoRewind(P: LongInt);
Var Code: Integer;
Begin {$I-}Seek(ActiveOutput,P); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Reprise encodage video impossible.'); End;
Procedure VideoRateStart;
Begin VideoBufferAvailable:=VideoBuffer*0.75; LastReferenceQP:=4; VideoRateBits:=0; VideoRateDuration:=0; VideoRateLimited:=0; End;
Procedure VideoTrialStart(Var R: TVideoRateTrial; Seconds: Double);
Var Compensation:Double;
Begin
 { One-pass accumulated-rate feedback, following FFmpeg ratecontrol.c.
   Zero tolerance selects the strict per-picture budget without division. }
 Compensation:=1;
 If VideoTolerance>0 Then Begin
  Compensation:=1-(VideoRateBits-VideoBitrate*VideoRateDuration)/VideoTolerance;
  If Compensation<0.001 Then Compensation:=0.001;
 End;
 VideoFrameBudget:=VideoBitrate*Seconds*Compensation;
 R.Q:=4; R.Low:=4; R.High:=31; R.Best:=0; R.Done:=False; R.Budget:=VideoFrameBudget;
 If (VideoBuffer>0) And (R.Budget>VideoBufferAvailable) Then R.Budget:=VideoBufferAvailable;
End;
Procedure VideoPictureTrialStart(Var R:TVideoRateTrial; Seconds:Double; IsB:Boolean);
Begin
 VideoTrialStart(R,Seconds);
 { Positive factor fixes B QP from the last accepted reference, not a trial. }
 If IsB And (BQuantFactor>0) Then Begin
  If VideoBuffer=0 Then R.Done:=True Else Begin
   R.Q:=Trunc(LastReferenceQP*BQuantFactor+BQuantOffset+0.5);
   If R.Q<1 Then R.Q:=1; If R.Q>31 Then R.Q:=31; R.Low:=R.Q;
  End;
 End;
End;
Function VideoPictureQP(Base:Integer; IsB:Boolean):Integer;
Var Q:Double;
Begin
 Q:=Base;
 If IsB Then Begin
  If BQuantFactor>0 Then Begin
   Q:=LastReferenceQP*BQuantFactor+BQuantOffset;
   If (VideoBuffer>0) And (Q<Base) Then Q:=Base;
  End
  Else If BQuantFactor<0 Then Q:=-Base*BQuantFactor+BQuantOffset;
 End;
 If Q<1 Then Q:=1; If Q>31 Then Q:=31;
 VideoPictureQP:=Trunc(Q+0.5);
End;
Function VideoTrialAgain(Var R: TVideoRateTrial; Bytes: LongInt): Boolean;
Begin
 VideoTrialAgain:=False; If R.Done Then Exit;
 If Bytes*8.0<=R.Budget Then Begin R.Best:=R.Q; R.High:=R.Q-1; End Else R.Low:=R.Q+1;
 If R.Low<=R.High Then Begin R.Q:=(R.Low+R.High) Div 2; VideoTrialAgain:=True; End Else
 If (R.Best<>0) And (R.Best<>R.Q) Then Begin R.Q:=R.Best; R.Done:=True; VideoTrialAgain:=True; End;
End;
Procedure VideoRateAccept(Bytes: LongInt; Seconds: Double);
Var Code: Integer;
Begin
 If VideoBuffer>0 Then Begin
  If Bytes*8.0>VideoBufferAvailable Then Fail('-bufsize: tampon insuffisant pour cette image au QP autorise.');
  VideoBufferAvailable:=VideoBufferAvailable-Bytes*8.0+VideoBitrate*Seconds;
  If VideoBufferAvailable>VideoBuffer Then VideoBufferAvailable:=VideoBuffer;
 End;
 { Remove the tail of a larger trial before the next picture or muxing. }
 {$I-}Truncate(ActiveOutput); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Finalisation encodage video impossible.');
 VideoRateBits:=VideoRateBits+Bytes*8.0; VideoRateDuration:=VideoRateDuration+Seconds;
 If Bytes*8.0>VideoFrameBudget Then Inc(VideoRateLimited);
End;
Procedure VideoRateReport;
Begin
 If HideBanner Or (VideoRateDuration<=0) Then Exit;
 WriteLn('Tolerance video: ',VideoTolerance,' bits/s.');
 WriteLn('Debit video cible: ',VideoBitrate,' bit/s; obtenu: ',VideoRateBits/VideoRateDuration:0:0,' bit/s.');
 If VideoRateLimited>0 Then WriteLn(VideoRateLimited,' image(s): budget depasse (quantification maximale ou QP B impose).');
End;

Function Probe(Const Name: String): String;
Var
 B: Array[0..1083] Of Byte;
 N,J: Integer;
 Size,StartPos,TagSize,ADXOffset: LongInt;
 EASize: Int64;
 Tag: String[4];
Begin
 OpenRead(Name); Size:=InputSize; StartPos:=0;
 Repeat
  N:=1084; If Size-StartPos<N Then N:=Size-StartPos;
  FillChar(B,SizeOf(B),0); ReadAt(StartPos,B,N);
  If N<10 Then Break;
  If (B[0]<>73) Or (B[1]<>68) Or (B[2]<>51) Then Break;
  If (B[3]<2) Or (B[3]>4) Or (B[4]=255) Then Fail('Version ID3v2 invalide.');
  TagSize:=0;
  For J:=6 To 9 Do Begin
   If B[J]>127 Then Fail('Taille ID3v2 invalide.'); TagSize:=TagSize*128+B[J];
  End;
  Inc(TagSize,10); If (B[3]=4) And ((B[5] And 16)<>0) Then Inc(TagSize,10);
  If TagSize>Size-StartPos Then Fail('Etiquette ID3v2 tronquee.');
  Inc(StartPos,TagSize);
 Until False;
 CloseRead;
 Probe:='';
 If N>=10 Then If ((B[0]=101) And (B[1]=97) And (B[2]=51) And (B[3]>=2) And (B[3]<=4)) Or
  ((B[0]=69) And (B[1]=65) And (B[2]=51) And (B[4]=0) And (B[5]=96)) Then Begin Probe:='oma'; Exit; End;
 If N>=9 Then If (B[0]=89) And (B[1]=85) And (B[2]=86) And (B[3]=52) And
  (B[4]=77) And (B[5]=80) And (B[6]=69) And (B[7]=71) And (B[8]=50) Then Begin
  Probe:='yuv4mpegpipe'; Exit;
 End;
 If N>=4 Then If (B[0]=0) And (B[1]=0) And (B[2]=1) And (B[3]=$B3) Then Begin
  Probe:='mpeg1video'; Exit;
 End;
 If N>=5 Then If (B[0]=0) And (B[1]=0) And (B[2]=1) And
  ((B[3]=$B0) Or (B[3]=$B5) Or (B[3]<=$2F)) Then Begin
  Probe:='m4v'; Exit;
 End;
 If N>=4 Then If (B[0]=0) And (B[1]=0) And (B[2]=1) And (B[3]=$BA) Then Begin
  Probe:='mpeg'; Exit;
 End;
 If N>=16 Then If (B[0]=$30) And (B[1]=$26) And (B[2]=$B2) And (B[3]=$75) And
  (B[4]=$8E) And (B[5]=$66) And (B[6]=$CF) And (B[7]=$11) Then Begin
  Probe:='asf'; Exit;
 End;
 If N>=9 Then If (B[0]=70) And (B[1]=76) And (B[2]=86) Then Begin
  Probe:='flv'; Exit;
 End;
 If N>=12 Then If (B[0]=82) And (B[1]=73) And (B[2]=70) And (B[3]=70) And
  (B[8]=52) And (B[9]=88) And (B[10]=77) And (B[11]=86) Then Begin Probe:='4xm'; Exit; End;
 If N>=8 Then Begin
  Tag:=''; For J:=4 To 7 Do Tag:=Tag+Chr(B[J]);
  If (Tag='moov') Or (Tag='mdat') Or (Tag='wide') Or (Tag='free') Or (Tag='skip') Then Begin Probe:='mp4'; Exit; End;
 End;
 If N>=12 Then Begin
  If (B[4]=102) And (B[5]=116) And (B[6]=121) And (B[7]=112) Then Begin
   Probe:='mp4'; Exit;
  End;
  If (B[0]=82) And (B[1]=73) And (B[2]=70) And (B[3]=70) And
  (B[8]=65) And (B[9]=86) And (B[10]=73) And (B[11]=32) Then Begin
   Probe:='avi'; Exit;
  End;
  If (B[0]=$1A) And (B[1]=$45) And (B[2]=$DF) And (B[3]=$A3) Then Begin
   Probe:='webm'; Exit;
  End;
 End;
 If N>=7 Then If (B[0]=35) And (B[1]=69) And (B[2]=88) And
 (B[3]=84) And (B[4]=77) And (B[5]=51) And (B[6]=85) Then Begin
  Probe:='hls'; Exit;
 End;
 If N>=12 Then Begin
  If (B[0]=82) And (B[1]=73) And (B[2]=70) And (B[3]=70) And
  (B[8]=87) And (B[9]=65) And (B[10]=86) And (B[11]=69) Then Begin
   Probe:='wav'; Exit;
  End;
  If (B[0]=70) And (B[1]=79) And (B[2]=82) And (B[3]=77) And
  (B[8]=65) And (B[9]=73) And (B[10]=70) And (B[11] In [70,67]) Then Begin
   Probe:='aiff'; Exit;
  End;
 End;
 If N>=12 Then If (B[0]=70) And (B[1]=79) And (B[2]=82) And (B[3]=77) And
  (B[8]=56) And (B[9]=83) And (B[10]=86) And (B[11]=88) Then Begin Probe:='iff'; Exit; End;
 If N>=26 Then If (B[0]=67) And (B[1]=114) And (B[2]=101) And (B[19]=$1A) Then Begin
  Probe:='voc'; Exit;
 End;
 If N>=8 Then If (B[0]=$80) And (B[1]=0) Then Begin
  ADXOffset:=LongInt(B[2])*256+B[3];
  If (ADXOffset>=8) And (ADXOffset<=N-4) Then
   If (B[ADXOffset-2]=40) And (B[ADXOffset-1]=99) And (B[ADXOffset]=41) And
    (B[ADXOffset+1]=67) And (B[ADXOffset+2]=82) And (B[ADXOffset+3]=73) Then Begin Probe:='adx'; Exit; End;
 End;
 If N>=24 Then If (B[0]=88) And (B[1]=65) And ((B[2]=0) Or (B[2]=73) Or (B[2]=74)) And (B[3]=0) Then Begin
  { Maxis XA: canaux 1..8, frequence 1..192000, 4..32 bits. }
  ADXOffset:=LongInt(B[12])+LongInt(B[13])*256+LongInt(B[14])*65536+LongInt(B[15])*16777216;
  If (B[10]+B[11]*256<>0) And (B[10]+B[11]*256<=8) And (ADXOffset>0) And (ADXOffset<=192000) And
   (B[22]+B[23]*256>=4) And (B[22]+B[23]*256<=32) Then Begin Probe:='xa'; Exit; End;
 End;
 If N>=8 Then Begin
  Tag:=Chr(B[0])+Chr(B[1])+Chr(B[2])+Chr(B[3]);
  If (Tag='1SNh') Or (Tag='SCHl') Or (Tag='SEAD') Or (Tag='SHEN') Or (Tag='kVGT') Or
   (Tag='MADk') Or (Tag='MPCh') Or (Tag='MVhd') Or (Tag='MVIh') Or (Tag='AVP6') Then Begin
   EASize:=Int64(B[4])+Int64(B[5])*256+Int64(B[6])*65536+Int64(B[7])*16777216;
   If EASize>1048575 Then
    EASize:=Int64(B[7])+Int64(B[6])*256+Int64(B[5])*65536+Int64(B[4])*16777216;
   ADXOffset:=0; If EASize<=1048575 Then ADXOffset:=EASize;
   If (ADXOffset>=8) And (ADXOffset<=1048575) Then Begin Probe:='ea'; Exit; End;
  End;
 End;
 If N>=16 Then If (B[0]=119) And (B[1]=87) And (B[2]=16) And (B[3]=0) Then Begin Probe:='avs'; Exit; End;
 If N>=8 Then If (B[0]=77) And (B[1]=65) And (B[2]=67) And (B[3]=32) Then Begin Probe:='ape'; Exit; End;
 If N>=20 Then If (B[0]=84) And (B[1]=72) And (B[2]=80) And (B[3]=0) Then Begin Probe:='thp'; Exit; End;
 If N>=24 Then If (B[0]=0) And (B[1]=255) And (B[10]=255) And (B[11]=0) And (B[$11]<32) And ((B[$12] And $0E)<>0) Then Begin Probe:='psxstr'; Exit; End;
 If N>=8 Then If (B[0]=0) And (B[1]=10) And (B[2]=83) And (B[3]=77) And (B[4]=74) And (B[5]=80) And
  (B[6]=69) And (B[7]=71) Then Begin Probe:='smjpeg'; Exit; End;
 If N>=15 Then If (B[0]=73) And (B[1]=77) And (B[2]=65) And (B[3]=95) And (B[4]=65) And (B[5]=68) And
  (B[6]=80) And (B[7]=67) And (B[8]=77) And (B[9]=95) And (B[10]=83) And (B[11]=111) And (B[12]=117) And
  (B[13]=110) And (B[14]=100) Then Begin Probe:='iss'; Exit; End;
 If N>=12 Then If (B[0]=82) And (B[1]=73) And (B[2]=70) And (B[3]=70) And (B[8]=65) And (B[9]=77) And
  (B[10]=86) And (B[11]=32) Then Begin Probe:='amv'; Exit; End;
 If N>=7 Then If (B[0]=$0B) And (B[1]=$77) Then Begin Probe:='ac3'; Exit; End;
 If N>=7 Then If (B[0]=$FF) And ((B[1] And $F6)=$F0) Then Begin Probe:='aac'; Exit; End;
 If N>=4 Then If (B[0]=$FF) And ((B[1] And $E6)=$E6) Then Begin
  Probe:='mp1'; Exit;
 End;
 If N>=4 Then If ((B[0]=73) And (B[1]=68) And (B[2]=51)) Or
 ((B[0]=$FF) And ((B[1] And $E6)=$E2)) Then Begin
  Probe:='mp3'; Exit;
 End;
 If N>=20 Then If (LongInt(B[0])+LongInt(B[1])*256>=8000) And (LongInt(B[0])+LongInt(B[1])*256<=48000) And
  ((B[10] And $FC)=0) And ((B[11]=99) Or (B[11]=1)) And (B[16]=$AF) And (B[17]=$DE) And (B[18]=0) And
  (B[19]=0) Then Begin Probe:='wsaud'; Exit; End;
 If N>=1084 Then Begin
  Tag:='';
  For J:=1080 To 1083 Do Tag:=Tag+Chr(B[J]);
  If (Tag='M.K.') Or (Tag='M!K!') Or (Tag='4CHN') Or (Tag='FLT4') Then Probe:=
  'libopenmpt';
 End;
End;

{ ASF packet reader. Reassembles media objects; it does not decode WMV/WMA.
  ASFP0001 is a private spool/test format, never an FLV output.
  Reference: FFmpeg libavformat/asfdec_f.c and the ASF object layout. }
Procedure DemuxASF(Const Source,Target: String);
Const
 GHeader: String[16]=#$30#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GFile: String[16]=#$A1#$DC#$AB#$8C#$47#$A9#$CF#$11#$8E#$E4#$00#$C0#$0C#$20#$53#$65;
 GStream: String[16]=#$91#$07#$DC#$B7#$B7#$A9#$CF#$11#$8E#$E6#$00#$C0#$0C#$20#$53#$65;
 GAudio: String[16]=#$40#$9E#$69#$F8#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GVideo: String[16]=#$C0#$EF#$19#$BC#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GData: String[16]=#$36#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GExtension: String[16]=#$B5#$03#$BF#$5F#$2E#$A9#$CF#$11#$8E#$E3#$00#$C0#$0C#$20#$53#$65;
 GEncrypt: String[16]=#$FB#$B3#$11#$22#$23#$BD#$D2#$11#$B4#$B7#$00#$A0#$C9#$55#$FC#$6E;
