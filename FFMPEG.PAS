  Else If Argument='-y' Then Overwrite:=True Else
  If Argument='-n' Then NoOverwrite:=True Else
  If Argument='-hide_banner' Then HideBanner:=True Else
  If Argument='-vn' Then NoVideo:=True Else
  If Argument='-comment' Then Begin
   CommentName:=NextArgument; HasComment:=True; PrepareComment;
  End
  Else If Argument='-album' Then Begin
   AlbumName:=NextArgument; HasAlbum:=True; PrepareAlbum;
  End Else
  If Argument='-an' Then NoAudio:=True Else
  If Argument='-aspect' Then Begin
   ParseAspect(NextArgument);
  End Else
  If (Argument='-croptop') Or (Argument='-cropbottom') Or (Argument='-cropleft') Or (Argument='-cropright') Then Begin
   Value:=NextArgument; Val(Value,Number,Code);
   If (Code<>0) Or (Number<0) Or (Number>8192) Then Fail('Crop: nombre entier de pixels 0..8192 requis.');
   HasCrop:=True;
   If Argument='-croptop' Then CropTop:=Number Else If Argument='-cropbottom' Then CropBottom:=Number
   Else If Argument='-cropleft' Then CropLeft:=Number Else CropRight:=Number;
  End Else
  If Argument='-4mv' Then Begin
   FourMV:=True;
  End Else
  If (Argument='-vcodec') Or (Argument='-c:v') Or (Argument='-codec:v') Then Begin
   If InputPath='' Then Fail('Codec video de sortie attendu apres -i.');
   VideoCodec:=Lower(NextArgument);
   If (VideoCodec<>'png') And (VideoCodec<>'gif') And (VideoCodec<>'copy') And
    (VideoCodec<>'ffv1') And (VideoCodec<>'flv') And (VideoCodec<>'mpeg4') And (VideoCodec<>'mpeg1video') And (VideoCodec<>'mpeg2video') And (VideoCodec<>'rawvideo') And
    (VideoCodec<>'asv1') And (VideoCodec<>'asv2') Then
    Fail('Codec video: png/gif, copy, ffv1, flv, mpeg4, mpeg1video, mpeg2video, rawvideo, asv1, asv2.');
  End Else If (Argument='-vframes') Or (Argument='-frames:v') Then Begin
   If InputPath='' Then Fail('Nombre d''images attendu apres -i.');
   Value:=NextArgument; Val(Value,Number,Code);
   If (Code<>0) Or (Number<>1) Then Fail('Extraction PNG/GIF: -vframes 1 uniquement.');
   VideoFrames:=1;
  End Else If Argument='-s' Then Begin
   If InputPath='' Then Fail('Dimensions de sortie attendues apres -i.');
   Value:=Lower(NextArgument); J:=Pos('x',Value);
   If J<2 Then Fail('-s exige LARGEURxHAUTEUR, exemple 106x106.');
   Val(Copy(Value,1,J-1),Number,Code);
   If (Code<>0) Or (Number<1) Or (Number>8192) Then Fail('Largeur image: 1..8192.');
   ImageWidth:=Number; Val(Copy(Value,J+1,255),Number,Code);
   If (Code<>0) Or (Number<1) Or (Number>4096) Then Fail('Hauteur image: 1..4096.');
   ImageHeight:=Number;
  End Else
  If Argument='-hls_base_url' Then Begin
   HLSBase:=NextArgument;
   If Not IsHTTP(HLSBase) Then Fail('-hls_base_url exige une URL HTTP/HTTPS.');
  End
  Else If Argument='-f' Then PendingFormat:=FormatName(NextArgument) Else
  If Argument='-i' Then Begin
   If InputPath<>'' Then Fail('Une seule entree est prise en charge.');
   InputPath:=NextArgument; InputFormat:=PendingFormat; PendingFormat:='';
  End
  Else If (Argument='-c') Or (Argument='-codec') Or (Argument='-c:a') Or (Argument=
  '-codec:a') Or (Argument='-acodec') Then Begin
   If InputPath='' Then InputCodec:=Lower(NextArgument) Else Begin
    AllStreams:=(Argument='-c') Or (Argument='-codec');
    AudioCodec:=Lower(NextArgument);
   End;
  End
  Else If (Argument='-ar') Or (Argument='-ac') Then Begin
   If InputPath='' Then Fail('Option de sortie attendue apres -i: '+Argument);
   Value:=NextArgument; Val(Value,Number,Code);
   If Code<>0 Then Fail('Valeur numerique incorrecte: '+Value);
   If Argument='-ar' Then Begin
    If (Number<4000) Or (Number>192000) Then Fail('-ar attendu: 4000..192000.');
    RequestedRate:=Number;
   End Else
   Begin
    If (Number<>1) And (Number<>2) Then Fail('-ac attendu: 1 ou 2.');
    RequestedChannels:=Number;
   End;
  End
  Else If Argument='-bf' Then Begin
   Value:=NextArgument; Val(Value,Number,Code);
   If (Code<>0) Or (Number<0) Or (Number>16) Then Fail('-bf: nombre entier 0..16 requis.');
   BFrames:=Number; HasBFrames:=True;
  End
  Else If (Argument='-b') Or (Argument='-b:v') Then Begin
   VideoBitrate:=ParseVideoRate(NextArgument,'-b',1,100000000); HasVideoBitrate:=True;
  End
  Else If Argument='-b_qfactor' Then Begin
   BQuantFactor:=ParseBQuant(NextArgument,'-b_qfactor'); HasBQuant:=True;
  End
  Else If Argument='-b_qoffset' Then Begin
   BQuantOffset:=ParseBQuant(NextArgument,'-b_qoffset'); HasBQuant:=True;
  End
  Else If Argument='-bufsize' Then Begin
   VideoBuffer:=ParseVideoRate(NextArgument,'-bufsize',0,16760832); HasVideoBuffer:=True;
  End
  Else If Argument='-bt' Then Begin
   VideoTolerance:=ParseVideoRate(NextArgument,'-bt',0,2147483647); HasVideoTolerance:=True;
  End
  Else If (Argument='-b:a') Or (Argument='-ab') Then Begin
   If InputPath='' Then Fail('Debit de sortie attendu apres -i.');
   Value:=Lower(NextArgument);
   If Value='' Then Fail('Debit audio manquant.');
   If Value[Length(Value)]='k' Then Begin
    Delete(Value,Length(Value),1); Val(Value,Number,Code);
   End Else Begin
    Val(Value,Number,Code);
    { Ancienne syntaxe -ab 64: kbit/s. -b:a garde les bits/s. }
    If (Code=0) And Not ((Argument='-ab') And (Number>=32) And (Number<=640)) Then Begin
     If Number Mod 1000<>0 Then Code:=1 Else Number:=Number Div 1000;
    End;
   End;
   If Code<>0 Then Fail('Debit audio invalide; exemple -b:a 64k.');
   Case Number Of
    32,40,48,56,64,80,96,112,128,160,192,224,256,320,384,448,512,576,640: RequestedBitRateK:=Number;
    Else Fail('Debit audio normalise requis: MP3 32..320k ou AC3 32..640k.');
   End;
   HasBitrate:=True;
  End
  Else If (Copy(Argument,1,1)='-') Then Fail('Option non prise en charge: '+Argument)
   Else
  Begin
   If (OutputPath<>'') Or (InputPath='') Then Fail(
   'Usage: ffmpeg -i ENTREE [options] SORTIE');
   OutputPath:=Argument; OutputFormat:=PendingFormat; PendingFormat:='';
   If I<>ParamCount Then Fail('La sortie doit etre le dernier argument.');
  End;
  Inc(I);
 End;
 If ParamCount=0 Then Begin
  Help; Halt(1);
 End;
 If (InputPath='') Or (OutputPath='') Then Fail(
 'Une entree -i et une sortie sont requises.');
 If Overwrite And NoOverwrite Then Fail('-y et -n sont incompatibles.');
 If (InputPath='-') Or ((Pos('://',InputPath)>0) And Not IsHTTP(InputPath)) Then Fail(
 'Entree locale ou HLS HTTP/HTTPS requise.');
 If Lower(FExpand(InputPath))=Lower(FExpand(OutputPath)) Then Fail(
 'Entree et sortie doivent etre differentes.');
 If IsDirectory(OutputPath) Then Fail('La sortie designe un dossier.');
 If Exists(OutputPath) And Not Overwrite Then Fail('Sortie existante (utiliser -y): '+
 OutputPath);
 Intermediate:=InputPath;
 If IsHTTP(InputPath) Then Begin
  Temps[0]:=NewTemporary; DownloadHLS(InputPath,Temps[0]); Intermediate:=Temps[0];
  If HLSBase='' Then HLSBase:=LastDownloadURL;
 End;
 {$IFDEF TEST_WMA2}
 Temps[0]:=NewTemporary; DemuxASF(Intermediate,Temps[0]);
 Temps[2]:=NewTemporary; DecodeWMA2Spool(Temps[0],Temps[2]);
 Commit(Temps[2]); Temps[2]:=''; Halt(0);
 {$ENDIF}
 {$IFDEF TEST_ASF_PACKETS}
 Temps[2]:=NewTemporary; DemuxASF(Intermediate,Temps[2]);
 Commit(Temps[2]); Temps[2]:=''; Halt(0);
 {$ENDIF}
 Detected:=Probe(Intermediate);
 If InputFormat='' Then InputFormat:=Detected Else
 If InputFormat<>Detected Then Fail(
 'Format impose incompatible avec la signature du fichier.');
 If InputFormat='' Then Fail('Format entree non reconnu ou non pris en charge.');
 If OutputFormat='' Then OutputFormat:=FormatName(Extension(OutputPath));
 If (InputFormat='mp4') And ((OutputFormat='wav') Or (OutputFormat='adx') Or (OutputFormat='aiff') Or
  (OutputFormat='flv') Or (OutputFormat='mp3') Or (OutputFormat='ac3') Or ((OutputFormat='mp4') And (AudioCodec='alac'))) Then
  If Not IsHTTP(InputPath) Then If MP4HasALAC(InputPath) Then InputFormat:='alac';
 If InputCodec<>'' Then Begin
  If (InputFormat<>'ea') And (InputFormat<>'xa') Then
   Fail('Decodeur impose (-c:a avant -i): conteneurs ea et xa seulement.');
  If EACodecNumber(InputCodec)<0 Then
   Fail('Decodeur impose: adpcm_ea, adpcm_ea_maxis_xa, adpcm_ea_r1, adpcm_ea_r2, adpcm_ea_r3, adpcm_ea_xas, adpcm_ima_ea_eacs ou adpcm_ima_ea_sead.');
  If (InputFormat='xa') And (InputCodec<>'adpcm_ea_maxis_xa') Then
   Fail('Le conteneur xa exige le decodeur adpcm_ea_maxis_xa.');
 End;
 If (InputFormat='avi') And Not IsHTTP(InputPath) And ((OutputFormat='yuv4mpegpipe') Or (VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or
  (VideoCodec='mpeg2video') Or (VideoCodec='ffv1') Or (VideoCodec='flv') Or (VideoCodec='asv1') Or (VideoCodec='asv2') Or FourMV) Then Begin
  AsvTag:=AVIVideoFourCC(Intermediate);
  If (AsvTag='ASV1') Or (AsvTag='ASV2') Then Begin
   If NoVideo Or (VideoCodec='copy') Or (AudioCodec<>'') Or HasBitrate Or (RequestedRate<>0) Or
    (RequestedChannels<>0) Or (ImageWidth<>0) Or (VideoFrames<>0) Then
    Fail('asv: video locale decodee, sans copie ni conversion audio requise.');
   NoAudio:=True; Temps[6]:=NewTemporary; DecodeASVAVI(Intermediate,Temps[6]); Intermediate:=Temps[6];
   InputFormat:='yuv4mpegpipe'; DecodedVideo:=True;
  End;
 End;
 If (InputFormat='yuv4mpegpipe') And ((VideoCodec='asv1') Or (VideoCodec='asv2')) Then Begin
  If IsHTTP(InputPath) Or (OutputFormat<>'avi') Or NoVideo Or (AudioCodec<>'') Or HasBitrate Or HasVideoBitrate Or
   (RequestedRate<>0) Or (RequestedChannels<>0) Or (VideoFrames<>0) Or (ImageWidth<>0) Then
   Fail('asv: Y4M local vers sortie AVI requis, sans autres options.');
  If HasCrop Then Fail('asv: -crop non supporte avec cet encodeur.');
  Temps[2]:=NewTemporary; EncodeASV(Intermediate,Temps[2],VideoCodec='asv2');
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video ASV creee: ',OutputPath); Halt(0);
 End;
 If ((InputFormat='mp4') Or (InputFormat='avi')) And ((OutputFormat='yuv4mpegpipe') Or (VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or
  (VideoCodec='mpeg2video') Or (VideoCodec='ffv1') Or (VideoCodec='flv') Or FourMV) Then Begin
  If NoVideo Or (VideoCodec='copy') Or (AudioCodec<>'') Or HasBitrate Or (RequestedRate<>0) Or
   (RequestedChannels<>0) Or (ImageWidth<>0) Or (VideoFrames<>0) Or IsHTTP(InputPath) Then
   Fail('Decodage video local sans copie ni conversion audio requis.');
  NoAudio:=True; Temps[6]:=NewTemporary;
  RemuxVideo(Intermediate,Temps[6],InputFormat,'yuv4mpegpipe'); Intermediate:=Temps[6];
  InputFormat:='yuv4mpegpipe'; DecodedVideo:=True;
 End;
 If (InputFormat='4xm') And Not ((OutputFormat='wav') Or (OutputFormat='mp3') Or
  (OutputFormat='ac3') Or (OutputFormat='adx')) Then Begin
  If NoVideo Or (VideoCodec='copy') Or (AudioCodec<>'') Or HasBitrate Or (RequestedRate<>0) Or
   (RequestedChannels<>0) Or (ImageWidth<>0) Or (VideoFrames<>0) Or IsHTTP(InputPath) Then
   Fail('4xm: video locale decodee, sans copie ni conversion audio requise.');
  If Not ((OutputFormat='yuv4mpegpipe') Or (VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or
   (VideoCodec='mpeg2video') Or (VideoCodec='ffv1') Or (VideoCodec='flv') Or FourMV) Then
   Fail('4xm: sortie Y4M ou encodeur video natif requis.');
  Temps[6]:=NewTemporary; Decode4XM(Intermediate,Temps[6]); Intermediate:=Temps[6];
  InputFormat:='yuv4mpegpipe'; DecodedVideo:=True;
 End;
 If (InputFormat='amv') And Not ((OutputFormat='wav') Or (OutputFormat='mp3') Or (OutputFormat='ac3') Or
  (OutputFormat='adx') Or (OutputFormat='aiff') Or (OutputFormat='flv') Or ((OutputFormat='mp4') And (AudioCodec='alac'))) Then Begin
  If NoVideo Or (VideoCodec='copy') Or (AudioCodec<>'') Or HasBitrate Or (RequestedRate<>0) Or
   (RequestedChannels<>0) Or (ImageWidth<>0) Or (VideoFrames<>0) Or IsHTTP(InputPath) Then
   Fail('amv: video locale decodee, sans copie ni conversion audio requise.');
  If Not ((OutputFormat='yuv4mpegpipe') Or (VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or
   (VideoCodec='mpeg2video') Or (VideoCodec='ffv1') Or (VideoCodec='flv') Or FourMV) Then
   Fail('amv: sortie Y4M ou encodeur video natif requis.');
  Temps[6]:=NewTemporary; DecodeAMVVideo(Intermediate,Temps[6]); Intermediate:=Temps[6];
  InputFormat:='yuv4mpegpipe'; DecodedVideo:=True; NoAudio:=True;
 End;
 If InputFormat='avs' Then Begin
  If NoVideo Or (VideoCodec='copy') Or (AudioCodec<>'') Or HasBitrate Or (RequestedRate<>0) Or
   (RequestedChannels<>0) Or (ImageWidth<>0) Or IsHTTP(InputPath) Then
   Fail('avs: video locale decodee, sans copie ni conversion audio requise.');
  If (VideoCodec='png') Or (OutputFormat='png') Then Begin
   If VideoFrames<>1 Then Fail('avs: extraction PNG avec -frames:v 1 requise.');
   Temps[2]:=NewTemporary; DecodeAVS(Intermediate,Temps[2],True);
   Commit(Temps[2]); Temps[2]:=''; WriteLn('Image creee: ',OutputPath); Halt(0);
  End;
  If VideoFrames<>0 Then Fail('avs: -frames:v reserve a la sortie PNG.');
  If Not ((OutputFormat='yuv4mpegpipe') Or (VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or
   (VideoCodec='mpeg2video') Or (VideoCodec='ffv1') Or (VideoCodec='flv') Or FourMV) Then
   Fail('avs: sortie Y4M, PNG ou encodeur video natif requis.');
  Temps[6]:=NewTemporary; DecodeAVS(Intermediate,Temps[6],False); Intermediate:=Temps[6];
  InputFormat:='yuv4mpegpipe'; DecodedVideo:=True; NoAudio:=True;
 End;
 If HasCrop Then Begin
  If NoVideo Or (VideoCodec='copy') Or (AudioCodec='copy') Then Fail('Crop: decodage/reencodage requis; incompatible avec copy ou -vn.');
  If Not ((InputFormat='yuv4mpegpipe') Or
   ((OutputFormat='yuv4mpegpipe') And ((InputFormat='avi') Or (InputFormat='flv') Or (InputFormat='mpeg1video') Or (InputFormat='mpeg'))) Or
   ((InputFormat='flv') And ((VideoCodec='png') Or (VideoCodec='gif') Or (OutputFormat='png') Or (OutputFormat='gif') Or (OutputFormat='image2')))) Then
   Fail('Crop: Y4M, decodage natif vers Y4M ou extraction PNG/GIF depuis FLV requis.');
  If InputFormat='yuv4mpegpipe' Then Begin
