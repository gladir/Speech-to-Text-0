   $65,$68,$67,$CC,$CD,$D2,$D3,
  $D4,$D5,$D6,$D7,$D8,$D9,$DA,$DB,$98,$99,$9A,$18,$9B,$08,$0C,$0D,$12,$13,$14,
   $15,$16,$17,$1C,$1D,$1E,$1F);
 TFCcBitsB: Array[0..103] Of Byte=(
  $37,$02,$03,$02,$03,$03,$02,$03,$05,$04,$04,$05,$07,$04,$07,$18,$17,$18,$08,
   $67,$68,$6C,$37,$28,$17,$18,
