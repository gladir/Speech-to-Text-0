  3),(0,2));
 ASVAcCcp: Array[0..15,0..1] Of Byte=((0,2),(55,6),(5,4),(23,6),(2,3),(39,6),(
  15,6),(7,6),
 (6,3),(47,6),(1,4),(31,5),(9,4),(13,4),(11,4),(3,4));
 ASV2Level: Array[0..62,0..1] Of Word=(
 ($3F0,10),($3D0,10),($3B0,10),($390,10),($370,10),($350,10),($330,10),($310,
  10),($2F0,10)
 ,($2D0,10),
 ($2B0,10),($290,10),($270,10),($250,10),($230,10),($210,10),
 ($0F8,8),($0E8,8),($0D8,8),($0C8,8),($0B8,8),($0A8,8),($098,8),($088,8),
 ($03C,6),($034,6),($02C,6),($024,6),($00E,4),($00A,4),($003,2),($000,5),($001,
  2),($002,4)
 ,($006,4),
 ($004,6),($00C,6),($014,6),($01C,6),
 ($008,8),($018,8),($028,8),($038,8),($048,8),($058,8),($068,8),($078,8),
 ($010,10),($030,10),($050,10),($070,10),($090,10),($0B0,10),($0D0,10),($0F0,
  10),($110,10)
 ,($130,10),
 ($150,10),($170,10),($190,10),($1B0,10),($1D0,10),($1F0,10));
 ASVMat: Array[0..63] Of Byte=(
 8,16,19,22,26,27,29,34,16,16,22,24,27,29,34,37,19,22,26,27,29,34,34,38,22,22,
  26,27,29,34,
 37,40,
 22,26,27,29,32,35,40,48,26,27,29,32,35,40,48,58,26,27,29,34,38,46,56,69,27,29,
  35,38,46,
 56,69,83);

Var
 ASVBuf: PEABuffer;
 ASVSize,ASVBit: LongInt;
 ASVLE: Boolean;
 ASVIntra: Array[0..63] Of LongInt;

Function ASVGetBit: Integer;
Var
 P,W,Bb: LongInt;
Begin
 P:=ASVBit; Inc(ASVBit);
 If ASVLE Then Begin
  ASVGetBit:=(EAByte(ASVBuf,ASVSize,P Shr 3) Shr (P And 7)) And 1;
 End Else
 Begin
  W:=P Shr 5; Bb:=(P Shr 3) And 3;
  ASVGetBit:=(EAByte(ASVBuf,ASVSize,W*4+(3-Bb)) Shr (7-(P And 7))) And 1;
 End;
End;

Function ASVBits(N: Integer): LongInt;
Var
 V: LongInt;
 I: Integer;
Begin
 V:=0;
 If ASVLE Then Begin
  For I:=0 To N-1 Do V:=V Or (ASVGetBit Shl I);
 End
  Else
 For I:=1 To N Do V:=V*2+ASVGetBit;
 ASVBits:=V;
End;
{ Symbole VLC (indice dans la table). Tb: 0 ccp, 1 level1, 2 dc_ccp, 3 ac_ccp, 4
 level2. }

Function ASVVlc(Tb: Integer): Integer;
Var
 L,I,N,V,Save: LongInt;
 Code,Len: Integer;
 Found: Boolean;
Begin
 Case Tb Of 0: N:=17; 1: N:=7; 2: N:=8; 3: N:=16; Else N:=63;
End;
Save:=ASVBit; V:=0;
For L:=1 To 10 Do Begin
 If ASVLE Then V:=V Or (ASVGetBit Shl (L-1)) Else V:=V*2+ASVGetBit;
 For I:=0 To N-1 Do Begin
  Case Tb Of
  0:
  Begin
   Code:=ASVCcp[I,0]; Len:=ASVCcp[I,1];
  End;
  1:
  Begin
   Code:=ASVLevel[I,0]; Len:=ASVLevel[I,1];
  End;
  2:
  Begin
   Code:=ASVDcCcp[I,0]; Len:=ASVDcCcp[I,1];
  End;
  3:
  Begin
   Code:=ASVAcCcp[I,0]; Len:=ASVAcCcp[I,1];
  End;
   Else
  Begin
   Code:=ASV2Level[I,0]; Len:=ASV2Level[I,1];
  End;
 End;
 If (Len=L) And (Code=V) Then Begin
  ASVVlc:=I; Exit;
 End;
End;
End;
ASVBit:=Save; ASVVlc:=-1;
End;

Function ASVLevel1: LongInt;
Var
 C,V: LongInt;
Begin
 C:=ASVVlc(1);
 If C=3 Then Begin
  V:=ASVBits(8); If V>=128 Then Dec(V,256); ASVLevel1:=V;
 End Else ASVLevel1:=C-3;
End;

Function ASVLevel2: LongInt;
Var
 C,V: LongInt;
Begin
 C:=ASVVlc(4);
 If C=31 Then Begin
  V:=ASVBits(8); If V>=128 Then Dec(V,256); ASVLevel2:=V;
 End Else ASVLevel2:=C-31;
End;

Function ASVDecodeBlock(Var Blk: TAMVBlock; V2: Boolean): Boolean;
Var
 I,Ccp,Count,K: Integer;
Begin
 ASVDecodeBlock:=False; FillChar(Blk,SizeOf(Blk),0);
 If Not V2 Then Begin
  Blk[0]:=8*ASVBits(8);
  For I:=0 To 10 Do Begin
   Ccp:=ASVVlc(0);
   If Ccp<>0 Then Begin
    If Ccp=16 Then Break;
    If (Ccp<0) Or (I>=10) Then Exit;
    For K:=0 To 3 Do If (Ccp And (8 Shr K))<>0 Then     Blk[ASVScan[4*I+K]]:=
     ADPCMSar(
    ASVLevel1*ASVIntra[4*I+K],4);
   End;
  End;
 End Else
 Begin
  Count:=ASVBits(4); Blk[0]:=8*ASVBits(8);
  Ccp:=ASVVlc(2);
  If Ccp<0 Then Exit;
  If Ccp<>0 Then
  For K:=1 To 3 Do If (Ccp And (8 Shr K))<>0 Then    Blk[ASVScan[K]]:=ADPCMSar(
   ASVLevel2*
  ASVIntra[K],4);
  For I:=1 To Count Do Begin
   Ccp:=ASVVlc(3);
   If Ccp<0 Then Exit;
   If Ccp<>0 Then
   For K:=0 To 3 Do If (Ccp And (8 Shr K))<>0 Then     Blk[ASVScan[4*I+K]]:=
    ADPCMSar(
   ASVLevel2*ASVIntra[4*I+K],4);
  End;
 End;
 ASVDecodeBlock:=True;
End;

Procedure ASVInitMatrix(InvQ: LongInt; V2: Boolean);
Var
 I,Scale: LongInt;
Begin
 If V2 Then Scale:=2 Else Scale:=1;
 If InvQ=0 Then Begin
  If V2 Then InvQ:=10 Else InvQ:=6;
 End;
 For I:=0 To 63 Do ASVIntra[I]:=64*Scale*ASVMat[ASVScan[I]] Div InvQ;
End;
{ Decodage d'une image: Y,U,V = plans remplis (largeur Mw*16 / Mw*8). }

Function ASVDecodeFrame(P: PEABuffer; Size,W,H: LongInt; V2: Boolean;
                        Y,U,V: PEABuffer): Boolean;
Var
 Mw,Mh,Mw2,Mh2,MX,MY,B: LongInt;
 Blk: Array[0..5] Of TAMVBlock;

Function DoMB(X,Yy: LongInt): Boolean;
Var
 K: Integer;
Begin
 DoMB:=False;
 For K:=0 To 5 Do If Not ASVDecodeBlock(Blk[K],V2) Then Exit;
 AVIdctPut(Blk[0],@Y^[(Yy*16)*Mw*16+X*16],Mw*16);
 AVIdctPut(Blk[1],@Y^[(Yy*16)*Mw*16+X*16+8],Mw*16);
 AVIdctPut(Blk[2],@Y^[(Yy*16+8)*Mw*16+X*16],Mw*16);
 AVIdctPut(Blk[3],@Y^[(Yy*16+8)*Mw*16+X*16+8],Mw*16);
 AVIdctPut(Blk[4],@U^[(Yy*8)*Mw*8+X*8],Mw*8);
 AVIdctPut(Blk[5],@V^[(Yy*8)*Mw*8+X*8],Mw*8);
 DoMB:=True;
End;
Begin
 ASVDecodeFrame:=False;
 Mw:=(W+15) Div 16; Mh:=(H+15) Div 16; Mw2:=W Div 16; Mh2:=H Div 16;
 If Size*8<Mh*Mw*13 Then Exit;
 ASVBuf:=P; ASVSize:=Size; ASVBit:=0; ASVLE:=V2;
 For MY:=0 To Mh2-1 Do
 For MX:=0 To Mw2-1 Do If Not DoMB(MX,MY) Then Exit;
 If Mw2<>Mw Then
 For MY:=0 To Mh2-1 Do If Not DoMB(Mw2,MY) Then Exit;
 If Mh2<>Mh Then
 For MX:=0 To Mw-1 Do If Not DoMB(MX,Mh2) Then Exit;
 ASVDecodeFrame:=True;
End;
{ Lecture AVI minimale: renvoie les parametres du flux video et les blocs. }

Function AVIVideoFourCC(Const Name: String): String;
Var
 H: Array[0..15] Of Byte;
 Limit,Pos,Size,Streams: LongInt;
 Count: Integer;
 Tag: String[4];
 Found: Boolean;

Function T4: String;
Var
 S4: String[4];
 J: Integer;
Begin
 S4:='';
 For J:=0 To 3 Do S4:=S4+Chr(H[J]); T4:=S4;
End;
Begin
 AVIVideoFourCC:=''; OpenRead(Name); Limit:=InputSize; Found:=False;
 If Limit>=12 Then Begin
  ReadAt(0,H,12);
  If (T4='RIFF') And (H[8]=65) And (H[9]=86) And (H[10]=73) And (H[11]=32) Then
   Begin
   Pos:=12; Count:=0;
   While (Limit-Pos>=8) And (Count<200) And Not Found Do Begin
    ReadAt(Pos,H,8); Tag:=T4; Inc(Count);
    Size:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+LongInt(H[7])*
     16777216;
    If H[7]>=128 Then Break;
    If Tag='LIST' Then Begin
     ReadAt(Pos+8,H,4);
     If (H[0]=109) And (H[1]=111) And (H[2]=118) And (H[3]=105) Then Break;
     Inc(Pos,12);
    End Else
    Begin
     If (Tag='strh') And (Size>=8) And (Limit-Pos>=24) Then Begin
      ReadAt(Pos+8,H,8);
      If (H[0]=118) And (H[1]=105) And (H[2]=100) And (H[3]=115) Then Begin
       AVIVideoFourCC:=Chr(H[4])+Chr(H[5])+Chr(H[6])+Chr(H[7]); Found:=True;
      End;
     End;
     Inc(Pos,8+Size+(Size And 1));
    End;
   End;
  End;
 End;
 Streams:=0; CloseRead;
End;

Procedure DecodeASVAVI(Const Source,Target: String);
Var
 H: Array[0..63] Of Byte;
 Limit,Pos,Size,W,Hh,Rate,Scale,InvQ,Frames,I,Take,Row,Mw,Mh,CW,CH: LongInt;
 Y,U,V,Buf: PEABuffer;
 V2,InMovie,Opened,HaveStrf: Boolean;
 Tag: String[4];
 Hdr,S: String;
 Vids: Boolean;
 Count: Integer;
 RN,RD: LongInt;

Function T4: String;
Var
 S4: String[4];
 J: Integer;
Begin
 S4:='';
 For J:=0 To 3 Do S4:=S4+Chr(H[J]); T4:=S4;
End;
Begin
 OpenRead(Source); Limit:=InputSize; ReadAt(0,H,12);
 Pos:=12; Rate:=0; Scale:=1; InvQ:=0; W:=0; Hh:=0; InMovie:=False; Vids:=False;
  V2:=False;
 HaveStrf:=False; Count:=0;
 While (Limit-Pos>=8) And Not InMovie And (Count<500) Do Begin
  ReadAt(Pos,H,8); Tag:=T4; Inc(Count);
  Size:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+LongInt(H[7])*
   16777216;
  If H[7]>=128 Then Fail('asv: taille de bloc excessive.');
  If Tag='LIST' Then Begin
   ReadAt(Pos+8,H,4);
   If (H[0]=109) And (H[1]=111) And (H[2]=118) And (H[3]=105) Then InMovie:=
    True;
   Inc(Pos,12);
  End Else
  Begin
   If (Tag='strh') And (Size>=28) And (Limit-Pos>=36) And Not HaveStrf Then
    Begin
    ReadAt(Pos+8,H,28);
    Vids:=(H[0]=118) And (H[1]=105) And (H[2]=100) And (H[3]=115);
    V2:=(H[4]=65) And (H[5]=83) And (H[6]=86) And (H[7]=50);
    Scale:=LongInt(H[20])+LongInt(H[21])*256+LongInt(H[22])*65536;
    Rate:=LongInt(H[24])+LongInt(H[25])*256+LongInt(H[26])*65536;
   End Else If (Tag='strf') And Vids And Not HaveStrf And (Size>=44) And (Limit-
    Pos>=8+
   Size) Then Begin
    ReadAt(Pos+8,H,44);
    W:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536;
    Hh:=LongInt(H[8])+LongInt(H[9])*256+LongInt(H[10])*65536;
    InvQ:=H[40]; HaveStrf:=True;
   End;
   Inc(Pos,8+Size+(Size And 1));
  End;
 End;
 If Not InMovie Or Not HaveStrf Then Fail('asv: flux video AVI introuvable.');
 If (W<16) Or (W>4096) Or (Hh<16) Or (Hh>4096) Then Fail(
  'asv: dimensions incorrectes.');
 If (Rate<=0) Or (Scale<=0) Then Begin
  Rate:=25; Scale:=1;
 End;
 ASVInitMatrix(InvQ,V2);
 Mw:=(W+15) Div 16; Mh:=(Hh+15) Div 16; CW:=(W+1) Div 2; CH:=(Hh+1) Div 2;
 GetMem(Y,Mw*16*Mh*16); GetMem(U,Mw*8*Mh*8); GetMem(V,Mw*8*Mh*8);
 FillChar(Y^,Mw*16*Mh*16,0); FillChar(U^,Mw*8*Mh*8,0); FillChar(V^,Mw*8*Mh*8,0);
 I:=Rate; Take:=Scale;
 While Take<>0 Do Begin
  Row:=I Mod Take; I:=Take; Take:=Row;
 End;
 RN:=Rate Div I; RD:=Scale Div I; Opened:=False; Frames:=0;
 While Limit-Pos>=8 Do Begin
  ReadAt(Pos,H,8); Tag:=T4;
  If H[7]>=128 Then Break;
  Size:=LongInt(H[4])+LongInt(H[5])*256+LongInt(H[6])*65536+LongInt(H[7])*
   16777216;
  If Tag='LIST' Then Begin
   Inc(Pos,12); Continue;
  End;
  If Size>Limit-Pos-8 Then Size:=Limit-Pos-8;
  If (H[0]=48) And (H[1]=48) And ((H[2]=100) Or (H[2]=119)) And ((H[3]=99) Or (
   H[3]=98))
  And (Size>0) Then Begin
   GetMem(Buf,Size); I:=0;
   While I<Size Do Begin
    If Size-I>16384 Then Take:=16384 Else Take:=Size-I;
    ReadAt(Pos+8+I,Buf^[I],Take); Inc(I,Take);
   End;
   If ASVDecodeFrame(Buf,Size,W,Hh,V2,Y,U,V) Then Begin
    If Not Opened Then Begin
     OpenWrite(Target); Opened:=True;
     Str(W,S); Hdr:='YUV4MPEG2 W'+S; Str(Hh,S); Hdr:=Hdr+' H'+S;
     Str(RN,S); Hdr:=Hdr+' F'+S; Str(RD,S); Hdr:=Hdr+':'+S+' Ip A1:1 C420jpeg'+
      #10;
     WriteBytes(Hdr[1],Length(Hdr));
    End;
    Hdr:='FRAME'+#10; WriteBytes(Hdr[1],Length(Hdr));
    For Row:=0 To Hh-1 Do WriteBytes(Y^[Row*Mw*16],W);
    For Row:=0 To CH-1 Do WriteBytes(U^[Row*Mw*8],CW);
    For Row:=0 To CH-1 Do WriteBytes(V^[Row*Mw*8],CW);
    Inc(Frames);
   End;
   FreeMem(Buf,Size);
  End;
  Inc(Pos,8+Size+(Size And 1));
 End;
 FreeMem(Y,Mw*16*Mh*16); FreeMem(U,Mw*8*Mh*8); FreeMem(V,Mw*8*Mh*8);
 If Frames=0 Then Fail('asv: aucune image video decodee.');
 CloseRead; CloseWrite;
End;
{ ---- Encodeur ---- }

Var
 ASVOut: PEABuffer;
 ASVOBit: LongInt;
 ASVQ: Array[0..63] Of LongInt;

Procedure ASVPutBE(N: Integer; V: Int64);
Var
 K: Integer;
Begin
 For K:=N-1 Downto 0 Do Begin
  If ((V Shr K) And 1)<>0 Then ASVOut^[ASVOBit Shr 3]:=ASVOut^[ASVOBit Shr 3] Or
   (
  128 Shr (ASVOBit And 7));
  Inc(ASVOBit);
 End;
End;

Procedure ASVPutLE(N: Integer; V: Int64);
Var
 K: Integer;
Begin
 For K:=0 To N-1 Do Begin
  If ((V Shr K) And 1)<>0 Then ASVOut^[ASVOBit Shr 3]:=ASVOut^[ASVOBit Shr 3] Or
   (1 Shl (
  ASVOBit And 7));
  Inc(ASVOBit);
 End;
End;

Procedure ASVFdct(Var D: TAMVBlock);
Const
 F0541=4433;
 F0765=6270;
 F1847=15137;
 F1175=9633;
 F0298=2446;
 F2053=16819;
 F3072=25172;
 F1501=12299;
 F0899=7373;
 F2562=20995;
 F1961=16069;
 F0390=3196;
Var
 I: Integer;
 T0,T1,T2,T3,T4,T5,T6,T7,T10,T11,T12,T13,Z1,Z2,Z3,Z4,Z5: Int64;

Function Ds(X: Int64; N: Integer): Int64;Begin
 Ds:=AVSar(X+(Int64(1) Shl (N-1)),N);
End;
Begin
 For I:=0 To 7 Do Begin
  T0:=D[I*8]+D[I*8+7]; T7:=D[I*8]-D[I*8+7]; T1:=D[I*8+1]+D[I*8+6]; T6:=D[I*8+1]-
   D[I*8+6];
  T2:=D[I*8+2]+D[I*8+5]; T5:=D[I*8+2]-D[I*8+5]; T3:=D[I*8+3]+D[I*8+4];
  T4:=D[I*8+3]-D[I*8+4];
  T10:=T0+T3; T13:=T0-T3; T11:=T1+T2; T12:=T1-T2;
  D[I*8]:=(T10+T11)*16; D[I*8+4]:=(T10-T11)*16;
  Z1:=(T12+T13)*F0541;
  D[I*8+2]:=Ds(Z1+T13*F0765,9); D[I*8+6]:=Ds(Z1+T12*(-F1847),9);
  Z1:=T4+T7; Z2:=T5+T6; Z3:=T4+T6; Z4:=T5+T7; Z5:=(Z3+Z4)*F1175;
  T4:=T4*F0298; T5:=T5*F2053; T6:=T6*F3072; T7:=T7*F1501;
  Z1:=Z1*(-F0899); Z2:=Z2*(-F2562); Z3:=Z3*(-F1961); Z4:=Z4*(-F0390);
  Inc(Z3,Z5); Inc(Z4,Z5);
  D[I*8+7]:=Ds(T4+Z1+Z3,9); D[I*8+5]:=Ds(T5+Z2+Z4,9); D[I*8+3]:=Ds(T6+Z2+Z3,9);
  D[I*8+1]:=Ds(T7+Z1+Z4,9);
 End;
 For I:=0 To 7 Do Begin
  T0:=D[I]+D[56+I]; T7:=D[I]-D[56+I]; T1:=D[8+I]+D[48+I]; T6:=D[8+I]-D[48+I];
  T2:=D[16+I]+D[40+I]; T5:=D[16+I]-D[40+I]; T3:=D[24+I]+D[32+I]; T4:=D[24+I]-D[
   32+I];
  T10:=T0+T3; T13:=T0-T3; T11:=T1+T2; T12:=T1-T2;
  D[I]:=Ds(T10+T11,4); D[32+I]:=Ds(T10-T11,4);
  Z1:=(T12+T13)*F0541;
  D[16+I]:=Ds(Z1+T13*F0765,17); D[48+I]:=Ds(Z1+T12*(-F1847),17);
  Z1:=T4+T7; Z2:=T5+T6; Z3:=T4+T6; Z4:=T5+T7; Z5:=(Z3+Z4)*F1175;
  T4:=T4*F0298; T5:=T5*F2053; T6:=T6*F3072; T7:=T7*F1501;
  Z1:=Z1*(-F0899); Z2:=Z2*(-F2562); Z3:=Z3*(-F1961); Z4:=Z4*(-F0390);
  Inc(Z3,Z5); Inc(Z4,Z5);
  D[56+I]:=Ds(T4+Z1+Z3,17); D[40+I]:=Ds(T5+Z2+Z4,17); D[24+I]:=Ds(T6+Z2+Z3,17);
  D[8+I]:=Ds(T7+Z1+Z4,17);
 End;
End;

Procedure ASVPutLevel1(L: LongInt);Begin
 If (L+3>=0) And (L+3<=6) Then ASVPutBE(ASVLevel[L+3,1],ASVLevel[L+3,0])
                          Else ASVPutBE(11,L And 255);
End;

Procedure ASVPutLevel2(L: LongInt);Begin
 If (L+31>=0) And (L+31<=62) Then ASVPutLE(ASV2Level[L+31,1],ASV2Level[L+31,0])
  Else
 Begin
  If L<-128 Then L:=-128; If L>127 Then L:=127;
  ASVPutLE(13,(L And 255) Shl 5);
 End;
End;

Function ASVQuant(Var D: TAMVBlock; K: Integer): Integer;
Var
 V: Int64;
Begin
 V:=AVSar(Int64(D[K])*ASVQ[K]+32768,16); D[K]:=V; ASVQuant:=D[K];
End;

Procedure ASVEncodeBlock(Var D: TAMVBlock; V2: Boolean);
Var
 I,Index,Ccp,Count,NcBits,NcVal: LongInt;
 V: Int64;
Begin
 If Not V2 Then Begin
  ASVPutBE(8,AVSar(D[0]+32,6) And 255); D[0]:=0; NcBits:=0; NcVal:=0;
  For I:=0 To 9 Do Begin
   Index:=ASVScan[4*I]; Ccp:=0;
   If ASVQuant(D,Index)<>0 Then Ccp:=Ccp Or 8;
   If ASVQuant(D,Index+8)<>0 Then Ccp:=Ccp Or 4;
   If ASVQuant(D,Index+1)<>0 Then Ccp:=Ccp Or 2;
   If ASVQuant(D,Index+9)<>0 Then Ccp:=Ccp Or 1;
   If Ccp<>0 Then Begin
    ASVPutBE(NcBits+ASVCcp[Ccp,1],(Int64(NcVal) Shl ASVCcp[Ccp,1]) Or ASVCcp[
     Ccp,0]);
    NcBits:=0; NcVal:=0;
    If (Ccp And 8)<>0 Then ASVPutLevel1(D[Index]);
    If (Ccp And 4)<>0 Then ASVPutLevel1(D[Index+8]);
    If (Ccp And 2)<>0 Then ASVPutLevel1(D[Index+1]);
    If (Ccp And 1)<>0 Then ASVPutLevel1(D[Index+9]);
   End Else
   Begin
    Inc(NcBits,2); NcVal:=(NcVal Shl 2) Or 2;
   End;
  End;
  ASVPutBE(5,15);
 End Else
 Begin
  Count:=63;
  While Count>3 Do Begin
   Index:=ASVScan[Count];
   V:=AVSar(Int64(D[Index])*ASVQ[Index]+32768,16);
   If V<>0 Then Break;
   Dec(Count);
  End;
  Count:=Count Shr 2;
  ASVPutLE(12,Count Or ((AVSar(D[0]+32,6) And 255) Shl 4)); D[0]:=0;
  For I:=0 To Count Do Begin
   Index:=ASVScan[4*I]; Ccp:=0;
   If ASVQuant(D,Index)<>0 Then Ccp:=Ccp Or 8;
   If ASVQuant(D,Index+8)<>0 Then Ccp:=Ccp Or 4;
   If ASVQuant(D,Index+1)<>0 Then Ccp:=Ccp Or 2;
   If ASVQuant(D,Index+9)<>0 Then Ccp:=Ccp Or 1;
   If I>0 Then ASVPutLE(ASVAcCcp[Ccp,1],ASVAcCcp[Ccp,0]) Else ASVPutLE(ASVDcCcp[
    Ccp,1],
   ASVDcCcp[Ccp,0]);
   If Ccp<>0 Then Begin
    If (Ccp And 8)<>0 Then ASVPutLevel2(D[Index]);
    If (Ccp And 4)<>0 Then ASVPutLevel2(D[Index+8]);
    If (Ccp And 2)<>0 Then ASVPutLevel2(D[Index+1]);
    If (Ccp And 1)<>0 Then ASVPutLevel2(D[Index+9]);
   End;
  End;
 End;
End;

Procedure EncodeASV(Const Source,Target: String; V2: Boolean);
Var
 H: Array[0..255] Of Byte;
 Limit,Cur,W,Hh,FN,FD,Frames,I,K,Mw,Mh,Mw2,Mh2,MX,MY,CW,CH,FrameBytes,Size,Row,
  Col,InvQ,
 Scale,Q,OutPos,Fix: LongInt;
 Y,U,V,Pk: PEABuffer;
 Line,Token: String;
 Blk: Array[0..5] Of TAMVBlock;
 Code: Integer;
 Sizes: PALLong;
 Out: Array[0..255] Of Byte;
 Used: Integer;

Procedure PutB(X: LongInt);Begin
 Out[Used]:=X And 255; Inc(Used); Inc(OutPos); If Used>=250 Then Begin
  WriteBytes(Out,Used); Used:=0;
 End;
End;

Procedure PutL16(X: LongInt);Begin
 PutB(X); PutB(X Shr 8);
End;

Procedure PutL32(X: LongInt);Begin
 PutL16(X); PutL16(X Shr 16);
End;

Procedure PutTag(Const T: String);
Var
 Z: Integer;
Begin
 For Z:=1 To 4 Do PutB(Ord(T[Z]));
End;

Procedure Flush;Begin
 If Used>0 Then Begin
  WriteBytes(Out,Used); Used:=0;
 End;
End;

Procedure Patch32(At,Value: LongInt);
Var
 Z: Integer;
 Code2: Integer;
 B4: Array[0..3] Of Byte;
Begin
 Flush;
 {$I-}Seek(ActiveOutput,At); Code2:=IOResult;{$I+}
 If Code2<>0 Then Fail('asv: positionnement AVI impossible.');
 For Z:=0 To 3 Do Begin
  B4[Z]:=Value And 255; Value:=Value Shr 8;
 End;
 WriteBytes(B4,4);
End;

Procedure GetPixels(Var B: TAMVBlock; Plane: PEABuffer; Stride,X0,Y0: LongInt);
Var
 A,C: Integer;
Begin
 For A:=0 To 7 Do
 For C:=0 To 7 Do B[A*8+C]:=Plane^[(Y0+A)*Stride+X0+C];
End;

Procedure EncodeMB;
Var
 Z: Integer;
Begin
 For Z:=0 To 5 Do ASVEncodeBlock(Blk[Z],V2);
End;
{ MB partiel: X0,Y0 en pixels luma; VW,VH pixels valides }

Procedure Partial(X0,Y0,VW,VH: LongInt);
Const
 Desc: Array[0..5,0..3] Of Byte=((0,0,0,0),(8,0,0,0),(0,8,0,0),(8,8,0,0),(0,0,1,
  1),(0,0,2,
 1));
Var
 Z,WA,HA,A,C,Stride,PX,PY,Last: LongInt;
 Plane: PEABuffer;
Begin
 For Z:=0 To 5 Do Begin
  If Desc[Z,3]=0 Then Begin
   WA:=VW-Desc[Z,0]; HA:=VH-Desc[Z,1];
  End
   Else
  Begin
   WA:=(VW+1) Div 2-Desc[Z,0]; HA:=(VH+1) Div 2-Desc[Z,1];
  End;
  If (WA<=0) Or (HA<=0) Then Begin
   FillChar(Blk[Z],SizeOf(Blk[Z]),0); Continue;
  End;
  If WA>8 Then WA:=8; If HA>8 Then HA:=8;
  Case Desc[Z,2] Of
  0:
  Begin
   Plane:=Y; Stride:=W; PX:=X0; PY:=Y0;
  End;
  1:
  Begin
   Plane:=U; Stride:=CW; PX:=X0 Div 2; PY:=Y0 Div 2;
  End;
   Else
  Begin
   Plane:=V; Stride:=CW; PX:=X0 Div 2; PY:=Y0 Div 2;
  End;
 End;
 Inc(PX,Desc[Z,0]); Inc(PY,Desc[Z,1]);
 For A:=0 To 7 Do Begin
  If A<HA Then Begin
   For C:=0 To WA-1 Do Blk[Z][A*8+C]:=Plane^[(PY+A)*Stride+PX+C];
   Last:=Blk[Z][A*8+WA-1];
   For C:=WA To 7 Do Blk[Z][A*8+C]:=Last;
  End Else
  For C:=0 To 7 Do Blk[Z][A*8+C]:=Blk[Z][(HA-1)*8+C];
 End;
 ASVFdct(Blk[Z]);
End;
EncodeMB;
End;

Function ReadLine: String;
Var
 R: String;
Begin
 R:='';
 While Cur<Limit Do Begin
  ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break; If Length(R)<250 Then R:=R+
   Chr(H[0]);
 End;
 ReadLine:=R;
End;

Procedure ReadPlane(Plane: PEABuffer; At,Count: LongInt);
Var
 N: LongInt;
Begin
 N:=0;
 While N<Count Do Begin
  If Count-N>4096 Then Q:=4096 Else Q:=Count-N;
  ReadAt(At+N,Plane^[N],Q); Inc(N,Q);
 End;
End;
Begin
 OpenRead(Source); Limit:=InputSize; Cur:=0;
 Line:=ReadLine;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('asv: entree Y4M requise.');
 W:=0; Hh:=0; FN:=25; FD:=1;
 Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
  'W': Val(Copy(Token,2,20),W,Code);
  'H': Val(Copy(Token,2,20),Hh,Code);
  'F':
  Begin
   K:=Pos(':',Token); If K>0 Then Begin
    Val(Copy(Token,2,K-2),FN,Code); Val(Copy(Token,K+1,20),FD,Code);
   End;
  End;
  'C': If (Token<>'C420') And (Token<>'C420jpeg') And (Token<>'C420mpeg2') And (
   Token<>
  'C420paldv') Then Fail('asv: Y4M YUV420 8 bits requis.');
  'I': If Token<>'Ip' Then Fail('asv: video progressive requise.');
 End;
End;
If (W<2) Or (Hh<2) Or (W>4096) Or (Hh>4096) Then Fail(
 'asv: dimensions Y4M incorrectes.');
If (FN<=0) Or (FD<=0) Then Begin
 FN:=25; FD:=1;
End;
CW:=(W+1) Div 2; CH:=(Hh+1) Div 2; FrameBytes:=W*Hh+2*CW*CH;
Mw:=(W+15) Div 16; Mh:=(Hh+15) Div 16; Mw2:=W Div 16; Mh2:=Hh Div 16;
If V2 Then Scale:=2 Else Scale:=1;
InvQ:=(32*Scale*118+472 Div 2) Div 472;
For I:=0 To 63 Do Begin
 Q:=32*Scale*ASVMat[I]; ASVQ[I]:=((InvQ Shl 16)+Q Div 2) Div Q;
End;
GetMem(Y,W*Hh); GetMem(U,CW*CH); GetMem(V,CW*CH);
Size:=Mh*Mw*720+64; GetMem(Pk,Size); GetMem(Sizes,1048576*4);
Frames:=0; OutPos:=0; Used:=0;
OpenWrite(Target);
PutTag('RIFF'); PutL32(0); PutTag('AVI '); PutTag('LIST'); PutL32(200); PutTag(
 'hdrl');
PutTag('avih'); PutL32(56); PutL32(Round(1000000.0*FD/FN)); PutL32(0); PutL32(
 0);
PutL32($10); PutL32(0); PutL32(0); PutL32(1);
PutL32(Size); PutL32(W); PutL32(Hh); PutL32(0); PutL32(0); PutL32(0); PutL32(0);
PutTag('LIST'); PutL32(124); PutTag('strl');
PutTag('strh'); PutL32(56); PutTag('vids'); If V2 Then PutTag('ASV2') Else
 PutTag('ASV1');
PutL32(0); PutL16(0); PutL16(0); PutL32(0); PutL32(FD); PutL32(FN); PutL32(0);
 PutL32(0);
PutL32(Size); PutL32(-1); PutL32(0);
PutL16(0); PutL16(0); PutL16(W); PutL16(Hh);
PutTag('strf'); PutL32(48); PutL32(48); PutL32(W); PutL32(Hh); PutL16(1);
 PutL16(24);
If V2 Then PutTag('ASV2') Else PutTag('ASV1');
PutL32(Size); PutL32(0); PutL32(0); PutL32(0); PutL32(0);
PutL32(InvQ); PutTag('ASUS');
PutTag('LIST'); PutL32(0); PutTag('movi'); Flush;
While Cur<Limit Do Begin
 Line:=ReadLine;
 If Copy(Line,1,5)<>'FRAME' Then Fail('asv: marqueur FRAME requis.');
 If FrameBytes>Limit-Cur Then Break;
 ReadPlane(Y,Cur,W*Hh); ReadPlane(U,Cur+W*Hh,CW*CH); ReadPlane(V,Cur+W*Hh+CW*CH,
  CW*CH);
 Inc(Cur,FrameBytes);
 ASVOut:=Pk; ASVOBit:=0; FillChar(Pk^,Size,0);
 For MY:=0 To Mh2-1 Do
 For MX:=0 To Mw2-1 Do Begin
  GetPixels(Blk[0],Y,W,MX*16,MY*16); GetPixels(Blk[1],Y,W,MX*16+8,MY*16);
  GetPixels(Blk[2],Y,W,MX*16,MY*16+8); GetPixels(Blk[3],Y,W,MX*16+8,MY*16+8);
  For K:=0 To 3 Do ASVFdct(Blk[K]);
  GetPixels(Blk[4],U,CW,MX*8,MY*8); GetPixels(Blk[5],V,CW,MX*8,MY*8);
  ASVFdct(Blk[4]); ASVFdct(Blk[5]);
  EncodeMB;
 End;
 If (W And 15)<>0 Then
 For MY:=0 To Mh2-1 Do Partial(Mw2*16,MY*16,W And 15,16);
 If (Hh And 15)<>0 Then Begin
  Col:=W; MX:=0;
  Repeat
  Partial(MX*16,Mh2*16,Col,Hh And 15);
  If Col<=16 Then Break;
  Dec(Col,16); Inc(MX);
  Until False;
 End;
 K:=((ASVOBit+7) Div 8+3) Div 4;
 If Not V2 Then
 For Row:=0 To K-1 Do Begin
  Q:=Pk^[Row*4]; Pk^[Row*4]:=Pk^[Row*4+3]; Pk^[Row*4+3]:=Q;
  Q:=Pk^[Row*4+1]; Pk^[Row*4+1]:=Pk^[Row*4+2]; Pk^[Row*4+2]:=Q;
 End;
 Sizes^[Frames]:=K*4;
 PutTag('00dc'); PutL32(K*4); Flush; WriteBytes(Pk^,K*4); Inc(OutPos,K*4);
 Inc(Frames);
 If Frames>=1048576 Then Break;
End;
If Frames=0 Then Fail('asv: aucune image Y4M.');
Fix:=OutPos;
PutTag('idx1'); PutL32(16*Frames); K:=4;
For I:=0 To Frames-1 Do Begin
 PutTag('00dc'); PutL32($10); PutL32(K); PutL32(Sizes^[I]); Inc(K,8+Sizes^[I]);
End;
Flush;
Patch32(4,OutPos-8); Patch32(224,Fix-228); Patch32(48,Frames); Patch32(140,
 Frames);
FreeMem(Y,W*Hh); FreeMem(U,CW*CH); FreeMem(V,CW*CH); FreeMem(Pk,Size);
FreeMem(Sizes,1048576*4);
CloseRead; CloseWrite;
End;
{ MJENC-BEGIN }
{ ---- Encodeur MJPEG (libavcodec/mjpegenc.c, mjpegenc_common.c,
 mjpegenc_huffman.c, mpegvideo_enc.c) :
  Y4M 4:2:0/4:2:2/4:4:4 vers .jpg ou AVI MJPG, qualite fixe (-q:v), tables de
   Huffman optimales ---- }
Type
 TMJEP2=Record A,B: LongInt; End;
 TMJEArr=Array[0..1023] Of TMJEP2;
 TMJEPkg=Record N: LongInt; Idx: Array[0..515] Of LongInt; Prob: Array[0..513]
  Of LongInt; Items: Array[0..4111] Of LongInt; End;
 TMJEHuge=Array[0..800000000] Of SmallInt;
Const
 MJEIntra: Array[0..63] Of Byte=(
  8,16,19,22,26,27,29,34,16,16,22,24,27,29,34,37,19,22,26,27,29,34,34,38,22,22,
   26,27,29,34,37,40,
  22,26,27,29,32,35,40,48,26,27,29,32,35,40,48,58,26,27,29,34,38,46,56,69,27,29,
   35,38,46,56,69,83);
Var
 MJEA,MJED: TMJEArr;
 MJEList: Array[0..1] Of TMJEPkg;
 MJEBits: Array[0..3,0..16] Of Byte; MJEVal: Array[0..3,0..255] Of Byte; MJECnt:
  Array[0..3,0..255] Of LongInt;
 MJESize: Array[0..3,0..255] Of Byte; MJECode: Array[0..3,0..255] Of Word;
 MJEMat,MJEQmat: Array[0..63] Of LongInt;
 MJEOut: PEABuffer; MJEPos: LongInt; MJEAcc: Int64; MJEAccN: LongInt;
 MJEHT,MJEHC: PEABuffer; MJEHM: ^TMJEHuge; MJENc: LongInt; MJEOptimal: Boolean;

Function MJECmp(X,Y: LongInt): LongInt;
Begin MJECmp:=MJEA[X].B-MJEA[Y].B; End;
Procedure MJESwap(X,Y: LongInt);
Var T: TMJEP2;
Begin T:=MJEA[X]; MJEA[X]:=MJEA[Y]; MJEA[Y]:=T; End;
{ AV_QSORT de libavutil/qsort.h, cle = champ B }
Procedure MJEQSort(Num: LongInt);
Var
 StkA,StkB: Array[0..63] Of LongInt; Sp,Start,Fin,Left,Right,Mid: LongInt;
  CheckSort: Boolean;
Begin
 If Num<2 Then Exit;
 Sp:=1; StkA[0]:=0; StkB[0]:=Num-1;
 While Sp>0 Do Begin
  Dec(Sp); Start:=StkA[Sp]; Fin:=StkB[Sp];
  While Start<Fin Do Begin
   If Start<Fin-1 Then Begin
    CheckSort:=False; Right:=Fin-2; Left:=Start+1; Mid:=Start+((Fin-Start) Shr
     1);
    If MJECmp(Start,Fin)>0 Then Begin
     If MJECmp(Fin,Mid)>0 Then MJESwap(Start,Mid) Else MJESwap(Start,Fin);
    End Else Begin
     If MJECmp(Start,Mid)>0 Then MJESwap(Start,Mid) Else CheckSort:=True;
    End;
    If MJECmp(Mid,Fin)>0 Then Begin MJESwap(Mid,Fin); CheckSort:=False; End;
    If Start=Fin-2 Then Break;
    MJESwap(Fin-1,Mid);
    While Left<=Right Do Begin
     While (Left<=Right) And (MJECmp(Left,Fin-1)<0) Do Inc(Left);
     While (Left<=Right) And (MJECmp(Right,Fin-1)>0) Do Dec(Right);
     If Left<=Right Then Begin MJESwap(Left,Right); Inc(Left); Dec(Right); End;
    End;
    MJESwap(Fin-1,Left);
    If CheckSort And ((Mid=Left-1) Or (Mid=Left)) Then Begin
     Mid:=Start;
     While (Mid<Fin) And (MJECmp(Mid,Mid+1)<=0) Do Inc(Mid);
     If Mid=Fin Then Break;
    End;
    If Fin-Left<Left-Start Then Begin
     StkA[Sp]:=Start; StkB[Sp]:=Right; Inc(Sp); Start:=Left+1;
    End Else Begin
     StkA[Sp]:=Left+1; StkB[Sp]:=Fin; Inc(Sp); Fin:=Right;
    End;
   End Else Begin
    If MJECmp(Start,Fin)>0 Then MJESwap(Start,Fin);
    Break;
   End;
  End;
 End;
End;

{ ff_mjpegenc_huffman_compute_bits : MJEA[0..Size-1] (A=valeur, B=occurrences)
 -> MJED, renvoie le nombre de symboles }
Function MJEComputeBits(Size,MaxLen: LongInt): LongInt;
Var To_,From_,Times,I,J,K,Mn,N2: LongInt; NBits: Array[0..256] Of LongInt;
Begin
 FillChar(NBits,SizeOf(NBits),0);
 MJEList[0].N:=0; MJEList[1].N:=0; MJEList[0].Idx[0]:=0; MJEList[1].Idx[0]:=0;
 To_:=0; From_:=1; I:=0;
 MJEQSort(Size);
 For Times:=0 To MaxLen Do Begin
  MJEList[To_].N:=0; MJEList[To_].Idx[0]:=0;
  J:=0;
  If Times<MaxLen Then I:=0;
  While (I<Size) Or (J+1<MJEList[From_].N) Do Begin
   Inc(MJEList[To_].N); N2:=MJEList[To_].N;
   MJEList[To_].Idx[N2]:=MJEList[To_].Idx[N2-1];
   If (I<Size) And ((J+1>=MJEList[From_].N) Or (MJEA[I].B<MJEList[From_].Prob[
    J]+MJEList[From_].Prob[J+1])) Then Begin
    MJEList[To_].Items[MJEList[To_].Idx[N2]]:=MJEA[I].A; Inc(MJEList[To_].Idx[
     N2]);
    MJEList[To_].Prob[N2-1]:=MJEA[I].B; Inc(I);
   End Else Begin
    For K:=MJEList[From_].Idx[J] To MJEList[From_].Idx[J+2]-1 Do Begin
     MJEList[To_].Items[MJEList[To_].Idx[N2]]:=MJEList[From_].Items[K]; Inc(
      MJEList[To_].Idx[N2]);
    End;
    MJEList[To_].Prob[N2-1]:=MJEList[From_].Prob[J]+MJEList[From_].Prob[J+1];
    Inc(J,2);
   End;
  End;
  K:=To_; To_:=From_; From_:=K;
 End;
 If Size-1<MJEList[From_].N Then Mn:=Size-1 Else Mn:=MJEList[From_].N;
 For I:=0 To MJEList[From_].Idx[Mn]-1 Do Inc(NBits[MJEList[From_].Items[I]]);
 J:=0;
 For I:=0 To 255 Do If NBits[I]>0 Then Begin MJED[J].A:=I; MJED[J].B:=NBits[I];
  Inc(J); End;
 MJEComputeBits:=J;
End;

{ ff_mjpeg_encode_huffman_close pour la table T }
Procedure MJEClose(T: LongInt);
Var I,J,Nval: LongInt;
Begin
 Nval:=0; For I:=0 To 255 Do If MJECnt[T,I]<>0 Then Inc(Nval);
 J:=0;
 For I:=0 To 255 Do If MJECnt[T,I]<>0 Then Begin MJEA[J].A:=I; MJEA[J].B:=
  MJECnt[T,I]; Inc(J); End;
 MJEA[J].A:=256; MJEA[J].B:=0;
 MJEComputeBits(Nval+1,16);
 For I:=0 To Nval-1 Do MJEA[I]:=MJED[I];
 MJEQSort(Nval);
 FillChar(MJEBits[T],17,0);
 For I:=0 To Nval-1 Do Begin MJEVal[T,I]:=MJEA[I].A; Inc(MJEBits[T,MJEA[I].B]);
  End;
End;

Procedure MJEBuildCodes(T: LongInt);
Var K,Code,I,J,Nb: LongInt;
Begin
 K:=0; Code:=0;
 FillChar(MJESize[T],SizeOf(MJESize[T]),0); FillChar(MJECode[T],SizeOf(MJECode[
  T]),0);
 For I:=1 To 16 Do Begin
  Nb:=MJEBits[T,I];
  For J:=0 To Nb-1 Do Begin
   MJESize[T,MJEVal[T,K]]:=I; MJECode[T,MJEVal[T,K]]:=Code; Inc(K); Inc(Code);
  End;
  Code:=Code Shl 1;
 End;
End;

Procedure MJEByte(B: LongInt); Begin MJEOut^[MJEPos]:=B And 255; Inc(MJEPos);
 End;
Procedure MJEWord(B: LongInt); Begin MJEByte(B Shr 8); MJEByte(B); End;
Procedure MJEMarker(M: LongInt); Begin MJEByte($FF); MJEByte(M); End;
Procedure MJEPut(V: LongInt; N: LongInt);
Begin
 If N=0 Then Exit;
 MJEAcc:=(MJEAcc Shl N) Or (Int64(V) And ((Int64(1) Shl N)-1)); Inc(MJEAccN,N);
 While MJEAccN>=8 Do Begin Dec(MJEAccN,8); MJEByte((MJEAcc Shr MJEAccN) And
  255); End;
 MJEAcc:=MJEAcc And ((Int64(1) Shl MJEAccN)-1);
End;

Procedure MJEAdd(T,Code,Mant: LongInt);
Begin MJEHT^[MJENc]:=T; MJEHC^[MJENc]:=Code; MJEHM^[MJENc]:=Mant; Inc(MJENc);
 End;
Procedure MJECoef(T,Val,Run: LongInt);
Var Mant,A,N: LongInt;
Begin
 If Val=0 Then MJEAdd(T,0,0) Else Begin
  Mant:=Val; A:=Val; If Val<0 Then Begin A:=-Val; Dec(Mant); End;
  N:=0; While (A Shr (N+1))>0 Do Inc(N);
  MJEAdd(T,(Run Shl 4) Or (N+1),Mant);
 End;
End;

{ dct_quantize_c (bloc intra) apres la FDCT islow ; renvoie l'indice du dernier
 coefficient non nul }
Function MJEQuant(Var B: TAMVBlock): LongInt;
Const Bias=786432; T1=1310719; T2=2621438;
Var I,J,Last,Level,Mx: LongInt; U,Prod: Int64;
Begin
 ASVFdct(B);
 B[0]:=(B[0]+32) Div 64;
 Last:=0; Mx:=0;
 For I:=63 DownTo 1 Do Begin
  J:=AMVZig[I];
  Prod:=Int64(B[J])*MJEQmat[J]; Level:=LongInt(Prod And $FFFFFFFF);
  U:=(Int64(Level)+T1) And $FFFFFFFF;
  If U>T2 Then Begin Last:=I; Break; End Else B[J]:=0;
 End;
 For I:=1 To Last Do Begin
  J:=AMVZig[I];
  Prod:=Int64(B[J])*MJEQmat[J]; Level:=LongInt(Prod And $FFFFFFFF);
  U:=(Int64(Level)+T1) And $FFFFFFFF;
  If U>T2 Then Begin
   If Level>0 Then Begin Level:=LongInt((Int64(Bias)+Level) Shr 21); B[J]:=
    Level; End
   Else Begin Level:=LongInt((Int64(Bias)-Level) Shr 21); B[J]:=-Level; End;
   Mx:=Mx Or Level;
  End Else B[J]:=0;
 End;
 If Mx>1023 Then
  For I:=1 To Last Do Begin
   J:=AMVZig[I];
   If B[J]>1023 Then B[J]:=1023 Else If B[J]<-1023 Then B[J]:=-1023;
  End;
 MJEQuant:=Last;
End;

Procedure MJEGetPixels(Var B: TAMVBlock; Pl: PEABuffer; PW,PH,X0,Y0: LongInt);
Var R,C,X,Y: LongInt;
Begin
 For R:=0 To 7 Do Begin
  Y:=Y0+R; If Y>PH-1 Then Y:=PH-1;
  For C:=0 To 7 Do Begin
   X:=X0+C; If X>PW-1 Then X:=PW-1;
   B[R*8+C]:=Pl^[Y*PW+X];
  End;
 End;
End;

Procedure MJERecord(Var B: TAMVBlock; N,Last: LongInt; Var LastDc: Array Of
 LongInt);
Var Comp,Tb,I,J,Val,Run,Dc: LongInt;
Begin
 If N<=3 Then Begin Comp:=0; Tb:=0; End Else Begin Comp:=(N And 1)+1; Tb:=1;
  End;
 Dc:=B[0]; MJECoef(Tb,Dc-LastDc[Comp],0); LastDc[Comp]:=Dc;
 Tb:=Tb Or 2; Run:=0;
 For I:=1 To Last Do Begin
  J:=AMVZig[I]; Val:=B[J];
  If Val=0 Then Inc(Run) Else Begin
   While Run>=16 Do Begin MJEAdd(Tb,$F0,0); Dec(Run,16); End;
   MJECoef(Tb,Val,Run); Run:=0;
  End;
 End;
 If (Last<63) Or (Run<>0) Then MJEAdd(Tb,0,0);
End;

{ encode une image (plans Y,U,V de la disposition Y4M) ; Fmt 0=420 1=422 2=444 ;
 renvoie les octets dans MJEOut }
Procedure MJEFrame(Y,U,V: PEABuffer; W,H,Fmt,Qs,SarN,SarD: LongInt; Full:
 Boolean);
Var
 I,J,Mx,My,Mw,Mh,Cw,Ch,Nb,K,X0,Y0,Cx,Cy,Hs,Vs,Hdr,Lenp,Tb,Code,Nbits,Sz,Tot,
  Comps: LongInt;
 Blk: Array[0..11] Of TAMVBlock; Last: Array[0..11] Of LongInt; LastDc: Array[
  0..2] Of LongInt;
 Order: Array[0..11] Of LongInt; NOrd,Part2: LongInt; Ident: String;
 Esc: PEABuffer; Lst: LongInt;
Begin
 Case Fmt Of
  0: Begin Cw:=(W+1) Div 2; Ch:=(H+1) Div 2; Nb:=6; End;
  1: Begin Cw:=(W+1) Div 2; Ch:=H; Nb:=8; End;
  Else Begin Cw:=W; Ch:=H; Nb:=12; End;
 End;
 Mw:=(W+15) Div 16; Mh:=(H+15) Div 16;
 { matrice de quantification : qscale integre }
 MJEMat[0]:=8;
 For I:=1 To 63 Do Begin
  J:=(MJEIntra[I]*Qs) Shr 3; If J>255 Then J:=255;
  MJEMat[I]:=J;
 End;
 For I:=0 To 63 Do MJEQmat[I]:=LongInt((Int64(2) Shl 21) Div (Int64(16)*MJEMat[
  I]));
 { passe 1 : quantification et enregistrement des codes }
 MJENc:=0; FillChar(MJECnt,SizeOf(MJECnt),0);
 For I:=0 To 2 Do LastDc[I]:=128;
 For My:=0 To Mh-1 Do For Mx:=0 To Mw-1 Do Begin
  X0:=Mx*16; Y0:=My*16;
  MJEGetPixels(Blk[0],Y,W,H,X0,Y0); MJEGetPixels(Blk[1],Y,W,H,X0+8,Y0);
  MJEGetPixels(Blk[2],Y,W,H,X0,Y0+8); MJEGetPixels(Blk[3],Y,W,H,X0+8,Y0+8);
  Case Fmt Of
   0: Begin
    Cx:=Mx*8; Cy:=My*8;
    MJEGetPixels(Blk[4],U,Cw,Ch,Cx,Cy); MJEGetPixels(Blk[5],V,Cw,Ch,Cx,Cy);
   End;
   1: Begin
    Cx:=Mx*8; Cy:=My*16;
    MJEGetPixels(Blk[4],U,Cw,Ch,Cx,Cy); MJEGetPixels(Blk[5],V,Cw,Ch,Cx,Cy);
    MJEGetPixels(Blk[6],U,Cw,Ch,Cx,Cy+8); MJEGetPixels(Blk[7],V,Cw,Ch,Cx,Cy+8);
   End;
   Else Begin
    Cx:=Mx*16; Cy:=My*16;
    MJEGetPixels(Blk[4],U,Cw,Ch,Cx,Cy); MJEGetPixels(Blk[5],V,Cw,Ch,Cx,Cy);
    MJEGetPixels(Blk[6],U,Cw,Ch,Cx+8,Cy); MJEGetPixels(Blk[7],V,Cw,Ch,Cx+8,Cy);
    MJEGetPixels(Blk[8],U,Cw,Ch,Cx,Cy+8); MJEGetPixels(Blk[9],V,Cw,Ch,Cx,Cy+8);
    MJEGetPixels(Blk[10],U,Cw,Ch,Cx+8,Cy+8); MJEGetPixels(Blk[11],V,Cw,Ch,Cx+8,
     Cy+8);
   End;
  End;
  For K:=0 To Nb-1 Do Last[K]:=MJEQuant(Blk[K]);
  Case Fmt Of
   0: Begin NOrd:=6; Order[0]:=0; Order[1]:=1; Order[2]:=2; Order[3]:=3; Order[
    4]:=4; Order[5]:=5; End;
   1: Begin NOrd:=8; Order[0]:=0; Order[1]:=1; Order[2]:=2; Order[3]:=3; Order[
    4]:=4; Order[5]:=6; Order[6]:=5; Order[7]:=7; End;
   Else Begin
    Order[0]:=0; Order[1]:=2; Order[2]:=4; Order[3]:=8; Order[4]:=5; Order[5]:=
     9; NOrd:=6;
    If X0+8<W Then Begin
     Order[6]:=1; Order[7]:=3; Order[8]:=6; Order[9]:=10; Order[10]:=7; Order[
      11]:=11; NOrd:=12;
    End;
   End;
  End;
  For K:=0 To NOrd-1 Do MJERecord(Blk[Order[K]],Order[K],Last[Order[K]],LastDc);
 End;
 { tables de Huffman }
 For I:=0 To MJENc-1 Do Inc(MJECnt[MJEHT^[I],MJEHC^[I]]);
 If MJEOptimal Then Begin
  For I:=0 To 3 Do MJEClose(I);
 End Else Begin
  FillChar(MJEBits,SizeOf(MJEBits),0);
  For I:=1 To 16 Do Begin
   MJEBits[0,I]:=LJBitsDcL[I]; MJEBits[1,I]:=LJBitsDcC[I]; MJEBits[2,I]:=
    LJBitsAcL[I]; MJEBits[3,I]:=LJBitsAcC[I];
  End;
  For I:=0 To 11 Do Begin MJEVal[0,I]:=I; MJEVal[1,I]:=I; End;
  For I:=0 To 161 Do Begin MJEVal[2,I]:=LJValAcL[I]; MJEVal[3,I]:=LJValAcC[I];
   End;
 End;
 For I:=0 To 3 Do MJEBuildCodes(I);
 { en-tete }
 MJEPos:=0; MJEAcc:=0; MJEAccN:=0;
 MJEMarker($D8);
 If (SarN>0) And (SarD>0) Then Begin
  K:=SarN; J:=SarD; While J<>0 Do Begin I:=K Mod J; K:=J; J:=I; End;
  If (SarN>65535) Or (SarD>65535) Then Begin SarN:=SarN Div K; SarD:=SarD Div K;
   End;
  MJEMarker($E0); MJEWord(16); MJEByte(74); MJEByte(70); MJEByte(73); MJEByte(
   70); MJEByte(0);
  MJEWord($0102); MJEByte(0); MJEWord(SarN); MJEWord(SarD); MJEByte(0); MJEByte(
   0);
 End;
 Ident:='Lavc60.31.102';
 MJEMarker($FE); MJEWord(Length(Ident)+3); For I:=1 To Length(Ident) Do MJEByte(
  Ord(Ident[I])); MJEByte(0);
 If Not Full Then Begin
  Ident:='CS=ITU601';
  MJEMarker($FE); MJEWord(Length(Ident)+3); For I:=1 To Length(Ident) Do
   MJEByte(Ord(Ident[I])); MJEByte(0);
 End;
 MJEMarker($DB); MJEWord(2+65); MJEByte(0);
 For I:=0 To 63 Do MJEByte(MJEMat[AMVZig[I]]);
 MJEMarker($C4); Lenp:=MJEPos; MJEWord(0); Sz:=2;
 For I:=0 To 3 Do Begin
  Tb:=0; For J:=1 To 16 Do Inc(Tb,MJEBits[I,J]);
  Case I Of 0: MJEByte($00); 1: MJEByte($01); 2: MJEByte($10); Else MJEByte(
   $11); End;
  For J:=1 To 16 Do MJEByte(MJEBits[I,J]);
  For J:=0 To Tb-1 Do MJEByte(MJEVal[I,J]);
  Inc(Sz,17+Tb);
 End;
 MJEOut^[Lenp]:=Sz Shr 8; MJEOut^[Lenp+1]:=Sz And 255;
 Case Fmt Of 0: Begin Hs:=1; Vs:=1; End; Else Begin Hs:=1; Vs:=2; End; End;
 MJEMarker($C0); MJEWord(17); MJEByte(8); MJEWord(H); MJEWord(W); MJEByte(3);
 MJEByte(1); MJEByte(((2 Shl 4) Or 2) * Ord(Fmt<2) + ((1 Shl 4) Or 2) * Ord(
  Fmt=2)); MJEByte(0);
 MJEByte(2); MJEByte((Hs Shl 4) Or Vs); MJEByte(0);
 MJEByte(3); MJEByte((Hs Shl 4) Or Vs); MJEByte(0);
 MJEMarker($DA); MJEWord(12); MJEByte(3);
 MJEByte(1); MJEByte($00); MJEByte(2); MJEByte($11); MJEByte(3); MJEByte($11);
 MJEByte(0); MJEByte(63); MJEByte(0);
 Hdr:=MJEPos;
 { donnees }
 For I:=0 To MJENc-1 Do Begin
  Tb:=MJEHT^[I]; Code:=MJEHC^[I]; Nbits:=Code And 15;
  MJEPut(MJECode[Tb,Code],MJESize[Tb,Code]);
  If Nbits<>0 Then MJEPut(MJEHM^[I],Nbits);
 End;
 If MJEAccN<>0 Then MJEPut((1 Shl (8-MJEAccN))-1,8-MJEAccN);
 { echappement des 0xFF }
 Tot:=MJEPos-Hdr; Lst:=0;
 For I:=Hdr To MJEPos-1 Do If MJEOut^[I]=$FF Then Inc(Lst);
 If Lst>0 Then Begin
  GetMem(Esc,Tot+Lst+16);
  K:=0;
  For I:=Hdr To MJEPos-1 Do Begin
   Esc^[K]:=MJEOut^[I]; Inc(K);
   If MJEOut^[I]=$FF Then Begin Esc^[K]:=0; Inc(K); End;
  End;
  Move(Esc^,MJEOut^[Hdr],K); MJEPos:=Hdr+K; FreeMem(Esc,Tot+Lst+16);
 End;
 MJEMarker($D9);
End;

Procedure EncodeMJPEG(Const Source,Target: String; AsAvi: Boolean; FrameSel,Qv:
 LongInt);
Var
 Hd: Array[0..255] Of Byte; Limit,Cur,W,H,FN,FD,Frames,K,Code,CW,CH,FrameBytes,
  FrameAt,N,Q,I,Fmt,Qs,Size,OutPos,Fix,SarN,SarD,Pad: LongInt;
 Line,Token: String; Full: Boolean; Raw,Pk: PEABuffer; Sizes: PALLong; Out:
  Array[0..255] Of Byte; Used: Integer;
Function ReadLine: String;
Var R: String;
Begin
 R:='';
 While Cur<Limit Do Begin ReadAt(Cur,Hd,1); Inc(Cur); If Hd[0]=10 Then Break; If
  Length(R)<250 Then R:=R+Chr(Hd[0]); End;
 ReadLine:=R;
End;
Procedure PutB(X: LongInt);Begin Out[Used]:=X And 255; Inc(Used); Inc(OutPos);
 If Used>=250 Then Begin WriteBytes(Out,Used); Used:=0; End; End;
Procedure PutL16(X: LongInt);Begin PutB(X); PutB(X Shr 8); End;
Procedure PutL32(X: LongInt);Begin PutL16(X); PutL16(X Shr 16); End;
Procedure PutTag(Const T: String);
Var Z: Integer;
Begin For Z:=1 To 4 Do PutB(Ord(T[Z])); End;
Procedure Flush;Begin If Used>0 Then Begin WriteBytes(Out,Used); Used:=0; End;
 End;
Procedure Patch32(At,Value: LongInt);
Var Z: Integer; Code2: Integer; B4: Array[0..3] Of Byte;
Begin
 Flush;
 {$I-}Seek(ActiveOutput,At); Code2:=IOResult;{$I+}
 If Code2<>0 Then Fail('mjpeg: positionnement AVI impossible.');
 For Z:=0 To 3 Do Begin B4[Z]:=Value And 255; Value:=Value Shr 8; End;
 WriteBytes(B4,4);
End;
Begin
 OpenRead(Source); Limit:=InputSize; Cur:=0;
 Line:=ReadLine;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('mjpeg: entree Y4M requise.');
 W:=0; H:=0; FN:=25; FD:=1; Fmt:=0; Full:=False; SarN:=0; SarD:=0; Line:=Copy(
  Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),H,Code);
   'F': Begin K:=Pos(':',Token); If K>0 Then Begin Val(Copy(Token,2,K-2),FN,
    Code); Val(Copy(Token,K+1,20),FD,Code); End; End;
   'A': Begin
    K:=Pos(':',Token);
    If K>2 Then Begin Val(Copy(Token,2,K-2),SarN,Code); Val(Copy(Token,K+1,20),
     SarD,Code); End;
   End;
   'I': If Token<>'Ip' Then Fail('mjpeg: video progressive requise.');
   'X': If Token='XCOLORRANGE=FULL' Then Full:=True;
   'C': Begin
    If (Token='C420') Or (Token='C420jpeg') Or (Token='C420mpeg2') Or (
     Token='C420paldv') Then Fmt:=0
    Else If Token='C422' Then Fmt:=1 Else If Token='C444' Then Fmt:=2
    Else Fail('mjpeg: Y4M 4:2:0, 4:2:2 ou 4:4:4 8 bits requis.');
   End;
  End;
 End;
 If (W<1) Or (H<1) Or (W>65500) Or (H>65500) Or (Int64(W)*H>40000000) Then Fail(
  'mjpeg: dimensions Y4M incorrectes.');
 If (Not Full) And (Not LJUnofficial) Then Fail(
  'mjpeg: YUV pleine plage requis (XCOLORRANGE=FULL), ou -strict unofficial.');
 If (FN<=0) Or (FD<=0) Then Begin FN:=25; FD:=1; End;
 Case Fmt Of
  0: Begin CW:=(W+1) Div 2; CH:=(H+1) Div 2; End;
  1: Begin CW:=(W+1) Div 2; CH:=H; End;
  Else Begin CW:=W; CH:=H; End;
 End;
 FrameBytes:=W*H+2*CW*CH;
 { qscale : lambda = Qv*118 puis update_qscale, borne a qmin=2..qmax=31 }
 Qs:=(Qv*118*139+128*64) Shr 14; If Qs<2 Then Qs:=2; If Qs>31 Then Qs:=31;
 GetMem(MJEOut,Int64(W+16)*(H+16)*8+70000);
 GetMem(MJEHT,(Int64((W+15) Div 16)*((H+15) Div 16))*12*64+64); GetMem(MJEHC,(
  Int64((W+15) Div 16)*((H+15) Div 16))*12*64+64);
 GetMem(MJEHM,(Int64((W+15) Div 16)*((H+15) Div 16))*12*64*2+64);
 GetMem(Raw,FrameBytes+64);
 Frames:=0; OutPos:=0; Used:=0; FrameAt:=0;
 If AsAvi Then Begin
  Size:=W*H*3+4096; GetMem(Sizes,1048576*4);
  OpenWrite(Target);
  PutTag('RIFF'); PutL32(0); PutTag('AVI '); PutTag('LIST'); PutL32(192);
   PutTag('hdrl');
  PutTag('avih'); PutL32(56); PutL32(Round(1000000.0*FD/FN)); PutL32(0); PutL32(
   0); PutL32($10); PutL32(0); PutL32(0); PutL32(1);
  PutL32(Size); PutL32(W); PutL32(H); PutL32(0); PutL32(0); PutL32(0); PutL32(
   0);
  PutTag('LIST'); PutL32(116); PutTag('strl');
  PutTag('strh'); PutL32(56); PutTag('vids'); PutTag('MJPG');
  PutL32(0); PutL16(0); PutL16(0); PutL32(0); PutL32(FD); PutL32(FN); PutL32(0);
   PutL32(0); PutL32(Size); PutL32(-1); PutL32(0);
  PutL16(0); PutL16(0); PutL16(W); PutL16(H);
  PutTag('strf'); PutL32(40); PutL32(40); PutL32(W); PutL32(H); PutL16(1);
   PutL16(24);
  PutTag('MJPG'); PutL32(Size); PutL32(0); PutL32(0); PutL32(0); PutL32(0);
  PutTag('LIST'); PutL32(0); PutTag('movi'); Flush;
 End;
 While Cur<Limit Do Begin
  Line:=ReadLine;
  If Copy(Line,1,5)<>'FRAME' Then Break;
  If FrameBytes>Limit-Cur Then Break;
  N:=0; While N<FrameBytes Do Begin If FrameBytes-N>4096 Then Q:=4096 Else Q:=
   FrameBytes-N; ReadAt(Cur+N,Raw^[N],Q); Inc(N,Q); End;
  Inc(Cur,FrameBytes); Inc(Frames);
  If AsAvi Then Begin
   MJEFrame(Raw,PEABuffer(@Raw^[W*H]),PEABuffer(@Raw^[W*H+CW*CH]),W,H,Fmt,Qs,
    SarN,SarD,Full);
   Sizes^[Frames-1]:=MJEPos;
   PutTag('00dc'); PutL32(MJEPos); Flush; WriteBytes(MJEOut^,MJEPos); Inc(
    OutPos,MJEPos);
   If Odd(MJEPos) Then Begin PutB(0); Flush; End;
   If Frames>=1048576 Then Break;
  End Else Begin
   If (FrameSel=0) Or (Frames=FrameSel) Then Begin
    MJEFrame(Raw,PEABuffer(@Raw^[W*H]),PEABuffer(@Raw^[W*H+CW*CH]),W,H,Fmt,Qs,
     SarN,SarD,Full);
    FrameAt:=MJEPos;
   End;
   If (FrameSel<>0) And (Frames=FrameSel) Then Break;
  End;
 End;
 If Frames=0 Then Fail('mjpeg: aucune image Y4M.');
 If AsAvi Then Begin
  Fix:=OutPos;
  PutTag('idx1'); PutL32(16*Frames); K:=4;
  For I:=0 To Frames-1 Do Begin
   PutTag('00dc'); PutL32($10); PutL32(K); PutL32(Sizes^[I]); Inc(K,8+Sizes^[I]+
    (Sizes^[I] And 1));
  End;
  Flush;
  Patch32(4,OutPos-8); Patch32(216,Fix-220); Patch32(48,Frames); Patch32(140,
   Frames);
  FreeMem(Sizes,1048576*4);
 End Else Begin
  OpenWrite(Target);
  I:=0; While I<FrameAt Do Begin If FrameAt-I>4096 Then Q:=4096 Else Q:=FrameAt-
   I; WriteBytes(MJEOut^[I],Q); Inc(I,Q); End;
 End;
 CloseRead; CloseWrite;
End;
{ MJENC-END }



{ ---- Encodeur HuffYUV (libavcodec/huffyuvenc.c, huffman.c, huffyuv.c):
 yuv422p, prediction gauche, tables statiques, AVI ---- }
Procedure HYGenLen(Var Dst: Array Of Byte; Const Stats: Array Of Int64; N:
 LongInt);
Type THeapEl=Record Val: Int64; Name: LongInt; End;
Var
 H: Array[0..255] Of THeapEl; Up: Array[0..511] Of LongInt; Len: Array[0..511]
  Of LongInt; Map: Array[0..255] Of LongInt;
 Size,Offset,I,Nxt: LongInt; Min1v: Int64; Over: Boolean; T: THeapEl;
Procedure Sift(Root,Sz: LongInt);
Var Child: LongInt;
Begin
 While Root*2+1<Sz Do Begin
  Child:=Root*2+1;
  If (Child<Sz-1) And (H[Child].Val>H[Child+1].Val) Then Inc(Child);
  If H[Root].Val>H[Child].Val Then Begin T:=H[Root]; H[Root]:=H[Child]; H[
   Child]:=T; Root:=Child; End
  Else Break;
 End;
End;
Begin
 Size:=0;
 For I:=0 To N-1 Do Begin Dst[I]:=255; Map[Size]:=I; Inc(Size); End;
 Offset:=1;
 While True Do Begin
  For I:=0 To Size-1 Do Begin H[I].Name:=I; H[I].Val:=(Stats[Map[I]] Shl 14)+
   Offset; End;
  For I:=Size Div 2-1 DownTo 0 Do Sift(I,Size);
  For Nxt:=Size To Size*2-2 Do Begin
   Min1v:=H[0].Val;
   Up[H[0].Name]:=Nxt;
   H[0].Val:=High(Int64);
   Sift(0,Size);
   Up[H[0].Name]:=Nxt;
   H[0].Name:=Nxt;
   H[0].Val:=H[0].Val+Min1v;
   Sift(0,Size);
  End;
  Len[2*Size-2]:=0;
  For I:=2*Size-3 DownTo Size Do Len[I]:=Len[Up[I]]+1;
  Over:=False;
  For I:=0 To Size-1 Do Begin
   Dst[Map[I]]:=Len[Up[I]]+1;
   If Dst[Map[I]]>=32 Then Begin Over:=True; Break; End;
  End;
  If Not Over Then Break;
  Offset:=Offset Shl 1;
 End;
End;

Procedure EncodeHuffyuv(Const Source,Target: String);
Var
 Hd: Array[0..255] Of Byte;
 Limit,Cur,W,Hh,FN,FD,Frames,I,K,CW,FrameBytes,Q,OutPos,N,Y,X,MaxPk,Lf,L2,Rate,
  Scale,G2,Aw,Ah: LongInt;
 Yp,Up,Vp,Ty,Tu,Tv,Pk: PEABuffer; Line,Token: String; Code: Integer; Sizes:
  PALLong;
 Stats: Array[0..255] Of Int64; Len: Array[0..255] Of Byte; Bits: Array[0..255]
  Of Int64; Fix: LongInt;
 Extra: Array[0..511] Of Byte; ExtraLen,PkSize,PkCap: LongInt; C422,C420:
  Boolean; SrcCH,Jv: LongInt; VF: TSwsF; U15,SrcU,SrcV: PEABuffer; Vsum: Int64;
 Acc,NB: Int64; AccN: LongInt; PkPos: LongInt;
 Out: Array[0..255] Of Byte; Used: Integer;
Procedure PutB(X: LongInt);Begin Out[Used]:=X And 255; Inc(Used); Inc(OutPos);
 If Used>=250 Then Begin WriteBytes(Out,Used); Used:=0; End; End;
Procedure PutL16(X: LongInt);Begin PutB(X); PutB(X Shr 8); End;
Procedure PutL32(X: LongInt);Begin PutL16(X); PutL16(X Shr 16); End;
Procedure PutTag(Const T: String);
Var Z: Integer;
Begin For Z:=1 To 4 Do PutB(Ord(T[Z])); End;
Procedure PutZ(Cnt: LongInt);
Var Z: LongInt;
Begin For Z:=1 To Cnt Do PutB(0); End;
Procedure Flush;Begin If Used>0 Then Begin WriteBytes(Out,Used); Used:=0; End;
 End;
Procedure Patch32(At,Value: LongInt);
Var Z: Integer; Code2: Integer; B4: Array[0..3] Of Byte;
Begin
 Flush;
 {$I-}Seek(ActiveOutput,At); Code2:=IOResult;{$I+}
 If Code2<>0 Then Fail('huffyuv: positionnement AVI impossible.');
 For Z:=0 To 3 Do Begin B4[Z]:=Value And 255; Value:=Value Shr 8; End;
 WriteBytes(B4,4);
 {$I-}Seek(ActiveOutput,OutPos); Code2:=IOResult;{$I+}
End;
Function ReadLine: String;
Var R: String;
Begin
 R:='';
 While Cur<Limit Do Begin ReadAt(Cur,Hd,1); Inc(Cur); If Hd[0]=10 Then Break; If
  Length(R)<250 Then R:=R+Chr(Hd[0]); End;
 ReadLine:=R;
End;
Procedure ReadPlane(Plane: PEABuffer; At,Count: LongInt);
Var Nn: LongInt;
Begin
 Nn:=0;
 While Nn<Count Do Begin
  If Count-Nn>4096 Then Q:=4096 Else Q:=Count-Nn;
  ReadAt(At+Nn,Plane^[Nn],Q); Inc(Nn,Q);
 End;
End;
Procedure PutBits(Cnt,V: LongInt);
Begin
 Acc:=(Acc Shl Cnt) Or (Int64(V) And ((Int64(1) Shl Cnt)-1)); Inc(AccN,Cnt);
 While AccN>=32 Do Begin
  Dec(AccN,32);
  PkSize:=PkSize+4;
  Pk^[PkPos]:=(Acc Shr (AccN)) And 255; Pk^[PkPos+1]:=(Acc Shr (AccN+8)) And
   255;
  Pk^[PkPos+2]:=(Acc Shr (AccN+16)) And 255; Pk^[PkPos+3]:=(Acc Shr (AccN+24))
   And 255;
  Inc(PkPos,4);
  Acc:=Acc And ((Int64(1) Shl AccN)-1);
 End;
End;
{ prediction gauche d'une ligne, memorisee dans Dst ; renvoie le dernier
 echantillon }
Function SubLeft(Dst,Src: PEABuffer; SrcOff,Wd,Left: LongInt): LongInt;
Var Z,Tt: LongInt;
Begin
 For Z:=0 To Wd-1 Do Begin Tt:=Src^[SrcOff+Z]; Dst^[Z]:=(Tt-Left) And 255;
  Left:=Tt; End;
 SubLeft:=Left;
End;
Procedure Enc422(Off,Count: LongInt);
Var Z,Y0,Y1,U0,V0: LongInt;
Begin
 For Z:=0 To (Count Div 2)-1 Do Begin
  Y0:=Ty^[Off+2*Z]; Y1:=Ty^[Off+2*Z+1]; U0:=Tu^[Off Div 2+Z]; V0:=Tv^[Off Div 2+
   Z];
  PutBits(Len[Y0],Bits[Y0]); PutBits(Len[U0],Bits[U0]); PutBits(Len[Y1],Bits[
   Y1]); PutBits(Len[V0],Bits[V0]);
 End;
End;
Procedure StoreTable;
Var Z,Val,Rep: LongInt;
Begin
 Z:=0;
 While Z<256 Do Begin
  Val:=Len[Z]; Rep:=0;
  While (Z<256) And (Len[Z]=Val) And (Rep<255) Do Begin Inc(Rep); Inc(Z); End;
  If Rep>7 Then Begin Extra[ExtraLen]:=Val; Extra[ExtraLen+1]:=Rep; Inc(
   ExtraLen,2); End
  Else Begin Extra[ExtraLen]:=Val Or (Rep Shl 5); Inc(ExtraLen); End;
 End;
End;
Begin
 OpenRead(Source); Limit:=InputSize; Cur:=0;
 Line:=ReadLine;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('huffyuv: entree Y4M requise.');
 W:=0; Hh:=0; FN:=25; FD:=1; C422:=False; C420:=False;
 Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),Hh,Code);
   'F': Begin K:=Pos(':',Token); If K>0 Then Begin Val(Copy(Token,2,K-2),FN,
    Code); Val(Copy(Token,K+1,20),FD,Code); End; End;
   'C': If (Token='C422') Or (Token='C422jpeg') Then C422:=True
        Else If (Token='C420') Or (Token='C420jpeg') Or (Token='C420mpeg2') Or (
         Token='C420paldv') Then C420:=True
        Else Fail('huffyuv: Y4M yuv422p ou yuv420p 8 bits requis.');
  End;
 End;
 If Not (C422 Or C420) Then Fail(
  'huffyuv: Y4M yuv422p ou yuv420p 8 bits requis.');
 If (W<2) Or (Hh<1) Or (W>16384) Or (Hh>16384) Then Fail(
  'huffyuv: dimensions Y4M incorrectes.');
 If Odd(W) Then Fail(
  'huffyuv: largeur paire requise pour ce format de pixels.');
 If (FN<=0) Or (FD<=0) Then Begin FN:=25; FD:=1; End;
 CW:=W Div 2;
 If C420 Then Begin SrcCH:=(Hh+1) Div 2; FrameBytes:=W*Hh+2*CW*SrcCH; End Else
  Begin SrcCH:=Hh; FrameBytes:=W*Hh+2*CW*Hh; End;
 { tables statiques (stats = 1e8/(d*d+1)) }
 For I:=0 To 255 Do Begin
  K:=I; If 256-I<K Then K:=256-I;
  Stats[I]:=100000000 Div (Int64(K)*K+1);
 End;
 HYGenLen(Len,Stats,256);
 { ff_huffyuv_generate_bits_table }
 NB:=0;
 For K:=32 DownTo 1 Do Begin
  For I:=0 To 255 Do If Len[I]=K Then Begin Bits[I]:=NB; Inc(NB); End;
  If Odd(NB) Then Fail('huffyuv: erreur de generation de la table Huffman.');
  NB:=NB Shr 1;
 End;
 Extra[0]:=0; Extra[1]:=16; Extra[2]:=$20; Extra[3]:=0; ExtraLen:=4;
 For I:=0 To 2 Do StoreTable;
 GetMem(Yp,W*Hh+64); GetMem(Up,CW*Hh+64); GetMem(Vp,CW*Hh+64);
 GetMem(Ty,W+64); GetMem(Tu,CW+64); GetMem(Tv,CW+64); GetMem(SrcU,CW*SrcCH+64);
  GetMem(SrcV,CW*SrcCH+64);
 PkCap:=W*Hh*12+65536; GetMem(Pk,PkCap); GetMem(Sizes,1048576*4);
 Frames:=0; OutPos:=0; Used:=0; MaxPk:=0;
 Rate:=FN; Scale:=FD; G2:=Rate; K:=Scale; While K<>0 Do Begin I:=G2 Mod K; G2:=
  K; K:=I; End;
 Rate:=Rate Div G2; Scale:=Scale Div G2;
 OpenWrite(Target);
 PutTag('RIFF'); PutL32(0); PutTag('AVI ');
 If ExtraLen<>106 Then Fail('huffyuv: tables Huffman inattendues.');
 PutTag('LIST'); PutL32(4770+O2Jx-4120); PutTag('hdrl');
 PutTag('avih'); PutL32(56); PutL32(Trunc(1000000.0*Scale/Rate)); PutL32(O2Bps);
  PutL32(0); PutL32(2320); PutL32(0); PutL32(0); PutL32(1);
 PutL32(1048576); PutL32(W); PutL32(Hh); PutL32(0); PutL32(0); PutL32(0);
  PutL32(0);
 PutTag('LIST'); PutL32(4426+O2Jx-4120); PutTag('strl');
 PutTag('strh'); PutL32(56); PutTag('vids'); PutTag('HFYU');
 PutL32(0); PutL16(0); PutL16(0); PutL32(0); PutL32(Scale); PutL32(Rate);
  PutL32(0); PutL32(0); PutL32(0); PutL32(-1); PutL32(0);
 PutL16(0); PutL16(0); PutL16(W); PutL16(Hh);
 PutTag('strf'); PutL32(40+ExtraLen); PutL32(40+ExtraLen); PutL32(W); PutL32(
  Hh); PutL16(1); PutL16(16);
 PutTag('HFYU'); PutL32(W*Hh*2); PutL32(0); PutL32(0); PutL32(0); PutL32(0);
 For I:=0 To ExtraLen-1 Do PutB(Extra[I]);
 If Odd(ExtraLen) Then PutB(0);
 PutTag('JUNK'); PutL32(O2Jx); PutL16(4); PutL16(0); PutL32(0); PutTag('00dc');
  PutZ(O2Jx-12);
 PutTag('vprp'); PutL32(68); PutL32(0); PutL32(0); PutL32((2*Rate+Scale-1) Div (
  2*Scale));
 PutL32(W); PutL32(Hh);
 Aw:=W; Ah:=Hh; G2:=Aw; K:=Ah; While K<>0 Do Begin I:=G2 Mod K; G2:=K; K:=I;
  End; Aw:=Aw Div G2; Ah:=Ah Div G2;
 PutL32((Aw Shl 16) Or Ah); PutL32(W); PutL32(Hh); PutL32(1);
 PutL32(Hh); PutL32(W); PutL32(Hh); PutL32(W); PutL32(0); PutL32(0); PutL32(0);
  PutL32(0);
 PutTag('JUNK'); PutL32(260); PutTag('odml'); PutTag('dmlh'); PutL32(248); PutZ(
  248);
 PutTag('LIST'); PutL32(26); PutTag('INFO'); PutTag('ISFT'); PutL32(14);
 PutTag('Lavf'); PutTag('60.1'); PutTag('6.10'); PutB(48); PutB(0);
 PutTag('JUNK'); PutL32(1016); PutZ(1016);
 PutTag('LIST'); PutL32(0); PutTag('movi'); Flush;
 While Cur<Limit Do Begin
  Line:=ReadLine;
  If Copy(Line,1,5)<>'FRAME' Then Fail('huffyuv: marqueur FRAME requis.');
  If FrameBytes>Limit-Cur Then Break;
  ReadPlane(Yp,Cur,W*Hh);
  If C420 Then Begin
   { yuv420p -> yuv422p : chroma etiree verticalement par le filtre bicubique de
    swscale }
   ReadPlane(SrcU,Cur+W*Hh,CW*SrcCH); ReadPlane(SrcV,Cur+W*Hh+CW*SrcCH,CW*
    SrcCH);
   SwsInitF(VF,SrcCH,Hh,128,128,4096);
   For K:=0 To 1 Do
    For Y:=0 To Hh-1 Do
     For X:=0 To CW-1 Do Begin
      Vsum:=Int64(64) Shl 12;
      For Jv:=0 To VF.FS-1 Do Begin
       If K=0 Then I:=SrcU^[(VF.Pos^[Y]+Jv)*CW+X] Else I:=SrcV^[(VF.Pos^[Y]+Jv)*
        CW+X];
       Vsum:=Vsum+Int64(I)*128*VF.Coef^[Y*VF.FS+Jv];
      End;
      Vsum:=AVSar(Vsum,19); If Vsum<0 Then Vsum:=0 Else If Vsum>255 Then Vsum:=
       255;
      If K=0 Then Up^[Y*CW+X]:=Vsum Else Vp^[Y*CW+X]:=Vsum;
     End;
   SwsFreeF(VF);
  End Else Begin ReadPlane(Up,Cur+W*Hh,CW*Hh); ReadPlane(Vp,Cur+W*Hh+CW*Hh,CW*
   Hh); End;
  Inc(Cur,FrameBytes);
  PkPos:=0; PkSize:=0; Acc:=0; AccN:=0;
  PutBits(8,Vp^[0]); PutBits(8,Yp^[1]); PutBits(8,Up^[0]); PutBits(8,Yp^[0]);
  Lf:=SubLeft(Ty,Yp,0,W,0); L2:=SubLeft(Tu,Up,0,CW,0); I:=SubLeft(Tv,Vp,0,CW,0);
  K:=I; { gauche V }
  Enc422(2,W-2);
  For Y:=1 To Hh-1 Do Begin
   Lf:=SubLeft(Ty,Yp,Y*W,W,Lf); L2:=SubLeft(Tu,Up,Y*CW,CW,L2); K:=SubLeft(Tv,Vp,
    Y*CW,CW,K);
   Enc422(0,W);
  End;
  { fin: bourrage a un mot de 32 bits }
  If AccN>0 Then PutBits(32-AccN,0);
  Sizes^[Frames]:=PkSize;
  If PkSize>MaxPk Then MaxPk:=PkSize;
  PutTag('00dc'); PutL32(PkSize); Flush;
  K:=0;
  While K<PkSize Do Begin
   If PkSize-K>32768 Then Q:=32768 Else Q:=PkSize-K;
   WriteBytes(Pk^[K],Q); Inc(K,Q);
  End;
  Inc(OutPos,PkSize);
  Inc(Frames);
  If Frames>=1048576 Then Break;
 End;
 If Frames=0 Then Fail('huffyuv: aucune image Y4M.');
 Fix:=OutPos-5860;
 PutTag('idx1'); PutL32(16*Frames); K:=4;
 For I:=0 To Frames-1 Do Begin
  PutTag('00dc'); PutL32($10); PutL32(K); PutL32(Sizes^[I]); Inc(K,8+Sizes^[I]);
 End;
 Flush;
 Patch32(4,OutPos-8); Patch32(48,Frames); Patch32(140,Frames); Patch32(144,
  MaxPk); Patch32(5852,4+Fix);
 FreeMem(Yp,W*Hh+64); FreeMem(Up,CW*Hh+64); FreeMem(Vp,CW*Hh+64);
 CloseRead; CloseWrite;
End;

{ ---- Ecriture AVI au format du muxer ffmpeg (libavformat/avienc.c): en-tete
 fixe, JUNK odml, idx1 ---- }
Var
 AWBuf: Array[0..255] Of Byte; AWUsed: Integer; AWPos,AWMovi,AWMaxPk,AWFrames:
  LongInt; AWSizes: PALLong;

Procedure AWB(X: LongInt);Begin AWBuf[AWUsed]:=X And 255; Inc(AWUsed); Inc(
 AWPos); If AWUsed>=250 Then Begin WriteBytes(AWBuf,AWUsed); AWUsed:=0; End;
 End;
Procedure AWL16(X: LongInt);Begin AWB(X); AWB(X Shr 8); End;
Procedure AWL32(X: LongInt);Begin AWL16(X); AWL16(X Shr 16); End;
Procedure AWTag(Const T: String);
Var Z: Integer;
Begin For Z:=1 To 4 Do AWB(Ord(T[Z])); End;
Procedure AWZ(Cnt: LongInt);
Var Z: LongInt;
Begin For Z:=1 To Cnt Do AWB(0); End;
Procedure AWFlush;Begin If AWUsed>0 Then Begin WriteBytes(AWBuf,AWUsed);
 AWUsed:=0; End; End;
Procedure AWPatch(At,Value: LongInt);
Var Z: Integer; Code2: Integer; B4: Array[0..3] Of Byte;
Begin
 AWFlush;
 {$I-}Seek(ActiveOutput,At); Code2:=IOResult;{$I+}
 If Code2<>0 Then Fail('avi: positionnement impossible.');
 For Z:=0 To 3 Do Begin B4[Z]:=Value And 255; Value:=Value Shr 8; End;
 WriteBytes(B4,4);
 {$I-}Seek(ActiveOutput,AWPos); Code2:=IOResult;{$I+}
End;

{ Fourcc: 4 caracteres ; Rate/Scale: cadence reduite ; Bpp: bits par pixel
 declares ; Extra: donnees codec }
Procedure AWBegin(Const Target,Fourcc: String; W,H,Rate,Scale,Bpp: LongInt;
 Extra: PEABuffer; ExtraLen: LongInt);
Var I,Aw,Ah,G,K,Strf,Strl,Hdrl,AWJx: LongInt;
Begin
 OpenWrite(Target); AWUsed:=0; AWPos:=0; AWFrames:=0; AWMaxPk:=0; GetMem(
  AWSizes,1048576*4);
 Strf:=40+ExtraLen+(ExtraLen And 1);
 O1AviSar(O1AwSn,O1AwSd); O1AwHv:=(O1AwSn>0) And (O1AwSd>0);
 If AWBpsOverride<>0 Then AWJx:=O2JxBR(Int64(AWBpsOverride)*8) Else AWJx:=O2Jx;
 Strl:=4+(8+56)+(8+Strf)+(8+AWJx); If O1AwHv Then Strl:=Strl+(8+68);
 Hdrl:=4+(8+56)+(8+Strl)+(8+260);
 AWTag('RIFF'); AWL32(0); AWTag('AVI ');
 AWTag('LIST'); AWL32(Hdrl); AWTag('hdrl');
 AWTag('avih'); AWL32(56); AWL32(Trunc(1000000.0*Scale/Rate)); If
  AWBpsOverride<>0 Then AWL32(AWBpsOverride) Else AWL32(O2Bps); AWL32(0); AWL32(
  2320); AWL32(0); AWL32(0); AWL32(1);
 AWL32(1048576); AWL32(W); AWL32(H); AWL32(0); AWL32(0); AWL32(0); AWL32(0);
 AWTag('LIST'); AWL32(Strl); AWTag('strl');
 AWTag('strh'); AWL32(56); AWTag('vids'); AWTag(Fourcc);
 AWL32(0); AWL16(0); AWL16(0); AWL32(0); AWL32(Scale); AWL32(Rate); AWL32(0);
  AWL32(0); AWL32(0); AWL32(-1); AWL32(0);
 AWL16(0); AWL16(0); AWL16(W); AWL16(H);
 AWTag('strf'); AWL32(40+ExtraLen); AWL32(40+ExtraLen); AWL32(W); AWL32(H);
  AWL16(1); AWL16(Bpp);
 AWTag(Fourcc); AWL32(W*H*Bpp Div 8); AWL32(0); AWL32(0); AWL32(0); AWL32(0);
 For I:=0 To ExtraLen-1 Do AWB(Extra^[I]);
 If Odd(ExtraLen) Then AWB(0);
 AWTag('JUNK'); AWL32(AWJx); AWL16(4); AWL16(0); AWL32(0); AWTag('00dc'); AWZ(
  AWJx-12);
 If O1AwHv Then Begin
 AWTag('vprp'); AWL32(68); AWL32(0); AWL32(0); AWL32((2*Rate+Scale-1) Div (2*
  Scale));
 AWL32(W); AWL32(H);
 O1AviDar(W,H,O1AwSn,O1AwSd,Aw,Ah);
 AWL32((Aw Shl 16) Or Ah); AWL32(W); AWL32(H); AWL32(1);
 AWL32(H); AWL32(W); AWL32(H); AWL32(W); AWL32(0); AWL32(0); AWL32(0); AWL32(0);
 End;
 AWTag('JUNK'); AWL32(260); AWTag('odml'); AWTag('dmlh'); AWL32(248); AWZ(248);
 AWTag('LIST'); AWL32(26); AWTag('INFO'); AWTag('ISFT'); AWL32(14);
 AWTag('Lavf'); AWTag('60.1'); AWTag('6.10'); AWB(48); AWB(0);
 AWTag('JUNK'); AWL32(1016); AWZ(1016);
 AWTag('LIST'); AWL32(0); AWMovi:=AWPos-8; AWTag('movi'); AWFlush;
 AWMovi:=AWMovi; { position du champ taille de LIST movi = AWMovi+4 }
End;

Procedure AWFrame(P: PEABuffer; Len: LongInt);
Var K,Q: LongInt;
Begin
 AWTag('00dc'); AWL32(Len); AWFlush;
 K:=0;
 While K<Len Do Begin
  If Len-K>32768 Then Q:=32768 Else Q:=Len-K;
  WriteBytes(P^[K],Q); Inc(K,Q); Inc(AWPos,Q);
 End;
 If Odd(Len) Then AWB(0);
 If AWFrames<1048576 Then AWSizes^[AWFrames]:=Len;
 Inc(AWFrames);
 If Len>AWMaxPk Then AWMaxPk:=Len;
End;

Procedure AWEnd;
Var I,K,Fix: LongInt;
Begin
 Fix:=AWPos-(AWMovi+8+4);
 AWTag('idx1'); AWL32(16*AWFrames); K:=4;
 For I:=0 To AWFrames-1 Do Begin
  AWTag('00dc'); If AWKeys=Nil Then AWL32($10) Else AWL32(AWKeys^[I]*16); AWL32(
   K); AWL32(AWSizes^[I]); Inc(K,8+AWSizes^[I]+(AWSizes^[I] And 1));
 End;
 AWFlush;
 AWPatch(4,AWPos-8); AWPatch(48,AWFrames); AWPatch(140,AWFrames); AWPatch(144,
  AWMaxPk); AWPatch(AWMovi+4,4+Fix);
 FreeMem(AWSizes,1048576*4);
 CloseRead; CloseWrite;
End;

{ ---- Encodeur H.263 / H.263+ (libavcodec/ituh263enc.c): I/P, vecteurs 16x16
 demi-pixel, boucle fermee via le decodeur ---- }
Const
 H3ERlMax=12;
Var
 H3ECos: Array[0..7,0..7] Of Double; H3ERl,H3ERlAic: Array[0..1,0..63,
  0..H3ERlMax] Of SmallInt; H3EInit: Boolean; H3ERv: LongInt;
 H3EBuf: PEABuffer; H3EBits: LongInt; H3ECap: LongInt;

Procedure H3EPut(N,V: LongInt);
Var I: LongInt;
Begin
 For I:=N-1 DownTo 0 Do Begin
  If ((V Shr I) And 1)<>0 Then H3EBuf^[H3EBits Shr 3]:=H3EBuf^[H3EBits Shr 3] Or
   (128 Shr (H3EBits And 7));
  Inc(H3EBits);
 End;
End;

Procedure H3EInitTab;
Var U,X,I,K: LongInt;
Begin
 For U:=0 To 7 Do For X:=0 To 7 Do Begin
  H3ECos[U,X]:=Cos((2*X+1)*U*Pi/16);
  If U=0 Then H3ECos[U,X]:=H3ECos[U,X]*Sqrt(0.5);
  H3ECos[U,X]:=H3ECos[U,X]*0.5;
 End;
 FillChar(H3ERl,SizeOf(H3ERl),255);
 For K:=0 To 101 Do Begin
  I:=0; If K>=58 Then I:=1;
  If (H3InterRun[K]<=63) And (H3InterLevel[K]<=H3ERlMax) Then H3ERl[I,
   H3InterRun[K],H3InterLevel[K]]:=K;
 End;
 FillChar(H3ERlAic,SizeOf(H3ERlAic),255);
 For K:=0 To 101 Do Begin
  I:=0; If K>=58 Then I:=1;
  If (H3IntraRunAic[K]<=63) And (H3IntraLevelAic[K]<=H3ERlMax) Then H3ERlAic[I,
   H3IntraRunAic[K],H3IntraLevelAic[K]]:=K;
 End;
 H3EInit:=True;
End;

Procedure H3EFdct(Var Src: Array Of LongInt; Var Dst: Array Of Double);
Var U,V,X,Y: LongInt; T: Array[0..63] Of Double; S: Double;
Begin
 For Y:=0 To 7 Do For U:=0 To 7 Do Begin
  S:=0; For X:=0 To 7 Do S:=S+Src[Y*8+X]*H3ECos[U,X];
  T[Y*8+U]:=S;
 End;
 For U:=0 To 7 Do For V:=0 To 7 Do Begin
  S:=0; For Y:=0 To 7 Do S:=S+T[Y*8+U]*H3ECos[V,Y];
  Dst[V*8+U]:=S;
 End;
End;

Procedure H3EMotion(Val: LongInt);
Var Sign,Code: LongInt;
Begin
 If Val=0 Then Begin H3EPut(H3MvTab[1],H3MvTab[0]); Exit; End;
 { codage modulo 64 }
 Val:=((Val+32) And 63)-32;
 If Val<0 Then Begin Sign:=1; Val:=-Val; End Else Sign:=0;
 Dec(Val); Code:=Val+1;
 H3EPut(H3MvTab[Code*2+1]+1,(H3MvTab[Code*2] Shl 1) Or Sign);
End;

{ ecrit les coefficients d'un bloc deja quantifie (raster) ; Intra: DC 8 bits
 puis AC }
Procedure H3EBlock(Var Lev: Array Of LongInt; Intra: Boolean);
Var I,J,Last,Run,L,Code,LastNz,Sign: LongInt;
Begin
 I:=0;
 If Intra Then Begin
  L:=Lev[0]; If L>254 Then L:=254 Else If L<1 Then L:=1;
  If L=128 Then H3EPut(8,255) Else H3EPut(8,L);
  I:=1;
 End;
 Last:=-1;
 For J:=63 DownTo I Do If Lev[H3Zigzag[J]]<>0 Then Begin Last:=J; Break; End;
 If Last<0 Then Exit;
 LastNz:=I-1;
 While I<=Last Do Begin
  L:=Lev[H3Zigzag[I]];
  If L<>0 Then Begin
   Run:=I-LastNz-1;
   If L<0 Then Begin Sign:=1; L:=-L; End Else Sign:=0;
   Code:=-1;
   If (Run<=63) And (L<=H3ERlMax) Then Code:=H3ERl[Ord(I=Last),Run,L];
   If Code>=0 Then Begin
    H3EPut(H3InterVlc[Code*2+1],H3InterVlc[Code*2]);
    H3EPut(1,Sign);
   End Else Begin
    H3EPut(H3InterVlc[102*2+1],H3InterVlc[102*2]);
    H3EPut(1,Ord(I=Last)); H3EPut(6,Run);
    If Sign<>0 Then L:=-L;
    H3EPut(8,L And 255);
   End;
   LastNz:=I;
  End;
  Inc(I);
 End;
End;

{ bloc intra AIC (RL intra AIC, DC inclus a la position 0) }
Procedure H3EBlockAic(Var Lev: Array Of LongInt);
Var I,J,Last,Run,L,Code,LastNz,Sign: LongInt;
Begin
 Last:=-1;
 For J:=63 DownTo 0 Do If Lev[H3Zigzag[J]]<>0 Then Begin Last:=J; Break; End;
 If Last<0 Then Exit;
 LastNz:=-1; I:=0;
 While I<=Last Do Begin
  L:=Lev[H3Zigzag[I]];
  If L<>0 Then Begin
   Run:=I-LastNz-1;
   If L<0 Then Begin Sign:=1; L:=-L; End Else Sign:=0;
   Code:=-1;
   If (Run<=63) And (L<=H3ERlMax) Then Code:=H3ERlAic[Ord(I=Last),Run,L];
   If Code>=0 Then Begin
    H3EPut(H3IntraVlcAic[Code*2+1],H3IntraVlcAic[Code*2]);
    H3EPut(1,Sign);
   End Else Begin
    H3EPut(H3IntraVlcAic[102*2+1],H3IntraVlcAic[102*2]);
    H3EPut(1,Ord(I=Last)); H3EPut(6,Run);
    If Sign<>0 Then L:=-L;
    If (L>=-127) And (L<=127) Then H3EPut(8,L And 255)
    Else Begin H3EPut(8,128); H3EPut(5,L And 31); H3EPut(6,(L Shr 5) And 63);
     End;
   End;
   LastNz:=I;
  End;
  Inc(I);
 End;
End;

{ ---- Ecriture RealMedia (libavformat/rmenc.c), un flux video ---- }
Var
 RMWBuf: Array[0..511] Of Byte; RMWLen: LongInt;
 RMWNFrames,RMWTotal,RMWMax,RMWDataPos,RMWW,RMWH,RMWFN,RMWFD,RMWBit,RMWKind,
  RMWPos,RMWHdrLen: LongInt;
 RMWOut: Array[0..32767] Of Byte; RMWOutN: LongInt;
Procedure RMWb(X: LongInt);Begin RMWBuf[RMWLen]:=X And 255; Inc(RMWLen); End;
Procedure RMWb16(X: LongInt);Begin RMWb(X Shr 8); RMWb(X); End;
Procedure RMWb32(X: LongInt);Begin RMWb16((X Shr 16) And $FFFF); RMWb16(X And
 $FFFF); End;
Procedure RMWTag(Const T: String);
Var Z: Integer;
Begin For Z:=1 To Length(T) Do RMWb(Ord(T[Z])); End;
Procedure RMWStr8(Const T: String);
Begin RMWb(Length(T)); RMWTag(T); End;
Procedure RMWHeader(DataSize: LongInt; Final: Boolean);
Var NPk,MaxS,Avg,Dur,Fps,TotFr: LongInt; Sub: LongInt;
Begin
 RMWLen:=0;
 If Final Then Begin NPk:=RMWNFrames; MaxS:=RMWMax; TotFr:=RMWNFrames; End Else
  Begin NPk:=0; MaxS:=4096; TotFr:=0; End;
 If NPk>0 Then Avg:=RMWTotal Div NPk Else Avg:=0;
 Dur:=(Int64(TotFr)*1000*RMWFD) Div RMWFN;
 Fps:=RMWFN Div RMWFD;
 RMWTag('.RMF'); RMWb32(18); RMWb16(0); RMWb32(0); RMWb32(5);
 RMWTag('PROP'); RMWb32(50); RMWb16(0);
 RMWb32(RMWBit); RMWb32(RMWBit); RMWb32(MaxS); RMWb32(Avg); RMWb32(NPk); RMWb32(
  Dur); RMWb32(0); RMWb32(0);
 RMWb32(RMWDataPos); RMWb16(1); RMWb16(3);
 RMWTag('CONT'); RMWb32(18); RMWb16(0); RMWb16(0); RMWb16(0); RMWb16(0); RMWb16(
  0);
 RMWTag('MDPR'); RMWb32(116); RMWb16(0);
 RMWb16(0); RMWb32(RMWBit); RMWb32(RMWBit); RMWb32(MaxS); RMWb32(Avg); RMWb32(
  0); RMWb32(0);
 If TotFr=0 Then RMWb32(3600000) Else RMWb32(Dur);
 RMWStr8('The Video Stream'); RMWStr8('video/x-pn-realvideo'); RMWb32(34);
 RMWb32(34); RMWTag('VIDO');
 If RMWKind=1 Then RMWTag('RV10') Else RMWTag('RV20');
 RMWb16(RMWW); RMWb16(RMWH); RMWb16(Fps); RMWb32(0); RMWb16(Fps); RMWb32(0);
  RMWb16(8);
 If RMWKind=1 Then Sub:=$10000000 Else Sub:=$20103001;
 RMWb32(Sub);
 RMWDataPos:=RMWLen;
 RMWTag('DATA'); RMWb32(DataSize+10+8); RMWb16(0); RMWb32(NPk); RMWb32(0);
End;
Procedure RMWFlushOut;
Begin If RMWOutN>0 Then Begin WriteBytes(RMWOut,RMWOutN); RMWOutN:=0; End; End;
Procedure RMWPut(Const B; N: LongInt);
Var P: ^Byte; K: LongInt;
Begin
 P:=@B;
 For K:=0 To N-1 Do Begin
  RMWOut[RMWOutN]:=P^; Inc(RMWOutN); Inc(P);
  If RMWOutN>=SizeOf(RMWOut) Then RMWFlushOut;
 End;
End;
Procedure RMWBegin(Const Target: String; Kind,W,H,FN,FD,Bitrate: LongInt);
Begin
 RMWKind:=Kind; RMWW:=W; RMWH:=H; RMWFN:=FN; RMWFD:=FD; RMWBit:=Bitrate;
 RMWNFrames:=0; RMWTotal:=0; RMWMax:=0; RMWOutN:=0; RMWDataPos:=0;
 OpenWrite(Target);
 RMWHeader(0,False);
 RMWHdrLen:=RMWLen; RMWPos:=RMWLen;
 WriteBytes(RMWBuf,RMWLen);
End;
Procedure RMWFrame(P: PEABuffer; Len: LongInt; Key: Boolean);
Var Length2,Ts: LongInt; Hd: Array[0..23] Of Byte; N: LongInt;
Procedure B(X: LongInt);Begin Hd[N]:=X And 255; Inc(N); End;
Procedure B16(X: LongInt);Begin B(X Shr 8); B(X); End;
Procedure B32(X: LongInt);Begin B16((X Shr 16) And $FFFF); B16(X And $FFFF);
 End;
Begin
 N:=0;
 Length2:=Len+7; If Len>=$4000 Then Inc(Length2,4);
 If Len>65535-19 Then Fail('rm: image de plus de 64 Ko non prise en charge.');
 Ts:=(Int64(RMWNFrames)*1000*RMWFD) Div RMWFN;
 B16(0); B16(Length2+12); B16(0); B32(Ts); B(0); If Key Then B(2) Else B(0);
 B($81); If Key Then B($81) Else B(1);
 If Len>=$4000 Then Begin B32(Len); B32(Len); End Else Begin B16($4000 Or Len);
  B16($4000 Or Len); End;
 B(RMWNFrames And 255);
 RMWPut(Hd,N); RMWPut(P^,Len);
 Inc(RMWPos,N+Len);
 Inc(RMWTotal,Length2); If Length2>RMWMax Then RMWMax:=Length2;
 Inc(RMWNFrames);
End;
Procedure RMWEnd;
Var Z: Array[0..7] Of Byte; Code: Integer; IndexPos,DataSize: LongInt;
Begin
 RMWFlushOut;
 IndexPos:=RMWPos; DataSize:=IndexPos-RMWDataPos;
 FillChar(Z,SizeOf(Z),0); WriteBytes(Z,8);
 RMWHeader(DataSize,True);
 {$I-}Seek(ActiveOutput,0); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('rm: positionnement impossible.');
 WriteBytes(RMWBuf,RMWLen);
 CloseRead; CloseWrite;
End;

Type TH3EDbl=Array[0..100000000] Of Double; PH3EDbl=^TH3EDbl;
Var
 H3ECo: PH3EDbl; H3EMode: PEABuffer; H3EMvX,H3EMvY: PALLong;

Procedure EncodeH263(Const Source,Target: String; Plus: Boolean);
Var
 Hd: Array[0..255] Of Byte;
 Limit,Cur,W,Hh,FN,FD,Frames,I,K,CW,FrameBytes,Q,N,Y,X,PW,PH,MbW,MbH,Fmt,MbNum,
  Mx,My,Gop,Slot,Bx,By,Dx,Dy,SadBest,Sad,Bytes,PkCap,PkLen: LongInt;
 Yp,Up,Vp,SrY,SrU,SrV,Pk: PEABuffer; Line,Token: String; Code: Integer; C420:
  Boolean;
 Rate,Scale,G2,BestClock,BestDiv,Err,BestErr,Div2,CustomPcf,Tr: LongInt;
 R: TVideoRateTrial; Seconds: Double; IsI: Boolean; Cm0,EPrev: LongInt; RvTmp:
  PEABuffer; EDc: Array[0..2] Of PALLong; EDcN: Array[0..2] Of LongInt; EDcW:
  Array[0..2] Of LongInt;
 Blk,Lev: Array[0..63] Of LongInt; Tmp: Array[0..63] Of Double;
 Px,Py,Sx,Sy,Mean,Var2,SadZero,Mvx,Mvy,Ex,Ey,Cx,Cy,Z,B2,Rng,X0,Y0,Bmx,Bmy,Cost,
  BestCost: LongInt; Ok: Boolean;
Function ReadLine: String;
Var Rs: String;
Begin
 Rs:='';
 While Cur<Limit Do Begin ReadAt(Cur,Hd,1); Inc(Cur); If Hd[0]=10 Then Break; If
  Length(Rs)<250 Then Rs:=Rs+Chr(Hd[0]); End;
 ReadLine:=Rs;
End;
Procedure ReadPlane(Plane: PEABuffer; At,Count: LongInt);
Var Nn,Qq: LongInt;
Begin
 Nn:=0;
 While Nn<Count Do Begin
  If Count-Nn>4096 Then Qq:=4096 Else Qq:=Count-Nn;
  ReadAt(At+Nn,Plane^[Nn],Qq); Inc(Nn,Qq);
 End;
End;
Procedure Pad(Src,Dst: PEABuffer; Sw,Sh,Dw,Dh: LongInt);
Var Yy,Xx,Cx2,Cy2: LongInt;
Begin
 For Yy:=0 To Dh-1 Do
  For Xx:=0 To Dw-1 Do Begin
   Cx2:=Xx; If Cx2>=Sw Then Cx2:=Sw-1; Cy2:=Yy; If Cy2>=Sh Then Cy2:=Sh-1;
   Dst^[Yy*Dw+Xx]:=Src^[Cy2*Sw+Cx2];
  End;
End;
Function MbMv(Xm,Ym,C: LongInt): LongInt;
Begin
 If (Xm<0) Or (Ym<0) Or (Xm>=MbW) Then MbMv:=0
 Else If C=0 Then MbMv:=H3EMvX^[Ym*MbW+Xm] Else MbMv:=H3EMvY^[Ym*MbW+Xm];
End;
Procedure PredMv(Xm,Ym: LongInt; Var Pxx,Pyy: LongInt);
Var A0,A1,B0,B1,C0,C1: LongInt;
Begin
 A0:=MbMv(Xm-1,Ym,0); A1:=MbMv(Xm-1,Ym,1);
 If Ym=0 Then Begin
  If Xm=0 Then Begin Pxx:=0; Pyy:=0; End Else Begin Pxx:=A0; Pyy:=A1; End;
 End Else Begin
  B0:=MbMv(Xm,Ym-1,0); B1:=MbMv(Xm,Ym-1,1);
  C0:=MbMv(Xm+1,Ym-1,0); C1:=MbMv(Xm+1,Ym-1,1);
  Pxx:=H3Mid(A0,B0,C0); Pyy:=H3Mid(A1,B1,C1);
 End;
End;
Function SadPred(Xm,Ym: LongInt): LongInt;
Var Yy,Xx,S: LongInt;
Begin
 S:=0;
 For Yy:=0 To 15 Do For Xx:=0 To 15 Do
  S:=S+Abs(LongInt(SrY^[(Ym*16+Yy)*PW+Xm*16+Xx])-LongInt(H3P[H3CurI].Y^[(Ym*16+
   Yy)*H3LY+Xm*16+Xx]));
 SadPred:=S;
End;
{ vecteur (demi-pixel) admissible : bloc entierement dans l'image }
Function MvOk(Xm,Ym,Vx,Vy: LongInt): Boolean;
Var Ix,Iy,Ew,Eh: LongInt;
Begin
 MvOk:=False;
 If (Vx<-32) Or (Vx>31) Or (Vy<-32) Or (Vy>31) Then Exit;
 Ix:=Xm*16+H3Sar(Vx,1); Iy:=Ym*16+H3Sar(Vy,1);
 Ew:=16; If (Vx And 1)<>0 Then Inc(Ew);
 Eh:=16; If (Vy And 1)<>0 Then Inc(Eh);
 If (Ix<0) Or (Iy<0) Or (Ix+Ew>PW) Or (Iy+Eh>PH) Then Exit;
 MvOk:=True;
End;
{ pixels source 8x8 du bloc Bn du macrobloc (Mx,My) }
Procedure GetSrc(Mxx,Myy,Bn: LongInt);
Var Yy,Xx: LongInt;
Begin
 For Yy:=0 To 7 Do For Xx:=0 To 7 Do
  Case Bn Of
   0..3: Blk[Yy*8+Xx]:=SrY^[(Myy*16+(Bn Shr 1)*8+Yy)*PW+Mxx*16+(Bn And 1)*8+Xx];
   4: Blk[Yy*8+Xx]:=SrU^[(Myy*8+Yy)*(PW Div 2)+Mxx*8+Xx];
   5: Blk[Yy*8+Xx]:=SrV^[(Myy*8+Yy)*(PW Div 2)+Mxx*8+Xx];
  End;
End;
Procedure SubPred(Mxx,Myy,Bn: LongInt);
Var Yy,Xx: LongInt;
Begin
 For Yy:=0 To 7 Do For Xx:=0 To 7 Do
  Case Bn Of
   0..3: Dec(Blk[Yy*8+Xx],H3P[H3CurI].Y^[(Myy*16+(Bn Shr 1)*8+Yy)*H3LY+Mxx*16+(
    Bn And 1)*8+Xx]);
   4: Dec(Blk[Yy*8+Xx],H3P[H3CurI].U^[(Myy*8+Yy)*H3LC+Mxx*8+Xx]);
   5: Dec(Blk[Yy*8+Xx],H3P[H3CurI].V^[(Myy*8+Yy)*H3LC+Mxx*8+Xx]);
  End;
End;
Function QuantBlock(Qs: LongInt; IsIntra: Boolean): Boolean;
Var Zz,Lv: LongInt; A: Double; Any: Boolean;
Begin
 Any:=False;
 For Zz:=0 To 63 Do Begin
  If IsIntra And (Zz=0) Then Begin
   Lv:=Trunc((Tmp[0]+4)/8);
   If Lv>254 Then Lv:=254 Else If Lv<1 Then Lv:=1;
   Lev[0]:=Lv;
  End Else Begin
   A:=Abs(Tmp[Zz]); Lv:=Trunc(A/(2*Qs)); If Lv>127 Then Lv:=127;
   If Tmp[Zz]<0 Then Lv:=-Lv;
   Lev[Zz]:=Lv;
   If Lv<>0 Then Any:=True;
  End;
 End;
 QuantBlock:=Any;
End;
Function QOf(Qs,Bn: LongInt): LongInt;
Begin If (H3ERv=2) And (Bn>=4) Then QOf:=H3ChromaQ[Qs] Else QOf:=Qs; End;
{ image intra RV20 : codage AIC sans prediction des AC }
Procedure WriteAic(Qs: LongInt);
Var
 Mbx,Mby,Mb,Bn,Zz,Cm,X,Y,A,C,Pred,Scale,Qb,L0,Cbp,Cbpc,Cbpy: LongInt; Lv: Array[
  0..5,0..63] Of LongInt; Coded: Boolean; Dcv: LongInt; Av: Double;
 Wrap: LongInt;
Begin
 For Cm:=0 To 2 Do FillChar(EDc[Cm]^,EDcN[Cm]*4,0);
 For Cm:=0 To 2 Do For Zz:=0 To EDcN[Cm]-1 Do EDc[Cm]^[Zz]:=1024;
 For Mby:=0 To MbH-1 Do For Mbx:=0 To MbW-1 Do Begin
  Mb:=Mby*MbW+Mbx; Cbp:=0;
  For Bn:=0 To 5 Do Begin
   Qb:=QOf(Qs,Bn);
   If Bn<4 Then Begin Cm:=0; X:=2*Mbx+(Bn And 1); Y:=2*Mby+(Bn Shr 1); End Else
    Begin Cm:=Bn-3; X:=Mbx; Y:=Mby; End;
   Wrap:=EDcW[Cm]; Scale:=H3AicDcScale[Qb];
   A:=EDc[Cm]^[(Y+1)*Wrap+X]; C:=EDc[Cm]^[Y*Wrap+X+1];
   If (Mby=0) And (Bn<>3) Then Begin
    If Bn<>2 Then C:=1024;
    If (Bn<>1) And (Mbx=0) Then A:=1024;
   End;
   If (A<>1024) And (C<>1024) Then Pred:=(A+C) Shr 1
   Else If A<>1024 Then Pred:=A
   Else Pred:=C;
   For Zz:=0 To 63 Do Tmp[Zz]:=H3ECo^[(Mb*6+Bn)*64+Zz];
   Av:=(Tmp[0]-Pred)/Scale;
   If Av>=0 Then L0:=Trunc(Av+0.5) Else L0:=-Trunc(-Av+0.5);
   If L0>1023 Then L0:=1023 Else If L0<-1023 Then L0:=-1023;
   Coded:=L0<>0;
   Lv[Bn,0]:=L0;
   For Zz:=1 To 63 Do Begin
    Av:=Abs(Tmp[Zz])/(2*Qb);
    X:=Trunc(Av+0.5); If X>127 Then X:=127;
    If Tmp[Zz]<0 Then X:=-X;
    Lv[Bn,Zz]:=X;
    If X<>0 Then Coded:=True;
   End;
   Dcv:=L0*Scale+Pred;
   If Dcv<0 Then Dcv:=0 Else Dcv:=Dcv Or 1;
   If Bn<4 Then Begin X:=2*Mbx+(Bn And 1); Y:=2*Mby+(Bn Shr 1); End Else Begin
    X:=Mbx; Y:=Mby; End;
   EDc[Cm]^[(Y+1)*Wrap+X+1]:=Dcv;
   If Coded Then Cbp:=Cbp Or (1 Shl (5-Bn));
  End;
  Cbpc:=Cbp And 3; Cbpy:=Cbp Shr 2;
  H3EPut(H3IntraMcbpcBits[Cbpc],H3IntraMcbpcCode[Cbpc]);
  H3EPut(1,0);
  H3EPut(H3CbpyTab[Cbpy*2+1],H3CbpyTab[Cbpy*2]);
  For Bn:=0 To 5 Do
   If (Cbp And (1 Shl (5-Bn)))<>0 Then H3EBlockAic(Lv[Bn]);
 End;
End;
Function WriteFrame(Qs,Fn: LongInt; Intr: Boolean): LongInt;
Var Mb,Bn,Mbx,Mby,Cbp,Cbpc,Cbpy,Pxx,Pyy,Zz: LongInt; Lv: Array[0..5,0..63] Of
 LongInt; IsIntra,Sk: Boolean;
Begin
 FillChar(Pk^,PkCap,0); H3EBuf:=Pk; H3EBits:=0;
 If H3ERv=1 Then Begin
  H3EPut(1,1); H3EPut(1,Ord(Not Intr)); H3EPut(1,0); H3EPut(5,Qs);
  H3EPut(6,0); H3EPut(6,0); H3EPut(12,MbNum); H3EPut(3,0);
 End Else If H3ERv=2 Then Begin
  H3EPut(2,1+Ord(Not Intr)); H3EPut(1,0); H3EPut(5,Qs); H3EPut(8,Fn And 255);
  Zz:=0; While (MbNum-1>H3MbaMax[Zz]) And (Zz<5) Do Inc(Zz);
  H3EPut(H3MbaLength[Zz],0); H3EPut(1,0);
 End Else Begin
 H3EPut(22,$20);
 If Plus Then Tr:=Int64(Fn)*1800000*Scale Div (Int64(1000+BestClock)*BestDiv*
  Rate)
 Else Tr:=Int64(Fn)*30000*Scale Div (Int64(1001)*Rate);
 H3EPut(8,Tr And 255);
 H3EPut(1,1); H3EPut(1,0); H3EPut(3,0);
 If Not Plus Then Begin
  H3EPut(3,Fmt); H3EPut(1,Ord(Not Intr)); H3EPut(1,0); H3EPut(1,0); H3EPut(1,0);
   H3EPut(1,0);
  H3EPut(5,Qs); H3EPut(1,0);
 End Else Begin
  H3EPut(3,7); H3EPut(3,1);
  If Fmt=8 Then H3EPut(3,6) Else H3EPut(3,Fmt);
  H3EPut(1,CustomPcf);
  H3EPut(1,0); H3EPut(1,0); H3EPut(1,0); H3EPut(1,0); H3EPut(1,0); H3EPut(1,0);
  H3EPut(1,0); H3EPut(1,0); H3EPut(1,0); H3EPut(1,0); H3EPut(1,1); H3EPut(3,0);
  H3EPut(3,Ord(Not Intr));
  H3EPut(1,0); H3EPut(1,0); H3EPut(1,0); H3EPut(2,0); H3EPut(1,1);
  H3EPut(1,0);
  If Fmt=8 Then Begin
   H3EPut(4,1); H3EPut(9,(W Shr 2)-1); H3EPut(1,1); H3EPut(9,Hh Shr 2);
  End;
  If CustomPcf<>0 Then Begin H3EPut(1,BestClock); H3EPut(7,BestDiv); H3EPut(2,(
   Tr Shr 8) And 3); End;
  H3EPut(5,Qs);
 End;
 H3EPut(1,0);
 End;
 If (H3ERv=2) And Intr Then Begin WriteAic(Qs); WriteFrame:=(H3EBits+7) Div 8;
  Exit; End;
 For Mby:=0 To MbH-1 Do For Mbx:=0 To MbW-1 Do Begin
  Mb:=Mby*MbW+Mbx;
  IsIntra:=Intr Or (H3EMode^[Mb]<>0);
  Cbp:=0;
  For Bn:=0 To 5 Do Begin
   For Zz:=0 To 63 Do Tmp[Zz]:=H3ECo^[(Mb*6+Bn)*64+Zz];
   If QuantBlock(QOf(Qs,Bn),IsIntra) Then Cbp:=Cbp Or (1 Shl (5-Bn));
   Move(Lev,Lv[Bn],SizeOf(Lev));
  End;
  If Not IsIntra Then Begin
   Sk:=(Cbp=0) And (H3EMvX^[Mb]=0) And (H3EMvY^[Mb]=0);
   If Sk Then Begin H3EPut(1,1); Continue; End;
   H3EPut(1,0);
   Cbpc:=Cbp And 3; Cbpy:=(Cbp Shr 2) Xor 15;
   H3EPut(H3InterMcbpcBits[Cbpc],H3InterMcbpcCode[Cbpc]);
   H3EPut(H3CbpyTab[Cbpy*2+1],H3CbpyTab[Cbpy*2]);
   PredMv(Mbx,Mby,Pxx,Pyy);
   H3EMotion(H3EMvX^[Mb]-Pxx); H3EMotion(H3EMvY^[Mb]-Pyy);
  End Else Begin
   Cbpc:=Cbp And 3; Cbpy:=Cbp Shr 2;
   If Intr Then H3EPut(H3IntraMcbpcBits[Cbpc],H3IntraMcbpcCode[Cbpc])
   Else Begin H3EPut(1,0); H3EPut(H3InterMcbpcBits[Cbpc+4],H3InterMcbpcCode[
    Cbpc+4]); End;
   H3EPut(H3CbpyTab[Cbpy*2+1],H3CbpyTab[Cbpy*2]);
  End;
  For Bn:=0 To 5 Do
   If IsIntra Then H3EBlock(Lv[Bn],True)
   Else If (Cbp And (1 Shl (5-Bn)))<>0 Then H3EBlock(Lv[Bn],False);
 End;
 WriteFrame:=(H3EBits+7) Div 8;
End;
Begin
 If Not H3EInit Then H3EInitTab;
 OpenRead(Source); Limit:=InputSize; Cur:=0;
 Line:=ReadLine;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('h263: entree Y4M requise.');
 W:=0; Hh:=0; FN:=25; FD:=1; C420:=False;
 Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),Hh,Code);
   'F': Begin K:=Pos(':',Token); If K>0 Then Begin Val(Copy(Token,2,K-2),FN,
    Code); Val(Copy(Token,K+1,20),FD,Code); End; End;
   'C': If (Token='C420') Or (Token='C420jpeg') Or (Token='C420mpeg2') Or (
    Token='C420paldv') Then C420:=True
        Else Fail('h263: Y4M yuv420p 8 bits requis.');
   'I': If Token<>'Ip' Then Fail('h263: video progressive requise.');
  End;
 End;
 If Not C420 Then Fail('h263: Y4M yuv420p 8 bits requis.');
 If (W<4) Or (Hh<4) Or (W>2048) Or (Hh>2048) Then Fail(
  'h263: dimensions Y4M incorrectes.');
 If (FN<=0) Or (FD<=0) Then Begin FN:=25; FD:=1; End;
 { format source }
 Fmt:=8;
 For I:=1 To 5 Do If (H3Format[I*2]=W) And (H3Format[I*2+1]=Hh) Then Fmt:=I;
 If (Fmt=8) And (H3ERv=0) Then Begin
  If Not Plus Then Begin Str(W,Token); Str(Hh,Line); Fail(
   'The specified picture size of '+Token+'x'+Line+
   ' is not valid for the H.263 codec. Valid sizes are 128x96, 176x144, 352x28'+
   '8, 704x576, and 1408x1152. Try H.263+.'); End;
  If ((W And 3)<>0) Or ((Hh And 3)<>0) Then Fail(
   'h263p: dimensions multiples de 4 requises pour un format personnalise.');
 End;
 Rate:=FN; Scale:=FD; G2:=Rate; K:=Scale; While K<>0 Do Begin I:=G2 Mod K; G2:=
  K; K:=I; End;
 Rate:=Rate Div G2; Scale:=Scale Div G2;
 { horloge image (PCF) }
 BestClock:=1; BestDiv:=60; BestErr:=High(LongInt);
 For I:=0 To 1 Do Begin
  Div2:=(Int64(Scale)*1800000+500*Int64(Rate)) Div ((1000+I)*Int64(Rate));
  If Div2<1 Then Div2:=1; If Div2>127 Then Div2:=127;
  Err:=Abs(Int64(Scale)*1800000-Int64(1000+I)*Rate*Div2);
  If Err<BestErr Then Begin BestErr:=Err; BestDiv:=Div2; BestClock:=I; End;
 End;
 If (BestClock<>1) Or (BestDiv<>60) Then CustomPcf:=1 Else CustomPcf:=0;
 If (Not Plus) And (CustomPcf<>0) Then CustomPcf:=0;
 MbW:=(W+15) Div 16; MbH:=(Hh+15) Div 16; MbNum:=MbW*MbH; PW:=MbW*16; PH:=MbH*
  16;
 CW:=(W+1) Div 2; FrameBytes:=W*Hh+2*CW*((Hh+1) Div 2);
 GetMem(Yp,W*Hh+64); GetMem(Up,CW*((Hh+1) Div 2)+64); GetMem(Vp,CW*((Hh+1) Div
  2)+64);
 GetMem(SrY,PW*PH+64); GetMem(SrU,(PW Div 2)*(PH Div 2)+64); GetMem(SrV,(PW Div
  2)*(PH Div 2)+64);
 GetMem(H3ECo,Int64(MbNum)*6*64*8); GetMem(H3EMode,MbNum+8); GetMem(H3EMvX,
  MbNum*4+8); GetMem(H3EMvY,MbNum*4+8);
 PkCap:=PW*PH*4+65536; GetMem(Pk,PkCap+128);
 Gop:=12;
 H3Reset; H3Codec:=0;
 If H3ERv>0 Then Begin
  FillChar(RVExt,SizeOf(RVExt),0); RVExt[3]:=8; RVExtLen:=8;
  If H3ERv=1 Then Begin RVExt[4]:=$10; End Else Begin RVExt[4]:=$20; RVExt[5]:=
   $10; RVExt[6]:=$30; RVExt[7]:=$01; End;
  RVSetup(H3ERv,W,Hh);
  EDcW[0]:=2*MbW+1; EDcN[0]:=EDcW[0]*(2*MbH+1);
  EDcW[1]:=MbW+1; EDcN[1]:=EDcW[1]*(MbH+1); EDcW[2]:=EDcW[1]; EDcN[2]:=EDcN[1];
  For Cm0:=0 To 2 Do GetMem(EDc[Cm0],EDcN[Cm0]*4+16);
  GetMem(RvTmp,PkCap+256);
  RMWBegin(Target,H3ERv,W,Hh,Rate,Scale,Round(VideoBitrate));
 End Else
 AWBegin(Target,'H263',W,Hh,Rate,Scale,24,Nil,0);
 EPrev:=-1;
 Frames:=0; Seconds:=Scale/Rate;
 VideoRateStart;
 While Cur<Limit Do Begin
  Line:=ReadLine;
  If Copy(Line,1,5)<>'FRAME' Then Fail('h263: marqueur FRAME requis.');
  If FrameBytes>Limit-Cur Then Break;
  ReadPlane(Yp,Cur,W*Hh); ReadPlane(Up,Cur+W*Hh,CW*((Hh+1) Div 2)); ReadPlane(
   Vp,Cur+W*Hh+CW*((Hh+1) Div 2),CW*((Hh+1) Div 2));
  Inc(Cur,FrameBytes);
  Pad(Yp,SrY,W,Hh,PW,PH); Pad(Up,SrU,CW,(Hh+1) Div 2,PW Div 2,PH Div 2); Pad(Vp,
   SrV,CW,(Hh+1) Div 2,PW Div 2,PH Div 2);
  IsI:=(Frames Mod Gop)=0;
  { phase A : decisions et coefficients de transformation }
  If Not IsI Then Begin
   If H3ERv>0 Then H3RefI:=EPrev;
   Slot:=0; While Slot=H3RefI Do Inc(Slot); H3CurI:=Slot;
  End;
  For My:=0 To MbH-1 Do For Mx:=0 To MbW-1 Do Begin
   I:=My*MbW+Mx; H3EMvX^[I]:=0; H3EMvY^[I]:=0; H3EMode^[I]:=1;
   If Not IsI Then Begin
    H3MbX:=Mx; H3MbY:=My; Sx:=Mx*16; Sy:=My*16;
    { recherche entiere }
    SadBest:=High(LongInt); Bmx:=0; Bmy:=0;
    For Dy:=-7 To 7 Do For Dx:=-7 To 7 Do Begin
     X0:=Sx+Dx; Y0:=Sy+Dy;
     If (X0<0) Or (Y0<0) Or (X0+16>PW) Or (Y0+16>PH) Then Continue;
     Sad:=0;
     For Y:=0 To 15 Do Begin
      For X:=0 To 15 Do Sad:=Sad+Abs(LongInt(SrY^[(Sy+Y)*PW+Sx+X])-LongInt(H3P[
       H3RefI].Y^[(Y0+Y)*H3LY+X0+X]));
      If Sad>=SadBest Then Break;
     End;
     Cost:=Sad+(Abs(Dx)+Abs(Dy))*2; If (Dx=0) And (Dy=0) Then Dec(Cost,100);
     If (Cost<SadBest) Then Begin SadBest:=Cost; Bmx:=Dx; Bmy:=Dy; End;
    End;
    Mvx:=Bmx*2; Mvy:=Bmy*2;
    { raffinement demi-pixel }
    H3MpegMotion(H3RefI,Mvx,Mvy,0); BestCost:=SadPred(Mx,My);
    If (Mvx<>0) Or (Mvy<>0) Then Dec(BestCost,0);
    Bmx:=Mvx; Bmy:=Mvy;
    For Ey:=-1 To 1 Do For Ex:=-1 To 1 Do Begin
     If (Ex=0) And (Ey=0) Then Continue;
     If Not MvOk(Mx,My,Mvx+Ex,Mvy+Ey) Then Continue;
     H3MpegMotion(H3RefI,Mvx+Ex,Mvy+Ey,0); Cost:=SadPred(Mx,My)+4;
     If Cost<BestCost Then Begin BestCost:=Cost; Bmx:=Mvx+Ex; Bmy:=Mvy+Ey; End;
    End;
    Mvx:=Bmx; Mvy:=Bmy;
    { variance intra }
    Mean:=0;
    For Y:=0 To 15 Do For X:=0 To 15 Do Inc(Mean,SrY^[(Sy+Y)*PW+Sx+X]);
    Mean:=(Mean+128) Div 256; Var2:=0;
    For Y:=0 To 15 Do For X:=0 To 15 Do Inc(Var2,Abs(LongInt(SrY^[(Sy+Y)*PW+Sx+
     X])-Mean));
    If BestCost>Var2+500 Then H3EMode^[I]:=1 Else Begin
     H3EMode^[I]:=0; H3EMvX^[I]:=Mvx; H3EMvY^[I]:=Mvy;
    End;
    If H3EMode^[I]=0 Then H3MpegMotion(H3RefI,Mvx,Mvy,0);
   End;
   For B2:=0 To 5 Do Begin
    GetSrc(Mx,My,B2);
    If H3EMode^[I]=0 Then SubPred(Mx,My,B2);
    H3EFdct(Blk,Tmp);
    Move(Tmp,H3ECo^[(I*6+B2)*64],512);
   End;
  End;
  { phase B : quantification avec recherche du pas selon le debit cible }
  VideoPictureTrialStart(R,Seconds,False);
  Repeat
   PkLen:=WriteFrame(R.Q,Frames,IsI);
  Until Not VideoTrialAgain(R,PkLen);
  VideoRateBits:=VideoRateBits+PkLen*8.0; VideoRateDuration:=VideoRateDuration+
   Seconds;
  If H3ERv>0 Then RMWFrame(Pk,PkLen,IsI) Else AWFrame(Pk,PkLen);
  { boucle fermee : reference = image decodee }
  If H3ERv>0 Then Begin
   FillChar(RvTmp^,9,0); RvTmp^[1]:=1; Move(Pk^,RvTmp^[9],PkLen); FillChar(
    RvTmp^[9+PkLen],64,0);
   H3CurI:=EPrev;
   If RVFrame(RvTmp,PkLen+9)<>1 Then Fail(
    'rv: erreur interne de reconstruction.');
   EPrev:=H3CurI;
  End Else
  If H3Frame(Pk,PkLen)<>1 Then Fail('h263: erreur interne de reconstruction.');
  Inc(Frames);
  If Frames>=1048576 Then Break;
 End;
 If Frames=0 Then Fail('h263: aucune image Y4M.');
 If H3ERv>0 Then RMWEnd Else AWEnd;
 VideoRateReport;
End;

