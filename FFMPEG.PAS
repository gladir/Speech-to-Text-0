Const
 SwrPi: Double = 3.14159265358979323846;
 SwrSqrt12: Double = 0.70710678118654752440;
 SwrSqrt32: Double = 1.22474487139158904909;
 SwrCutoff: Double = 0.97;
 SwrIntMax = 2147483647;
