{ ligne de commande du sous-processus, sans les options traitees par ce module }
Function O1ChildLine(Const InputFile: String; KeepInputOpts: Boolean; Const
 OutFile: String; Extra: String; Mode: Integer): String;
{ Mode 1 : decodage de l'entree (options globales + options d'entree + -i +
 Extra + OutFile) ; Mode 2 : transcodage (globales + -i InputFile + options de
 sortie + OutFile) }
Var I,Ti: Integer; Pre,Post: String; HasVal: Boolean;
Begin
 Pre:=''; Post:='';
 For I:=1 To O1NOp Do Begin
  Ti:=O1Op[I].Tok;
  HasVal:=O1Op[I].Av Or ((O1Op[I].Ti>=0) And (O1HasFlag(O1Op[I].Ti,'A') Or
   O1HasFlag(O1Op[I].Ti,'X')));
  If O1Op[I].Grp=-1 Then Begin
   { options globales : conservees (sauf -y/-n/-stdin geres ici) }
   If (O1Op[I].Key='y') Or (O1Op[I].Key='n') Or (O1Op[I].Key='nostdin') Or (
    O1Op[I].Key='stdin') Then Continue;
   If (Mode=1) And ((O1Op[I].Key='v') Or (O1Op[I].Key='loglevel')) Then
    Continue;
   Pre:=Pre+' -'+O1Op[I].Key;
   If HasVal Then Pre:=Pre+' '+O1Q(O1Op[I].Val);
   Continue;
  End;
  If O1Used[Ti] Then Continue;
  If (Mode=1) And KeepInputOpts And (O1Op[I].Grp=O1InG) Then Begin
   Pre:=Pre+' -'+O1Op[I].Key;
   If HasVal Then Pre:=Pre+' '+O1Q(O1Op[I].Val);
  End;
  If (Mode=2) And (O1Op[I].Grp=O1OutG) Then Begin
   Post:=Post+' -'+O1Op[I].Key;
   If HasVal Then Post:=Post+' '+O1Q(O1Op[I].Val);
  End;
 End;
 If Mode=1 Then O1ChildLine:='-y -v quiet'+Pre+' -i '+O1Q(InputFile)+Extra+' '+
  O1Q(OutFile)
 Else O1ChildLine:='-y'+Pre+' -i '+O1Q(InputFile)+Extra+Post+' '+O1Q(OutFile);
End;

