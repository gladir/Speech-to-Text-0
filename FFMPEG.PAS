  ((18,34,30,46,17,33,29,45),(50,2,62,14,49,1,61,13),(26,42,22,38,25,41,21,37),(
   58,10,54,6,57,9,53,5),(16,32,28,44,19,35,31,47),(48,0,60,12,51,3,63,15),(24,
