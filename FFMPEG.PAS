Procedure SQVlcAdd(R,Code,Len,Sym: LongInt);
Var N,B,I,C: LongInt;
Begin
 N:=SQRoot[R];
 For I:=Len-1 Downto 0 Do Begin
  B:=(Code Shr I) And 1;
  If I=0 Then SQNd[N,B]:=-(Sym+1)
  Else Begin
   C:=SQNd[N,B];
   If C<=0 Then Begin Inc(SQNN); SQNd[SQNN,0]:=0; SQNd[SQNN,1]:=0; C:=SQNN;
    SQNd[N,B]:=C; End;
   N:=C;
  End;
 End;
End;

Procedure SQNewRoot(R: LongInt);
Begin Inc(SQNN); SQNd[SQNN,0]:=0; SQNd[SQNN,1]:=0; SQRoot[R]:=SQNN; End;

Procedure SQInit;
Var R,I,L,B,D,Base: LongInt;
Begin
 If SQInited Then Exit;
 SQInited:=True; SQNN:=0;
 SQNewRoot(0); For I:=0 To 3 Do SQVlcAdd(0,SQBlkC[I],SQBlkL[I],I);
 For L:=0 To 5 Do Begin
  SQNewRoot(1+L); For I:=0 To 7 Do SQVlcAdd(1+L,SQIMsC[L*8+I],SQIMsL[L*8+I],I);
  SQNewRoot(7+L); For I:=0 To 7 Do SQVlcAdd(7+L,SQPMsC[L*8+I],SQPMsL[L*8+I],I);
 End;
 SQNewRoot(13); For I:=0 To 255 Do SQVlcAdd(13,SQIMnC[I],SQIMnL[I],I);
 SQNewRoot(14); For I:=0 To 511 Do SQVlcAdd(14,SQPMnC[I],SQPMnL[I],I);
 SQNewRoot(15); For I:=0 To 32 Do SQVlcAdd(15,SQMvTab[I*2],SQMvTab[I*2+1],I);
 { codebooks en mots de 32 bits (petit-boutiste) }
 For I:=0 To 2879 Do Begin
  SQCbDI[I]:=LongWord(SQCbInter[I*4] And 255) Or (LongWord(SQCbInter[I*4+1] And
   255) Shl 8) Or (LongWord(SQCbInter[I*4+2] And 255) Shl 16) Or (LongWord(
   SQCbInter[I*4+3] And 255) Shl 24);
  SQCbDP[I]:=LongWord(SQCbIntra[I*4] And 255) Or (LongWord(SQCbIntra[I*4+1] And
   255) Shl 8) Or (LongWord(SQCbIntra[I*4+2] And 255) Shl 16) Or (LongWord(
   SQCbIntra[I*4+3] And 255) Shl 24);
 End;
End;

Function SQGet(N: LongInt): LongInt;
Var V: Int64; I,At: LongInt;
Begin
 If N=0 Then Begin SQGet:=0; Exit; End;
 At:=SQPos Shr 3; V:=0;
 For I:=0 To 4 Do Begin
  V:=V Shl 8;
  If (At+I>=0) And (At+I<SQSz) Then V:=V Or SQBuf^[At+I];
 End;
 V:=V Shr (40-(SQPos And 7)-N);
 SQGet:=V And ((Int64(1) Shl N)-1);
 Inc(SQPos,N);
End;

Function SQVlc(R: LongInt): LongInt;
Var N,B,C,K: LongInt;
Begin
 N:=SQRoot[R]; SQVlc:=-1;
 For K:=1 To 32 Do Begin
  B:=SQGet(1); C:=SQNd[N,B];
  If C=0 Then Exit;
  If C<0 Then Begin SQVlc:=-C-1; Exit; End;
  N:=C;
 End;
End;

Function SQRd32(P: PEABuffer; At: LongInt): Int64;
Begin SQRd32:=Int64(P^[At]) Or (Int64(P^[At+1]) Shl 8) Or (Int64(P^[At+2]) Shl
 16) Or (Int64(P^[At+3]) Shl 24); End;
Procedure SQWr32(P: PEABuffer; At: LongInt; V: Int64);
Begin P^[At]:=V And 255; P^[At+1]:=(V Shr 8) And 255; P^[At+2]:=(V Shr 16) And
 255; P^[At+3]:=(V Shr 24) And 255; End;

{ ecretage en voie 16 bits de SVQ1_ADD_CODEBOOK }
Function SQClip32(N: Int64): Int64;
Var N3: Int64;
Begin
 If (N And $FF00FF00)<>0 Then Begin
  N3:=((((N Shr 15) And $00010001) Or $01000100)-$00010001) And $FFFFFFFF;
  N:=(N+$7F007F00) And $FFFFFFFF;
  N:=N Or ((((((Not N) And $FFFFFFFF) Shr 15) And $00010001) Or $01000100)-
   $00010001);
  N:=N And $FFFFFFFF;
  N:=N And (N3 And $00FF00FF);
 End;
 SQClip32:=N;
End;

{ svq1_decode_block_intra / non_intra : Intra=True pour la premiere }
Function SQBlock(Intra: Boolean; P: PEABuffer; Off0,Pitch: LongInt): LongInt;
Var
 List: Array[0..63] Of LongInt; Ent: Array[0..5] Of LongInt;
 I,J,M,N,Level,Stages,Width,Height,X,Y,Dst,Cache,Step,K,CbBase: LongInt;
 Mean,N1,N2,N3,N4: Int64;
Begin
 SQBlock:=0;
 List[0]:=Off0; I:=0; M:=1; N:=1; Level:=5;
 While I<N Do Begin
  While Level>0 Do Begin
   If I=M Then Begin M:=N; Dec(Level); If Level=0 Then Break; End;
   If SQGet(1)=0 Then Break;
   List[N]:=List[I]; Inc(N);
   If (Level And 1)<>0 Then Step:=Pitch Shl ((Level Shr 1)+1) Else Step:=1 Shl (
    (Level Shr 1)+1);
   List[N]:=List[I]+Step; Inc(N);
   Inc(I);
  End;
  Dst:=List[I];
  Width:=1 Shl ((4+Level) Div 2); Height:=1 Shl ((3+Level) Div 2);
  If Intra Then Stages:=SQVlc(1+Level)-1 Else Stages:=SQVlc(7+Level)-1;
  If Stages=-2 Then Begin SQBlock:=-1; Exit; End;
  If Stages=-1 Then Begin
   If Intra Then For Y:=0 To Height-1 Do FillChar(P^[Dst+Y*Pitch],Width,0);
  End Else Begin
   If (Stages>0) And (Level>=4) Then Begin SQBlock:=-1; Exit; End;
   If Intra Then Begin
    Mean:=SQVlc(13); If Mean<0 Then Begin SQBlock:=-1; Exit; End;
   End Else Begin
    Mean:=SQVlc(14); If Mean<0 Then Begin SQBlock:=-1; Exit; End;
    Mean:=Mean-256;
    If SQBuggy Then Begin If Mean=-128 Then Mean:=128 Else If Mean=128 Then
     Mean:=-128; End;
   End;
   If Intra And (Stages=0) Then Begin
    For Y:=0 To Height-1 Do FillChar(P^[Dst+Y*Pitch],Width,Mean And 255);
   End Else Begin
    Case Level Of 0: CbBase:=0; 1: CbBase:=192; 2: CbBase:=576; Else CbBase:=
     1344; End;
    If Stages>0 Then Cache:=SQGet(4*Stages) Else Cache:=0;
    For J:=0 To Stages-1 Do Ent[J]:=(((Cache Shr (4*(Stages-J-1))) And $F)+16*J)
     Shl (Level+1);
    Mean:=(Mean-Stages*128) And $FFFFFFFF;
    N4:=((Mean Shl 16)+Mean) And $FFFFFFFF;
    K:=0;
    For Y:=0 To Height-1 Do Begin
     For X:=0 To (Width Div 4)-1 Do Begin
      If Intra Then Begin N1:=N4; N2:=N4; End Else Begin
       N3:=SQRd32(P,Dst+Y*Pitch+X*4);
       N1:=(N4+((N3 And $FF00FF00) Shr 8)) And $FFFFFFFF;
       N2:=(N4+(N3 And $00FF00FF)) And $FFFFFFFF;
      End;
      For J:=0 To Stages-1 Do Begin
       If Intra Then N3:=SQCbDP[CbBase+Ent[J]+K] Else N3:=SQCbDI[CbBase+Ent[J]+
        K];
       N3:=N3 Xor $80808080;
       N1:=(N1+((N3 And $FF00FF00) Shr 8)) And $FFFFFFFF;
       N2:=(N2+(N3 And $00FF00FF)) And $FFFFFFFF;
      End;
      N1:=SQClip32(N1); N2:=SQClip32(N2);
      SQWr32(P,Dst+Y*Pitch+X*4,((N1 Shl 8) Or N2) And $FFFFFFFF);
      Inc(K);
     End;
    End;
   End;
  End;
  Inc(I);
 End;
End;

Function SQMid(A,B,C: LongInt): LongInt;
Begin
 If A>B Then Begin If B>C Then SQMid:=B Else If A>C Then SQMid:=C Else SQMid:=A;
  End
 Else Begin If A>C Then SQMid:=A Else If B>C Then SQMid:=C Else SQMid:=B; End;
End;

Function SQSext6(V: LongInt): LongInt;
Begin V:=V And 63; If V>=32 Then V:=V-64; SQSext6:=V; End;

Function SQClipI(V,Lo,Hi: LongInt): LongInt;
Begin If V<Lo Then SQClipI:=Lo Else If V>Hi Then SQClipI:=Hi Else SQClipI:=V;
 End;

Function SQHalf(V: LongInt): LongInt;
Begin If V<0 Then SQHalf:=-((-V+1) Shr 1) Else SQHalf:=V Shr 1; End;

{ copie demi-pixel (hpeldsp put_pixels, arrondi standard) ; S = 16 ou 8 }
Procedure SQPut(Dst,Src: PEABuffer; DOff,SOff,Pitch,S,Dxy: LongInt);
Var X,Y,A,B,C,D: LongInt;
Begin
 For Y:=0 To S-1 Do
  For X:=0 To S-1 Do Begin
   A:=Src^[SOff+Y*Pitch+X];
   Case Dxy Of
    0: Dst^[DOff+Y*Pitch+X]:=A;
    1: Dst^[DOff+Y*Pitch+X]:=(A+Src^[SOff+Y*Pitch+X+1]+1) Shr 1;
    2: Dst^[DOff+Y*Pitch+X]:=(A+Src^[SOff+(Y+1)*Pitch+X]+1) Shr 1;
    Else Begin
     B:=Src^[SOff+Y*Pitch+X+1]; C:=Src^[SOff+(Y+1)*Pitch+X]; D:=Src^[SOff+(Y+1)*
      Pitch+X+1];
     Dst^[DOff+Y*Pitch+X]:=(A+B+C+D+2) Shr 2;
    End;
   End;
  End;
End;

{ svq1_decode_motion_vector : Dst et P0..P2 sont des indices dans SQMX/SQMY ;
 l'indice 1050 est le vecteur local "mv" }
Function SQMotionVec(Dst,P0,P1,P2: LongInt): LongInt;
Var Diff,I: LongInt;
Begin
 SQMotionVec:=0;
 For I:=0 To 1 Do Begin
  Diff:=SQVlc(15);
  If Diff<0 Then Begin SQMotionVec:=-1; Exit; End
  Else If Diff<>0 Then If SQGet(1)<>0 Then Diff:=-Diff;
  If I=1 Then SQMY[Dst]:=SQSext6(Diff+SQMid(SQMY[P0],SQMY[P1],SQMY[P2]))
  Else SQMX[Dst]:=SQSext6(Diff+SQMid(SQMX[P0],SQMX[P1],SQMX[P2]));
 End;
End;

Function SQDeltaBlock(Cur,Prev: PEABuffer; Pitch,X,Y,Width,Height: LongInt):
 LongInt;
Const MV=1050;
Var
 BT,I,R,Mvx,Mvy,P0,P1,P2,P3,Co,Sx,Sy,Q: LongInt; Cp: Array[0..3] Of LongInt;
Begin
 SQDeltaBlock:=0;
 BT:=SQVlc(0);
 If BT<0 Then Begin SQDeltaBlock:=-1; Exit; End;
 Q:=X Div 8;
 If (BT=0) Or (BT=3) Then Begin
  SQMX[0]:=0; SQMY[0]:=0; SQMX[Q+2]:=0; SQMY[Q+2]:=0; SQMX[Q+3]:=0; SQMY[Q+3]:=
   0;
 End;
 Co:=Y*Pitch+X;
 Case BT Of
  0: For I:=0 To 15 Do Move(Prev^[Co+I*Pitch],Cur^[Co+I*Pitch],16);
  1: Begin
   P0:=0;
   If Y=0 Then Begin P1:=P0; P2:=P0; End Else Begin P1:=Q+2; P2:=Q+4; End;
   R:=SQMotionVec(MV,P0,P1,P2); If R<>0 Then Begin SQDeltaBlock:=R; Exit; End;
   SQMX[0]:=SQMX[MV]; SQMX[Q+2]:=SQMX[MV]; SQMX[Q+3]:=SQMX[MV];
   SQMY[0]:=SQMY[MV]; SQMY[Q+2]:=SQMY[MV]; SQMY[Q+3]:=SQMY[MV];
   Mvx:=SQClipI(SQMX[MV],-2*X,2*(Width-X-16)); Mvy:=SQClipI(SQMY[MV],-2*Y,2*(
    Height-Y-16));
   Sx:=X+SQHalf(Mvx); Sy:=Y+SQHalf(Mvy);
   SQPut(Cur,Prev,Co,Sy*Pitch+Sx,Pitch,16,((Mvy And 1) Shl 1) Or (Mvx And 1));
   SQDeltaBlock:=SQBlock(False,Cur,Co,Pitch);
  End;
  2: Begin
   P0:=0;
   If Y=0 Then Begin P1:=P0; P2:=P0; End Else Begin P1:=Q+2; P2:=Q+4; End;
   R:=SQMotionVec(MV,P0,P1,P2); If R<>0 Then Begin SQDeltaBlock:=R; Exit; End;
   P0:=MV;
   If Y=0 Then Begin P1:=P0; P2:=P0; End Else P1:=Q+3;
   R:=SQMotionVec(0,P0,P1,P2); If R<>0 Then Begin SQDeltaBlock:=R; Exit; End;
   P1:=0; P2:=Q+1;
   R:=SQMotionVec(Q+2,P0,P1,P2); If R<>0 Then Begin SQDeltaBlock:=R; Exit; End;
   P2:=Q+2; P3:=Q+3;
   R:=SQMotionVec(P3,P0,P1,P2); If R<>0 Then Begin SQDeltaBlock:=R; Exit; End;
   Cp[0]:=MV; Cp[1]:=P1; Cp[2]:=P2; Cp[3]:=P3;
   For I:=0 To 3 Do Begin
    Mvx:=SQMX[Cp[I]]+(I And 1)*16; Mvy:=SQMY[Cp[I]]+(I Shr 1)*16;
    Mvx:=SQClipI(Mvx,-2*X,2*(Width-X-8)); Mvy:=SQClipI(Mvy,-2*Y,2*(Height-Y-8));
    Sx:=X+SQHalf(Mvx); Sy:=Y+SQHalf(Mvy);
    SQPut(Cur,Prev,Co,Sy*Pitch+Sx,Pitch,8,((Mvy And 1) Shl 1) Or (Mvx And 1));
    If (I And 1)<>0 Then Inc(Co,8*(Pitch-1)) Else Inc(Co,8);
   End;
   SQDeltaBlock:=SQBlock(False,Cur,Y*Pitch+X,Pitch);
  End;
  3: SQDeltaBlock:=SQBlock(True,Cur,Co,Pitch);
 End;
End;

{ svq1_decode_frame_header ; renvoie 0 si bon }
Function SQHeader: LongInt;
Var FSC,Csum,Len,I,TempRef: LongInt;
Begin
 SQHeader:=-1;
 TempRef:=SQGet(8);
 SQBuggy:=(TempRef=0) And (SQLastTempref=0) And Not SQHasExt;
 SQLastTempref:=TempRef;
 SQNonRef:=False;
 Case SQGet(2) Of
  0: SQIsI:=True;
  1: SQIsI:=False;
  2: Begin SQNonRef:=True; SQIsI:=False; End;
  Else Exit;
 End;
 If SQIsI Then Begin
  If (SQFrameCode=$50) Or (SQFrameCode=$60) Then Csum:=SQGet(16);
  If (SQFrameCode Xor $10)>=$50 Then Begin
   Len:=SQGet(8);
   For I:=1 To Len Do SQGet(8);
  End;
  SQGet(2); SQGet(2); SQGet(1);
  FSC:=SQGet(3);
  If FSC=7 Then Begin
   SQW:=SQGet(12); SQH:=SQGet(12);
   If (SQW=0) Or (SQH=0) Then Exit;
  End Else Begin SQW:=SQFrameSizes[FSC*2]; SQH:=SQFrameSizes[FSC*2+1]; End;
 End;
 If SQGet(1)<>0 Then Begin
  SQGet(1); SQGet(1);
  If SQGet(2)<>0 Then Exit;
 End;
 If SQGet(1)<>0 Then Begin
  SQGet(1); SQGet(4); SQGet(1); SQGet(2);
  If SQSz*8-SQPos<=0 Then Exit;
  While SQGet(1)<>0 Do Begin
   SQGet(8);
   If SQSz*8-SQPos<=0 Then Exit;
  End;
 End;
 If SQSz*8-SQPos<=0 Then Exit;
 SQHeader:=0;
End;

Procedure SQFreePlanes;
Var I: LongInt;
Begin
 For I:=0 To 2 Do Begin
  If SQCur[I]<>Nil Then Begin FreeMem(SQCur[I]); SQCur[I]:=Nil; End;
  If SQPrv[I]<>Nil Then Begin FreeMem(SQPrv[I]); SQPrv[I]:=Nil; End;
 End;
End;

Procedure SQAllocPlanes(W,H: LongInt);
Var I,PW,PHt: LongInt;
Begin
 SQFreePlanes;
 For I:=0 To 2 Do Begin
  If I=0 Then Begin PW:=(W+15) And Not 15; PHt:=(H+15) And Not 15; End
  Else Begin PW:=((W Div 4)+15) And Not 15; PHt:=((H Div 4)+15) And Not 15; End;
  SQPit[I]:=PW; SQPH[I]:=PHt;
  GetMem(SQCur[I],PW*PHt+64); FillChar(SQCur[I]^,PW*PHt+64,0);
  GetMem(SQPrv[I],PW*PHt+64); FillChar(SQPrv[I]^,PW*PHt+64,0);
 End;
 SQAW:=W; SQAH:=H; SQHavePrev:=False;
End;

{ decodage d'un paquet ; 0 = image produite dans SQCur, <0 = erreur }
Function SQDecode(Pk: PEABuffer; Sz: LongInt): LongInt;
Var
 Sw: PEABuffer; I,J,X,Y,W,H,R,Pitch: LongInt; A,B: Int64; Tmp: Array[0..7] Of
  Int64;
 T: PEABuffer;
Begin
 SQDecode:=-1;
 SQBuf:=Pk; SQSz:=Sz; SQPos:=0; Sw:=Nil;
 If Sz<1 Then Exit;
 SQFrameCode:=SQGet(22);
 If ((SQFrameCode And Not $70)<>0) Or ((SQFrameCode And $60)=0) Then Exit;
 If SQFrameCode<>$20 Then Begin
  If Sz<36 Then Exit;
  GetMem(Sw,Sz+64); FillChar(Sw^,Sz+64,0); Move(Pk^,Sw^,Sz);
  For I:=0 To 7 Do Tmp[I]:=SQRd32(Sw,4+4*I);
  For I:=0 To 3 Do Begin
   A:=Tmp[I]; B:=(((A Shl 16) Or (A Shr 16)) And $FFFFFFFF) Xor Tmp[7-I];
   SQWr32(Sw,4+4*I,B);
  End;
  SQBuf:=Sw; SQPos:=22;
 End;
 If SQHeader<>0 Then Begin If Sw<>Nil Then FreeMem(Sw); Exit; End;
 If SQIsI Then Begin
  If (SQAW<>SQW) Or (SQAH<>SQH) Or (SQCur[0]=Nil) Then SQAllocPlanes(SQW,SQH);
 End Else Begin
  If (Not SQHavePrev) Or (SQPrevW<>SQW) Or (SQPrevH<>SQH) Or (SQAW<>SQW) Or (
   SQAH<>SQH) Then Begin If Sw<>Nil Then FreeMem(Sw); Exit; End;
 End;
 R:=0;
 For I:=0 To 2 Do Begin
  Pitch:=SQPit[I]; W:=Pitch; H:=SQPH[I];
  If SQIsI Then Begin
   Y:=0;
   While (Y<H) And (R=0) Do Begin
    X:=0;
    While (X<W) And (R=0) Do Begin
     R:=SQBlock(True,SQCur[I],Y*Pitch+X,Pitch);
     Inc(X,16);
    End;
    Inc(Y,16);
   End;
  End Else Begin
   FillChar(SQMX,SizeOf(SQMX),0); FillChar(SQMY,SizeOf(SQMY),0);
   Y:=0;
   While (Y<H) And (R=0) Do Begin
    X:=0;
    While (X<W) And (R=0) Do Begin
     R:=SQDeltaBlock(SQCur[I],SQPrv[I],Pitch,X,Y,W,H);
     Inc(X,16);
    End;
    SQMX[0]:=0; SQMY[0]:=0;
    Inc(Y,16);
   End;
  End;
  If R<>0 Then Break;
 End;
 If Sw<>Nil Then FreeMem(Sw);
 If R<>0 Then Exit;
 SQDecode:=0;
End;

Procedure DecodeSVQ1(Const Source,Target: String; Mode: LongInt);
Var
 Pk,Out: PEABuffer; PIdx,Sz,I,Y,W,H,CW,CH,Code: LongInt; Begun: Boolean; T:
  PEABuffer;
Begin
 QXOpen(Source);
 SQInit;
 SQHasExt:=(Not QXIsMov) And (QXExtLen>0);
 SQLastTempref:=255; SQHavePrev:=False; SQAW:=0; SQAH:=0; SQW:=0; SQH:=0;
 FillChar(SQCur,SizeOf(SQCur),0); FillChar(SQPrv,SizeOf(SQPrv),0);
 Begun:=False; Out:=Nil; W:=0; H:=0;
 For PIdx:=0 To QXCount-1 Do Begin
  Sz:=QXLen^[PIdx]; If QXPos^[PIdx]+Sz>QXSize Then Sz:=QXSize-QXPos^[PIdx]; If (
   QXPos^[PIdx]<0) Or (QXPos^[PIdx]>QXSize) Or (Sz<0) Then Sz:=0;
  Pk:=PEABuffer(@QXF^[QXPos^[PIdx]]);
  Code:=SQDecode(Pk,Sz);
  If Code<>0 Then Begin If Begun Then NVRepeat; Continue; End;
  If Not Begun Then Begin
   W:=SQW; H:=SQH; CW:=(W+3) Shr 2; CH:=(H+3) Shr 2;
   NVBegin(Mode,Target,W,H,7,QXRn,QXRd);
   NVSubX:=2; NVSubY:=2; NVCW:=CW; NVCH:=CH; NVYTag:=
    'C420jpeg XYSCSS=420JPEG XCOLORRANGE=LIMITED'; NVTo420:=True; NVHdrOk:=True;
   If QXIsMov And (QXSarN>0) Then Begin NVSarN:=QXSarN; NVSarD:=QXSarD; End Else
    NVSarN:=0;
   If Not QXIsMov Then NVAviSar(W,H);
   GetMem(Out,NVFrameBytes+64);
   Begun:=True;
  End Else If (SQW<>W) Or (SQH<>H) Then Begin NVRepeat; Continue; End;
  CW:=(W+3) Shr 2; CH:=(H+3) Shr 2;
  For Y:=0 To H-1 Do Move(SQCur[0]^[Y*SQPit[0]],Out^[Y*W],W);
  For I:=1 To 2 Do
   For Y:=0 To CH-1 Do Begin
    FillChar(Out^[W*H+(I-1)*CW*CH+Y*CW],CW,0);
    If Y<SQPH[I] Then Begin
     If CW<=SQPit[I] Then Move(SQCur[I]^[Y*SQPit[I]],Out^[W*H+(I-1)*CW*CH+Y*CW],
      CW)
     Else Move(SQCur[I]^[Y*SQPit[I]],Out^[W*H+(I-1)*CW*CH+Y*CW],SQPit[I]);
    End;
   End;
  NVEmit(Out);
  If NVDone Then Break;
  If Not SQNonRef Then Begin
   For I:=0 To 2 Do Begin T:=SQCur[I]; SQCur[I]:=SQPrv[I]; SQPrv[I]:=T; End;
   SQHavePrev:=True; SQPrevW:=SQW; SQPrevH:=SQH;
  End;
 End;
 If Out<>Nil Then FreeMem(Out);
 SQFreePlanes;
 QXClose;
 NVFinish('svq1');
End;

