{ ---- Nellymoser (libavcodec/nellymoser.c, nellymoserdec.c, nellymoserenc.c,
 LGPL) ---- }
Var
 NyMap: Array[0..63] Of LongInt;
 NyExpRe,NyExpIm: Array[0..127] Of Single;
 NySine: Array[0..127] Of Single;
 NyReady: Boolean;
 NyPrev,NyOut: Array[0..127] Of Single;
 NyPow: Array[0..2047] Of Single;
 NyBuf: Array[0..383] Of Single;
 NyMdct: Array[0..255] Of Single;
 NyBufPos: LongInt;
 NyBitSrc: PEABuffer; NyBitPos: LongInt;

{ sinf de la glibc 2.31+ (sysdeps/ieee754/flt-32/s_sinf.c), pour 0 < x < PI/2 }
Function NySinf(Y: Single): Single;
Const HpiInv=10680707.430881744; Hpi=1.5707963267948966; C1=-
 0.49999999725108224; C2=0.041666623324344516;
 C3=-0.001388676379437604; C4=2.4390450703564542e-05; S1=-0.16666654943701084;
  S2=0.008332178146138854; S3=-0.00019517298981385725;
Var X,X2,X3,X4,X6,X7,Sv,Cc,Cc1,Cc2,Sa: Double; N: LongInt; R: Single;
Begin
 X:=Y;
 If X<0.7853981852531433 Then Begin
  X2:=X*X;
  X3:=X*X2; Sa:=S2+X2*S3; X7:=X3*X2; Sv:=X+X3*S1;
  R:=Sv+X7*Sa; NySinf:=R;
 End Else Begin
  X:=X*HpiInv; N:=(Trunc(X)+$800000) Shr 24;
  X:=Y; X:=X-N*Hpi;
  X2:=X*X; X4:=X2*X2; Cc2:=C3+X2*C4; Cc1:=1.0+X2*C1; X6:=X4*X2; Cc:=Cc1+X4*C2;
  R:=Cc+X6*Cc2; NySinf:=R;
 End;
End;

Procedure NyInitTables;
Var I: LongInt; Alpha,Dv,Tm: Double; Sg: Single;
Begin
 If NyReady Then Exit;
 IMCInit;
 NyReady:=True;
 For I:=0 To 63 Do NyMap[I]:=(-IMCSplitPerm(I,64,1)) And 63;
 For I:=0 To 63 Do Begin
  Alpha:=(IMCPi/2)*(I+0.125)/64;
  Dv:=Cos(Alpha); NyExpRe[64+I]:=Dv; Dv:=Sin(Alpha); NyExpIm[64+I]:=Dv;
 End;
 For I:=0 To 63 Do Begin NyExpRe[I]:=NyExpRe[64+NyMap[I]]; NyExpIm[I]:=NyExpIm[
  64+NyMap[I]]; End;
 For I:=0 To 63 Do NyMap[I]:=NyMap[I] Shl 1;
 For I:=0 To 127 Do Begin Sg:=(I+0.5)*(IMCPi/(2.0*128)); NySine[I]:=NySinf(Sg);
  End;
 { table de puissances de l'encodeur }
 NyPow[0]:=1; NyPow[1024]:=Sqrt(0.5);
 For I:=1 To 512 Do Begin
  Tm:=Exp(-I/2048.0*Ln(2.0));
  NyPow[I]:=Tm; NyPow[1024-I]:=0.70710678118654752440/Tm; NyPow[1024+I]:=Tm*
   0.70710678118654752440; NyPow[2048-I]:=0.5/Tm;
 End;
End;

{ MDCT inverse a 128 coefficients -> 128 echantillons (tx_template.c
 ff_tx_mdct_inv, versions C) }
Procedure NyImdct(Const Src: Array Of Single; Var Dst: Array Of Single);
Var I,K,I0,I1: LongInt; Tr,Ti,S1r,S1i,S0r,S0i: Single;
Begin
 For I:=0 To 63 Do Begin
  K:=NyMap[I];
  Tr:=Src[127-K]; Ti:=Src[K];
  IMCZr[I]:=Tr*NyExpRe[I]-Ti*NyExpIm[I];
  IMCZi[I]:=Tr*NyExpIm[I]+Ti*NyExpRe[I];
 End;
 IMCFft(64,0,6);
 For I:=0 To 31 Do Begin
  I0:=32+I; I1:=31-I;
  S1r:=IMCZi[I1]; S1i:=IMCZr[I1];
  S0r:=IMCZi[I0]; S0i:=IMCZr[I0];
  IMCZr[I1]:=S1r*NyExpIm[64+I1]-S1i*NyExpRe[64+I1];
  IMCZi[I0]:=S1r*NyExpRe[64+I1]+S1i*NyExpIm[64+I1];
  IMCZr[I0]:=S0r*NyExpIm[64+I0]-S0i*NyExpRe[64+I0];
  IMCZi[I1]:=S0r*NyExpRe[64+I0]+S0i*NyExpIm[64+I0];
 End;
 For I:=0 To 63 Do Begin Dst[2*I]:=IMCZr[I]; Dst[2*I+1]:=IMCZi[I]; End;
End;

Function NySar(V,N: LongInt): LongInt;
Begin
 If V>=0 Then NySar:=V Shr N Else NySar:=-LongInt((-Int64(V)+(Int64(1) Shl N)-1)
  Shr N);
End;

Function NySShift(I,Sh: LongInt): LongInt;
Begin
 If Sh>0 Then NySShift:=LongInt(LongWord(I) Shl Sh) Else NySShift:=NySar(I,-Sh);
End;

Function NyLog2i(X: LongInt): LongInt;
Var R: LongInt;
Begin R:=0; While X>1 Do Begin X:=X Shr 1; Inc(R); End; NyLog2i:=R; End;

Function NyHeadroom(Var La: LongInt): LongInt;
Var L: LongInt;
Begin
 If La=0 Then Begin NyHeadroom:=31; Exit; End;
 L:=30-NyLog2i(Abs(La));
 La:=LongInt(LongWord(La) Shl L);
 NyHeadroom:=L;
End;

Function NyClip(V,Lo,Hi: LongInt): LongInt;
Begin If V<Lo Then V:=Lo; If V>Hi Then V:=Hi; NyClip:=V; End;

Function NySumBits(Var Buf: Array Of SmallInt; Shift,Off: LongInt): LongInt;
Var I,B,R: LongInt;
Begin
 R:=0;
 For I:=0 To 123 Do Begin
  B:=Buf[I]-Off;
  B:=NySar(NySar(B,Shift-1)+1,1);
  Inc(R,NyClip(B,0,6));
 End;
 NySumBits:=R;
End;

Procedure NyGetBits(Const Buf: Array Of Single; Var Bits: Array Of LongInt);
Var
 SBuf: Array[0..127] Of SmallInt; I,J,Max,Sum,Shift,ShiftSaved,SmallOff,BigOff,
  Off,Tmp,BitSum,LastBitSum,SmallBitSum,BigBitSum,LastOff: LongInt; T: Single;
Begin
 Max:=0;
 For I:=0 To 123 Do If Buf[I]>Max Then Max:=Trunc(Buf[I]);
 Shift:=-16;
 Inc(Shift,NyHeadroom(Max));
 Sum:=0;
 For I:=0 To 123 Do Begin
  SBuf[I]:=NySShift(Trunc(Buf[I]),Shift);
  SBuf[I]:=NySar(3*SBuf[I],2);
  Inc(Sum,SBuf[I]);
 End;
 Inc(Shift,11);
 ShiftSaved:=Shift;
 Dec(Sum,LongInt(LongWord(198) Shl Shift));
 Inc(Shift,NyHeadroom(Sum));
 SmallOff:=NySar(4228*NySar(Sum,16),15);
 Shift:=ShiftSaved-(19+Shift-31);
 SmallOff:=NySShift(SmallOff,Shift);
 BitSum:=NySumBits(SBuf,ShiftSaved,SmallOff);
 If BitSum<>198 Then Begin
  Off:=BitSum-198;
  Shift:=0;
  While Abs(Off)<=16383 Do Begin Off:=Off*2; Inc(Shift); End;
  Off:=NySar(Off*4228,15);
  Shift:=ShiftSaved-(19+Shift-15);
  Off:=NySShift(Off,Shift);
  LastOff:=SmallOff; LastBitSum:=BitSum;
  J:=1;
  While J<20 Do Begin
   LastOff:=SmallOff;
   Inc(SmallOff,Off);
   LastBitSum:=BitSum;
   BitSum:=NySumBits(SBuf,ShiftSaved,SmallOff);
   If (BitSum-198)*(LastBitSum-198)<=0 Then Break;
   Inc(J);
  End;
  If BitSum>198 Then Begin
   BigOff:=SmallOff; SmallOff:=LastOff; BigBitSum:=BitSum; SmallBitSum:=
    LastBitSum;
  End Else Begin
   BigOff:=LastOff; BigBitSum:=LastBitSum; SmallBitSum:=BitSum;
  End;
  While (BitSum<>198) And (J<=19) Do Begin
   Off:=NySar(BigOff+SmallOff,1);
   BitSum:=NySumBits(SBuf,ShiftSaved,Off);
   If BitSum>198 Then Begin BigOff:=Off; BigBitSum:=BitSum; End
   Else Begin SmallOff:=Off; SmallBitSum:=BitSum; End;
   Inc(J);
  End;
  If Abs(BigBitSum-198)>=Abs(SmallBitSum-198) Then BitSum:=SmallBitSum
  Else Begin SmallOff:=BigOff; BitSum:=BigBitSum; End;
 End;
 For I:=0 To 123 Do Begin
  Tmp:=SBuf[I]-SmallOff;
  Tmp:=NySar(NySar(Tmp,ShiftSaved-1)+1,1);
  Bits[I]:=NyClip(Tmp,0,6);
 End;
 If BitSum>198 Then Begin
  Tmp:=0; I:=0;
  While Tmp<198 Do Begin Inc(Tmp,Bits[I]); Inc(I); End;
  Dec(Bits[I-1],Tmp-198);
  While I<124 Do Begin Bits[I]:=0; Inc(I); End;
 End;
End;

Function NyGet(N: LongInt): LongInt;
Var K,V: LongInt;
Begin
 V:=0;
 For K:=0 To N-1 Do
  If (NyBitSrc^[(NyBitPos+K) Shr 3] Shr ((NyBitPos+K) And 7)) And 1<>0 Then V:=V
   Or (1 Shl K);
 Inc(NyBitPos,N);
 NyGet:=V;
End;

{ decode un bloc de 64 octets (Blk) en 256 echantillons flottants }
Procedure NyDecodeBlock(Blk: PEABuffer; Var Audio: Array Of Single);
Var
 I,J,Sub,V: LongInt; Buf,Pows: Array[0..123] Of Single; Bits: Array[0..127] Of
  LongInt; Val,Pval: Single; Dv: Double; Sg: Single;
 S0,S1,Wi: Single; Tmp: Array[0..127] Of Single; Aptr: LongInt;
Begin
 NyBitSrc:=Blk; NyBitPos:=0;
 J:=0;
 Val:=NyInit[NyGet(6)];
 For I:=0 To 22 Do Begin
  If I>0 Then Val:=Val+NyDelta[NyGet(5)];
  Dv:=Val*(1.0/2048); Dv:=Exp(Ln(2.0)*Dv);
  Dv:=-Dv*(1.0/(32768*8));
  Pval:=Dv;
  For V:=1 To NyBand[I] Do Begin Buf[J]:=Val; Pows[J]:=Pval; Inc(J); End;
 End;
 NyGetBits(Buf,Bits);
 For Sub:=0 To 1 Do Begin
  Aptr:=Sub*128;
  NyBitSrc:=Blk; NyBitPos:=116+Sub*198;
  For J:=0 To 123 Do Begin
   If Bits[J]<=0 Then Begin
    Dv:=0.70710678118654752440*Pows[J]; Sg:=Dv; Audio[Aptr+J]:=Sg;
    If (CKLfgGet And 1)<>0 Then Audio[Aptr+J]:=-Audio[Aptr+J];
   End Else Begin
    V:=NyGet(Bits[J]);
    Audio[Aptr+J]:=NyDequant[(1 Shl Bits[J])-1+V]*Pows[J];
   End;
  End;
  For J:=124 To 127 Do Audio[Aptr+J]:=0;
  For J:=0 To 127 Do Tmp[J]:=Audio[Aptr+J];
  NyImdct(Tmp,NyOut);
  { vector_fmul_window(aptr, prev+64, out, sine, 64) }
  For J:=0 To 63 Do Begin
   S0:=NyPrev[64+J];
   S1:=NyOut[63-J];
   Audio[Aptr+J]:=S0*NySine[127-J]-S1*NySine[J];
   Audio[Aptr+127-J]:=S0*NySine[J]+S1*NySine[127-J];
  End;
  { echange prev/out }
  For J:=0 To 127 Do Begin Wi:=NyPrev[J]; NyPrev[J]:=NyOut[J]; NyOut[J]:=Wi;
   End;
 End;
End;

Procedure NyReset;
Var I: LongInt;
Begin
 NyInitTables;
 FillChar(NyPrev,SizeOf(NyPrev),0); FillChar(NyOut,SizeOf(NyOut),0);
 For I:=0 To 63 Do CKLfg[I]:=CKLfgInit[I];
 CKLfgIdx:=0;
End;

{ FLV audio-seul Nellymoser vers WAV (flottant si une sortie PCM native est
 demandee, sinon PCM 16 bits) }
Procedure DecodeNellyFLV(Const Source,Target: String);
Var
 H: Array[0..15] Of Byte; Limit,Pos,Size,Rate,Blocks,Total,K,Fmt,Take,J:
  LongInt; Found: Boolean; Buf: PEABuffer;
 Audio: Array[0..255] Of Single; Sp: TPcmSpec; Out: TPcmBuf; N,V: LongInt; Fl:
  Single;
Begin
 NyReset;
 OpenRead(Source); Limit:=InputSize; Found:=False; Rate:=0;
 If Limit<13 Then Fail('flv: fichier tronque.');
 ReadAt(0,H,9);
 If (H[0]<>70) Or (H[1]<>76) Or (H[2]<>86) Then Fail(
  'flv: signature FLV requise.');
 Pos:=LongInt(H[5])*16777216+LongInt(H[6])*65536+LongInt(H[7])*256+H[8]+4;
 Blocks:=0;
 { passe 1 : nombre de blocs }
 While Limit-Pos>=12 Do Begin
  ReadAt(Pos,H,12);
  Size:=LongInt(H[1])*65536+LongInt(H[2])*256+H[3];
  If Pos+11+Size>Limit Then Break;
  If (H[0]=8) And (Size>1) Then Begin
   Fmt:=H[11] Shr 4;
   If (Fmt<4) Or (Fmt>6) Then Fail(
    'flv: codec audio non pris en charge (ADPCM ou Nellymoser).');
   If Not Found Then Begin
    Found:=True;
    Case Fmt Of 4: Rate:=16000; 5: Rate:=8000; Else Rate:=44100 Shr (3-((H[11]
     Shr 2) And 3)); End;
    If Fmt=6 Then Case (H[11] Shr 2) And 3 Of 0: Rate:=5512; 1: Rate:=11025; 2:
     Rate:=22050; Else Rate:=44100; End;
   End;
   Inc(Blocks,(Size-1) Div NELLY_BLK);
  End;
  Pos:=Pos+11+Size+4;
 End;
 If Not Found Or (Blocks=0) Then Fail('flv: aucune donnee audio Nellymoser.');
 If PcmCodecOut<>'' Then PcmSpecOf('f32le',Sp) Else PcmSpecOf('s16le',Sp);
 OpenWrite(Target);
 PcmNativeHeader(Sp,1,Rate,Blocks*256);
 WriteBytes(PcmH,PcmHN);
 Pos:=LongInt(0);
 ReadAt(0,H,9);
 Pos:=LongInt(H[5])*16777216+LongInt(H[6])*65536+LongInt(H[7])*256+H[8]+4;
 While Limit-Pos>=12 Do Begin
  ReadAt(Pos,H,12);
  Size:=LongInt(H[1])*65536+LongInt(H[2])*256+H[3];
  If Pos+11+Size>Limit Then Break;
  If (H[0]=8) And (Size>1) Then Begin
   GetMem(Buf,Size+64); K:=0;
   While K<Size-1 Do Begin
    If Size-1-K>16384 Then Take:=16384 Else Take:=Size-1-K;
    ReadAt(Pos+12+K,Buf^[K],Take); Inc(K,Take);
   End;
   For K:=0 To (Size-1) Div NELLY_BLK-1 Do Begin
    NyDecodeBlock(PEABuffer(@Buf^[K*NELLY_BLK]),Audio);
    N:=0;
    For J:=0 To 255 Do Begin
     If PcmCodecOut<>'' Then Begin PcmPutF(Sp,Out,N,Audio[J]); Inc(N,4); End
     Else Begin
      Fl:=Audio[J]*32768.0; V:=PcmRint(Fl);
      If V>32767 Then V:=32767; If V<-32768 Then V:=-32768;
      Out[N]:=V And 255; Out[N+1]:=(V Shr 8) And 255; Inc(N,2);
     End;
    End;
    PcmWriteBig(Out,N);
   End;
   FreeMem(Buf,Size+64);
  End;
  Pos:=Pos+11+Size+4;
 End;
 CloseRead; CloseWrite;
End;

{ ---- encodeur ---- }
Var NyWPos: LongInt; NyWBuf: Array[0..63] Of Byte;
Procedure NyPut(N,V: LongInt);
Var K: LongInt;
Begin
 For K:=0 To N-1 Do Begin
  If ((V Shr K) And 1)<>0 Then NyWBuf[NyWPos Shr 3]:=NyWBuf[NyWPos Shr 3] Or (1
   Shl (NyWPos And 7));
  Inc(NyWPos);
 End;
End;

Function NyLrint(X: Single): LongInt;
Begin NyLrint:=PcmRint(X); End;

Procedure NyApplyMdct;
Var I,J,K: LongInt; Win: Array[0..255] Of Double; Sum: Double;
Procedure One(A,B: LongInt; OutOff: LongInt);
Var Q,R: LongInt; Inp: Array[0..255] Of Single; Sg: Single;
Begin
 For Q:=0 To 127 Do Inp[Q]:=NyBuf[A+Q]*NySine[Q];
 For Q:=0 To 127 Do Inp[128+Q]:=NyBuf[B+Q]*NySine[127-Q];
 For Q:=0 To 127 Do Begin
  Sum:=0;
  For R:=0 To 255 Do Sum:=Sum+Inp[R]*Cos(((2*R+1+128)*(2*Q+1))*(IMCPi/(4.0*
   128)));
  Sum:=Sum*32768.0;
  Sg:=Sum; NyMdct[OutOff+Q]:=Sg;
 End;
End;
Begin
 One(0,128,0);
 One(128,256,128);
End;

Procedure NyEncodeBlock(Var Blk: Array Of Byte);
Var
 I,J,Band,BestIdx,PowerIdx,Block,Bi: LongInt; Cand: Array[0..22] Of Single;
  Pows: Array[0..123] Of Single; Bits: Array[0..127] Of LongInt;
 IdxTable: Array[0..22] Of LongInt; CoeffSum,PowerVal,Coeff,PCand: Single; Dv:
  Double;
Function FindBest(Val: Single; Const Tab: Array Of LongInt; Const Lut: Array Of
 Byte; LutAdd,LutSize: LongInt): LongInt;
Var Bx: LongInt; T0,T1,D0,D1: Single;
Begin
 Bx:=Lut[NyClip(NySar(NyLrint(Val),8)+LutAdd,0,LutSize-1)];
 T0:=Tab[Bx]; T1:=Tab[Bx+1]; D0:=Val-T0; D1:=Val-T1;
 If Abs(D0)>Abs(D1) Then Inc(Bx);
 FindBest:=Bx;
End;
Var InitT: Array[0..63] Of LongInt; DeltaT: Array[0..31] Of LongInt; Fv: Single;
Begin
 For I:=0 To 63 Do InitT[I]:=NyInit[I];
 For I:=0 To 31 Do DeltaT[I]:=NyDelta[I];
 NyApplyMdct;
 FillChar(NyWBuf,SizeOf(NyWBuf),0); NyWPos:=0;
 I:=0;
 For Band:=0 To 22 Do Begin
  CoeffSum:=0;
  For J:=1 To NyBand[Band] Do Begin
   CoeffSum:=CoeffSum+(NyMdct[I]*NyMdct[I]+NyMdct[I+128]*NyMdct[I+128]);
   Inc(I);
  End;
  Fv:=NyBand[Band] Shl 7; Fv:=CoeffSum/Fv; Dv:=Fv;
  If Dv<1.0 Then Dv:=1.0;
  Cand[Band]:=Ln(Dv)/Ln(2.0)*1024.0;
 End;
 { exposants (algorithme glouton) }
 IdxTable[0]:=FindBest(Cand[0],InitT,NySfLut,-20,96);
 PowerIdx:=InitT[IdxTable[0]];
 For Band:=1 To 22 Do Begin
  Fv:=PowerIdx; PCand:=Cand[Band]-Fv;
  IdxTable[Band]:=FindBest(PCand,DeltaT,NySfDelta,37,78);
  Inc(PowerIdx,DeltaT[IdxTable[Band]]);
 End;
 I:=0; PowerIdx:=0;
 For Band:=0 To 22 Do Begin
  If Band>0 Then Begin
   Inc(PowerIdx,DeltaT[IdxTable[Band]]); NyPut(5,IdxTable[Band]);
  End Else Begin
   PowerIdx:=InitT[IdxTable[0]]; NyPut(6,IdxTable[0]);
  End;
  PowerVal:=NyPow[PowerIdx And $7FF]/(1 Shl ((PowerIdx Shr 11)+3));
  For J:=1 To NyBand[Band] Do Begin
   NyMdct[I]:=NyMdct[I]*PowerVal; NyMdct[I+128]:=NyMdct[I+128]*PowerVal;
   Pows[I]:=PowerIdx;
   Inc(I);
  End;
 End;
 NyGetBits(Pows,Bits);
 For Block:=0 To 1 Do Begin
  For I:=0 To 123 Do If Bits[I]>0 Then Begin
   Coeff:=NyMdct[Block*128+I];
   Fv:=Coeff*NyQMul[Bits[I]]+NyQAdd[Bits[I]];
   Bi:=NyQuantLut[NyClip(Trunc(Fv),NyQOff[Bits[I]],NyQOff[Bits[I]+1]-1)];
   Fv:=Coeff-NyDequant[(1 Shl Bits[I])-1+Bi]; PCand:=Coeff-NyDequant[(1 Shl
    Bits[I])-1+Bi+1];
   If Abs(Fv)>Abs(PCand) Then Inc(Bi);
   NyPut(Bits[I],Bi);
  End;
  If Block=0 Then NyPut(116+198-NyWPos,0);
 End;
 For I:=0 To 63 Do Blk[I]:=NyWBuf[I];
End;

{ WAV mono (ou stereo ramene a une voie) vers FLV Nellymoser }
Procedure EncodeNellyFLV(Const Source,Target: String);
Var
 S,Fl: TPcmSpec; Ch,Rate,DS,DSz,Frames,Done,N,I,J,Used,Ts,Blk,Flag,RateCode:
  LongInt; BI,BO: TPcmBuf; Smp: PEABuffer; Mono: Array[0..1023] Of Single;
 Pk: Array[0..63] Of Byte; Out: Array[0..255] Of Byte; Frame: Array[0..255] Of
  Single; Last,Flush: Boolean; Fv: Single; Total: LongInt;
Procedure PutB(X: LongInt);Begin Out[Used]:=X And 255; Inc(Used); End;
Procedure PutBE24(X: LongInt);Begin PutB(X Shr 16); PutB(X Shr 8); PutB(X); End;
Procedure PutBE32(X: LongInt);Begin PutB(X Shr 24); PutBE24(X); End;
Procedure FlushOut;Begin If Used>0 Then Begin WriteBytes(Out,Used); Used:=0;
 End; End;
Procedure Emit;
Begin
 NyEncodeBlock(Pk);
 Ts:=Round(Int64(Blk)*256000/Rate+0.4999);
 Used:=0;
 PutB(8); PutBE24(65); PutBE24(Ts And $FFFFFF); PutB(Ts Shr 24); PutBE24(0);
 PutB(Flag);
 FlushOut; WriteBytes(Pk,64);
 PutBE32(76); FlushOut;
 Inc(Blk);
End;
Begin
 NyReset;
 If Not PcmOpenSource(Source,S,Ch,Rate,DS,DSz) Then Fail(
  'nellymoser: source WAV PCM requise.');
 CloseRead;
 If Ch>2 Then Fail('nellymoser: audio mono requis (-ac 1).');
 Case Rate Of
  8000: Flag:=$52; 16000: Flag:=$42; 11025: Flag:=$66; 22050: Flag:=$6A; 44100:
   Flag:=$6E;
  Else Fail(
   'nellymoser: frequence 8000, 11025, 16000, 22050 ou 44100 Hz (utiliser -ar)'+
   '.');
 End;
 PcmSpecOf('f32le',Fl);
 Frames:=DSz Div (Ch*S.Bytes);
 If Frames<1 Then Fail('nellymoser: aucune donnee audio.');
 OpenWrite(Target); OpenRead(Source);
 Used:=0;
 PutB(70); PutB(76); PutB(86); PutB(1); PutB(4); PutBE32(9); PutBE32(0);
  FlushOut;
 FillChar(NyBuf,SizeOf(NyBuf),0);
 Done:=0; Blk:=0; Last:=False; Flush:=False;
 { chaque appel : 256 nouveaux echantillons ; derniere trame eventuellement
  partielle }
 Repeat
  { decale le tampon }
  For I:=0 To 127 Do NyBuf[I]:=NyBuf[256+I];
  N:=256; If Frames-Done<N Then N:=Frames-Done;
  If Flush Then N:=0;
  FillChar(Frame,SizeOf(Frame),0);
  I:=0;
  While I<N Do Begin
   J:=N-I; If J>1024 Then J:=1024;
   PcmReadBig(DS+(Done+I)*Ch*S.Bytes,BI,J*Ch*S.Bytes);
   PcmChunk(S,Fl,Ch,J,BI,BO);
   For Total:=0 To J-1 Do Begin
    Move(BO[Total*Ch*4],Mono[0],4);
    If Ch=2 Then Begin Move(BO[Total*8+4],Mono[1],4); Mono[0]:=(Mono[0]+Mono[
     1])*0.5; End;
    Frame[I+Total]:=Mono[0];
   End;
   Inc(I,J);
  End;
  For I:=0 To 255 Do NyBuf[128+I]:=Frame[I];
  If N<256 Then Begin
   If N>=128 Then Last:=True;
  End;
  Emit;
  Inc(Done,N);
  If Flush Then Last:=True;
  If (Not Last) And (Done>=Frames) Then Flush:=True;
 Until Last;
 CloseRead; CloseWrite;
End;


Procedure NormalizeWave(Const Source,Target: String; ForMP3: Boolean);
Type
 TBytes = Array[0..4095] Of Byte;
Var
 B: TBytes;
 Cache: TBytes;
 OutBuffer: TBytes;
 Position,Limit,Size,DataStart,DataSize,Rate,Frames,OutFrames,OutRate,J,Index,
 CacheBase: LongInt;
 Channels,Bits,Align,OutChannels,CacheFrames,C,Used: Integer;
 HasFormat,HasData: Boolean;
 Fraction,Value,Left,Right,ExactFrames: Double;

Function U16(At: Integer): Word;Begin
 U16:=Word(B[At])+Word(B[At+1])*256;
End;

Function U32(At: Integer): LongInt;Begin
 If B[At+3]>=128 Then Fail('Champ WAV trop grand.');
 U32:=LongInt(B[At])+LongInt(B[At+1])*256+LongInt(B[At+2])*65536+LongInt(B[At+
  3])*
 16777216;
End;

Function Tag(Const S: String): Boolean;
Var
 A: Integer;
 Equal: Boolean;
Begin
 Equal:=True;
 For A:=1 To 4 Do If B[A-1]<>Ord(S[A]) Then Equal:=False; Tag:=Equal;
End;

Procedure Put16(V: Word);Begin
 B[0]:=V And 255; B[1]:=V Shr 8; WriteBytes(B,2);
End;

Procedure Put32(V: LongInt);
Var
 A: Integer;
Begin
 For A:=0 To 3 Do Begin
  B[A]:=V And 255; V:=V Shr 8;
 End; WriteBytes(B,4);
End;

Procedure PutTag(S: String);Begin
 WriteBytes(S[1],4);
End;

Function Sample(N: LongInt; Ch: Integer): Double;
Var
 P,Bytes: Integer;
 V: LongInt;
W: Int64;

Begin
 If N>=Frames Then N:=Frames-1;
 If (CacheBase<0) Or (N<CacheBase) Or (N>=CacheBase+CacheFrames) Then Begin
  CacheBase:=N; CacheFrames:=4096 Div Align;
  If Frames-N<CacheFrames Then CacheFrames:=Frames-N;
  ReadAt(DataStart+N*Align,Cache,CacheFrames*Align);
 End;
 Bytes:=Bits Div 8; P:=(N-CacheBase)*Align+Ch*Bytes;
 If Bits=8 Then V:=(LongInt(Cache[P])-128)*256
  Else
If Bits>16 Then Begin
  { conversion S32 -> S16 de swresample : ((x>>15)+1)>>1 avec saturation }
  W:=Int64(Cache[P+Bytes-1]);
  If W>=128 Then W:=W-256;
  W:=W*256+Cache[P+Bytes-2];
  If Bytes=4 Then Begin W:=W*256+Cache[P+1]; W:=W*256+Cache[P]; W:=W Div 32768-
   Ord((W Mod 32768<0)); End
  Else Begin W:=W*256+Cache[P]; W:=W Div 128-Ord((W Mod 128<0)); End;
  W:=(W+1) Div 2-Ord((W+1<0) And (((W+1) Mod 2)<>0));
  If W>32767 Then W:=32767; If W< -32768 Then W:=-32768;
  V:=W;
 End Else

 Begin
  V:=LongInt(Cache[P+Bytes-2])+LongInt(Cache[P+Bytes-1])*256;
  If V>=32768 Then Dec(V,65536);
 End;
 Sample:=V;
End;
Begin
 If SwrNormalize(Source,Target,ForMP3) Then Exit;

 OpenRead(Source); Limit:=InputSize;
 If Limit<12 Then Fail('WAV tronque.');
 ReadAt(0,B,12);
 If Not Tag('RIFF') Or (B[8]<>87) Or (B[9]<>65) Or (B[10]<>86) Or (B[11]<>69)
  Then Fail(
 'WAV RIFF requis.');
 Size:=U32(4); If (Size<4) Or (Size>Limit-8) Then Fail(
  'Taille RIFF incorrecte.');
 Limit:=Size+8; Position:=12; HasFormat:=False; HasData:=False;
 DataStart:=0; DataSize:=0; Rate:=0; Channels:=0; Align:=0; Bits:=0;
 While Position<Limit Do Begin
  If Limit-Position<8 Then Fail('Bloc WAV tronque.');
  ReadAt(Position,B,8); Size:=U32(4); Inc(Position,8);
  If Size>Limit-Position Then Fail('Bloc WAV tronque.');
  If Tag('fmt ') Then Begin
   If HasFormat Or (Size<16) Then Fail('Bloc fmt incorrect.');
   ReadAt(Position,B,16);
   If (U16(0)<>1) And Not ((U16(0)=$FFFE) And (Size>=40)) Then Fail(
   'WAV PCM entier requis.');
   Channels:=U16(2); Rate:=U32(4); Bits:=U16(14); Align:=U16(12);
   If Not (Channels In [1.. 255 ]) Or Not (Bits In [8,16,24,32]) Or (Rate<4000)
    Or (Rate>
   3000000 ) Then Fail('Format PCM non pris en charge.');
{ F6B }

   If (Align<>Channels*(Bits Div 8)) Or (U32(8)<>Rate*Align) Then Fail(
   'Alignement PCM incorrect.');
   HasFormat:=True;
  End Else If Tag('data') Then Begin
   If HasData Then Fail('Plusieurs blocs data non pris en charge.');
   DataStart:=Position; DataSize:=Size; HasData:=True;
  End;
  Inc(Position,Size);
  If Odd(Size) Then Begin
   If Position>=Limit Then Fail('Bourrage WAV manquant.'); Inc(Position);
  End;
 End;
 If Not HasFormat Or Not HasData Then Fail('Blocs WAV manquants.');
 If (DataSize=0) Or (DataSize Mod Align<>0) Then Fail(
  'Donnees PCM vides ou tronquees.');
 Frames:=DataSize Div Align; OutRate:=RequestedRate;
 If OutRate=0 Then Begin
  OutRate:=Rate;
  If ForMP3 And (Rate<>32000) And (Rate<>44100) And (Rate<>48000) Then OutRate:=
   44100;
 End;
 If ForMP3 And (OutRate<>32000) And (OutRate<>44100) And (OutRate<>48000) Then
  Fail(
 'MP3: -ar 32000, 44100 ou 48000 requis.');
 OutChannels:=RequestedChannels; If OutChannels=0 Then OutChannels:=Channels;
 If Channels>2 Then Begin
  If (OutChannels<>Channels) Or (OutRate<>Rate) Or ForMP3 Then Fail(
  'Audio multicanal (plus de 2 canaux): conversion de canaux, de frequence ou '+
   'sortie MP3 non prise en charge.');
  CloseRead; OpenRead(Source);
  OpenWrite(Target);
  Position:=0;
  While Position<Limit Do Begin
   If Limit-Position>4096 Then Frames:=4096 Else Frames:=Limit-Position;
   ReadAt(Position,Cache,Frames); WriteBytes(Cache,Frames); Inc(Position,
    Frames);
  End;
  CloseRead; CloseWrite; Exit;
 End;
 ExactFrames:=Frames*(OutRate*1.0)/Rate;
 If ExactFrames>(2147483600 Div (OutChannels*2)) Then Fail(
  'Sortie PCM depassant 2 Go.');
 OutFrames:=Round(ExactFrames); If OutFrames<1 Then OutFrames:=1;
 OpenWrite(Target);
 If OutRate>48000 Then Begin { F6B: WAVE_FORMAT_EXTENSIBLE comme ffmpeg }
  PutTag('RIFF'); Put32(60+OutFrames*OutChannels*2); PutTag('WAVE');
  PutTag('fmt '); Put32(40); Put16($FFFE); Put16(OutChannels); Put32(OutRate);
  Put32(OutRate*OutChannels*2); Put16(OutChannels*2); Put16(16); Put16(22);
   Put16(16);
  If OutChannels=1 Then Put32(4) Else Put32(3);
  Put32(1); Put32($00100000); Put32(LongInt($AA000080)); Put32($719B3800);
 End Else Begin

 PutTag('RIFF'); Put32(36+OutFrames*OutChannels*2); PutTag('WAVE');
 PutTag('fmt '); Put32(16); Put16(1); Put16(OutChannels); Put32(OutRate);
 Put32(OutRate*OutChannels*2); Put16(OutChannels*2); Put16(16);
 End;

 PutTag('data'); Put32(OutFrames*OutChannels*2);
 CacheBase:=-1; CacheFrames:=0; Used:=0;
 For J:=0 To OutFrames-1 Do Begin
  If OutRate=Rate Then Begin
   Index:=J; Fraction:=0;
  End Else
  Begin
   Value:=J*(Rate*1.0)/OutRate; Index:=Trunc(Value); Fraction:=Value-Index;
  End;
  Left:=Sample(Index,0)*(1-Fraction)+Sample(Index+1,0)*Fraction;
  Right:=Left;
  If Channels=2 Then Right:=Sample(Index,1)*(1-Fraction)+Sample(Index+1,1)*
   Fraction;
  If OutChannels=1 Then Left:=(Left+Right)/2;
  For C:=0 To OutChannels-1 Do Begin
   If C=0 Then Value:=Left Else Value:=Right;
   Index:=Round(Value); If Index< -32768 Then Index:=-32768;
   If Index>32767 Then Index:=32767;
   If Index<0 Then Inc(Index,65536);
   OutBuffer[Used]:=Index And 255; OutBuffer[Used+1]:=Index Shr 8; Inc(Used,2);
   If Used=4096 Then Begin
    WriteBytes(OutBuffer,Used); Used:=0;
   End;
  End;
 End;
 If Used>0 Then WriteBytes(OutBuffer,Used);
 CloseRead; CloseWrite;
End;
