Procedure CKDct4Setup(N: LongInt);
Var
 M,I,J,Bits,R,Lg: LongInt;
Begin
 M:=N Div 2; CKFN:=N;
 For I:=0 To M-1 Do Begin
  CKTwC[I]:=Cos(Pi*(I+0.125)/N); CKTwS[I]:=Sin(Pi*(I+0.125)/N);
  CKFC[I]:=Cos(2*Pi*I/M); CKFS[I]:=-Sin(2*Pi*I/M);
 End;
 Lg:=0;
 While (1 Shl Lg)<M Do Inc(Lg);
 For I:=0 To M-1 Do Begin
  R:=0;
  For J:=0 To Lg-1 Do If (I And (1 Shl J))<>0 Then R:=R Or (1 Shl (Lg-1-J));
  CKFRev[I]:=R;
 End;
End;

Procedure CKDct4(N: LongInt; Inp: PCKF; Var B: Array Of Double);
Var
 M,I,K,Len,Half,Step,J,P,Q: LongInt;
 Re,Im: Array[0..511] Of Double;
 A,Bq,Tr,Ti,Wr,Wi,Yr,Yi: Double;
Begin
 If CKFN<>N Then CKDct4Setup(N);
 M:=N Div 2;
 For I:=0 To M-1 Do Begin
  A:=Inp^[2*I]; Bq:=Inp^[N-1-2*I];
  { z = (a + i b) * (c - i s) }
  Re[CKFRev[I]]:=A*CKTwC[I]+Bq*CKTwS[I];
  Im[CKFRev[I]]:=Bq*CKTwC[I]-A*CKTwS[I];
 End;
 Len:=2;
 While Len<=M Do Begin
  Half:=Len Div 2; Step:=M Div Len;
  I:=0;
  While I<M Do Begin
   For J:=0 To Half-1 Do Begin
    Wr:=CKFC[J*Step]; Wi:=CKFS[J*Step];
    P:=I+J; Q:=P+Half;
    Tr:=Re[Q]*Wr-Im[Q]*Wi; Ti:=Re[Q]*Wi+Im[Q]*Wr;
    Re[Q]:=Re[P]-Tr; Im[Q]:=Im[P]-Ti;
    Re[P]:=Re[P]+Tr; Im[P]:=Im[P]+Ti;
   End;
   Inc(I,Len);
  End;
  Len:=Len*2;
 End;
 For K:=0 To M-1 Do Begin
  Yr:=Re[K]*CKTwC[K]+Im[K]*CKTwS[K];
  Yi:=Im[K]*CKTwC[K]-Re[K]*CKTwS[K];
  B[2*K]:=Yr; B[N-1-2*K]:=-Yi;
 End;
End;
{ IMDCT complete (type FULL_IMDCT de libavutil/tx): Out[n] = -1/32768 * sum
 In[k] cos(pi/N (n+1/2+N/2)(k+1/2)), n=0..2N-1 }

Procedure CKImdct(N: LongInt; Inp: PCKF; Out: PCKF);
Var
 M,Nn: LongInt;
 B: Array[0..1023] Of Double;
 Acc: Double;
 Sc: Double;
Begin
 CKDct4(N,Inp,B);
 Sc:=1.0/32768.0;
 For Nn:=0 To 2*N-1 Do Begin
  M:=Nn+N Div 2;
  If M<N Then Acc:=B[M] Else
  If M<2*N Then Acc:=-B[2*N-1-M]
           Else Acc:=-B[M-2*N];
  Out^[Nn]:=-Sc*Acc;
 End;
End;

Procedure CKInterpolate(Buf: PCKF; Base,Gi,Gn: LongInt);
Var
 I: LongInt;
 Fc1,Fc2: Single;
Begin
 Fc1:=CKPow2[Gi+63];
 If Gi=Gn Then Begin
  For I:=0 To CKGsf-1 Do Buf^[Base+I]:=Buf^[Base+I]*Fc1;
 End Else
 Begin
  Fc2:=CKGainTab[15+(Gn-Gi)];
  For I:=0 To CKGsf-1 Do Begin
   Buf^[Base+I]:=Buf^[Base+I]*Fc1;
   Fc1:=Fc1*Fc2;
  End;
 End;
End;
{ imlt_gain + saturation: Coef = coefficients MLT, Now/Prev = gains, PrevBuf =
 tampon de recouvrement, Out = sortie (Nil si rejetee) }

Procedure CKImltGain(Coef: PCKF; Const Now,Prev: Array Of LongInt; PrevBuf:
 PCKF;
                     Out: PCKF);
Var
 I: LongInt;
 Fc,T1,T2: Single;
 B1: PCKF;
Begin
 CKImdct(CKSpc,Coef,PCKF(@CKMdct));
 B1:=PCKF(@CKMdct[CKSpc]);
 Fc:=CKPow2[Prev[0]+63];
 For I:=0 To CKSpc-1 Do Begin
  T1:=B1^[I]*Fc; T1:=T1*CKWin[I];
  T2:=PrevBuf^[I]*CKWin[CKSpc-1-I];
  B1^[I]:=T1-T2;
 End;
 For I:=0 To 7 Do  If (Now[I]<>0) Or (Now[I+1]<>0) Then CKInterpolate(B1,CKGsf*
  I,Now[I],
 Now[I+1]);
 Move(CKMdct[0],PrevBuf^,CKSpc*4);
 If Out<>Nil Then
 For I:=0 To CKSpc-1 Do Begin
  T1:=B1^[I]; If T1>1.0 Then T1:=1.0; If T1<-1.0 Then T1:=-1.0;
  Out^[I]:=T1;
 End;
End;

Function CKDecoupleInfo(P: LongInt; Var Tab: Array Of LongInt): Boolean;
Var
 Vlc,Start,EndB,Len,I,V: LongInt;
Begin
 CKDecoupleInfo:=False;
 Vlc:=CKBits(1);
 Start:=CKCplBand[CKSub[P].JsStart]; EndB:=CKCplBand[CKSub[P].Subbands-1];
 Len:=EndB-Start+1;
 If Start>EndB Then Begin
  CKDecoupleInfo:=True; Exit;
 End;
 If Vlc<>0 Then
 For I:=0 To Len-1 Do Tab[Start+I]:=CKVlc(20+CKSub[P].JsBits-2)
  Else
 For I:=0 To Len-1 Do Begin
  V:=CKBits(CKSub[P].JsBits);
  If V=(1 Shl CKSub[P].JsBits)-1 Then Exit;
  Tab[Start+I]:=V;
 End;
 CKDecoupleInfo:=True;
End;

Function CKJointDecode(P: LongInt; L,R: PCKF): Boolean;
Var
 Tab: Array[0..19] Of LongInt;
 I,J,Idx,CT,Sb,Tmp: LongInt;
 F1,F2: Single;
 Off: LongInt;
Begin
 CKJointDecode:=False;
 FillChar(Tab,SizeOf(Tab),0);
 FillChar(CKBuf0,SizeOf(CKBuf0),0);
 FillChar(L^,4096,0); FillChar(R^,4096,0);
 If Not CKDecoupleInfo(P,Tab) Then Exit;
 If Not CKMonoDecode(P,PCKF(@CKBuf0)) Then Exit;
 For I:=0 To CKSub[P].JsStart-1 Do
 For J:=0 To 19 Do Begin
  L^[I*20+J]:=CKBuf0[I*40+J];
  R^[I*20+J]:=CKBuf0[I*40+20+J];
 End;
 Idx:=(1 Shl CKSub[P].JsBits)-1;
 Off:=0;
 For I:=2 To CKSub[P].JsBits-1 Do Inc(Off,(1 Shl I)+1);
 For Sb:=CKSub[P].JsStart To CKSub[P].Subbands-1 Do Begin
  CT:=CKCplBand[Sb];
  Dec(Idx,Tab[CT]);
  F1:=CKCplS[Off+Tab[CT]+1];
  F2:=CKCplS[Off+Idx];
  For J:=0 To 19 Do Begin
   Tmp:=((CKSub[P].JsStart+Sb)*20)+J;
   L^[20*Sb+J]:=F1*CKBuf0[Tmp];
   R^[20*Sb+J]:=F2*CKBuf0[Tmp];
  End;
  Idx:=(1 Shl CKSub[P].JsBits)-1;
 End;
 CKJointDecode:=True;
End;
{ copie les octets du sous-paquet en les dechiffrant (cle 37 C5 11 F2 repetee) }

Procedure CKDecodeBytes(Base,Bytes,LimitBits: LongInt);
Const
 Key: Array[0..3] Of Byte=($37,$C5,$11,$F2);
Var
 J,Words: LongInt;
Begin
 Words:=(Bytes+3) Div 4;
 FillChar(CKDec,SizeOf(CKDec),0);
 For J:=0 To Words*4-1 Do  If Base+J<CKPktSize Then CKDec[J]:=CKPkt^[Base+
 J] Xor Key[J And 3] Else CKDec[J]:=Key[J And 3];
 CKGB:=PEABuffer(@CKDec); CKGSize:=Words*4+4; CKGLimit:=LimitBits; CKGBit:=0;
End;

Procedure CKBytesAndGain(P: LongInt; Base: LongInt; Second: Boolean);
Var
 T: Array[0..8] Of LongInt;
Begin
 CKDecodeBytes(Base,CKSub[P].BitsSub Div 8,CKSub[P].BitsSub);
 If Not Second Then Begin
  CKGainInfo(CKSub[P].Gnow1);
  Move(CKSub[P].Gnow1,T,36); Move(CKSub[P].Gprev1,CKSub[P].Gnow1,36);
  Move(T,CKSub[P].Gprev1,36);
 End Else
 Begin
  CKGainInfo(CKSub[P].Gnow2);
  Move(CKSub[P].Gnow2,T,36); Move(CKSub[P].Gprev2,CKSub[P].Gnow2,36);
  Move(T,CKSub[P].Gprev2,36);
 End;
End;

Function CKDecodeSubpacket(P,Base: LongInt; Outs: Array Of PCKF): Boolean;
Var
 O1,O2: PCKF;
Begin
 CKDecodeSubpacket:=False;
 FillChar(CKBuf1,SizeOf(CKBuf1),0);
 CKBytesAndGain(P,Base,False);
 If CKSub[P].Joint<>0 Then Begin
  If Not CKJointDecode(P,PCKF(@CKBuf1),PCKF(@CKBuf2)) Then Exit;
 End Else
 Begin
  If Not CKMonoDecode(P,PCKF(@CKBuf1)) Then Exit;
  If CKSub[P].NumCh=2 Then Begin
   CKBytesAndGain(P,Base+CKSub[P].Size Div 2,True);
   If Not CKMonoDecode(P,PCKF(@CKBuf2)) Then Exit;
  End;
 End;
 O1:=Outs[CKSub[P].ChIdx]; O2:=Nil;
 If CKSub[P].NumCh=2 Then O2:=Outs[CKSub[P].ChIdx+1];
 CKImltGain(PCKF(@CKBuf1),CKSub[P].Gnow1,CKSub[P].Gprev1,PCKF(@CKSub[P].Prev1),
  O1);
 If CKSub[P].NumCh=2 Then Begin
  If CKSub[P].Joint<>0 Then CKImltGain(PCKF(@CKBuf2),CKSub[P].Gnow1,CKSub[
   P].Gprev1,PCKF(
  @CKSub[P].Prev2),O2)
  Else CKImltGain(PCKF(@CKBuf2),CKSub[P].Gnow2,CKSub[P].Gprev2,PCKF(@CKSub[
   P].Prev2),O2);
 End;
 CKDecodeSubpacket:=True;
End;

Function CKInitStream(Const Extra: Array Of Byte; ExtraLen: LongInt): Boolean;
Var
 S,Pos2,SamplesPerFrame,TotalCh,ChMaskAll: LongInt;
 Ok: Boolean;

Function B32: LongInt;Begin
 B32:=0;
 If Pos2+4<=ExtraLen Then B32:=Extra[Pos2]*16777216+Extra[Pos2+1]*65536+Extra[
  Pos2+2]*256+
 Extra[Pos2+3];
 Inc(Pos2,4);
End;

Function B16: LongInt;Begin
 B16:=0;
 If Pos2+2<=ExtraLen Then B16:=Extra[Pos2]*256+Extra[Pos2+1];
 Inc(Pos2,2);
End;

Function Pop(V: LongInt): LongInt;
Var
 C: LongInt;
Begin
 C:=0;
 While V<>0 Do Begin
  If (V And 1)<>0 Then Inc(C); V:=V Shr 1;
 End; Pop:=C;
End;
Begin
 CKInitStream:=False;
 If ExtraLen<8 Then Exit;
 Pos2:=0; S:=0; TotalCh:=0; ChMaskAll:=0; CKNSub:=0;
 While Pos2<ExtraLen Do Begin
  If S>=5 Then Exit;
  If S>=CKSps Then Exit;
  CKSub[S].Ver:=B32;
  SamplesPerFrame:=B16;
  CKSub[S].Subbands:=B16;
  B32;
  CKSub[S].JsStart:=B16;
  If CKSub[S].JsStart>=51 Then Exit;
  CKSub[S].JsBits:=B16;
  CKSub[S].Spc:=SamplesPerFrame Div CKChan;
  CKSub[S].BitsSub:=CKSps*8;
  CKSub[S].Log2Nv:=5; CKSub[S].Total:=CKSub[S].Subbands; CKSub[S].NumCh:=1;
  CKSub[S].BitsDiv:=0;
  CKSub[S].Joint:=0; CKSub[S].Mask:=0;
  Case CKSub[S].Ver Of
  $1000001: If CKChan<>1 Then Exit;
  $1000002: If CKChan<>1 Then Begin
   CKSub[S].BitsDiv:=1; CKSub[S].NumCh:=2;
  End;
  $1000003:
  Begin
   If CKChan<>2 Then Exit;
   If ExtraLen>=16 Then Begin
    CKSub[S].Total:=CKSub[S].Subbands+CKSub[S].JsStart; CKSub[S].Joint:=1;
    CKSub[S].NumCh:=2;
   End;
   If CKSub[S].Spc>256 Then CKSub[S].Log2Nv:=6;
   If CKSub[S].Spc>512 Then CKSub[S].Log2Nv:=7;
  End;
  $2000000:
  Begin
   CKSub[S].Mask:=B32; ChMaskAll:=ChMaskAll Or CKSub[S].Mask;
   If Pop(CKSub[S].Mask)>1 Then Begin
    CKSub[S].Total:=CKSub[S].Subbands+CKSub[S].JsStart; CKSub[S].Joint:=1;
    CKSub[S].NumCh:=2;
    CKSub[S].Spc:=SamplesPerFrame Shr 1;
    If CKSub[S].Spc>256 Then CKSub[S].Log2Nv:=6;
    If CKSub[S].Spc>512 Then CKSub[S].Log2Nv:=7;
   End Else CKSub[S].Spc:=SamplesPerFrame;
  End;
  Else Exit;
 End;
 If (S>1) And (CKSub[S].Spc<>CKSpc) Then Exit;
 CKSpc:=CKSub[0].Spc;
 CKSub[S].NvSize:=1 Shl CKSub[S].Log2Nv;
 If CKSub[S].Total>53 Then Exit;
 If (CKSub[S].JsBits>6) Or (CKSub[S].JsBits<2*CKSub[S].Joint) Then Exit;
 If CKSub[S].Subbands>50 Then Exit;
 If CKSub[S].Subbands=0 Then Exit;
 FillChar(CKSub[S].Gnow1,36,0); FillChar(CKSub[S].Gprev1,36,0);
 FillChar(CKSub[S].Gnow2,36,0); FillChar(CKSub[S].Gprev2,36,0);
 FillChar(CKSub[S].Prev1,SizeOf(CKSub[S].Prev1),0);
 FillChar(CKSub[S].Prev2,SizeOf(CKSub[S].Prev2),0);
 If TotalCh+CKSub[S].NumCh>CKChan Then Exit;
 Inc(TotalCh,CKSub[S].NumCh);
 Inc(CKNSub); Inc(S);
End;
If (CKSpc<>256) And (CKSpc<>512) And (CKSpc<>1024) Then Exit;
CKMaskAll:=ChMaskAll;
CKInitStream:=True;
End;
{ Decode un fichier RealMedia (.rm/.rmvb) contenant du son Cook (RealAudio G2,
 entrelacement genr) vers un WAV PCM 16 bits. }

Procedure DecodeCook(Const Source,Target: String);
Var
 F: PEABuffer;
 Size,Pos2,K,Q,Tag,TSize,P,Q2,SId,TsdStart,TsdSize,Ver,H,W,Sps,Cfs,NPktBlocks,Y,
  X,Cnt,
 Flags,Num,Len,PStart,I,J,Ch,Code,OutBytes,FrameSz,Cnt2: LongInt;
 State: Int64;
 Found,Got: Boolean;
 Extra: Array[0..255] Of Byte;
 ExtraLen: LongInt;
 Deint,CodecTag: LongInt;
 PktBuf: PEABuffer;
 Outs: Array[0..7] Of PCKF;
 OutBufs: Array[0..7] Of PCKF;
 Pcm: Array[0..8191] Of Byte;
 Used,V,MaskW: LongInt;
 T: Single;
 Wr: Array[0..71] Of Byte;
 Started: Boolean;
 Ok: Boolean;
 Chk: LongInt;

Function R16(At: LongInt): LongInt;Begin
 If At+2<=Size Then R16:=F^[At]*256+F^[At+1] Else R16:=0;
End;

Function R32(At: LongInt): LongInt;Begin
 If At+4<=Size Then R32:=F^[At]*16777216+F^[At+1]*65536+F^[At+2]*256+F^[At+3]
  Else R32:=0;
End;

Procedure P32(At: LongInt; Vv: LongInt);
Var
 Z: Integer;
Begin
 For Z:=0 To 3 Do Begin
  Wr[At+Z]:=Vv And 255; Vv:=Vv Shr 8;
 End;
End;

Procedure P16(At: LongInt; Vv: LongInt);Begin
 Wr[At]:=Vv And 255; Wr[At+1]:=(Vv Shr 8) And 255;
End;

Procedure Header(NCh,Rate,Bytes,MaskV: LongInt);Begin
 FillChar(Wr,SizeOf(Wr),0);
 Wr[0]:=82; Wr[1]:=73; Wr[2]:=70; Wr[3]:=70; Wr[8]:=87; Wr[9]:=65; Wr[10]:=86;
  Wr[11]:=69;
 Wr[12]:=102; Wr[13]:=109; Wr[14]:=116; Wr[15]:=32;
 If NCh<=2 Then Begin
  P32(4,36+Bytes); P32(16,16); P16(20,1); P16(22,NCh); P32(24,Rate); P32(28,
   Rate*NCh*2);
  P16(32,NCh*2); P16(34,16);
  Wr[36]:=100; Wr[37]:=97; Wr[38]:=116; Wr[39]:=97; P32(40,Bytes); WriteBytes(
   Wr,44);
 End Else
 Begin
  P32(4,60+Bytes); P32(16,40); P16(20,$FFFE); P16(22,NCh); P32(24,Rate);
  P32(28,Rate*NCh*2); P16(32,NCh*2); P16(34,16);
  P16(36,22); P16(38,16); P32(40,MaskV);
  Wr[44]:=1; Wr[50]:=16; Wr[52]:=128; Wr[55]:=170; Wr[57]:=56; Wr[58]:=155; Wr[
   59]:=113;
  Wr[60]:=100; Wr[61]:=97; Wr[62]:=116; Wr[63]:=97; P32(64,Bytes); WriteBytes(
   Wr,68);
 End;
End;

Procedure FlushPcm;Begin
 If Used>0 Then Begin
  WriteBytes(Pcm,Used); Used:=0;
 End;
End;
{ decode un bloc de block_align octets; retourne True si une trame audio a ete
 produite }

Function DecodeBlock(Blk: PEABuffer; Idx: LongInt): Boolean;
Var
 Z,Off,ChI,S: LongInt;
 Ok2: Boolean;
 OA: Array[0..7] Of PCKF;
Begin
 DecodeBlock:=False;
 CKPkt:=Blk; CKPktSize:=CKBlock;
 CKSub[0].Size:=CKBlock;
 For Z:=1 To CKNSub-1 Do Begin
  CKSub[Z].Size:=2*Blk^[CKBlock-CKNSub+Z];
  Dec(CKSub[0].Size,CKSub[Z].Size+1);
  If CKSub[0].Size<0 Then Exit;
 End;
 For Z:=0 To 7 Do If CKDiscard>=2 Then OA[Z]:=OutBufs[Z] Else OA[Z]:=Nil;
 Off:=0; ChI:=0;
 For S:=0 To CKNSub-1 Do Begin
  CKSub[S].BitsSub:=(CKSub[S].Size*8) Shr CKSub[S].BitsDiv;
  CKSub[S].ChIdx:=ChI;
  If Not CKDecodeSubpacket(S,Off,OA) Then Exit;
  Inc(Off,CKSub[S].Size); Inc(ChI,CKSub[S].NumCh);
 End;
 If CKDiscard<2 Then Begin
  Inc(CKDiscard); Exit;
 End;
 DecodeBlock:=True;
End;
Begin
 OpenRead(Source); Size:=InputSize;
 GetMem(F,Size+64); K:=0;
 While K<Size Do Begin
  If Size-K>4096 Then Q:=4096 Else Q:=Size-K;
  ReadAt(K,F^[K],Q); Inc(K,Q);
 End;
 CloseRead;
 If (Size<20) Or (F^[0]<>$2E) Or (F^[1]<>$52) Or (F^[2]<>$4D) Or (F^[3]<>$46)
  Then Fail(
 'cook: fichier RealMedia (.RMF) requis.');
 Pos2:=R32(4); Found:=False; PStart:=0; CKChan:=0; Deint:=0; ExtraLen:=0;
  CodecTag:=0;
 H:=0; W:=0; Sps:=0; Cfs:=0; SId:=-1;
 While Pos2+10<=Size Do Begin
  Tag:=R32(Pos2); TSize:=R32(Pos2+4);
  If Tag=$44415441 Then Begin
   PStart:=Pos2+18; Break;
  End;
  If TSize<10 Then Fail('cook: bloc RealMedia invalide.');
  If (Tag=$4D445052) And Not Found Then Begin
   P:=Pos2+10; Q:=R16(P); Inc(P,2+28);
   Inc(P,1+F^[P]);
   Inc(P,1+F^[P]);
   TsdSize:=R32(P); Inc(P,4); TsdStart:=P;
   If (R32(TsdStart)=$2E7261FD) Then Begin
    P:=TsdStart+4; Ver:=R16(P); Inc(P,2);
    If (Ver=4) Or (Ver=5) Then Begin
     Inc(P,2); Inc(P,4); Inc(P,4); Inc(P,2); Inc(P,4);
     Inc(P,2); { flavor }
     Cfs:=R32(P); Inc(P,4); Inc(P,4); Inc(P,4); Inc(P,4);
     H:=R16(P); Inc(P,2); W:=R16(P); Inc(P,2); Sps:=R16(P); Inc(P,2); Inc(P,2);
     If Ver=5 Then Inc(P,6);
     CKRate:=R16(P); Inc(P,2); Inc(P,4); CKChan:=R16(P); Inc(P,2);
     If Ver=5 Then Begin
      Deint:=F^[P]+F^[P+1]*256+F^[P+2]*65536+F^[P+3]*16777216; Inc(P,4);
      CodecTag:=F^[P]+F^[P+1]*256+F^[P+2]*65536+F^[P+3]*16777216; Inc(P,4);
     End Else
     Begin
      Deint:=0; Q2:=F^[P];
      For I:=Q2-1 Downto 0 Do If I<4 Then Deint:=Deint*256+F^[P+1+I];
      Inc(P,1+Q2);
      Q2:=F^[P]; CodecTag:=0;
      For I:=Q2-1 Downto 0 Do If I<4 Then CodecTag:=CodecTag*256+F^[P+1+I];
      Inc(P,1+Q2);
     End;
     If CodecTag=$6B6F6F63 Then Begin
      Inc(P,2); Inc(P,1); If Ver=5 Then Inc(P,1);
      ExtraLen:=R32(P); Inc(P,4);
      If (ExtraLen<8) Or (ExtraLen>256) Or (P+ExtraLen>Size) Then Fail(
      'cook: donnees additionnelles (extradata) invalides.');
      Move(F^[P],Extra,ExtraLen);
      SId:=Q; Found:=True;
     End;
    End;
   End;
  End;
  Inc(Pos2,TSize);
 End;
 If Not Found Then Fail(
  'cook: aucun flux audio Cook dans ce fichier RealMedia.');
 If PStart=0 Then Fail('cook: bloc DATA introuvable.');
 If Deint<>$726E6567 Then Fail(
  'cook: seul l''entrelacement genr est pris en charge.');
 CKBlock:=Sps;
 If (Sps<=0) Or (Sps>W) Or (W Mod Sps<>0) Or (CKBlock<=0) Or (CKBlock>4000) Or (
  H<=0) Or (
 H>64) Or (W*H>1000000) Or (CKChan<1) Or (CKChan>6) Or (CKRate<4000) Then Fail(
 'cook: parametres du flux RealAudio invalides.');
 CKSps:=Sps;
 If Not CKInitStream(Extra,ExtraLen) Then Fail(
 'cook: parametres Cook invalides ou non pris en charge.');
 CKGsf:=CKSpc Div 8;
 CKInitTables;
 For I:=0 To 30 Do CKGainTab[I]:=Exp(((I-15)/CKGsf)*0.69314718055994530942);
 For I:=0 To CKSpc-1 Do Begin
  T:=Sin(Single((I+0.5)*(Pi/(2.0*CKSpc))));
  CKWin[I]:=Double(T)*Sqrt(2.0/CKSpc);
 End;
 CKFN:=0; CKDiscard:=0;
 FillChar(CKBuf0,SizeOf(CKBuf0),0); FillChar(CKBuf1,SizeOf(CKBuf1),0);
 FillChar(CKBuf2,SizeOf(CKBuf2),0);
 GetMem(PktBuf,W*H+64);
 For I:=0 To 7 Do OutBufs[I]:=Nil;
 For I:=0 To CKChan-1 Do GetMem(OutBufs[I],4096*4);
 MaskW:=CKMaskAll;
 If MaskW=0 Then Case CKChan Of 1: MaskW:=4; 2: MaskW:=3; 3: MaskW:=7; 4:
  MaskW:=$107;
 5: MaskW:=$37; Else MaskW:=$3F;
End;
OpenWrite(Target); Used:=0; Started:=False; OutBytes:=0;
Header(CKChan,CKRate,0,MaskW); Started:=True;
 { paquets }
State:=$FFFFFFFF; Cnt:=0; P:=PStart;
While P<Size Do Begin
 State:=((State Shl 8)+F^[P]) And $FFFFFFFF; Inc(P);
 If State=$494E4458 Then Break;
 If (State>$FFFF) Or (State<=12) Then Continue;
 Len:=State-12; State:=$FFFFFFFF;
 If P+8>Size Then Break;
 Num:=R16(P); Flags:=F^[P+7]; Inc(P,8);
 If Num<>SId Then Begin
  Inc(P,Len); Continue;
 End;
  { entrelacement genr }
 Y:=Cnt;
 If (Flags And 2)<>0 Then Begin
  Y:=0; Cnt:=0;
 End;
 For X:=0 To W Div Sps-1 Do Begin
  Q:=Sps*(H*X+((H+1) Div 2)*(Y And 1)+(Y Shr 1));
  For J:=0 To Sps-1 Do If P+J<Size Then PktBuf^[Q+J]:=F^[P+J] Else PktBuf^[Q+
   J]:=0;
  Inc(P,Sps);
 End;
 Inc(Cnt);
