Function ByteAt(At: LongInt): Byte;Begin
 If (At<0) Or (At>=FileLimit) Then Fail('Lecture hors fichier video.');
 If (CacheAt<0) Or (At<CacheAt) Or (At>=CacheAt+CacheSize) Then Begin
  CacheAt:=At; CacheSize:=4096; If CacheSize>FileLimit-At Then CacheSize:=FileLimit-At;
  ReadAt(CacheAt,Cache,CacheSize);
 End;
 ByteAt:=Cache[At-CacheAt];
End;

Function U16(At: LongInt; Little: Boolean): LongInt;Begin
 If Little Then U16:=LongInt(ByteAt(At))+LongInt(ByteAt(At+1))*256
           Else U16:=LongInt(ByteAt(At))*256+ByteAt(At+1);
End;

Function U32(At: LongInt; Little: Boolean): Double;
Var
 A: Integer;
 V: Double;
Begin
 V:=0;
 If Little Then
 For A:=3 Downto 0 Do V:=V*256+ByteAt(At+A)
  Else
 For A:=0 To 3 Do V:=V*256+ByteAt(At+A);
 U32:=V;
End;

Function Number(At: LongInt; Little: Boolean): LongInt;
Var
 V: Double;
Begin
 V:=U32(At,Little); If V>2147483647.0 Then Fail('Champ video superieur a 2 Go.');
 Number:=Trunc(V);
End;

Function Signed32(At: LongInt): LongInt;
Var
 V: Double;
Begin
 V:=U32(At,False); If V>=2147483648.0 Then V:=V-4294967296.0; Signed32:=Trunc(V);
End;

Function Tag(At: LongInt): String;
Var
 A: Integer;
 V: String[4];
Begin
 V:='';
 For A:=0 To 3 Do V:=V+Chr(ByteAt(At+A)); Tag:=V;
End;

Function RatioGCD(A,B: LongInt): LongInt;
Var R: LongInt;
Begin
 While B<>0 Do Begin R:=A Mod B; A:=B; B:=R; End; RatioGCD:=A;
End;

Function Ticks(Value: Double): LongInt;Begin
 If (Value< -2147480000.0) Or (Value>2147480000.0) Then Fail('Duree video hors limite.');
 Ticks:=Round(Value);
End;

Procedure Bounds(At,Size: LongInt);Begin
 If (At<0) Or (Size<0) Or (At>FileLimit) Or (Size>FileLimit-At) Then Fail(
 'Conteneur video tronque.');
End;

Procedure MPBox(At,Limit: LongInt; Var Payload,Finish: LongInt);
Var
 N: LongInt;
Begin
 If Limit-At<8 Then Fail('Entete MP4 tronquee.');
 N:=Number(At,False); Payload:=At+8;
 If N=1 Then Begin
  If Limit-At<16 Then Fail('Entete MP4 etendue tronquee.');
  If Number(At+8,False)<>0 Then Fail('Boite MP4 superieure a 2 Go.');
  N:=Number(At+12,False); Payload:=At+16;
 End;
 If N=0 Then N:=Limit-At;
 If (N<Payload-At) Or (N>Limit-At) Then Fail('Taille boite MP4 incorrecte.');
 Finish:=At+N;
End;

Procedure TableBounds(At,HeaderSize,ItemSize,Count: LongInt);
Var
 B,E: LongInt;
Begin
 MPBox(At,FileLimit,B,E);
 If (E-At<HeaderSize) Or (Count<0) Then Fail('Table MP4 tronquee.');
 If (ItemSize>0) And (Count>(E-At-HeaderSize) Div ItemSize) Then Fail(
 'Entrees de table MP4 tronquees.');
End;

Function Child(At,Limit: LongInt; Const Name: String): LongInt;
Var
 B,E: LongInt;
Begin
 Child:=0;
 While At<Limit Do Begin
  MPBox(At,Limit,B,E); If Tag(At+4)=Name Then Begin
   Child:=At; Exit;
  End; At:=E;
 End;
End;

Function AddTrack: Integer;Begin
 If TrackCount=MaxTracks Then Fail('Maximum de quatre pistes video/audio.');
 Inc(TrackCount); Tracks^[TrackCount].Scale:=90000; AddTrack:=TrackCount;
End;

Function AddSample(T: Integer; At,Size,DTime,Duration,Composition: LongInt;
                   Key: Boolean): PSample;
Var
 V: PSample;
Begin
 Bounds(At,Size); If Size=0 Then Fail('Paquet video/audio vide non pris en charge.');
 {$IFNDEF FPC}
  If MaxAvail<SizeOf(TSample) Then Fail('Memoire DOS insuffisante pour les index video.');
 {$ENDIF}
 New(V); FillChar(V^,SizeOf(V^),0);
 V^.Pos:=At; V^.Size:=Size; V^.Time:=DTime; V^.Duration:=Duration;
 V^.Composition:=Composition; V^.Key:=Key;
 With Tracks^[T] Do Begin
  If Last=Nil Then First:=V Else Last^.Next:=V;
  Last:=V; Inc(Count);
 End;
 AddSample:=V;
End;

Procedure ConfigFrom(T: Integer; At,Size: LongInt);Begin
 If (Size<0) Or (Size>MaxConfig) Then Fail('Configuration codec trop grande.');
 Bounds(At,Size); Tracks^[T].ConfigSize:=Size;
 If Size>0 Then ReadAt(At,Tracks^[T].Config,Size);
End;

Procedure Descriptors(T: Integer; At,Limit: LongInt; Depth: Integer);
Var
 Kind,A,V: Integer;
 Size,Finish: LongInt;
Begin
 If Depth>5 Then Fail('Descripteurs ESDS invalides.');
 While At<Limit Do Begin
  Kind:=ByteAt(At); Inc(At); Size:=0; A:=0;
  Repeat
  If (At>=Limit) Or (A=4) Then Fail('Longueur ESDS incorrecte.');
  V:=ByteAt(At); Inc(At); Inc(A); Size:=Size*128+(V And 127);
  Until (V And 128)=0;
  If Size>Limit-At Then Fail('Descripteur ESDS tronque.'); Finish:=At+Size;
  If Kind=3 Then Begin
   If Size<3 Then Fail('ESDS ES tronque.');
   V:=ByteAt(At+2); Inc(At,3);
   If (V And $80)<>0 Then Inc(At,2);
   If (V And $40)<>0 Then Begin
    Inc(At,ByteAt(At)+1);
   End;
   If (V And $20)<>0 Then Inc(At,2);
   If At>Finish Then Fail('ESDS ES invalide.'); Descriptors(T,At,Finish,Depth+1);
  End Else If Kind=4 Then Begin
   If Size<13 Then Fail('ESDS decodeur tronque.');
   If (ByteAt(At)=$6B) Or (ByteAt(At)=$69) Then Tracks^[T].Codec:='.mp3';
   Descriptors(T,At+13,Finish,Depth+1);
  End Else If Kind=5 Then ConfigFrom(T,At,Size);
  At:=Finish;
 End;
End;

Procedure MPEntry(T: Integer; At,Limit: LongInt);
Var
 B,E,C,D,F: LongInt;
 Name: String[4];
Begin
 MPBox(At,Limit,B,E); Name:=Tag(At+4); Tracks^[T].Codec:=Name;
 If NoAudio And Not Tracks^[T].Video Then Exit;
 With Tracks^[T] Do Begin
  If Video Then Begin
   If E-At<86 Then Fail('Entree video MP4 tronquee.');
   Width:=U16(At+32,False); Height:=U16(At+34,False); C:=At+86;
   If (Name<>'avc1') And (Name<>'mp4v') And (Name<>'vp09') Then Fail(
   'Codec video MP4 non pris en charge: '+Name);
  End Else
  Begin
   If E-At<36 Then Fail('Entree audio MP4 tronquee.');
   If U16(At+16,False)<>0 Then Fail('Version entree audio MP4 non prise en charge.');
   Channels:=U16(At+24,False); Rate:=U16(At+32,False); C:=At+36;
   If (Name<>'mp4a') And (Name<>'.mp3') And (Name<>'Opus') Then Fail(
   'Codec audio MP4 non pris en charge: '+Name);
  End;
  While C<E Do Begin
   MPBox(C,E,D,F); Name:=Tag(C+4);
   If (Name='avcC') Or (Name='vpcC') Or (Name='dOps') Then ConfigFrom(T,D,F-D) Else
   If Name='esds' Then Descriptors(T,D+4,F,0) Else
   If (Name='pasp') And Video Then Begin
    If F-D<>8 Then Fail('pasp MP4 invalide.');
    SARNum:=Number(D,False); SARDen:=Number(D+4,False);
    If (SARNum<=0) Or (SARDen<=0) Then Fail('pasp MP4 invalide.');
   End Else
   If (Name='sinf') Then Fail('Piste chiffree non prise en charge.');
   C:=F;
  End;
  If Codec='avc1' Then Begin
   If (ConfigSize<7) Or (Config[0]<>1) Then Fail('Configuration avcC absente.');
   NALBytes:=(Config[4] And 3)+1;
  End;
 End;
End;

Procedure MPTables(T: Integer);
Var
 V: PSample;
 A,C,N,Uniform,Chunk,Chunks,Run,RunCount,NextChunk,PerChunk,Offset,K: LongInt;
 Time,Delta,CT: Double;
Begin
 With Tracks^[T] Do Begin
  If Stsz=0 Then Exit;
  Uniform:=Number(Stsz+12,False); N:=Number(Stsz+16,False);
  TableBounds(Stsz,20,0,0); If Uniform=0 Then TableBounds(Stsz,20,4,N);
  If N=0 Then Exit;
  If (Stts=0) Or (Stsc=0) Or (Stco=0) Then Fail('Tables MP4 manquantes.');
  If N>2000000 Then Fail('Trop de paquets MP4.');
  For A:=0 To N-1 Do Begin
   C:=Uniform; If C=0 Then C:=Number(Stsz+20+A*4,False);
   V:=AddSample(T,0,C,0,0,0,Stss=0);
  End;
  V:=First; Time:=0; RunCount:=Number(Stts+12,False);
  TableBounds(Stts,16,8,RunCount);
  For A:=0 To RunCount-1 Do Begin
   C:=Number(Stts+16+A*8,False); Delta:=U32(Stts+20+A*8,False);
   If (C>N) Or (Delta<=0) Then Fail('Table stts MP4 incorrecte.');
   For K:=1 To C Do Begin
    If V=Nil Then Fail('Table stts trop longue.');
    V^.Time:=Ticks(Time*Scale/InputScale); Time:=Time+Delta;
    V^.Duration:=Ticks(Time*Scale/InputScale)-V^.Time; V:=V^.Next;
   End;
  End;
  If V<>Nil Then Fail('Table stts incomplete.');
  If Ctts<>0 Then Begin
   V:=First; RunCount:=Number(Ctts+12,False);
   TableBounds(Ctts,16,8,RunCount);
   For A:=0 To RunCount-1 Do Begin
    C:=Number(Ctts+16+A*8,False); CT:=U32(Ctts+20+A*8,False);
    If ByteAt(Ctts+8)=1 Then CT:=Signed32(Ctts+20+A*8);
    If C>N Then Fail('Table ctts incorrecte.');
    For K:=1 To C Do Begin
     If V=Nil Then Fail('Table ctts trop longue.');
     V^.Composition:=Ticks(CT*Scale/InputScale); V:=V^.Next;
    End;
   End;
   If V<>Nil Then Fail('Table ctts incomplete.');
  End;
  If Stss<>0 Then Begin
   V:=First; K:=1; RunCount:=Number(Stss+12,False);
   TableBounds(Stss,16,4,RunCount);
   For A:=0 To RunCount-1 Do Begin
    C:=Number(Stss+16+A*4,False);
    If (C<K) Or (C>N) Then Fail('Table stss incorrecte.');
    While K<C Do Begin
     V:=V^.Next; Inc(K);
    End; V^.Key:=True;
   End;
  End;
  V:=First; Chunks:=Number(Stco+12,False); RunCount:=Number(Stsc+12,False);
  TableBounds(Stsc,16,12,RunCount);
  If Tag(Stco+4)='co64' Then TableBounds(Stco,16,8,Chunks) Else TableBounds(Stco,16,4,
  Chunks);
  If (Chunks=0) Or (RunCount=0) Or (Number(Stsc+16,False)<>1) Then Fail(
  'Table stsc incorrecte.');
  Run:=0; PerChunk:=Number(Stsc+20,False); NextChunk:=Chunks+1;
  If RunCount>1 Then NextChunk:=Number(Stsc+28,False);
  For Chunk:=1 To Chunks Do Begin
   If Chunk=NextChunk Then Begin
    Inc(Run); PerChunk:=Number(Stsc+20+Run*12,False); NextChunk:=Chunks+1;
    If Run+1<RunCount Then NextChunk:=Number(Stsc+28+Run*12,False);
   End;
   If (PerChunk<1) Or (PerChunk>N) Or (Number(Stsc+24+Run*12,False)<>1) Then Fail(
   'Description/chunk MP4 non pris en charge.');
   If Tag(Stco+4)='co64' Then Begin
    If Number(Stco+16+(Chunk-1)*8,False)<>0 Then Fail('Offset MP4 superieur a 2 Go.');
    Offset:=Number(Stco+20+(Chunk-1)*8,False);
   End Else Offset:=Number(Stco+16+(Chunk-1)*4,False);
   For K:=1 To PerChunk Do Begin
    If V=Nil Then Fail('Trop de paquets dans stsc.');
    Bounds(Offset,V^.Size); V^.Pos:=Offset; Inc(Offset,V^.Size); V:=V^.Next;
   End;
  End;
  If V<>Nil Then Fail('Table stsc incomplete.');
 End;
End;

Procedure MPTrack(At,Limit: LongInt);
Var
 B,E,C,D,F,Tk,Md,St,T,EntryCount,Ed: LongInt;
 Kind: String[4];
Begin
 T:=AddTrack;
 Tk:=Child(At,Limit,'tkhd'); Md:=Child(At,Limit,'mdia'); Ed:=Child(At,Limit,'edts');
 If (Tk=0) Or (Md=0) Then Fail('Piste MP4 incomplete.');
 If ByteAt(Tk+8)<>0 Then Fail('tkhd version 1 non pris en charge.');
 Tracks^[T].ID:=Number(Tk+20,False);
 If Ed<>0 Then Begin
  MPBox(Ed,Limit,B,E); Tracks^[T].EditAt:=Child(B,E,'elst');
 End;
 MPBox(Md,Limit,B,E); C:=Child(B,E,'hdlr'); D:=Child(B,E,'mdhd');
 If (C=0) Or (D=0) Then Fail('mdia MP4 incomplet.');
 Kind:=Tag(C+16);
 If (Kind<>'vide') And (Kind<>'soun') Then Fail(
 'Piste autre que video/audio non prise en charge.');
 Tracks^[T].Video:=Kind='vide';
 If ByteAt(D+8)<>0 Then Fail('mdhd version 1 non pris en charge.');
 Tracks^[T].InputScale:=Number(D+20,False);
 If Tracks^[T].InputScale=0 Then Fail('Echelle temporelle MP4 nulle.');
 If Not Tracks^[T].Video Then Tracks^[T].Scale:=Tracks^[T].InputScale;
 C:=Child(B,E,'minf'); If C=0 Then Fail('minf absent.'); MPBox(C,E,B,F);
 St:=Child(B,F,'stbl'); If St=0 Then Fail('stbl absent.'); MPBox(St,F,B,E);
 With Tracks^[T] Do Begin
  Stsz:=Child(B,E,'stsz'); Stsc:=Child(B,E,'stsc'); Stco:=Child(B,E,'stco');
  If Stco=0 Then Stco:=Child(B,E,'co64');
  Stts:=Child(B,E,'stts'); Ctts:=Child(B,E,'ctts'); Stss:=Child(B,E,'stss');
  C:=Child(B,E,'stsd'); If C=0 Then Fail('stsd absent.');
  MPBox(C,E,D,F); EntryCount:=Number(D+4,False);
  If EntryCount<>1 Then Fail('Une seule description par piste MP4 requise.');
  MPEntry(T,D+8,F); MPTables(T);
 End;
End;

Procedure MPFragment(At,Limit,Base: LongInt);
Var
 B,E,C,D,F,T,A,Flags,N,Dur,Size,SampleFlags,CT,Offset,Count,FirstFlags,
 DefaultFlags: LongInt;
 Time,DT: Double;
 V: PSample;
Begin
 C:=Child(At,Limit,'tfhd'); D:=Child(At,Limit,'tfdt');
 If (C=0) Or (D=0) Then Fail('Fragment MP4 sans tfhd/tfdt.');
 N:=Number(C+12,False); T:=0;
 For A:=1 To TrackCount Do If Tracks^[A].ID=N Then T:=A;
 If T=0 Then Fail('Piste fragment MP4 inconnue.');
 Flags:=Number(C+8,False);
 If (Flags And 1)<>0 Then Fail('Fragment a offset absolu non pris en charge.');
 If (Flags And $20000)=0 Then Fail('Fragment exige default-base-is-moof.');
 Dur:=Tracks^[T].DefaultDuration; Size:=Tracks^[T].DefaultSize;
 SampleFlags:=Tracks^[T].DefaultFlags;
 Inc(C,16);
 If (Flags And 2)<>0 Then Begin
  If Number(C,False)<>1 Then Fail('Description fragment inconnue.'); Inc(C,4);
 End;
 If (Flags And 8)<>0 Then Begin
  Dur:=Number(C,False); Inc(C,4);
 End;
 If (Flags And 16)<>0 Then Begin
  Size:=Number(C,False); Inc(C,4);
 End;
 If (Flags And 32)<>0 Then SampleFlags:=Number(C,False);
 DefaultFlags:=SampleFlags;
 If ByteAt(D+8)=1 Then Time:=U32(D+12,False)*4294967296.0+U32(D+16,False)
                  Else Time:=U32(D+12,False);
 Offset:=-1; C:=At;
 While C<Limit Do Begin
  MPBox(C,Limit,B,E);
  If Tag(C+4)='trun' Then Begin
   Flags:=Number(B,False); Count:=Number(B+4,False); F:=B+8;
   If (Flags And 1)<>0 Then Begin
    Offset:=Base+Signed32(F); Inc(F,4);
   End;
   If Offset<0 Then Fail('trun sans offset de donnees.');
   FirstFlags:=DefaultFlags;
   If (Flags And 4)<>0 Then Begin
    FirstFlags:=Number(F,False); Inc(F,4);
   End;
   If Count>2000000 Then Fail('Trop de paquets fragment MP4.');
   For A:=1 To Count Do Begin
    N:=Dur; D:=Size; CT:=0;
    If (Flags And $100)<>0 Then Begin
     N:=Number(F,False); Inc(F,4);
    End;
    If (Flags And $200)<>0 Then Begin
     D:=Number(F,False); Inc(F,4);
    End;
    SampleFlags:=DefaultFlags; If A=1 Then SampleFlags:=FirstFlags;
    If (Flags And $400)<>0 Then Begin
     SampleFlags:=Number(F,False); Inc(F,4);
    End;
    If (Flags And $800)<>0 Then Begin
     If ByteAt(B)=1 Then CT:=Signed32(F) Else CT:=Number(F,False); Inc(F,4);
    End;
    If (F>E) Or (N<=0) Then Fail('trun invalide.');
    With Tracks^[T] Do Begin
     DT:=Time*Scale/InputScale;
     V:=AddSample(T,Offset,D,Ticks(DT),Ticks((Time+N)*Scale/InputScale)-Ticks(DT),Ticks(
     CT*1.0*Scale/InputScale),(SampleFlags And $10000)=0);
    End;
    Time:=Time+N; Inc(Offset,D);
   End;
  End;
  C:=E;
 End;
End;

Procedure ReadMP4;
Var
 A,B,E,C,D,F,T,N: LongInt;
Begin
 Moov:=Child(0,FileLimit,'moov'); If Moov=0 Then Fail('MP4 sans moov.');
 MPBox(Moov,FileLimit,B,E); C:=Child(B,E,'mvhd');
 If C=0 Then Fail('Horloge mvhd MP4 absente.');
 If ByteAt(C+8)=0 Then MovieScale:=Number(C+20,False) Else
 If ByteAt(C+8)=1 Then MovieScale:=Number(C+28,False)
                  Else Fail('Version mvhd MP4 inconnue.');
 If MovieScale=0 Then Fail('Horloge movie MP4 nulle.');
 A:=B;
 While A<E Do Begin
  MPBox(A,E,C,D); If Tag(A+4)='trak' Then MPTrack(C,D); A:=D;
 End;
 A:=Child(B,E,'mvex');
 If A<>0 Then Begin
  MPBox(A,E,C,D); A:=C;
  While A<D Do Begin
   MPBox(A,D,B,E);
   If Tag(A+4)='trex' Then Begin
    N:=Number(B+4,False);
    For T:=1 To TrackCount Do If Tracks^[T].ID=N Then Begin
     Tracks^[T].DefaultDuration:=Number(B+12,False);
     Tracks^[T].DefaultSize:=Number(B+16,False);
     Tracks^[T].DefaultFlags:=Number(B+20,False);
    End;
   End;
   A:=E;
  End;
 End;
 A:=0;
 While A<FileLimit Do Begin
  MPBox(A,FileLimit,B,E);
  If Tag(A+4)='moof' Then Begin
   C:=B;
   While C<E Do Begin
    MPBox(C,E,D,F); If Tag(C+4)='traf' Then MPFragment(D,F,A); C:=F;
   End;
  End;
  A:=E;
 End;
End;
{ AVI RIFF, un seul segment RIFF, codecs H264/XVID, AAC/MP3. }

Procedure AVIWalk(At,Limit: LongInt; T,Depth: Integer; InMovi: Boolean);
Var
 N,B,E,A,Stream,Rate,Scale,Units: LongInt;
 Name,Kind: String[4];
 V: PSample;
Begin
 If Depth>8 Then Fail('Imbrication AVI excessive.');
 While At<Limit Do Begin
  If Limit-At<8 Then Fail('Entete AVI tronquee.');
  Name:=Tag(At); N:=Number(At+4,True); B:=At+8;
  If N>Limit-B Then Fail('Bloc AVI tronque.'); E:=B+N;
  If Name='LIST' Then Begin
   If N<4 Then Fail('LIST AVI vide.'); Kind:=Tag(B);
   If Kind='strl' Then Begin
    A:=AddTrack; Tracks^[A].ID:=A; AVIWalk(B+4,E,A,Depth+1,False);
   End
   Else AVIWalk(B+4,E,T,Depth+1,InMovi Or (Kind='movi'));
  End Else If (Name='strh') And (T>0) Then Begin
   If N<48 Then Fail('strh AVI tronque.');
   Kind:=Tag(B); Tracks^[T].Video:=Kind='vids';
   If (Kind<>'vids') And (Kind<>'auds') Then Fail('Type de piste AVI non pris en charge.')
   ;
   Scale:=Number(B+20,True); Rate:=Number(B+24,True);
   If (Scale=0) Or (Rate=0) Then Fail('Horloge AVI invalide.');
   Tracks^[T].AVIUnits:=Number(B+28,True);
   If (Number(B+44,True)<>0) And (Tracks^[T].Video Or Not NoAudio) Then Fail('AVI a paquets de taille fixe non pris en charge.');
   Tracks^[T].InputScale:=Rate; Tracks^[T].DefaultDuration:=Scale;
   If Not Tracks^[T].Video Then Tracks^[T].Scale:=Rate;
  End Else If (Name='strf') And (T>0) Then Begin
   With Tracks^[T] Do Begin
    If Video Then Begin
     If N<40 Then Fail('BITMAPINFO AVI tronque.');
     Width:=Number(B+4,True); Height:=Number(B+8,True); Kind:=Tag(B+16);
     If (Kind='H264') Or (Kind='h264') Or (Kind='avc1') Or (Kind='X264') Then Begin
      Codec:='avc1'; AnnexB:=True;
     End
     Else If (Kind='XVID') Or (Kind='FMP4') Or (Kind='DIVX') Or (Kind='DX50') Then Codec:=
     'mp4v'
     Else If Kind='FFV1' Then Codec:='FFV1'
     Else Fail('Codec AVI video non pris en charge: '+Kind);
     ConfigFrom(T,B+40,N-40);
    End Else
    Begin
     If NoAudio Then Codec:='skip' Else Begin
     If N<16 Then Fail('WAVEFORMAT AVI tronque.');
     A:=U16(B,True); Channels:=U16(B+2,True); Rate:=Number(B+4,True);
     If A=$55 Then Codec:='.mp3' Else If A=$FF Then Codec:='mp4a'
              Else Fail('Audio AVI: seuls MP3 et AAC bruts sont pris en charge.');
     DShowAlign:=U16(B+12,True);
     If (Codec='mp4a') And (DShowAlign<=4) Then DShowAlign:=0;
     If (N>=18) And (Codec='mp4a') Then Begin
      A:=U16(B+16,True); If A>N-18 Then Fail('Configuration AAC AVI tronquee.');
      ConfigFrom(T,B+18,A);
     End;
     End;
    End;
   End;
  End Else If InMovi And (Name[1] In ['0'..'9']) And (Name[2] In ['0'..'9']) Then Begin
   Stream:=(Ord(Name[1])-48)*10+Ord(Name[2])-48+1;
   If (Stream<1) Or (Stream>TrackCount) Then Fail('Piste AVI inconnue.');
   If (Copy(Name,3,2)<>'dc') And (Copy(Name,3,2)<>'db') And (Copy(Name,3,2)<>'wb')
   Then Fail('Type de paquet AVI non pris en charge.');
   With Tracks^[Stream] Do Begin
    Units:=1;
    If Not Video And (DShowAlign>0) Then Units:=(N+DShowAlign-1) Div DShowAlign;
    If N=0 Then Begin
     If Last<>Nil Then Last^.Duration:=Ticks((AVIUnits+Units*1.0)*DefaultDuration*Scale/
     InputScale)-Last^.Time;
    End Else V:=AddSample(Stream,B,N,Ticks(AVIUnits*1.0*DefaultDuration*Scale/InputScale),
    Ticks((AVIUnits+Units*1.0)*DefaultDuration*Scale/InputScale)-Ticks(AVIUnits*1.0*
    DefaultDuration*Scale/InputScale),0,False);
    Inc(AVIUnits,Units);
   End;
  End;
  At:=E+(N And 1); If At>Limit Then Fail('Padding AVI absent.');
 End;
End;

Procedure ReadAVI;Begin
 If (Tag(0)<>'RIFF') Or (Tag(8)<>'AVI ') Then Fail('AVI RIFF requis.');
 RiffEnd:=Number(4,True)+8; Bounds(0,RiffEnd);
 If RiffEnd<>FileLimit Then Fail('AVI OpenDML/RIFF multiples non pris en charge.');
 AVIWalk(12,RiffEnd,0,0,False);
End;
{ EBML/WebM: VP9 profile 0 et Opus mono/stereo, SimpleBlock sans lacing. }

Function VInt(Var At: LongInt; IsID: Boolean): Double;
Var
 Mask,N,A,V: Integer;
 D: Double;
 Unknown: Boolean;
Begin
 V:=ByteAt(At); Inc(At); Mask:=128; N:=1;
 While (Mask>0) And ((V And Mask)=0) Do Begin
  Mask:=Mask Shr 1; Inc(N);
 End;
 If (Mask=0) Or (IsID And (N>4)) Then Fail('Entier EBML invalide.');
 If IsID Then D:=V Else D:=V And (Mask-1);
 Unknown:=(V And (Mask-1))=Mask-1;
 For A:=2 To N Do Begin
  V:=ByteAt(At); Inc(At); D:=D*256+V; Unknown:=Unknown And (V=255);
 End;
 If Unknown And Not IsID Then D:=-1;
 VInt:=D;
End;

Function EBNumber(At,Size: LongInt): Double;
Var
 A: Integer;
 D: Double;
Begin
 If (Size<1) Or (Size>8) Then Fail('Entier EBML hors limite.');
 D:=0;
 For A:=0 To Size-1 Do D:=D*256+ByteAt(At+A); EBNumber:=D;
End;

Procedure EBElement(Var At: LongInt; Limit: LongInt; Var ID,Finish: LongInt);
Var
 D: Double;
Begin
 ID:=Ticks(VInt(At,True)); D:=VInt(At,False);
 If D<0 Then Begin
  If (ID<>$18538067) And (ID<>$1F43B675) Then Fail(
  'Taille EBML inconnue non prise en charge.');
  Finish:=Limit;
 End Else
 Begin
  If D>Limit-At Then Fail('Element EBML tronque.'); Finish:=At+Trunc(D);
 End;
End;

Procedure WebTrack(At,Limit: LongInt; T,Depth: Integer);
Var
 EID,E,A: LongInt;
 Name: String;
Begin
 If Depth>4 Then Fail('Imbrication TrackEntry WebM excessive.');
 While At<Limit Do Begin
  EBElement(At,Limit,EID,E);
  With Tracks^[T] Do Begin
   Case EID Of
   $83:
   Begin
    A:=Ticks(EBNumber(At,E-At));
    If (A<>1) And (A<>2) Then Fail('WebM: piste autre que video/audio.'); Video:=A=1;
   End;
   $86:
   Begin
    Name:='';
    For A:=At To E-1 Do Begin
     If Length(Name)=255 Then Fail('CodecID trop long.'); Name:=Name+Chr(ByteAt(A));
    End;
    If Name='V_VP9' Then Codec:='vp09' Else If Name='A_OPUS' Then Begin
     Codec:='Opus'; Scale:=48000; Rate:=48000;
    End
    Else Fail('WebM: codecs VP9 et Opus uniquement; codec rencontre: '+Name);
   End;
   $63A2: ConfigFrom(T,At,E-At);
   $23E383: DefaultDuration:=Ticks(EBNumber(At,E-At)*90000/1000000000);
   $B0: Width:=Ticks(EBNumber(At,E-At));
   $BA: Height:=Ticks(EBNumber(At,E-At));
   $9F: Channels:=Ticks(EBNumber(At,E-At));
   $56AA: Delay:=Ticks(EBNumber(At,E-At)*48000/1000000000);
   $E0,$E1: WebTrack(At,E,T,Depth+1);
   $6D80: Fail('WebM chiffre/compresse non pris en charge.');
  End;
 End;
 If EID=$D7 Then Tracks^[T].ID:=Ticks(EBNumber(At,E-At));
 At:=E;
End;
End;

Procedure ReadWebM;
Var
 At,ID,E,Limit,B,C,F,T,A,Code,Relative,Flags,BlockTrack: LongInt;
 Scale,ClusterTime,Timestamp: Double;
 V: PSample;
 Name: String;
 GroupAt,GroupID,GroupEnd,BlockAt,BlockEnd,Padding: LongInt;
 GroupKey: Boolean;
 GroupDuration: Double;

Procedure ReadBlock(Start,Finish: LongInt; Simple,Key: Boolean; Trim: LongInt;
                    BlockDuration: Double);
Var
 TrackIndex: Integer;
Begin
 F:=Start; BlockTrack:=Ticks(VInt(F,False)); T:=0;
 For TrackIndex:=1 To TrackCount Do If Tracks^[TrackIndex].ID=BlockTrack Then T:=
 TrackIndex;
 If (T=0) Or (Finish-F<4) Then Fail('Block WebM incorrect.');
 Relative:=U16(F,False); If Relative>=32768 Then Dec(Relative,65536);
 Flags:=ByteAt(F+2); Inc(F,3);
 If (Flags And 6)<>0 Then Fail('Lacing WebM non pris en charge.');
 If (Flags And 9)<>0 Then Fail(
 'Images WebM invisibles/discardables non prises en charge.');
 Timestamp:=(ClusterTime+Relative)*Scale/1000000000;
 If Simple Then Key:=(Flags And 128)<>0;
 If Tracks^[T].LastTrim<>0 Then Fail('DiscardPadding WebM avant le dernier paquet.');
 With Tracks^[T] Do Begin
  If (Trim<>0) And (Codec<>'Opus') Then Fail('DiscardPadding reserve a Opus.');
  V:=AddSample(T,F,Finish-F,Ticks(Timestamp*Tracks^[T].Scale),DefaultDuration,0,Key);
  If BlockDuration>0 Then V^.Duration:=Ticks(BlockDuration*Tracks^[T].Scale);
  LastTrim:=Trim;
 End;
End;
Begin
 At:=0; EBElement(At,FileLimit,ID,E); If ID<>$1A45DFA3 Then Fail('Entete WebM absente.');
 B:=At; Name:='';
 While B<E Do Begin
  EBElement(B,E,Code,C); If Code=$4282 Then
  For A:=B To C-1 Do Name:=Name+Chr(ByteAt(A)); B:=C;
 End;
 If Name<>'webm' Then Fail('Document EBML non WebM.');
 At:=E; EBElement(At,FileLimit,ID,Limit);
 If ID<>$18538067 Then Fail('Segment WebM absent.');
 Scale:=1000000; ClusterTime:=0;
 While At<Limit Do Begin
  EBElement(At,Limit,ID,E);
  If ID=$1549A966 Then Begin
   B:=At;
   While B<E Do Begin
    EBElement(B,E,Code,C); If Code=$2AD7B1 Then Scale:=EBNumber(B,C-B); B:=C;
   End;
   If (Scale<=0) Or (Scale>1000000000) Then Fail('TimecodeScale WebM invalide.');
  End Else If ID=$1654AE6B Then Begin
   B:=At;
   While B<E Do Begin
    EBElement(B,E,Code,C); If Code=$AE Then Begin
     T:=AddTrack; Tracks^[T].Channels:=1; WebTrack(B,C,T,0);
    End; B:=C;
   End;
  End Else If ID=$1F43B675 Then Begin
   B:=At;
   While B<E Do Begin
    EBElement(B,E,Code,C);
    If Code=$E7 Then ClusterTime:=EBNumber(B,C-B) Else
    If Code=$A3 Then ReadBlock(B,C,True,False,0,0) Else
    If Code=$A0 Then Begin
     GroupAt:=B; BlockAt:=0; BlockEnd:=0; Padding:=0; GroupKey:=True; GroupDuration:=0;
     While GroupAt<C Do Begin
      EBElement(GroupAt,C,GroupID,GroupEnd);
      If GroupID=$A1 Then Begin
       BlockAt:=GroupAt; BlockEnd:=GroupEnd;
      End
      Else If GroupID=$FB Then GroupKey:=False Else
      If GroupID=$9B Then GroupDuration:=EBNumber(GroupAt,GroupEnd-GroupAt)*Scale/
      1000000000
      Else If GroupID=$75A2 Then Begin
       If ByteAt(GroupAt)>=128 Then Fail(
       'DiscardPadding WebM negatif non pris en charge.');
       Padding:=Ticks(EBNumber(GroupAt,GroupEnd-GroupAt)*48000/1000000000);
      End Else If (GroupID<>$9B) And (GroupID<>$BF) Then Fail(
      'Attribut BlockGroup WebM non pris en charge.');
      GroupAt:=GroupEnd;
     End;
     If BlockAt=0 Then Fail('BlockGroup WebM sans Block.');
     ReadBlock(BlockAt,BlockEnd,False,GroupKey,Padding,GroupDuration);
    End
    Else If Code=$1F43B675 Then Fail(
    'Clusters WebM de taille inconnue non pris en charge.');
    B:=C;
   End;
  End;
  At:=E;
 End;
End;

Function OutPos: LongInt;
Var
 Code: Integer;
 V: LongInt;
Begin
 {$I-}V:=FilePos(ActiveOutput); Code:=IOResult;{$I+} If Code<>0 Then Fail('Position sortie video impossible.'); OutPos:=V;
End;

Procedure SeekOut(At: LongInt);
Var
 Code: Integer;
Begin
 {$I-}Seek(ActiveOutput,At); Code:=IOResult;{$I+} If Code<>0 Then Fail('Position sortie video incorrecte.');
End;

Procedure W8(V: Byte);Begin
 WriteBytes(V,1);
End;

Procedure W16(V: LongInt);Begin
 If LE Then Begin
  W8(V And 255); W8((V Shr 8) And 255);
 End Else
 Begin
  W8((V Shr 8) And 255); W8(V And 255);
 End;
End;

Procedure W32(V: LongInt);
Var
 A: Integer;
Begin
 If LE Then
 For A:=0 To 3 Do W8((V Shr (A*8)) And 255) Else
 For A:=3 Downto 0 Do W8((V Shr (A*8)) And 255);
End;

Procedure WTag(Name: String);Begin
 WriteBytes(Name[1],4);
End;

Procedure Zero(N: Integer);
Var
 A: Integer;
Begin
 For A:=1 To N Do W8(0);
End;

Procedure StartBox(Const Name: String);Begin
 If Level=16 Then Fail('Imbrication sortie excessive.'); Stack[Level]:=OutPos; Inc(Level);
 If LE Then Begin
  WTag(Name); W32(0);
 End Else
 Begin
  W32(0); WTag(Name);
 End;
End;

Procedure EndBox;
Var
 At,Finish: LongInt;
Begin
 If Level=0 Then Fail('Erreur interne boite video.'); Dec(Level); At:=Stack[Level];
 Finish:=OutPos;
 If LE Then Begin
  SeekOut(At+4); W32(Finish-At-8);
 End Else
 Begin
  SeekOut(At); W32(Finish-At);
 End;
 SeekOut(Finish); If LE And Odd(Finish-At) Then W8(0);
End;

Procedure CopyBytes(At,N: LongInt);
Var
 B: Array[0..4095] Of Byte;
 Amount: Word;
Begin
 Bounds(At,N);
 If N>2147480000-OutPos Then Fail('Sortie video superieure a 2 Go.');
 While N>0 Do Begin
  Amount:=4096; If N<Amount Then Amount:=N; ReadAt(At,B,Amount); WriteBytes(B,Amount);
  Inc(At,Amount); Dec(N,Amount);
 End;
End;
{ Conversion AVCC <-> Annex B. }

Function StartCode(At,Limit: LongInt; Var Payload: LongInt): LongInt;
Var
 Z: Integer;
 C: Byte;
Begin
 Z:=0; StartCode:=-1; Payload:=Limit;
 While At<Limit Do Begin
  C:=ByteAt(At);
  If (C=1) And (Z>=2) Then Begin
   StartCode:=At-Z; Payload:=At+1; Exit;
  End;
  If C=0 Then Inc(Z) Else Z:=0;
  Inc(At);
 End;
End;

Procedure AVCConfig(T: Integer; V: PSample);
Var
 At,B,E,D,SPS,PPS,SPSN,PPSN,A: LongInt;
Begin
 SPS:=-1; PPS:=-1; SPSN:=0; PPSN:=0; At:=StartCode(V^.Pos,V^.Pos+V^.Size,B);
 While At>=0 Do Begin
  E:=StartCode(B,V^.Pos+V^.Size,D); If E<0 Then E:=V^.Pos+V^.Size;
  If B<E Then Begin
   A:=ByteAt(B) And 31;
   If A=7 Then Begin
    SPS:=B; SPSN:=E-B;
   End;
   If A=8 Then Begin
    PPS:=B; PPSN:=E-B;
   End;
  End;
  At:=StartCode(B,V^.Pos+V^.Size,B);
 End;
 If (SPS<0) Or (PPS<0) Or (SPSN<4) Or (SPSN+PPSN+11>MaxConfig) Then Fail(
 'AVI H264: SPS/PPS requis dans la premiere image.');
 With Tracks^[T] Do Begin
  Config[0]:=1; Config[1]:=ByteAt(SPS+1); Config[2]:=ByteAt(SPS+2);
  Config[3]:=ByteAt(SPS+3);
  Config[4]:=255; Config[5]:=225; Config[6]:=SPSN Shr 8; Config[7]:=SPSN And 255;
  For A:=0 To SPSN-1 Do Config[8+A]:=ByteAt(SPS+A);
  A:=8+SPSN; Config[A]:=1; Config[A+1]:=PPSN Shr 8; Config[A+2]:=PPSN And 255;
  For D:=0 To PPSN-1 Do Config[A+3+D]:=ByteAt(PPS+D);
  ConfigSize:=A+3+PPSN; NALBytes:=4;
 End;
End;
{ Reconstruit les PTS a partir de POC H264 ou du temps VOP MPEG-4.
  Les paquets restent dans l'ordre de decodage. Aucune image n'est decodee. }

Procedure ReconstructAVI(T: Integer);
Type
 TOffsets=Array[0..255] Of LongInt;
Var
 V,G,LastG: PSample;
 ReadPosition,ReadLimit: LongInt;
 MemoryBits,EscapeBits: Boolean;
 BitCount,CurrentByte,ZeroCount: Integer;
 SPSID,PPSID,FrameBits,POCBits,POCType,Chroma,BottomPresent: Integer;
 RefL0,RefL1,WeightedBi: Integer;
 WeightedP,Redundant,FrameOnly,DeltaZero: Boolean;
 OffsetNonRef,OffsetBottom,CycleSum: LongInt;
 CycleCount: Integer;
 Offsets: TOffsets;
 PreviousLSB,PreviousMSB,PreviousFrame,PreviousFrameOffset: LongInt;
 FrameOffset,FrameNumber,PictureOrder: LongInt;
 HasPicture,ResetOrder: Boolean;
 SPSAt,SPSSize,PPSAt,PPSSize: Integer;
 GroupTime: LongInt;
 Resolution,TimeBits: Integer;
 TimeBase,LastTimeBase,RawStep,RawFixed,RawLast,RawIndex: LongInt;

Procedure BitsAt(At,Limit: LongInt; InMemory,Escaped: Boolean);Begin
 ReadPosition:=At; ReadLimit:=Limit; MemoryBits:=InMemory; EscapeBits:=Escaped;
 BitCount:=0; ZeroCount:=0;
End;

Function ReadByte: Integer;Begin
 If ReadPosition>=ReadLimit Then Fail(
 'En-tete video tronque pendant la reconstruction PTS.');
 If MemoryBits Then ReadByte:=Tracks^[T].Config[ReadPosition] Else ReadByte:=ByteAt(
 ReadPosition);
 Inc(ReadPosition);
End;

Function Bit: Integer;
Var
 C: Integer;
Begin
 If BitCount=0 Then Begin
  C:=ReadByte;
  If EscapeBits And (ZeroCount>=2) And (C=3) Then Begin
   C:=ReadByte; If C>3 Then Fail('Octet emulation-prevention H264 incorrect.');
   ZeroCount:=0;
  End;
  If C=0 Then Inc(ZeroCount) Else ZeroCount:=0;
  CurrentByte:=C; BitCount:=8;
 End;
 Dec(BitCount); Bit:=(CurrentByte Shr BitCount) And 1;
End;

Function GetBits(N: Integer): LongInt;
Var
 A: Integer;
 D: LongInt;
Begin
 If (N<0) Or (N>30) Then Fail('Champ binaire video hors limite.');
 D:=0;
 For A:=1 To N Do D:=D*2+Bit; GetBits:=D;
End;

Function UE: LongInt;
Var
 N: Integer;
 D: LongInt;
Begin
 N:=0;
 While Bit=0 Do Begin
  Inc(N); If N>24 Then Fail('Exp-Golomb H264 hors limite.');
 End;
 D:=GetBits(N); UE:=(LongInt(1) Shl N)-1+D;
End;

Function SE: LongInt;
Var
 D: LongInt;
Begin
 D:=UE; If Odd(D) Then SE:=(D+1) Div 2 Else SE:=-(D Div 2);
End;

Function SmallUE(Maximum: Integer): Integer;
Var
 D: LongInt;
Begin
 D:=UE; If D>Maximum Then Fail('Parametre H264 hors limite.'); SmallUE:=D;
End;

Procedure Marker;Begin
 If Bit<>1 Then Fail('Marqueur temporel MPEG-4 invalide.');
End;

Procedure ScalingList(N: Integer);
Var
 A,Last,Next: Integer;
 Delta: LongInt;
Begin
 Last:=8; Next:=8;
 For A:=1 To N Do Begin
  If Next<>0 Then Begin
   Delta:=SE; Next:=(Last+(Delta Mod 256)+256) Mod 256;
  End;
  If Next<>0 Then Last:=Next;
 End;
End;

Procedure ParseAVCConfig;
Var
 A,Profile,N,SkipValue: LongInt;
Begin
 With Tracks^[T] Do Begin
  If (ConfigSize<8) Or ((Config[5] And 31)<>1) Then Fail(
  'PTS AVI: une seule SPS H264 requise.');
  SPSAt:=8; SPSSize:=Integer(Config[6])*256+Config[7];
  A:=SPSAt+SPSSize;
  If (SPSSize<4) Or (A+3>ConfigSize) Then Fail('SPS avcC tronquee.');
  If Config[A]<>1 Then Fail('PTS AVI: une seule PPS H264 requise.');
  PPSAt:=A+3; PPSSize:=Integer(Config[A+1])*256+Config[A+2];
  If (PPSSize<2) Or (PPSAt+PPSSize>ConfigSize) Then Fail('PPS avcC tronquee.');
 End;
 BitsAt(SPSAt+1,SPSAt+SPSSize,True,True);
 Profile:=GetBits(8); SkipValue:=GetBits(16); SPSID:=SmallUE(31); Chroma:=1;
 If SPSID>31 Then Fail('SPS id H264 hors limite.');
 If Profile In [44,83,86,100,110,118,122,128,134,135,138,139,244] Then Begin
  Chroma:=SmallUE(3);
  If Chroma=3 Then If Bit<>0 Then Fail('H264 separate colour planes non pris en charge.');
  SkipValue:=UE; SkipValue:=UE; SkipValue:=Bit;
  If Bit<>0 Then Begin
   N:=8; If Chroma=3 Then N:=12;
   For A:=0 To N-1 Do If Bit<>0 Then If A<6 Then ScalingList(16) Else ScalingList(64);
  End;
 End;
 FrameBits:=SmallUE(12)+4;
 POCType:=SmallUE(2); CycleCount:=0; CycleSum:=0;
 If POCType=0 Then Begin
  POCBits:=SmallUE(12)+4;
 End Else If POCType=1 Then Begin
  DeltaZero:=Bit<>0; OffsetNonRef:=SE; OffsetBottom:=SE; CycleCount:=SmallUE(255);
  If CycleCount>255 Then Fail('Cycle POC H264 hors limite.');
  For A:=0 To CycleCount-1 Do Begin
   Offsets[A]:=SE; CycleSum:=Ticks(CycleSum*1.0+Offsets[A]);
  End;
 End Else If POCType<>2 Then Fail('Type POC H264 inconnu.');
 SkipValue:=UE; SkipValue:=Bit; SkipValue:=UE; SkipValue:=UE; FrameOnly:=Bit<>0;
 BitsAt(PPSAt+1,PPSAt+PPSSize,True,True);
 PPSID:=SmallUE(255); If UE<>SPSID Then Fail('PPS et SPS H264 incompatibles.');
 SkipValue:=Bit; BottomPresent:=Bit;
 If UE<>0 Then Fail('Groupes de slices H264 FMO non pris en charge.');
 RefL0:=SmallUE(31)+1; RefL1:=SmallUE(31)+1;
 If (RefL0>32) Or (RefL1>32) Then Fail('Trop de references H264.');
 WeightedP:=Bit<>0; WeightedBi:=GetBits(2);
 SkipValue:=SE; SkipValue:=SE; SkipValue:=SE; SkipValue:=Bit; SkipValue:=Bit;
 Redundant:=Bit<>0;
 PreviousLSB:=0; PreviousMSB:=0; PreviousFrame:=0; PreviousFrameOffset:=0;
End;

Procedure RefList;
Var
 Code,A: LongInt;
 N: Integer;
Begin
 If Bit<>0 Then Begin
  N:=0;
  Repeat
  Code:=UE; Inc(N); If (N>64) Or (Code>3) Then Fail('Liste de references H264 invalide.');
  If Code<>3 Then A:=UE;
  Until Code=3;
 End;
End;

Procedure WeightList(N: Integer);
Var
 A,C: Integer;
 D: LongInt;
Begin
 For A:=1 To N Do Begin
  If Bit<>0 Then Begin
   D:=SE; D:=SE;
  End;
  If Chroma<>0 Then If Bit<>0 Then
  For C:=1 To 2 Do Begin
   D:=SE; D:=SE;
  End;
 End;
End;

Procedure Slice(Payload,Finish: LongInt; Kind,RefID: Integer);
Var
 FirstMB,SliceKind,N,FrameID,LSB,MSB,Top,Bottom,Delta0,Delta1,AbsFrame: LongInt;
 Expected: Double;
 A,L0,L1,MMCO,Operations: Integer;
 FirstSlice: Boolean;
Begin
 BitsAt(Payload+1,Finish,False,True);
 FirstMB:=UE; SliceKind:=UE; If SliceKind>9 Then Fail('Type slice H264 invalide.');
 SliceKind:=SliceKind Mod 5;
 If UE<>PPSID Then Fail('Changement PPS H264 non pris en charge.');
 FrameID:=GetBits(FrameBits);
 If Not FrameOnly Then If Bit<>0 Then Fail('Images H264 par champs non prises en charge.')
 ;
 If Kind=5 Then N:=UE;
 Delta0:=0; Delta1:=0; LSB:=0;
 If POCType=0 Then Begin
  LSB:=GetBits(POCBits); If BottomPresent<>0 Then Delta1:=SE;
 End
 Else If (POCType=1) And Not DeltaZero Then Begin
  Delta0:=SE; If BottomPresent<>0 Then Delta1:=SE;
 End;
 FirstSlice:=Not HasPicture;
 If Not FirstSlice Then Begin
  If (FirstMB=0) Or (FrameID<>FrameNumber) Then Fail(
  'Plusieurs images H264 dans un paquet AVI.');
  Exit;
 End;
 If FirstMB<>0 Then Fail('Premiere slice H264 manquante.');
 HasPicture:=True; FrameNumber:=FrameID; ResetOrder:=Kind=5; V^.Key:=ResetOrder;
 If Kind=5 Then Begin
  PreviousLSB:=0; PreviousMSB:=0; PreviousFrame:=0; PreviousFrameOffset:=0;
 End;
 FrameOffset:=PreviousFrameOffset;
 If FrameNumber<PreviousFrame Then FrameOffset:=Ticks(FrameOffset*1.0+(LongInt(1)
 Shl FrameBits));
 If POCType=0 Then Begin
  N:=LongInt(1) Shl POCBits; MSB:=PreviousMSB;
  If (LSB<PreviousLSB) And (PreviousLSB-LSB>=N Div 2) Then MSB:=Ticks(MSB*1.0+N) Else
  If (LSB>PreviousLSB) And (LSB-PreviousLSB>N Div 2) Then MSB:=Ticks(MSB*1.0-N);
  Top:=Ticks(MSB*1.0+LSB); Bottom:=Ticks(Top*1.0+Delta1);
  If RefID<>0 Then Begin
   PreviousLSB:=LSB; PreviousMSB:=MSB;
  End;
 End Else If POCType=1 Then Begin
  AbsFrame:=Ticks(FrameOffset*1.0+FrameNumber); If CycleCount=0 Then AbsFrame:=0;
  If (RefID=0) And (AbsFrame>0) Then Dec(AbsFrame);
  Expected:=0;
  If AbsFrame>0 Then Begin
   Expected:=((AbsFrame-1) Div CycleCount)*1.0*CycleSum;
   For A:=0 To (AbsFrame-1) Mod CycleCount Do Expected:=Expected+Offsets[A];
  End;
  If RefID=0 Then Expected:=Expected+OffsetNonRef;
  Top:=Ticks(Expected+Delta0); Bottom:=Ticks(Top*1.0+OffsetBottom+Delta1);
 End Else
 Begin
  Expected:=2.0*(FrameOffset*1.0+FrameNumber); If RefID=0 Then Expected:=Expected-1;
  If Kind=5 Then Expected:=0; Top:=Ticks(Expected); Bottom:=Top;
 End;
 PictureOrder:=Top; If Bottom<Top Then PictureOrder:=Bottom;
 PreviousFrame:=FrameNumber; PreviousFrameOffset:=FrameOffset;
 { Aller jusqu'au marquage des references pour ne pas ignorer un MMCO 5. }
 If Redundant Then N:=UE;
 If SliceKind=1 Then N:=Bit;
 L0:=RefL0; L1:=RefL1;
 If (SliceKind=0) Or (SliceKind=1) Or (SliceKind=3) Then If Bit<>0 Then Begin
  L0:=SmallUE(31)+1; If SliceKind=1 Then L1:=SmallUE(31)+1;
  If (L0>32) Or (L1>32) Then Fail('References H264 hors limite.');
 End;
 If (SliceKind<>2) And (SliceKind<>4) Then RefList;
 If SliceKind=1 Then RefList;
 If (WeightedP And ((SliceKind=0) Or (SliceKind=3))) Or ((WeightedBi=1) And (SliceKind=1))
 Then Begin
  N:=UE; If Chroma<>0 Then N:=UE; WeightList(L0); If SliceKind=1 Then WeightList(L1);
 End;
 If RefID<>0 Then Begin
  If Kind=5 Then Begin
   N:=Bit; N:=Bit;
  End
  Else If Bit<>0 Then Begin
   Operations:=0;
   Repeat
   MMCO:=SmallUE(6); Inc(Operations);
   If Operations>64 Then Fail('Marquage references H264 invalide.');
   If MMCO=5 Then Fail('Reinitialisation POC H264 MMCO 5 non prise en charge.');
   If (MMCO=1) Or (MMCO=3) Then N:=UE;
   If MMCO=2 Then N:=UE;
   If (MMCO=3) Or (MMCO=6) Then N:=UE;
   If MMCO=4 Then N:=UE;
   Until MMCO=0;
  End;
 End;
End;

Procedure AVCPicture;
Var
 At,Payload,NextPayload,Finish,NalEnd: LongInt;
 Kind,RefID,A,ConfigAt,ConfigLength: Integer;
Begin
 Finish:=V^.Pos+V^.Size; At:=StartCode(V^.Pos,Finish,Payload); HasPicture:=False;
 ResetOrder:=False;
 While At>=0 Do Begin
  NalEnd:=StartCode(Payload,Finish,NextPayload); If NalEnd<0 Then NalEnd:=Finish;
  If Payload>=NalEnd Then Fail('NAL H264 vide.');
  Kind:=ByteAt(Payload) And 31; RefID:=(ByteAt(Payload) Shr 5) And 3;
  If (Kind=1) Or (Kind=5) Then Slice(Payload,NalEnd,Kind,RefID) Else
  If (Kind=7) Or (Kind=8) Then Begin
   If Kind=7 Then Begin
    ConfigAt:=SPSAt; ConfigLength:=SPSSize;
   End
    Else
   Begin
    ConfigAt:=PPSAt; ConfigLength:=PPSSize;
   End;
   If NalEnd-Payload<>ConfigLength Then Fail(
   'Changement configuration H264 non pris en charge.');
   For A:=0 To ConfigLength-1 Do If ByteAt(Payload+A)<>Tracks^[T].Config[ConfigAt+
   A] Then Fail('Changement SPS/PPS H264 non pris en charge.');
  End Else If Kind In [2,3,4,14,20,21] Then Fail('Extension H264 non prise en charge.');
  At:=StartCode(Payload,Finish,Payload);
 End;
 If Not HasPicture Then Fail('Paquet AVI H264 sans image.');
 V^.Order:=PictureOrder;
End;

Procedure ParseVOL;
Var
 A,Version,Value: LongInt;
Begin
 A:=0;
 With Tracks^[T] Do Begin
  While (A+4<ConfigSize) And Not ((Config[A]=0) And (Config[A+1]=0) And (Config[A+2]=1)
  And
  (Config[A+3]>=$20) And (Config[A+3]<=$2F)) Do Inc(A);
  If A+4>=ConfigSize Then Fail('VOL MPEG-4 absent pour reconstruire les PTS.');
  BitsAt(A+4,ConfigSize,True,False);
 End;
 Value:=Bit; Value:=GetBits(8); Version:=1;
 If Bit<>0 Then Begin
  Version:=GetBits(4); Value:=GetBits(3);
 End;
 Value:=GetBits(4); If Value=15 Then Value:=GetBits(16);
 If Bit<>0 Then Begin
  Value:=GetBits(2); Value:=Bit;
  If Bit<>0 Then Begin
   Value:=GetBits(15); Marker; Value:=GetBits(15); Marker; Value:=GetBits(15); Marker;
   Value:=GetBits(3); Value:=GetBits(11); Marker; Value:=GetBits(15); Marker;
  End;
 End;
 Value:=GetBits(2); If Value<>0 Then Fail('Forme VOL MPEG-4 non rectangulaire.');
 Marker; Resolution:=GetBits(16);
 If Resolution=0 Then Fail('Resolution temporelle MPEG-4 nulle.');
 TimeBits:=1; Value:=Resolution-1;
 While Value>1 Do Begin
  Inc(TimeBits); Value:=Value Shr 1;
 End;
 Marker; TimeBase:=0; LastTimeBase:=0;
 If InKind='m4v' Then Begin
  RawFixed:=0; If Bit<>0 Then RawFixed:=GetBits(TimeBits);
  Marker; Tracks^[T].Width:=GetBits(13); Marker;
  Tracks^[T].Height:=GetBits(13); Marker;
 End;
End;

Procedure MPEGPicture;
Var
 At,Finish,Seconds,Increment,Kind,Hours,Minutes: LongInt;
 Found: Boolean;
Begin
 Finish:=V^.Pos+V^.Size; At:=V^.Pos; Found:=False;
 While At+4<Finish Do Begin
  If (ByteAt(At)=0) And (ByteAt(At+1)=0) And (ByteAt(At+2)=1) And (ByteAt(At+3)=$B3)
  Then Begin
   BitsAt(At+4,Finish,False,False); Hours:=GetBits(5); Minutes:=GetBits(6); Marker;
   Seconds:=GetBits(6);
   If (Hours>23) Or (Minutes>59) Or (Seconds>59) Then Fail(
   'Timecode GOP MPEG-4 invalide.');
   TimeBase:=Seconds+60*(Minutes+60*Hours);
  End;
  If (ByteAt(At)=0) And (ByteAt(At+1)=0) And (ByteAt(At+2)=1) And (ByteAt(At+3)=$B6)
  Then Begin
   If Found Then Fail(
   'MPEG-4 packed bitstream: plusieurs VOP par paquet non pris en charge.');
   Found:=True; BitsAt(At+4,Finish,False,False); Kind:=GetBits(2);
   If Kind=3 Then Fail('VOP MPEG-4 sprite non pris en charge.');
   Seconds:=0;
   While Bit<>0 Do Begin
    Inc(Seconds); If Seconds>3600 Then Fail('Temps VOP MPEG-4 invalide.');
   End;
   Marker; Increment:=GetBits(TimeBits); Marker;
   If Bit=0 Then Fail('VOP MPEG-4 non code non pris en charge.');
   If Kind<>2 Then Begin
    LastTimeBase:=TimeBase; Inc(TimeBase,Seconds); Seconds:=TimeBase;
   End
   Else Seconds:=LastTimeBase+Seconds;
   V^.Order:=Ticks(Seconds*1.0*Resolution+Increment); V^.Key:=Kind=0;
  End;
  Inc(At);
 End;
 If Not Found Then Fail('Paquet MPEG-4 sans VOP.');
 ResetOrder:=False;
End;

Function Merge(A,B: PSample): PSample;
Var
 Head,Tail,N: PSample;
Begin
 Head:=Nil; Tail:=Nil;
 While (A<>Nil) Or (B<>Nil) Do Begin
  If A=Nil Then Begin
   N:=B; B:=B^.DisplayNext;
  End
  Else If B=Nil Then Begin
   N:=A; A:=A^.DisplayNext;
  End
  Else If A^.Order<=B^.Order Then Begin
   N:=A; A:=A^.DisplayNext;
  End
   Else
  Begin
   N:=B; B:=B^.DisplayNext;
  End;
  If Tail=Nil Then Head:=N Else Tail^.DisplayNext:=N; Tail:=N;
 End;
 If Tail<>Nil Then Tail^.DisplayNext:=Nil; Merge:=Head;
End;

Function Sort(Head: PSample): PSample;
Var
 Slow,Fast,Other: PSample;
Begin
 If Head=Nil Then Begin
  Sort:=Nil; Exit;
 End;
 If Head^.DisplayNext=Nil Then Begin
  Sort:=Head; Exit;
 End;
 Slow:=Head; Fast:=Head^.DisplayNext;
 While Fast<>Nil Do Begin
  Fast:=Fast^.DisplayNext; If Fast<>Nil Then Begin
   Slow:=Slow^.DisplayNext; Fast:=Fast^.DisplayNext;
  End;
 End;
 Other:=Slow^.DisplayNext; Slow^.DisplayNext:=Nil; Sort:=Merge(Sort(Head),Sort(Other));
End;

Procedure FinishGroup;
Var
 A,Previous: PSample;
Begin
 A:=Sort(G); Previous:=Nil;
 While A<>Nil Do Begin
  If Previous<>Nil Then If Previous^.Order=A^.Order Then Fail(
  'Ordre de presentation ambigu dans AVI.');
  A^.Composition:=Ticks(GroupTime*1.0-A^.Time);
  GroupTime:=Ticks(GroupTime*1.0+A^.Duration);
  Previous:=A; A:=A^.DisplayNext;
 End;
 G:=Nil; LastG:=Nil;
End;
Begin
 G:=Nil; LastG:=Nil; GroupTime:=0;
 If Tracks^[T].Codec='avc1' Then ParseAVCConfig Else ParseVOL;
 V:=Tracks^[T].First;
 While V<>Nil Do Begin
  If Tracks^[T].Codec='avc1' Then AVCPicture Else MPEGPicture;
  If ResetOrder And (G<>Nil) Then FinishGroup;
  If LastG=Nil Then G:=V Else LastG^.DisplayNext:=V;
  LastG:=V; V^.DisplayNext:=Nil; V:=V^.Next;
 End;
 If InKind='m4v' Then Begin
  G:=Sort(G); RawStep:=RawFixed; V:=G;
  If V<>Nil Then Begin
   RawLast:=V^.Order; V:=V^.DisplayNext;
   While V<>Nil Do Begin
    If RawStep=0 Then RawStep:=V^.Order-RawLast;
    If (RawStep<=0) Or (V^.Order-RawLast<>RawStep) Then
     Fail('M4V: cadence variable ou chronologie ambigue non prise en charge.');
    RawLast:=V^.Order; V:=V^.DisplayNext;
   End;
  End;
  If RawStep<=0 Then Fail('M4V: cadence indeterminable (une seule image sans cadence fixe).');
  Tracks^[T].Scale:=Resolution; Tracks^[T].InputScale:=Resolution;
  RawIndex:=0; V:=Tracks^[T].First;
  While V<>Nil Do Begin
   V^.Time:=Ticks(RawIndex*1.0*RawStep); V^.Duration:=RawStep;
   Inc(RawIndex); V:=V^.Next;
  End;
 End;
 FinishGroup;
End;

Procedure WriteAVCInitialization(T: Integer);
Var
 A,B,D,N,K: LongInt;
 OldLE: Boolean;
Begin
 OldLE:=LE; LE:=False;
 With Tracks^[T] Do Begin
  A:=6; K:=Config[5] And 31;
  For D:=0 To 1 Do Begin
   For N:=1 To K Do Begin
    If A+2>ConfigSize Then Fail('avcC tronque.');
    B:=LongInt(Config[A])*256+Config[A+1]; Inc(A,2);
    If (B=0) Or (B>ConfigSize-A) Then Fail('NAL avcC tronque.');
    W32(1); WriteBytes(Config[A],B); Inc(A,B);
   End;
   If D=0 Then Begin
    If A>=ConfigSize Then Fail('PPS avcC absent.'); K:=Config[A]; Inc(A);
   End;
  End;
 End;
 LE:=OldLE;
End;

{ FFV1 v0/v1, range coder, 8-bit YUV420. FFmpeg-derived range/symbol
  algorithms: LGPL-2.1-or-later; see THIRD_PARTY_NOTICES.md. }
Procedure FFRenorm;
Var Carry: Integer;
Begin
 If (FFLow<$FF01) Or (FFLow>=$10000) Then Begin
  Carry:=0; If FFLow>=$10000 Then Carry:=1;
  If FFOutstanding>=0 Then W8((FFOutstanding+Carry) And 255);
  While FFCount>0 Do Begin W8((255+Carry) And 255); Dec(FFCount); End;
  FFOutstanding:=FFLow Shr 8;
 End Else Inc(FFCount);
 FFLow:=(FFLow And 255)*256; FFRange:=FFRange*256;
End;

Function FFRac(Var State: Byte; Value: Integer): Integer;
Var R: LongInt;
Begin
 If (State=0) Or (State=255) Then Fail('FFV1: etat probabiliste invalide.');
 R:=(FFRange*State) Div 256;
 If FFEncoding Then Begin
  If Value=0 Then Begin FFRange:=FFRange-R; State:=FFZero[State]; End
  Else Begin FFLow:=FFLow+FFRange-R; FFRange:=R; State:=FFOne[State]; End;
  If FFRange<256 Then FFRenorm;
 End Else Begin
  FFRange:=FFRange-R; Value:=0;
  If FFLow<FFRange Then State:=FFZero[State] Else Begin
   Value:=1; FFLow:=FFLow-FFRange; FFRange:=R; State:=FFOne[State];
  End;
  If FFRange<256 Then Begin
   FFRange:=FFRange*256; FFLow:=FFLow*256;
   If FFPos<FFEnd Then Begin Inc(FFLow,ByteAt(FFPos)); Inc(FFPos); End
   Else Begin Inc(FFOverread); If FFOverread>2 Then Fail('FFV1: trame tronquee.'); End;
  End;
 End;
 FFRac:=Value;
End;

Function FFSymbol(Var State: TFFState; Value: Integer; SignedValue: Boolean): Integer;
Var A,E,J,Dummy: Integer;
Begin
 If FFEncoding Then Begin
  If Value=0 Then Dummy:=FFRac(State[0],1) Else Begin
   Dummy:=FFRac(State[0],0); A:=Abs(Value); E:=0; J:=A;
   While J>1 Do Begin Inc(E); J:=J Div 2; End;
   If E>9 Then Fail('FFV1: symbole encode hors limites.');
   For J:=0 To E-1 Do Dummy:=FFRac(State[1+J],1);
   Dummy:=FFRac(State[1+E],0);
   For J:=E-1 Downto 0 Do Dummy:=FFRac(State[22+J],(A Shr J) And 1);
   If SignedValue Then Dummy:=FFRac(State[11+E],Ord(Value<0));
  End;
 End Else Begin
  Value:=0;
  If FFRac(State[0],0)=0 Then Begin
   E:=0; While FFRac(State[1+E],0)<>0 Do Begin
    Inc(E); If E>9 Then Fail('FFV1: symbole hors limites.');
   End;
   A:=1;
   For J:=E-1 Downto 0 Do A:=A*2+FFRac(State[22+J],0);
   Value:=A; If SignedValue Then If FFRac(State[11+E],0)<>0 Then Value:=-Value;
  End;
 End;
 FFSymbol:=Value;
End;

Procedure FFFrame(T: Integer; V: PSample; EncodeMode: Boolean);
Var
 HS,QS: TFFState; Key: Byte;
 I,J,K,N,Q,Scale,Version,Coder,Dummy,Plane,PW,PH,X,Y,Cur,Prev,PC,Context,Diff,Pred,L,Top,LT,Pixel: Integer;
 RawPos: LongInt; Negative: Boolean;
 Row: Array[0..4095] Of Byte;
Begin
 FFEncoding:=EncodeMode; FFRange:=$FF00; FFLow:=0; FFOutstanding:=-1; FFCount:=0; FFOverread:=0;
 Move(FFDefault,FFOne,SizeOf(FFOne)); FillChar(FFZero,SizeOf(FFZero),0);
 For I:=1 To 255 Do FFZero[I]:=(256-FFOne[256-I]) And 255;
 FFPos:=V^.Pos; FFEnd:=V^.Pos+V^.Size; RawPos:=FFPos;
 If Not EncodeMode Then Begin
  If Tracks^[T].ConfigSize<>0 Then Fail('FFV1: versions avec configuration globale non implementees.');
  If FFEnd-FFPos<2 Then Fail('FFV1: trame vide.');
  FFLow:=ByteAt(FFPos)*256+ByteAt(FFPos+1); Inc(FFPos,2);
  If FFLow>=$FF00 Then Fail('FFV1: code initial invalide.');
 End;
 Key:=128; N:=FFRac(Key,1);
 If N<>0 Then Begin
  FillChar(HS,SizeOf(HS),128); Version:=FFSymbol(HS,1,False);
  If (Version<0) Or (Version>1) Then Fail('FFV1: seules versions 0/1 implementees.');
  Coder:=FFSymbol(HS,1,False);
  If Coder<>1 Then Fail('FFV1: range coder avec table par defaut requis.');
  If FFSymbol(HS,0,False)<>0 Then Fail('FFV1: espace YUV requis.');
  If Version=1 Then If FFSymbol(HS,8,False)<>8 Then Fail('FFV1: 8 bits requis.');
  If FFRac(HS[0],1)<>1 Then Fail('FFV1: plans chroma requis.');
  If FFSymbol(HS,1,False)<>1 Then Fail('FFV1: YUV420 requis.');
  If FFSymbol(HS,1,False)<>1 Then Fail('FFV1: YUV420 requis.');
  If FFRac(HS[0],0)<>0 Then Fail('FFV1: transparence non implementee.');
  Scale:=1;
  For I:=0 To 4 Do Begin
   FillChar(QS,SizeOf(QS),128); J:=0; Q:=0;
   While J<128 Do Begin
    N:=FFSymbol(QS,127,False)+1;
    If (N<1) Or (N>128-J) Then Fail('FFV1: table de quantification invalide.');
    For K:=1 To N Do Begin FFQuant[I,J]:=Scale*Q; Inc(J); End;
    Inc(Q);
   End;
   For J:=1 To 127 Do FFQuant[I,256-J]:=-FFQuant[I,J];
   FFQuant[I,128]:=-FFQuant[I,127];
   If Scale>2047 Div (2*Q-1) Then Fail('FFV1: trop de contextes.');
   Scale:=Scale*(2*Q-1);
  End;
  If (FFQuant[3,127]<>0) Or (FFQuant[4,127]<>0) Then Fail('FFV1: contexte a cinq differences non implemente.');
  FFContexts:=(Scale+1) Div 2;
  For I:=0 To 1 Do FillChar(FFStates[I]^,SizeOf(TFFStates),128);
  FFConfigured:=True;
 End Else If Not FFConfigured Then Fail('FFV1: premiere image cle requise.');
 For Plane:=0 To 2 Do Begin
  PW:=Tracks^[T].Width; PH:=Tracks^[T].Height; PC:=0;
  If Plane<>0 Then Begin PW:=(PW+1) Div 2; PH:=(PH+1) Div 2; PC:=1; End;
  FillChar(FFRows^,SizeOf(TFFRows),0);
  For Y:=0 To PH-1 Do Begin
   Cur:=Y And 1; Prev:=1-Cur;
   FFRows^[Cur,0]:=FFRows^[Prev,1]; FFRows^[Prev,PW+1]:=FFRows^[Prev,PW];
   If EncodeMode Then Begin ReadAt(RawPos,Row,PW); Inc(RawPos,PW); End;
   For X:=1 To PW Do Begin
    L:=FFRows^[Cur,X-1]; Top:=FFRows^[Prev,X]; LT:=FFRows^[Prev,X-1];
    Context:=FFQuant[0,(L-LT) And 255]+FFQuant[1,(LT-Top) And 255]+
     FFQuant[2,(Top-FFRows^[Prev,X+1]) And 255];
    Negative:=Context<0; Context:=Abs(Context);
    If Context>=FFContexts Then Fail('FFV1: contexte invalide.');
    Pred:=L+Top-LT;
    If L<Top Then Begin If Pred<L Then Pred:=L Else If Pred>Top Then Pred:=Top; End
    Else Begin If Pred<Top Then Pred:=Top Else If Pred>L Then Pred:=L; End;
    Diff:=0;
    If EncodeMode Then Begin
     Diff:=Row[X-1]-Pred; If Negative Then Diff:=-Diff;
     Diff:=((Diff+128) And 255)-128;
    End;
    Diff:=FFSymbol(FFStates[PC]^[Context],Diff,True);
    If Negative Then Diff:=-Diff;
    Pixel:=(Pred+Diff) And 255; FFRows^[Cur,X]:=Pixel; Row[X-1]:=Pixel;
   End;
   If Not EncodeMode Then WriteBytes(Row,PW);
  End;
 End;
 If EncodeMode Then Begin FFRange:=255; Inc(FFLow,255); FFRenorm; FFRange:=255; FFRenorm; End;
End;

Function Y4Line(Var At: LongInt): String;
Var S: String; B: Byte;
Begin
 S:='';
 Repeat
  If At>=FileLimit Then Fail('Y4M: ligne tronquee.'); B:=ByteAt(At); Inc(At);
  If B=10 Then Break;
  If Length(S)=250 Then Fail('Y4M: ligne trop longue.'); S:=S+Chr(B);
 Until False;
 Y4Line:=S;
End;

{ FLV1/Sorenson Spark intra profile. H.263 VLC tables from FFmpeg,
  LGPL-2.1-or-later; see THIRD_PARTY_NOTICES.md. }
Function LVBits(Count: Integer; Value: LongInt): LongInt;
Var I,B: Integer; R: LongInt;
Begin
 R:=0;
 For I:=Count-1 Downto 0 Do Begin
  If LVEncoding Then Begin
   LVByte:=LVByte*2+((Value Shr I) And 1); Inc(LVCount);
   If LVCount=8 Then Begin W8(LVByte); LVByte:=0; LVCount:=0; End;
  End Else Begin
   If LVCount=0 Then Begin
    If LVPos>=LVEnd Then Fail('FLV1: bits tronques.');
    LVByte:=ByteAt(LVPos); Inc(LVPos); LVCount:=8;
   End;
   Dec(LVCount); B:=(LVByte Shr LVCount) And 1; R:=R*2+B;
  End;
 End;
 If LVEncoding Then LVBits:=Value Else LVBits:=R;
End;

Procedure LVHeader(T: Integer; V: PSample; EncodeMode: Boolean);
Var F,W,H,D: LongInt;
Begin
 LVEncoding:=EncodeMode; LVPos:=V^.Pos; LVEnd:=V^.Pos+V^.Size; LVCount:=0; LVByte:=0;
 If LVBits(17,1)<>1 Then Fail('FLV1: code de debut incorrect.');
 LVVersion:=LVBits(5,1); If LVVersion>1 Then Fail('FLV1: version non prise en charge.');
 D:=LVBits(8,0); F:=LVBits(3,1);
 Case F Of
  0: Begin W:=LVBits(8,Tracks^[T].Width); H:=LVBits(8,Tracks^[T].Height); End;
  1: Begin W:=LVBits(16,Tracks^[T].Width); H:=LVBits(16,Tracks^[T].Height); End;
  2: Begin W:=352; H:=288; End; 3: Begin W:=176; H:=144; End;
  4: Begin W:=128; H:=96; End; 5: Begin W:=320; H:=240; End;
  6: Begin W:=160; H:=120; End; Else Fail('FLV1: dimensions invalides.');
 End;
 If (W<1) Or (H<1) Or (W>1024) Or (H>1024) Then Fail('FLV1: dimensions 1..1024 requises.');
 If (Tracks^[T].Width<>0) And ((Tracks^[T].Width<>W) Or (Tracks^[T].Height<>H)) Then
  Fail('FLV1: changement de dimensions non pris en charge.');
 Tracks^[T].Width:=W; Tracks^[T].Height:=H;
 If LVBits(2,0)<>0 Then Fail('FLV1: seules images intra implementees; images P non prises en charge.');
 D:=LVBits(1,0); LVQP:=LVBits(5,LVEncodeQP);
 If LVQP=0 Then Fail('FLV1: quantification nulle.');
 While LVBits(1,0)<>0 Do D:=LVBits(8,0);
End;

