Function NextByte:Byte;Begin
 If At>=RowEnd Then Fail('8bps: ligne RLE tronquee.'); NextByte:=ByteAt(At);
  Inc(At);
End;

Procedure Pixel(X,Y:Integer; Var R,G,B,A:LongInt);
Var
 Index:Integer;
Begin
 A:=255;
 If Count=1 Then Begin
  Index:=Planes[0]^[Y]^[X]*3; R:=Tracks^[T].Config[Index]; G:=Tracks^[T].Config[
   Index+1];
  B:=Tracks^[T].Config[Index+2];
 End Else
 Begin
  R:=Planes[0]^[Y]^[X]; G:=Planes[1]^[Y]^[X]; B:=Planes[2]^[Y]^[X];
  If Count=4 Then A:=Planes[3]^[Y]^[X];
 End;
End;

Function Shift8(Value:LongInt):LongInt;Begin
 If Value>=0 Then Shift8:=Value Div 256 Else Shift8:=-1-((-1-Value) Div 256);
End;
Begin
 W:=Tracks^[T].Width; H:=Tracks^[T].Height;
 If (W<1) Or (W>4096) Or (H<1) Or (H>4096) Then Fail(
  '8bps: dimensions 1..4096 requises.')
 ;
 Count:=Tracks^[T].BPDepth Div 8;
 If (Count<>1) And (Count<>3) And (Count<>4) Then Fail(
  '8bps: profondeur invalide.');
 At:=Sample^.Pos; Finish:=At+Sample^.Size; TableEnd:=At+LongInt(Count)*H*2;
 If TableEnd>Finish Then Fail('8bps: table des longueurs tronquee.');
 {$IFNDEF FPC}
  If MemAvail<LongInt(W)*H*Count+LongInt(SizeOf(TBPPlane))*Count+SizeOf(
   TBPOutput)+
  8192 Then Fail('8bps: memoire DOS insuffisante.');
 {$ENDIF}
 New(Row); At:=TableEnd;
 For P:=0 To Count-1 Do Begin
  New(Planes[P]);
  For Y:=0 To H-1 Do Begin
   GetMem(Planes[P]^[Y],W); N:=U16(Sample^.Pos+(LongInt(P)*H+Y)*2,False);
   If N>Finish-At Then Fail('8bps: ligne hors paquet.'); RowEnd:=At+N; X:=0;
   While At<RowEnd Do Begin
    Run:=NextByte;
    If Run<=127 Then Begin
     Inc(Run);
     If (Run>W-X) Or (Run>RowEnd-At) Then Fail(
      '8bps: sequence litterale hors ligne.');
     For J:=1 To Run Do Begin
      Planes[P]^[Y]^[X]:=NextByte; Inc(X);
     End;
    End Else
    Begin
     Run:=257-Run; If Run>W-X Then Fail('8bps: repetition hors ligne.'); V:=
      NextByte;
     For J:=1 To Run Do Begin
      Planes[P]^[Y]^[X]:=V; Inc(X);
     End;
    End;
   End;
   If X<>W Then Fail('8bps: ligne decodee incomplete.');
  End;
 End;
 If At<>Finish Then Fail('8bps: octets excedentaires apres les plans.');
 {$IFDEF TEST_8BPS_RGBA}
  For Y:=0 To H-1 Do Begin
   For X:=0 To W-1 Do Begin
    Pixel(X,Y,R,G,B,A); Row^[X*4]:=R; Row^[X*4+1]:=G; Row^[X*4+2]:=B; Row^[X*4+
     3]:=A;
   End;
   WriteBytes(Row^,W*4);
  End;
 {$ELSE}
  For P:=0 To 2 Do Begin
   CW:=W; CH:=H; If P<>0 Then Begin
    CW:=(W+1) Div 2; CH:=(H+1) Div 2;
   End;
   For Y:=0 To CH-1 Do Begin
    For X:=0 To CW-1 Do Begin
     If P=0 Then Begin
      Pixel(X,Y,R,G,B,A); Row^[X]:=16+((66*R+129*G+25*B+128) Div 256);
     End
      Else
     Begin
      Sum:=0;
      For DY:=0 To 1 Do
      For DX:=0 To 1 Do Begin
       XX:=X*2+DX; YY:=Y*2+DY; If XX>=W Then XX:=W-1; If YY>=H Then YY:=H-1;
       Pixel(XX,YY,R,G,B,A);
       If P=1 Then C:=-38*R-74*G+112*B Else C:=112*R-94*G-18*B;
       Inc(Sum,128+Shift8(C+128));
      End;
      Row^[X]:=(Sum+2) Div 4;
     End;
    End;
    WriteBytes(Row^,CW);
   End;
  End;
 {$ENDIF}
 For P:=0 To Count-1 Do Begin
  For Y:=0 To H-1 Do FreeMem(Planes[P]^[Y],W); Dispose(Planes[P]);
 End;
 Dispose(Row);
End;

