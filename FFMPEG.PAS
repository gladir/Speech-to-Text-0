Procedure ParseAspect(S: String);
Var K,C,Dots,Digits: Integer; N,D,G,R: LongInt; Decimal: Boolean;
Begin
 N:=0; D:=1; Dots:=0; Digits:=0; Decimal:=False;
 K:=Pos(':',S);
 If K>0 Then Begin
  For C:=1 To Length(S) Do If (C<>K) And Not (S[C] In ['0'..'9']) Then
   Fail('-aspect: N:D positif attendu.');
  Val(Copy(S,1,K-1),N,C); If C<>0 Then Fail('-aspect: ratio invalide.');
  Val(Copy(S,K+1,Length(S)),D,C); If C<>0 Then Fail('-aspect: ratio invalide.');
 End Else Begin
  For K:=1 To Length(S) Do
   If S[K]='.' Then Begin Inc(Dots); Decimal:=True; End Else
   If S[K] In ['0'..'9'] Then Begin
    Inc(Digits);
    If (N>100000000) Or (Decimal And (D>=1000000)) Then Fail('-aspect: precision maximale 6 decimales.');
    N:=N*10+Ord(S[K])-48; If Decimal Then D:=D*10;
   End Else Fail('-aspect: nombre positif ou N:D attendu.');
  If (Dots>1) Or (Digits=0) Then Fail('-aspect: ratio invalide.');
 End;
 If (N<=0) Or (D<=0) Or (N>1000000000) Or (D>1000000) Then Fail('-aspect: ratio positif hors limites.');
 G:=N; R:=D; While R<>0 Do Begin
  AspectNum:=G Mod R; G:=R; R:=AspectNum;
 End;
 AspectNum:=N Div G; AspectDen:=D Div G;
End;

BEGIN
 HasBFrames:=False; BFrames:=0; HasBQuant:=False; BQuantFactor:=1.25; BQuantOffset:=1.25;
 HasVideoBitrate:=False; VideoBitrate:=200000;
 HasVideoTolerance:=False; VideoTolerance:=4000000; HasVideoBuffer:=False; VideoBuffer:=0;
 HasComment:=False; CommentName:=''; CommentWideSize:=0; CommentUTF8Size:=0;
 FourMV:=False; HasAlbum:=False; AlbumName:=''; AlbumWideSize:=0; AlbumUTF8Size:=0;
 InputActive:=False; OutputActive:=False;
 HLSListOpen:=False; AllStreams:=False; NoVideo:=False; HLSBase:='';
 AspectNum:=0; AspectDen:=1;
 HasCrop:=False; CropTop:=0; CropBottom:=0; CropLeft:=0; CropRight:=0;
 NoAudio:=False; VideoCodec:=''; VideoFrames:=0; ImageWidth:=0; ImageHeight:=0;
 {$IFDEF MSWINDOWS}
  NetSession:=Nil; NetRequest:=Nil;
 {$ENDIF}
 For J:=0 To 6 Do Temps[J]:='';
 InputPath:=''; OutputPath:=''; InputFormat:=''; OutputFormat:='';
 AudioCodec:=''; PendingFormat:=''; RequestedRate:=0; RequestedChannels:=0; RequestedBitRateK:=320;
 Overwrite:=False; NoOverwrite:=False; HideBanner:=False; HasBitrate:=False;
 SavedExit:=ExitProc; ExitProc:=@ExitCleanup; Randomize;
 I:=1;
 While I<=ParamCount Do Begin
  Argument:=ParamStr(I);
  If (Argument='-h') Or (Argument='--help') Or (Argument='/?') Or (Argument='-help')
  Then Begin
   Help; Halt(0);
  End
  Else If Argument='-version' Then Begin
   WriteLn(
   'FFMPEG Pascal 1.11; sources de reference FFmpeg 8.0.git; moteurs Pascal du projet.');
   Halt(0);
  End
  Else If Argument='-formats' Then Begin
   ShowFormats; Halt(0);
  End
  Else If Argument='-codecs' Then Begin
   WriteLn('Codecs:');
   WriteLn(' D = decodage, E = encodage, A = audio, V = video');
   WriteLn('DEV    flv             Flash Video (FLV1/Sorenson Spark, images intra)');
   WriteLn('DEV    ffv1            FFmpeg codec #1 (v0/1, range defaut, YUV420 8 bits)');
   WriteLn(' EV    gif             GIF (palette RGB 3/3/2, LZW, une image)');
   WriteLn('D V    h264            H264 (premiere IDR CAVLC 8 bits 4:2:0 progressive)');
   WriteLn('D A    mp1             MP1 (MPEG audio layer 1)');
   WriteLn('DEA    mp3             MP3 (decodeur Layer III; encodeur MPEG-1 CBR 32..320k)');
   WriteLn('DEA    pcm_s16le       PCM signe 16 bits little-endian');
   WriteLn('D A    pcm_u8, pcm_s24le, pcm_s32le, pcm_s8, pcm_s16be, pcm_s24be, pcm_s32be');
   WriteLn(' EV    png             PNG (RGB24, sans compression)');
   WriteLn('D A    wmav2           WMA2 (44100/48000 Hz, VLC, blocs fixes, sans reservoir/bruit)');
   WriteLn(' EV    mpeg2video      MPEG-2 video (encodeur progressif I/B)');
   WriteLn('DEV    mpeg1video      MPEG-1 video (encodeur I/B; decodeur I/P/B)');
   WriteLn(' EV    mpeg4           MPEG-4 Part 2 (Y4M, I/P/B, options -4mv/-bf)');
   WriteLn('Copie seulement: h264, vp9, aac, opus (voir limites).'); Halt(0);
  End
  Else If Argument='-y' Then Overwrite:=True Else
  If Argument='-n' Then NoOverwrite:=True Else
  If Argument='-hide_banner' Then HideBanner:=True Else
  If Argument='-vn' Then NoVideo:=True Else
  If Argument='-comment' Then Begin
   CommentName:=NextArgument; HasComment:=True; PrepareComment;
  End
  Else If Argument='-album' Then Begin
   AlbumName:=NextArgument; HasAlbum:=True; PrepareAlbum;
  End Else
  If Argument='-an' Then NoAudio:=True Else
  If Argument='-aspect' Then Begin
   ParseAspect(NextArgument);
  End Else
  If (Argument='-croptop') Or (Argument='-cropbottom') Or (Argument='-cropleft') Or (Argument='-cropright') Then Begin
   Value:=NextArgument; Val(Value,Number,Code);
   If (Code<>0) Or (Number<0) Or (Number>8192) Then Fail('Crop: nombre entier de pixels 0..8192 requis.');
   HasCrop:=True;
   If Argument='-croptop' Then CropTop:=Number Else If Argument='-cropbottom' Then CropBottom:=Number
   Else If Argument='-cropleft' Then CropLeft:=Number Else CropRight:=Number;
  End Else
  If Argument='-4mv' Then Begin
   FourMV:=True;
  End Else
  If (Argument='-vcodec') Or (Argument='-c:v') Or (Argument='-codec:v') Then Begin
   If InputPath='' Then Fail('Codec video de sortie attendu apres -i.');
   VideoCodec:=Lower(NextArgument);
   If (VideoCodec<>'png') And (VideoCodec<>'gif') And (VideoCodec<>'copy') And
    (VideoCodec<>'ffv1') And (VideoCodec<>'flv') And (VideoCodec<>'mpeg4') And (VideoCodec<>'mpeg1video') And (VideoCodec<>'mpeg2video') And (VideoCodec<>'rawvideo') Then
    Fail('Codec video: png/gif, copy, ffv1, flv, mpeg4, mpeg1video, mpeg2video, rawvideo.');
  End Else If (Argument='-vframes') Or (Argument='-frames:v') Then Begin
   If InputPath='' Then Fail('Nombre d''images attendu apres -i.');
   Value:=NextArgument; Val(Value,Number,Code);
   If (Code<>0) Or (Number<>1) Then Fail('Extraction PNG/GIF: -vframes 1 uniquement.');
   VideoFrames:=1;
  End Else If Argument='-s' Then Begin
   If InputPath='' Then Fail('Dimensions de sortie attendues apres -i.');
   Value:=Lower(NextArgument); J:=Pos('x',Value);
   If J<2 Then Fail('-s exige LARGEURxHAUTEUR, exemple 106x106.');
   Val(Copy(Value,1,J-1),Number,Code);
   If (Code<>0) Or (Number<1) Or (Number>8192) Then Fail('Largeur image: 1..8192.');
   ImageWidth:=Number; Val(Copy(Value,J+1,255),Number,Code);
   If (Code<>0) Or (Number<1) Or (Number>4096) Then Fail('Hauteur image: 1..4096.');
   ImageHeight:=Number;
  End Else
  If Argument='-hls_base_url' Then Begin
   HLSBase:=NextArgument;
   If Not IsHTTP(HLSBase) Then Fail('-hls_base_url exige une URL HTTP/HTTPS.');
  End
  Else If Argument='-f' Then PendingFormat:=FormatName(NextArgument) Else
  If Argument='-i' Then Begin
   If InputPath<>'' Then Fail('Une seule entree est prise en charge.');
   InputPath:=NextArgument; InputFormat:=PendingFormat; PendingFormat:='';
  End
  Else If (Argument='-c') Or (Argument='-codec') Or (Argument='-c:a') Or (Argument=
  '-codec:a') Or (Argument='-acodec') Then Begin
   If InputPath='' Then Fail('Selection du codec de sortie attendue apres -i.');
   AllStreams:=(Argument='-c') Or (Argument='-codec');
   AudioCodec:=Lower(NextArgument);
  End
  Else If (Argument='-ar') Or (Argument='-ac') Then Begin
   If InputPath='' Then Fail('Option de sortie attendue apres -i: '+Argument);
   Value:=NextArgument; Val(Value,Number,Code);
   If Code<>0 Then Fail('Valeur numerique incorrecte: '+Value);
   If Argument='-ar' Then Begin
    If (Number<4000) Or (Number>192000) Then Fail('-ar attendu: 4000..192000.');
    RequestedRate:=Number;
   End Else
   Begin
    If (Number<>1) And (Number<>2) Then Fail('-ac attendu: 1 ou 2.');
    RequestedChannels:=Number;
   End;
  End
  Else If Argument='-bf' Then Begin
   Value:=NextArgument; Val(Value,Number,Code);
   If (Code<>0) Or (Number<0) Or (Number>16) Then Fail('-bf: nombre entier 0..16 requis.');
   BFrames:=Number; HasBFrames:=True;
  End
  Else If (Argument='-b') Or (Argument='-b:v') Then Begin
   VideoBitrate:=ParseVideoRate(NextArgument,'-b',1,100000000); HasVideoBitrate:=True;
  End
  Else If Argument='-b_qfactor' Then Begin
   BQuantFactor:=ParseBQuant(NextArgument,'-b_qfactor'); HasBQuant:=True;
  End
  Else If Argument='-b_qoffset' Then Begin
   BQuantOffset:=ParseBQuant(NextArgument,'-b_qoffset'); HasBQuant:=True;
  End
  Else If Argument='-bufsize' Then Begin
   VideoBuffer:=ParseVideoRate(NextArgument,'-bufsize',0,16760832); HasVideoBuffer:=True;
  End
  Else If Argument='-bt' Then Begin
   VideoTolerance:=ParseVideoRate(NextArgument,'-bt',0,2147483647); HasVideoTolerance:=True;
  End
  Else If (Argument='-b:a') Or (Argument='-ab') Then Begin
   If InputPath='' Then Fail('Debit de sortie attendu apres -i.');
   Value:=Lower(NextArgument);
   If Value='' Then Fail('Debit audio manquant.');
   If Value[Length(Value)]='k' Then Begin
    Delete(Value,Length(Value),1); Val(Value,Number,Code);
   End Else Begin
    Val(Value,Number,Code);
    { Ancienne syntaxe -ab 64: kbit/s. -b:a garde les bits/s. }
    If (Code=0) And Not ((Argument='-ab') And (Number>=32) And (Number<=320)) Then Begin
     If Number Mod 1000<>0 Then Code:=1 Else Number:=Number Div 1000;
    End;
   End;
   If Code<>0 Then Fail('Debit audio invalide; exemple -b:a 64k.');
   Case Number Of
    32,40,48,56,64,80,96,112,128,160,192,224,256,320: RequestedBitRateK:=Number;
    Else Fail('Debit MP3 requis: 32,40,48,56,64,80,96,112,128,160,192,224,256,320 kbit/s.');
   End;
   HasBitrate:=True;
  End
  Else If (Copy(Argument,1,1)='-') Then Fail('Option non prise en charge: '+Argument)
   Else
  Begin
   If (OutputPath<>'') Or (InputPath='') Then Fail(
   'Usage: ffmpeg -i ENTREE [options] SORTIE');
   OutputPath:=Argument; OutputFormat:=PendingFormat; PendingFormat:='';
   If I<>ParamCount Then Fail('La sortie doit etre le dernier argument.');
  End;
  Inc(I);
 End;
 If ParamCount=0 Then Begin
  Help; Halt(1);
 End;
 If (InputPath='') Or (OutputPath='') Then Fail(
 'Une entree -i et une sortie sont requises.');
 If Overwrite And NoOverwrite Then Fail('-y et -n sont incompatibles.');
 If (InputPath='-') Or ((Pos('://',InputPath)>0) And Not IsHTTP(InputPath)) Then Fail(
 'Entree locale ou HLS HTTP/HTTPS requise.');
 If Lower(FExpand(InputPath))=Lower(FExpand(OutputPath)) Then Fail(
 'Entree et sortie doivent etre differentes.');
 If IsDirectory(OutputPath) Then Fail('La sortie designe un dossier.');
 If Exists(OutputPath) And Not Overwrite Then Fail('Sortie existante (utiliser -y): '+
 OutputPath);
 Intermediate:=InputPath;
 If IsHTTP(InputPath) Then Begin
  Temps[0]:=NewTemporary; DownloadHLS(InputPath,Temps[0]); Intermediate:=Temps[0];
  If HLSBase='' Then HLSBase:=LastDownloadURL;
 End;
 {$IFDEF TEST_WMA2}
 Temps[0]:=NewTemporary; DemuxASF(Intermediate,Temps[0]);
 Temps[2]:=NewTemporary; DecodeWMA2Spool(Temps[0],Temps[2]);
 Commit(Temps[2]); Temps[2]:=''; Halt(0);
 {$ENDIF}
 {$IFDEF TEST_ASF_PACKETS}
 Temps[2]:=NewTemporary; DemuxASF(Intermediate,Temps[2]);
 Commit(Temps[2]); Temps[2]:=''; Halt(0);
 {$ENDIF}
 Detected:=Probe(Intermediate);
 If InputFormat='' Then InputFormat:=Detected Else
 If InputFormat<>Detected Then Fail(
 'Format impose incompatible avec la signature du fichier.');
 If InputFormat='' Then Fail('Format entree non reconnu ou non pris en charge.');
 If OutputFormat='' Then OutputFormat:=FormatName(Extension(OutputPath));
 If HasCrop Then Begin
  If NoVideo Or (VideoCodec='copy') Or (AudioCodec='copy') Then Fail('Crop: decodage/reencodage requis; incompatible avec copy ou -vn.');
  If Not ((InputFormat='yuv4mpegpipe') Or
   ((OutputFormat='yuv4mpegpipe') And ((InputFormat='avi') Or (InputFormat='flv') Or (InputFormat='mpeg1video') Or (InputFormat='mpeg'))) Or
   ((InputFormat='flv') And ((VideoCodec='png') Or (VideoCodec='gif') Or (OutputFormat='png') Or (OutputFormat='gif') Or (OutputFormat='image2')))) Then
   Fail('Crop: Y4M, decodage natif vers Y4M ou extraction PNG/GIF depuis FLV requis.');
  If InputFormat='yuv4mpegpipe' Then Begin
   Temps[5]:=NewTemporary; CropY4M(Intermediate,Temps[5]); Intermediate:=Temps[5];
  End;
 End;
 If HasBFrames Or HasBQuant Then Begin
  If (InputFormat<>'yuv4mpegpipe') Or
   Not ((VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or (VideoCodec='mpeg2video') Or
    (FourMV And (VideoCodec='')) Or ((VideoCodec='') And
     ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Then
   Fail('-bf/-b_qfactor/-b_qoffset exige un encodage Y4M vers MPEG-1, MPEG-2 ou MPEG-4; incompatible avec copy.');
 End;
 If HasVideoBitrate Or HasVideoTolerance Or HasVideoBuffer Then Begin
  If (InputFormat<>'yuv4mpegpipe') Or
   Not ((VideoCodec='mpeg4') Or (VideoCodec='mpeg1video') Or (VideoCodec='mpeg2video') Or (VideoCodec='flv') Or
    (FourMV And (VideoCodec='')) Or ((VideoCodec='') And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Then
   Fail('-b/-bt/-bufsize exige un encodage video Y4M vers MPEG4, MPEG1, MPEG2 ou FLV1; incompatible avec copy et FFV1.');
 End;
 If (HasAlbum Or HasComment) And (OutputFormat<>'mp3') And (OutputFormat<>'wav') And
  (OutputFormat<>'avi') And (OutputFormat<>'mp4') Then
  Fail('-album/-comment: sorties MP3, WAV, AVI et MP4 uniquement.');
 If AspectNum>0 Then Begin
  If NoVideo Then Fail('-aspect incompatible avec -vn.');
  If (OutputFormat<>'mp4') And (OutputFormat<>'avi') And (OutputFormat<>'yuv4mpegpipe') Then
   Fail('-aspect: sorties MP4, AVI et Y4M uniquement.');
 End;
 If (VideoCodec='mpeg1video') Or (VideoCodec='mpeg2video') Or (InputFormat='mpeg1video') Or
  ((InputFormat='yuv4mpegpipe') And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video'))) Or
  ((InputFormat='mpeg') And (OutputFormat='yuv4mpegpipe')) Then Begin
  If FourMV Or NoVideo Or IsHTTP(InputPath) Or (HLSBase<>'') Or (RequestedRate<>0) Or
   (RequestedChannels<>0) Or HasBitrate Or (VideoFrames<>0) Or (ImageWidth<>0) Then
   Fail('MPEG1 natif: video locale sans filtres, -4mv ni conversion audio requise.');
  Temps[2]:=NewTemporary;
  If (InputFormat='mpeg1video') And (OutputFormat='mpeg1video') And
   ((AudioCodec='') Or (AudioCodec='copy')) And ((VideoCodec='') Or (VideoCodec='copy')) And
   ((AudioCodec='copy') Or (VideoCodec='copy')) Then CopyFile(Intermediate,Temps[2]) Else Begin
   If AudioCodec<>'' Then Fail('MPEG1 natif: options audio non prises en charge.');
   If InputFormat='yuv4mpegpipe' Then Begin
    If VideoCodec='' Then VideoCodec:=OutputFormat;
    If ((VideoCodec<>'mpeg1video') And (VideoCodec<>'mpeg2video')) Or (OutputFormat<>VideoCodec) Then
     Fail('MPEG: encodage Y4M vers M1V ou M2V du meme codec requis.');
    MPEG1Video(Intermediate,Temps[2],True);
   End Else Begin
    If (OutputFormat<>'yuv4mpegpipe') Or ((VideoCodec<>'') And (VideoCodec<>'rawvideo')) Then
     Fail('MPEG1: decodage M1V/MPEG1 System vers Y4M uniquement.');
    If InputFormat='mpeg' Then Begin
     Temps[3]:=NewTemporary; MPEGSystem(Intermediate,Temps[3],'mpeg','mpeg1video'); Intermediate:=Temps[3];
    End Else If InputFormat<>'mpeg1video' Then Fail('MPEG1: entree non prise en charge.');
    MPEG1Video(Intermediate,Temps[2],False);
   End;
  End;
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video MPEG creee: ',OutputPath); Halt(0);
 End;
 If FourMV And (VideoCodec='') Then VideoCodec:='mpeg4';
 If FourMV And (VideoCodec<>'mpeg4') Then Fail('-4mv exige un encodage MPEG-4 Part 2, pas une copie.');
 If VideoCodec='mpeg4' Then Begin
  If (InputFormat<>'yuv4mpegpipe') Or IsHTTP(InputPath) Or (HLSBase<>'') Or NoVideo Or
   (AudioCodec<>'') Or (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   (VideoFrames<>0) Or (ImageWidth<>0) Then Fail('MPEG4: entree Y4M locale sans filtres ni audio requise.');
  If (OutputFormat<>'m4v') And (OutputFormat<>'avi') And (OutputFormat<>'mp4') Then
   Fail('MPEG4: sorties M4V, AVI ou MP4 requises.');
  Temps[3]:=NewTemporary; EncodeMPEG4(Intermediate,Temps[3]); Temps[2]:=NewTemporary;
  If OutputFormat='m4v' Then CopyFile(Temps[3],Temps[2])
  Else RemuxVideo(Temps[3],Temps[2],'m4v',OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video MPEG4 creee: ',OutputPath); Halt(0);
 End;
 If (VideoCodec='ffv1') Or (VideoCodec='flv') Or (InputFormat='yuv4mpegpipe') Or (OutputFormat='yuv4mpegpipe') Then Begin
  If IsHTTP(InputPath) Or (HLSBase<>'') Or NoVideo Or (AudioCodec<>'') Or
   (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   (VideoFrames<>0) Or (ImageWidth<>0) Then Fail('FFV1: video locale sans filtres ni options audio requise.');
  If InputFormat='yuv4mpegpipe' Then Begin
   If Not ((HasCrop And (OutputFormat='yuv4mpegpipe') And ((VideoCodec='') Or (VideoCodec='rawvideo'))) Or ((OutputFormat='avi') And (VideoCodec='ffv1')) Or
    ((OutputFormat='flv') And (VideoCodec='flv'))) Then Fail('Y4M: ffv1 vers AVI ou flv vers FLV requis.');
  End Else If ((InputFormat<>'avi') And (InputFormat<>'flv')) Or (OutputFormat<>'yuv4mpegpipe') Or
   ((VideoCodec<>'') And (VideoCodec<>'rawvideo')) Then Fail('Decodage: AVI FFV1 ou FLV1 intra vers Y4M requis.');
  Temps[2]:=NewTemporary;
  If HasCrop And (InputFormat='yuv4mpegpipe') And (OutputFormat='yuv4mpegpipe') Then CopyFile(Intermediate,Temps[2])
  Else RemuxVideo(Intermediate,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video creee: ',OutputPath); Halt(0);
 End;
 If (InputFormat='m4v') Or (OutputFormat='m4v') Then Begin
  If IsHTTP(InputPath) Or (HLSBase<>'') Then Fail('M4V: entree locale requise.');
  If Not (((AudioCodec='copy') And AllStreams) Or ((VideoCodec='copy') And (AudioCodec=''))) Then
   Fail('M4V exige -c copy ou -c:v copy.');
  If NoVideo Or (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   (VideoFrames<>0) Or (ImageWidth<>0) Or ((VideoCodec<>'') And (VideoCodec<>'copy')) Then
   Fail('M4V: copie video sans filtre ni reencodage.');
  If Not (((InputFormat='m4v') And ((OutputFormat='mp4') Or (OutputFormat='avi') Or (OutputFormat='m4v'))) Or
   ((OutputFormat='m4v') And ((InputFormat='mp4') Or (InputFormat='avi')))) Then
   Fail('M4V: conversions MP4/AVI vers M4V et M4V vers MP4/AVI.');
  Temps[2]:=NewTemporary; RemuxVideo(Intermediate,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video creee: ',OutputPath); Halt(0);
 End;
 If (InputFormat='mpeg') Or (OutputFormat='mpeg') Then Begin
  If IsHTTP(InputPath) Or (HLSBase<>'') Then Fail('MPEG System: entree locale requise.');
  If Not (((AudioCodec='copy') And AllStreams) Or
   ((VideoCodec='copy') And (AudioCodec='') And (InputFormat='mpeg') And
    ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Then Fail('MPEG System exige -c copy (ou -c:v copy pour mpeg1video/mpeg2video).');
  If (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or
   ((VideoCodec<>'') And Not ((VideoCodec='copy') And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')))) Or
   (VideoFrames<>0) Or (ImageWidth<>0) Then
   Fail('MPEG System: copie des flux uniquement, sans reencodage ni filtres.');
  If NoAudio And NoVideo Then Fail('Aucune piste selectionnee (-an et -vn).');
  If InputFormat='mpeg' Then Begin
   If (OutputFormat<>'mpeg') And (OutputFormat<>'mp3') And
    (OutputFormat<>'mp2') And (OutputFormat<>'mpeg1video') And (OutputFormat<>'mpeg2video') Then
    Fail('Sorties MPEG System: mpeg, mp3, mp2, mpeg1video ou mpeg2video.');
   If NoAudio And ((OutputFormat='mp3') Or (OutputFormat='mp2')) Then Fail('-an exclut la sortie audio.');
   If NoVideo And ((OutputFormat='mpeg1video') Or (OutputFormat='mpeg2video')) Then Fail('-vn exclut la sortie video.');
  End Else If InputFormat<>'mp3' Then Fail('Muxage MPEG System: entree MP3 MPEG-1 requise.');
  Temps[2]:=NewTemporary; MPEGSystem(Intermediate,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Sortie MPEG creee: ',OutputPath); Halt(0);
 End;
 If (VideoCodec='png') Or (VideoCodec='gif') Or (OutputFormat='png') Or
  (OutputFormat='gif') Or (OutputFormat='image2') Then Begin
  If InputFormat<>'flv' Then Fail('Extraction PNG/GIF: entree FLV AVC/H264 requise.');
  If VideoCodec='' Then Begin
   If (OutputFormat='gif') Or (Extension(OutputPath)='gif') Then VideoCodec:='gif'
   Else VideoCodec:='png';
  End;
  If ((OutputFormat='gif') And (VideoCodec<>'gif')) Or
     ((OutputFormat='png') And (VideoCodec<>'png')) Then Fail('Codec et format image incompatibles.');
  If Not ((OutputFormat='rawvideo') Or (OutputFormat='png') Or (OutputFormat='gif') Or
   (OutputFormat='image2')) Then Fail('Image: muxeur rawvideo, image2, png ou gif requis.');
  If NoVideo Then Fail('-vn est incompatible avec extraction PNG/GIF.');
  If (AudioCodec<>'') Or (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Then
   Fail('Options audio incompatibles avec extraction PNG/GIF.');
  If Not HideBanner Then WriteLn('Premiere image FLV H264 CAVLC: decodage et image natifs Pascal.');
  Temps[2]:=NewTemporary; ExtractFLVPicture(Intermediate,Temps[2],ImageWidth,ImageHeight);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Image ',VideoCodec,' creee: ',OutputPath); Halt(0);
 End;
 If (VideoFrames<>0) Or (ImageWidth<>0) Or ((VideoCodec<>'') And (VideoCodec<>'copy')) Then
  Fail('-vframes, -s et encodage video non pris en charge pour cette sortie.');
 If InputFormat='hls' Then Begin
  If (OutputFormat<>'mp4') Or (AudioCodec<>'copy') Or Not AllStreams Then   Fail(
  'HLS exige -c copy et une sortie MP4.');
  If (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or NoVideo Then   Fail(
  'HLS copy conserve toutes les pistes: conversion et -vn non pris en charge.');
  Temps[2]:=NewTemporary;
  If NoAudio Or (AspectNum>0) Or HasAlbum Or HasComment Then Begin
   Temps[3]:=NewTemporary; AssembleHLS(Intermediate,Temps[3]);
   RemuxVideo(Temps[3],Temps[2],'mp4','mp4');
  End Else AssembleHLS(Intermediate,Temps[2]);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('MP4 cree: ',OutputPath); Halt(0);
 End;
 If IsHTTP(InputPath) Then Fail('Entree reseau reservee aux listes HLS.');
 If HLSBase<>'' Then Fail('-hls_base_url exige une entree HLS.');
 If (InputFormat='mp4') Or (InputFormat='avi') Or (InputFormat='webm') Then Begin
  If Not (((InputFormat='mp4') And (OutputFormat='avi')) Or
  ((InputFormat='avi') And (OutputFormat='mp4')) Or
  ((InputFormat='webm') And (OutputFormat='mp4')) Or
  ((NoAudio Or (AspectNum>0) Or HasAlbum Or HasComment) And (InputFormat=OutputFormat) And ((InputFormat='mp4') Or (InputFormat='avi')))) Then   Fail(
  'Conversions video: MP4 vers AVI, AVI vers MP4, WebM vers MP4.');
  If (AudioCodec<>'') And ((AudioCodec<>'copy') Or Not AllStreams) Then   Fail(
  'Video: utiliser -c copy; aucun reencodage video implemente.');
  If (RequestedRate<>0) Or (RequestedChannels<>0) Or HasBitrate Or NoVideo Then   Fail(
  'Conversion de conteneur video: filtres et conversion audio non pris en charge.');
  If Not HideBanner Then WriteLn('Conversion de conteneur video sans reencodage.');
  Temps[2]:=NewTemporary; RemuxVideo(InputPath,Temps[2],InputFormat,OutputFormat);
  Commit(Temps[2]); Temps[2]:=''; WriteLn('Video creee: ',OutputPath); Halt(0);
 End;
 If NoAudio Then Fail('-an: aucune piste a ecrire dans une sortie audio seule.');
 If VideoCodec<>'' Then Fail('Codec video incompatible avec une sortie audio seule.');
 If (OutputFormat<>'wav') And (OutputFormat<>'mp3') Then Fail(
 'Seules les sorties WAV et MP3 sont implementees.');
 If AudioCodec='' Then If OutputFormat='wav' Then AudioCodec:=
 'pcm_s16le' Else AudioCodec:='mp3';
 If (AudioCodec<>'copy') And Not (((OutputFormat='wav') And (AudioCodec='pcm_s16le')) Or
 ((OutputFormat='mp3') And (AudioCodec='mp3'))) Then Fail(
 'Codec de sortie non pris en charge pour ce conteneur.');
 If HasBitrate And ((OutputFormat<>'mp3') Or (AudioCodec='copy')) Then Fail(
 '-b:a exige un encodage MP3.');
 If (AudioCodec='copy') And ((RequestedRate<>0) Or (RequestedChannels<>0) Or (InputFormat
 <>OutputFormat)) Then  Fail(
 '-c:a copy exige le meme conteneur WAV/MP3 et aucune conversion audio.');
 If Not HideBanner Then WriteLn('FFMPEG Pascal 1.11 - moteur audio natif du projet');
 Temps[2]:=NewTemporary;
 If AudioCodec='copy' Then CopyFile(InputPath,Temps[2])
  Else
 Begin
  Intermediate:=InputPath;
  If InputFormat<>'wav' Then Begin
   Temps[0]:=NewTemporary;
   If InputFormat='asf' Then Begin
    Temps[3]:=NewTemporary; DemuxASF(InputPath,Temps[3]);
    DecodeWMA2Spool(Temps[3],Temps[0]);
   End Else
   If (InputFormat='mp3') Or (InputFormat='mp1') Then DecodeMP3(InputPath,Temps[0]) Else
   If InputFormat='aiff' Then DecodeAIFF(InputPath,Temps[0]) Else
   If InputFormat='voc' Then DecodeVOC(InputPath,Temps[0]) Else
   If InputFormat='libopenmpt' Then DecodeMOD(InputPath,Temps[0])
                               Else Fail('Decodeur non implemente.');
   Intermediate:=Temps[0];
  End;
  If OutputFormat='wav' Then NormalizeWave(Intermediate,Temps[2],False)
   Else
  Begin
   Temps[1]:=NewTemporary; NormalizeWave(Intermediate,Temps[1],True);
   EncodeMP3(Temps[1],Temps[2],RequestedBitRateK);
  End;
 End;
 Commit(Temps[2]); Temps[2]:='';
 WriteLn('Sortie creee: ',OutputPath);
END.
