  'acing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, Ma'+
  'rginV, Encoding'#13#10;
 Hd3='Style: Default,Arial,16,&Hffffff,&Hffffff,&H0,&H0,0,0,0,0,100,100,0,0,1,'+
  '1,0,2,10,10,10,1'#13#10#13#10'[Events]'#13#10;
 Hd4='Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effec'+
  't, Text'#13#10;
Var P: PEABuffer; Size,At,LS,LE,N,NEv,I,J,K,Cap,BL: LongInt; Ev: PAHEv; Idx,Tmp:
 PASIdx;
 Bf: PEABuffer; HasInfo: Boolean; Cache: PEABuffer; CL: LongInt; Cur,TmpEv:
  TAHEv;
 H1,M1,S1,Ms1,H2,M2,S2,Ms2: Int64; SP: LongInt; Line: PEABuffer; LLen: LongInt;
 Out_: PEABuffer; OL: LongInt; St,Du,En: Int64; L: String; Hh1,Mm1,Ss1,Cs1,Hh2,
  Mm2,Ss2,Cs2: LongInt;
 Function GI(Var V: Int64): Boolean;
 Var Neg: Boolean; D: LongInt;
 Begin
  GI:=False;
  While (SP<LLen) And (Line^[SP] In [9,10,11,12,13,32]) Do Inc(SP);
  Neg:=False;
  If (SP<LLen) And ((Line^[SP]=43) Or (Line^[SP]=45)) Then Begin Neg:=Line^[
   SP]=45; Inc(SP); End;
  D:=0; V:=0;
  While (SP<LLen) And (Line^[SP] In [48..57]) Do Begin If V<100000000000 Then
   V:=V*10+(Line^[SP]-48); Inc(SP); Inc(D); End;
  If D=0 Then Exit;
  If Neg Then V:=-V;
  GI:=True;
 End;
 Function Lit(Ch: Byte): Boolean;
 Begin If (SP<LLen) And (Line^[SP]=Ch) Then Begin Inc(SP); Lit:=True; End Else
  Lit:=False; End;
 Function Sep: Boolean;
 Begin If (SP<LLen) And ((Line^[SP]=44) Or (Line^[SP]=46)) Then Begin Inc(SP);
  Sep:=True; End Else Sep:=False; End;
 Procedure Ws; Begin While (SP<LLen) And (Line^[SP] In [9,10,11,12,13,32]) Do
  Inc(SP); End;
 Function EventInfo: Boolean;
 Begin
  EventInfo:=False; SP:=0;
  If Not GI(H1) Then Exit; If Not Lit(58) Then Exit;
  If Not GI(M1) Then Exit; If Not Lit(58) Then Exit;
  If Not GI(S1) Then Exit; If Not Sep Then Exit;
  If Not GI(Ms1) Then Exit; Ws;
  If Not (Lit(45) And Lit(45) And Lit(62)) Then Exit; Ws;
  If Not GI(H2) Then Exit; If Not Lit(58) Then Exit;
  If Not GI(M2) Then Exit; If Not Lit(58) Then Exit;
  If Not GI(S2) Then Exit; If Not Sep Then Exit;
  If Not GI(Ms2) Then Exit;
  If (SP+3<LLen) And (Line^[SP]=32) Then Begin
   K:=SP; While (K<LLen) And (Line^[K]=32) Do Inc(K);
   If (K+2<LLen) And (Line^[K]=88) And (Line^[K+1]=49) And (Line^[K+2]=58) Then
    Fail('srt: coordonnees X1/X2/Y1/Y2 non prises en charge.');
  End;
  EventInfo:=True;
 End;
 { strtol >= 0 : la ligne commence par un nombre non negatif ; Whole : le nombre
  occupe toute la ligne }
 Function StrtolPos(B: PEABuffer; Len: LongInt; Var Whole: Boolean): Boolean;
 Var Q,Dg2: LongInt; Neg,NZ: Boolean;
 Begin
  Q:=0; Neg:=False; NZ:=False; Dg2:=0; Whole:=False; StrtolPos:=False;
  If Len=0 Then Begin Whole:=True; StrtolPos:=True; Exit; End;
  While (Q<Len) And (B^[Q] In [9,10,11,12,13,32]) Do Inc(Q);
  If (Q<Len) And ((B^[Q]=43) Or (B^[Q]=45)) Then Begin Neg:=B^[Q]=45; Inc(Q);
   End;
  While (Q<Len) And (B^[Q] In [48..57]) Do Begin If B^[Q]<>48 Then NZ:=True;
   Inc(Q); Inc(Dg2); End;
  If Dg2=0 Then Exit; { aucun chiffre : strtol renvoie 0 sans avancer }
  If Neg And NZ Then Exit;
  StrtolPos:=True; Whole:=Q=Len;
 End;
 Function HasNum(B: PEABuffer; Len: LongInt): Boolean; { strtol(line)<0 ||
  line==pline -> faux }
 Var W: Boolean;
 Begin
  If Len=0 Then Begin HasNum:=False; Exit; End;
  HasNum:=StrtolPos(B,Len,W);
 End;
 Procedure AddEvent(Append: Boolean);
 Begin
  If Append And (CL>0) Then Begin Move(Cache^[0],Bf^[BL],CL); Inc(BL,CL); Bf^[
   BL]:=10; Inc(BL); End;
  CL:=0;
  While (BL>0) And (Bf^[BL-1]=10) Do Dec(BL);
  If BL>0 Then Begin
   GetMem(TmpEv.Txt,BL+1); Move(Bf^[0],TmpEv.Txt^[0],BL); TmpEv.Txt^[BL]:=0;
    TmpEv.TxtLen:=BL;
   TmpEv.Pos:=Cur.Pos; TmpEv.Start:=Cur.Start; TmpEv.Dur:=Cur.Dur;
   Ev^[NEv]:=TmpEv; Inc(NEv);
   BL:=0;
  End;
 End;
 Function Less(X,Y: LongInt): Boolean;
 Begin
  If Ev^[X].Start=Ev^[Y].Start Then Less:=Ev^[X].Pos<Ev^[Y].Pos Else Less:=Ev^[
   X].Start<Ev^[Y].Start;
 End;
 Procedure SortIdx(Lo,Hi: LongInt);
 Var Mid,A,B,C2: LongInt;
 Begin
  If Hi-Lo<2 Then Exit;
  Mid:=(Lo+Hi) Div 2; SortIdx(Lo,Mid); SortIdx(Mid,Hi);
  A:=Lo; B:=Mid; C2:=Lo;
  While (A<Mid) And (B<Hi) Do Begin
   If Less(Idx^[B],Idx^[A]) Then Begin Tmp^[C2]:=Idx^[B]; Inc(B); End Else Begin
    Tmp^[C2]:=Idx^[A]; Inc(A); End;
   Inc(C2);
  End;
  While A<Mid Do Begin Tmp^[C2]:=Idx^[A]; Inc(A); Inc(C2); End;
  While B<Hi Do Begin Tmp^[C2]:=Idx^[B]; Inc(B); Inc(C2); End;
  For A:=Lo To Hi-1 Do Idx^[A]:=Tmp^[A];
 End;
 Function SameTxt(X,Y: LongInt): Boolean;
 Var Q: LongInt;
 Begin
  SameTxt:=False;
  If Ev^[X].TxtLen<>Ev^[Y].TxtLen Then Exit;
  For Q:=0 To Ev^[X].TxtLen-1 Do If Ev^[X].Txt^[Q]<>Ev^[Y].Txt^[Q] Then Exit;
  SameTxt:=True;
 End;
 Function Cs(Ms: Int64): Int64;
 Begin If Ms>=0 Then Cs:=(Ms+5) Div 10 Else Cs:=-((-Ms+5) Div 10); End;
Var Keep: PASIdx; NK,LastK: LongInt; Whole,W2,Num0: Boolean;
Begin
 ASLoad(Source,P,Size); ASText(P,Size);
 N:=0; For I:=0 To Size-1 Do If (P^[I]=10) Or (P^[I]=13) Then Inc(N);
 GetMem(Ev,(N+2)*SizeOf(TAHEv)); NEv:=0;
 GetMem(Bf,Size*2+64); BL:=0; GetMem(Cache,Size+64); CL:=0; GetMem(Line,Size+
  64);
 HasInfo:=False; At:=0;
 FillChar(Cur,SizeOf(Cur),0);
 While At<Size Do Begin
  LS:=At; LLen:=0;
  While (At<Size) And (P^[At]<>13) And (P^[At]<>10) And (P^[At]<>0) Do Begin
   Line^[LLen]:=P^[At]; Inc(LLen); Inc(At); End;
  If (At<Size) And (P^[At]=0) Then Break;
  If At<Size Then Inc(At);
  While (At<Size) And (P^[At]=13) Do Inc(At);
  If (At<Size) And (P^[At]=10) Then Inc(At);
  If LLen=0 Then Continue;
  If EventInfo Then Begin
   If HasInfo Then Begin
    { cache : nombre isole ? }
    Num0:=StrtolPos(Cache,CL,Whole) And Whole;
    AddEvent((BL=0) And Not Num0);
   End Else HasInfo:=True;
   Cur.Pos:=LS;
   Cur.Start:=(H1*3600+M1*60+S1)*1000+Ms1;
   Cur.Dur:=((H2*3600+M2*60+S2)*1000+Ms2)-Cur.Start;
  End Else Begin
   If Not HasInfo Then Continue;
   If CL>0 Then Begin Move(Cache^[0],Bf^[BL],CL); Inc(BL,CL); Bf^[BL]:=10; Inc(
    BL); CL:=0; End;
   If Not HasNum(Line,LLen) Then Begin Move(Line^[0],Bf^[BL],LLen); Inc(BL,
    LLen); Bf^[BL]:=10; Inc(BL); End
   Else Begin Move(Line^[0],Cache^[0],LLen); CL:=LLen; End;
  End;
 End;
 If HasInfo Then AddEvent(True);
 { file triee, durees negatives, doublons }
 If NEv>0 Then Begin
  GetMem(Idx,NEv*4); GetMem(Tmp,NEv*4); GetMem(Keep,NEv*4);
  For I:=0 To NEv-1 Do Idx^[I]:=I;
  SortIdx(0,NEv);
  For I:=0 To NEv-2 Do If Ev^[Idx^[I]].Dur<0 Then Ev^[Idx^[I]].Dur:=Ev^[Idx^[I+
   1]].Start-Ev^[Idx^[I]].Start;
  NK:=0; LastK:=-1;
  For I:=0 To NEv-1 Do Begin
   If (LastK>=0) And (Ev^[Idx^[I]].Start=Ev^[LastK].Start) And (Ev^[Idx^[
    I]].Dur=Ev^[LastK].Dur) And SameTxt(Idx^[I],LastK) Then
   Else Begin Keep^[NK]:=Idx^[I]; Inc(NK); LastK:=Idx^[I]; End;
  End;
 End Else NK:=0;
 OpenWrite(Target);
 ASWriteS(Hd1); ASWriteS(Hd2); ASWriteS(Hd3); ASWriteS(Hd4);
 GetMem(Out_,Size*6+1024);
 For I:=0 To NK-1 Do Begin
  J:=Keep^[I];
  AHConvert(Ev^[J].Txt,Out_,OL);
  St:=Cs(Ev^[J].Start); Du:=Cs(Ev^[J].Dur); En:=St+Du;
  Hh1:=St Div 360000; Mm1:=(St Div 6000) Mod 60; Ss1:=(St Div 100) Mod 60; Cs1:=
   St Mod 100;
  Hh2:=En Div 360000; Mm2:=(En Div 6000) Mod 60; Ss2:=(En Div 100) Mod 60; Cs2:=
   En Mod 100;
  If Hh1>9 Then Begin Hh1:=9; Mm1:=59; Ss1:=59; Cs1:=99; End;
  If Hh2>9 Then Begin Hh2:=9; Mm2:=59; Ss2:=59; Cs2:=99; End;
  L:='Dialogue: 0,'+ASNum(Hh1)+':'+ASFmt2(Mm1)+':'+ASFmt2(Ss1)+'.'+ASFmt2(Cs1)+
   ','+ASNum(Hh2)+':'+ASFmt2(Mm2)+':'+ASFmt2(Ss2)+'.'+ASFmt2(Cs2)+
   ',Default,,0,0,0,,';
  ASWriteS(L);
  If OL>0 Then ASWrite(Out_^,OL);
  ASWriteS(#13#10);
 End;
 CloseWrite;
End;
{ ======== F1 : encodeur TTA (libavcodec/ttaenc.c, ttaencdsp.c, ttadata.c) +
 muxeur tta (libavformat/ttaenc.c, apetag.c) ======== }
Type
 TTFilt=Record Shift,Round,Error: LongInt; Qm,Dx,Dl: Array[0..15] Of LongInt;
  End;
 TTChan=Record Pred: LongInt; F: TTFilt; K0,K1: LongWord; Sum0,Sum1: LongWord;
  End;
Var
 TTCrcT: Array[0..255] Of LongWord; TTCrcOk: Boolean;
 TTBuf: PEABuffer; TTCap,TTLen: LongInt; TTAcc: QWord; TTCnt: LongInt;

Const
 TTShift1: Array[0..40] Of LongWord=(
  $1,$2,$4,$8,$10,$20,$40,$80,$100,$200,$400,$800,$1000,$2000,$4000,$8000,
  $10000,$20000,$40000,$80000,$100000,$200000,$400000,$800000,$1000000,$2000000,
   $4000000,$8000000,
  $10000000,$20000000,$40000000,$80000000,$80000000,$80000000,$80000000,
   $80000000,
  $80000000,$80000000,$80000000,$80000000,$FFFFFFFF);

Procedure TTCrcInit;
Var I,J: LongInt; C: LongWord;
Begin
 If TTCrcOk Then Exit; TTCrcOk:=True;
 For I:=0 To 255 Do Begin
  C:=I; For J:=0 To 7 Do If (C And 1)<>0 Then C:=(C Shr 1) Xor $EDB88320 Else
   C:=C Shr 1;
  TTCrcT[I]:=C;
 End;
End;

Function TTCrc(Var B; Len: LongInt; Init: LongWord): LongWord;
Var P: PEABuffer; I: LongInt; C: LongWord;
Begin
 TTCrcInit; P:=@B; C:=Init;
 For I:=0 To Len-1 Do C:=TTCrcT[(C Xor P^[I]) And 255] Xor (C Shr 8);
 TTCrc:=C;
End;

Procedure TTPutByte(V: LongInt);
Begin
 If TTLen>=TTCap Then Begin TTCap:=TTCap*2; ReAllocMem(TTBuf,TTCap); End;
 TTBuf^[TTLen]:=V And 255; Inc(TTLen);
End;

Procedure TTPutBits(N: LongInt; V: QWord);
Begin
 If N<=0 Then Exit;
 V:=V And ((QWord(1) Shl N)-1);
 TTAcc:=TTAcc Or (V Shl TTCnt); Inc(TTCnt,N);
 While TTCnt>=8 Do Begin TTPutByte(TTAcc And 255); TTAcc:=TTAcc Shr 8; Dec(
  TTCnt,8); End;
End;

Procedure TTFlush;
Begin
 If TTCnt>0 Then Begin TTPutByte(TTAcc And 255); TTAcc:=0; TTCnt:=0; End;
End;

Function TTW32(V: Int64): LongInt;
Begin V:=V And $FFFFFFFF; If V>=2147483648 Then V:=V-4294967296; TTW32:=V; End;

{ Smp : echantillons entrelaces deja signes (u8 : valeur-128). Bytes : 1, 2 ou
 3. }
Procedure F1TtaEncode(Const Target: String; Smp: FQPI; NFr,Ch,Rate,Bytes:
 LongInt);
Var Chs: Array[0..7] Of TTChan; FrameSize,Pos,Nb,I,C,CurChan,FStart,OutBytes,
 NFrames,Cap: LongInt;
 Res,Value,Temp,Sample: LongInt; K,Unary,OutVal: LongWord; Q: QWord; Rc:
  LongWord;
 Sizes: PEABuffer; SzN: LongInt; Frames: PEABuffer; Crc: LongWord; Hdr: Array[
  0..31] Of Byte;
 Sg: LongInt; Sh: LongInt; Er: LongInt; S64: Int64; Lm,J: LongInt;
 CmN: LongInt; CmK: TMdK; CmV: TMdV; Tot,Cnt,Tmp32: LongInt; Out: Array[0..3] Of
  Byte; Sample1: LongInt;
 Cfg: Array[0..3] Of Byte;
 Function GetS(Idx: LongInt): LongInt;
 Begin GetS:=Smp^[Pos*Ch+Idx]; End;
 Procedure W32(V: LongWord); Begin Out[0]:=V And 255; Out[1]:=(V Shr 8) And 255;
  Out[2]:=(V Shr 16) And 255; Out[3]:=V Shr 24; WriteBytes(Out,4); End;
 Procedure W16(V: LongInt); Begin Out[0]:=V And 255; Out[1]:=(V Shr 8) And 255;
  WriteBytes(Out,2); End;
Begin
 TTCrcInit;
 Cfg[0]:=10; Cfg[1]:=9; Cfg[2]:=10; Cfg[3]:=12;
 FrameSize:=Int64(256)*Rate Div 245;
 TTCap:=65536; GetMem(TTBuf,TTCap); TTLen:=0; TTAcc:=0; TTCnt:=0;
 GetMem(Sizes,(NFr Div FrameSize+2)*4); SzN:=0;
 Pos:=0;
 While Pos<NFr Do Begin
  Nb:=FrameSize; If NFr-Pos<Nb Then Nb:=NFr-Pos;
  FStart:=TTLen; TTAcc:=0; TTCnt:=0;
  For C:=0 To Ch-1 Do Begin
   FillChar(Chs[C],SizeOf(TTChan),0);
   Chs[C].F.Shift:=Cfg[Bytes-1]; Chs[C].F.Round:=TTShift1[Chs[C].F.Shift-1];
   Chs[C].K0:=10; Chs[C].K1:=10; Chs[C].Sum0:=TTShift1[4+10]; Chs[C].Sum1:=
    TTShift1[4+10];
  End;
  Res:=0; CurChan:=0;
  For I:=0 To Nb*Ch-1 Do Begin
   Value:=Smp^[Pos*Ch+I];
   If Ch>1 Then Begin
    If CurChan<Ch-1 Then Begin
     Sample1:=Smp^[Pos*Ch+I+1];
     Res:=TTW32(Int64(Sample1)-Value); Value:=Res;
    End Else Value:=Value-(Res Div 2);
   End;
   Temp:=Value;
   Case Bytes Of
    1: Sh:=4; Else Sh:=5;
   End;
   Q:=QWord(Int64(Chs[CurChan].Pred)); Q:=(Q Shl Sh)-QWord(Int64(Chs[
    CurChan].Pred)); Q:=Q Shr Sh;
   Value:=TTW32(Int64(Value)-TTW32(Int64(Q And $FFFFFFFF)));
   Chs[CurChan].Pred:=Temp;
   { filtre }
   With Chs[CurChan].F Do Begin
    If Error<0 Then Begin For J:=0 To 7 Do Qm[J]:=TTW32(Int64(Qm[J])-Dx[J]); End
    Else If Error>0 Then Begin For J:=0 To 7 Do Qm[J]:=TTW32(Int64(Qm[J])+Dx[
     J]); End;
    S64:=Round;
    For J:=0 To 7 Do S64:=S64+Int64(Dl[J])*Qm[J];
    Er:=TTW32(S64);
    Dx[0]:=Dx[1]; Dx[1]:=Dx[2]; Dx[2]:=Dx[3]; Dx[3]:=Dx[4];
    Dl[0]:=Dl[1]; Dl[1]:=Dl[2]; Dl[2]:=Dl[3]; Dl[3]:=Dl[4];
    Dx[4]:=(FQSar(Dl[4],30) Or 1);
    Dx[5]:=(FQSar(Dl[5],30) Or 2) And Not 1;
    Dx[6]:=(FQSar(Dl[6],30) Or 2) And Not 1;
    Dx[7]:=(FQSar(Dl[7],30) Or 4) And Not 3;
    Dl[4]:=-Dl[5]; Dl[5]:=-Dl[6];
    Dl[6]:=TTW32(Int64(Value)-Dl[7]); Dl[7]:=Value;
    Dl[5]:=TTW32(Int64(Dl[5])+Dl[6]); Dl[4]:=TTW32(Int64(Dl[4])+Dl[5]);
    Value:=TTW32(Int64(Value)-FQSar(Er,Shift));
    Error:=Value;
   End;
   If Value>0 Then OutVal:=LongWord(TTW32(Int64(Value) Shl 1)-1) Else OutVal:=
    LongWord(TTW32(Int64(-Value) Shl 1));
   With Chs[CurChan] Do Begin
    K:=K0;
    Sum0:=Sum0+OutVal-(Sum0 Shr 4);
    If (K0>0) And (Sum0<TTShift1[4+K0]) Then Dec(K0)
    Else If Sum0>TTShift1[4+K0+1] Then Inc(K0);
    If OutVal>=TTShift1[K] Then Begin
     OutVal:=OutVal-TTShift1[K];
     K:=K1;
     Sum1:=Sum1+OutVal-(Sum1 Shr 4);
     If (K1>0) And (Sum1<TTShift1[4+K1]) Then Dec(K1)
     Else If Sum1>TTShift1[4+K1+1] Then Inc(K1);
     Unary:=1+(OutVal Shr K);
     Repeat
      If Unary>31 Then Begin TTPutBits(31,$7FFFFFFF); Dec(Unary,31); End
      Else Begin TTPutBits(Unary,(QWord(1) Shl Unary)-1); Unary:=0; End;
     Until Unary=0;
    End;
    TTPutBits(1,0);
    If K<>0 Then TTPutBits(K,OutVal And (TTShift1[K]-1));
   End;
   If CurChan<Ch-1 Then Inc(CurChan) Else CurChan:=0;
  End;
  TTFlush;
  OutBytes:=TTLen-FStart;
  Crc:=TTCrc(TTBuf^[FStart],OutBytes,$FFFFFFFF) Xor $FFFFFFFF;
  TTPutByte(Crc); TTPutByte(Crc Shr 8); TTPutByte(Crc Shr 16); TTPutByte(Crc Shr
   24);
  Sizes^[SzN*4]:=(OutBytes+4) And 255; Sizes^[SzN*4+1]:=((OutBytes+4) Shr 8) And
   255; Sizes^[SzN*4+2]:=((OutBytes+4) Shr 16) And 255; Sizes^[SzN*4+3]:=((
   OutBytes+4) Shr 24) And 255;
  Inc(SzN);
  Inc(Pos,Nb);
 End;
 { fichier }
 OpenWrite(Target);
 Hdr[0]:=84; Hdr[1]:=84; Hdr[2]:=65; Hdr[3]:=49; Hdr[4]:=1; Hdr[5]:=0; Hdr[6]:=
  Ch; Hdr[7]:=0; Hdr[8]:=Bytes*8; Hdr[9]:=0;
 Hdr[10]:=Rate And 255; Hdr[11]:=(Rate Shr 8) And 255; Hdr[12]:=(Rate Shr 16)
  And 255; Hdr[13]:=(Rate Shr 24) And 255;
 WriteBytes(Hdr,14);
 Crc:=TTCrc(Hdr,14,$FFFFFFFF);
 { le C ecrit 18 octets : TTA1 + 2 + 2 + 2 + 4 = 14 : l'entete fait 14 octets }
 Hdr[14]:=NFr And 255; Hdr[15]:=(NFr Shr 8) And 255; Hdr[16]:=(NFr Shr 16) And
  255; Hdr[17]:=(NFr Shr 24) And 255;
 WriteBytes(Hdr[14],4);
 Crc:=TTCrc(Hdr,18,$FFFFFFFF) Xor $FFFFFFFF;
 { crc sur les octets ecrits avant le champ crc : entete (14) + nb_samples (4) }
 W32(Crc);
 Crc:=TTCrc(Sizes^,SzN*4,$FFFFFFFF) Xor $FFFFFFFF;
 ASWrite(Sizes^,SzN*4); W32(Crc);
 ASWrite(TTBuf^,TTLen);
 { etiquette APE }
 CmN:=MdN; For I:=0 To MdN-1 Do Begin CmK[I]:=MdK[I]; CmV[I]:=MdV[I]; End;
 F1MdEncoder(CmN,CmK,CmV);
 If CmN>0 Then Begin
  Tot:=0; For I:=0 To CmN-1 Do Tot:=Tot+8+Length(CmK[I])+1+Length(CmV[I]);
  Tot:=Tot+32;
  Hdr[0]:=65; Hdr[1]:=80; Hdr[2]:=69; Hdr[3]:=84; Hdr[4]:=65; Hdr[5]:=71; Hdr[
   6]:=69; Hdr[7]:=88; WriteBytes(Hdr,8);
  W32(2000); W32(Tot); W32(CmN); W32($A0000000); W32(0); W32(0);
  For I:=0 To CmN-1 Do Begin
   W32(Length(CmV[I])); W32(0);
   WriteBytes(CmK[I][1],Length(CmK[I])); Hdr[0]:=0; WriteBytes(Hdr,1);
   If Length(CmV[I])>0 Then WriteBytes(CmV[I][1],Length(CmV[I]));
  End;
  Hdr[0]:=65; Hdr[1]:=80; Hdr[2]:=69; Hdr[3]:=84; Hdr[4]:=65; Hdr[5]:=71; Hdr[
   6]:=69; Hdr[7]:=88; WriteBytes(Hdr,8);
  W32(2000); W32(Tot); W32(CmN); W32($80000000); W32(0); W32(0);
 End;
 CloseWrite;
 FreeMem(TTBuf); FreeMem(Sizes);
End;
{ ======== F1 : copie de flux MP3 (libavformat/mp3dec.c + mp3enc.c : ID3v2.4,
 trame Xing/Info, CRC) ======== }
Var F1Why: LongInt;
Function F1Mp3Copy(Const Source,Target: String): Boolean;
Const
 BrM1: Array[0..15] Of LongInt=(0,32,40,48,56,64,80,96,112,128,160,192,224,256,
  320,0);
 BrM2: Array[0..15] Of LongInt=(0,8,16,24,32,40,48,56,64,80,96,112,128,144,160,
  0);
 Freq3: Array[0..2] Of LongInt=(44100,48000,32000);
Type TBagArr=Array[0..399] Of Int64;
Const LavfId='Lavf60.16.100';
Var Buf: PEABuffer; Size,Pos,At,Tag,N,I,J,K,FStart: LongInt;
 Ver,Lsf,Srate,Mono,Ok1: LongInt;
 Sr,Ch,FSz,FBr,Br,Hd: LongInt;
 Fr,Sz: Array[0..0] Of LongInt;
 NPk,Total,AudioSize,InitBr,VbrFlag,Want,Seen,BPos,XSize,XFrames: LongInt;
 Bag: TBagArr; Crc,AudioCrc: Word; Xs: Array[0..2047] Of Byte; XFrameSize,XOff:
  LongInt;
 TagFr,TagSize,TagFilesz,StartPad,EndPad,SkipTag,Cbr,HasLame: LongInt;
 Enc: Array[0..9] Of Byte; EncOk: Boolean; ParBr,Spf: LongInt; BestErr,BestIdx,
  Err,B2,Bv: LongInt;
 Delay,Padding,Fd,Ld,Smp,Disc,Hdr,ID3Ok: LongInt; PackStart: LongInt;
 Pk: Array[0..0] Of LongInt; Firsts: Boolean;
 Hv: Array[0..3] Of Byte; ID: Array[0..44] Of Byte; Sgn: Int64;
 Function RB(P: LongInt): LongInt; Begin If (P>=0) And (P<Size) Then RB:=Buf^[P]
  Else RB:=0; End;
 Function RB32(P: LongInt): LongInt; Begin RB32:=(RB(P) Shl 24) Or (RB(P+1) Shl
  16) Or (RB(P+2) Shl 8) Or RB(P+3); End;
 Function CrcUpd(C: Word; D: Byte): Word;
 Var K2: LongInt; X: LongInt;
 Begin
  X:=(C Xor D) And 255;
  For K2:=1 To 8 Do If (X And 1)<>0 Then X:=(X Shr 1) Xor $A001 Else X:=X Shr 1;
  CrcUpd:=(C Shr 8) Xor X;
 End;
 { analyse d'un en-tete : renvoie la taille de trame, 0 si invalide / non
  support }
 Function Parse(P: LongInt; Var V,L,SrI,Chn,B: LongInt): LongInt;
 Var H,Idx,Sx,Pd,Lsf2: LongInt;
 Begin
  Parse:=0;
  If P+4>Size Then Exit;
  H:=RB32(P);
  If (H And $FFE00000)<>$FFE00000 Then Exit;
  V:=(H Shr 19) And 3; If V=1 Then Exit;
  If ((H Shr 17) And 3)<>1 Then Exit; { couche III uniquement }
  Idx:=(H Shr 12) And 15; If (Idx=0) Or (Idx=15) Then Exit;
  Sx:=(H Shr 10) And 3; If Sx=3 Then Exit;
  Pd:=(H Shr 9) And 1;
  Lsf2:=Ord(V<>3);
  If V=3 Then B:=BrM1[Idx] Else B:=BrM2[Idx];
  SrI:=Freq3[Sx]; If V=2 Then SrI:=SrI Div 2 Else If V=0 Then SrI:=SrI Div 4;
  Chn:=Ord(((H Shr 6) And 3)<>3)+1;
  L:=Lsf2;
  Parse:=(B*144000) Div (SrI Shl Lsf2)+Pd;
 End;
 Function Spfv(L: LongInt): LongInt; Begin If L<>0 Then Spfv:=576 Else Spfv:=
  1152; End;
 Procedure W32(P: LongInt; V: LongInt); Begin Xs[P]:=(V Shr 24) And 255; Xs[P+
  1]:=(V Shr 16) And 255; Xs[P+2]:=(V Shr 8) And 255; Xs[P+3]:=V And 255; End;
Begin
 F1Mp3Copy:=False;
 OpenRead(Source); Size:=InputSize;
 If (Size<64) Or (Size>200000000) Then Begin CloseRead; Exit; End;
 GetMem(Buf,Size+16);
 At:=0; While At<Size Do Begin N:=Size-At; If N>32768 Then N:=32768; ReadAt(At,
  Buf^[At],N); Inc(At,N); End;
 CloseRead;
 { etiquette ID3v2 en tete: seule TSSE est admise }
 Pos:=0;
 If (RB(0)=73) And (RB(1)=68) And (RB(2)=51) Then Begin
  If (RB(3)<3) Or (RB(3)>4) Or (RB(5)<>0) Then Begin F1Why:=1; FreeMem(Buf,Size+
   16); Exit; End;
  Tag:=(RB(6) Shl 21) Or (RB(7) Shl 14) Or (RB(8) Shl 7) Or RB(9);
  At:=10;
  While At<10+Tag Do Begin
   If RB(At)=0 Then Break;
   If (RB(At)<>Ord('T')) Or (RB(At+1)<>Ord('S')) Or (RB(At+2)<>Ord('S')) Or (RB(
    At+3)<>Ord('E')) Then Begin F1Why:=2; FreeMem(Buf,Size+16); Exit; End;
   If RB(3)=4 Then N:=(RB(At+4) Shl 21) Or (RB(At+5) Shl 14) Or (RB(At+6) Shl 7)
    Or RB(At+7)
   Else N:=RB32(At+4);
   Inc(At,10+N);
  End;
  Pos:=10+Tag;
 End;
 { fin: etiquette ID3v1 -> non support }
 If (Size>128) And (RB(Size-128)=84) And (RB(Size-127)=65) And (RB(Size-126)=71)
  Then Begin F1Why:=3; FreeMem(Buf,Size+16); Exit; End;
 { trame d'en-tete Xing/Info/VBRI }
 FStart:=Pos; TagFr:=0; TagFilesz:=0; StartPad:=0; EndPad:=0; Cbr:=0; EncOk:=
  False; HasLame:=0; SkipTag:=0;
 FSz:=Parse(Pos,Ver,Lsf,Sr,Ch,FBr);
 If FSz=0 Then Begin F1Why:=4; FreeMem(Buf,Size+16); Exit; End;
 Spf:=Spfv(Lsf);
 Mono:=Ord(Ch=1);
 If Lsf<>0 Then Begin If Mono<>0 Then I:=9 Else I:=17; End Else Begin If Mono<>0
  Then I:=17 Else I:=32; End;
 K:=Pos+4+I;
 If (RB32(K)=$58696E67) Or (RB32(K)=$496E666F) Then Begin { Xing / Info }
  Cbr:=Ord(RB32(K)=$496E666F);
  N:=RB32(K+4); J:=K+8;
  If (N And 1)<>0 Then Begin TagFr:=RB32(J); Inc(J,4); End;
  If (N And 2)<>0 Then Begin TagFilesz:=RB32(J); Inc(J,4); End;
  If TagFilesz<>0 Then Begin
   B2:=Size-(Pos+4); Bv:=TagFilesz; If B2<Bv Then Err:=B2 Else Err:=Bv;
   If (B2>Bv) And (B2-Bv>(Err Shr 4)) Then TagFr:=0;
  End;
  If (N And 4)<>0 Then Inc(J,100);
  If (N And 8)<>0 Then Inc(J,4);
  { version de l'encodeur }
  FillChar(Enc,SizeOf(Enc),0); For I:=0 To 8 Do Enc[I]:=RB(J+I);
  Inc(J,9+1+1+4+2+2+1+1);
  N:=(RB(J) Shl 16) Or (RB(J+1) Shl 8) Or RB(J+2);
  If (Enc[0]=Ord('L')) And (((Enc[1]=Ord('A')) And (Enc[2]=Ord('M')) And (Enc[
   3]=Ord('E'))) Or ((Enc[1]=Ord('a')) And (Enc[2]=Ord('v')) And ((Enc[3]=Ord(
   'f')) Or (Enc[3]=Ord('c'))))) Then Begin
   HasLame:=1; StartPad:=N Shr 12; EndPad:=N And 4095;
  End;
  Inc(J,3+1+1+2+4+2);
  { CRC de l'etiquette : de l'en-tete de trame jusqu'ici }
  Crc:=0; For I:=Pos To J-1 Do Crc:=CrcUpd(Crc,Buf^[I]);
  EncOk:=(Crc=RB(J)*256+RB(J+1));
  If (TagFr<>0) Or (TagFilesz<>0) Then SkipTag:=1;
 End Else If RB32(Pos+4+32)=$56425249 Then Begin
  F1Why:=5; FreeMem(Buf,Size+16); Exit; { VBRI : non support }
 End;
 ParBr:=0;
 If SkipTag<>0 Then Begin
  If (TagFilesz<>0) And (TagFr<>0) And (Cbr=0) Then
   ParBr:=(Int64(TagFilesz)*8*Sr+(Int64(TagFr)*Spf) Div 2) Div (Int64(TagFr)*
    Spf)
  Else ParBr:=0;
  { le debit des fichiers Info (CBR) vient du premier paquet decode }
  Pos:=Pos+FSz;
 End Else Begin StartPad:=0; EndPad:=0; HasLame:=0; End;
 { saut des octets parasites avant la premiere trame }
 I:=0; While (Pos+I<Size) And (Parse(Pos+I,Ver,Lsf,Sr,Ch,FBr)=0) Do Inc(I);
 If I>65535 Then Begin F1Why:=6; FreeMem(Buf,Size+16); Exit; End;
 If Pos+I>=Size Then Begin F1Why:=7; FreeMem(Buf,Size+16); Exit; End;
 Inc(Pos,I);
 FSz:=Parse(Pos,Ver,Lsf,Sr,Ch,FBr); Spf:=Spfv(Lsf); Mono:=Ord(Ch=1);
 If ParBr=0 Then ParBr:=FBr*1000;
 If SkipTag<>0 Then Begin
  If (Ver=0) Then Begin End;
 End;
 PackStart:=Pos;
 { premier passage : comptage des paquets, table des sacs, CRC }
 NPk:=0; Total:=0; AudioSize:=0; InitBr:=0; VbrFlag:=0; Want:=1; Seen:=0; BPos:=
  0; AudioCrc:=0;
 { construction de la trame Xing }
 { debit le plus proche }
 BestErr:=MaxLongInt; BestIdx:=-1;
 For I:=1 To 14 Do Begin
  If Ver=3 Then B2:=BrM1[I]*1000 Else B2:=BrM2[I]*1000;
  Err:=Abs(B2-ParBr);
  If Err<BestErr Then Begin BestErr:=Err; BestIdx:=I; End;
 End;
 { en-tete factice }
 Srate:=0; While (Srate<3) And (Not ((Sr=Freq3[Srate]) Or (Sr=Freq3[Srate] Div
  2) Or (Sr=Freq3[Srate] Div 4))) Do Inc(Srate);
 If Srate=3 Then Begin F1Why:=8; FreeMem(Buf,Size+16); Exit; End;
 { choix de la version selon la frequence }
 If Sr=Freq3[Srate] Then Ver:=3 Else If Sr=Freq3[Srate] Div 2 Then Ver:=2 Else
  Ver:=0;
 Lsf:=Ord(Ver<>3);
 Hdr:=0; XFrameSize:=0;
 I:=BestIdx;
 While True Do Begin
  If I=15 Then Begin F1Why:=9; FreeMem(Buf,Size+16); Exit; End;
  If Ver=3 Then B2:=BrM1[I] Else B2:=BrM2[I];
  FSz:=(B2*144000) Div (Sr Shl Lsf);
  If Lsf<>0 Then Begin If Mono<>0 Then XOff:=9 Else XOff:=17; End Else Begin If
   Mono<>0 Then XOff:=17 Else XOff:=32; End;
  Inc(XOff,4);
  If XOff+156<=FSz Then Break;
  Inc(I);
 End;
 XFrameSize:=FSz;
 FillChar(Xs,SizeOf(Xs),0);
 Xs[0]:=255; Xs[1]:=$E0 Or (Ver Shl 3) Or 3; Xs[2]:=(I Shl 4) Or (Srate Shl 2);
  Xs[3]:=(Ord(Mono<>0) Or 0)*192;
 If Mono=0 Then Xs[3]:=0;
 Xs[XOff]:=88; Xs[XOff+1]:=105; Xs[XOff+2]:=110; Xs[XOff+3]:=103;
 Xs[XOff+7]:=15;
 For J:=0 To 99 Do Xs[XOff+16+J]:=(255*J) Div 100;
 { chaine de l'encodeur }
 If EncOk Then Begin For J:=0 To 8 Do Xs[XOff+120+J]:=Enc[J]; End Else Begin Xs[
  XOff+120]:=76; Xs[XOff+121]:=97; Xs[XOff+122]:=118; Xs[XOff+123]:=102; End;
 XSize:=XFrameSize;
 { parcours des trames }
 Pos:=PackStart; Delay:=0; Padding:=0; Firsts:=True;
 Fd:=0; Ld:=0;
 If (HasLame<>0) And (TagFr<>0) Then Begin Fd:=-EndPad+529+TagFr*Spf; Ld:=TagFr*
  Spf; End;
 While True Do Begin
  FSz:=Parse(Pos,Hdr,K,J,N,B2);
  If Pos>=Size Then Break;
  If FSz=0 Then Begin F1Why:=12; FreeMem(Buf,Size+16); Exit; End;
  If Pos+FSz>Size Then FSz:=Size-Pos;
  { couche / frequence / canaux constants sinon non support }
  If (J<>Sr) Or (N<>Ch) Then Begin F1Why:=10; FreeMem(Buf,Size+16); Exit; End;
  If InitBr=0 Then InitBr:=B2;
  If (B2=0) Or (InitBr<>B2) Then VbrFlag:=1;
  { table des sacs }
  Inc(NPk); Inc(Seen); Inc(XSize,FSz);
  If Want=Seen Then Begin
   Bag[BPos]:=XSize; Inc(BPos);
   If BPos=400 Then Begin
    I:=1; While I<400 Do Begin Bag[I Shr 1]:=Bag[I]; Inc(I,2); End;
    Want:=Want*2; BPos:=200;
   End;
   Seen:=0;
  End;
  Inc(AudioSize,FSz);
  For I:=Pos To Pos+FSz-1 Do AudioCrc:=CrcUpd(AudioCrc,Buf^[I]);
  { donnees annexes saut/rognage }
  Smp:=(NPk-1)*Spf; Disc:=0;
  If Fd<>0 Then Begin
   If (Smp+Spf>=Fd) And (Smp<Ld) Then Begin Disc:=Smp+Spf-Fd; If Disc>Spf Then
    Disc:=Spf; End;
  End;
  If (HasLame<>0) And (NPk=1) Then K:=StartPad+529 Else K:=0;
  If (K<>0) Or (Disc<>0) Then Begin
   Padding:=Disc+529; If Padding<0 Then Padding:=0;
   If (Delay=0) And (K<>0) Then Delay:=K-529;
  End Else Padding:=0;
  Inc(Pos,FSz);
 End;
 If NPk=0 Then Begin F1Why:=11; FreeMem(Buf,Size+16); Exit; End;
 { mise a jour de la trame Xing }
 If VbrFlag=0 Then Begin Xs[XOff]:=73; Xs[XOff+1]:=110; Xs[XOff+2]:=102; Xs[
  XOff+3]:=111; End;
 W32(XOff+8,NPk); W32(XOff+12,XSize);
 Xs[XOff+16]:=0;
 For I:=1 To 99 Do Begin
  J:=I*BPos Div 100;
  Sgn:=(Int64(256)*Bag[J]) Div XSize;
  If Sgn>255 Then Sgn:=255;
  Xs[XOff+16+I]:=Sgn;
 End;
 If Delay>=4096 Then Delay:=4095; If Padding>=4096 Then Padding:=4095;
 N:=(Delay Shl 12)+Padding;
 Xs[XOff+141]:=(N Shr 16) And 255; Xs[XOff+142]:=(N Shr 8) And 255; Xs[XOff+
  143]:=N And 255;
 Inc(AudioSize,XFrameSize);
 W32(XOff+156-8,AudioSize);
 Xs[XOff+156-4]:=AudioCrc Shr 8; Xs[XOff+156-3]:=AudioCrc And 255;
 Crc:=0; For I:=0 To 189 Do Crc:=CrcUpd(Crc,Xs[I]);
 Xs[XOff+156-2]:=Crc Shr 8; Xs[XOff+156-1]:=Crc And 255;
 { ecriture : ID3v2.4 TSSE, trame Xing, trames audio }
 OpenWrite(Target);
 FillChar(ID,SizeOf(ID),0);
 ID[0]:=73; ID[1]:=68; ID[2]:=51; ID[3]:=4; ID[9]:=35;
 ID[6]:=0; ID[7]:=0; ID[8]:=0;
 ID[10]:=84; ID[11]:=83; ID[12]:=83; ID[13]:=69; ID[17]:=15; ID[20]:=3;
 For I:=1 To 13 Do ID[20+I]:=Ord(LavfId[I]);
