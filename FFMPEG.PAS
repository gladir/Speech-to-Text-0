Begin
 AlbumWideSize:=Length(AlbumName); AlbumUTF8Size:=0;
 {$IFDEF MSWINDOWS}
  If AlbumWideSize>0 Then Begin
   AlbumWideSize:=MultiByteToWideChar(0,0,@AlbumName[1],Length(AlbumName),
