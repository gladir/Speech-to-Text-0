Function VLC(Kind: Integer): Integer;
Var
 L,I,N,Bits,Value: Integer;
Begin
 Value:=0; VLC:=-1;
 For L:=1 To 13 Do Begin
  Value:=Value*2+LVBits(1,0); N:=103; If Kind=0 Then N:=9 Else If Kind=1 Then
   N:=16;
  For I:=0 To N-1 Do Begin
   If Kind=0 Then Begin
    Bits:=MCBits[I]; Code:=MCCodes[I];
   End Else
   If Kind=1 Then Begin
    Bits:=CBTable[I,1]; Code:=CBTable[I,0];
   End Else
   Begin
    Bits:=RLTable[I,1]; Code:=RLTable[I,0];
   End;
   If (Bits=L) And (Value=Code) Then Begin
    VLC:=I; Exit;
   End;
  End;
 End;
 Fail('FLV1: code VLC invalide.');
End;

Procedure Geometry(B: Integer);Begin
 PW:=Tracks^[T].Width; PH:=Tracks^[T].Height; RawPlane:=V^.Pos; PlaneBase:=
  FrameBase;
 BX:=MBX*16+(B And 1)*8; BY:=MBY*16+((B Shr 1) And 1)*8;
 If B>=4 Then Begin
  Inc(RawPlane,LongInt(PW)*PH); Inc(PlaneBase,LongInt(PW)*PH);
  PW:=(PW+1) Div 2; PH:=(PH+1) Div 2; BX:=MBX*8; BY:=MBY*8;
  If B=5 Then Begin
   Inc(RawPlane,LongInt(PW)*PH); Inc(PlaneBase,LongInt(PW)*PH);
  End;
 End;
End;
Begin
 LVHeader(T,V,EncodeMode); FrameBase:=OutPos;
 If Not EncodeMode Then Begin
  N:=Tracks^[T].Width; I:=Tracks^[T].Height;
  FrameEnd:=Ticks(FrameBase*1.0+N*1.0*I+2.0*((N+1) Div 2)*((I+1) Div 2));
  { Reserve all planes so block writes can seek independently. }
  At:=FrameEnd-FrameBase;
  While At>0 Do Begin
   N:=4096; If At<N Then N:=At; Zero(N); Dec(At,N);
  End;
 End;
 For U:=0 To 7 Do
 For X:=0 To 7 Do Begin
  C[U,X]:=Cos((2*X+1)*U*3.14159265358979323846/16)/2;
  If U=0 Then C[U,X]:=C[U,X]/Sqrt(2);
 End;
 For MBY:=0 To (Tracks^[T].Height+15) Div 16-1 Do
 For MBX:=0 To (Tracks^[T].Width+15) Div 16-1 Do Begin
  FillChar(Coeff,SizeOf(Coeff),0); CBP:=0;
  If EncodeMode Then Begin
   For Block:=0 To 5 Do Begin
    Geometry(Block);
    For Y:=0 To 7 Do
    For X:=0 To 7 Do Begin
     I:=BX+X; If I>=PW Then I:=PW-1; J:=BY+Y; If J>=PH Then J:=PH-1;
     Values[Y,X]:=ByteAt(RawPlane+LongInt(J)*PW+I);
    End;
    For Y:=0 To 7 Do
    For U:=0 To 7 Do Begin
     Sum:=0;
     For X:=0 To 7 Do Sum:=Sum+C[U,X]*Values[Y,X]; Temp[Y,U]:=Sum;
    End;
    For Y:=0 To 7 Do
    For X:=0 To 7 Do Begin
     Sum:=0;
     For U:=0 To 7 Do Sum:=Sum+C[Y,U]*Temp[U,X];
     If (X=0) And (Y=0) Then Begin
      N:=Round(Sum/8); If N<1 Then N:=1 Else If N>254 Then N:=254;
     End Else
     Begin
      N:=Trunc((Abs(Sum)-(LVQP-1))/ (2*LVQP)); If N<0 Then N:=0;
      If N>1023 Then N:=1023; If Sum<0 Then N:=-N;
      If N<>0 Then CBP:=CBP Or (1 Shl (5-Block));
     End;
     Coeff[Block,Y*8+X]:=N;
    End;
   End;
   CP:=CBP And 3; Dummy:=LVBits(MCBits[CP],MCCodes[CP]);
   CP:=CBP Shr 2; Dummy:=LVBits(CBTable[CP,1],CBTable[CP,0]);
  End Else
  Begin
   Repeat CP:=VLC(0); Until CP<>8;
   CBP:=(CP And 3) Or (VLC(1) Shl 2);
   If (CP And 4)<>0 Then Begin
    Inc(LVQP,DQ[LVBits(2,0)]);
    If (LVQP<1) Or (LVQP>31) Then Fail('FLV1: DQUANT invalide.');
   End;
  End;
  For Block:=0 To 5 Do Begin
   If EncodeMode Then Begin
    N:=Coeff[Block,0]; If N=128 Then N:=255; Dummy:=LVBits(8,N);
    Last:=0;
    For I:=1 To 63 Do If Coeff[Block,Scan[I]]<>0 Then Last:=I;
    Run:=0;
    For I:=1 To Last Do Begin
     Level:=Coeff[Block,Scan[I]];
     If Level=0 Then Inc(Run) Else
     Begin
      Dummy:=LVBits(7,3); Dummy:=LVBits(1,1); Dummy:=LVBits(1,Ord(I=Last));
      Dummy:=LVBits(6,Run); Dummy:=LVBits(11,Level And 2047); Run:=0;
     End;
    End;
   End Else
   Begin
    N:=LVBits(8,0); If (N=0) Or (N=128) Then Fail('FLV1: DC invalide.');
    If N=255 Then N:=128;
    Coeff[Block,0]:=N*8; Index:=0;
    If (CBP And (1 Shl (5-Block)))<>0 Then Repeat
    Code:=VLC(2);
    If Code=102 Then Begin
     N:=8;
     If LVVersion=1 Then Begin
      N:=7; If LVBits(1,0)<>0 Then N:=11;
     End;
     Last:=LVBits(1,0); Run:=LVBits(6,0); Level:=LVBits(N,0);
     If Level>=(1 Shl (N-1)) Then Dec(Level,1 Shl N);
     If (LVVersion=0) And (Level=-128) Then Begin
      I:=LVBits(5,0); J:=LVBits(6,0); If J>=32 Then Dec(J,64); Level:=I+J*32;
     End;
     If Level=0 Then Fail('FLV1: coefficient nul dans escape.');
    End Else
    Begin
     Last:=Ord(Code>=58); Run:=RLRun[Code]; Level:=RLLevel[Code];
     If LVBits(1,0)<>0 Then Level:=-Level;
    End;
    Inc(Index,Run+1); If Index>63 Then Fail('FLV1: depassement bloc DCT.');
    N:=Abs(Level)*2*LVQP+((LVQP-1) Or 1); If Level<0 Then N:=-N;
    Coeff[Block,Scan[Index]]:=N;
    Until Last<>0;
    Geometry(Block);
    For Y:=0 To 7 Do
    For X:=0 To 7 Do Begin
     Sum:=0;
     For U:=0 To 7 Do Sum:=Sum+C[U,X]*Coeff[Block,Y*8+U]; Temp[Y,X]:=Sum;
    End;
    For Y:=0 To 7 Do If BY+Y<PH Then Begin
     K:=0;
     For X:=0 To 7 Do If BX+X<PW Then Begin
      Sum:=0;
      For U:=0 To 7 Do Sum:=Sum+C[U,Y]*Temp[U,X];
      N:=Round(Sum); If N<0 Then N:=0 Else If N>255 Then N:=255; Row[X]:=N; Inc(
       K);
     End;
     If K>0 Then Begin
      SeekOut(PlaneBase+LongInt(BY+Y)*PW+BX); WriteBytes(Row,K);
     End;
    End;
   End;
  End;
 End;
 If EncodeMode Then Begin
  If LVCount<>0 Then Dummy:=LVBits(8-LVCount,0);
 End
 Else SeekOut(FrameEnd);
End;

Procedure ReadFLV1;
Var
 At,N,TS,Previous,LastTS,Delta: LongInt;
 T,Kind: Integer;
 V: PSample;
Begin
 If (FileLimit<13) Or (Tag(0)<>'FLV'+#1) Then Fail('FLV: entete invalide.');
 At:=Number(5,False);
 If (At<9) Or ((ByteAt(4) And $FA)<>0) Then Fail('FLV: entete invalide.');
 Bounds(At,4);
 If Number(At,False)<>0 Then Fail('FLV: premiere taille precedente invalide.');
  Inc(At,4);
 T:=AddTrack; Tracks^[T].Video:=True; Tracks^[T].Codec:='FLV1'; Tracks^[
  T].Scale:=1000;
 Tracks^[T].InputScale:=1000; LastTS:=-1; Delta:=0;
 While At<FileLimit Do Begin
  Bounds(At,11);
  If (ByteAt(At+8)<>0) Or (U16(At+9,False)<>0) Then Fail(
  'FLV: identifiant de flux non nul.');
  Kind:=ByteAt(At); N:=LongInt(ByteAt(At+1))*65536+U16(At+2,False);
  TS:=LongInt(ByteAt(At+4))*65536+U16(At+5,False);
  If ByteAt(At+7)>127 Then Fail('FLV: horodatage hors limites.');
  Inc(TS,LongInt(ByteAt(At+7))*16777216);
  Bounds(At+11,N+4); Previous:=Number(At+11+N,False);
  If Previous<>N+11 Then Fail('FLV: taille precedente incorrecte.');
  If Kind=9 Then Begin
   If (N<2) Or (ByteAt(At+11)<>$12) Then Fail(
   'FLV1: images intra Sorenson Spark requises.');
   If LastTS>=0 Then Begin
    If Delta=0 Then Delta:=TS-LastTS;
    If (Delta<=0) Or (TS-LastTS<>Delta) Then Fail(
     'FLV1: cadence constante requise.');
    Tracks^[T].Last^.Duration:=Delta;
   End;
   V:=AddSample(T,At+12,N-1,TS,1,0,True); LVHeader(T,V,False); LastTS:=TS;
  End Else If (Kind<>8) And (Kind<>18) Then Fail(
   'FLV: tag non pris en charge.');
  Inc(At,N+15);
 End;
 If Delta=0 Then Fail('FLV1: deux images requises pour determiner la cadence.');
 Tracks^[T].DefaultDuration:=Delta; Tracks^[T].Last^.Duration:=Delta;
 TS:=Tracks^[T].First^.Time; V:=Tracks^[T].First;
 While V<>Nil Do Begin
  Dec(V^.Time,TS); V:=V^.Next;
 End;
End;

Procedure WriteFLV1;
Var
 V: PSample;
 At,Finish,N,TS: LongInt;
 J: Integer;
 Trial:TVideoRateTrial;
 Seconds:Double;
Begin
 VideoRateStart;
 If TrackCount<>1 Then Fail('FLV1: une seule piste requise.');
 LE:=False; WTag('FLV'+#1); W8(1); W32(9); W32(0); V:=Tracks^[1].First;
 While V<>Nil Do Begin
  At:=OutPos; Seconds:=V^.Duration*1.0/Tracks^[1].Scale; VideoTrialStart(Trial,
   Seconds);
  Repeat
  SeekOut(At); LVEncodeQP:=Trial.Q; W8(9); Zero(3);
  TS:=Ticks(V^.Time*1000.0/Tracks^[1].Scale);
  W8((TS Shr 16) And 255); W8((TS Shr 8) And 255); W8(TS And 255);
  W8((TS Shr 24) And 255); Zero(3);
  W8($12); LVFrame(1,V,True); Finish:=OutPos; N:=Finish-At-11;
  If N>$FFFFFF Then Fail('FLV1: image trop volumineuse.');
  SeekOut(At+1);
  For J:=2 Downto 0 Do W8((N Shr (J*8)) And 255);
  SeekOut(Finish); W32(N+11);
  Until Not VideoTrialAgain(Trial,OutPos-At);
  VideoRateAccept(OutPos-At,Seconds); V:=V^.Next;
 End; VideoRateReport;
End;

Procedure ReadY4M;
Var
 At,N,Num,Den: LongInt;
 Line,Token: String;
 T,J,K,Code: Integer;
 V: PSample;
Begin
 At:=0; Line:=Y4Line(At);
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('Y4M: signature absente.');
 T:=AddTrack; Tracks^[T].Video:=True; Tracks^[T].Codec:='FFV1';
 If VideoCodec='flv' Then Tracks^[T].Codec:='FLV1'; Num:=0; Den:=0;
 Delete(Line,1,9);
 While Line<>'' Do Begin
  If Line[1]=' ' Then Delete(Line,1,1) Else
  Begin
   J:=Pos(' ',Line); If J=0 Then J:=Length(Line)+1;
   Token:=Copy(Line,1,J-1); Delete(Line,1,J);
   Case Token[1] Of
   'W','H':
   Begin
    Val(Copy(Token,2,255),N,Code);
    If (Code<>0) Or (N<1) Or (N>4096) Then Fail(
     'Y4M: dimensions 1..4096 requises.');
    If Token[1]='W' Then Tracks^[T].Width:=N Else Tracks^[T].Height:=N;
   End;
   'F':
   Begin
    K:=Pos(':',Token); If K<3 Then Fail('Y4M: cadence invalide.');
    Val(Copy(Token,2,K-2),Num,Code);
    If (Code<>0) Or (Num<=0) Or (Num>1000000) Then Fail(
     'Y4M: cadence invalide.');
    Val(Copy(Token,K+1,255),Den,Code);
    If (Code<>0) Or (Den<=0) Or (Den>1000000) Then Fail(
     'Y4M: cadence invalide.');
   End;
   'C': If (Token<>'C420') And (Token<>'C420jpeg')
And (Token<>'C420mpeg2') And (Token<>'C420paldv')
 Then Fail(
   'Y4M: C420jpeg 8 bits requis.');
   'I': If Token<>'Ip' Then Fail('Y4M: video progressive requise.');
   'A': If (Token<>'A1:1') And (Token<>'A0:0') Then Fail(
    'Y4M: pixels carres requis.');
    'X': ;

                                               Else Fail(
                                                'Y4M: parametre non pris en ch'+
                                                'arge: '+Token);
  End;
 End;
End;
If (Num=0) Or (Den=0) Or (Tracks^[T].Width=0) Or (Tracks^[T].Height=0) Then
 Fail(
'Y4M: dimensions et cadence requises.');
Tracks^[T].Scale:=Num; Tracks^[T].InputScale:=Num;
N:=Tracks^[T].Width*Tracks^[T].Height+2*((Tracks^[T].Width+1) Div 2)*((Tracks^[
 T].Height+
1) Div 2);
While At<FileLimit Do Begin
 Line:=Y4Line(At); If Line<>'FRAME' Then Fail(
  'Y4M: marqueur FRAME simple requis.');
 V:=AddSample(T,At,N,Ticks(Tracks^[T].Count*1.0*Den),Den,0,True); Inc(At,N);
End;
End;
