Type
 TMPCVlc=Record N: LongInt; Code: Array[0..255] Of LongWord; Len: Array[0..255]
  Of Byte; Sym: Array[0..255] Of SmallInt; End;
 TMPCBand=Record Msf: LongInt; Res,Scfi: Array[0..1] Of LongInt; Scf: Array[
  0..1,0..2] Of LongInt; End;
 PMPCVlc=^TMPCVlc;
 TMPCBandArr=Array[0..31] Of TMPCBand;
 TMPC=Record
  Maxbands,MSS,IS,Gapless,LastFrameLen,Frames,CurFrame,LastBitsUsed,LastMaxBand,
   Channels: LongInt;
  OldDSCF: Array[0..1,0..31] Of LongInt;
  Bands: TMPCBandArr;
  Q: Array[0..1,0..1151] Of LongInt;
  Lfg: Array[0..63] Of LongWord; LfgIdx: LongWord;
  Syn: PMPA; Plane: Array[0..1] Of PMPASingles;
  Buf: PEABuffer; BitPos,BitLimit: LongInt;
 End;
 PMPC=^TMPC;
Var
 MPCV: Array[0..37] Of TMPCVlc;
 MPCReady: Boolean;
 MPCC: PMPC;

Function MPCPeek32: LongWord;
Var P,Sh: LongInt; V: Int64;
Begin
 P:=MPCC^.BitPos Shr 3; Sh:=MPCC^.BitPos And 7;
 V:=(Int64(MPCC^.Buf^[P]) Shl 32) Or (Int64(MPCC^.Buf^[P+1]) Shl 24) Or (Int64(
  MPCC^.Buf^[P+2]) Shl 16) Or (Int64(MPCC^.Buf^[P+3]) Shl 8) Or MPCC^.Buf^[P+4];
 MPCPeek32:=LongWord((V Shr (8-Sh)) And $FFFFFFFF);
End;
Function MPCGet(N: LongInt): LongInt;
Var V: LongWord;
Begin
 If N=0 Then Begin MPCGet:=0; Exit; End;
 V:=MPCPeek32;
 If N<=32 Then MPCGet:=LongInt(V Shr (32-N)) Else MPCGet:=0;
 Inc(MPCC^.BitPos,N);
End;
Procedure MPCSkip(N: LongInt);
Begin Inc(MPCC^.BitPos,N); End;
Function MPCLeft: LongInt;
Begin MPCLeft:=MPCC^.BitLimit-MPCC^.BitPos; End;

Function MPCVlcGet(Idx: LongInt): LongInt;
Var V: PMPCVlc; W: LongWord; Lo,Hi,Mid,L: LongInt;
Begin
 V:=@MPCV[Idx]; W:=MPCPeek32;
 Lo:=0; Hi:=V^.N-1;
 While Lo<Hi Do Begin
  Mid:=(Lo+Hi+1) Shr 1;
  If V^.Code[Mid]<=W Then Lo:=Mid Else Hi:=Mid-1;
 End;
 L:=V^.Len[Lo];
 If (V^.Code[Lo] Shr (32-L))=(W Shr (32-L)) Then Begin
  MPCVlcGet:=V^.Sym[Lo]; Inc(MPCC^.BitPos,L);
 End Else MPCVlcGet:=-1;
End;

Procedure MPCAdd(Idx: LongInt; Var Code: Int64; Len,Sym: LongInt);
Var V: PMPCVlc;
Begin
 V:=@MPCV[Idx];
 V^.Code[V^.N]:=LongWord(Code And $FFFFFFFF); V^.Len[V^.N]:=Len; V^.Sym[V^.N]:=
  Sym; Inc(V^.N);
 Code:=Code+(Int64(1) Shl (32-Len));
End;

{ table SV7 : paires (symbole, longueur) }
Procedure MPCBuild7(Idx: LongInt; Const Tab: Array Of Byte; Start,Count,Offset:
 LongInt);
Var I: LongInt; Code: Int64;
Begin
 MPCV[Idx].N:=0; Code:=0;
 For I:=0 To Count-1 Do MPCAdd(Idx,Code,Tab[Start+2*I+1],Tab[Start+2*I]+Offset);
End;

{ table SV8 : nombres de codes par longueur (16 -> 1), symboles consecutifs ;
 renvoie le nombre de symboles }
Function MPCBuild8(Idx: LongInt; Const Counts: Array Of Byte; CStart: LongInt;
 Const Syms: Array Of Byte; SStart,Offset: LongInt): LongInt;
Var L,K,Num: LongInt; Code: Int64;
Begin
 MPCV[Idx].N:=0; Code:=0; Num:=0;
 For L:=16 DownTo 1 Do
  For K:=1 To Counts[CStart+L-1] Do Begin
   MPCAdd(Idx,Code,L,Syms[SStart+Num]+Offset); Inc(Num);
  End;
 MPCBuild8:=Num;
End;

Procedure MPCInitVlcs;
Var I,J,Off,S,Q,Tmp: LongInt;
Begin
