Function R2Dot(Const A: Array Of Single; Ao: LongInt; Const B: Array Of Single;
 Bo: LongInt; Len: LongInt): Single;
Var P: Single; I: LongInt;
Begin P:=0.0; For I:=0 To Len-1 Do P:=P+A[Ao+I]*B[Bo+I]; R2Dot:=P; End;
Procedure R2Convolve(Var Tgt: Array Of Single; Const Src: Array Of Single; So:
 LongInt; Len,N: LongInt);
Begin
 While N>=0 Do Begin Tgt[N]:=R2Dot(Src,So,Src,So-N,Len); Dec(N); End;
End;
{ ff_celp_lp_synthesis_filterf, Out[OutPos..] avec historique avant OutPos }
Procedure R2LpSynth(Var Out: Array Of Single; OutPos: LongInt; Const Co: Array
 Of Single; Const Inp: Array Of Single; BufLen,FLen: LongInt);
Var Out0,Out1,Out2,Out3,Old0,Old1,Old2,Old3,A,B,C,Val,Tmp0,Tmp1,Tmp2,T: Single;
 N,I,Ip,Op: LongInt;
Begin
 A:=Co[0]; B:=Co[1]; C:=Co[2];
 B:=B-Co[0]*Co[0]; C:=C-Co[1]*Co[0]; C:=C-Co[0]*B;
 Old0:=Out[OutPos-4]; Old1:=Out[OutPos-3]; Old2:=Out[OutPos-2]; Old3:=Out[
  OutPos-1];
 N:=0; Ip:=0; Op:=OutPos;
 While N<=BufLen-4 Do Begin
  Out0:=Inp[Ip]; Out1:=Inp[Ip+1]; Out2:=Inp[Ip+2]; Out3:=Inp[Ip+3];
  Out0:=Out0-Co[2]*Old1; Out1:=Out1-Co[2]*Old2; Out2:=Out2-Co[2]*Old3;
  Out0:=Out0-Co[1]*Old2; Out1:=Out1-Co[1]*Old3;
  Out0:=Out0-Co[0]*Old3;
  Val:=Co[3];
  Out0:=Out0-Val*Old0; Out1:=Out1-Val*Old1; Out2:=Out2-Val*Old2; Out3:=Out3-Val*
   Old3;
  I:=5;
  While I<FLen Do Begin
   Old3:=Out[Op-I];
   Val:=Co[I-1];
   Out0:=Out0-Val*Old3; Out1:=Out1-Val*Old0; Out2:=Out2-Val*Old1; Out3:=Out3-
    Val*Old2;
   Old2:=Out[Op-I-1];
   Val:=Co[I];
   Out0:=Out0-Val*Old2; Out1:=Out1-Val*Old3; Out2:=Out2-Val*Old0; Out3:=Out3-
    Val*Old1;
   T:=Old0; Old0:=Old2; Old2:=T;
   Old1:=Old3;
   Inc(I,2);
  End;
  Tmp0:=Out0; Tmp1:=Out1; Tmp2:=Out2;
  Out3:=Out3-A*Tmp2; Out2:=Out2-A*Tmp1; Out1:=Out1-A*Tmp0;
  Out3:=Out3-B*Tmp1; Out2:=Out2-B*Tmp0;
  Out3:=Out3-C*Tmp0;
  Out[Op]:=Out0; Out[Op+1]:=Out1; Out[Op+2]:=Out2; Out[Op+3]:=Out3;
  Old0:=Out0; Old1:=Out1; Old2:=Out2; Old3:=Out3;
  Inc(Op,4); Inc(Ip,4); Inc(N,4);
 End;
 { Op/Ip correspondent a la position N ; reprise echantillon par echantillon }
 While N<BufLen Do Begin
  Out[OutPos+N]:=Inp[N];
  For I:=1 To FLen Do Out[OutPos+N]:=Out[OutPos+N]-Co[I-1]*Out[OutPos+N-I];
  Inc(N);
 End;
End;
{ compute_lpc_coefs (float), normalize=1, fail=1, lpc_stride=0 ; retourne True
 si echec }
Function R2LpcCoefs(Const Autoc: Array Of Single; MaxOrder: LongInt; Var Lpc:
 Array Of Single): Boolean;
Var I,J: LongInt; Err,R,F,B: Single;
Begin
 R2LpcCoefs:=False;
 Err:=Autoc[0];
 If (Autoc[MaxOrder]=0) Or (Err<=0) Then Begin R2LpcCoefs:=True; Exit; End;
 For I:=0 To MaxOrder-1 Do Begin
  R:=-Autoc[1+I];
  For J:=0 To I-1 Do R:=R-Lpc[J]*Autoc[1+I-J-1];
  If Err<>0 Then R:=R/Err;
  Err:=Err*(1.0-R*R);
  Lpc[I]:=R;
  For J:=0 To ((I+1) Shr 1)-1 Do Begin
   F:=Lpc[J]; B:=Lpc[I-1-J];
   Lpc[J]:=F+R*B;
   Lpc[I-1-J]:=B+R*F;
  End;
  If Err<0 Then Begin R2LpcCoefs:=True; Exit; End;
 End;
End;
Procedure R2Backward(Var Hist: Array Of Single; Var Rec: Array Of Single; Const
 Win: Array Of Single; Var Lpc: Array Of Single; Const Tab: Array Of Single;
 Order,N,NonRec,MoveSize: LongInt);
Var Work: Array[0..127] Of Single; B1,B2,Temp: Array[0..36] Of Single; I,Tot:
 LongInt; Fail: Boolean;
Begin
 Tot:=Order+N+NonRec;
 For I:=0 To Tot-1 Do Work[I]:=Win[I]*Hist[I];
 R2Convolve(B1,Work,Order,N,Order);
 R2Convolve(B2,Work,Order+N,NonRec,Order);
 For I:=0 To Order Do Begin
  Rec[I]:=Single(Double(Rec[I])*0.5625+B1[I]);
  Temp[I]:=Rec[I]+B2[I];
 End;
 Temp[0]:=Single(Double(Temp[0])*(257.0/256.0));
 Fail:=R2LpcCoefs(Temp,Order,Lpc);
 If Not Fail Then For I:=0 To Order-1 Do Lpc[I]:=Lpc[I]*Tab[I];
 For I:=0 To MoveSize-1 Do Hist[I]:=Hist[I+N];
End;
Procedure R2Decode(Gain: Single; Cb: LongInt);
Var I: LongInt; Sum: Single; SumSum: Double; Buf: Array[0..4] Of Single; Sd,A5,
 Kc: Double;
Begin
 For I:=0 To 35 Do R2.SpHist[70+I]:=R2.SpHist[75+I];
 Sum:=32.0;
 For I:=0 To 9 Do Sum:=Sum-R2.GainHist[28+9-I]*R2.GainLpc[I];
 If Sum<0 Then Sum:=0 Else If Sum>60 Then Sum:=60;
 SumSum:=Exp(Double(Sum)*0.1151292546497)*Double(Gain)*(1.0/8388608.0);
 For I:=0 To 4 Do Buf[I]:=Single(RA2Code[Cb*5+I]*SumSum);
 Sum:=R2Dot(Buf,0,Buf,0,5);
 Sd:=5.0/16777216.0;
 If Not (Double(Sum)>Sd) Then Sum:=Single(Sd);
 For I:=0 To 8 Do R2.GainHist[28+I]:=R2.GainHist[28+I+1];
 A5:=5.0; Kc:=10*(Ln(16777216.0/A5)/Ln(10.0))-32;
 R2.GainHist[37]:=Single(10*(Ln(Double(Sum))/Ln(10.0))+Kc);
 R2LpSynth(R2.SpHist,106,R2.SpLpc,Buf,5,36);
End;
Procedure R2Block(Buf: PEABuffer; Var Pcm: Array Of Single);
Var Bp,I,J,Gi,Cb: LongInt; Gn: Single;
Function GetBitsLE(N: LongInt): LongInt;
Var Z,Rr: LongInt;
Begin Rr:=0; For Z:=0 To N-1 Do Begin Rr:=Rr Or (((Buf^[Bp Shr 3] Shr (Bp And
 7)) And 1) Shl Z); Inc(Bp); End; GetBitsLE:=Rr; End;
Begin
 Bp:=0;
 For I:=0 To 31 Do Begin
  Gi:=GetBitsLE(3); Gn:=RA2Amp[Gi];
  Cb:=GetBitsLE(6+(I And 1));
  R2Decode(Gn,Cb);
  For J:=0 To 4 Do Pcm[I*5+J]:=R2.SpHist[106+J];
  If (I And 7)=3 Then Begin
   R2Backward(R2.SpHist,R2.SpRec,RA2SynWin,R2.SpLpc,RA2SynBw,36,40,35,70);
   R2Backward(R2.GainHist,R2.GainRec,RA2GainWin,R2.GainLpc,RA2GainBw,10,8,20,
    28);
  End;
 End;
End;

Procedure DecodeRA288(Const Source,Target: String);
Var I,P,J,Found,V: LongInt; Pcm: Array[0..159] Of Single; Tg: LongInt;
Begin
 RMParse(Source);
 Found:=-1; Tg:=Ord('2')+Ord('8')*256+Ord('_')*65536+Ord('8')*16777216;
 For I:=0 To RMNS-1 Do If (RMSt[I].Kind=1) And (RMSt[I].Tag=Tg) Then Begin
  Found:=I; Break; End;
 If Found<0 Then Fail('real_288: aucun flux RealAudio 2.0 (28_8).');
 If RMSt[Found].BlockAlign<>38 Then Fail(
  'real_288: block_align de 38 octets requis.');
 FillChar(R2,SizeOf(R2),0);
 EAReset; OpenWrite(Target); ADPCMWaveHeader(RMSt[Found].Rate,1,0);
 For P:=0 To RMNPk-1 Do If RMPkS^[P]=Found Then Begin
  If RMPkLen^[P]<38 Then Continue;
  R2Block(PEABuffer(@RMArena^[RMPkOff^[P]]),Pcm);
  For J:=0 To 159 Do Begin
   V:=Round(Single(Pcm[J]*32768.0));
   If V>32767 Then V:=32767 Else If V<-32768 Then V:=-32768;
   EAPut(V);
  End;
 End;
 EAFlush;
 If EAWritten=0 Then Fail('real_288: aucune trame decodee.');
 ADPCMPatchHeader(RMSt[Found].Rate,1,EAWritten); CloseWrite;
 RMFree;
End;


Function RMAudioKind(Const Name: String): LongInt;
Var I: LongInt;
Begin
 RMAudioKind:=0;
 RMParse(Name);
 For I:=0 To RMNS-1 Do If RMSt[I].Kind=1 Then Begin
  If RMSt[I].Tag=Ord('l')+Ord('p')*256+Ord('c')*65536+Ord('J')*16777216 Then
   Begin RMAudioKind:=1; Break; End;
  If RMSt[I].Tag=Ord('2')+Ord('8')*256+Ord('_')*65536+Ord('8')*16777216 Then
   Begin RMAudioKind:=2; Break; End;
 End;
 RMFree;
End;

{ ---- RealVideo 1.0 / 2.0 (libavcodec/rv10.c) : decodeur sur le moteur H.263
 (H3) ---- }
Var
 RVSub,RVMajor,RVMinor,RVMicro,RVOrigW,RVOrigH,RVRprMax,RVCurType,RVLastI,
  RVNextI: LongInt;
 RVLow,RVPend: Boolean; RVExt: Array[0..255] Of Byte; RVExtLen: LongInt;
 RVFrameBuf: PEABuffer; RVFrameCap: LongInt;

Function RVLog2(V: LongInt): LongInt;
Var R: LongInt;
Begin R:=0; While V>1 Do Begin V:=V Shr 1; Inc(R); End; RVLog2:=R; End;

{ rv10_decode_picture_header : retourne le nombre de macroblocs ou < 0 }
Function RVHeader10: LongInt;
Var PbFrame,MbXy,MbCount,I: LongInt;
Begin
 RVHeader10:=-1;
 H3Bit;
 If H3Bit<>0 Then H3PictType:=1 Else H3PictType:=0;
 PbFrame:=H3Bit;
 If PbFrame<>0 Then Exit;
 H3Qscale:=H3Bits(5);
 If H3Qscale=0 Then Exit;
 If (H3PictType=0) And (H3Rv10Ver=3) Then For I:=0 To 2 Do H3RvLastDc[I]:=
  H3Bits(8);
 MbXy:=H3MbX+H3MbY*H3MbW;
 If (H3Show(12)=0) Or ((MbXy<>0) And (MbXy<H3MbNum)) Then Begin
  H3MbX:=H3Bits(6); H3MbY:=H3Bits(6); MbCount:=H3Bits(12);
 End Else Begin
  H3MbX:=0; H3MbY:=0; MbCount:=H3MbW*H3MbH;
 End;
 H3Skip(3);
 RVHeader10:=MbCount;
End;

{ rv20_decode_picture_header ; -2 = image B ignoree (ordre incoherent), -3 =
 changement de resolution }
Function RVHeader20(Whole: LongInt): LongInt;
Var Typ,F,Seq,MbPos,I: LongInt;
Begin
 RVHeader20:=-1;
 Typ:=H3Bits(2);
 Case Typ Of 0,1: H3PictType:=0; 2: H3PictType:=1; Else H3PictType:=2; End;
 If RVLow And (H3PictType=2) Then Exit;
 If (RVLastI<0) And (H3PictType=2) Then Exit;
 If H3Bit<>0 Then Exit;
 H3Qscale:=H3Bits(5);
 If H3Qscale=0 Then Exit;
 If RVMinor>=2 Then H3Loop:=H3Bit;
 If RVMinor<=1 Then Seq:=H3Bits(8) Shl 7 Else Seq:=H3Bits(13) Shl 2;
 If RVRprMax<>0 Then Begin
  F:=H3Bits(RVLog2(RVRprMax)+1);
  If F<>0 Then Begin RVHeader20:=-3; Exit; End;
 End;
 MbPos:=H3DecodeMba;
 Seq:=Seq Or (H3Time And Not $7FFF);
 If Seq-H3Time>$4000 Then Dec(Seq,$8000);
 If Seq-H3Time<-$4000 Then Inc(Seq,$8000);
 If Seq<>H3Time Then Begin
  If H3PictType<>2 Then Begin
   H3Time:=Seq; H3PpTime:=H3Time-H3LastNonB; H3LastNonB:=H3Time;
  End Else Begin
   H3Time:=Seq; H3PbTime:=H3PpTime-(H3LastNonB-H3Time);
  End;
 End;
 If H3PictType=2 Then Begin
  If (H3PpTime<=H3PbTime) Or (H3PpTime<=H3PpTime-H3PbTime) Or (H3PpTime<=0) Then
   Begin RVHeader20:=-2; Exit; End;
  For I:=0 To 63 Do Begin
   H3DirScale[0,I]:=(I-32)*H3PbTime Div H3PpTime;
   H3DirScale[1,I]:=(I-32)*(H3PbTime-H3PpTime) Div H3PpTime;
  End;
 End;
 H3NoRounding:=H3Bit;
 If (RVMinor<=1) And (H3PictType=2) Then H3Skip(5);
 H3Aic:=Ord(H3PictType=0);
 H3ModQ:=1; H3Loop:=1; H3ChromaTab:=True;
 RVHeader20:=H3MbW*H3MbH-MbPos;
End;

Procedure RVStartFrame;
Var Slot: LongInt;
Begin
 If H3PictType<>2 Then Begin
  RVLastI:=RVNextI; H3RefI:=RVLastI;
  Slot:=0;
  While Slot=RVLastI Do Inc(Slot);
  H3CurI:=Slot; RVNextI:=Slot;
 End Else Begin
  H3RefI:=RVLastI; H3BwdI:=RVNextI;
  Slot:=0;
  While (Slot=RVLastI) Or (Slot=RVNextI) Do Inc(Slot);
  H3CurI:=Slot;
 End;
 H3ClearPic(H3CurI);
 If (H3PictType=1) And (H3RefI<0) Then Begin
  Slot:=0; While Slot=H3CurI Do Inc(Slot);
  H3RefI:=Slot; RVLastI:=Slot;
  FillChar(H3P[H3RefI].Y^,H3LY*H3MbH*16,16);
  FillChar(H3P[H3RefI].U^,H3LC*H3MbH*8,128); FillChar(H3P[H3RefI].V^,H3LC*H3MbH*
   8,128);
 End;
 RVCurType:=H3PictType; RVPend:=True;
End;

{ rv10_decode_packet : retourne la taille active en bits, ou < 0 }
Function RVPacket(Buf: PEABuffer; BufSize,BufSize2,Whole: LongInt): LongInt;
Var MbCount,MbPos,Left,Active,StartX,Ret,V,I: LongInt;
Begin
 RVPacket:=-1;
 Active:=BufSize*8;
 H3Buf:=Buf; If BufSize>BufSize2 Then H3Size:=BufSize Else H3Size:=BufSize2;
  H3Pos:=0;
 If H3RvMode=1 Then MbCount:=RVHeader10 Else MbCount:=RVHeader20(Whole);
 If MbCount<0 Then Exit;
 If (H3MbX>=H3MbW) Or (H3MbY>=H3MbH) Then Exit;
 MbPos:=H3MbY*H3MbW+H3MbX; Left:=H3MbW*H3MbH-MbPos;
 If MbCount>Left Then Exit;
 If Whole<H3MbW*H3MbH Div 8 Then Exit;
 If ((H3MbX=0) And (H3MbY=0)) Or Not RVPend Then Begin
  If RVPend Then Begin H3MbX:=0; H3MbY:=0; H3ResyncX:=0; H3ResyncY:=0; End;
  RVStartFrame;
 End Else If RVCurType<>H3PictType Then Exit;
 If H3RvMode=1 Then Begin
  If H3MbY=0 Then H3FirstLine:=1;
 End Else Begin
  H3FirstLine:=1; H3ResyncX:=H3MbX;
 End;
 StartX:=H3MbX; H3ResyncY:=H3MbY;
 H3SetQscale(H3Qscale);
 For I:=0 To 2 Do H3RvFirst[I]:=0;
 H3MbNumLeft:=MbCount;
 While H3MbNumLeft>0 Do Begin
  H3MvType:=0;
  Ret:=H3DecodeMb;
  If Ret<>H3SliceErr Then
   If Active>=H3Pos Then Begin
    V:=H3Show(16);
    If H3Pos+16>Active Then V:=V Shr (H3Pos+16-Active);
    If V=0 Then Ret:=H3SliceEnd;
   End;
  If (Ret<>H3SliceErr) And (Active<H3Pos) And (8*BufSize2>=H3Pos) Then Begin
   Active:=BufSize2*8; Ret:=H3SliceOk;
  End;
  If (Ret=H3SliceErr) Or (Active<H3Pos) Then Exit;
  If H3PictType<>2 Then H3UpdateMotion;
  H3Recon;
  If H3Loop<>0 Then H3LoopFilter;
  Inc(H3MbX);
  If H3MbX=H3MbW Then Begin H3MbX:=0; Inc(H3MbY); End;
  If H3MbX=H3ResyncX Then H3FirstLine:=0;
  If Ret=H3SliceEnd Then Break;
  Dec(H3MbNumLeft);
 End;
 RVPacket:=Active;
End;

{ rv10_decode_frame ; 1 = image disponible dans H3P[H3Out], 0 = rien, < 0 =
 erreur }
Function RVFrame(Pk: PEABuffer; Len: LongInt): LongInt;
Var
 SliceCount,I,Offset,Size,Size2,Ret,DSize,Off1,Off2: LongInt; Data: PEABuffer;
Function SlOff(N: LongInt): Int64;
Begin SlOff:=Int64(RVFrameBuf^[5+N*8])+Int64(RVFrameBuf^[6+N*8])*256+Int64(
 RVFrameBuf^[7+N*8])*65536+Int64(RVFrameBuf^[8+N*8])*16777216; End;
Begin
 RVFrame:=0;
 If Len=0 Then Exit;
 If RVFrameCap<Len+128 Then Begin
  If RVFrameBuf<>Nil Then FreeMem(RVFrameBuf);
  RVFrameCap:=Len+128; GetMem(RVFrameBuf,RVFrameCap);
 End;
 Move(Pk^,RVFrameBuf^,Len); FillChar(RVFrameBuf^[Len],128,0);
 SliceCount:=RVFrameBuf^[0]+1;
 DSize:=Len-1;
 If DSize<=8*SliceCount Then Begin RVFrame:=-1; Exit; End;
 Data:=PEABuffer(@RVFrameBuf^[1+8*SliceCount]); Dec(DSize,8*SliceCount);
 I:=0;
 While I<SliceCount Do Begin
  If SlOff(I)>=DSize Then Begin RVFrame:=-1; Exit; End;
  Offset:=SlOff(I);
  If I+1=SliceCount Then Size:=DSize-Offset Else Size:=SlOff(I+1)-Offset;
  If I+2>=SliceCount Then Size2:=DSize-Offset Else Size2:=SlOff(I+2)-Offset;
  If (Size<=0) Or (Size2<=0) Then Begin RVFrame:=-1; Exit; End;
  If Size>Size2 Then Off1:=Size Else Off1:=Size2;
  If Offset+Off1>DSize Then Begin RVFrame:=-1; Exit; End;
  Ret:=RVPacket(PEABuffer(@Data^[Offset]),Size,Size2,DSize);
  If Ret<0 Then Begin RVFrame:=-1; Exit; End;
  If Ret>8*Size Then Inc(I);
  Inc(I);
 End;
 If RVPend And (H3MbY>=H3MbH) Then Begin
  If RVLow Or (RVCurType=2) Then Begin H3Out:=H3CurI; RVFrame:=1; End
  Else If RVLastI>=0 Then Begin H3Out:=RVLastI; RVFrame:=1; End;
  RVPend:=False;
 End;
End;

