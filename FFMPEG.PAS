  R:=R Xor (Word(W^.Data[I]) Shl 8);
  For J:=1 To 8 Do Begin High:=(R And $8000)<>0; R:=(LongInt(R)*2) And 65535; If High Then R:=R Xor $8005; End;
 End; CRC:=R;
End;
Procedure FinishCRC;
Var Split,I:Integer; R:Word;
Begin
 Split:=((FrameSize Div 2) Div 2+(FrameSize Div 2) Div 8)*2;
 R:=CRC(4,Split);
